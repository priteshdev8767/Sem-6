function SimpleScaleComparisonSeriesItem(argparent, argprops) {
    this.name = "SimpleScaleComparisonSeriesItem";
    this.radius = 0;
    this.areaminSize =350;
    this.startAngle = 180;
    this.endAngle = 0;
    this.assetSize =0;
    this.innerRadius = 0;
    this.pntEnd = {
        x: 0,
        y: 0,
    };
    this.pntStart = {
        x: 0,
        y: 0,
    };
    this.pntCenter = {
        x: 0,
        y: 0,
    };
    this.pntInnerEnd = {
        x: 0,
        y: 0,
    };
    this.pntInnerStart = {
        x: 0,
        y: 0,
    };
    this.minValueFontSize = [25,25]
    this.boolMinWidth =false;
    BaseMovieclipColumnSeriesItem.call(this, argparent, argprops);
}
SimpleScaleComparisonSeriesItem.prototype = Object.create(BaseMovieclipColumnSeriesItem.prototype);
SimpleScaleComparisonSeriesItem.prototype.constructor = SimpleScaleComparisonSeriesItem;

SimpleScaleComparisonSeriesItem.prototype.updateBasicData = function () {
    this.gapPercentage = 1;
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if(categoryFontDetails)
    {
        this.maxValueFontSize = [categoryFontDetails.maxSize,categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize,categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [120, 120];
    if(this.data.customValueFontSize){
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if(this.minValueFontSize[0]>this.data.customValueFontSize)this.minValueFontSize = [this.data.customValueFontSize,this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex.toString(),
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * 0.7;
    this.labelMaxW = this.labelMaxW < labelMaxW ? labelMaxW : this.labelMaxW
    this.labeMaxH = this.state.height * 0.8 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: (this.data.layout.valuePosIndex).toString(),
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = (this.state.width * 0.4) * this.gapPercentage;
    this.valueMaxH = this.state.height * 0.2; //< 35 ? this.state.height : 35;
    this.valueMaxH = this.valueMaxH < 160 ? 160 : this.valueMaxH
    this.valueMaxW = this.valueMaxW < this.areaminSize ? this.areaminSize : this.valueMaxW

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);


    var intAssetLength = this.data.asset.data.length;
    // if (0 < intAssetLength) this.assetURL = appStaticURL + "genericassets/shapes/firefox-logo-horizontal-lockup.png";
    this.asset = this.data.asset.data;
}

SimpleScaleComparisonSeriesItem.prototype.doAddGraphicElement = function () {
    // if(this.data.boolPercentageChart)
    // {
    //     this.data.valuesDenomination[this.groupindex][this.index] = Math.round(this.data.values[this.groupindex][this.index])
    // }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType,
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const parentWidth = this.parent.getAttribute("data-width");
    const parentHeight = this.parent.getAttribute("data-height");
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = "100%";
    element.style.height = "auto";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    this.parent.appendChild(element);
    this.doAddTopSeriesItemElement(element, eProps);
}

SimpleScaleComparisonSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    if (this.data.chartName == "numberFillComparisonChart") {
        maxSize = 400;
    }
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = "auto";
    element.style.alignItems = "center";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);

    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
    }
}

SimpleScaleComparisonSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    this.labelMaxW = this.labelMaxW * 0.8
    // if (this.displayValue(argprops) && this.valueAlignment.position == "outer") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "outer") _iHeight += _dataPlaceholder.height;

    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex;
    element.className = "basegraphic basetopgraphic";
    element.style.width = parentWidth + "px";
    element.style.height = "auto";
    if (argparent) argparent.appendChild(element);
    else return element;
    
    this.boolMinWidth = (parentWidth*2)<=this.areaminSize;
    if(this.boolMinWidth){
        element.style.width = this.areaminSize+"px"
        if(this.groupindex==0){
            element.style.alignItems = "flex-end";
        }else{
            element.style.alignItems = "flex-start";
        }
        
    }

    let assetSize = parentWidth;
    this.assetSize = parentWidth;
    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "seriesitem-" + index;
    // subelement.style.display = "block";
    subelement.className = "seriesitem topseriesitem chartgraphic";
    subelement.style.width = assetSize + "px";
    subelement.style.height = "auto";
    subelement.style.position = "relative";
    subelement.setAttribute("data-width", assetSize);
    subelement.setAttribute("data-height", assetSize);
    element.appendChild(subelement); //multiCompPie
    this.doPieComputation(assetSize, groupindex, index, subelement, argprops);
    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        graphicH = assetSize / 2;
        this.doAddTopValue(element, argprops, true);
        this.doAddLabel(element, argprops, true, false);
        let placeHolderBounds = this.getPlaceholderBounds()
        let boolValueoverLap = graphicH < this.maxValueH;
        let boolLabeloverLap = (assetSize) < this.labelMaxW || (graphicH / 2) < this.maxLabelH * 0.7;
        const vLayoutName = this.valuelayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + this.groupindex + "_" + argprops.index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.height = this.radius + "px";
        sameElement.style.position = "absolute";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : assetSize + "px";
        if (!boolLabeloverLap || !boolValueoverLap) element.appendChild(sameElement);


        if (this.valueAlignment.samepos && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || boolValueoverLap ? this.ChartFonts.valueOuterColor : this.getColorDetails(groupindex,this.ChartFonts.valueInnerColor, this.data.layout.valueColor, "color");
            if (boolValueoverLap) this.doAddTopValue(element, argprops);
            else this.doAddTopValue(sameElement, argprops);
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || boolLabeloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (boolLabeloverLap){
                this.labelMaxW = this.areaminSize*0.6;
                this.doAddLabel(element, argprops, false, false, true);
                let labelElement = element.querySelector(".label");
                labelElement.style.justifyContent = this.groupindex==0?"flex-end":"flex-start";
                labelElement.style.textAlign = this.groupindex==0?"right":"left";
            }
            else this.doAddLabel(sameElement, argprops, false, false, true);
        }
    }
}

SimpleScaleComparisonSeriesItem.prototype.doPieComputation = function (assetSize, groupindex, index, subelement, argprops) {
    assetSize = parseInt(assetSize);
    let intMaxAngle = 180;
    this.pntCenter.x = parseInt(assetSize / 2);
    this.pntCenter.y = parseInt(assetSize / 2);
    let value = argprops.value < 100 ? argprops.value : 100;
    this.radius = parseInt(assetSize / 2);
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
    this.endAngle = this.startAngle + intMaxAngle;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(groupindex,this.ChartFonts.graphicFillColor(groupindex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicFillColor(groupindex);
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class:"svgAsset",
        x: "0%",
        y: "0%",
        width: parseInt(assetSize) + "px",
        height: parseInt(assetSize / 2) + "px",
        viewBox: 0 + " " + 0 + " " + parseInt(assetSize) + " " + parseInt(assetSize / 2),
    });
    subelement.appendChild(svgElement);

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "moodanimation transformOrginBottom path_to " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray,
        mask: "url(#mask" + groupindex + ")",
    });
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement)
    }
    svgPathTo.dataset.customorgin = "bottom";
    svgElement.appendChild(svgPathTo);
}

SimpleScaleComparisonSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax) {
    let valueMaxSize = "";
    if (boolmax) {
        valueMaxSize = this.maxValueFontSize[this.arrIndex] * (this.data.rangePositive / this.data.rangePositive)
    } else {
        valueMaxSize = this.maxValueFontSize[this.arrIndex] * (argprops.value / this.data.rangePositive)
    }
    valueMaxSize = valueMaxSize < 50 ? 50 : valueMaxSize

    const index = argprops.index;
    const groupindex = argprops.gindex;
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.width = this.valueMaxW + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow n1 " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if(this.data.layout.valuePaddingClass){
        element.classList.add(this.data.layout.valuePaddingClass)
    }
    if(this.boolMinWidth&&graphicH < this.maxValueH){
        if(this.groupindex==0){
            element.style.marginRight = ((this.assetSize/2)-5)+"px";
            element.style.justifyContent = "flex-end";
        }else{
            element.style.marginLeft = ((this.assetSize/2)-5)+"px";
            element.style.justifyContent = "flex-start";
        }
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }

    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset=="inside"
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor,this.valueStyle,subelement,"value",hasInnerValue)
    this.checkMoodLevelColorvalue(this.data.layout.valueColor,subelement,"value","color",null,hasInnerValue)
    let colorTabValueCustomClass = this.valueStyle=="dummeycolor"?"":this.data.clsValueTextColor;

    subelement.className = "valuetext "+colorTabValueCustomClass+" moodanimation " + this.valueStyle;
    if(this.data.layout.valueInset=="inside"&this.valueStyle!="outerColor1"){
        subelement.className = "valuetext " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    }
    subelement.innerText = argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = valueMaxSize + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", valueMaxSize);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    subelement.style.overflow = "hidden";
    subelement.dataset.animation = "secondarytext";
    if(this.valueStyle=="textgradient"){
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important")
    }
    element.appendChild(subelement);
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        this.valuebgProperties(subelement)
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex])
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle :clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if(this.data.layout.valueShadowClass)subelement.classList.add(this.data.layout.valueShadowClass)
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if(this.data.valueTextColor[groupindex][index]){
        subelement.style.setProperty("color",this.data.valueTextColor[groupindex][index],"important")
    }
    this.calculateMaxFonsize(subelement,boolmax,valueMaxSize)
    this.ChartHelper.adjustFontSize(subelement, 10, 37, valueMaxSize);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, 37, valueMaxSize);
    // this.ChartHelper.textPositionChangeObserver(subelement);
    //this.ChartHelper.textPositionChangeObserver(subelement);
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        argparent.removeChild(element);
    }else{
        this.ChartUtils.createSpanFormat(subelement,this.data);
    }
    if(this.data.layout.valueInset=="inside"&this.valueStyle!="outerColor1"&&!this.boolMinWidth){
        if(this.data.suffixStyle){
            let valueSuffixElement = subelement.querySelector("."+this.data.suffixStyle);
            if(valueSuffixElement)valueSuffixElement.className = this.data.suffixStyle+" "+this.valueStyle
        }
        if(this.data.prefixStyle){
            let valuePerfixElement = subelement.querySelector("."+this.data.prefixStyle);
            if(valuePerfixElement)valuePerfixElement.className = this.data.prefixStyle+" "+this.valueStyle
        }
    }
}




function SimpleShapeComparisonChart(argparent, argprops) {
    this.name = "SimpleShapeComparisonChart";
    BaseMovieclipColumnChart.call(this, argparent, argprops);
    this.chartDataGenerator = new window["ChartDataGenerator"]();
}
SimpleShapeComparisonChart.prototype = Object.create(BaseMovieclipColumnChart.prototype);
SimpleShapeComparisonChart.prototype.constructor = SimpleShapeComparisonChart;

SimpleShapeComparisonChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleShapeComparisonSeries"](argparent, argprops);
};
SimpleShapeComparisonChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveX = this.rectSeries.y;
    // if(this.data.layout.itemSpace){
    //     this.rectSeries.width = this.rectSeries.width - this.data.layout.itemSpace;
    // }
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.move(moveX, this.rectSeries.y);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveX += this.rectSeries.width;
    }
    this.adjustaxisline(argparent);
    if (this.data.chartName == "multiImageComparison") {
        this.createGraphicsImage();
    }
};
SimpleShapeComparisonChart.prototype.createGraphicsImage = function () {
    let graphicElement = this.parent.querySelectorAll(".chartgraphic");
    let seriesItemContent = this.parent.querySelectorAll(".seriesitemcond");
    let valueElement = this.parent.querySelectorAll(".value");
    let labelElement = this.parent.querySelectorAll(".label");
    let seriesElement = this.parent.querySelectorAll(".series");
    for (let i1 = 0; i1 < graphicElement.length; i1++) {
        if (seriesItemContent[i1] && graphicElement[i1]) seriesItemContent[i1].style.height = graphicElement[i1].clientHeight + "px";
        let assetdata = this.voData.asset.data.length > 0 && this.voData.asset.data[0].data ? JSON.parse(this.voData.asset.data[0].data) : "";
        let farmes = "";
        let assetValueUrl = "";
        if (assetdata) {
            farmes = assetdata.frames;
            this.data.spriteasset.push({ name: this.data.layout.assetname, assetvalue: this.voData.asset.data });
            assetValueUrl = this.voData.asset.data[1].url;
        } else {
            if (this.data.spriteasset.length > 0) {
                for (let k1 = 0; k1 < this.data.spriteasset.length; k1++) {
                    if (this.data.spriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.spriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.spriteasset[k1].assetvalue[1].url;
                    }
                }
                farmes = assetdata.frames;
            }
            if (!farmes && this.data.secondaryspriteasset.length > 0 && !assetdata) {
                for (let k1 = 0; k1 < this.data.secondaryspriteasset.length; k1++) {
                    if (this.data.secondaryspriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.secondaryspriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.secondaryspriteasset[k1].assetvalue[1].url;
                    }
                }
                farmes = assetdata.frames;
            }
        }
        if (!farmes || (farmes && farmes.length < 1)) return;
        let totalfarmes = farmes.length - 1;
        let assetURL = this.data.serverUrl + assetValueUrl;
        if (this.data._postiveMaxValue > 100) {
            let differenceValue = 100 / this.data._postiveMaxValue;
            this.voData.values[i1][0] = this.voData.values[i1][0] * differenceValue;
        } else {
            this.voData.values[i1][0] = this.voData.values[i1][0] > 100 ? 100 : this.voData.values[i1][0];
        }
        let indexValue = (this.voData.values[i1][0] / 100) * 100;

        let frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((indexValue / 100) * totalfarmes);
        if (this.data.seriesLength == 1) {
            frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((this.voData.values[i1][0] / 100) * totalfarmes);
        }
        let frame = farmes[frameIndex]?.frame;
        if (!frame) return;
        let spriteCoordinates = [];
        for (let i1 = 0; i1 < totalfarmes + 1; i1++) {
            let eachFrame = farmes[i1].frame;
            let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
            spriteCoordinates.push(eachFrameCoordinates);
        }

        let itemWidth = graphicElement[i1].clientWidth;
        let itemHeight = graphicElement[i1].clientHeight;
        let scaleX = itemWidth / frame.w;
        let scaleY = itemHeight / frame.h;
        let scale = scaleX < scaleY ? scaleX : scaleY;

        let viewWidth = frame.w * scale;
        let viewHeight = frame.h * scale;
        let translateX = (itemWidth - viewWidth) / 2;
        let translateY = (itemHeight - frame.h) / 2;
        let baseElement = this.data.ChartHelper.createDivElement({});
        baseElement.className = "piegraphic moodanimation";
        baseElement.style.overflow = "hidden";
        baseElement.style.width = "100%";
        baseElement.dataset.animation = "item";
        graphicElement[i1].appendChild(baseElement);
        let assetelement = this.data.ChartHelper.createDivElement({});
        assetelement.id = "graphicimage-" + i1;
        assetelement.className = "graphicimage";
        // assetelement.dataset.animation = "spriteanimation";
        assetelement.dataset.frameindex = frameIndex;
        assetelement.dataset.totalframes = totalfarmes;
        assetelement.dataset.assetURL = assetURL;
        assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
        if (this.data._directionenable) {
            translateX = -translateX;
        }
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        baseElement.appendChild(assetelement);
        translateX = (itemWidth - assetelement.clientWidth) / 2;
        if (this.data._directionenable) {
            translateX = -translateX;
        }
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        baseElement.style.height = frame.h * scale + "px";
        let labelW = labelElement[i1] ? labelElement[i1].clientWidth : 0;
        let valueW = valueElement[i1] ? valueElement[i1].clientWidth : 0;
        let widthPercentage = parseInt(((viewWidth + labelW + valueW + 20) / this.state.width) * 100) + "%";
        if (seriesElement[i1]) {
            seriesElement[i1].style.maxWidth = widthPercentage;
        }
    }
};

// const minSize = 20;
// const maxSize = 400;
function SimpleShapeComparisonSeries(argparent, argprops) {
    this.widthPercentage = 1;
    this.name = "SimpleShapeComparisonSeries";
    BaseMovieclipColumnSeries.call(this, argparent, argprops);
}
SimpleShapeComparisonSeries.prototype = Object.create(BaseMovieclipColumnSeries.prototype);
SimpleShapeComparisonSeries.prototype.constructor = SimpleShapeComparisonSeries;

SimpleShapeComparisonSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleShapeComparisonSeriesItem"](argparent, argprops);
};

SimpleShapeComparisonSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series accent" + customColorIndex + " clsMultiColorParent";
    // element.dataset.animation = "nodeitem"
    element.style.width = this.state.width + "px";
    element.style.justifyContent = "center";
    if (this.data.layout.parentvPosition == "bottom") {
        element.style.justifyContent = "flex-start";
    }
    element.classList.add("th-section" + customColorIndex);
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    let viewSize = this.state.width * this.widthPercentage < this.rectSeriesItem.height ? this.state.width * this.widthPercentage : this.rectSeriesItem.height;
    //boolMax
    this.labeMaxH = this.data.hadSecondaryText ? (this.state.height - viewSize) * 0.5 : (this.state.height - viewSize) * 0.9;
    if (this.data.hadSecondaryText) {
        this.doAddSecondaryLabelNode(element, argprops, true);
        this.doAddSecondaryLabelNode(element, argprops);
    }
    this.doAddLabel(element, argprops, true, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops, false, true);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops);
    }
    viewSize = this.state.width * this.widthPercentage < this.rectSeriesItem.height ? this.state.width * this.widthPercentage : this.rectSeriesItem.height;

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    this.widthPercentage = 1;

    // viewSize =  260< viewSize ? 260 : viewSize;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond";
    subelement.style.width = viewSize + "px";
    subelement.style.height = viewSize + "px";
    subelement.style.flex = "unset";
    subelement.setAttribute("data-width", viewSize);
    subelement.setAttribute("data-height", viewSize);
    if (this.data.chartName == "multiCompPie") {
        subelement.style.height = "auto";
    }
    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

// const minSize = 20;
// const maxSize = 400;
// let assetSize = 0;
// let backPadding = 0;

function SimpleShapeComparisonSeriesItem(argparent, argprops) {
    this.name = "SimpleShapeComparisonSeriesItem";
    this.radius = 0;
    this.startAngle = 270;
    this.endAngle = 0;
    this.innerRadius = 0;
    this.pntEnd = {
        x: 0,
        y: 0,
    };
    this.pntStart = {
        x: 0,
        y: 0,
    };
    this.pntCenter = {
        x: 0,
        y: 0,
    };
    this.pntInnerEnd = {
        x: 0,
        y: 0,
    };
    this.pntInnerStart = {
        x: 0,
        y: 0,
    };
    this.pntMidPoints = [];
    BaseMovieclipColumnSeriesItem.call(this, argparent, argprops);
}
SimpleShapeComparisonSeriesItem.prototype = Object.create(BaseMovieclipColumnSeriesItem.prototype);
SimpleShapeComparisonSeriesItem.prototype.constructor = SimpleShapeComparisonSeriesItem;

SimpleShapeComparisonSeriesItem.prototype.updateBasicData = function () {
    BaseMovieclipColumnSeriesItem.prototype.updateBasicData.call(this);
    // this.valueMaxW = (this.state.width) * 0.4;
    var intAssetLength = this.data.asset.data.length;
    if (this.voData._localAsset) {
        this.assetURL = this.data.serverUrl + this.voData.asset.data[0].url;
    } else {
        if (0 < intAssetLength) this.assetURL = this.data.serverUrl + this.voData.asset.data[0].url;
    }
    this.asset = this.data.asset.data;
};

SimpleShapeComparisonSeriesItem.prototype.doAddGraphicElement = function () {
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.valuesDenomination[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType,
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };
    if (this.groupindex == 0) {
        backPadding = this.data.layout.valuePaddingbottom;
    }
    const parentWidth = this.parent.getAttribute("data-width") / this.length;
    const parentHeight = this.parent.getAttribute("data-height");
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = parentWidth + "px";
    element.style.justifyContent = "flex-end";
    element.style.height = "auto";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    this.parent.appendChild(element);

    this.doAddTopSeriesItemElement(element, eProps);
};

SimpleShapeComparisonSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = "auto";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
    }
};

SimpleShapeComparisonSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // if (this.displayValue(argprops) && this.valueAlignment.position == "outer") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "outer") _iHeight += _dataPlaceholder.height;

    let parentWidth = argparent.getAttribute("data-width");
    let parentHeight = argparent.getAttribute("data-height");
    // parentHeight = parentHeight>argparent.parentNode.clientHeight?argparent.parentNode.clientHeight:parentHeight;
    parentWidth = parentHeight;

    if (this.valueAlignment.position == "outer" && this.displayValue(argprops)) {
        this.doAddTopValue(argparent, argprops, true);
        _iHeight = this.maxValueH;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex;
    element.className = "basegraphic basetopgraphic";
    element.style.width = parentWidth + "px";
    element.style.height = parentHeight + "px";
    if (argparent) argparent.appendChild(element);
    else return element;

    const baseGraphicHeight = parentHeight;
    let valuePercentage = 0;
    if (this.data.chartName == "multiCompPie" || this.data.chartName == "multiComparisonPie" || this.data.chartName == "multiFillCompCircle" || this.data.chartName == "multiCompDoughnut" || this.data.chartName == "multiImageComparison") {
        valuePercentage = 0.8;
    } else {
        let maxValue = argprops.maxvalue;
        let value = argprops.value;
        if (this.data.chartName == "shapesComparisonPieChart") {
            maxValue = Math.max(...this.voData.arrSeriesItemValueTotal);
            value = this.voData.arrSeriesItemValueTotal[this.groupindex];
        }
        let differnceValue = value == 0 ? 0 : (maxValue - value) * 0.01;
        valuePercentage = (value + differnceValue) / maxValue;
    }

    let viewSize = parentWidth < baseGraphicHeight ? parentWidth - _iHeight : baseGraphicHeight - _iHeight;
    // viewSize = 260 < viewSize ? 260 : viewSize;
    assetSize = viewSize * valuePercentage;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "seriesitem-" + index;
    // subelement.style.display = "block";
    subelement.className = "seriesitem topseriesitem";
    subelement.style.width = viewSize + "px";
    subelement.style.height = viewSize + "px";
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.style.position = "relative";
    subelement.setAttribute("data-width", viewSize);
    subelement.setAttribute("data-height", viewSize);
    element.appendChild(subelement); //multiCompPie
    let backgroundElement = "";
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.className = "backgroundElement";
        backgroundElement.style.width = viewSize + "px";
        backgroundElement.style.height = viewSize + "px";
        backgroundElement.style.position = "absolute";
        backgroundElement.setAttribute("data-width", viewSize);
        backgroundElement.setAttribute("data-height", assetSize);
        subelement.appendChild(backgroundElement);
    }
    subelement.style.display = "flex";
    subelement.style.justifyContent = "flex-start";
    subelement.style.alignItems = "center";

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.className = "chartgraphic graphicBaseElement";
    graphicElement.style.width = assetSize + "px";
    graphicElement.style.height = assetSize + "px";
    graphicElement.style.position = "relative";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-width", assetSize);
    graphicElement.setAttribute("data-height", assetSize);
    subelement.appendChild(graphicElement);

    if (this.data.chartName == "multiComparisonPie") {
        this.doComparePie(assetSize, groupindex, index, graphicElement, argprops);
    } else if (this.data.chartName == "stopwatchmultiCompPie") {
        this.doMaskPieComputation(assetSize, groupindex, index, graphicElement, argprops);
    } else if (this.data.chartName == "multiCompPie") {
        this.doPieComputation(assetSize, groupindex, index, graphicElement, argprops);
    } else if (this.data.chartName == "multiCompDoughnut") {
        this.doDoughnutComputation(assetSize, groupindex, index, graphicElement, argprops);
    } else if (this.data.chartName == "multiFillCompCircle") {
        this.doFillComputation(assetSize, groupindex, index, graphicElement, argprops);
    } else if (this.data.chartName == "multiImageComparison") {
        graphicElement.style.alignItems = "center";
    } else if (this.data.chartName == "shapesComparisonPieChart") {
        graphicElement.className = "graphicBaseElement";
        this.doComparePieComputation(assetSize, groupindex, index, graphicElement, argprops);
    } else {
        let clsStyle = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.appendgraphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(this.groupindex);
        let clsBgStyle = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.appendgraphicFillColor(this.groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(this.groupindex);
        if (this.data.chartName == "shapesComparisonChart" || this.data.chartName == "windenergy" || this.voData.customProperties.appearance == "Solid") {
            let assetelement;
            if (!this.asset?.[0]?.data && this.data.slideObj) {
                assetelement = this.data.slideObj.querySelector("#base-graphic-0")?.querySelector(".chartgraphic")?.children[0]?.children[0]?.cloneNode(true);
                assetelement.removeAttribute("style");
            } else {
                assetelement = this.asset?.[0]?.data?.cloneNode(true);
            }
            if (this.data.layout.itemColor == "gradient") {
                clsStyle = "";
            }
            if (this.data.layout.itemborder) {
                clsStyle = this.ChartFonts.graphicStrokeColor(this.groupindex);
            }
            this.data.SVGUtils.assignAttributes(assetelement, {
                id: "graphic-" + groupindex + "_" + index,
                class: "transformOrginBottom assetelement " + clsStyle,
                "data-bgstyle": clsBgStyle,
                "data-style": clsStyle,
                x: "0%",
                y: "0%",
                width: "100%",
                height: "100%",
            });
            assetelement.dataset.customorgin = "bottom";
            let baseSvg = this.data.SVGUtils.createSVGElement("svg");
            this.data.SVGUtils.assignAttributes(baseSvg, {
                x: "0%",
                y: "0%",
                class: "svgAsset moodanimation " + this.data.layout.itemShadow,
                "data-animation": "item",
                width: "100%",
                height: "100%",
            });
            graphicElement.appendChild(baseSvg);
            baseSvg.appendChild(assetelement);

            if (this.data.layout.itemColor == "gradient") {
                this.addGradient(assetelement, baseSvg);
            }
        } else {
            const assetelement = this.data.SVGUtils.createSVGElement("svg");
            this.data.SVGUtils.assignAttributes(assetelement, {
                id: "graphic-" + groupindex + "_" + index,
                class: "micropie moodanimation assetelement transformOrginBottom " + clsStyle,
                "data-bgstyle": clsBgStyle,
                "data-style": clsStyle,
                x: "0%",
                y: "0%",
                width: "100%",
                height: "100%",
                "data-graphicassetimage": "true",
                "data-animation": "item",
            });
            assetelement.dataset.customorgin = "bottom";
            graphicElement.appendChild(assetelement);

            const imageTag = this.data.SVGUtils.createSVGElement("image");
            this.data.SVGUtils.assignAttributes(imageTag, {
                id: "image-" + groupindex + "_" + index,
                "xlink:href": this.assetURL,
                "data-type": "IMAGE",
                "data-secondassetSource": this.data.layout.itemFolder,
                x: "0%",
                y: "0%",
                width: "100%",
                height: "100%",
            });
            assetelement.appendChild(imageTag);
        }
    }

    if (this.displayValue(argprops) && this.data.chartName != "multiComparisonPie") {
        if (this.data.chartName == "multiCompPie") {
            let boolPercentageChart = this.ChartUtils.checkPecentageChart(this.data);
            if (boolPercentageChart && argprops.maxvalue > 100) {
                argprops.valuetext = this.data.prefix[this.groupindex][this.index] + parseInt(argprops.value) + this.data.suffix[this.groupindex][this.index];
            }
        }
        this.doAddTopValue(graphicElement, argprops, true, false);
        if (this.valueAlignment.position == "outer" || assetSize < this.maxValueH) {
            this.valueStyle = "outerstyle";
            if (this.valueAlignment.position == "inner") {
                this.data.layout.valuePaddingbottom = 4;
                this.valueStyle = this.ChartFonts.valueOuterColor;
            }
            this.valueMaxW = subelement.clientWidth * 0.9;
            this.valueAlignment.position == "inner" ? this.doAddTopValue(subelement, argprops, false, false) : this.doAddTopValue(subelement, argprops, false, false);
            if (this.data.chartName == "shapesComparisonPieChart") {
                argprops["index"] = 1;
                argprops["value"] = this.data.values[this.groupindex][1];
                argprops["valuetext"] = this.data.prefix[this.groupindex][1] + this.data.valuesDenomination[this.groupindex][1] + this.data.suffix[this.groupindex][1];
                this.valueAlignment.position == "inner" ? this.doAddTopValue(subelement, argprops, false, false) : this.doAddTopValue(subelement, argprops, false, false);
            }
            let valuenode = subelement.children[0];
            valuenode.style.margin = "unset";
        } else if (this.valueAlignment.position == "inner") {
            this.data.layout.valuePaddingbottom = backPadding;
            let valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + index;
            valueElement.className = "valueelement topseriesitem";
            valueElement.style.width = "100%";
            valueElement.style.height = "100%";
            valueElement.style.display = "flex";
            valueElement.style.justifyContent = "center";
            valueElement.style.alignItems = "center";
            valueElement.style.overflow = "hidden";
            valueElement.style.position = "absolute";
            valueElement.style.top = "0";
            graphicElement.style.position = "relative";
            graphicElement.appendChild(valueElement);

            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.valueMaxW = assetSize * 0.8;
            this.doAddTopValue(valueElement, argprops, false, false);
            let valuenode = valueElement.children[0];
            valuenode.style.margin = "unset";
            let valueSuffixElement = valueElement.querySelector(".clsSuffixTxt");
            if (valueSuffixElement) {
                valueSuffixElement.classList.remove("clsInnerSuffixTxt");
                valueSuffixElement.classList.add("clsInnerSuffixTxt");
            }
            let valuePerfixElement = valueElement.querySelector(".clsPrefixTopSmallTxt");
            if (valuePerfixElement) {
                valuePerfixElement.classList.remove("clsInnerPrefixTxt");
                valuePerfixElement.classList.add("clsInnerPrefixTxt");
            }
            if (this.data.chartName == "shapesComparisonPieChart") {
                argprops["index"] = 1;
                argprops["value"] = this.data.values[this.groupindex][1];
                argprops["valuetext"] = this.data.prefix[this.groupindex][1] + this.data.valuesDenomination[this.groupindex][1] + this.data.suffix[this.groupindex][1];
                this.doAddTopValue(valueElement, argprops, false, false);
            }
        }
    }

    let backGroundGraphicElement = graphicElement?.children[0]?.cloneNode(true);
    let bgAssetElement = backGroundGraphicElement?.querySelector(".assetelement");
    if (backGroundGraphicElement && backgroundElement) {
        backGroundGraphicElement.style.width = viewSize + "px";
        backGroundGraphicElement.style.height = viewSize + "px";
        backGroundGraphicElement.style.position = "absolute";
        backGroundGraphicElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backGroundGraphicElement.style.fillOpacity = this.data.layout.backgroundOpacity;
        backGroundGraphicElement.setAttribute("data-width", viewSize);
        backGroundGraphicElement.setAttribute("data-height", viewSize);
        backGroundGraphicElement.classList.remove("chartgraphic");
        backGroundGraphicElement.classList.add("backgroundchartGraphic");
        if (bgAssetElement) {
            bgAssetElement.classList.remove(bgAssetElement.getAttribute("data-style"));
            bgAssetElement.classList.add(bgAssetElement.getAttribute("data-bgstyle"));
        }
        let arrSvgAsset = backGroundGraphicElement?.getAttribute("data-animation") == "item" ? [backGroundGraphicElement] : backGroundGraphicElement?.querySelectorAll('[data-animation="item"]');
        if (arrSvgAsset) {
            arrSvgAsset.forEach((item) => {
                item.dataset.animation = "itembackground";
            });
        }
        backgroundElement.appendChild(backGroundGraphicElement);
    }
    if (this.data.chartName == "shapesComparisonPieChart") {
        let value1Element = subelement?.parentNode?.querySelector("#value-text-" + groupindex + "_0");
        let value2Element = subelement?.parentNode?.querySelector("#value-text-" + groupindex + "_1");
        let arrValueElement = [value1Element, value2Element];
        value2Element.classList.add("clsMultiColorParent");
        value1Element.classList.add("clsMultiColorParent");

        let valueCutomGroupIndex = this.ChartFonts.customColor(1);
        value1Element.classList.add("accent" + valueCutomGroupIndex);
        value1Element.classList.add("th-section" + valueCutomGroupIndex);

        valueCutomGroupIndex = this.ChartFonts.customColor(0);
        value2Element.classList.add("accent" + valueCutomGroupIndex);
        value2Element.classList.add("th-section" + valueCutomGroupIndex);
        if (this.valueAlignment.position == "inner") {
            arrValueElement.forEach((item, index) => {
                if (item) {
                    item.style.width = "fit-content";
                    item.style.minWidth = "10px";
                    item.style.position = "absolute";
                    item.style.left = this.pntMidPoints[index].x + "px";
                    item.style.top = this.pntMidPoints[index].y + "px";
                    item.style.transform = "translate(-50%, -50%)";
                    let itemSize = Math.max(item.clientWidth, item.clientHeight) + 5;
                    if (this.pntMidPoints[index]["diffangle"] < 30 || this.pntMidPoints[index].radius < itemSize) {
                        item.style.display = "none";
                    }
                }
            });
        }
    }
};
SimpleShapeComparisonSeriesItem.prototype.doComparePie = function (assetSize, groupindex, index, subelement, argprops) {
    let startAngle = this.startAngle;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");

    subelement.appendChild(svgElement);
    for (let i1 = 0; i1 < 2; i1++) {
        assetSize = parseInt(assetSize);
        let intMaxAngle = 360;
        this.pntCenter.x = parseInt(assetSize / 2);
        this.pntCenter.y = parseInt(assetSize / 2);
        let value = this.data.values[this.groupindex][i1];
        this.radius = parseInt(assetSize / 2);
        this.totalDashArray = Math.PI * this.radius;
        let totalValue = 100;
        if (this.data._rangePositive > 100) {
            totalValue = this.data._rangePositive;
        }
        this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / totalValue);
        let dummeyTotalValue = parseFloat(this.data.values[this.groupindex][0]) + parseFloat(this.data.values[this.groupindex][1]);
        let Angle = (intMaxAngle / dummeyTotalValue) * parseFloat(value);
        this.endAngle = startAngle + Angle;
        let midAngle = startAngle + (this.endAngle - startAngle) / 2;

        this.pntMid.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
        this.pntMid.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * startAngle) / 180));

        this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
        this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
        this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * startAngle) / 180));
        this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * startAngle) / 180));
        this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

        this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (startAngle / 180)));
        this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (startAngle / 180)));
        this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
        this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
        this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

        let strStyleClass = this.ChartFonts.graphicFillColor(i1);
        let strBgStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
        let strBgStrokeStyleClass = this.getBgFillDetails(groupindex, "clsSecondaryStroke", this.data.layout.backgroundColor, "stroke"); //this.ChartFonts.graphicFillColor(groupindex);

        this.data.SVGUtils.assignAttributes(svgElement, {
            id: "graphic-" + groupindex + "_" + index,
            class: "micropie " + strStyleClass,
            x: "0%",
            y: "0%",
            width: assetSize + "px",
            height: assetSize + "px",
            viewBox: 0 + " " + 0 + " " + assetSize + " " + assetSize,
            "data-cx": this.pntCenter.x,
            "data-cy": this.pntCenter.y,
            "data-type": "CHARTITEM",
            "data-endangle": this.endAngle,
            "data-startangle": this.startAngle,
            "data-outerradius": this.radius,
            "data-innerradius": this.innerRadius,
        });

        if (this.data.layout.backgroundColor == "gradient") {
            this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
                fill: "",
                stroke: "",
            });
            this.addGradient(svgBgDonghnutPath, svgElement);
        }
        let svgPathTo = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            id: "path-" + groupindex + "_" + index,
            class: "path_to " + strStyleClass,
            d:
                "M" +
                this.pntInnerStart.x +
                "," +
                this.pntInnerStart.y +
                "L" +
                this.pntStart.x +
                "," +
                this.pntStart.y +
                "A" +
                this.radius +
                "," +
                this.radius +
                " 0 " +
                (this.endAngle - startAngle > 180 ? 1 : 0) +
                ",1 " +
                this.pntEnd.x +
                "," +
                this.pntEnd.y +
                "L" +
                this.pntInnerEnd.x +
                "," +
                this.pntInnerEnd.y +
                "A" +
                this.innerRadius +
                "," +
                this.innerRadius +
                ",0," +
                (this.endAngle - startAngle > 180 ? 1 : 0) +
                ",0 " +
                this.pntInnerStart.x +
                "," +
                this.pntInnerStart.y +
                "z",
            "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
            "stroke-opacity": 0,
            "data-cx": this.pntCenter.x,
            "data-cy": this.pntCenter.y,
            "data-endangle": this.endAngle,
            "data-startangle": this.startAngle,
            "data-outerradius": this.radius,
            "data-innerradius": this.innerRadius,
            "data-hover": this.data.validHover,
            "data-hover-value": this.numValue,
            "data-animation": "item",
            "data-totaldasharray": this.totalDashArray,
            "data-valuedasharray": this.valueDashArray,
            mask: "url(#mask" + groupindex + ")",
        });
        svgElement.appendChild(svgPathTo);
        if (this.data.layout.itemColor == "gradient") {
            this.data.SVGUtils.assignAttributes(svgPathTo, {
                class: "path_to ",
            });
        }
        if (this.data.layout.itemColor == "gradient") {
            this.addGradient(svgPathTo, svgElement);
        }
        if (this.data.layout.itemColor == "gradient") {
            this.data.SVGUtils.assignAttributes(svgPathFrom, {
                fill: "",
                stroke: "",
            });
        }
        if (this.data.layout.itemColor == "gradient") {
            this.addGradient(svgPathFrom, svgElement);
        }
        startAngle = this.endAngle;
        if (this.displayValue(argprops)) {
            this.valueStyle = "outerstyle";
            if (this.valueAlignment.position == "inner") {
                this.data.layout.valuePaddingbottom = 4;
                this.valueStyle = this.ChartFonts.valueOuterColor;
            }
            let valueElement = this.ChartHelper.createDivElement({});
            valueElement.style.position = "absolute";
            subelement.appendChild(valueElement);
            this.valueMaxW = subelement.clientWidth * 0.9;
            this.valueAlignment.position == "inner" ? this.doAddTopValue(valueElement, argprops, false, false) : this.doAddTopValue(valueElement, argprops, false, false);
            let valuenode = subelement.children[0];
            valuenode.style.margin = "unset";
        }
    }
};
SimpleShapeComparisonSeriesItem.prototype.doComparePieComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let clsStyle = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(this.groupindex);
    let clsBgStyle = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(this.groupindex);
    let uuid = DiagramNodeUtils.uuidv4();
    const assetelement = this.ChartHelper.createDivElement({});
    this.data.SVGUtils.assignAttributes(assetelement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "micropie moodanimation assetelement transformOrginBottom " + clsStyle,
        "data-bgstyle": clsBgStyle,
        "data-style": clsStyle,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-graphicassetimage": "true",
        "data-animation": "item",
    });
    assetelement.dataset.customorgin = "bottom";
    subelement.appendChild(assetelement);
    let value1 = this.data.values[this.groupindex][0];
    let value2 = this.data.values[this.groupindex][1];

    // Convert values to percentages that sum to 100
    let total = value1 + value2;
    if (total > 0) {
        value1 = (value1 / total) * 100;
        value2 = (value2 / total) * 100;
    }

    let microChartValue = value1;
    let microchartStyle = "clsPieMicroDiagram";
    let globalStyle = "clsMoodMicrochartStyle";
    let assetData = { type: "text", contenttype: "microchart", value: microChartValue };
    let microObj = {
        content: assetData,
        // microchartFontSize: "n1", // font classname
        microStyle: microchartStyle, // microchart type
        globalMoodData: this.data.moodData, // pass mood data
        globalStyle: globalStyle + " clsMicroSingleNode clsMultiColorParent outlineclass", // give global Style here
    };
    // graphicDiv.classList.add("clsMicroSingleNode");
    DiagramCreateUtil.createMicroNode(assetelement, microObj);
    let MicroChartNode = assetelement.querySelector(".clsMicroChartNode");
    MicroChartNode.parentNode.removeChild(MicroChartNode);
    let bgCircle = assetelement.querySelector(".clsCircleBG");
    let mainCircle = assetelement.querySelector(".clsMainCircle");

    let radius = parseInt(mainCircle.getAttribute("r")) * 2;
    let bgGroupNode = this.data.SVGUtils.createSVGElement("g");
    bgCircle.parentNode.appendChild(bgGroupNode);
    let customColorIndex = this.ChartFonts.customColor(0);
    this.data.SVGUtils.assignAttributes(bgGroupNode, {
        class: "clsMultiColorParent accent" + customColorIndex,
    });
    bgCircle.classList.add("chartgraphic");
    bgCircle.setAttribute("data-id", groupindex + "_" + 1);
    bgCircle.style.setProperty("pointer-events", "stroke", "important");
    bgGroupNode.classList.add("th-section" + customColorIndex);
    bgGroupNode.appendChild(bgCircle);
    let mainGroupNode = this.data.SVGUtils.createSVGElement("g");
    mainCircle.parentNode.appendChild(mainGroupNode);
    let customColorIndex2 = this.ChartFonts.customColor(1);
    this.data.SVGUtils.assignAttributes(mainGroupNode, {
        class: "clsMultiColorParent accent" + customColorIndex2,
    });

    mainCircle.classList.add("chartgraphic");
    mainCircle.setAttribute("data-id", groupindex + "_" + 0);

    mainGroupNode.classList.add("th-section" + customColorIndex2);
    bgCircle.style.setProperty("stroke-linecap", "butt", "important");
    mainCircle.style.setProperty("stroke-width", radius + "px", "important");
    mainCircle.style.setProperty("stroke-linecap", "butt", "important");
    mainCircle.style.setProperty("pointer-events", "stroke", "important");
    mainGroupNode.appendChild(mainCircle);
    bgCircle.classList.add("cf-fill-section-primary");
    let defsTag = assetelement.querySelector("defs");
    let maskTag = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(maskTag, {
        id: "mask" + uuid,
    });
    let maskElementInnerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt((radius / 2) * (this.voData.customProperties.innerRadius * 0.01));
    maskTag.innerHTML += '<rect width="32" height="32" fill="white" stroke="none" />';
    maskTag.innerHTML += '<circle r="' + maskElementInnerRadius + '" cx="16" cy="16" fill="black" stroke="none" />';
    defsTag.appendChild(maskTag);
    let targetGroup = mainGroupNode?.parentNode;
    targetGroup.setAttribute("mask", "url(#mask" + uuid + ")");
    this.data.values[this.groupindex][0] = value1;
    this.data.values[this.groupindex][1] = value2;
    let totalValue = value1 + value2;
    let innerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt((assetSize / 2) * (this.voData.customProperties.innerRadius * 0.01));
    let endAngle = this.positionValueOnArc(assetSize, assetSize / 2, innerRadius, value1, totalValue);
    endAngle = this.positionValueOnArc(assetSize, assetSize / 2, innerRadius, value2, totalValue, endAngle);
    console.log(endAngle);
};
