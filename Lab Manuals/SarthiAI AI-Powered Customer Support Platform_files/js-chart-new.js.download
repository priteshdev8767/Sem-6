            if (metaData.getAttribute("data-graphicimage") == "true" || chartName == "barSimpleiconRepeatFill" || chartName == "barSimpleRectangle" || chartName == "statisticalBarSimpleRectangle") {
                hasGraphicImageProperty = "";
            }
            if (chartName == "waterfallchart") {
                hasSortOrderProperty = "";
            }
            if (
                itemId.split("-")[0] != "axis" &&
                minLength < length &&
                !itemId.includes("multiSeriesLabel") &&
                !itemId.includes("secondaryvalue") &&
                !itemId.includes("secondarylabel") &&
                !itemId.includes("seriesItemLabel") &&
                !itemId.includes("graphicIcon") &&
                !itemId.includes("srcData") &&
                !itemId.includes("commonplaceholder") &&
                !itemId.includes("seiriesitemtitle")
            ) {
                hasDeleteProperty = this.FloaterPropertyObjects.deleteasset;
            }
            if (chartName == "comparisonModelType3" && minLength >= length / 2) {
                hasDeleteProperty = "";
            }
            if (itemId.split("-")[0] != "axis" && !itemId.includes("seriesItemLabel") && !itemId.includes("commonplaceholder") && !itemId.includes("seiriesitemtitle") && chartName != "logoComparisonChart" && chartName != "iconComparisonChart" && elementType != "comparelabelheader") {
                hasLinkProperty = this.setItemLinkProperty(eltarget, grahicDiv);
            }
