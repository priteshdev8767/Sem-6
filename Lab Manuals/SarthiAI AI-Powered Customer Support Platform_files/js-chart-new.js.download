                }
                let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
                emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyLineShape);
                svgElement.appendChild(emptySvgNode);
                dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-enabled");
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-disabled");
                }
                let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
                svgElement.removeChild(emptySvgNode);
                if (this.data.layout.itemShapeWidth) {
                    ShapeWidth = this.data.layout.itemShapeWidth;
                }
                if (this.data.layout.itemShapeHeight) {
                    ShapeHeight = this.data.layout.itemShapeHeight;
                }
                if (getShapeBounds) {
                    ShapeWidth = getShapeBounds.width ? getShapeBounds.width : ShapeWidth;
                    ShapeHeight = getShapeBounds.height ? getShapeBounds.height : ShapeHeight;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    shapeY = intY - ShapeHeight / 2;
                    shapeX = intX - ShapeWidth / 2;
                    ShapeWidth = ShapeWidth;
                    ShapeHeight = ShapeHeight;
                }
                if (this.pointshape == "rhombus") {
                    x1 = intX;
                    y1 = intY - ShapeHeight / 2;
                    x2 = intX - ShapeWidth / 2;
                    y2 = intY;
                    x3 = intX;
                    y3 = intY + ShapeHeight / 2;
                    x4 = intX + ShapeHeight / 2;
                    y4 = intY;
                    strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
                }

                if (this.pointshape == "rect" || this.pointshape == "square") {
                    svgCircle = this.data.SVGUtils.createSVGElement("rect");
