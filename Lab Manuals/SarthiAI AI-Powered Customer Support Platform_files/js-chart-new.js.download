            texttransform["val"] = transformValue;
            textopacity["elementvalue"] = "chartgrouplabel" + indexVale + "dynamicalign";
            texttransform["elementvalue"] = "chartgrouplabel" + indexVale + "dynamicalign";
            textopacity["val"] = textOpacityValue;
            let dpTitleFontSize = [{ label: "auto", data: "auto" }];
