function SimpleHalfPieChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleHalfPieChart";
    this.maxAngle = 180;
    BasePieChart.call(this, argparent, argprops);
}
SimpleHalfPieChart.prototype = Object.create(BasePieChart.prototype);
SimpleHalfPieChart.prototype.constructor = SimpleHalfPieChart;

SimpleHalfPieChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleHalfPieSeries"](argparent, argprops);
}


SimpleHalfPieChart.prototype.doAddGraphicElement=function(argparent) {
    let intStartAngle = 180//parseInt(this.data.layout.data.item.drawAngle);
    let intEndAngle = intStartAngle;
    this.maxAngle =180;
    for (let i1 = 0; i1 < this.length; i1++) {
        let intAngle = (this.maxAngle / this.data.totalValue) * parseFloat(this.data.values[i1][0]);
        intEndAngle += intAngle;
        let intMidAngle = intStartAngle + (intEndAngle - intStartAngle) / 2;
        let pntCenterPointPad = this.distanceMeasurement(intMidAngle, 5);
        let eProps = {
            index: i1,
            angle: intAngle,
            midangle: intMidAngle,
            endangle: intEndAngle,
            startangle: intStartAngle,
            centerPointPad: pntCenterPointPad
        };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(0, 0);
        series.size(this.rectBaseSeries.width, this.rectBaseSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        intStartAngle = intEndAngle;
    }
}



