BaseColumnChart.prototype.calculateProjectionDisableWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let disableProjectionLength = childLength - projectionLength;
    let width = disableProjectionLength * indualWidth;
    let x = 0;
    return { x: containerElement.offsetLeft + this.rectBaseSeries.x + x, width: width };
};

BaseColumnChart.prototype.calculateProjectionWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let width = projectionLength * indualWidth;
    let x = startingProjectionPoint * indualWidth;
    return { x: containerElement.offsetLeft + this.rectBaseSeries.x + x, width: width };
};
BaseColumnChart.prototype.doAddGraphicElement = function (argparent, length, index = 0) {
    let padding = 10;
    let moveX = this.rectSeries.y;
    let currentLength = length ? length : this.length;
    if (this.data.layout.secondaryElement) {
        this.data.headerHeight = this.rectBaseSeries.width * 0.2;
        this.rectSeries.width = this.rectSeries.width - this.data.headerHeight / currentLength;
        currentLength = currentLength;
    }
    // if (this.data.layout.itemSpace) {
    //     this.rectSeries.width = this.rectSeries.width - this.data.layout.itemSpace;
    // }
    let chartGroupCreated = false;
    let createGroupNode = false;
    let chartGroupNodeCount = 0;
    if (this.data._stackedDynamicSize && this.data.seriesItemTotalWidth > 0) {
        let totalWidth = this.rectSeries.width * this.length;
        let minWidthValue = Math.min(...this.data.arrSeriesItemWidth) || 0;
        for (let i1 = index; i1 < currentLength; i1++) {
            let groupIndex = parseInt(this.data._groupNodes[i1].index) - 1;
            let seriesWidth = totalWidth * this.data.arrSeriesItemWidth[i1];
            let eProps = { index: i1, chartgroupwidth: this.chartGroupWidth[groupIndex], minwidth: minWidthValue * totalWidth };
            let series = this.seriesInstance(argparent, eProps);
            series.ChartHelper = this.ChartHelper;
            series.ChartUtils = this.ChartUtils;
            series.move(moveX, this.rectSeries.y);
            series.size(seriesWidth, this.rectSeries.height);
            series.data = this.data;
            this.items[i1] = series;
            moveX += seriesWidth;
        }
    } else {
        for (let i1 = index; i1 < currentLength; i1++) {
            let groupIndex = parseInt(this.data._groupNodes[i1].index) - 1;
            if (!chartGroupCreated && this.data._groupNodes[i1].value == "true" && this.data.chartGroup && this.data.arrChartGroupDatas[groupIndex].length > 1) {
                chartGroupCreated = true;
                createGroupNode = true;
            }
            if (chartGroupCreated && this.data._groupNodes[i1].value == "false" && this.data.chartGroup) {
                chartGroupCreated = false;
                createGroupNode = false;
            }
            let seriesWidth = this.rectSeries.width;
            let eProps = { index: i1, chartgroupwidth: this.chartGroupWidth[groupIndex], createGroupNode: createGroupNode };
            let series = this.seriesInstance(argparent, eProps);
            series.ChartHelper = this.ChartHelper;
            series.ChartUtils = this.ChartUtils;
            series.move(moveX, this.rectSeries.y);
            series.size(seriesWidth, this.rectSeries.height);
            series.data = this.data;
            this.items[i1] = series;
            moveX += this.rectSeries.width;
            if (createGroupNode) {
                createGroupNode = false;
            }
        }
    }

    // this.adjustaxisline(argparent)
};
BaseColumnChart.prototype.adjustaxisline = function (argparent) {
    let bottomTitle = this.parent.querySelector("#axis-title-left");
    let graphicArea = this.items[0].parent.querySelector(".seriesitemcond");
    if (graphicArea && bottomTitle) {
        let graphicHeight = graphicArea.clientHeight;
        let titleGridcalCulation = (graphicHeight - 10) / this.props.gridsize;
        bottomTitle.style.height = parseInt(titleGridcalCulation) * this.props.gridsize + "px";
    }
};
// ---------------------------------- Enhancement ---------------------------------

BaseColumnChart.prototype.doAddLegendDesk = function (argParent) {
    if (((this.seriesItemLengthValue > 1 || this.data.seriesanimation) && this.data.baseProperties.maxAllowedSeriesItems > 1) || this.data._secondaryLineChart || this.data.chartName == "waterfallchart" || this.data.chartName == "shapesComparisonPieChart") {
        const element = this.ChartHelper.createDivElement();
        element.className = "legend";
        element.style.maxWidth = argParent.clientWidth + "px";
        element.style.maxHeight = argParent.clientHeight - 40 + "px";
        if (this.legendposition == "bottom" || this.legendposition == "right") element.style.order = 1;
        if (this.data.layout.legendWidth && (this.legendposition == "left" || this.legendposition == "right")) {
            element.style.maxWidth = this.data.layout.legendWidth;
            element.style.width = this.data.layout.legendWidth;
        }
        argParent.appendChild(element);
        let extraGridWidth = 0;
        if (this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            extraGridWidth = this.gridvalueSize + this.tickMarkSize;
        }
        let eProps = { maxsize: this.rectBaseLegend, legendlabel: true, extraGridWidth: extraGridWidth };
        this.addLegendDeskElements(element, eProps);
    }
};

BaseColumnChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    if (this.data.baseProperties.legend && this.data.showLegend) {
        if (this.data.legendposition != "bottom" && this.data.legendposition != "top") {
            this.rectBaseLegend.height -= 50;
        }
        let legend = new window["Legend"](argParent, argProps, true);
        legend.ChartHelper = this.ChartHelper;
        legend.ChartUtils = this.ChartUtils;
        legend.move(0, 0);
        legend.size(this.rectBaseLegend.width, this.rectBaseLegend.height);
        legend.data = this.data;
    }
    //this.doMeasurementComputation(argParent);
    return null;
};

BaseColumnChart.prototype.doAddGridDesk = function (argProps) {
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.gridvalueSize = this.data.gridValueSize;
    }
    if (this.data._showTickMark && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.tickMarkSize = 12;
    }
    // if (this.data.layout.parenthPosition == "center" && (this.legendposition == "right" || this.legendposition == "left") && this.data._directionenable) {
    //     if (this.legendposition == "left") this.legendposition = "right";
    //     else if (this.legendposition == "right") this.legendposition = "left";
    // }
    let eParent = this.parent;
    let eLabel = eParent.getElementsByClassName("label");
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let Container = eParent.getElementsByClassName("columnContainer");
    let negseries = eParent.getElementsByClassName("bottomseriesitem");
    let statisticalValue = eParent.getElementsByClassName("statistcalelement");
    let groupLabelNodeClientHeight = Container?.[0]?.querySelector(".chartgroupLabelBaseElement")?.clientHeight || 0;
    let BaseSeriesElement = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series") : "";
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series")?.querySelector(".columnContainer") : "";
    let secondarySeriesWidth = secondarySeries ? (secondarySeries.dataset.gridWidth ? parseFloat(secondarySeries.dataset.gridWidth) : secondarySeries.clientWidth) : 0;
    let statisticalValueBounds = statisticalValue[0] ? { width: parseInt(statisticalValue[0].clientWidth), height: parseInt(statisticalValue[0].clientHeight) } : { width: 0, height: 0 };
    if (negseries[0] && negseries[0].children.length > 0) {
        let childSeries = eParent.querySelectorAll(".basebottomgraphic");
        negseries = childSeries.length > 0 ? childSeries : negseries;
    }
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        if (this.seriesItemLengthValue > 1 && this.legendposition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid && Container) {
            Container[0].style.boxSizing = "unset";
            if (this.data._directionenable) {
                Container[0].style.paddingright = "60px";
            } else {
                Container[0].parentNode.paddingLeft = "60px";
            }
        }
    }
    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    let eValue = eParent.getElementsByClassName("value");
    let gridMaxValue = eParent.querySelector(".gridmaxValue");
    let gridNegativeValue = eParent.querySelector(".gridnegativemaxValue");
    let ePlaceholder = eParent.getElementsByClassName("primaryplaceholder");
    let labelBounds = eLabel[0] ? { width: parseInt(eLabel[0].clientWidth), height: parseInt(eLabel[0].clientHeight) } : { width: 0, height: 0 };
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };
    let placeholderBounds = { width: 0, height: 0 };

    let VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueBounds.height) : 0;
    let negativeValueHeight = 0;
    if (gridMaxValue) {
        VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false ? parseFloat(gridMaxValue.clientHeight) : 0;
    }
    if (this.data.chartName == "verticalDumbellChart") {
        VlaueHeight = 0;
    }
    if (this.data.highlightDifference.display) {
        this.highlightDifferenceHeight = VlaueHeight > 0 ? this.data._hdHight1 : this.data._hdHight2;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.indualHighlight) {
        this.highlightDifferenceHeight = VlaueHeight > 0 ? this.data._hdHight1 : this.data._hdHight2;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.totalValueBounds?.height) {
        VlaueHeight += this.data.totalValueBounds?.height;
    }
    if (this.data.layout.statisticalInset == "outer" || this.data.layout.statisticalInset == "bgoutside") {
        VlaueHeight += statisticalValueBounds.height;
    }
    if (this.data.secondaryLineValueMaxHeight && !this.data.trendline) {
        VlaueHeight += parseFloat(this.data.secondaryLineValueMaxHeight);
    }
    if (this.data.extraElementBounds?.height) {
        VlaueHeight += this.data.extraElementBounds?.height;
    }
    this.valueHeight = VlaueHeight;
    if (gridNegativeValue) {
        negativeValueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(gridNegativeValue.clientHeight) : 0;
    }
    this.negativeValueHeight = negativeValueHeight;
    totalBounds = eSeries[0] ? { width: parseFloat(eSeries[0].clientWidth), height: parseFloat(eSeries[0].clientHeight) - parseFloat(VlaueHeight) } : { width: 0, height: 0 };
    if (this.data.totalValueBounds?.height && this.data.chartName == "lineChart") {
        totalBounds.height += this.data.totalValueBounds?.height;
    }
    if (this.data.layout.showPlaceholder && !this.data.layout.placeholderInset && ePlaceholder[0]) {
        placeholderBounds = { width: parseFloat(ePlaceholder[0].clientWidth), height: parseFloat(ePlaceholder[0].clientHeight + 10) };
    }

    let columnstart = parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize);
    let columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    let legendArea = this.parent.querySelector(".legend");
    if ((this.data.stackedChart || this.data.chartName == "lineChart" || this.data.chartName == "columnSimpleRectangle") && this.legendposition == "left") {
        this.rectBaseSeries.x += legendArea.clientWidth;
        columnstart = Math.round(parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize));
        columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    }
    if (this.data.stackedChart && this.legendposition == "top") {
        this.rectBaseSeries.x += eSeries[0].offsetLeft - 4;
        columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
    }
    let element = document.createElement("div");
    element.className = "grid griddesk accent1 clsMultiColorParent";
    element.style.position = "absolute";
    element.classList.add("th-section" + 1);

    // Calculate position and size using absolute positioning instead of grid
    let left = columnstart * this.props.gridsize;
    let top = parseInt((this.rectBaseSeries.y + this.legendY + VlaueHeight) / this.props.gridsize) * this.props.gridsize;
    let width = (columnEnd - columnstart) * this.props.gridsize;
    let height = parseInt(totalBounds.height + this.legendY);

    if (this.data._allNegativeValue) {
        top = parseInt((this.rectBaseSeries.y + this.legendY) / this.props.gridsize) * this.props.gridsize;
    }

    if (this.data.chartFlip) {
        if (negBounds.height > 0) {
            top = parseInt((eSeries[0].offsetTop + groupLabelNodeClientHeight + VlaueHeight + this.legendY) / this.props.gridsize) * this.props.gridsize;
        } else {
            top = Math.round(parseInt((eSeries[0].offsetTop + groupLabelNodeClientHeight + this.legendY) / this.props.gridsize)) * this.props.gridsize;
        }
        height = parseInt((eSeries[0].offsetTop + groupLabelNodeClientHeight + totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize - top;
    }

    if (height < 0) {
        height = parseInt((totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize;
    }

    element.style.left = left + "px";
    element.style.top = top + "px";
    element.style.width = width + "px";
    element.style.height = height + "px";
    eParent.appendChild(element);
    let DiffernceValue = 0;
    let dummeyBaseLine = 0;
    if (this.data.layout.parenthPosition == "center") {
        let borderWidth = 0;
        if (this.data.chartBorder) {
            borderWidth = this.data._chartBorderWidth;
        }
        DiffernceValue = element.clientWidth - this.gridvalueSize - secondarySeriesWidth;
        columnstart = columnstart + Math.round((element.clientWidth - secondarySeriesWidth) / 2 / this.props.gridsize);
        let extraPropertisWidth = Math.round((borderWidth + this.tickMarkSize) / this.props.gridsize);
        if (extraPropertisWidth > 0) {
            columnstart = columnstart - extraPropertisWidth;
        }
        if (columnstart > 0) {
            element.style.left = columnstart * this.props.gridsize + "px";
        }
        let AxisTitle = eParent.querySelector("#axis-title-left");

        let baseLineValue = 0;
        let axisPadding = 0;
        // if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
        //     baseLineValue = 30;
        // }
        // if (this.data.data.getAttribute("axisbaseline") || this.data.data.getAttribute("data-baseline")) {
        //     dummeyBaseLine = 30;
        // }
        let topValue = Container.length > 0 ? Container[0].parentNode.offsetLeft + Container[0].offsetLeft + BaseSeriesElement.offsetLeft - this.gridvalueSize : 0;
        let legendLeft = Container[0].parentNode.querySelector(".legend") && Container[0].parentNode.querySelector(".legend").children[0] ? Container[0].parentNode.querySelector(".legend").children[0].offsetLeft : null;
        // if(legendLeft&&legendLeft<topValue&&this.legendposition == "left"){
        //     topValue = legendLeft;
        // }
        topValue = topValue <= 4 ? 4 : topValue + dummeyBaseLine;

        if (Container.length > 0) {
            let newColumnStart = Math.round(topValue / this.props.gridsize) - extraPropertisWidth;
            element.style.left = newColumnStart * this.props.gridsize + "px";
            columnstart = newColumnStart;
            columnstart = columnstart < 1 ? 1 : columnstart;
        }
        if (this.data._directionenable) {
            columnstart = Math.round(DiffernceValue / 2 / this.props.gridsize) - extraPropertisWidth;
            if (this.legendposition == "left" && legendLeft > 0) {
                columnstart = Math.round(columnstart + this.legendWidth / 4);
            }
            columnstart = columnstart < 1 ? 1 : columnstart;
            element.style.left = columnstart * this.props.gridsize + "px";
        }
        if (AxisTitle) {
            if (this.legendposition != "left") {
                let axisTitleColumnStart = columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1 ? 1 : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
                AxisTitle.style.left = axisTitleColumnStart * this.props.gridsize + "px";
                AxisTitle.style.width = (columnstart - axisTitleColumnStart) * this.props.gridsize + "px";
                if (this.legendposition == "bottom" && Container[0].parentNode.querySelector(".legend")) {
                    AxisTitle.children[0].style.width = Container[0].clientHeight + "px";
                    let gridRowStart = window.getComputedStyle(AxisTitle)["grid-row-start"];
                    let gridRowEnd = parseInt(gridRowStart) + Math.round(Container[0].clientHeight / this.props.gridsize);
                    AxisTitle.style.height = (gridRowEnd - parseInt(gridRowStart)) * this.props.gridsize + "px";
                }
            } else {
                if (this.legendposition == "left") {
                    let axisTitleColumnStart =
                        columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1
                            ? 1
                            : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
                    AxisTitle.style.left = axisTitleColumnStart * this.props.gridsize + "px";
                    AxisTitle.style.width = (columnstart - Math.round(this.legendWidth / this.props.gridsize) - axisTitleColumnStart) * this.props.gridsize + "px";
                }
            }
            if (this.data._directionenable) {
                element.style.left = (columnstart + Math.round(axisTitleSize / this.props.gridsize)) * this.props.gridsize + "px";
            }
        }
        let gridStart = BaseSeriesElement ? BaseSeriesElement.style.gridColumnStart : 0;
        let BaseSeriesWidth = BaseSeriesElement ? BaseSeriesElement.clientWidth : 0;
        let legendAreaWidth = this.legendWidth > 0 && (this.legendposition == "left" || this.legendposition == "right") ? this.legendWidth : 0;
        if (this.data.showSeriesItemLabel) {
            legendAreaWidth = this.seriesitemLabelLongLabelWidth;
        }
        // if (AxisTitle) {
        //     let totalWidth = legendAreaWidth + secondarySeriesWidth;
        //     BaseSeriesElement.style.width = totalWidth + "px";
        //     let difference = BaseSeriesWidth - totalWidth;
        //     let gridValueSize = Math.round(difference / this.props.gridsize);
        //     if (gridValueSize > 0) {
        //         BaseSeriesElement.style.gridColumnStart = parseInt(gridStart) + gridValueSize + 4;
        //     }
        // }
    } else {
        if (this.legendWidth > 0 && this.legendposition == "left") {
            if (columnstart > 0) {
                element.style.left = Math.round((Container[0].offsetLeft + Container[0]?.parentNode?.offsetLeft) / this.props.gridsize) * this.props.gridsize + "px";
            }
        }
    }
    let rectSeries = {
        x: 0,
        y: 0,
        width: secondarySeriesWidth != 0 && (this.data.layout.parenthPosition == "center" || this.data.layout.parenthPosition == "left") ? secondarySeriesWidth + this.gridvalueSize + this.seondaryGridValueSize : element.clientWidth,
        height: totalBounds.height,
        top: element.offsetTop > element.clientHeight ? 10 - negBounds.height : element.offsetTop - negBounds.height,
        left: element.offsetLeft + this.gridvalueSize + dummeyBaseLine + this.tickMarkSize,
    };
    if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        rectSeries.width = secondarySeriesWidth != 0 && this.data.layout.parenthPosition == "left" ? secondarySeriesWidth : rectSeries.width;
    }
    // if(this.data.chartName == "lineChart"){
    //     rectSeries.width = secondarySeriesWidth != 0 && (this.data.layout.parenthPosition == "center" || this.data.layout.parenthPosition == "left") ? secondarySeriesWidth : element.clientWidth;
    // }
    if (this.data.layout.parenthPosition == "center" || this.data.hasCenter) {
        rectSeries.left = dummeyBaseLine + this.tickMarkSize + this.gridvalueSize;
    } else {
        rectSeries.left = rectSeries.left >= 100 ? this.gridvalueSize + this.tickMarkSize : rectSeries.left;
    }

    rectSeries.top = rectSeries.top > element.clientHeight ? element.clientHeight : rectSeries.top;
    // if (this.data.stackedChart && this.legendposition == "left" && this.data.layout.parenthPosition != "center") {
    //     rectSeries.left += legendArea.clientWidth + this.gridvalueSize;
    // }
    if (this.data.stackedChart && this.legendposition == "top") {
        rectSeries.top += legendArea.clientHeight;
    }
    let graphicContainer = eParent.querySelector(".chartgraphic");
    let grid3dspace = graphicContainer && graphicContainer.getAttribute("data-movey") ? graphicContainer.getAttribute("data-movey") : 0;
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        valueHeight: VlaueHeight,
        negativeHeight: negativeValueHeight,
        negBounds: negBounds,
        gridvalueSize: { width: this.gridvalueSize, height: 0 },
        gridthickMarkerSize: { width: this.tickMarkSize, height: 0 },
        move3dspace: grid3dspace,
        projectionLabelHeight: this.projectionHeight,
        type: "vertical",
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    this.addGridDeskElement(element, eProps);
    if (this.data.stackedChart && this.legendposition == "top") {
        let xaxis = this.parent.querySelector(".axisXlines");
        let legendArea = this.parent.querySelector(".legend");
        if (xaxis && legendArea) {
            let topElementValue = xaxis.parentNode.offsetTop + legendArea.clientHeight;
            xaxis.parentNode.style.top = topElementValue + "px";
        }
        let yaxis = this.parent.querySelector(".axisYlines");
        if (yaxis) {
            yaxis.parentNode.style.top = legendArea.clientHeight + "px";
        }
    }
    let axisLine = element.querySelector("#xaxis");
    let yAxis = element.querySelector("#yaxis");
    if (this.legendposition == "top" && yAxis) {
        yAxis.style.top = "unset";
    }
    if (axisLine) axisLine.style.top = rectSeries.height - negBounds.height - parseFloat(grid3dspace) + "px";
    if (axisLine && this.data.chartFlip) {
        axisLine.style.bottom = rectSeries.height - negBounds.height - parseFloat(grid3dspace) + "px";
        axisLine.style.removeProperty("top");
    }
    if (this.data.minValue < 0) {
        let containerElement = element.querySelectorAll(".gridcontainer");
        let gridvalueContainer = element.querySelectorAll(".gridValuecontainer");
        if (containerElement.length > 1 && gridvalueContainer.length > 1) {
            if (this.data.chartFlip) {
                containerElement[1].style.bottom = containerElement[0].clientHeight + "px";
                gridvalueContainer[1].style.bottom = containerElement[0].clientHeight + 9 + "px";
                if (axisLine) {
                    axisLine.style.bottom = containerElement[0].clientHeight + "px";
                    axisLine.style.removeProperty("top");
                }
                gridvalueContainer[0].style.marginTop = negBounds.height - negativeValueHeight + "px";
                containerElement[0].style.marginTop = negBounds.height - negativeValueHeight + "px";
            } else if (!this.data._allNegativeValue) {
                containerElement[1].style.top = containerElement[0].clientHeight + "px";
                gridvalueContainer[1].style.top = containerElement[0].clientHeight + "px";
                if (axisLine) axisLine.style.top = containerElement[0].clientHeight - parseFloat(grid3dspace) + "px";
            }
            if (this.data._allNegativeValue && !this.data.chartFlip) {
                if (axisLine) axisLine.style.top = "0px";
            }
        }
    }
};

BaseColumnChart.prototype.addGridDeskElement = function (argParent, argProps) {
    if (this.data.baseProperties.grid && this.data.layout.labelVPosition != "top") {
        if (this.data.stackedChart) this.voData.rangeTotal = this.voData.maxStackValueTotal;
        let grid = new window["Grid"](argParent, argProps);
        grid.data = this.data;
        grid.rectSeries = argProps.rectSeries;
        grid.move(0, 0);
        grid.negBounds = argProps.negBounds;
        grid.chartHelper = this.ChartHelper;
        grid.size(argProps.rectSeries.width, argProps.rectSeries.height);
    }
    return null;
};

BaseColumnChart.prototype.doAddBaseLineDesk = function () {
    let eParent = this.parent;
    let eLabel = eParent.getElementsByClassName("label");
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let gridMaxValue = eParent.querySelector(".gridmaxValue");
    let eValue = eParent.getElementsByClassName("value");
    let ePlaceholder = eParent.getElementsByClassName("primaryplaceholder");
    let columnContainer = eParent.getElementsByClassName("columnContainer")[0];
    let Container = eParent.getElementsByClassName("columnContainer");
    let negseries = eParent.getElementsByClassName("bottomseriesitem");
    let baseSeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series") : "";
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series").querySelector(".columnContainer") : "";
    let secondarySeriesWidth = secondarySeries?.clientWidth || 0;
    if (secondarySeries?.dataset.gridWidth) {
        secondarySeriesWidth = parseFloat(secondarySeries.dataset.gridWidth);
    } else {
        let paddingValue = window.getComputedStyle(secondarySeries).paddingLeft;
        let paddingValueRight = window.getComputedStyle(secondarySeries).paddingRight;
        secondarySeriesWidth = secondarySeries.clientWidth - parseFloat(paddingValue) - parseFloat(paddingValueRight);
    }

    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };

    let labelBounds = eLabel[0] ? { width: parseInt(eLabel[0].clientWidth), height: parseInt(eLabel[0].clientHeight) } : { width: 0, height: 0 };
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };
    let placeholderBounds = { width: 0, height: 0 };
    if (this.data.rangeNegative < 0) {
        let elementHeight = eSeries[0].querySelector(".topseriesitem").clientHeight;
        totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(elementHeight) } : { width: 0, height: 0 };
    }
    if (this.data.layout.showPlaceholder && !this.data.layout.placeholderInset && ePlaceholder[0]) {
        placeholderBounds = { width: parseInt(ePlaceholder[0].clientWidth), height: parseInt(ePlaceholder[0].clientHeight) };
    }

    this.legendHeight = 0;
    this.legendHeight = this.parent.querySelector(".legend") ? this.parent.querySelector(".legend").clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    let VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueBounds.height) : 0;
    if (gridMaxValue) {
        VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false ? parseFloat(gridMaxValue.clientHeight) : 0;
    }

    if (this.data.highlightDifference.display) {
        this.highlightDifferenceHeight = this.data._hdHight1;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.indualHighlight) {
        this.highlightDifferenceHeight = this.data._hdHight1;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.totalValueBounds?.height) {
        VlaueHeight += this.data.totalValueBounds?.height;
    }
    if (this.data.extraElementBounds?.height) {
        VlaueHeight += this.data.extraElementBounds?.height;
    }
    if (this.data.secondaryLineValueMaxHeight) {
        VlaueHeight += parseFloat(this.data.secondaryLineValueMaxHeight);
    }
    let baselineValue = 0;
    if (this.data._customProperties.showYAxisTitle) {
        baselineValue = 32;
    }
    totalBounds.height = totalBounds.height - VlaueHeight;
    let secondaryClientWidth = columnContainer.getAttribute("data-grid-width") ? parseFloat(columnContainer.getAttribute("data-grid-width")) : 0;

    let columnstart = parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize);
    let columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    let legendArea = this.parent.querySelector(".legend");
    if ((this.data.stackedChart || this.data.chartName == "lineChart" || this.data.chartName == "columnSimpleRectangle") && this.legendposition == "left") {
        this.rectBaseSeries.x += legendArea.clientWidth;
        columnstart = Math.round(parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize));
        columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    }
    if (this.data.stackedChart && this.legendposition == "top") {
        this.rectBaseSeries.x += eSeries[0].offsetLeft - 4;
        columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
    }

    let element = document.createElement("div");
    element.className = "axisbaseline";
    element.style.position = "absolute";

    // Calculate position and size using absolute positioning instead of grid
    let left = columnstart * this.props.gridsize;
    let top = parseInt((this.rectBaseSeries.y + this.legendY + VlaueHeight) / this.props.gridsize) * this.props.gridsize;
    let width = (columnEnd - columnstart) * this.props.gridsize;
    let height = parseInt((totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize;

    if (this.data.chartFlip) {
        top = parseInt((eSeries[0].offsetTop + VlaueHeight) / this.props.gridsize) * this.props.gridsize;
        height = parseInt((totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize;
    }

    element.style.left = left + "px";
    element.style.top = top + "px";
    element.style.width = width + "px";
    element.style.height = height + "px";
    eParent.appendChild(element);
    let DiffernceValue = 0;
    if (this.data.layout.parenthPosition == "center") {
        DiffernceValue = element.clientWidth - this.gridvalueSize - secondarySeriesWidth;
        if (this.data._directionenable) {
            columnstart = Math.round(DiffernceValue / 2 / this.props.gridsize);
        } else {
            columnstart = columnstart + Math.round((element.clientWidth - 40 - secondarySeriesWidth) / 2 / this.props.gridsize);
        }
        if (columnstart > 0) {
            element.style.left = columnstart * this.props.gridsize + "px";
        }
        columnEnd = columnstart + Math.round(secondarySeriesWidth / this.props.gridsize);
        if (columnEnd > 0) {
            element.style.width = (columnEnd - columnstart) * this.props.gridsize + "px";
        }
        let AxisTitle = eParent.querySelector("#axis-title-left");

        let baseLineValue = 0;
        // if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
        //     baseLineValue = 30;
        // }
        let dummeyBaseLine = 0;
        // if (this.data.data.getAttribute("axisbaseline") || this.data.data.getAttribute("data-baseline")) {
        //     dummeyBaseLine = 30;
        // }
        let topValue = Container.length > 0 ? Container[0]?.parentNode?.offsetLeft + baseSeries?.offsetLeft + Container[0]?.offsetLeft - this.tickMarkSize : 0;
        topValue = topValue <= 4 ? 4 : topValue + dummeyBaseLine;
        if (Container.length > 0 && !AxisTitle) {
            element.style.left = Math.round(topValue / this.props.gridsize) * this.props.gridsize + "px";
        }
        // if (AxisTitle) {
        //     if (this.legendposition != "left") {
        //         AxisTitle.style.gridColumnStart =
        //             columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1
        //                 ? 1
        //                 : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
        //         AxisTitle.style.gridColumnEnd = columnstart;
        //     } else {
        //         if (this.legendposition == "left") {
        //             AxisTitle.style.gridColumnStart =
        //                 columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1
        //                     ? 1
        //                     : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
        //             AxisTitle.style.gridColumnEnd = columnstart - Math.round(this.legendWidth / this.props.gridsize);
        //         }
        //     }
        // }
    } else {
        // if (this.data.layout.parenthPosition == "left" && secondarySeriesWidth > 0) {
        //     columnEnd = columnstart + Math.round(secondarySeriesWidth / this.props.gridsize);
        //     if (columnEnd > 0) {
        //         element.style.gridColumnEnd = columnEnd;
        //     }
        // }
        if (this.legendWidth > 0 && this.legendposition == "left") {
            if (columnstart > 0) {
                element.style.left = Math.round(Container[0].offsetLeft / this.props.gridsize) * this.props.gridsize + "px";
            }
        }
    }

    if (this.data.chartFlip) {
        if (negBounds.height > 0) {
            element.style.top = parseInt((eSeries[0].offsetTop + VlaueHeight + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
        } else {
            element.style.top = Math.round(parseInt((eSeries[0].offsetTop + this.legendY) / this.props.gridsize)) * this.props.gridsize + "px";
        }
        element.style.height = parseInt((eSeries[0].offsetTop + totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
    }
    let gridDeskElement = eParent?.querySelector(".griddesk");
    let gridColumnStart = parseInt(gridDeskElement?.style.gridColumnStart);
    let gridColumnEnd = parseInt(gridDeskElement?.style.gridColumnEnd);
    if (element && gridColumnStart && gridColumnEnd) {
        element.style.left = gridColumnStart * this.props.gridsize + "px";
        element.style.width = (gridColumnEnd - gridColumnStart) * this.props.gridsize + "px";
    }

    let rectSeries = { x: 0, y: 0, width: secondaryClientWidth ? secondaryClientWidth : element.clientWidth, height: element.clientHeight, top: element.offsetTop, left: element.offsetLeft };
    if (this.data.stackedChart && this.legendposition == "top") {
        rectSeries.top += legendArea.clientHeight;
    }
    rectSeries.width = rectSeries.width - (this.gridvalueSize + this.tickMarkSize);
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        type: "vertical",
        chartHelper: this.ChartHelper,
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    this.viewport.width = 10;
    this.addAxisBaselineDeskElement(element, eProps);
    if (this.data.layout.parenthPosition == "center") {
        let baseLineValue = element.querySelector(".baselinevalue");
        if (baseLineValue) {
            let baseLineValueWidth = baseLineValue.clientWidth;
            let baseLineValuegrid = Math.round(baseLineValueWidth / this.props.gridsize);
            let gridStartValue = parseInt(element.style.left) / this.props.gridsize - baseLineValuegrid;
            if (gridStartValue > 0) {
                element.style.left = gridStartValue * this.props.gridsize + "px";
            }
        }
    }
    if (element && gridColumnStart && gridColumnEnd) {
        element.style.left = gridColumnStart * this.props.gridsize + "px";
        element.style.width = (gridColumnEnd - gridColumnStart) * this.props.gridsize + "px";
        let lineElement = element.querySelector(".baselineleft");
        if (lineElement) {
            lineElement.style.left = this.gridvalueSize + this.tickMarkSize + "px";
        }
        let baseLineValue = element.querySelector(".baselinevalue");
        if (baseLineValue) {
            baseLineValue.style.width = this.gridvalueSize + "px";
            baseLineValue.style.display = "flex";
            baseLineValue.style.justifyContent = "center";
        }
    }
};

BaseColumnChart.prototype.addAxisBaselineDeskElement = function (argParent, argProps) {
    let axisbaseline = new window["AxisBaseLine"](argParent, argProps);
    axisbaseline.data = this.data;
    axisbaseline.rectSeries = argProps.rectSeries;
    axisbaseline.move(0, 0);
    axisbaseline.size(argProps.rectSeries.width, argProps.rectSeries.height);
};
BaseColumnChart.prototype.doAddLineGraphicElement = function (argparent) {
    let padding = 10;
    let moveX = this.rectSeries.y;

    let element = document.createElement("div");
    element.style.width = "100%";
    element.style.height = "100%";
    element.style.display = "flex";
    element.style.flexDirection = "column";
    element.style.position = "relative";
    element.style.alignItems = "center";
    argparent.appendChild(element);

    let serieselement = document.createElement("div");
    serieselement.style.width = "100%";
    serieselement.style.height = "100%";
    serieselement.style.display = "flex";
    serieselement.style.position = "absolute";
    if (this.data.comparisonStyle == "style1") {
        serieselement.style.top = 50 + "px";
    }
    element.appendChild(serieselement);

    this.rectSeries.y += 40;
    this.rectSeries.height -= 40;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(serieselement, eProps);
        series.move(moveX, this.rectSeries.y);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveX += this.rectSeries.width;
    }

    let labelElement = element.getElementsByClassName("label")[0];
    let containerHeight = element.querySelector("#seriesitemcond-1").clientHeight;
    minHeight = labelElement ? labelElement.clientHeight : 0;
    minHeight += this.data._customProperties.showXAxisTitle ? 40 : 0;
    let subelement = document.createElement("div");
    subelement.style.width = "100%";
    subelement.style.height = this.state.height - minHeight + "px";
    subelement.style.display = "flex";
    subelement.style.position = "absolute";
    if (this.data.comparisonStyle == "style1") {
        subelement.style.top = 50 + "px";
    }
    element.appendChild(subelement);
    serieselement.remove();
    element.appendChild(serieselement);
    if (this.data.comparisonStyle == "style1") {
        this.doAddTextElement(element);
    }
    this.createPathSVG(subelement, containerHeight, element);
};

BaseColumnChart.prototype.createPathSVG = function (argparent, containerHeight, element) {
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = 5;
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.bgFill = this.style.bgFill;
    this.gradient = this.style.bgFillType == "gradient";
    this.pointshape = this.voData.connectorLineStyle != "valueincircle";
    this.dashedarray = this.data.connectorLinedashArray;

    this.state.height -= 40;
    let sereiesX = 20;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "series-common",
        class: "commonitem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, sereiesX),
        y: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeries.y),
        width: this.data.SVGUtils.createPercentValue(this.state.width, this.state.width),
        height: this.data.SVGUtils.createPercentValue(this.state.height, this.state.height),
        "data-width": this.state.width,
        "data-height": this.state.height,
    });
    argparent.appendChild(svgElement);

    ///
    let seriesItemLength = this.seriesItemLengthValue;
    let intPreviousX = 0;
    let intPreviousY = 0;
    let intPreviousProjectionX = 0;
    let intPreviousProjectionWidth = 0;
    for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
        let svgSeiesItem = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgSeiesItem, {
            id: "svgseriesitem-" + seriesItemIndex,
            class: "svgseriesitem",
            //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
        });

        if (this.dropshadow) {
            this.createDropShadow(svgElement);
            this.data.SVGUtils.assignAttributes(svgSeiesItem, {
                filter: "url(#dropshadow)",
            });
        }

        let strPath = "";
        let strAreaPath = "";
        let intX = "";
        let intY = "";
        let intStartYPoint = "";
        let intstartPoint = "";
        let strLinePathTo = "";
        let strPathTo = "";
        let svgAreaPath;
        if (this.bgFill) {
            svgAreaPath = this.data.SVGUtils.createSVGElement("path");
            svgSeiesItem.appendChild(svgAreaPath);
        }
        let svgPath = this.data.SVGUtils.createSVGElement("path");
        svgSeiesItem.appendChild(svgPath);
        let container;
        let seriesContainer;
        let seriesItemContainer;
        if (this.data.comparisonStyle == "style1") {
            let boolFistValueMax = false;
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                // let strLine = "";
                let svgLinePath = this.data.SVGUtils.createSVGElement("path");
                // intCircleRadius = this.data.hasEmphasis && this.data.emphasis[seriesIndex] == true ? 2 * 5 : 5;
                // let svgItems = this.items[seriesIndex];
                let intQX1;
                let intQX2;
                let intQY1;
                let intQY2;
                let intCY;
                let intCX;
                let intBeginY;
                let numMultiplyFactor = (containerHeight - (minHeight + intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (minHeight + height + intCircleRadius)) + intCircleRadius;
                itemY -= numValue > 0 ? 0 : minHeight + intCircleRadius;
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                    graphicContainer = seriesContainer[1].querySelector(".chartgraphic");
                    itemY = this.voData.connectorLineStyle == "valueincircle" ? seriesContainer[1].querySelector(".middleelement").offsetTop : seriesContainer[1].querySelector(".value").offsetTop;
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartgraphic");
                    itemY = this.voData.connectorLineStyle == "valueincircle" ? seriesContainer[0].querySelector(".middleelement").offsetTop : seriesContainer[0].querySelector(".value").offsetTop;
                }
                intX = sereiesX + this.rectSeries.width / 2 - intCircleRadius * 2;
                intY = itemY + intCircleRadius;
                intY = intY > containerHeight ? containerHeight - intCircleRadius : intY;
                intStartYPoint = itemY + graphicContainer.clientHeight;
                intstartPoint = intY;

                if (seriesIndex == 0) {
                    if (this.bgFill) intStartX = intX;
                    boolFistValueMax = parseFloat(this.voData.values[seriesIndex][seriesItemIndex]) > parseFloat(this.voData.values[seriesIndex + 1][seriesItemIndex]);
                    if (boolFistValueMax) {
                        intY = intY + (seriesContainer[0].querySelector(".value").clientHeight / 2 - 10);
                        intX = intX + seriesContainer[0].querySelector(".value").children[0].clientWidth / 2;
                    }
                    strPath += "M" + intX + "," + intY;
                    strAreaPath += this.bgFill ? "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " " : "M" + intX + "," + intY;
                    intPreviousX = intX;
                    intPreviousY = intY;
                    intBeginY = intPreviousY;
                }
                intCY = intY;
                intCX = intX;
                if (seriesIndex != 0) {
                    if (!boolFistValueMax && intY != intPreviousY) {
                        intY = intY + (seriesContainer[0].querySelector(".value").clientHeight / 2 - 10);
                        intX = intX - (seriesContainer[0].querySelector(".value").children[0].clientWidth / 2 + 10);
                    }
                    var p1x = intPreviousX;
                    var p1y = intPreviousY;
                    var p2x = intX;
                    var p2y = intY;

                    var mpx = (p2x + p1x) * 0.5;
                    var mpy = (p2y + p1y) * 0.5;

                    // angle of perpendicular to line:
                    var theta = Math.atan2(p2y - p1y, p2x - p1x) - Math.PI / 2;

                    // distance of control point from mid-point of line:
                    var offset = 120;

                    // location of control point:
                    var c1x = mpx + offset * Math.cos(theta);
                    var c1y = mpy + offset * Math.sin(theta);
                    c1x = c1x < 0 ? 0 : c1x;
                    c1y = c1y < 0 ? 0 : c1y;

                    // construct the command to draw a quadratic curve
                    strPath = "M" + p1x + " " + p1y + " Q " + c1x + " " + c1y + " " + p2x + " " + p2y;
                    intPreviousX = intX;
                    intPreviousY = intY;
                }

                let dummeyPath = this.data.SVGUtils.createSVGElement("path");
                this.data.SVGUtils.assignAttributes(dummeyPath, {
                    visblity: "hidden",
                    d: strPath,
                });
                let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyPath);
                this.ChartUtils.addDummySvg(emptySvgNode, this.data.slideID);
                let pathLength;
                pathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.data.slideID);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
                // this.linethickness = 6;
                let clsstyle = this.ChartFonts.graphicFillColor(seriesIndex);
                let svgCircle = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(svgCircle, {
                    cx: intX,
                    cy: intY,
                    r: 6,
                    "fill-opacity": 0,
                    "stroke-opacity": 1,
                    "stroke-width": 5,
                    class: "item-circle moodanimation " + this.ChartFonts.secondaryStroke() + " " + clsstyle,
                    id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                    "data-cxvalues": intCX,
                    "data-animation": "itemcircle",
                    "data-animateitem": "itemcircle" + seriesItemIndex,
                    "data-pathLength": pathLength,
                    visibility: this.pointshape ? "visible" : "hidden",
                });
                // svgSeiesItem.appendChild(svgCircle);
                this.data.SVGUtils.assignAttributes(svgLinePath, {
                    d: strAreaPath,
                    class: "item-lines " + this.ChartFonts.secondaryStroke(),
                    "fill-opacity": 0,
                    "stroke-opacity": 0,
                    "stroke-linecap": "round",
                    "stroke-width": this.linethickness + "px",
                    id: "itemlines-" + seriesIndex + "_" + seriesItemIndex,
                });
                svgSeiesItem.appendChild(svgLinePath);
                sereiesX += this.rectSeries.width;
            }
            sereiesX = 20;
        } else {
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let numMultiplyFactor = (containerHeight - (minHeight + intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (minHeight + height + intCircleRadius)) + intCircleRadius;
                itemY -= numValue > 0 ? 0 : minHeight + intCircleRadius;
                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                    graphicContainer = seriesContainer[1].querySelector(".chartgraphic");
                    itemY = this.voData.connectorLineStyle == "valueincircle" ? seriesContainer[1].querySelector(".middleelement").offsetTop : seriesContainer[1].querySelector(".value").offsetTop;
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartgraphic");
                    itemY =
                        this.voData.connectorLineStyle == "valueincircle"
                            ? seriesContainer[0].querySelector(".middleelement").offsetTop + seriesContainer[0].querySelector(".middleelement").offsetHeight / 2
                            : seriesContainer[0].querySelector(".value").offsetTop + seriesContainer[0].querySelector(".value").offsetHeight - 10;
                }
                intX = sereiesX + this.rectSeries.width / 2 - intCircleRadius * 2;
                intY = itemY;
                intY = intY > containerHeight ? containerHeight - intCircleRadius : intY;

                if (seriesIndex == 0) {
                    if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                        height = seriesContainer[1].querySelector(".chartgraphic").clientHeight;
                        intStartYPoint = itemY - height;
                    } else {
                        height = seriesContainer[0].querySelector(".chartgraphic").clientHeight;
                        intStartYPoint = itemY + height;
                    }
                    if (this.bgFill) intStartX = intX;
                    strPath = strPath += "M" + intX + "," + intY;
                    if (this.bgFill) strAreaPath = "M" + intX + "," + intStartYPoint + "L" + intX + "," + intY;
                } else {
                    strPath += "L" + intX + "," + intY;
                    if (this.bgFill) strAreaPath += "L" + intX + "," + intY;
                }

                let dummeyPath = this.data.SVGUtils.createSVGElement("path");
                this.data.SVGUtils.assignAttributes(dummeyPath, {
                    visblity: "hidden",
                    d: strPath,
                });
                let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyPath);
                this.ChartUtils.addDummySvg(emptySvgNode, this.voData.slideID);
                let pathLength;
                pathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.voData.slideID);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
                // this.linethickness = 6;
                // this.gradient = true;
                let clsstyle = this.gradient && !this.bgFill ? this.ChartFonts.graphicFillColor(seriesIndex) : this.ChartFonts.graphicFillColor(0);
                let svgCircle = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(svgCircle, {
                    cx: intX,
                    cy: intY,
                    r: 6,
                    "fill-opacity": 0,
                    "stroke-opacity": 1,
                    "stroke-width": 5,
                    class: "item-circle moodanimation " + this.ChartFonts.secondaryStroke(),
                    "data-animation": "itemcircle",
                    "data-animateitem": "itemcircle" + seriesItemIndex,
                    "data-pathLength": pathLength,
                    visibility: this.pointshape ? "visible" : "hidden",
                });

                //svgSeiesItem.appendChild(svgCircle);
                sereiesX += this.rectSeries.width;
            }
            sereiesX = 20;
        }

        this.data.SVGUtils.assignAttributes(svgPath, {
            d: strPath,
            class: "item-path  moodanimation",
            "data-animation": "itemline",
            "stroke-linecap": "round",
            fill: "transparent",
            "stroke-opacity": "0.5",
            "stroke-width": this.linethickness + "px",
        });
        if (this.data.connectorLineColor != "nutral") {
            svgPath.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesItemIndex));

            this.data.SVGUtils.assignAttributes(svgPath, {
                "stroke-opacity": "1",
            });
        } else {
            svgPath.classList.add("contrast-fill");
        }

        if (this.dashedarray) {
            let defsTag = this.data.SVGUtils.createSVGElement("defs");
            let maskElement = this.data.SVGUtils.createSVGElement("mask");
            this.data.SVGUtils.assignAttributes(maskElement, {
                "data-maskelement": "true",
                id: this.data.slideID + "maskpath" + seriesItemIndex,
                fill: "none",
                stroke: "white",
            });
            defsTag.appendChild(maskElement);
            svgSeiesItem.appendChild(defsTag);
            let clonepath = svgPath.cloneNode(true);
            this.data.SVGUtils.assignAttributes(clonepath, {
                class: "",
                fill: "none",
                stroke: "white",
                "data-animation": "",
                "stroke-width": this.linethickness + "px",
                "stroke-dasharray": this.dashedarray,
            });
            maskElement.appendChild(clonepath);
            this.data.SVGUtils.assignAttributes(svgPath, {
                mask: "url(#" + this.data.slideID + "maskpath" + seriesItemIndex + ")",
                class: this.ChartFonts.secondaryStroke(),
                "data-mask": "true",
                "data-mask": "true",
            });
        }
        svgElement.appendChild(svgSeiesItem);
        if (this.gradient == true) {
            this.addGradient(svgPath, svgAreaPath, svgElement, this.bgFill);
        }
    }
};
BaseColumnChart.prototype.doAddTextElement = function (argparent) {
    let element = document.createElement("div");
    element.style.maxWidth = "30%";
    element.style.maxHeight = "50px";
    element.style.display = "flex";
    element.style.width = "auto";
    element.style.flexDirection = "column";
    element.style.position = "relative";
    element.style.overflow = "hidden";
    argparent.appendChild(element);
    let placeHolderText = document.createElement("div");
    element.appendChild(placeHolderText);
    placeHolderText.classList.add("moodanimation");
    placeHolderText.classList.add("p4");
    placeHolderText.classList.add("commonplaceholdertext");
    placeHolderText.classList.add("comparelabel");
    this.ChartHelper.setTextChangeListner(placeHolderText);
    placeHolderText.setAttribute("contenteditable", "true");
    placeHolderText.setAttribute("data-dck-selector", "true");

    placeHolderText.setAttribute("data-type", "comparelabel");
    placeHolderText.setAttribute("data-slideid", this.data.slideID);
    placeHolderText.setAttribute("data-id", this.index);
    placeHolderText.setAttribute("data-prompt-text", "Enter Label");
    placeHolderText.innerHTML = this.voData.comparetext;
    element.style.width = element.clientWidth + "px";
};
BaseColumnChart.prototype.CreateHightlightDifference = function () {
    let eParent = this.parent;
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let baseseies = eParent.querySelector("#base-series") && eParent.querySelector("#base-series").children[0] ? eParent.querySelector("#base-series").querySelector(".columnContainer").children[0] : "";
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series").querySelector(".columnContainer") : "";
    let secondarySeriesWidth = secondarySeries ? (secondarySeries.dataset.gridWidth ? parseFloat(secondarySeries.dataset.gridWidth) : secondarySeries.clientWidth) : 0;
    let negseries = eParent.getElementsByClassName("leftseriesitem");
    let totalBounds = baseseies ? { width: parseInt(baseseies.clientWidth - 10), height: parseInt(baseseies.clientHeight) } : { width: 0, height: 0 };

    let columnstart = this.rectBaseSeries.x / this.props.gridsize;
    let rowstart = this.rectBaseSeries.y;
    let columnEnd = (this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize;
    let legendArea = this.parent.querySelector(".legend");
    if (this.data.stackedChart && this.legendposition == "left") {
        columnstart = Math.round(parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize));
        columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    }
    if (this.data.stackedChart && this.legendposition == "right") {
        columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    }
    if (this.data.stackedChart && this.legendposition == "top") {
        columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
        rowstart += this.legendHeight;
    }

    let element = document.createElement("div");
    element.className = "highlightdiff " + this.data.highlightDifference.style;
    element.style.position = "absolute";
    element.style.left = columnstart * this.props.gridsize + "px";
    element.style.width = (columnEnd - columnstart) * this.props.gridsize + "px";
    element.style.top = Math.round(rowstart / this.props.gridsize) * this.props.gridsize + "px";
    element.style.height = Math.round((this.state.height - (rowstart + this.rectBaseSeries.height)) / -this.props.gridsize) * this.props.gridsize + "px";
    eParent.appendChild(element);
    let DiffernceValue = 0;
    if (this.data.chartFlip && eSeries && eSeries[0]) {
        element.style.top = Math.round((rowstart + eSeries[0].offsetTop) / this.props.gridsize) * this.props.gridsize + "px";
        element.style.height = Math.round((this.state.height - (rowstart + eSeries[0].offsetTop + this.rectBaseSeries.height)) / -this.props.gridsize) * this.props.gridsize + "px";
    }
    let elementRect = document.createElement("div");
    // if (this.data.layout.parenthPosition == "center") {
    elementRect.style.justifyContent = "center";
    element.style.justifyContent = "center";
    this.ParentElementPosition(element, this.data.layout.parenthPosition);
    // DiffernceValue = ((element.clientWidth)-secondarySeriesWidth)
    // columnstart = columnstart+Math.round((((DiffernceValue)/2))/this.props.gridsize)
    // if (columnstart > 0) {
    //     element.style.gridColumnStart = columnstart;
    // }
    //}
    elementRect.style.width = secondarySeriesWidth + "px";
    elementRect.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
    elementRect.style.display = "flex";
    elementRect.style.flexDirection = "row-reverse";

    element.appendChild(elementRect);
    for (let i = 0; i < this.data.highlightDifference.point1.length; i++) {
        let firstPoint = this.data.highlightDifference.point1[i];
        let secondPoint = this.data.highlightDifference.point2[i];
        if (this.data._stackedChart) {
            firstPoint = this.data.arrSeriesItemValueTotal[firstPoint];
            secondPoint = this.data.arrSeriesItemValueTotal[secondPoint];
        } else {
            firstPoint = this.data.values[firstPoint]?.[0] || "";
            secondPoint = this.data.values[secondPoint]?.[0] || "";
        }
        if (secondPoint && firstPoint) {
            let elementConatiner = document.createElement("div");
            elementConatiner.style.width = totalBounds.width + "px";
            elementConatiner.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
            elementConatiner.style.position = "absolute";
            elementRect.appendChild(elementConatiner);
            let rectSeries = { x: 0, y: 0, width: elementConatiner.clientWidth, height: elementConatiner.clientHeight, top: elementConatiner.offsetTop, left: elementConatiner.offsetLeft };
            let eProps = {
                highlightNodes: [this.data.highlightDifference.point1[i], this.data.highlightDifference.point2[i]],
                gridsize: this.props.gridsize,
                rectSeries: rectSeries,
                chartHelper: this.ChartHelper,
                index: i,
                type: "column",
                viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
            };
            let hightlightDiffernce = new window["hightlightDifference"](elementConatiner, eParent, eProps);
            hightlightDiffernce.data = this.data;
            hightlightDiffernce.chartHelper = this.ChartHelper;
            hightlightDiffernce.rectSeries = eProps.rectSeries;
            hightlightDiffernce.move(0, 0);
            hightlightDiffernce.size(eProps.rectSeries.width, eProps.rectSeries.height);
        }
    }
};
BaseColumnChart.prototype.createArrowHeader = function (svgNode) {
    if (true) {
        let arrowHeader = "";
        let type = "arrow";
        switch (type) {
            case "arrow":
                arrowHeader = this.data.SVGUtils.createSVGElement("path");
                if (arrowHeader) svgNode.appendChild(arrowHeader);
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    d: "M0,0 L0,15 L10,7.5 z",
                    class: "tertiary-fill cs-highlight-difference-arrow",
                    "data-customsmovey": "-7.5px",
                    "data-customsmovex": "-7.5px",
                    "data-customsmoveendy": "-7.5px",
                    "data-customsmoveendx": "-7.5px",
                    "data-customorgin": "null",
                });
                arrowHeader.style.transform = "translate(-7.5px,-7.5px)";
                let bounds = this.getArrowBounds(arrowHeader);
                if (bounds) {
                    let strBounds = "M" + bounds.x1 + "," + bounds.y1 + " L" + bounds.x2 + "," + bounds.y2 + " L" + bounds.x3 + "," + bounds.y3;
                    this.data.SVGUtils.assignAttributes(arrowHeader, {
                        d: strBounds,
                        "data-customsmovey": "-" + bounds.y3 + "px",
                        "data-customsmovex": "-" + bounds.y3 + "px",
                        "data-customsmoveendy": "-" + bounds.y3 + "px",
                        "data-customsmoveendx": "-" + bounds.y3 + "px",
                        "data-customorgin": "null",
                    });
                    arrowHeader.style.transform = "translate(-" + bounds.y3 + "px,-" + bounds.y3 + "px)";
                }
                return arrowHeader;
                break;
            case "circle":
                arrowHeader = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    cx: "5",
                    cy: "5",
                    r: "10",
                    class: "cf-fill-section-primary",
                });
                arrowHeader.style.transform = "translateY(-5px)";
                break;
            case "square":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 30,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "cf-fill-section-primary",
                });
                arrowHeader.style.transform = "translate(-15px,-15px)";
                break;
            case "rect":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 60,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "cf-fill-section-primary",
                });
                arrowHeader.style.transform = "translateY(-15px)";
                break;
            default:
                return null;
                break;
        }
    } else {
        if (this.data.layout.lineHeadShapeType == "svg") {
            for (let i1 = 0; i1 < this.data.asset.data.length; i1++) {
                if (this.data.asset.data[i1].id == "lineheadshape") {
                    let AssetGroup = this.data.SVGUtils.createSVGElement("g");
                    this.data.SVGUtils.assignAttributes(AssetGroup, {
                        id: "lineshape",
                        class: "cf-fill-section-primary",
                    });
                    let svgAsset = "";
                    if (this.data.asset.data[i1].data) {
                        svgAsset = this.data.asset.data[i1].data.cloneNode(true);
                        AssetGroup.appendChild(svgAsset);
                    } else {
                        svgAsset = this.data.slideObj.querySelector("#lineshape") && this.data.slideObj.querySelector("#lineshape").children.length > 0 ? this.data.slideObj.querySelector("#lineshape").children[0].cloneNode(true) : "";
                        if (svgAsset) AssetGroup.appendChild(svgAsset);
                    }

                    return AssetGroup;
                }
            }
        }
    }
};
BaseColumnChart.prototype.getArrowBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    if (width && height) {
        let x1 = 0;
        let y1 = 0;
        let x2 = 0;
        let y2 = width;
        let x3 = height;
        let y3 = width * 0.5;
        return { x1: x1, y1: y1, x2: x2, y2: y2, x3: x3, y3: y3 };
    } else {
        return null;
    }
};
BaseColumnChart.prototype.createCallout = function () {
    let calloutDiv = this.ChartHelper.createDivElement();
    calloutDiv.className = "indualhighlightcallout cs-highlight-difference-callout moodanimation";
    calloutDiv.dataset.animation = "indualhdcalloutdiv";
    let textCallout = this.ChartHelper.createDivElement();
    textCallout.className = "cs-dual-highlight-text-callout " + this.ChartFonts.hdClassName;
    textCallout.setAttribute("data-slideid", this.data.slideID);
    calloutDiv.appendChild(textCallout);
    return calloutDiv;
};
BaseColumnChart.prototype.getMultiSlideBounds = function () {
    let slideMaxCount = 10;
    let multiSlideEnableCount = 16;
    if (this.data.presentMode) {
        let slideCount = 1;
        let slideElementCount = [];
        let arrSlideNodes = this.data.data.getAttribute("slidecounts")?.split(",") || [];
        let oldSlideCount = this.data.data.getAttribute("multislidecount");
        let maxSlideNodeCount = 0;
        for (let i1 = 0; i1 < arrSlideNodes.length; i1++) {
            if (i1 == 0) {
                maxSlideNodeCount = parseInt(arrSlideNodes[i1]);
                if (maxSlideNodeCount > this.data.seriesLength) {
                    slideElementCount.push(parseInt(this.data.seriesLength));
                } else {
                    slideElementCount.push(maxSlideNodeCount);
                }
            }
            if (this.data.seriesLength > maxSlideNodeCount) {
                let temElementCount = this.data.seriesLength - maxSlideNodeCount;
                if (temElementCount > parseInt(arrSlideNodes[i1])) {
                    slideElementCount.push(parseInt(arrSlideNodes[i1]));
                } else {
                    slideElementCount.push(this.data.seriesLength - maxSlideNodeCount);
                }
                maxSlideNodeCount = maxSlideNodeCount + parseInt(arrSlideNodes[i1]);
                slideCount++;
            }
        }
        this.data.multislideIndex = 0;
        this.data.data.setAttribute("currentslideelementcount", maxSlideNodeCount);
        return { slideCount: slideCount, elementCount: slideElementCount };
    } else {
        let slideCount = Math.ceil(this.data.seriesLength / slideMaxCount);
        let slideElementCount = [];
        let totalCount = 0;
        for (s1 = 0; s1 < slideCount; s1++) {
            let nodeCount = s1 == slideCount - 1 ? Math.floor(this.data.seriesLength / slideCount) : Math.ceil(this.data.seriesLength / slideCount);
            totalCount += nodeCount;
            if (totalCount > this.data.seriesLength) {
                nodeCount--;
            }
            slideElementCount.push(nodeCount);
        }
        this.data.data.setAttribute("slidecounts", slideElementCount.join(","));
        this.data.data.setAttribute("multislidecount", slideCount);
        return { slideCount: slideCount, elementCount: slideElementCount };
    }
};
BaseColumnChart.prototype.createTrendline = function () {
    let eParent = this.parent;
    let baseColumnContainer = eParent.querySelector(".baseColumnChartContainer");
    let columnContainer = eParent.querySelector(".columnContainer");
    let columnContainerChild = columnContainer?.children[0];
    let parentLeft = columnContainer?.offsetLeft + columnContainerChild?.offsetLeft;
    let numberOfYears = this.data.seriesLength;
    let beginningValue = parseInt(this.data.values[0][0]);
    let endingValue = parseInt(this.data.values[this.data.seriesLength - 1][0]);
    if (this.data.stackedChart) {
        beginningValue = parseInt(this.data.arrSeriesItemValueTotal[0]);
        endingValue = parseInt(this.data.arrSeriesItemValueTotal[this.data.seriesLength - 1]);
    }
    let result = this.calculateCAGR(beginningValue, endingValue, numberOfYears);
    let padding = 30;
    let seriesElements = baseColumnContainer.querySelectorAll(".graphicconatiner ");
    if (this.data.stackedChart) {
        seriesElements = baseColumnContainer.querySelectorAll(".substackitemcond");
    }
    let seriesNodes = baseColumnContainer.querySelectorAll(".series");
    if (this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside") {
        seriesElements = baseColumnContainer.querySelectorAll(".value");
    }
    if (this.data.totalValueBounds?.height > 0 && this.data.stackedChart) {
        seriesElements = baseColumnContainer.querySelectorAll(".totalValue");
    }
    let hasInterMediateHighValue = false;
    for (let i = 1; i < numberOfYears - 1; i++) {
        if (this.data.stackedChart) {
            if (parseFloat(this.data.arrSeriesItemValueTotal[i]) >= beginningValue && parseFloat(this.data.arrSeriesItemValueTotal[i]) >= endingValue) {
                hasInterMediateHighValue = true;
            }
        } else {
            if (parseFloat(this.data.values[i][0]) >= beginningValue && parseFloat(this.data.values[i][0]) >= endingValue) {
                hasInterMediateHighValue = true;
            }
        }
    }
    console.log(`CAGR: ${result.toFixed(1)}%`);
    let trendlineBaseElement = document.createElement("div");
    trendlineBaseElement.className = "trendlineBaseElement th-section1";
    trendlineBaseElement.style.position = "absolute";
    trendlineBaseElement.style.top = "0";
    trendlineBaseElement.style.left = parentLeft + "px";
    trendlineBaseElement.style.width = columnContainerChild ? columnContainerChild.clientWidth + "px" : "100%";
    trendlineBaseElement.style.height = columnContainerChild ? columnContainerChild.clientHeight + "px" : "100%";
    baseColumnContainer.appendChild(trendlineBaseElement);
    let trendLineSvgElement = this.data.SVGUtils.createSVGElement("svg");
    trendLineSvgElement.style.width = "100%";
    trendLineSvgElement.style.height = "100%";
    trendLineSvgElement.className = "trendlineSvgElement";
    trendlineBaseElement.appendChild(trendLineSvgElement);
    let trendLinePathElement = this.data.SVGUtils.createSVGElement("path");
    trendLinePathElement.setAttribute("class", "trendlinePathElement cs-chart-trend-line-style moodanimation");
    trendLinePathElement.dataset.animation = "trendline";
    trendLinePathElement.setAttribute("d", "M 0 0 L 100 100");
    trendLineSvgElement.appendChild(trendLinePathElement);
    let x1, y1, x2, y2;
    let strPath = "";
    let arrPoints = [];
    if (!hasInterMediateHighValue) {
        let firstSeriesElement = seriesElements[0];
        let lastSeriesElement = seriesElements[seriesElements.length - 1];
        let firstSeriesNode = seriesNodes[0];
        let lastSeriesNode = seriesNodes[seriesNodes.length - 1];
        x1 = firstSeriesNode.offsetLeft + firstSeriesNode.clientWidth / 2;
        y1 = firstSeriesElement.offsetTop - padding;
        x2 = lastSeriesNode.offsetLeft + lastSeriesNode.clientWidth / 2;
        y2 = lastSeriesElement.offsetTop - padding;
        strPath = `M ${x1} ${y1} L ${x2} ${y2}`;
    } else {
        let isFirstElementHighestValue = parseFloat(this.data.values[0][0]) > parseFloat(this.data.values[this.data.seriesLength - 1][0]);
        let maxvalue = isFirstElementHighestValue ? parseFloat(this.data.values[0][0]) : parseFloat(this.data.values[this.data.seriesLength - 1][0]);
        let areaheight = this.trendlineHeight - 30;
        let numMultipleFactor = areaheight / maxvalue;
        x1 = seriesNodes[0].offsetLeft + seriesNodes[0].clientWidth / 2;
        y1 = this.trendlineHeight - parseFloat(this.data.values[0][0]) * numMultipleFactor;
        x2 = seriesNodes[seriesNodes.length - 1].offsetLeft + seriesNodes[seriesNodes.length - 1].clientWidth / 2;
        y2 = this.trendlineHeight - parseFloat(this.data.values[this.data.seriesLength - 1][0]) * numMultipleFactor;
        strPath = `M ${x1} ${y1} L ${x2} ${y2}`;
    }
    arrPoints.push({ x: x1, y: y1 });
    arrPoints.push({ x: x2, y: y2 });

    let trendlineTextElementParent = document.createElement("div");
    trendlineTextElementParent.className = "trendlineTextElementParent cs-chart-trend-callout-style moodanimation trendlinestyle ";
    trendlineBaseElement.appendChild(trendlineTextElementParent);
    trendlineTextElementParent.dataset.animation = "trendlinevalueelement";
    let trendlineTextElement = document.createElement("div");
    trendlineTextElement.className = "trendlineTextElement cs-chart-trend-text-style trendlinehighlightfontstyle1 " + this.ChartFonts.trendlineTextThemeClassName;
    trendlineTextElement.textContent = result == 100 ? "100%" : `${result.toFixed(1)}%`;
    trendlineTextElementParent.appendChild(trendlineTextElement);
    let shapeWidth = trendlineTextElementParent.clientWidth;
    let shapeHeight = trendlineTextElementParent.clientHeight;
    let centerY = (y1 + y2) / 2;
    let centerX = (x1 + x2) / 2;
    let shapeX = centerX - shapeWidth / 2;
    let shapeY = centerY - shapeHeight / 2;
    trendlineTextElementParent.style.left = shapeX + "px";
    trendlineTextElementParent.style.top = shapeY + "px";

    let arrowPoints = this.doMeasurementArrow(arrPoints);
    strPath += "L" + arrowPoints.x + "," + arrowPoints.y;
    let arrowHead = document.createElement("div");
    let arrowHeadParent = document.createElement("div");
    arrowHeadParent.className = "arrowheadParent cs-chart-trend-arrow-style accent" + this.customColorIndex + " clsMultiColorParent";
    arrowHeadParent.classList.add("th-section" + 1);
    if (arrowHead) {
        arrowHeadParent.appendChild(arrowHead);
        trendlineBaseElement.appendChild(arrowHeadParent);
        arrowHeadParent.style.offsetPath = "path('" + strPath + "')";
        arrowHeadParent.style.offsetDistance = "100%";
        arrowHeadParent.classList.add("moodanimation");
        arrowHead.classList.add("cf-background-color-section-primary");
        arrowHead.classList.add("cs-chart-arrow-head");
        arrowHeadParent.dataset.animation = "arrowhead";
    }
    trendLinePathElement.setAttribute("d", strPath);
    trendLinePathElement.setAttribute("fill", "none");
    let hasDashedLine = window.getComputedStyle(trendLinePathElement).getPropertyValue("stroke-dasharray") != "none";
    if (hasDashedLine) {
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        let maskTag = this.data.SVGUtils.createSVGElement("mask");
        maskTag.id = "mask";
        defsTag.appendChild(maskTag);
        let maskPathElement = this.data.SVGUtils.createSVGElement("path");
        maskPathElement.setAttribute("d", strPath);
        maskPathElement.setAttribute("fill", "white");
        maskTag.appendChild(maskPathElement);
        trendLinePathElement.setAttribute("mask", "url(#mask)");
    }
};
BaseColumnChart.prototype.doMeasurementArrow = function (arrPoints) {
    if (arrPoints.length > 1) {
        let length = arrPoints.length;
        let lastIndex = length - 1;
        let preIndex = length - 2;

        let A1 = {
            x: arrPoints[preIndex].x,
            y: arrPoints[preIndex].y,
        };

        let A2 = {
            x: arrPoints[lastIndex].x,
            y: arrPoints[lastIndex].y,
        };
        let d = 40;
        let slope = (A2.y - A1.y) / (A2.x - A1.x);
        let theta = Math.atan(slope);
        let A3x = A2.x + d * Math.cos(theta);
        let A3y = A2.y + d * Math.sin(theta);
        return { x: A3x, y: A3y };
    }
};
BaseColumnChart.prototype.calculateCAGR = function (beginningValue, endingValue, numberOfYears) {
    const cagr = Math.pow(endingValue / beginningValue, 1 / numberOfYears) - 1;
    if (cagr == Infinity || isNaN(cagr)) {
        return 100;
    }
    const cagrPercentage = cagr * 100;
    return cagrPercentage;
};
BaseColumnChart.prototype.createTrendlineElement = function (eParent) {
    return trendlineBaseElement;
};

// let labelMaxW = 0;
// let labeMaxH = 90;
// let valueMaxW = 0;
// let valueMaxH = 0;
function BaseColumnSeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
    this.name = "BaseSeries";
    this.gapPercentage = 0.7;
    this.maxLabelFontSize = [22, 22];
    this.minLabelFontSize = [30 - 8, 30 - 8];
    this.minValueFontSize = [25, 25];
    this.minValueFontSize = [42 - 8, 42 - 8];
    this.valueClientHeight = 0;
    this.boolDisableWidth = false;
    this.longLabelWidth = 0;
    this.totalValueHeight = 0;
    this.totalValueWidth = 0;
    this.ChartFonts = new window["ChartFonts"]();
    this.maxValueFontSize = this.ChartFonts.maxValueFontSize;
    this.valueStyle = this.ChartFonts.valueOuterColor;
    this.valueRotation = false;
    this.svgAsset = false;
    this.longTotalvalueWidth = 0;
    this.longTotalvalueHeight = 0;
    this.minWidthValue = argprops.minwidth || 0;
    this.chartGroupWidth = argprops.chartgroupwidth;
    this.createGroupNode = argprops.createGroupNode;
    this.createLabelTickMark = false;
    BaseSeries.call(this, argparent, argprops);
}
BaseColumnSeries.prototype = Object.create(BaseSeries.prototype);
BaseColumnSeries.prototype.constructor = BaseColumnSeries;

BaseColumnSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["BaseColumnSeriesItem"](argparent, argprops);
};

BaseColumnSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseColumnSeries.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let _oHeight = 0;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    const objValue = this.getValueBounds();
    const objPrimaryPlaceholder = this.getPlaceholderBounds();
    this.gapPercentage = this.data.layout.itemgap ? 1 : this.gapPercentage;
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    let objRuler = ""; //this.ChartUtils.ruler(this.data.data);
    if (objRuler) {
        if (this.data.validHover && objRuler.layout) this.data.conflictLayout = "basic";
    }

    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    }); //alterPos : "true"
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });
    this.secondaryLabelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLabelHPosition,
        vposition: this.data.layout.secondaryLabelVPosition,
        show: this.data.layout.showsecondaryLabel,
        inset: this.data.layout.secondaryLabelInset,
        index: this.data.layout.secondaryLabelPosIndex,
        itemBased: this.data.layout.secondaryLabelItemBased,
        samepos: this.data.layout.secondaryLabelSamePos,
        textbg: this.data.layout.secondaryLabeltextbg,
        textbgstyle: this.data.layout.secondaryLabeltextbgstyle,
        textbgcallout: this.data.layout.secondaryLabeltextbgcallout,
        textbgitem: this.data.layout.secondaryLabeltextbgItem,
    });
    this.secondaryNumberAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryNumberHPosition,
        vposition: this.data.layout.secondaryNumberVPosition,
        show: this.data.layout.secondaryNumber,
        inset: this.data.layout.secondaryNumberInset,
        index: this.data.layout.secondaryNumberPosIndex,
        itemBased: this.data.layout.secondaryNumberItemBased,
        samepos: this.data.layout.secondaryNumberSamePos,
        textbg: this.data.layout.secondaryNumbertextbg,
        textbgstyle: this.data.layout.secondaryNumbertextbgstyle,
        textbgcallout: this.data.layout.secondaryNumbertextbgcallout,
        textbgitem: this.data.layout.secondaryNumbertextbgItem,
    });
    this.secondaryLogoAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLogoHPosition,
        vposition: this.data.layout.secondaryLogoVPosition,
        show: this.data.layout.secondaryLogo,
        inset: this.data.layout.secondaryLogoInset,
        index: this.data.layout.secondaryLogoPosIndex,
        itemBased: this.data.layout.secondaryLogoItemBased,
        samepos: this.data.layout.secondaryLogoSamePos,
        textbg: this.data.layout.secondaryLogotextbg,
        textbgstyle: this.data.layout.secondaryLogotextbgstyle,
        textbgcallout: this.data.layout.secondaryLogotextbgcallout,
        textbgitem: this.data.layout.secondaryLogotextbgItem,
    });
    this.secondarySequenceAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondarySquenceNumberHPosition,
        vposition: this.data.layout.secondarySquenceNumberVPosition,
        show: this.data.layout.secondarySquenceNumber,
        inset: this.data.layout.secondarySquenceNumberInset,
        index: this.data.layout.secondarySquenceNumberPosIndex,
        itemBased: this.data.layout.secondarySquenceNumberItemBased,
        samepos: this.data.layout.secondarySquenceNumberSamePos,
        textbg: this.data.layout.secondarySquenceNumbertextbg,
        textbgstyle: this.data.layout.secondarySquenceNumbertextbgstyle,
        textbgcallout: this.data.layout.secondarySquenceNumbertextbgcallout,
        textbgitem: this.data.layout.secondarySquenceNumbertextbgItem,
    });
    this.totalValueAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.totalValueHPosition || "center",
        vposition: this.data.layout.totalValueVPosition || "top",
        show: this.data.layout.showTotalValue,
        inset: this.data.layout.totalValueInset,
        index: this.data.layout.totalValuePosIndex,
        itemBased: this.data.layout.totalValueItemBased,
        samepos: this.data.layout.totalValueSamePos,
        textbg: this.data.layout.totalValuetextbg,
        textbgstyle: this.data.layout.totalValuetextbgstyle,
        textbgcallout: this.data.layout.totalValuetextbgcallout,
        textbgitem: this.data.layout.totalValuetextbgItem,
        overlap: this.data.layout.totalValueoverlap,
    });
    this.alignment = this.secondaryLabelAlignment;
    if (this.data.layout.secondaryElementType == "image") {
        this.alignment = this.secondaryLogoAlignment;
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        this.alignment = this.secondarySequenceAlignment;
    }
    if (this.data.layout.secondaryElementType == "number") {
        this.alignment = this.secondaryNumberAlignment;
    }
    this.labelMaxW = this.state.width * this.gapPercentage;
    this.labeMaxH = this.state.height * 0.2;
    this.secondaryLabelMaxW = this.state.width * this.gapPercentage;
    this.secondaryLabelMaxH = this.state.height * 0.2;
    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });
    valueMaxW = this.state.width * this.gapPercentage;
    valueMaxH = this.state.height * 0.4; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        alterpos: this.data.layout.placeholderalterpos,
    });

    // Set createLabelTickMark to true when no label, no primary placeholder, and no secondary placeholder
    const hasLabel = this.labelAlignment && this.data.layout.showLabel;
    const hasPrimaryPlaceholder = this.placeholderAlignment && this.placeholderAlignment.show;
    const hasSecondaryPlaceholder = this.data.layout.secondaryElement && this.data.layout.secondaryElementType == "image";
    if (!hasLabel && !hasPrimaryPlaceholder && !hasSecondaryPlaceholder) {
        this.createLabelTickMark = true;
    }

    // if (this.labelAlignment.position == "outer") {
    //     _oHeight += objLabel.height + this.pad;
    // }

    // if (this.valueAlignment.position == "outer") {
    //     _oHeight += objValue.height + this.pad;
    // }

    // if (this.placeholderAlignment.position == "outer") {
    //     _oHeight += objPrimaryPlaceholder.height;
    // }

    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = 0.8;
    this.length = this.voData.seriesItemLength;
    if (this.data.chartName == "imageColumnIconFill" || this.data.chartName == "verticalDumbellChart" || this.data.chartName == "shapesComparisonPieChart") {
        this.length = 1;
    }
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem.width = this.data.stackedChart ? this.viewport.width : this.viewport.width / this.length;
    this.rectSeriesItem.height = this.viewport.height - _oHeight;
};

BaseColumnSeries.prototype.doMeasurementComputation = function (argprops) {};

BaseColumnSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.layout.secondaryElement && this.index == this.data.seriesLength) {
        let element = document.createElement("div");
        element.id = "header-" + this.index;
        element.className = "header overflow ";
        // element.style.height = this.data._headerHeight + "px";
        // element.dataset.animation = "nodeitem";

        element.style.minWidth = this.data.headerHeight + "px";
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        let seiesElement = this.parent.querySelector(".series");
        let labelHeader = document.createElement("div");
        let serieslabel = seiesElement.querySelector(".label");
        labelHeader.innerText = this.data.labelHeader;
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.style.height = serieslabel.clientHeight + "px";
        labelHeader.style.order = this.labelAlignment.index;
        labelHeader.className = "labelheader " + this.ChartFonts.secondaryLabelThemeClassName;
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.setAttribute("maxFontSize", 30);
        labelHeader.setAttribute("data-id", "label-header");
        labelHeader.setAttribute("data-slideid", this.data.slideID);
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-type", "labelheader");
        if (this.data._labelHeaderColor) {
            labelHeader.style.setProperty("color", this.data._labelHeaderColor, "important");
        }
        // labelHeader.setAttribute("data-animation", "yaxistitle");
        labelHeader.setAttribute("data-prompt-text", "Enter Title");
        labelHeader.style.minWidth = this.data.headerHeight + "px";
        this.ChartHelper.setTextChangeListner(labelHeader);
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position == "outer") {
            element.appendChild(labelHeader);
        }

        let secondaryHeader = document.createElement("div");
        let secondarylabelElement = seiesElement.querySelector(".secondaryElement");
        secondaryHeader.className = "secondaryheader " + this.ChartFonts.secondaryLabelThemeClassName;
        secondaryHeader.innerText = this.data.secondaryHeader;
        secondaryHeader.style.order = this.alignment.index;
        secondaryHeader.setAttribute("contenteditable", "true");
        secondaryHeader.setAttribute("maxFontSize", 30);
        secondaryHeader.setAttribute("data-id", "secondary-Header");
        secondaryHeader.setAttribute("data-slideid", this.data.slideID);
        secondaryHeader.setAttribute("contenteditable", "true");
        secondaryHeader.setAttribute("data-dck-selector", "true");
        secondaryHeader.setAttribute("data-dck-selector", "true");
        secondaryHeader.setAttribute("data-type", "secondaryheader");
        // secondaryHeader.setAttribute("data-animation", "yaxistitle");
        secondaryHeader.setAttribute("data-prompt-text", "Enter Title");
        secondaryHeader.style.minWidth = this.data.headerHeight + "px";
        if (this.data._secondaryHeaderColor) {
            secondaryHeader.style.setProperty("color", this.data._secondaryHeaderColor, "important");
        }
        this.ChartHelper.setTextChangeListner(secondaryHeader);

        secondaryHeader.style.height = secondarylabelElement.clientHeight + "px";
        if (this.alignment.itemBased != "true" && this.alignment.position == "outer") {
            element.appendChild(secondaryHeader);
        }

        let seriesItemHeader = document.createElement("div");
        let secondarylabel = seiesElement.querySelector(".seriesitemcond");
        seriesItemHeader.className = "secondaryitemheader " + this.ChartFonts.secondaryLabelThemeClassName;
        seriesItemHeader.setAttribute("contenteditable", "true");
        seriesItemHeader.style.order = this.data.layout.itemPosIndex;
        seriesItemHeader.innerText = this.data.itemHeader;
        seriesItemHeader.style.height = secondarylabel.clientHeight + "px";
        seriesItemHeader.setAttribute("contenteditable", "true");
        seriesItemHeader.setAttribute("data-dck-selector", "true");
        seriesItemHeader.setAttribute("data-dck-selector", "true");
        seriesItemHeader.setAttribute("maxFontSize", 30);
        seriesItemHeader.setAttribute("data-id", "item-Header");
        seriesItemHeader.setAttribute("data-slideid", this.data.slideID);
        seriesItemHeader.setAttribute("contenteditable", "true");
        seriesItemHeader.setAttribute("data-dck-selector", "true");
        seriesItemHeader.setAttribute("data-type", "itemheader");
        if (this.data._itemHeaderTextColor) {
            seriesItemHeader.style.setProperty("color", this.data._itemHeaderTextColor, "important");
        }
        seriesItemHeader.style.minWidth = this.data.headerHeight + "px";
        // seriesItemHeader.setAttribute("data-animation", "yaxistitle");
        seriesItemHeader.setAttribute("data-prompt-text", "Enter Title");
        this.ChartHelper.setTextChangeListner(seriesItemHeader);
        element.appendChild(seriesItemHeader);

        // if (this.parent) this.parent.appendChild(element);
        this.parent.insertBefore(element, this.parent.firstChild);
    } else {
        let moveX = this.viewport.x;
        let groupingIndex = 0;
        let customColorIndex = this.ChartFonts.customColor(this.index);
        let arrChartGroupNode = this.parent.querySelectorAll(".chartgroupnode");
        let chartGroupNode = arrChartGroupNode?.[arrChartGroupNode?.length - 1];
        let groupNodeIndex = "";
        if (this.data._groupNodes[this.index]?.value == "true") {
            groupNodeIndex = this.data._groupNodes[this.index].index;
            chartGroupNode = this.parent.querySelector(".chartgroupnode" + groupNodeIndex);
            if (!chartGroupNode) {
                this.createGroupNode = true;
            }
        }
        if (this.data._chartGroup && this.data._groupNodes[this.index].value == "true" && this.createGroupNode) {
            chartGroupNode = document.createElement("div");
            chartGroupNode.id = "chartgroupnode-" + this.data._groupNodes[this.index].index;
            chartGroupNode.className = "chartgroupnode seriesnodeelements chartgroupnode" + this.data._groupNodes[this.index].index;
            chartGroupNode.style.width = this.chartGroupWidth + "px";
            chartGroupNode.setAttribute("data-id", this.data._groupNodes[this.index].index);
            chartGroupNode.setAttribute("data-dck-selector", "true");
            chartGroupNode.dataset.index = this.index;
            this.parent.appendChild(chartGroupNode);
        }
        let arrChartGroupingLength = this.parent.querySelectorAll(".chartgroupnode")?.length || 0;
        if (arrChartGroupingLength > 0) {
            let colorIndex = this.data.chartGroupColorIndex != "null" ? this.data.chartGroupColorIndex : this.index;
            if (this.createGroupNode || this.data._groupNodes[this.index].value == "false") {
                if (this.data.chartGroupColorIndex != "null") colorIndex++;
                this.data.chartGroupColorIndex = colorIndex;
            }
            customColorIndex = this.ChartFonts.customColor(colorIndex);
        }

        const element = document.createElement("div");
        element.id = "series-" + this.index;
        element.setAttribute("data-test-id", this?.data?.isLive ? " " : "series-" + this.index);
        element.dataset.dckSelector = true;
        // element.dataset.animation = "nodeitem"
        element.className = "series " + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
        element.dataset.index = this.index;
        if (this.data.chartFlip) {
            this.parent.classList.add("chartflip");
        }
        if (this.data.layout.itemalterpos == "true" && (this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true") && this.data.chartName == "columnSimpleRectangle") {
            if (this.index == 0) {
                element.style.alignItems = "flex-end";
            } else {
                if (this.index == 1) {
                    element.style.alignItems = "flex-start";
                }
            }
        }
        let dummeyrectBaseSeriesHeight = this.parent.clientWidth;
        if (this.data.layout.itemSpace) {
            let numIndualHeight = this.parent.clientWidth * this.data.layout.itemSpace;
            dummeyrectBaseSeriesHeight = this.parent.clientWidth - numIndualHeight * (this.data.seriesLength - 1);
        }
        this.state.width = this.state.width;
        if (this.data.stackedChart && !this.data._stackedDynamicSize && this.data.seriesLength > 1) this.labelMaxW = this.parent.clientWidth / this.data.seriesLength;
        element.style.width = this.state.width + "px";
        if (this.data.boolSeriesBackgroundEnable) {
            let seriesBackground = document.createElement("div");
            seriesBackground.className = "seriesbackground moodanimation " + this.data.layout.seriesBackgroundGlobalStyle;
            seriesBackground.dataset.animation = "seriesbackground";
            element.appendChild(seriesBackground);
        }
        if (this.data._chartGroup && this.data._groupNodes[this.index].value == "true" && chartGroupNode) {
            chartGroupNode.appendChild(element);
        } else {
            element.classList.add("seriesnodeelements");
            if (this.parent) this.parent.appendChild(element);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        // if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
        //     element.classList.add("emphasis");
        // }
        // if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "alphaprojection") {
        //     element.classList.add("emphasis");
        // }
        // if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") {
        //     element.classList.add("emphasis");
        // }

        element.classList.add("th-section" + customColorIndex);

        if (this.createLabelTickMark) {
            let labelTickMark = document.createElement("div");
            labelTickMark.className = "labelTickMark";
            element.appendChild(labelTickMark);
        }

        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.chartName == "columnSimpleCoin") {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.dataset.emphasis = "false";
                element.classList.add("cs-chart-emphasis-image-disabled");
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.dataset.emphasis = "true";
                element.classList.add("cs-chart-emphasis-image-enabled");
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-enabled");
                element.dataset.projection = "true";
                element.classList.add("projectionEnableGraphic");
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-disabled");
                element.dataset.projection = "false";
                element.classList.add("projectionDisabledGraphic");
            }
        } else {
            if (this.svgAsset) {
                if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                    element.classList.add("cs-chart-emphasis-svg-disabled");
                }
                if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                    element.classList.add("cs-chart-emphasis-svg-enabled");
                }
                if (this.data.projection[this.index] == true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-svg-enabled");
                    element.dataset.projection = "true";
                    element.classList.add("projectionEnableGraphic");
                }
                if (this.data.projection[this.index] != true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-svg-disabled");
                    element.dataset.projection = "false";
                    element.classList.add("projectionDisabledGraphic");
                }
            } else if (this.data.grapicImage[this.index] == "true") {
                if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                    element.classList.add("cs-chart-emphasis-image-disabled");
                    element.dataset.emphasis = "false";
                }
                if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                    element.classList.add("cs-chart-emphasis-image-enabled");
                    element.dataset.emphasis = "true";
                }
                if (this.data.projection[this.index] == true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-image-enabled");
                    element.dataset.projection = "true";
                    element.classList.add("projectionEnableGraphic");
                }
                if (this.data.projection[this.index] != true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-image-disabled");
                    element.dataset.projection = "false";
                    element.classList.add("projectionDisabledGraphic");
                }
            } else {
                if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                    if (this.data.chartName == "columnSimpleRectangleFill") {
                        element.classList.add("cs-chart-emphasis-svg-disabled");
                        element.dataset.emphasis = "false";
                    } else {
                        element.classList.add("cs-chart-emphasis-disabled");
                        element.dataset.emphasis = "false";
                    }
                }
                if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                    if (this.data.chartName == "columnSimpleRectangleFill") {
                        element.classList.add("cs-chart-emphasis-svg-enabled");
                        element.dataset.emphasis = "true";
                    } else {
                        element.classList.add("cs-chart-emphasis-enabled");
                        element.dataset.emphasis = "true";
                    }
                }
                if (this.data.projection[this.index] == true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-enabled");
                    element.dataset.projection = "true";
                    element.classList.add("projectionEnableGraphic");
                }
                if (this.data.projection[this.index] != true && this.data.hasProjection) {
                    element.classList.add("cs-chart-projection-disabled");
                    element.dataset.projection = "false";
                    element.classList.add("projectionDisabledGraphic");
                }
            }
        }

        ///boolMax
        // this.doAddLabel(element, argprops, true);
        let sameElement = document.createElement("div");
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.justifyContent = "center";
        sameElement.style.alignItems = "center";
        if (this.data.layout.secondarySamePosition) {
            element.appendChild(sameElement);
        }

        if (this.data.secondaryLabel) {
            if (this.data.layout.secondarySamePosition) {
                this.doAddSecondaryLabelNode(sameElement, argprops, true);
                this.doAddSecondaryLabelNode(sameElement, argprops, false, true);
            } else {
                if (this.data.layout.secondaryPosition) {
                    this.doAddSecondaryLabelNode(element, argprops, true);
                    this.doAddSecondaryLabelNode(element, argprops, false);
                } else {
                    this.doAddSecondaryLabelNode(element, argprops, true);
                    this.doAddSecondaryLabelNode(element, argprops, false);
                }
            }
        }

        if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
            this.addlabel = true;
            if (this.data.layout.secondarySamePosition) {
                this.doAddLabel(sameElement, argprops, true);
                this.doAddLabel(sameElement, argprops, false, true);
            } else {
                if (this.data.layout.secondaryPosition) {
                    this.doAddLabel(element, argprops, true);
                    this.doAddLabel(element, argprops, false);
                } else {
                    this.doAddLabel(element, argprops, true);
                    this.doAddLabel(element, argprops, false);
                }
            }
        }

        if (this.data.sequencenumber) {
            this.alignment = this.secondarySequenceAlignment;
            // this.doSecondaryLabel(element, argprops, true);
            // this.doSecondaryLabel(element, argprops, false, true);
        }
        if (this.data.layout.secondaryElement && this.alignment.itemBased != "true" && this.data.sequencenumber) {
            // if (false) {
            if (this.data.layout.secondaryElementType != "image") {
                this.addlabel = true;
                labelMaxH = element.clientHeight / 2;
                if (this.data.layout.secondaryElementType == "number") {
                    this.alignment = this.secondaryNumberAlignment;
                }
                if (this.data.layout.secondarySamePosition) {
                    this.doSecondaryLabel(sameElement, argprops, true);
                    this.doSecondaryLabel(sameElement, argprops, false, true);
                } else {
                    if (this.data.layout.secondaryPosition) {
                        labelMaxH = element.clientHeight;
                        this.doSecondaryLabel(element, argprops, true);
                        this.doSecondaryLabel(element, argprops, false);
                    } else {
                        this.doSecondaryLabel(element, argprops, true);
                        this.doSecondaryLabel(element, argprops, false, true);
                    }
                }
            }
            if (this.data.layout.secondaryElementType == "image") {
                this.alignment = this.secondaryLogoAlignment;
                if (this.data.layout.secondarySamePosition) {
                    this.doSecondaryImage(sameElement, argprops);
                } else {
                    if (this.data.layout.secondaryPosition) {
                        this.doSecondaryImage(element, argprops);
                    } else {
                        this.doSecondaryImage(element, argprops);
                    }
                }
            }
        }
        if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
            this.addvalue = true;
            this.doAddValueElement(element, argprops);
        }

        if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;
        if (this.labelAlignment.itemBased == "true") {
            this.gapPercentage = 1;
        }
        const subelement = document.createElement("div");
        subelement.id = "seriesitemcond-" + this.index;
        subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
        subelement.style.width = this.gapPercentage * 100 + "%";
        if (this.data.layout.multiSeriesItemSize) {
            let widthValue = parseFloat(this.data.layout.multiSeriesItemSize) * this.data.seriesItemLength;
            let gapValue = this.data.layout.multiseriesGapValue * (this.data.seriesItemLength - 1);
            let totalWidth = widthValue + gapValue;
            if (totalWidth > element.clientWidth) {
                totalWidth = element.clientWidth;
            }
            subelement.style.width = totalWidth + "px";
            subelement.setAttribute("data-width", totalWidth);
        } else {
            subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
        }
        subelement.style.order = 2;
        // subelement.style.height = this.rectSeriesItem.height + "px"
        subelement.setAttribute("data-height", this.rectSeriesItem.height);
        if (element) element.appendChild(subelement);
        if (this.data.chartName == "barFXGVerticalChart") {
            subelement.style.height = "100%";
        }
        if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
            this.addplaceholder = true;
            const eprops = {
                index: this.index,
                length: this.length,
                placeholdertype: this.data.primaryPlaceholderType[this.index],
                placeholder: this.data.placeholder,
                placeholderpath: this.data.placeholderpath,
            };
            if (this.labelAlignment.itemBased == "true" && this.placeholderAlignment.alterpos == "true") {
                const pLayoutName = this.placeholderlayoutClassName("placeholder", this.index);
                const placeholderElement1 = this.ChartHelper.createDivElement({});
                placeholderElement1.className = "itempBasedlaceholder " + pLayoutName;
                placeholderElement1.style.width = this.gapPercentage * 100 + "%";
                element.appendChild(placeholderElement1);
                this.doAddPrimaryPlaceholder(placeholderElement1, eprops);
                let childElement = placeholderElement1.children[0];
                childElement.style.width = 50 + "%";
            } else {
                if (this.placeholderAlignment.itemBased != "true") {
                    this.doAddPrimaryPlaceholder(element, eprops);
                }
            }
        }

        let stackElement;
        let numHeight = "";
        if (this.data.stackedChart) {
            // const numMultpleFactor = this.state.width / this.data.stackSeriesvalueTotal[this.index];
            numHeight = this.data.stackSeriesvalueTotal[this.index] / this.data.maxStackValueTotal; //this.data.maxStackValueTotal * numMultpleFactor;
            const subStackElement = document.createElement("div");
            subStackElement.id = "stackitemcond-" + this.index;
            subStackElement.className = "stackitemcond overflow";
            subStackElement.style.width = 100 + "%";
            subStackElement.style.display = "flex";
            subStackElement.style.flexDirection = "column-reverse";
            subStackElement.style.height = 100 + "%";
            subelement.appendChild(subStackElement);

            stackElement = document.createElement("div");
            stackElement.id = "substackitemcond-" + this.index;
            stackElement.className = "substackitemcond overflow";
            stackElement.style.width = 100 + "%";
            stackElement.style.display = "flex";
            stackElement.style.flexDirection = "column-reverse";
            stackElement.style.height = this.data.data.getAttribute("data-stackpercentage") ? "100%" : numHeight * 100 + "%";
            subStackElement.appendChild(stackElement);
            // if(this.data.layout.itemShadow){
            //     stackElement.classList.add(this.data.layout.itemShadow);
            // }
        }
        let baseGraphicElements = stackElement || subelement;
        let totalValueElement = stackElement?.parentNode || subelement;
        let stackedHighlightDifferenceHeight = 0;
        if (this.data.stackedChart && (this.data.highlightDifference.display || this.data.indualHighlight)) {
            stackedHighlightDifferenceHeight = this.data._hdHight2;
        }
        if (this.data.showTotalValue && totalValueElement && baseGraphicElements) {
            let defaultPaddingClass = this.data.chartFlip ? "clsPaddingTop16" : "clsPaddingTop16-Alter";
            this.data.layout.totalValuePaddingClass = this.data.layout.totalValuePaddingClass ? this.data.layout.totalValuePaddingClass : defaultPaddingClass;
            this.totalValueStyle = this.getColorDetails(this.groupindex, this.ChartFonts.valueOuterColor, this.data.layout.totalValueColor, "color");
            if (this.totalValueAlignment.itemBased == "true") {
                if (this.totalValueAlignment.hposition == "right") {
                    totalValueElement.style.flexDirection = "row-reverse";
                } else {
                    totalValueElement.style.flexDirection = "row";
                }
                this.totalValueHeight = totalValueElement.clientHeight;
                this.totalValueWidth = totalValueElement.clientWidth * 0.5;
                let itemBasedTotalValueElement = document.createElement("div");
                const vLayoutName = this.totalValuelayoutClassName("containertotalvalue", true);
                this.data.SVGUtils.assignAttributes(itemBasedTotalValueElement, {
                    class: "itembasedtotalvalue " + vLayoutName,
                });
                itemBasedTotalValueElement.style.height = baseGraphicElements.clientHeight + "px";
                totalValueElement.style.alignItems = "flex-end";
                baseGraphicElements.style.width = "50%";
                totalValueElement.appendChild(itemBasedTotalValueElement);
                this.createTotalValueContainer(itemBasedTotalValueElement, true);
                this.data.totalValueBounds = { width: 0, height: 0 };
                this.createTotalValueContainer(itemBasedTotalValueElement, false);
            } else if (this.totalValueAlignment.position == "outer" && this.totalValueAlignment.itemBased != "true" && this.totalValueAlignment.inset != "bgoutside") {
                this.totalValueHeight = totalValueElement.clientHeight * 0.2;
                this.totalValueWidth = totalValueElement.clientWidth;
                if (!this.totalValueAlignment.vposition) this.totalValueAlignment.vposition = "top";
                if (this.totalValueAlignment.vposition == "top") {
                    this.createTotalValueContainer(totalValueElement, true);
                    this.createTotalValueContainer(totalValueElement, false);
                    if (this.data.chartFlip) {
                        totalValueElement.style.flexDirection = "column";
                        totalValueElement.style.justifyContent = "flex-start";
                    }
                    if (stackElement) {
                        let maxBaseHeight = this.rectSeriesItem.height - this.longTotalvalueHeight - stackedHighlightDifferenceHeight;
                        let numCalculatedHeight = maxBaseHeight * numHeight;
                        stackElement.style.height = this.data.SVGUtils.createPercentValue(this.rectSeriesItem.height, numCalculatedHeight);
                        if (this.data._stackedPercentage) {
                            stackElement.style.height = "100%";
                        }
                    }
                } else if (this.totalValueAlignment.vposition == "bottom") {
                    this.createTotalValueContainer(element, true);
                    this.rectSeriesItem.height -= this.longTotalvalueHeight;
                    this.data.totalValueBounds = { width: 0, height: 0 };
                    this.createTotalValueContainer(element, false);
                }
            }
        } else if (this.totalValueAlignment.vposition == "bottom" || this.totalValueAlignment.inset == "bgoutside" || (this.totalValueAlignment.position == "inner" && this.totalValueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
        }

        for (let i1 = 0; i1 < this.length; i1++) {
            const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
            let itemElement = this.data.stackedChart ? stackElement : subelement;
            const seriesItem = this.seriesItemInstance(itemElement, eProps);
            seriesItem.ChartHelper = this.ChartHelper;
            seriesItem.ChartUtils = this.ChartUtils;
            seriesItem.move(moveX, this.rectSeriesItem.y);
            seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
            seriesItem.data = this.data;
            this.items[i1] = seriesItem;
            moveX += this.rectSeriesItem.width;
        }
    }
};

BaseColumnSeries.prototype.labellayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") lLayoutName = lLayoutName + "valuecontainer valuebackground";
    return lLayoutName;
};

BaseColumnSeries.prototype.secondaryLabellayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.secondaryLabelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.secondaryLabelAlignment.hposition + this.secondaryLabelAlignment.vposition;
    } else {
        if (lLayoutName.includes("label") && this.secondaryLabelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.secondaryLabelAlignment.hposition + this.secondaryLabelAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") lLayoutName = lLayoutName + "valuecontainer valuebackground";
    return lLayoutName;
};

BaseColumnSeries.prototype.doAddSecondaryLabelNode = function (argparent, argprops, boolMax = false, shapeCompare = false, bounds = null) {
    let fontStyle = this.data.secondarylabelfontStyle || this.ChartFonts.dynamiclabelThemeClassName(this.index);
    let llayoutname = this.secondaryLabellayoutClassName("label");
    let element = document.createElement("div");
    element.className = "secondarylabelNode cls-secondary-text-parent secondarylabel moodanimation " + fontStyle + " " + llayoutname;
    element.style.paddingLeft = this.data.layout.secondaryLabelPaddingleft + "px";
    element.style.paddingRight = this.data.layout.secondaryLabelPaddingright + "px";
    element.style.paddingTop = this.data.layout.secondaryLabelPaddingtop + "px";
    element.style.paddingBottom = this.data.layout.secondaryLabelPaddingbottom + "px";
    if (shapeCompare) {
        element.className = "secondarylabelNode cls-secondary-text-parent moodanimation " + this.ChartFonts.shapeCompareLabel + " " + llayoutname;
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.chartFlip) {
        element.style.paddingBottom = this.data.layout.secondaryLabelPaddingtop + "px";
        element.style.paddingTop = this.data.layout.secondaryLabelPaddingbottom + "px";
        if (this.data.layout.secondaryLabelAlterPaddingClass) {
            element.classList.add(this.data.layout.secondaryLabelAlterPaddingClass);
        }
    } else {
        if (this.data.layout.secondaryLabelPaddingClass) {
            element.classList.add(this.data.layout.secondaryLabelPaddingClass);
        }
    }

    let paddingStyle = window.getComputedStyle(element);
    let topPadding = paddingStyle["padding-top"] ? parseFloat(paddingStyle["padding-top"]) : 0;
    let bottomPadding = paddingStyle["padding-bottom"] ? parseFloat(paddingStyle["padding-bottom"]) : 0;
    let paddingLeft = paddingStyle["padding-left"] ? parseFloat(paddingStyle["padding-left"]) : 0;
    let paddingRight = paddingStyle["padding-right"] ? parseFloat(paddingStyle["padding-right"]) : 0;
    if (bounds) {
        this.secondaryLabelMaxW = bounds.width;
    }
    let dummeylabelW = this.secondaryLabelMaxW;
    let dummeylabelH = this.secondaryLabelMaxH + (topPadding + bottomPadding);
    element.id = "secondarylabel-text-" + this.index;
    element.style.minHeight = 10 + "px";
    element.style.maxWidth = dummeylabelW + "px";
    element.style.maxHeight = dummeylabelH + "px";
    element.setAttribute("data-textalign", "vertical");
    element.dataset.animation = "primarytext";
    element.style.order = this.secondaryLabelAlignment.index;
    // element.style.fontSize = this.maxLabelFontSize[this.index]+"px"
    if (this.data.secondarylabeltextsize) element.style.fontSize = this.data.secondarylabeltextsize;

    if (this.data.layout.boolvaluebgShape) {
        // this.labelbgProperties(middleelementValue)
    }
    let totalPaddingHeight = topPadding + bottomPadding;
    dummeylabelH = this.labeMaxH - totalPaddingHeight;
    dummeylabelH = this.checkMaxLabelLineHeight(this.parent, dummeylabelH);
    dummeylabelW = this.labelMaxW;

    if (this.boolDisableWidth) {
        element.style.width = "unset";
    } else {
        element.style.width = dummeylabelW + "px";
    }
    let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
    this.labelStyle = labelColor ? labelColor : this.ChartFonts.labelOuterColor;
    dummeylabelW = dummeylabelW - (paddingLeft + paddingRight);

    let subelement = document.createElement("div");
    let hasInnerLabel = this.data.layout.labelInset == "inside";
    let labelClassValue = shapeCompare ? "heading" : "heading";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, labelClassValue, hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, labelClassValue, "color", null, hasInnerLabel);
    let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;

    subelement.className = "secondarylabeltext cs-chart-secondary-label-style " + colorTabCustomClass + " " + this.labelStyle;
    subelement.id = "secondary-labeltext-" + this.index;
    subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "secondary-labeltext-" + this.index);
    if (this.data.arrSecondaryLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrSecondaryLabelOpacity[this.index], "");
    if (this.data.arrsecondaryLabeltexttransform[this.index]) subelement.style.setProperty("text-transform", this.data.arrsecondaryLabeltexttransform[this.index], "");
    subelement.innerHTML = boolMax ? this.data.secondarylongLabel : this.data.secondaryText[this.index];
    subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.style.maxWidth = dummeylabelW + "px";
    subelement.style.maxHeight = dummeylabelH + "px";
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "secondarylabel");
    if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison" || this.data.chartName == "columnSimpleCoin") {
        subelement.setAttribute("data-specialtype", "label");
    }
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", this.index);
    subelement.setAttribute("data-prompt-text", "Enter Seconday Text");
    subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
    if (this.data._secondaryTextColor[this.index]) {
        subelement.style.setProperty("color", this.data._secondaryTextColor[this.index], "important");
    }
    if (shapeCompare) {
        subelement.dataset.themeClass = this.ChartFonts.shapeCompareLabel;
    }
    if (this.data.hasEmphasis || this.data.hasProjection) {
        subelement.classList.add("cs-label-text");
    }
    if (this.data.layout.boollabelbgShape) {
        subelement.style.padding = "10px";
        this.labelbgProperties(subelement);
    }
    if (this.data.layout.labelshadow == "true") {
        let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.index);
        let clsSendaryStyle = this.ChartFonts.labelOuterColor;
        let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
        // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
    }
    if (this.data.presentMode) {
        subelement.setAttribute("data-dck-selector", "false");
        subelement.setAttribute("contenteditable", "false");
    }
    element.appendChild(subelement);

    if (this.secondaryLabelAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.secondaryLabelAlignment.textbgstyle);
        if (this.secondaryLabelAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.secondaryLabelAlignment.vposition == "bottom") {
                element.style.paddingTop = topPadding + 15 + "px";
                element.style.paddingBottom = "15px";
            } else if (this.secondaryLabelAlignment.vposition == "top") {
                element.style.paddingTop = "15px";
                element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.secondaryLabelAlignment.textbgstyle + this.secondaryLabelAlignment.vposition);
        }
    } else {
        subelement.classList.add("transparentBg");
    }
    if (this.data.secondaryLabelLineHeight) {
        subelement.style.lineHeight = this.data.secondaryLabelLineHeight;
    }
    if (this.data.secondaryLabelLineHeight) {
        subelement.style.letterSpacing = this.data.secondaryLabelLetterSpace + "em";
    }
    this.ChartUtils.enableTextHeighlight(subelement, this.data);
    if (this.index == 0 && boolMax) {
        this.ChartHelper.adjustFontSize(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        this.recalculateSecondaryLabelMaxHeight(subelement);
        let clientHeight = element.clientHeight;
        let clientWidth = element.clientWidth;
        let fontSize = this.ChartFonts.maxLabelFontSize(subelement);
        this.data.secondaryTextBouns = { width: clientWidth, height: clientHeight, fontSize: fontSize };
    } else {
        subelement.style.fontSize = this.data.secondaryTextBouns.fontSize + "px";
        element.style.minHeight = this.data.secondaryTextBouns.height + "px";
        element.style.maxHeight = this.data.secondaryTextBouns.height + "px";
        subelement.style.maxHeight = this.data.secondaryTextBouns.height - (topPadding + bottomPadding) + "px";
    }
    if (boolMax) {
        this.rectSeriesItem.height -= this.data.secondaryTextBouns.height;
        argparent.removeChild(element);
    } else {
        this.ChartHelper.setTextChangeListner(subelement);
    }
};

BaseColumnSeries.prototype.recalculateSecondaryLabelMaxHeight = function (nodeTextElement, disableparent = false, enableAllNodes = true) {
    let numScrollH = nodeTextElement.scrollHeight;
    let numClientH = nodeTextElement.clientHeight;
    let maxHeight;
    let boolHeightChange = false;
    const cssValue = window.getComputedStyle(nodeTextElement);
    if (numClientH <= numScrollH) {
        maxHeight = cssValue["maxHeight"].split("px")[0];
        let value = maxHeight / parseFloat(cssValue["lineHeight"]);
        let maxLines = parseInt(value) == 0 ? 1 : parseInt(value);
        if (maxLines > 0 && parseFloat(cssValue["lineHeight"]) > 0) maxHeight = parseInt(maxLines * parseFloat(cssValue["lineHeight"]));
        nodeTextElement.style.maxHeight = maxHeight + "px";
        boolHeightChange = true;
    }
};

BaseColumnSeries.prototype.doAddLabel = function (argparent, argprops, boolMax = false, shapeCompare = false, bounds = null) {
    if (this.data.layout.showLabel) {
        let llayoutname = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.index) + " " + llayoutname;
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (shapeCompare) {
            element.className = "label moodanimation " + this.ChartFonts.shapeCompareLabel + " " + llayoutname;
        }
        if (argparent) argparent.appendChild(element);
        else return element;
        if (this.data.chartFlip) {
            element.style.paddingBottom = this.data.layout.labelPaddingtop + "px";
            element.style.paddingTop = this.data.layout.labelPaddingbottom + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        let paddingStyle = window.getComputedStyle(element);
        let topPadding = paddingStyle["padding-top"] ? parseFloat(paddingStyle["padding-top"]) : 0;
        let bottomPadding = paddingStyle["padding-bottom"] ? parseFloat(paddingStyle["padding-bottom"]) : 0;
        let paddingLeft = paddingStyle["padding-left"] ? parseFloat(paddingStyle["padding-left"]) : 0;
        let paddingRight = paddingStyle["padding-right"] ? parseFloat(paddingStyle["padding-right"]) : 0;
        if (bounds) {
            this.labelMaxW = bounds.width;
        }
        let dummeylabelW = this.labelMaxW;
        let dummeylabelH = this.labeMaxH + (topPadding + bottomPadding);

        if (this.labelAlignment.vposition == "bottom" && this.valueRotation && (this.data.chartName == "columnSimpleRectangle" || this.data.chartName == "barFXGVerticalChart")) {
            dummeylabelH = this.labelMaxW;
            dummeylabelW = this.labeMaxH > argparent.clientWidth ? argparent.clientWidth : this.labeMaxH;
        }
        element.id = "label-text-" + this.index;
        element.style.minHeight = 10 + "px";
        element.style.maxWidth = dummeylabelW + "px";
        element.style.maxHeight = dummeylabelH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px"
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];

        if (this.data.layout.boolvaluebgShape) {
            // this.labelbgProperties(middleelementValue)
        }
        if (this.labelAlignment.vposition == "bottom" && this.valueRotation && this.data.chartName == "columnSimpleRectangle") {
            // element.style.paddingRight = this.data.layout.labelPaddingtop + "px";
            // element.style.paddingTop = this.data.layout.labelPaddingleft + "px";
            // element.style.paddingBottom = this.data.layout.labelPaddingright + "px";
        }
        dummeylabelH = this.labeMaxH - (topPadding + bottomPadding);
        dummeylabelH = this.checkMaxLabelLineHeight(this.parent, dummeylabelH);
        dummeylabelW = this.labelMaxW;
        if (this.labelAlignment.vposition == "bottom" && this.valueRotation && this.data.chartName == "columnSimpleRectangle") {
            dummeylabelH = this.labelMaxW;
            dummeylabelW = this.labeMaxH + 80 > argparent.clientWidth ? argparent.clientWidth : this.labeMaxH + 80;
        }
        if (this.boolDisableWidth) {
            element.style.width = "unset";
        } else {
            element.style.width = dummeylabelW + "px";
        }
        let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.ChartFonts.labelOuterColor;
        dummeylabelW = dummeylabelW - (paddingLeft + paddingRight);

        let subelement = document.createElement("div");
        let hasInnerLabel = this.data.layout.labelInset == "inside";
        let labelClassValue = shapeCompare ? "heading" : "heading";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, labelClassValue, hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, labelClassValue, "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.index;
        subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "labeltext-" + this.index);
        if (this.data.arrLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.index], "");
        if (this.data.arrLabeltexttransform[this.index]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.index], "");
        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.index];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = dummeylabelW + "px";
        subelement.style.maxHeight = dummeylabelH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison" || this.data.chartName == "columnSimpleCoin") {
            subelement.setAttribute("data-specialtype", "label");
        }
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.index);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
        if (this.data._labelTextColor[this.index]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.index], "important");
        }
        if (shapeCompare) {
            subelement.dataset.themeClass = this.ChartFonts.shapeCompareLabel;
        }
        if (this.data.hasEmphasis || this.data.hasProjection) {
            subelement.classList.add("cs-label-text");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.index);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        if (this.data.presentMode) {
            subelement.setAttribute("data-dck-selector", "false");
            subelement.setAttribute("contenteditable", "false");
        }
        element.appendChild(subelement);

        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = topPadding + 15 + "px";
                    element.style.paddingBottom = "15px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = "15px";
                    element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        } else {
            subelement.classList.add("transparentBg");
        }
        if (this.data.labelLineHeight[this.index]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.index];
        }
        if (this.data.labelLetterSpace[this.index]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.index] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        this.ChartHelper.adjustFontSize(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        let minHeight = parseFloat(subelement.parentNode.style.minHeight);
        let maxHeight = parseFloat(subelement.parentNode.style.maxHeight);
        if (minHeight > maxHeight && !this.data.stackedChart) {
            this.doSetLabelMaxHeight(argparent.parentNode);
            minHeight = parseFloat(subelement.parentNode.style.minHeight);
            maxHeight = parseFloat(subelement.parentNode.style.maxHeight);
        }
        // if(this.data.hadSecondaryText){
        //     let dummeylabelHeight = this.checkMaxLabelLineHeight(this.parent,dummeylabelH)
        //     subelement.style.minHeight = dummeylabelHeight+"px";
        // }
        if (boolMax) {
            minHeight = parseFloat(subelement.parentNode.style.minHeight) > dummeylabelH ? dummeylabelH : parseFloat(subelement.parentNode.style.minHeight);
            if (this.labelAlignment.vposition == "bottom" && this.valueRotation && this.data.chartName != "waterfallchart" && this.data.chartName == "columnSimpleRectangle") {
            } else {
                this.rectSeriesItem.height -= minHeight > element.clientHeight ? minHeight : element.clientHeight;
            }
            //  if(this.data.hadSecondaryText){
            //     subelement.style.minHeight = "unset";
            // }
            this.longLabelWidth = element.clientHeight + 4;
            this.longLabelHeight = element.clientHeight;

            if (topPadding) {
                this.longLabelHeight = element.clientHeight - parseFloat(topPadding);
            }
            if (bottomPadding) {
                this.longLabelHeight -= parseFloat(bottomPadding);
            }
            if (this.data.chartName == "columnSimpleRectangle" || this.data.stackedChart || this.data.chartName == "barFXGVerticalChart") {
                subelement.style.wordWrap = "unset";
                subelement.style.wordBreak = "normal";
                subelement.style.overflow = "unset";
                let scrollWidthValue = subelement.scrollWidth;
                let clientWidthValue = subelement.clientWidth;
                if (scrollWidthValue == clientWidthValue) {
                    let HighlightScrollWidth = subelement.querySelector(".selectedTextHighlight")?.scrollWidth || 0;
                    if (scrollWidthValue < HighlightScrollWidth) {
                        scrollWidthValue = HighlightScrollWidth;
                    }
                }
                this.singleLine = this.lineCount(subelement);
                if (subelement.innerText == "Enter Label") {
                    this.longLabelChildWidth = subelement.scrollWidth < 90 ? 90 : subelement.scrollWidth;
                } else {
                    this.longLabelChildWidth = subelement.scrollWidth;
                }
                if (clientWidthValue < scrollWidthValue) {
                    this.valueRotation = true;
                }
            }
            argparent.removeChild(element);
            let overlapLabel = minHeight < element.clientHeight;
        } else {
            subelement.style.wordWrap = "unset";
            subelement.style.wordBreak = "normal";
            if (minHeight <= this.longLabelHeight) {
                let elemntMinHeight = this.longLabelHeight;
                element.style.minHeight = this.longLabelHeight + "px";
                this.labelMinHeight(elemntMinHeight);
                // if(this.data.hadSecondaryText&&!isNaN(parseFloat(this.longLabelHeight))){
                //     this.labelMinHeight(parseFloat(this.longLabelHeight))
                // }
            } else {
                // if(this.data.hadSecondaryText&&!isNaN(parseFloat(this.longLabelHeight))){
                //     this.labelMinHeight(parseFloat(this.longLabelHeight),true)
                // }
            }
        }
        if (!boolMax && this.labelAlignment.vposition == "bottom" && this.valueRotation && this.data.chartName != "waterfallchart" && (this.data.chartName == "columnSimpleRectangle" || this.data.stackedChart)) {
            // this.rectSeriesItem.height -= labelMaxW + 40;
            let graphicElement = this.ChartHelper.getElementSlide(subelement, true);
            let elementDetails = graphicElement.getElementsByClassName("label");
            for (let i1 = 0; i1 < elementDetails.length; i1++) {
                elementDetails[i1].children[0].style.minWidth = this.longLabelChildWidth > this.labeMaxH + 80 ? this.labeMaxH + 80 + "px" : this.longLabelChildWidth + "px";
                elementDetails[i1].children[0].style.transform = "rotate(-90deg)";
                let width = elementDetails[i1].children[0].clientWidth;
                elementDetails[i1].children[0].style.removeProperty("word-break");
                if (this.singleLine) {
                    elementDetails[i1].children[0].style.setProperty("word-break", "break-all");
                }
                elementDetails[i1].children[0].style.justifyContent = "flex-end";
                elementDetails[i1].dataset.customstartrotation = "90";
                elementDetails[i1].dataset.customendrotation = "90";
                elementDetails[i1].style.alignItems = "center";
                elementDetails[i1].style.boxSizing = "unset";
                elementDetails[i1].style.maxHeight = this.labeMaxH + 80 + "px";
                elementDetails[i1].style.height = this.longLabelChildWidth > this.labeMaxH + 80 ? this.labeMaxH + 80 + "px" : this.longLabelChildWidth + "px";
                elementDetails[i1].children[0].style.textAlign = "end";
                if (this.data._stackedDynamicSize) {
                    elementDetails[i1].children[0].style.width = this.longLabelChildWidth + "px";
                }
                // elementDetails[i1].style.width = this.longLabelWidth + "px";
                elementDetails[i1].style.justifyContent = "flex-end";
                elementDetails[i1].children[0].style.maxWidth = elementDetails[i1].style.maxHeight;
                elementDetails[i1].style.justifyContent = "center";

                let parentWidth = elementDetails[i1].clientWidth;
                let elementHeight = elementDetails[i1].children[0].clientWidth;
                let transformvalue = parentWidth > elementHeight ? (parentWidth - elementHeight) / 2 : (elementHeight - parentWidth) / 2;
                elementDetails[i1].children[0].style.transform = "rotate(-90deg) translate(0px,0px)";
            }
        }
        if (this.data.chartName == "waterfallchart" && this.index == this.data.seriesLength - 1) {
            subelement.setAttribute("data-prompt-text", "Net Profit");
        }
    }
};

BaseColumnSeries.prototype.secondaryLabelMinHeight = function (longMinHeight, updatechild = false, totalPaddingHeight = 0) {
    let valueElements = this.data.stackedChart ? this.parent.parentNode.parentNode.parentNode.querySelectorAll(".secondarylabelNode") : this.parent.parentNode.parentNode.querySelectorAll(".secondarylabelNode");
    if (valueElements) {
        let chartHelper = this.ChartHelper;
        Array.from(valueElements).forEach(function (item) {
            if (updatechild && item.querySelector(".secondarylabeltext")) {
                item.querySelector(".secondarylabeltext").style.minHeight = longMinHeight + "px";
                let maxHeight = parseFloat(item.querySelector(".secondarylabeltext").style.maxHeight);
                if (longMinHeight > maxHeight) {
                    item.querySelector(".secondarylabeltext").style.minHeight = maxHeight - totalPaddingHeight + "px";
                }
                item.querySelector(".secondarylabeltext").style.maxHeight = maxHeight - totalPaddingHeight + "px";
            }
            let maxHeight = parseFloat(item.style.maxHeight);
            if (longMinHeight >= maxHeight) {
                item.style.minHeight = maxHeight - totalPaddingHeight + "px";
            }
            item.style.maxHeight = longMinHeight + totalPaddingHeight + "px";
        });
    }
};

BaseColumnSeries.prototype.labelMinHeight = function (longMinHeight, updatechild = false) {
    let valueElements = this.data.stackedChart ? this.parent.parentNode.parentNode.parentNode.querySelectorAll(".label") : this.parent.parentNode.parentNode.querySelectorAll(".label");
    if (valueElements) {
        Array.from(valueElements).forEach(function (item) {
            item.style.minHeight = longMinHeight + "px";
            if (updatechild && item.querySelector(".labeltext")) {
                item.querySelector(".labeltext").style.minHeight = longMinHeight + "px";
            }
        });
    }
};
BaseColumnSeries.prototype.doSetLabelMaxHeight = function (argparent) {
    let labelelementValues = argparent ? argparent.querySelectorAll(".label") : [];
    for (let j1 = 0; j1 < labelelementValues.length; j1++) {
        let labelelement = labelelementValues[j1];
        let minHeight = labelelement && labelelement.style ? parseFloat(labelelement.style.minHeight) : 0;
        let maxHeight = labelelement && labelelement.style ? parseFloat(labelelement.style.maxHeight) : 0;
        if (minHeight > maxHeight && !this.data.stackedChart) {
            labelelement.style.minHeight = maxHeight + "px";
        }
    }
};
BaseColumnSeries.prototype.doSecondaryLabel = function (argparent, argprops, boolMax = false, sequencenumber = false) {
    let llayoutname = this.labellayoutClassName("label");
    let element = document.createElement("div");
    element.className = "secondaryElement secondarylabel moodanimation " + this.ChartFonts.secondaryLabelThemeClassName + " " + llayoutname;
    element.id = "secondary-text-" + this.index;
    element.style.order = 0;
    element.style.minHeight = 10 + "px";
    element.style.width = this.labelMaxW + "px";
    element.style.maxWidth = this.labelMaxW + "px";
    element.style.maxHeight = this.labeMaxH + "px";
    element.setAttribute("data-type", "secondarylabel");
    if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison" || this.data.chartName == "columnSimpleCoin") {
        element.setAttribute("data-specialtype", "secondarylabel");
    }
    element.setAttribute("data-textalign", "vertical");
    element.dataset.animation = "secondarylabel";
    element.style.paddingLeft = this.data.layout.secondaryLabelPaddingleft + "px";
    element.style.paddingRight = this.data.layout.secondaryLabelPaddingright + "px";
    element.style.paddingTop = this.data.layout.secondaryLabelPaddingtop + "px";
    element.style.paddingBottom = this.data.layout.secondaryLabelPaddingbottom + "px";
    if (this.data.arrSecondaryLabelTextSize[this.index]) element.style.setProperty("font-size", this.data.arrSecondaryLabelTextSize[this.index], "");
    if (this.data.layout.secondaryLabelPaddingClass) {
        element.classList.add(this.data.layout.secondaryLabelPaddingClass);
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    let paddingStyle = window.getComputedStyle(element);
    let paddingTopValue = paddingStyle["padding-top"] ? parseFloat(paddingStyle["padding-top"]) : 0;
    let paddingBottomValue = paddingStyle["padding-bottom"] ? parseFloat(paddingStyle["padding-bottom"]) : 0;
    let subelement = document.createElement("div");
    let hasInnerLabel = this.data.layout.labelInset == "inside";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.ChartFonts.labelOuterColor, subelement, "contrast", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "contrast", "color", null, hasInnerLabel);
    let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : "clsLabelTextColor";
    subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
    if (this.data.layout.secondaryElementType != "squencenumber") {
        subelement.className = "labeltext secondarytext " + colorTabCustomClass + " " + this.labelStyle;
    }
    if (this.data.arrSecondaryLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrSecondaryLabelOpacity[this.index], "");
    if (this.data.arrsecondaryLabeltexttransform[this.index]) subelement.style.setProperty("text-transform", this.data.arrsecondaryLabeltexttransform[this.index], "");
    let secondaryLabelMaxHeight = this.labeMaxH - paddingTopValue - paddingBottomValue;
    subelement.id = "secondary-text-" + this.index;
    subelement.innerHTML = boolMax ? this.data.secondarylongLabel : this.data.secondaryText[this.index];
    subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.style.maxWidth = this.labelMaxW + "px";
    subelement.style.maxHeight = secondaryLabelMaxHeight + "px";
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "secondarylabel");
    if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison" || this.data.chartName == "columnSimpleCoin") {
        subelement.setAttribute("data-specialtype", "secondarylabel");
    }
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", this.index);
    element.setAttribute("data-id", this.index);
    subelement.setAttribute("data-prompt-text", "Enter secondaryText");
    if (this.data.presentMode || sequencenumber) {
        subelement.setAttribute("data-dck-selector", "false");
        subelement.setAttribute("contenteditable", "false");
    }
    if (sequencenumber) {
        subelement.innerHTML = this.index + 1;
    }
    if (this.data._secondaryTextColor[this.index]) {
        subelement.style.setProperty("color", this.data._secondaryTextColor[this.index], "important");
    }
    element.appendChild(subelement);
    if (this.alignment.textbg == "true") {
        subelement.classList.add("textbg" + this.alignment.textbgstyle);
        if (this.alignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.alignment.vposition == "bottom") {
                element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                element.style.paddingBottom = "15px";
            } else if (this.alignment.vposition == "top") {
                element.style.paddingTop = "15px";
                element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.alignment.textbgstyle + this.alignment.vposition);
        }
    }
    if (this.data.secondaryLabelLineHeight[this.index]) {
        subelement.style.lineHeight = this.data.secondaryLabelLineHeight[this.index];
    }
    if (this.data.secondaryLabelLetterSpace[this.index]) {
        subelement.style.letterSpacing = this.data.secondaryLabelLetterSpace[this.index] + "em";
    }
    this.ChartHelper.setTextChangeListner(subelement);

    this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement);
    if (this.data.layout.secondaryElementType != "squencenumber") this.ChartHelper.recalculateMaxHeight(subelement);
    if (boolMax) {
        this.rectSeriesItem.height -= element.clientHeight;
        argparent.removeChild(element);
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        element.style.minWidth = "90px";
        element.style.textAlign = "center";
    }
};
BaseColumnSeries.prototype.valuelayoutClassName = function (itemname) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") vLayoutName = vLayoutName + "valuecontainer valuebackground";
    return vLayoutName;
};

BaseColumnSeries.prototype.doAddValueElement = function (argparent, argprops, boolPercentage = false) {
    const index = 0;
    const groupindex = parseInt(this.index);
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.width = valueMaxW + "px";
    element.style.maxWidth = valueMaxW + "px";
    element.style.maxHeight = valueMaxH + "px";
    element.style.overflow = "hidden";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    element.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.displayValueFormat == "fraction" || this.data.displayValueFormat == "outof") {
        this.valueStyle = this.ChartFonts.valueOuterColor;
    }
    if (!this.data.hasEmphasis && !this.data.hasProjection) {
        this.valueStyle = this.getColorDetails(groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    }
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "valuetext-" + groupindex + "_" + index);

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.ChartFonts.valueThemeClassName;
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + " " + this.ChartFonts.valueThemeClassName + "  moodanimation";
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
    }
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.index][0] = parseInt(this.data.values[this.index][0]);
    }
    let valueText = parseFloat(this.data.valuesDenomination[this.index][0]);

    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        let numValue = this.data.values[index][0];
        let remaingValue = numValue % 10;
        let roundedValue = 0;
        let maxCount = this.data.displayValueMaxCount;
        let originalValue = 0;
        if (remaingValue >= 5) {
            let addinValue = 10 - remaingValue;
            originalValue = addinValue + parseInt(numValue);
        } else {
            originalValue = parseInt(numValue) != remaingValue ? parseInt(numValue) - remaingValue : remaingValue;
        }
        if (this.data.values[this.index][0] <= maxCount) {
            numValue = this.data.values[this.index][0];
        } else {
            numValue = numValue < this.data.displayValueMaxCount ? numValue : originalValue;
        }
        let currentValue = parseInt(numValue) < 10 ? parseInt(numValue / 100) : parseInt(numValue);
        let splitValue = parseInt(numValue) < 10 ? currentValue : currentValue.toString().split("");
        let graphicCount = splitValue.length > 1 ? parseFloat(splitValue.join(".")) : currentValue;
        let multiplefactor = maxCount / 10;
        graphicCount = parseInt(numValue) != 0 && Math.round(graphicCount * multiplefactor) == 0 ? 1 : Math.round(graphicCount * multiplefactor);
        graphicCount = numValue >= 100 ? maxCount : graphicCount;
        graphicCount = this.data.values[this.index][0] <= maxCount ? this.data.values[this.index][0] : graphicCount;
        this.data.valuesDenomination[this.index][0] = graphicCount;
    }

    if (this.data.displayValueFormat == "outof" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data.suffix[this.index][0] = "";
        this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] + " out of " + this.data.displayValueMaxCount;
        valueText = this.data.valuesDenomination[this.index][0];
    }
    if (this.data.displayValueFormat == "fraction" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data.suffix[this.index][0] = "";
        this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] + "/" + this.data.displayValueMaxCount;
        valueText = this.data.valuesDenomination[this.index][0];
    }
    if (this.data.displayValueFormat == "percentage" && this.data.chartName != "buildingPositionColumn") {
        // this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] > 100 ? 100 : this.data.valuesDenomination[this.index][0];
        subelement.dataset.defalutPercentage = "true";
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }

    subelement.innerText = this.data.prefix[this.index][0] + this.data.valuesDenomination[this.index][0] + this.data.suffix[this.index][0];
    if (boolPercentage && this.data.displayValueFormat != "number") {
        subelement.dataset.defalutPercentage = "true";
        if (this.data.suffix[this.index][0] == "") {
            subelement.innerText = this.data.prefix[this.index][0] + valueText + "%" + this.data.suffix[this.index][0];
        }
    }
    subelement.style.maxWidth = valueMaxW + "px";
    subelement.style.maxHeight = valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("data-type", "value");
    if (this.data.chartName == "lineChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison" || this.data.chartName == "lineCoinChart" || this.data.chartName == "columnSimpleCoin") {
        subelement.setAttribute("data-specialtype", "value");
    }
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-animateItem", "secondarytext" + groupindex);
    // subelement.setAttribute("data-graphic-y", graphicH);
    subelement.dataset.animation = "secondarytext";

    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }

    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        subelement.setAttribute("data-fraction", "true");
    }
    subelement.setAttribute("data-animateItem", "secondarytext" + groupindex);
    element.appendChild(subelement);
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        if (this.data.presentMode || this.data.disableEdit) {
            subelement.setAttribute("contenteditable", "false");
        }
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") & (this.data.chartName != "simpleIconFillRepeatChart")) {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    if (this.data.presentMode || this.data.seriesanimation || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    } else {
        subelement.setAttribute("data-dck-selector", "true");
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = this.data.layout.valuePaddingtop + 15 + "px";
                element.style.paddingBottom = "15px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = "15px";
                element.style.paddingBottom = this.data.layout.valuePaddingbottom + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolPercentage && this.data.layout.valueColor != "contrast") {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }

    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.chartName == "buildingPositionColumn") {
        let height = subelement.clientHeight;
        if (height > 10) {
            element.style.minHeight = height - 2 + "px";
        }
    }
    console.log(subelement.style.fontSize);
    let minFontSize = this.minValueFontSize[this.arrIndex];

    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    if (this.data.baseProperties.maxAllowedSeries > 1) {
        minFontSize = this.maxValueFontSize[this.arrIndex];
        if (this.data.chartName == "buildingPositionColumn" || this.data.chartName == "multiImageComparison") {
            minFontSize = parseFloat(this.maxValueFontSize[this.arrIndex]) * 0.5;
        }
    }
    // subelement.style.lineHeight = "1.5";
    this.calculateMaxFonsize(subelement, false, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, minFontSize, this.maxValueFontSize[this.arrIndex]);
    // this.ChartHelper.adjustFontSizeWidth(subelement, 10, minFontSize, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    console.log(subelement.style.fontSize);
    // subelement.style.lineHeight = "";
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1") && subelement) {
        if (this.data.suffixStyle) {
            let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
            if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
        }
        if (this.data.prefixStyle) {
            let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
            if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
        }
    }
};
BaseColumnSeries.prototype.doSecondaryImage = function (element, argprops) {
    const subelement = document.createElement("img");
    subelement.style.width = "80%";
    subelement.style.order = this.alignment.index;
    subelement.src = this.data.secondaryPlaceholderPath[this.index];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "secondaryElement primaryplaceholdergraphic";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "rgba(var(--th-slide-secondary), 1)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "var(--item" + this.index + "-color)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
};

BaseColumnSeries.prototype.totalValuelayoutClassName = function (itemname, boolBottom = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.totalValueAlignment.position == "inner") {
        if (boolBottom) {
            if (this.totalValueAlignment.vposition == "bottom") vLayoutName = "inset" + vLayoutName + this.totalValueAlignment.hposition + "top";
            else if (this.totalValueAlignment.vposition == "top") vLayoutName = "inset" + vLayoutName + this.totalValueAlignment.hposition + "bottom";
            else vLayoutName = "inset" + vLayoutName + this.totalValueAlignment.hposition + this.totalValueAlignment.vposition;
        } else {
            vLayoutName = "inset" + vLayoutName + this.totalValueAlignment.hposition + this.totalValueAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolBottom) {
            if (this.totalValueAlignment.vposition == "bottom") vLayoutName = vLayoutName + this.totalValueAlignment.hposition + "top";
            else if (this.totalValueAlignment.vposition == "top") vLayoutName = vLayoutName + this.totalValueAlignment.hposition + "bottom";
            else vLayoutName = vLayoutName + this.totalValueAlignment.hposition + this.totalValueAlignment.vposition;
        } else {
            vLayoutName = vLayoutName + this.totalValueAlignment.hposition + this.totalValueAlignment.vposition;
        }
    }
    return vLayoutName;
};

// doAddValueElement(argparent, argprops) {
//     let eProps = {};
//     let element = this.ChartHelper.createDivElement(eProps);
//     return element;
// }

BaseColumnSeries.prototype.placeholderlayoutClassName = function (itemname, index) {
    let lLayoutName = itemname;

    let hpos = this.placeholderAlignment.alterpos == "true" && index ? (this.placeholderAlignment.hposition == "left" ? "right" : this.placeholderAlignment.hposition == "right" ? "left" : this.placeholderAlignment.hposition) : this.placeholderAlignment.hposition;
    if ((index == 0 || !!index) && this.placeholderAlignment.alterpos == "true") {
        hpos = this.placeholderAlignment.hposition == "center" && index == 0 ? "right" : this.placeholderAlignment.hposition == "center" ? "left" : hpos;
    }
    if (lLayoutName.includes("graphic") && this.placeholderAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + hpos + this.placeholderAlignment.vposition;
    }
    return lLayoutName;
};

BaseColumnSeries.prototype.doAddPrimaryPlaceholder = function (argparent, argprops) {
    const index = argprops.index;
    const bounds = this.getPlaceholderBounds();
    const pLayoutName = this.placeholderlayoutClassName("placeholder");
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    let baseelement = this.ChartHelper.createDivElement({});
    let placeholderWidth = this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    let placeholderHeight = this.data.layout.placholderHeight && this.data.layout.placholderHeight < bounds.height ? this.data.layout.placholderHeight * this.data.placeholderSizeRatio + "px" : bounds.height * this.data.placeholderSizeRatio + "px";
    if (this.data.chartFlip) {
        baseelement.style.marginRight = this.data.layout.placeholderPaddingleft + "px";
        baseelement.style.marginLeft = this.data.layout.placeholderPaddingright + "px";
        baseelement.style.marginBottom = this.data.layout.placeholderPaddingtop + "px";
        baseelement.style.marginTop = this.data.layout.placeholderPaddingbottom + "px";
    } else {
        baseelement.style.marginLeft = this.data.layout.placeholderPaddingleft + "px";
        baseelement.style.marginRight = this.data.layout.placeholderPaddingright + "px";
        baseelement.style.marginTop = this.data.layout.placeholderPaddingtop + "px";
        baseelement.style.marginBottom = this.data.layout.placeholderPaddingbottom + "px";
    }
    baseelement.style.height = placeholderHeight;
    baseelement.style.width = placeholderWidth;
    baseelement.style.position = "relative";
    baseelement.className = pLayoutName;
    baseelement.style.display = "flex";
    if (argparent) argparent.appendChild(baseelement);
    let customColorIndex = this.data.seriesItemLength > 1 ? 1 : this.ChartFonts.customColor(this.index);
    baseelement.classList.add("th-section" + customColorIndex);
    baseelement.classList.add("contentContainer");
    baseelement.classList.add("clsMultiColorParent");
    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");
    baseelement.setAttribute("data-nodetype", "contentContainer");
    if (this.data.layout.placeholderAlterPaddingClass && this.data.chartFlip) {
        baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
    } else {
        if (this.data.layout.placeholderPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderPaddingClass);
        }
    }
    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);
    let baseElementStyle = window.getComputedStyle(baseelement);
    let paddingLeft = baseElementStyle.paddingLeft;
    let paddingRight = baseElementStyle.paddingRight;
    let paddingTop = baseElementStyle.paddingTop;
    let paddingBottom = baseElementStyle.paddingBottom;
    const element = this.ChartHelper.createDivElement({});
    element.id = "primary-placeholder-" + index;
    element.className = "primaryplaceholder topprimaryplaceholder" + pLayoutName;
    element.style.position = "relative";
    element.style.width = parseFloat(placeholderWidth) - parseFloat(paddingLeft || 0) - parseFloat(paddingRight || 0) + "px";
    element.style.height = parseFloat(placeholderHeight) - parseFloat(paddingTop || 0) - parseFloat(paddingBottom || 0) + "px";
    element.style.order = this.placeholderAlignment.index;
    if (this.data.layout.boolplaceholderShape) {
        //this.bgProperties(element);
    }

    baseelement.appendChild(element);

    if (this.data.layout.boolplaceholderShape) {
        element.style.alignItems = "center";
        element.style.justifyContent = "center";
    }
    let type = argprops.placeholdertype.toLowerCase();
    if (type == "image") {
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    }
    let logoBounds = this.getLogoBounds(type);
    if ((type == "logo" || this.data.hasLogoPlaceholder) && logoBounds) {
        element.style.height = logoBounds.height * this.data.placeholderSizeRatio + "px";
        element.style.width = logoBounds.width * this.data.placeholderSizeRatio + "px";
        baseelement.style.height = logoBounds.height * this.data.placeholderSizeRatio + "px";
        baseelement.style.width = logoBounds.width * this.data.placeholderSizeRatio + "px";
        if (type != "logo") {
            baseelement.style.width = logoBounds.height * this.data.placeholderSizeRatio + "px";
            element.style.width = logoBounds.height * this.data.placeholderSizeRatio + "px";
        }
    }
    this.rectSeriesItem.height -= bgElement.clientHeight + parseFloat(paddingTop) + parseFloat(paddingBottom);
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            this.setBorderWidth(baseelement);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            this.setImageBorderWidth(baseelement);
            break;
        case "logo":
            element.classList.add("logoHolder");
            element.setAttribute("data-nodetype", "logoHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 2) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[2]);
            this.doAddLogoUseNodeElement(element, argprops, "logo");
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

BaseColumnSeries.prototype.doAddImageUseNodeElement = function (element, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);

    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.src = this.data.primaryPlaceholderPath[this.index];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    subelement.setAttribute("data-nodetype", "imageNode");
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[this.groupindex]);

    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", "img", true);
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type, true);

    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);

    // if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey") {
    //     BgStyle = "var(--tertiary-color)";
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    // }
    // if (this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey") {
    //     BgStyle = "var(--item" + this.index + "-color)";
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    // }
    // if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    // }
};
BaseColumnSeries.prototype.doAddLogoUseNodeElement = function (element, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.setAttribute("data-holder-type", "primary");
    element.setAttribute("data-node-content-type", "logo");

    element.appendChild(nodeBgElement);
    let alignment = this.data.chartFlip ? "bottom" : "top";
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-imagecropalignment", alignment);
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    subelement.setAttribute("data-nodetype", "imageNode");
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[this.groupindex]);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    CommonImageUtils.updateImageBounds(subelement, "logo");
    subelement.src = this.data.primaryPlaceholderPath[this.index];
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
};
BaseColumnSeries.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon",
        "data-nodetype": "iconNode",
        id: "placeholder-" + this.index + "_0",
    });
    element.setAttribute("data-nodetype", "iconNode");

    if (this.data.layout.boolplaceholderShape) {
        this.data.SVGUtils.assignAttributes(element, {
            style: "width:60%;height:60%;",
        });
    }
    let iconFillColor = this.ChartFonts.graphicFillColor(this.index);
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        iconFillColor = "clsAlterTertiaryColor";
    }
    if (this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") {
        iconFillColor = "clsAlterTertiaryColor";
    } else if (
        (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
        (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
    ) {
        iconFillColor = "clsSecondaryFill";
    }
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        iconFillColor = "var(--item" + 5 + "-color)";
    }
    if (this.data.projection[this.index] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        iconFillColor = "var(--item" + 1 + "-color)";
    }
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon",
    });
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.index + "_0",
        class: "primaryplaceholdergraphic ",
        "data-placeholderelement": "icon,image",
        "data-id": this.index + "_0",
        "data-type": "ICON",
        "data-iconpath": this.data._primaryPlaceholderPathData[this.index],
        "data-name": this.data.primaryPlaceholderName[this.index],
        "xlink:href": "#" + this.data.primaryPlaceholderName[this.index],
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    this.data.SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};

BaseColumnSeries.prototype.doAddSecondartPlaceholder = function (argparent, argprops) {
    let eProps = {};
    let element = this.ChartHelper.createDivElement(eProps);
    return element;
};

BaseColumnSeries.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment ? this.placeholderAlignment.show : false;
};

BaseColumnSeries.prototype.getPlaceholderBounds = function (props) {
    let sourceParentWidth = this.minWidthValue > 0 ? this.minWidthValue : this.state.width;
    if (this.data.primaryPlaceholder) {
        let dummeyWidth = 0;
        if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
            dummeyWidth = sourceParentWidth * 0.8 > 120 ? 120 : sourceParentWidth * 0.8;
            return { width: dummeyWidth, height: dummeyWidth };
        } else {
            dummeyWidth = sourceParentWidth * 0.8 > 120 ? 120 : sourceParentWidth * 0.8;
            return { width: dummeyWidth, height: dummeyWidth };
        }
    } else {
        return { width: sourceParentWidth, height: 0 };
    }
};

BaseColumnSeries.prototype.getValueBounds = function (props) {
    if (this.data.value) {
        return { width: this.state.width, height: 50 };
    } else {
        return { width: this.state.width, height: 0 };
    }
};
BaseColumnSeries.prototype.findLongLabelWidth = function (element, longLabel) {
    let arrSplitWords = longLabel.split(" ");
    let longWordLength = 0;
    let longWord = "";
    for (let i1 = 0; i1 < arrSplitWords.length; i1++) {
        if (arrSplitWords[i1].length > longWordLength) {
            longWordLength = arrSplitWords[i1].length;
            longWord = arrSplitWords[i1];
        }
    }
    element.innerText = longWord;
    let width = element.clientWidth;
};
BaseColumnSeries.prototype.lineCount = function (subelement) {
    let paddingStyle = window.getComputedStyle(subelement);
    let lineHeight = paddingStyle["line-height"] ? parseFloat(paddingStyle["line-height"]) : 1;
    let elementHeight = subelement.clientHeight;
    let lineCount = Math.floor(elementHeight / lineHeight);
    if (lineCount == 1) {
        return true;
    } else {
        return false;
    }
};
BaseColumnSeries.prototype.getLogoBounds = function (type) {
    let Width = 0;
    let Height = 0;
    let sourceParentWidth = this.minWidthValue > 0 ? this.minWidthValue : this.state.width;
    if (this.data.primaryPlaceholder) {
        // if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
        //     return { width: this.state.height *1, height: this.state.height * 1 };
        // } else {
        Height = sourceParentWidth * 0.61;
        Width = sourceParentWidth;
        if (this.data.hasLogoPlaceholder) {
            let tempWidthValue = sourceParentWidth * 0.8 > 200 ? 200 : sourceParentWidth * 0.8;
            Height = tempWidthValue * 0.61;
            Width = tempWidthValue;
        }
        return { width: Width, height: Height };
        // }
    } else {
        return { width: 0, height: sourceParentWidth };
    }
};

let graphicH = 0;
let padding = 8;
let bkelement;
let bkSubElement;
let middleelementValue;
let middleelementLabel;
let middleelementPlaceholder;
let overlapStackedColumn = false;
let differnceIndex;
let parentHeight;
let stackedGraphicH = 0;
function BaseColumnSeriesItem(argparent, argprops) {
    this.voData = null;
    this.name = "BaseSeries";
    this.valuePosition = "middle";
    this.placeholderPosition = "top";
    this.minValueFontSize = [25, 25];
    this.maxLabelH = 0;
    this.maxValueH = 0;
    this.middleLW = 0;
    this.middleLH = 0;
    this.middleVW = 0;
    this.middleVH = 0;
    this.middlePW = 0;
    this.middlePH = 0;
    this.addlabel = argprops.addlabel;
    this.addvalue = argprops.addvalue;
    this.addplaceholder = argprops.addplaceholder;
    this.gapPercentage = argprops.gapPercentage;
    this.labelMaxW = 230;
    this.intCircleRadius = 8;
    this.labelMaxH = 0;
    this.valueMaxW = 0;
    this.valueMaxH = 0;
    this.eableLine = false;
    this.boolDisableWidth = false;
    this.ChartFonts = new window["ChartFonts"]();
    this.maxValueFontSize = this.ChartFonts.maxValueFontSize;
    this.valueStyle = this.ChartFonts.valueOuterColor;
    this.maxLabelFontSize = [22, 22];
    this.minValueFontSize = [25, 25];
    this.placeholderStyle = this.ChartFonts.valueOuterColor;
    this.emphasisColor = this.ChartFonts.emphasizeColor;
    this.boolEnableInnerValue = false;
    this.valueOuter = false;
    this.overlap = false;
    this.stackedChartOverlap = false;
    this.maxCurrentValueW = 0;
    this.maxCurrentLabelW = 0;
    this.maxElementValueW = 0;
    this.transformOrginValue = "transformOrginBottom";
    this.negativeTransformValue = "transformOrginTop";
    this.customOrginValue = "bottom";
    this.customNegativeOrginmValue = "top";
    this.innerValuePlace = false;
    this.lineCount = 3;
    this.statisticalHeight = 0;
    BaseSeriesItem.call(this, argparent, argprops);
}
BaseColumnSeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
BaseColumnSeriesItem.prototype.constructor = BaseColumnSeriesItem;

BaseColumnSeriesItem.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseColumnSeriesItem.prototype.updateBasicData = function () {
    this.boolEnableInnerValue = false;
    this.itembasedHeight = 0;
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    if (this.data.chartName == "imageColumnIconFill" || this.data.chartName == "verticalDumbellChart" || this.data.chartName == "shapesComparisonPieChart") {
        this.length = 1;
    }
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    if (this.data.chartFlip) {
        this.transformOrginValue = "transformOrginTop";
        this.negativeTransformValue = "transformOrginBottom";
        this.customOrginValue = "top";
        this.customNegativeOrginmValue = "bottom";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        let dummeyLeftvalue = this.data.layout.labelPaddingleft;
        let dummeyRightValue = this.data.layout.labelPaddingright;
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? dummeyRightValue : dummeyLeftvalue;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? dummeyLeftvalue : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        let leftPadding = this.data.layout.valuePaddingleft;
        let rightPadding = this.data.layout.valuePaddingright;
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? rightPadding : leftPadding;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? leftPadding : rightPadding;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.secondaryLabelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLabelHPosition,
        vposition: this.data.layout.secondaryLabelVPosition,
        show: this.data.layout.showsecondaryLabel,
        inset: this.data.layout.secondaryLabelInset,
        index: this.data.layout.secondaryLabelPosIndex,
        itemBased: this.data.layout.secondaryLabelItemBased,
        samepos: this.data.layout.secondaryLabelSamePos,
        textbg: this.data.layout.secondaryLabeltextbg,
        textbgstyle: this.data.layout.secondaryLabeltextbgstyle,
        textbgcallout: this.data.layout.secondaryLabeltextbgcallout,
        textbgitem: this.data.layout.secondaryLabeltextbgItem,
    });
    this.secondaryNumberAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryNumberHPosition,
        vposition: this.data.layout.secondaryNumberVPosition,
        show: this.data.layout.secondaryNumber,
        inset: this.data.layout.secondaryNumberInset,
        index: this.data.layout.secondaryNumberPosIndex,
        itemBased: this.data.layout.secondaryNumberItemBased,
        samepos: this.data.layout.secondaryNumberSamePos,
        textbg: this.data.layout.secondaryNumbertextbg,
        textbgstyle: this.data.layout.secondaryNumbertextbgstyle,
        textbgcallout: this.data.layout.secondaryNumbertextbgcallout,
        textbgitem: this.data.layout.secondaryNumbertextbgItem,
    });
    this.secondaryLogoAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLogoHPosition,
        vposition: this.data.layout.secondaryLogoVPosition,
        show: this.data.layout.secondaryLogo,
        inset: this.data.layout.secondaryLogoInset,
        index: this.data.layout.secondaryLogoPosIndex,
        itemBased: this.data.layout.secondaryLogoItemBased,
        samepos: this.data.layout.secondaryLogoSamePos,
        textbg: this.data.layout.secondaryLogotextbg,
        textbgstyle: this.data.layout.secondaryLogotextbgstyle,
        textbgcallout: this.data.layout.secondaryLogotextbgcallout,
        textbgitem: this.data.layout.secondaryLogotextbgItem,
    });
    this.secondarySequenceAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondarySquenceNumberHPosition,
        vposition: this.data.layout.secondarySquenceNumberVPosition,
        show: this.data.layout.secondarySquenceNumber,
        inset: this.data.layout.secondarySquenceNumberInset,
        index: this.data.layout.secondarySquenceNumberPosIndex,
        itemBased: this.data.layout.secondarySquenceNumberItemBased,
        samepos: this.data.layout.secondarySquenceNumberSamePos,
        textbg: this.data.layout.secondarySquenceNumbertextbg,
        textbgstyle: this.data.layout.secondarySquenceNumbertextbgstyle,
        textbgcallout: this.data.layout.secondarySquenceNumbertextbgcallout,
        textbgitem: this.data.layout.secondarySquenceNumbertextbgItem,
    });
    this.alignment = this.secondaryLabelAlignment;
    if (this.data.layout.secondaryElementType == "image") {
        this.alignment = this.secondaryLogoAlignment;
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        this.alignment = this.secondarySequenceAlignment;
    }
    if (this.data.layout.secondaryElementType == "number") {
        this.alignment = this.secondaryNumberAlignment;
    }
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.2 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage;
    // if (this.data.layout.multiSeriesItemSize && this.data.seriesItemLength > 1) {
    //     this.valueMaxW = parseFloat(this.data.layout.multiSeriesItemSize);
    // }
    this.valueMaxH = this.state.height * 0.4; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.statisticalAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.statisticalHPosition,
        vposition: this.data.layout.statisticalVPosition,
        show: this.data.layout.showstatistical,
        inset: this.data.layout.statisticalInset,
        index: this.data.layout.statisticalPosIndex,
        itemBased: this.data.layout.statisticalItemBased,
        samepos: this.data.layout.statisticalSamePos,
        textbg: this.data.layout.statisticaltextbg,
        textbgstyle: this.data.layout.statisticaltextbgstyle,
        textbgcallout: this.data.layout.statisticaltextbgcallout,
        textbgitem: this.data.layout.statisticaltextbgItem,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased == "true") this.valueMaxW = this.state.width * 0.4;
        if (this.valueAlignment.itemBased == "true") this.labelMaxW = this.state.width * 0.4;
    }
    if (this.labelAlignment.itemBased == "true" || this.labelAlignment.position == "inner") {
        this.itembasedHeight += this.labelMaxH;
    }
    if (this.valueAlignment.itemBased == "true" || this.valueAlignment.position == "inner" || this.valueAlignment.position == "middle") {
        this.itembasedHeight += this.valueMaxH;
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.itembasedHeight += 110;
    }
};

BaseColumnSeriesItem.prototype.doMeasurementComputation = function () {};

BaseColumnSeriesItem.prototype.doAddGraphicElement = function () {
    this.itemBasedValueWidth = 1 - this.thicknessPercentage;
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        let remaingValue = this.data.values[this.groupindex][this.index] % 10;
        let maxCount = this.data.displayValueMaxCount;

        let roundedValue = 0;
        let originalValue = 0;
        if (remaingValue >= 5) {
            let addinValue = 10 - remaingValue;
            originalValue = addinValue + parseInt(this.data.values[this.groupindex][this.index]);
        } else {
            originalValue = parseInt(this.data.values[this.groupindex][this.index]) - remaingValue;
        }
        this.data.valuesDenomination[this.index][0] = originalValue;
        let splitValue = this.data.values[this.groupindex][this.index].toString().split("");
        let multiplefactor = maxCount / 10;
        let graphicCount = splitValue.length > 1 ? parseFloat(splitValue.join(".")) : this.data.values[this.index][0];
        graphicCount = Math.round(graphicCount * multiplefactor);
        graphicCount = this.data.values[this.index][0] >= 100 ? maxCount : graphicCount;
        this.data.valuesDenomination[this.index][0] = graphicCount;
    }
    if (this.data.displayValueFormat == "outof" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data._valuesDenomination[this.groupindex][this.index] = this.data._valuesDenomination[this.groupindex][this.index] + " out of " + this.data.displayValueMaxCount;
    }
    if (this.data.displayValueFormat == "fraction" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] + "/" + this.data.displayValueMaxCount;
    }

    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const stackHeight = this.data._stackedPercentage && this.data._boolPercentageChart ? eProps.value / 100 : eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const numParentWidth = this.parent.getAttribute("data-width") / this.length;
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.justifyContent = "flex-end";
    element.style.width = this.data.stackedChart ? "100%" : 100 / this.length + "%";
    if (this.data.layout.multiseriesGapValue > 0 && !this.data.stackedChart && !this.data.baseProperties.isItemCompareChart) {
        let totalWidth = parseFloat(this.data.layout.multiseriesGapValue) * (this.length - 1);
        let indualWidth = (parseFloat(this.parent.clientWidth) - totalWidth) / this.length;
        element.style.width = this.data.SVGUtils.createPercentValue(this.parent.clientWidth, indualWidth);
        this.parent.style.setProperty("justify-content", "space-between");
    }
    if (this.data.baseProperties.isItemCompareChart) {
        element.style.width = this.index == 0 ? "100%" : "50%";
        if (this.index > 0) {
            element.style.position = "absolute";
            this.parent.style.justifyContent = "center";
        } else {
            element.classList.add("cs-two-series-chart-bg-color");
        }
        element.style.zIndex = 2;
    }
    element.style.height = this.data.stackedChart ? stackHeight * 100 + "%" : "100%";
    let stackedHighlightDifferenceHeight = 0;
    if ((this.data.highlightDifference.display || this.data.indualHighlight) && this.data.stackedChart) {
        stackedHighlightDifferenceHeight = this.data._hdHight2;
    }
    if (this.data._secondaryLineChart && (this.data.totalValueBounds.height < 1 || this.data.promptText)) {
        if (this.data._secondaryLineChartValue) {
            this.parent.appendChild(element);
            this.doAddTopValue(element, eProps, true, false, false, 0, true);
            let valueHeight = eProps.minvalue < 0 ? 2 * this.maxValueH : this.maxValueH;
            if (this.index == 0 && this.groupindex == 0) {
                this.data.secondaryLineValueMaxHeight = valueHeight + this.intCircleRadius + this.data.extraElementBounds?.height;
            }
            let heightValue = this.data.secondaryLineValueMaxHeight + stackedHighlightDifferenceHeight;
            let parentHeightValue = this.parent?.style?.height;
            let intParentHeight = parseFloat(parentHeightValue || 100);
            let calcualtedHeight = (intParentHeight / 100) * heightValue;
            if (this.index == 0) {
                let strCalcValue = "calc(" + parentHeightValue + " - " + calcualtedHeight + "px)";
                if (this.data.stackedChart) this.parent.style.height = strCalcValue;
            }
        } else {
            this.parent.appendChild(element);
            if (this.index == 0 && this.groupindex == 0) {
                this.data.secondaryLineValueMaxHeight = this.intCircleRadius + this.data.extraElementBounds?.height;
            }
            let heightValue = this.data.secondaryLineValueMaxHeight + stackedHighlightDifferenceHeight;
            let parentHeightValue = this.parent?.style?.height;
            let intParentHeight = parseFloat(parentHeightValue || 100);
            let calcualtedHeight = (intParentHeight / 100) * heightValue;
            if (this.index == 0) {
                let strCalcValue = "calc(" + parentHeightValue + " - " + calcualtedHeight + "px)";
                if (this.data.stackedChart) this.parent.style.height = strCalcValue;
            }
        }
    } else {
        this.parent.appendChild(element);
        let parentHeightValue = this.parent?.style?.height;
        let heightValue = this.data.extraElementBounds?.height || 0;
        if (this.data.stackedChart && (this.data.totalValueBounds.height < 1 || this.data.promptText)) {
            heightValue += stackedHighlightDifferenceHeight;
        }
        let intParentHeight = parseFloat(parentHeightValue || 100);
        let calcualtedHeight = (intParentHeight / 100) * heightValue;
        if (this.index == 0) {
            let strCalcValue = "calc(" + parentHeightValue + " - " + calcualtedHeight + "px)";
            if (this.data._stackedPercentage) {
                strCalcValue = "calc(100% - " + calcualtedHeight + "px)";
            }
            if (this.data.stackedChart) this.parent.style.height = strCalcValue;
        }
    }

    if ((this.data._seriesItemLength > 1 || this.data.seriesanimation) && (this.data.stackedChart || this.data.baseProperties.isItemCompareChart || this.data.chartName == "columnSimpleRectangle" || this.data.chartName == "columnLaderChart" || this.data.chartName == "column3DRectangle")) {
        let customColorIndex = this.ChartFonts.customColor(this.index);
        if (this.data.seriesanimation) customColorIndex = this.ChartFonts.customColor(this.data.seriesAnimationIndex);
        if (this.data.baseProperties.isItemCompareChart && this.index == 1) {
            customColorIndex = this.ChartFonts.customColor(0);
        }
        element.classList.add("th-section" + customColorIndex);
    }
    if (this.data.baseProperties.isItemCompareChart) {
        if (this.index == 0) {
            element.classList.add("cs-two-series-chart-bg-color");
        }
    }
    if (this.data._arrseriesItemHighValue[this.index] == "true") {
        element.classList.add("cs-series-item-highlight-enabled");
    } else if (this.data.hasSeriesItemHighlight) {
        element.classList.add("cs-series-item-highlight-disabled");
    }
    if (this.data.stackedChart) element.style.display = "block";
    element.setAttribute("data-width", numParentWidth);
    this.parent.appendChild(element);
    if (this.data.data.getAttribute("data-barspace") == "Overlapping" && this.data.seriesItemLength > 1 && this.index > 0) {
        element.style.position = "relative";
        element.style.left = "-20px";
    }
    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(element, eProps);
    this.doAddBottomSeriesItemElement(element, eProps);
    if (eProps.minvalue < 0) {
        this.doCalculateElementHeight(element, eProps);
    }
    // if (this.data.stackedChart) {
    //     this.valueOverlapping();
    // }
};
BaseColumnSeriesItem.prototype.doCalculateElementHeight = function (argparent, argprops) {
    if (this.groupindex == this.data.seriesLength - 1) {
        let topSeriesItem = this.parent?.parentNode?.parentNode?.querySelectorAll(".topseriesitem") || [];
        let bottomSeriesItem = this.parent?.parentNode?.parentNode?.querySelectorAll(".bottomseriesitem") || [];
        let baseBootomGraphic = this.parent?.parentNode?.parentNode?.querySelector(".basebottomgraphic") || null;
        let baseTopGraphic = this.parent?.parentNode?.parentNode?.querySelector(".basetopgraphic") || null;
        let topValueHeight = 0;
        if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") {
            topValueHeight = baseTopGraphic?.querySelector(".value")?.clientHeight || 0;
        }
        let bottomValueHeight = 0;
        if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") {
            bottomValueHeight = baseBootomGraphic?.querySelector(".value")?.clientHeight || 0;
        }
        let totalValueHeight = topValueHeight + bottomValueHeight;
        let graphicArea = this.state.height - totalValueHeight;
        let totalMaxValue = -argprops.minvalue + argprops.maxvalue;
        let multipleFactor = graphicArea / totalMaxValue;
        let topgraphicHeight = argprops.maxvalue * multipleFactor;
        let bottomgraphicHeight = -argprops.minvalue * multipleFactor;
        for (let i = 0; i < topSeriesItem.length; i++) {
            topSeriesItem[i].style.height = this.data.SVGUtils.createPercentValue(this.state.height, topgraphicHeight + topValueHeight);
        }
        for (let i = 0; i < bottomSeriesItem.length; i++) {
            bottomSeriesItem[i].style.height = this.data.SVGUtils.createPercentValue(this.state.height, bottomgraphicHeight + bottomValueHeight);
        }
    }
};
BaseColumnSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = parseInt(argprops.gindex);
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    if (argprops.minvalue == 0 && totalValue == 0) {
        totalValue = 1;
    }
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")))) ? 143 : 10;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.stackedChart || this.data.chartName == "columnImageHorizontalChart" ? "100%" : minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (this.data.chartName == "columnImageHorizontalChart") {
        element.setAttribute("data-height", this.state.height);
    }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
};

BaseColumnSeriesItem.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment && !this.addplaceholder && this.placeholderAlignment.position != "middle" ? this.placeholderAlignment.show : false;
};

BaseColumnSeriesItem.prototype.displayLabel = function (argprops) {
    return this.labelAlignment && !this.addlabel && this.labelAlignment.position != "middle" ? this.labelAlignment.show : false;
};

BaseColumnSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment && !this.addvalue && this.valueAlignment.position != "middle" ? this.valueAlignment.show : false;
};

BaseColumnSeriesItem.prototype.doAddBottomSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numBottomHeight = -argprops.minvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight =
            (this.labelAlignment && this.labelAlignment.position == "middle") ||
            (this.valueAlignment && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.valueAlignment && this.valueAlignment.position == "middle")
                ? 300
                : 10;
        if (numBottomHeight < minimumHeight && argprops.minvalue < 0) {
            numBottomHeight = minimumHeight;
        }
        numBottomHeight = numBottomHeight > this.state.height - this.itembasedHeight ? this.state.height - this.itembasedHeight : numBottomHeight;
    }

    let minGraphicHeight = (numBottomHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem bottomseriesitem";
    element.style.height = minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numBottomHeight);
    if (argparent) argparent.appendChild(element);
    else return element;
    if (argprops.value < 0) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numBottomHeight },
        };
        // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "top") {
        //     this.doAddBottomPlaceholder(element, argprops);
        // }

        // if (this.displayValue(argprops) && this.valuePosition == "top") {
        //     this.doAddBottomValue(element, argprops);
        // }
        this.doAddBottomGraphicsContainer(element, eprops);

        // this.middleElementvalidationBottom(bkelement, element, middleelementValue, middleelementPlaceholder, middleelementLabel,eprops);
    } else {
        if (this.data.minValue < 0) {
            let topSeriesItem = this.parent.querySelector(".topseriesitem");
            let topHeight = topSeriesItem ? topSeriesItem.clientHeight : 0;
            let baseParentHeight = this.state.height;
            if (this.data.highlightDifference.display) {
                baseParentHeight -= this.data._hdHight1;
            }
            if (this.data.indualHighlight) {
                baseParentHeight -= this.data._hdHight1;
            }
            // let baseParentHeight = this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
            // baseParentHeight = baseParentHeight<this.state.height?this.state.height:baseParentHeight;
            // element.style.height = this.data.SVGUtils.createPercentValue(this.state.height, baseParentHeight - topHeight);
            // let bottomHeightPercentage = parseFloat(element.style.height)
            // let totalHeight = topHeightPercentage+bottomHeightPercentage;
            // if(!isNaN(totalHeight)&&totalHeight<100){
            //     element.style.height = (100-topHeightPercentage)+"%";
            // }
            // element.style.height = baseParentHeight-topHeight+"px";
        }
        if (bkSubElement) {
            this.middleElementvalidation(bkelement, bkSubElement, middleelementValue, middleelementPlaceholder, middleelementLabel);
        }
    }
};

BaseColumnSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight, boolsecondarylinevalue = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});

    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    element.dataset.alignment = vLayoutName;
    if (this.valueAlignment.position == "inner" && this.data.stackedChart && boolmax) {
        element.style.position = "absolute";
    }
    if (this.overlap) {
        element.dataset.outerside = "true";
    }
    if (this.data.layout.backgroundColor == "bgcolor") {
        element.style.zIndex = 3;
    }
    if (this.valueAlignment.position == "middle") {
        element.classList.add("middleposition");
    }
    if (this.data.chartName == "imageColumnIconFill") {
        element.style.position = "absolute";
        element.style.display = "none";
    }
    if (this.valueAlignment.vposition == "top" && this.valueAlignment.itemBased != "true") {
        element.style.alignItems = "flex-end";
    }
    if (this.valueAlignment.position != "middle") {
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
    }
    if (this.data.values[groupindex][index] < 0 || (this.valueAlignment.itemBased == "true" && this.data.layout.itemalterpos == "true" && this.groupindex == 1 && this.valueAlignment.position != "inner")) {
        element.style.paddingTop = padding["bottom"] + "px";
        element.style.paddingBottom = padding["top"] + "px";
        if (this.data.layout.valueAlterPaddingClass) {
            element.classList.add(this.data.layout.valueAlterPaddingClass);
        }
        if (this.data.chartFlip) {
            if (this.data.layout.valuePaddingClass) {
                element.classList.add(this.data.layout.valuePaddingClass);
            }
        }
    } else {
        if (this.data.layout.valuePaddingClass) {
            element.classList.add(this.data.layout.valuePaddingClass);
        }
        if (this.data.chartFlip || this.overlap) {
            if (this.data.layout.valueAlterPaddingClass) {
                element.classList.add(this.data.layout.valueAlterPaddingClass);
            }
        }
    }
    if (boolsecondarylinevalue) {
        element.classList.add("secondarylinecalcvalue");
    }
    let valuesMaxWidth = this.valueMaxW;
    element.style.maxWidth = valuesMaxWidth + "px";
    let graphicContainer = argparent.querySelector(".chartgraphic");
    let dummeyGraphicHeight = graphicH;
    if (graphicContainer) {
        dummeyGraphicHeight = graphicContainer.clientHeight > dummeyGraphicHeight ? graphicContainer.clientHeight : dummeyGraphicHeight;
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder") && (this.valueAlignment.vposition == "bottom" || dummeyGraphicHeight < this.middlePW / 2)) {
        element.style.marginBottom = this.middlePW / 2 + 2 + "px";
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.boolDisableWidth || this.data.layout.valueItemBased == "true") {
        element.style.width = "";
    } else {
        element.style.width = valuesMaxWidth + "px";
    }
    if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            // element.style.marginLeft = "auto";
        } else {
            // element.style.marginRight = "auto";
        }
    }

    if (this.data._projectionName == "projection-alpha" || (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (!this.data.hasEmphasis && !this.data.hasProjection) || (!this.data.hasEmphasis && this.data.hasProjection && this.data.projection[groupindex] != true)) {
        if (!this.overlap) this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    }
    if (((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (!this.data.hasEmphasis && this.data.hasProjection && this.data.projection[groupindex] != false)) && this.data.chartName == "columnSimpleRectangle" && this.data.layout.labelItemBased == "true") {
        if (!this.overlap) this.valueStyle = "clsContrastColor";
    }
    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display && !this.overlap) highlightPoint = true;
    }
    if (((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && !this.valueOuter && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || this.boolEnableInnerValue) && this.data.chartName != "shapesComparisonChart") {
        this.valueStyle = this.ChartFonts.valueInnerColor;
    }
    // if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
    //     this.valueStyle = "accent" + (this.groupindex + 1) + "-color";
    // }
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "valuetext-" + groupindex + "_" + index);
    let promptTextThemeClass = this.ChartFonts.promptTextClassName;
    if (this.data.lineHighlightStyle[this.groupindex] == "true" && this.data.highlights[this.groupindex] && this.data.lineHighlightPoint && this.data.chartName == "lineChart") {
        this.valueStyle = "";
    }
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    if (this.overlap && this.valueStyle != "dummeycolor") {
        colorTabValueCustomClass = "clsValueTextColor";
    }
    if (!this.data.layout.microChartText) {
        subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.ChartFonts.valueThemeClassName;
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.ChartFonts.valueThemeClassName || "n1");
            subelement.classList.add(this.data.customValueFontClass);
        }
        if (this.data.promptText) {
            subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + promptTextThemeClass;
        }
    } else {
        subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.ChartFonts.valueThemeClassName;
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.ChartFonts.valueThemeClassName || "n1");
            subelement.classList.add(this.data.customValueFontClass);
        }
        if (this.data.promptText) {
            subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + promptTextThemeClass;
        }
    }
    if ((this.data.layout.valueInset == "inside" || this.data.layout.valueInset == "middle") && this.valueStyle != "outerColor1" && !this.overlap) {
        if (this.data.promptText) {
            subelement.className = "valuetext " + this.valueStyle + " " + promptTextThemeClass + " moodanimation";
        } else {
            subelement.className = "valuetext " + this.valueStyle + "  moodanimation " + this.ChartFonts.valueThemeClassName;
            if (this.data.customValueFontClass) {
                subelement.classList.remove(this.ChartFonts.valueThemeClassName || "n1");
                subelement.classList.add(this.data.customValueFontClass);
            }
        }
    }
    let hasDoubleNode = this.data.chartName == "columnSimpleRectangle" && this.data.layout.labelItemBased == "true" ? true : false;
    if (this.data.layout.valueColor && !hasDoubleNode) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        if (!this.overlap) subelement.classList.add("cs-inner-text-color");
    }
    if (hasDoubleNode && this.data.hasProjection) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.add("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        if (!this.overlap) subelement.classList.add("cs-inner-text-color");
    }
    if (this.data._arrseriesItemHighValue[this.index] == "true") {
        subelement.classList.remove("cs-value-text");
        subelement.classList.remove("clsValueInnerText");
        if (this.data.layout.valueInset == "inside" && !this.overlap) {
            subelement.classList.add("clsValueInnerText");
        } else {
            subelement.classList.add("cs-value-text");
        }
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    element.appendChild(subelement);
    subelement.innerHTML = boolmax ? this.data.prefix[groupindex][index] + this.data.longLengthValue + this.data.suffix[groupindex][index] : argprops.valuetext;
    subelement.setAttribute("data-type", "value");
    if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison") {
        subelement.setAttribute("data-specialtype", "value");
    }

    if (this.maxValueFontSize[this.arrIndex] != "null") {
        subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    } else if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    let fontSize = this.ChartFonts.maxLabelFontSize(subelement);
    if (this.data.promptText) {
        element.style.whiteSpace = "unset";
        subelement.setAttribute("data-type", "promt");
        if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison") {
            subelement.setAttribute("data-specialtype", "promt");
        }
        subelement.setAttribute("data-index", groupindex + "_" + index);
        subelement.classList.add("prompttext");
        element.classList.add("promt");
        subelement.setAttribute("data-prompt-text", "10-15");
        subelement.innerHTML = boolmax ? this.data.promptlongValue : this.data.promptTextValue[groupindex][index];
        if (boolsecondarylinevalue) {
            subelement.innerHTML = boolmax ? this.data._secondaryLinePromptLongValue : this.data.promptTextValue[groupindex][index];
        }
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        this.maxValueFontSize[this.arrIndex] = fontSize;
        subelement.dataset.animation = "prompttext";
    } else {
        subelement.style.maxHeight = this.valueMaxH + "px";
        subelement.dataset.animation = "secondarytext";
    }
    if (this.valueAlignment.itemBased == "true" && this.valueAlignment.hposition == "left") {
        let paddingStyle = window.getComputedStyle(element);
        let horPaddingValue = parseFloat(paddingStyle["padding-left"] || 0) + parseFloat(paddingStyle["padding-right"] || 0);
        valuesMaxWidth = valuesMaxWidth - horPaddingValue;
    }
    subelement.style.maxWidth = valuesMaxWidth + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    if (this.data.highlights[groupindex] && this.data.lineHighlightPoint && this.data.lineHighlightStyle[groupindex] == "true" && this.data.chartName == "lineChart") {
        subelement.style.visibility = "visible";
    }
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (this.valueStyle == "textgradient" && !this.data.layout.microChartText) {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.hasEmphasis || this.data.hasProjection) {
        subelement.classList.add("cs-value-text");
    }
    if (this.innerValuePlace && this.data.layout.itemFillType == "image" && this.data.grapicImage[groupindex] == "true") {
        subelement.style.pointerEvents = "all";
        element.style.pointerEvents = "none";
    }
    if (boolenablePer) {
        if (this.data.displayValueFormat == "number") {
            // if(this.data.suffix[this.groupindex][this.index]==""){
            //     subelement.innerText = this.data.values[groupindex][index];
            // }
        } else {
            subelement.dataset.defalutPercentage = "true";
            if (this.data.suffix[this.groupindex][this.index] == "") {
                subelement.innerText = argprops.valuetext + "%";
            }
        }
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle" && !this.data.layout.microChartText) {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    if (this.data.chartFlip) {
        subelement.setAttribute("data-graphic-y", -graphicH);
    }
    if (this.data.layout.microChartText) {
        subelement.classList.add(this.data.layout.microChartText);
    }
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
        if (this.data.chartFlip) {
            subelement.setAttribute("data-graphic-y", -customgraphicHeight);
        }
    }

    if (this.data.values[this.groupindex][this.index] < 0) {
        element.style.boolnegative = "true";
        subelement.dataset.boolnegative = "true";
    }
    if (this.data.stackedChart) {
        subelement.dataset.animation = this.data.promptText ? "prompttext" + (index + 1) : "secondarytext" + (index + 1);
        subelement.dataset.stackedmultiseries = "true";
        if (this.data.seriesLength == 1) subelement.dataset.singlestackedmultiseries = "true";
    }
    if (!this.data.promptText) subelement.setAttribute("data-animateItem", "secondarytext" + index);
    if (this.data.promptText) subelement.setAttribute("data-animateItem", "prompttext" + index);
    let borderElement1;
    if (this.data.layout.valuebgBorder || this.data.layout.valuebgBorder == "true") {
        borderElement1 = this.ChartHelper.createDivElement({});
        borderElement1.className = "moodanimation valueborder " + this.ChartFonts.graphicBgColor(groupindex);
        borderElement1.dataset.animation = "borderelement";
        element.appendChild(borderElement1);
        element.appendChild(subelement);
        element.style.alignItems = "center";
        element.style.position = "relative";
        borderElement1.style.position = "absolute";
        element.style.display = "flex";
        // subelement.style.paddingLeft = padding["left"] + "px";
        // subelement.style.paddingRight = padding["right"] + "px";
        subelement.classList.remove("itembgColor");
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        if (!this.overlap) subelement.classList.add("cs-inner-text-color");

        // subelement.classList.add("valuebg-color")
        subelement.style.zIndex = 1;
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }

    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        if ((this.data.presentMode || this.data.seriesanimation || this.data.disableEdit) && !this.data.promptText) {
            subelement.setAttribute("contenteditable", "false");
        } else {
            subelement.setAttribute("data-dck-selector", "true");
        }
    }
    if (this.data._stackedPercentage && this.data._boolPercentageChart && !this.data.promptText) {
        subelement.setAttribute("contenteditable", "false");
    }
    if (((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) && !this.data.promptText) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName != "simpleIconFillRepeatChart") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }

    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor && this.data.layout.valueColor != "contrast") {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (this.data.promptText) {
        paddingStyle = window.getComputedStyle(subelement);
        let promptMaxHeight = paddingStyle["line-height"] ? parseFloat(paddingStyle["line-height"]) * this.lineCount : this.valueMaxH;
        if (this.valueMaxH > promptMaxHeight) {
            subelement.style.maxHeight = promptMaxHeight + "px";
        } else {
            subelement.style.maxHeight = this.valueMaxH + "px";
        }
    }
    if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        if (this.data.suffixStyle) {
            let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
            if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
        }
        if (this.data.prefixStyle) {
            let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
            if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
        }
    }
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this.index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);

    if (this.data.promptText) {
        paddingStyle = window.getComputedStyle(subelement);
        let promptMaxHeight = paddingStyle["line-height"] ? parseFloat(paddingStyle["line-height"]) * this.lineCount : this.valueMaxH;
        if (this.valueMaxH > promptMaxHeight) {
            subelement.style.maxHeight = promptMaxHeight + "px";
        } else {
            subelement.style.maxHeight = this.valueMaxH + "px";
        }
    }
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" && this.data.seriesLength != 1 ? true : false;
    overlapgrid = this.data.promptText ? false : overlapgrid;
    overlapgrid = this.data.invaidData ? true : overlapgrid;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (this.data.values[groupindex][this.index] == this.data.rangePositive) {
        element.classList.add("gridmaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (this.data.values[groupindex][index] == this.data.minValue && this.data.minValue < 0) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }

    subelement.style.overflow = "hidden";
    // element.style.display="none"

    if (boolmax) {
        this.maxValueH = element.clientHeight;
        this.maxCurrentValueW = element.clientWidth;
        this.maxElementValueW = subelement.clientWidth;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (((parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") || (overlapgrid && this.voData.presentMode)) && this.data.chartName != "columnIconFill" && !this.data.promptText) {
            this.valueMaxLimit = this.valueOverlapping();
            this.maxValueH = 0;
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
        if (this.data.invaidData) {
            this.valueMaxLimit = this.valueOverlapping();
            overlapgrid = true;
            this.maxValueH = 0;
        }
        if (boolsecondarylinevalue) this.data.secondaryLineValueMaxFontSize = fontsize;
    } else {
        fontsize = parseInt(window.getComputedStyle(subelement)["font-size"]);
        if ((overlapStackedColumn && this.data.stackedChart) || (overlapgrid && calloutStyle != "textbgcalloutstyle4top") || (overlapgrid && this.voData.presentMode)) {
            overlapStackedColumn = false;
            if (stackedGraphicH < element.clientHeight && this.data.stackedChart) {
                this.removeValueElement();
            } else {
                if (!this.data.stackedChart) this.removeValueElement();
            }
        }
    }
    if (!boolmax) {
        let borderElement2;
        if (this.data.layout.valuebgBorder || this.data.layout.valuebgBorder == "true") {
            borderElement2 = this.ChartHelper.createDivElement({});
            borderElement2.className = "moodanimation valueborder " + this.ChartFonts.graphicBgColor(groupindex);
            borderElement2.dataset.animation = "borderelement";
            element.style.position = "relative";
            element.style.display = "flex";
            let subElementWidth = subelement.clientWidth;
            let elementWidth = element.clientWidth;
            let lineWidth = elementWidth - subElementWidth;
            borderElement2.style.width = lineWidth / 2 + "px";
            borderElement1.style.width = lineWidth / 2 + "px";
            // subelement.style.paddingLeft = padding["left"] + "px";
            // subelement.style.paddingRight = padding["right"] + "px";
            subelement.classList.remove("itembgColor");
            subelement.classList.remove("clsValueTextColor");
            subelement.classList.remove("clsValueTextColor");

            subelement.classList.remove("cs-inner-text-color");
            if (!this.overlap) subelement.classList.add("cs-inner-text-color");

            // subelement.classList.add("valuebg-color")
            subelement.style.zIndex = 1;

            borderElement1.style.position = "relative";
            element.appendChild(borderElement2);
            element.style.display = "flex";
        }
    }
    if (this.stackedChartOverlap) {
        subelement.style.display = "none";
    }
};

BaseColumnSeriesItem.prototype.valueOverlapping = function (enableGrid = true) {
    if (!this.data._customProperties.showYAxisGridValue && !this.data._customProperties.showYAxisGridValue) {
        this.data._customProperties.showYAxisGrid = true;
        // this.data._customProperties.showYAxisLine = true;
        // this.data._customProperties.showXAxisLine = true;
        this.data._customProperties.showYAxisGridValue = true;

        const valuesRange = this.ChartHelper.getValuesRange(this.data.values, enableGrid, this.data._customProperties.yAxisMaxValue, this.data.baseProperties.maxAllowedSeriesItems);
        // this.data.longValue = valuesRange.longValue;
        this.data.rangeTotal = valuesRange.rangeTotal;
        this.data.totalValue = valuesRange.totalValue;
        this.data.rangePositive = this.data.highvaluebreak ? this.data.rangePositive : valuesRange.rangePositive;
        this.data.rangeNegative = valuesRange.rangeNegative;
    }

    // this.data.data.setAttribute("showyaxisline", "true");
    this.data.data.setAttribute("showyaxisgrid", "true");
    this.data.data.setAttribute("yaxissteps", "true");
    this.data.data.setAttribute("overlapgrid", "true");
    if (this.data.chartName == "barRoundedFill") {
        this.data.data.setAttribute("showyaxisline", "false");
        // this.data.data.setAttribute("showxaxisline", "false");
        this.data._customProperties.showYAxisLine = false;
        this.data._customProperties.showXAxisLine = false;
    }
    this.data.data.setAttribute("enablegrid", "false");
};

BaseColumnSeriesItem.prototype.removeGrid = function () {
    this.data.data.setAttribute("enablegrid", "");
    // this.data.data.setAttribute("showyaxisline", "false");
    this.data.data.setAttribute("showyaxisgrid", "false");
    this.data.data.setAttribute("yaxissteps", "false");
    this.data.data.setAttribute("overlapgrid", "false");
    // this.data._customProperties.showYAxisLine = false;
    // this.data._customProperties.showXAxisLine = false;
};

BaseColumnSeriesItem.prototype.doAddTopPlaceholder = function (argparent, argprops, customSize = false) {
    const index = argprops.index;
    const type = String(argprops.placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    let bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    bounds.height = type != "image" ? 80 : bounds.height;
    if (customSize) {
        bounds.width = 70;
        bounds.height = 70;
    }
    let padding = this.setoverlapPadding("placeholder");
    let pLayoutName = this.placeholderlayoutClassName("placeholder");

    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.paddingLeft = padding["left"] + "px";
    baseelement.style.paddingRight = padding["right"] + "px";
    baseelement.style.paddingTop = padding["top"] + "px";
    baseelement.style.paddingBottom = padding["bottom"] + "px";
    baseelement.style.pointerEvents = "all";
    baseelement.style.position = "relative";
    // baseelement.className =this.data.layout.placholderGlopalStyle;
    baseelement.style.order = this.placeholderAlignment.index;
    if (this.data.layout.placeholderAlterPaddingClass && this.data.chartFlip) {
        baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
    } else {
        if (this.data.layout.placeholderPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderPaddingClass);
        }
    }
    if (argparent) argparent.appendChild(baseelement);

    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");

    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);
    if (this.data.layout.placeholderPaddingClass) {
        baseelement.classList.add(this.data.layout.placeholderPaddingClass);
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "primary-placeholder-" + this.groupindex;
    element.className = "primaryplaceholder topprimaryplaceholder " + pLayoutName;
    element.style.position = "relative";
    element.style.width = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.width + "px";
    element.style.height = bounds.height + "px";
    if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "outer") {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.className = pLayoutName + " contentContainer  moodanimation";
    } else {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.className = pLayoutName + " contentContainer  moodanimation";
    }
    baseelement.appendChild(element);
    if (this.placeholderAlignment.position == "inner") {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    }
    if (this.data.layout.placeholderAlterPaddingClass && this.data.chartFlip) {
        baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
    } else {
        if (this.data.layout.placeholderPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderPaddingClass);
        }
    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position != "middle") {
        // this.bgProperties(element)
    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && type == "image") {
        // this.bgProperties(element)
    }
    if (this.data.layout.boolplaceholderShape) {
        element.style.alignItems = "center";
        element.style.justifyContent = "center";
    }
    // if (this.graphicElement.alterpos == "true") {

    // }

    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            this.setBorderWidth(baseelement);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            this.setImageBorderWidth(baseelement);
            break;
        case "logo":
            this.doAddImageUseNodeElement(element, argprops, "logo");
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

BaseColumnSeriesItem.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    if ((this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") || this.placeholderAlignment.inset == "inset" || this.placeholderAlignment.inset == "true") {
        this.placeholderStyle = "clsAlterTertiaryColor";
    } else if (
        (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
        (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
    ) {
        this.placeholderStyle = "clsSecondaryFill";
    }
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon " + this.placeholderStyle,
        id: "placeholder-" + this.groupindex + "_" + this.index,
        width: "100%",
        height: "100%",
    });
    element.setAttribute("data-nodetype", "iconNode");
    if (this.data.layout.boolplaceholderShape) {
        this.data.SVGUtils.assignAttributes(element, {
            style: "width:60%;height:60%;",
        });
    }
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.groupindex + "_" + this.index,
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "xlink:href": "#" + this.data.primaryPlaceholderName[this.groupindex],
        "data-type": argprops.placeholdertype,
        "data-placeholderelement": "icon,image",
        "data-id": this.groupindex + "_" + this.index,
        "data-type": "ICON",
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    this.data.SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};

BaseColumnSeriesItem.prototype.doAddImageUseNodeElement = function (argparent, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    argparent.appendChild(nodeBgElement);

    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    if (this.data.layout.placeHolderShapeType == "circle") {
        subelement.style.borderRadius = "50%";
    }
    subelement.src = this.data.primaryPlaceholderPath[this.groupindex];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.groupindex + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.groupindex + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    subelement.setAttribute("data-nodetype", "imageNode");
    argparent.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(argparent, "SLIDE", true);
    argparent.setAttribute("data-x", item.x);
    argparent.setAttribute("data-y", item.y);
    argparent.setAttribute("data-width", argparent.clientWidth);
    argparent.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-width", argparent.clientWidth);
    subelement.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[this.groupindex]);

    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);

    this.ChartUtils.updateImageReSize(argparent.clientWidth, argparent.clientHeight, subelement, "", type);
    if (this.data.layout.placeholderoverlay == "true") {
        argparent.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, "var(--item" + (this.groupindex + 1) + "-color)");
    }
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    argparent.appendChild(overLayDiv);
};

BaseColumnSeriesItem.prototype.doAddTextUseNodeElement = function (argparent, argprops) {};

BaseColumnSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, centerAlign = false) {
    let _oHeight = 0;
    let _iHeight = 0;
    this.boolEnableInnerValue = false;
    let highlightDifferenceHeight = 0;
    let extraElementHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    if (this.groupindex == 0 && this.index == 0) {
        overlapStackedColumn = false;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") {
        this.doAddTopValue(element, argprops, true);
        if (this.data.secondaryLineValueMaxHeight > 0) {
            this.data.secondaryLineValueMaxHeight = this.intCircleRadius;
        } else {
            this.data.secondaryLineValueMaxHeight = 0;
        }
    }

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width);
        this.middleVH = parseInt(this.state.width);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        if (this.data.layout.boolvaluebgShape) {
            this.valuebgProperties(middleelementValue);
        }

        if (this.data.layout.valuebgBgColor == "theme") {
            this.valueStyle = this.ChartFonts.valueInnerColor;
        }
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }

    if (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
        this.middlePW = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        this.middlePH = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        if (this.data.layout.placholderHeight) {
            this.middlePH = this.data.layout.placholderHeight;
        }
        if (this.data.layout.placholderWidth) {
            this.middlePW = this.data.layout.placholderWidth;
        }
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.layout.boolplaceholderShape) {
            // this.bgProperties(middleelementPlaceholder)
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    parentHeight = this.state.height;
    // if(this.data.minValue<0){
    //  parentHeight =this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    //  parentHeight = parentHeight<this.state.height?this.state.height:parentHeight;
    // }
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = this.data._hdHight1;
        if (this.data.layout.valueInset == "inside") {
            highlightDifferenceHeight = this.data._hdHight2;
        }
    }
    if (this.data.indualHighlight) {
        highlightDifferenceHeight = this.data._hdHight1;
        if (this.data.layout.valueInset == "inside") {
            highlightDifferenceHeight = this.data._hdHight2;
        }
    }

    if (this.data.extraElementBounds?.height) {
        extraElementHeight = this.data.extraElementBounds?.height;
    }
    let baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.5) + dropShadowHeight + highlightDifferenceHeight + extraElementHeight);
    let valueHeight = argprops.minvalue < 0 ? 2 * this.maxValueH : this.maxValueH;
    if (this.data._secondaryLineChartValue) {
        valueHeight += this.data.secondaryLineValueMaxHeight;
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.inset != "bgoutside") {
        baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight + valueHeight + extraElementHeight);
    }

    if (this.data.showStatistical && this.statisticalAlignment.position == "outer" && this.statisticalAlignment.itemBased != "true") {
        this.createStatistacalContainer(element, true);
        baseGraphicHeight -= this.statisticalHeight;
    }

    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;

    let baseGraphicHeightPercentage = baseGraphicHeight;
    let dummeyValue = argprops.value;
    let differncePercentage = (this.data.rangePositive * 0.8) / this.data.secondPositiveHighValue;
    if (this.data.highvaluebreak && argprops.value != this.data.rangePositive) {
        dummeyValue = argprops.value * differncePercentage;
    }
    let graphicHeightPercentage = baseGraphicHeightPercentage * (dummeyValue / totalValue);

    let parentPercentage = baseGraphicHeightPercentage * (argprops.totalvalue / totalValue);

    let seriesItem = this.parent.querySelectorAll(".topseriesitem");
    let dummeyValueHeight = this.maxValueH;
    if (this.valueAlignment.inset == "bgoutside") {
        dummeyValueHeight = 0;
    }
    // for (let s1 = 0; s1 < seriesItem.length; s1++) {
    //     seriesItem[s1].style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage + this.maxValueH);
    // }
    let ParentHeightValue = parentPercentage + dummeyValueHeight + this.statisticalHeight + highlightDifferenceHeight + extraElementHeight;
    // if (this.maxValueH == 0) {
    //     ParentHeightValue = parentPercentage + dummeyValueHeight + highlightDifferenceHeight;
    // }
    // let seriesItemHeight =
    if (this.data.data.getAttribute("data-multiseries") && this.data.seriesItemLength > 1) {
        graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / this.data.seriesItemMaxValue[groupindex]);
    }

    // if(this.data.minValue==0){
    //     graphicHeightPercentage = baseGraphicHeightPercentage * ((parseFloat(argprops.value)+10) / (argprops.maxvalue+10));
    // }
    if (this.valueAlignment.position == "middle") {
        middleelementValue.setAttribute("data-graphic-y", graphicH);
        if (this.data.chartFlip) {
            middleelementValue.setAttribute("data-graphic-y", -graphicH);
        }
    }
    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        // let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = this.getBgColorDetails(groupindex, this.ChartFonts.emphasizeColor, this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        // let bgClsFillStyle = "";
        // if (this.data.layout.backgroundColor == "theme") {
        //     bgClsFillStyle = this.ChartFonts.graphicBgColor(groupindex);
        // } else {
        //     if (this.data.layout.backgroundColor == "transparent") {
        //         bgClsFillStyle = " transparent";
        //     } else {
        //         bgClsFillStyle = this.ChartFonts.emphasizeColor;
        //     }
        // }
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        // backgroundElement.style.opacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customorgin = this.customOrginValue;
        backgroundElement.style.height = this.data.SVGUtils.createPercentValue(ParentHeightValue, parentPercentage);
        if (this.data.chartName == "columnslider") {
            backgroundElement.style.width = 100 * this.thicknessPercentage + "%";
        }
        if (this.data.layout.backgroundColor == "gradient") {
            backgroundElement.style.backgroundImage = this.data.layout.backgroundGradientValues ? this.data.layout.backgroundGradientValues : "";
        }
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundOpacity != 0) {
            element.style.setProperty("--bg-opacity", this.data.layout.backgroundOpacity);
        }
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " cs-chart-main-graphic backgroundItem moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = backgroundElement.style.width;
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage);
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            if (this.data.layout.backgroundborderstyle == "dashed") {
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment + "dashed");
                backgroundBorderElement.style.setProperty("--border-style", "dashed", "");
            } else {
                backgroundBorderElement.style.setProperty("--border-style", "solid", "");
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
            }
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            backgroundBorderElement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");

            let BgBorderColor = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.data.layout.backgroundBorder.color, "bordercolor");
            backgroundBorderElement.classList.add(BgBorderColor);
            if (this.data.layout.backgroundBorder.color == "gradient") {
                backgroundBorderElement.classList.add("itemborderGrdient");
            }
            if (this.data.layout.backgroundBorderRadiusClass) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);

            // if (this.data.layout.backgroundBorder.color == "theme") {
            //     let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
            //     backgroundBorderElement.classList.add("accent" + (groupindex + 1) + "-border-color");
            //     if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //         this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
            //     }
            // }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    subelement.style.setProperty("--bg-opacity", "1");

    if (this.valueAlignment.itemBased == "true" || this.labelAlignment.itemBased == "true") {
        subelement.style.width = 100 + "%";
    }
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    // subelement.style.height = this.data.stackedChart ? "100%" : graphicHeightPercentage+"px";
    subelement.style.height = this.data.stackedChart ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue, graphicHeightPercentage);
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.data._stackedPercentage && this.data._boolPercentageChart) {
        graphicHeightPercentage = subelement.clientHeight;
    }
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    if (this.data.chartName == "columnslider") {
        subelement.style.borderRadius = "35px";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic graphicnode moodanimation " + this.transformOrginValue + " " + clsStyle;
    graphicElement.dataset.customorgin = this.customOrginValue;
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
    if (this.data.boolEnableWidthReducer) {
        graphicElement.style.width = "96%";
    }
    graphicElement.dataset.animation = "item";
    if (this.data.hasEmphasis || this.data.hasProjection || this.data._arrseriesItemHighValue[this.index] == "true") {
        graphicElement.classList.add("cs-chart-main-graphic");
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    if (this.data.stackedChart) {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    if (this.data.chartName == "columnslider") {
        graphicElement.style.borderRadius = "35px";
    }
    if (this.style.bgFillType == "gradient" || (this.style.bgFillType == "gradient" && this.data.hasEmphasis && this.data.emphasis[groupindex] == true)) {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    if (this.data.highvaluebreak && argprops.value >= this.data.rangePositive && this.data.seriesLength > 1) {
        let highvalueBreakElemnt = this.ChartHelper.createDivElement({});
        highvalueBreakElemnt.style.height = "10%";
        highvalueBreakElemnt.style.position = "absolute";
        highvalueBreakElemnt.style.width = "100%";
        graphicElement.style.position = "relative";
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.bottom = "13%";
        } else {
            highvalueBreakElemnt.style.top = "15%";
        }
        highvalueBreakElemnt.style.overflow = "hidden";
        graphicElement.parentNode.appendChild(highvalueBreakElemnt);
        let dividerHeight = highvalueBreakElemnt.clientHeight;
        let dividerWidth = highvalueBreakElemnt.clientWidth;

        let svgParent = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgParent, {
            width: "100%",
            height: "100%",
            style: "position: absolute; top: 0; left: 0;",
        });
        highvalueBreakElemnt.appendChild(svgParent);

        let Bounds = this.thicknesCalculation(dividerWidth, dividerHeight);
        let thickness = Bounds.thickness;
        let topY = Bounds.top;
        let bottomY = Bounds.bottom;
        let segmentWidth = Bounds.Width;
        let segmentCount = Bounds.count;

        // Create a continuous zigzag path starting from left edge to right edge
        let pathValue = "";

        // Start from left edge always at top
        pathValue += "M 0," + topY;

        // Create zigzag segments across the width - alternate between top and bottom
        for (let i = 0; i < segmentCount; i++) {
            let x = (i + 1) * segmentWidth;
            let y = i % 2 === 0 ? bottomY : topY; // First goes down, then up, then down, etc.

            // Ensure we don't exceed the width
            if (x >= dividerWidth) {
                x = dividerWidth;
            }

            pathValue += " L " + x + "," + y;
        }

        // Calculate final Y position after all segments
        // After segmentCount segments, if count is even, we're at topY, if odd, at bottomY
        let finalY = segmentCount % 2 === 0 ? topY : bottomY;

        // End at the right edge with the correct final Y position
        pathValue += " L " + dividerWidth + "," + finalY;

        let svgPath = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: pathValue,
            "stroke-width": thickness + "px",
            stroke: "var(--item" + (groupindex + 1) + "-color)",
            fill: "none",
            class: "dividerpath moodanimation",
            "data-animation": "highvaluebreak",
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
        });
        svgParent.appendChild(svgPath);
    }
    if (this.data.layout.enableBackground) {
        if (this.voData.layout.backgroundBorderRadiusValues) {
            let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            if (this.data.layout.backgroundBorderRadiusClass) {
                backgroundElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
            } else {
                backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            }
        }
    }
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (this.data.chartName != "columnSimpleRectangleFill") {
        ///DropShadow
        // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
        let colorStyle = this.data.layout.itemBoxShdowColor == "item" || this.data.layout.itemBoxShdowColor == "theme" ? clsStyle : this.data.layout.itemBoxShdowColor;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
        // graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    }
    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "columnborderelement";
        borderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);

        // graphicElement.classList.remove("accent" + (styleIndex + 1) + "-bg-color");
        // graphicElement.classList.add("background-bg-color");

        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        // if (this.voData.shapeBoderColor == "theme") {
        let strBordeStyleClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.voData.shapeBoderColor, "bordercolor");
        borderElement.classList.add(strBordeStyleClass);
        if (this.voData.shapeBoderColor == "gradient") {
            borderElement.classList.add("itemborderGrdient");
        }
        this.emphasisColor = " secondary-border-color";
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
            if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
                let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
                graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
            }
        }
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
            this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex, true);
        }

        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
            graphicElement.classList.remove("background-bg-color");
            graphicElement.classList.add(this.data.ChartFonts.appendgraphicBgColor(styleIndex));
        }
        borderElement.classList.add("moodanimation");
        borderElement.dataset.animation = "itemborder";
        borderElement.setAttribute("data-graphic-y", graphicElement.clientHeight);
        if (this.data.chartFlip) {
            borderElement.setAttribute("data-graphic-y", -graphicElement.clientHeight);
        }
        // }

        if (this.data.layout.itemborderstyle == "dashed") {
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign + "dashed");
            borderElement.style.setProperty("--border-style", "dashed", "");
        } else {
            borderElement.style.setProperty("--border-style", "solid", "");
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        }
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        if (graphicHeightPercentage < this.voData.shapeBoderSize) {
            borderElement.style.borderWidth = graphicHeightPercentage + "px";
            borderElement.style.setProperty("--border-width", graphicHeightPercentage + "px", "");
        }
    }

    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = graphicElement.clientHeight + "px 0% 0%";
    }

    if (borderElement) {
        borderElement.classList.remove("columnborderelement");
        borderElement.classList.add("columnborderelement");
    }
    if (this.data.grapicImage[groupindex] == "true" && this.data.chartName != "columnSimpleRectangleFill" && this.data.chartName != "column3DRectangle" && this.data.layout.itemFillType == "image") {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        // subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage basenodeposition";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
        graphicElement.style.position = "relative";
        let item = this.ChartUtils.getOffsetLeftTop(graphicElement, "SLIDE", true);
        graphicElement.setAttribute("data-x", item.x);
        graphicElement.setAttribute("data-y", item.y);
        graphicElement.setAttribute("data-width", graphicElement.clientWidth);
        graphicElement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-width", graphicElement.clientWidth);
        subImgelement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);
        subImgelement.setAttribute("data-x", item.x);
        subImgelement.setAttribute("data-y", item.y);
        // graphicElement.style.position = "absolute";
        graphicElement.style.overflow = "hidden";
        if (this.data.data.getAttribute("layout") == "outsidenumberbottom" || this.data.data.getAttribute("layout") == "outsidenumberinsidelabel" || this.data.data.getAttribute("layout") == "outsidenumber" || this.data.data.getAttribute("layout") == "labeloutsidetop") {
            subImgelement.style.position = "absolute";
            graphicElement.style.position = "relative";
        }
        if (groupindex == this.data.seriesLength - 1) {
            let PromptValues = [];
            let PromptIndexValues = [];
            for (let i1 = 0; i1 < this.data.graphicImagePrompt.length; i1++) {
                if (this.data.graphicImagePrompt[i1]) {
                    PromptIndexValues.push(i1);
                    PromptValues.push(this.data.graphicImagePrompt[i1]);
                    this.updateaisearchcount(this.data.slideID);
                }
            }
            let copyImageObject = {};
            copyImageObject["text"] = PromptValues;
            copyImageObject["type"] = "image";
            copyImageObject["imgtype"] = "nodes";
            let slideDetails = {
                slideid: this.data.slideID,
                groupindexValues: PromptIndexValues,
                xmlData: this.data.data,
                isTakeaway: this.data.data.getAttribute("isTakeaway") == "true",
            };
            // if (PromptValues.length > 0) this.imageSearchCompleteCallback({}, slideDetails);
            if (PromptValues.length > 0) AISearchUtils.searchIcon(this.data.indexstorefunction.appBaseURL, copyImageObject, this.imageSearchCompleteCallback.bind(this), slideDetails);
        }
        this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img", this.voData);
        if (this.data.hasEmphasis || this.data.hasProjection) {
            let bgColor = window.getComputedStyle(graphicElement)["background-color"];
            this.ChartUtils.applyOverlayToImage(subImgelement, bgColor);
        }
    }
    // if (this.index == 1) {
    //     graphicElement.classList.remove("chartgraphic");
    // }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        graphicH = Math.round(graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * this.itemBasedValueWidth + "px" : "100%";
        // if( this.valueAlignment.position == "inner"||this.labelAlignment.position == "inner"&&this.valueAlignment.samepos == "true"){
        sameElement.style.height = "100%";
        //}
        if (booloverLap) {
            this.overlap = booloverLap;
            sameElement.style.position = "relative";
            sameElement.style.justifyContent = this.data.chartFlip ? "flex-start" : "flex-end";
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.appendChild(subelement);
            overlapParentDiv.appendChild(sameElement);
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%;height:100%;",
            });
            overlapParentDiv.style.flexDirection = this.data.chartFlip ? "column" : "column-reverse";
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
        } else {
            subelement.appendChild(sameElement);
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.voData.shapeBorder ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.samepos != "true")) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            let pLayoutName = this.placeholderlayoutClassName("placeholder");
            if (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.samepos != "true") {
                let itembasedPlaceholderElement = this.ChartHelper.createDivElement({});
                itembasedPlaceholderElement.className = pLayoutName;
                itembasedPlaceholderElement.style.width = graphicElement.clientWidth + "px";
                itembasedPlaceholderElement.style.position = "relative";
                itembasedPlaceholderElement.style.display = "flex";
                itembasedPlaceholderElement.style.left = graphicElement.offsetLeft + "px";
                argparent.appendChild(itembasedPlaceholderElement);
                this.doAddTopPlaceholder(itembasedPlaceholderElement, argprops);
                if (itembasedPlaceholderElement.children.length > 0) {
                    itembasedPlaceholderElement.children[0].style.display = "flex";
                    itembasedPlaceholderElement.children[0].children[0].style.width = itembasedPlaceholderElement.children[0].children[0].clientHeight + "px";
                }
            } else {
                this.doAddTopPlaceholder(argparent, argprops);
            }
        }
    }
    if (this.data.showStatistical) {
        graphicH = graphicHeightPercentage;
        this.createStatistacalContainer(element, true);
        this.statisticalStyle = this.getColorDetails(this.groupindex, this.ChartFonts.valueOuterColor, this.data.layout.statisticalColor, "color");
        if (this.statisticalAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            let vLayoutName = this.statisticallayoutClassName("containerlabel");
            let statistacalLayoutName = this.statisticallayoutClassName("containervalue");
            let statistacalValueElement = this.ChartHelper.createDivElement({});
            statistacalValueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            statistacalValueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) statistacalValueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            if (this.statisticalAlignment.vposition == "bottom") {
                statistacalValueElement.style.setProperty("align-items", "flex-start", "important");
            }
            statistacalValueElement.className = "itembasedlabelelement " + containerAlignment + " " + statistacalLayoutName;
            statistacalValueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.statisticalAlignment.position == "inner") {
                statistacalValueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent && (this.statisticalAlignment.vposition == this.valueAlignment.vposition || this.statisticalAlignment.vposition == this.labelAlignment.vposition)) {
                statistacalValueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    statistacalValueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                if (this.valueAlignment.itemBased == "true") {
                    statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                }
                statistacalValueElement.style.height = "100%";
                layoutParent.appendChild(statistacalValueElement);
                // this.createStatistacalContainer(element,true);
            } else if (this.statisticalAlignment.vposition == this.labelAlignment.vposition) {
                labelStaticalParent = this.ChartHelper.createDivElement({});
                labelStaticalParent.classList.add("layoutParentNode");
                labelStaticalParent.classList.add("labelstatistical");
                if (this.voData.layout.statisticalVPosition == "top") {
                    element.insertBefore(labelStaticalParent, subelement);
                } else {
                    element.appendChild(labelStaticalParent);
                }
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                labelStaticalParent.appendChild(statistacalValueElement);
            } else if (valueStaticalParent) {
                valueStaticalParent.style.width = "100%";
                statistacalValueElement.style.height = "100%";
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                valueStaticalParent.appendChild(statistacalValueElement);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.statisticalAlignment.itemBased == "true") {
                    element.insertBefore(statistacalValueElement, subelement);
                } else {
                    element.appendChild(statistacalValueElement);
                }
            }
            if (this.statisticalAlignment.itemBased == "true" && this.statisticalAlignment.vposition == "top" && statistacalValueElement && backgroundElement) {
                backgroundElement.style.top = statistacalValueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? statistacalValueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : statistacalValueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                statistacalValueElement.style.marginLeft = this.middlePW / 2 + "px";
            } // this.valueMaxH = valueElement.clientHeight;
            this.createStatistacalContainer(statistacalValueElement);
            if (this.labelAlignment.itemBased != "true") {
                statistacalValueElement.style.maxHeight = elementHeight * 100 + "%";
                statistacalValueElement.style.height = "auto";
                if (statistacalValueElement.children[0]) {
                    statistacalValueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.statisticalAlignment.position == "outer" && this.statisticalAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.statisticalWidth) {
            // this.valueStyle = this.getColorDetails(multiValueSeriesIndex, this.valueStyle, this.data.layout.statisticalColor, "color");
            if (this.data.layout.statisticalInset == "bgoutside") {
                this.statisticalAlignment.position == "inner" ? this.createStatistacalContainer(element) : this.createStatistacalContainer(argparent);
                if (this.data.layout.statisticalInset == "bgoutside") {
                    argparent.style.display = "flex";
                    if (this.labelAlignment.itemBased != "true") {
                        argparent.style.alignItems = "center";
                    }
                }
            } else {
                graphicW = Math.round(subelement.clientWidth);
                if (this.labelAlignment.itemBased == "true" || this.alignment.itemBased == "true") {
                    this.createStatistacalContainer(subelement);
                } else this.createStatistacalContainer(element, false);
            }
        } else if ((this.statisticalAlignment.position == "inner" && this.statisticalAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            let vLayoutName = this.statisticallayoutClassName("containervalue");
            const statisticalElement = this.ChartHelper.createDivElement({});
            statisticalElement.id = "statisticalElement-" + groupindex + "_" + index;
            statisticalElement.className = "statisticalElement " + vLayoutName;
            statisticalElement.style.width = "100%";
            subelement.appendChild(statisticalElement);
            this.statisticalStyle = this.ChartFonts.valueInnerColor;
            if (this.data.layout.itemColor != "bgcolor") this.statisticalArrowStyle = this.ChartFonts.valueInnerColor;
            if (this.data.chartName.includes("comparisonModel") && index == 1) {
                vLayoutName = this.statisticallayoutClassName("containervalue", true);
                statisticalElement.className = "statisticalElement " + vLayoutName;
            }
            this.createStatistacalContainer(statisticalElement);
        }
    }
    if (this.displayLabel(argprops)) {
        graphicH = graphicHeightPercentage;
        if (this.labelAlignment.itemBased != "true") this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.labelMaxW = subelement.clientWidth;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";

            if (graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(labelElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%;height:auto;min-height:40px;",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = 100 * this.thicknessPercentage + "%";
                this.thicknessPercentage = 1;
                graphicElement.style.width = 100 + "%";
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            // this.labeMaxH = subelement.clientHeight * 0.8;
            this.labelMaxW = labelElement.clientWidth;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            if (this.valueAlignment.itemBased == "true" && graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH) && this.labelAlignment.position == "inner") {
                let overlapParentDiv1 = this.ChartHelper.createDivElement({});
                graphicElement.parentNode.appendChild(overlapParentDiv1);
                this.data.SVGUtils.assignAttributes(overlapParentDiv1, {
                    style: "display:flex;align-items: flex-end;width:100%;height:100%;",
                });
                overlapParentDiv1.appendChild(graphicElement);
                this.doAddLabel(overlapParentDiv1, argprops);
            } else {
                this.doAddLabel(element, argprops);
            }
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }
    if (this.data.layout.secondaryElement && this.alignment.itemBased == "true") {
        this.doAddSecondaryLabel(element, argprops, true);
        if (this.alignment.itemBased == "true" && this.alignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.secondarylayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.alignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            if (this.data.layout.secondaryElementType != "image") {
                this.doAddSecondaryLabel(labelElement, argprops);
            } else {
                this.doSecondaryImage(labelElement, argprops);
            }
        }
    }

    if (this.displayValue(argprops)) {
        graphicH = Math.round(graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true);
        this.boolEnableInnerValue = false; //(((this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && ((element.clientHeight - subelement.clientHeight) < this.maxValueH)))
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            this.valueOuter = true;
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.style.height = subelement.clientHeight + "px";
                subelement.parentNode.appendChild(overlapParentDiv);
                label[0].children[0].classList.remove("clsAlterSecondaryColor");
                label[0].children[0].classList.remove("clsContrastColor");
                label[0].children[0].classList.add("clsContrastColor");
                subelement.parentNode.appendChild(label[0]);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(valueElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%;height:auto;",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%";
                graphicElement.style.width = "100%";
                if (borderElement) borderElement.style.width = "100%";
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && !this.boolEnableInnerValue && this.valueAlignment.itemBased != "true" && this.valueAlignment.inset != "bgoutside") {
            this.valueStyle = "";
            graphicH = Math.round(subelement.clientHeight) - this.maxValueH < 0 ? Math.round(subelement.clientHeight) : Math.round(subelement.clientHeight) - this.maxValueH;
            this.valueOuter = true;
            if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) {
                this.overlap = true;
            }
            this.stackedChartOverlap = this.data.stackedChart && subelement.clientHeight <= this.maxValueH;
            if (this.data.layout.enableBackground) {
                this.doAddTopValue(element, argprops);
            } else if (this.data.stackedChart) {
                stackedGraphicH = subelement.clientHeight;
                if (this.data.chartName == "stackedAreaChart") {
                    this.doAddTopValue(element, argprops);
                }
            } else {
                if (this.labelAlignment.itemBased == "true") {
                    if (this.groupindex == 0) {
                        element.style.alignItems = "flex-end";
                    } else {
                        element.style.alignItems = "flex-start";
                    }
                }
                this.doAddTopValue(element, argprops);
            }
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.maxValueH) || this.boolEnableInnerValue) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            this.innerValuePlace = true;
            this.valueMaxW = valueElement.clientWidth * 0.8;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || this.valueAlignment.inset == "bgoutside" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
            this.valueStyle = this.ChartFonts.valueOuterColor;
            element.style.order = 1;
            if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH) {
                this.overlap = subelement.clientHeight < this.maxValueH;
                this.doAddTopValue(element, argprops);
            } else {
                if (this.valueAlignment.inset == "bgoutside") {
                    argparent.style.flexDirection = "column";
                    argparent.style.alignItems = "center";
                }
                this.doAddTopValue(argparent, argprops);
            }
        }
    }
    bkelement = element;
    bkSubElement = subelement;
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        if (this.data.layout.borderRadiusClass) {
            graphicElement.classList.add(this.data.layout.borderRadiusClass);
            if (borderElement) borderElement.classList.add(this.data.layout.borderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            if (borderElement) borderElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    let multiSeries = this.data.data.getAttribute("data-multiseries") ? true : false;
    if ((this.data.comparisonStyle == "style2" && this.data.seriesItemLength < 2 && this.data.rangeNegative >= 0) || (this.data.comparisonStyle == "style2" && multiSeries)) {
        differnceIndex = multiSeries ? index : groupindex;
        let boolEnablecomparestyle = "";
        if (multiSeries) {
            boolEnablecomparestyle = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index + 1]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index - 1]);
        } else {
            boolEnablecomparestyle = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex + 1][index]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex - 1][index]);
        }

        if (boolEnablecomparestyle) {
            let differentValue1;
            if (multiSeries) {
                differentValue1 = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            } else {
                differentValue1 = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            }
            let differentValue = ((differentValue1 / this.data.rangePositive) * 100).toFixed(0) + "%";
            let eprops = {
                differentValue: differnceIndex == 0 ? differentValue : differentValue,
            };
            //this.createCompareStyle(element, eprops, graphicElement)
        }
    }
    if (this.data.chartName == "columnSimpleRectangleFill") {
        this.createRect(graphicElement, argparent);
    }
    if (this.data.layout.itemFillType == "pattern") {
        this.createPatternSvg(graphicElement);
        if (borderElement) borderElement.style.zIndex = "3";
    }
    if (this.data.layout.backgroundFillType == "pattern") {
        this.createPatternSvg(backgroundElement);
        subelement.parentNode.appendChild(subelement);
    }
    if (backgroundElement && this.data.layout.itemalterpos == "true") {
        backgroundElement.style.width = graphicElement.clientWidth + "px";
        backgroundElement.style.left = graphicElement.offsetLeft + "px";
        if (backgroundBorderElement) backgroundBorderElement.style.left = this.data.layout.backgroundBorder.width ? graphicElement.offsetLeft - this.data.layout.backgroundBorder.width + "px" : graphicElement.offsetLeft + "px";
    }
    if (backgroundElement) {
        if (this.data.layout.data.background.opacity || this.data.layout.backgroundOpacity) {
            let Class = this.getBgClassList(backgroundElement);
            let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
            backgroundElement.style.setProperty("background-color", rgbavalue, "important");
        }
    }
    if (backgroundElement) {
        backgroundElement.style.width = graphicElement.clientWidth + "px";
        if (backgroundBorderElement) {
            backgroundBorderElement.style.width = graphicElement.clientWidth + "px";
        }
    }
    if (middleelementPlaceholder && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true")) {
        middleelementPlaceholder.style.position = "absolute";
        if (this.placeholderAlignment.hposition == "left") {
            middleelementPlaceholder.style.left = graphicElement.parentNode.offsetLeft + graphicElement.offsetLeft;
            middleelementPlaceholder.style.margin = "unset";
        }
        if (this.placeholderAlignment.hposition == "center") {
            middleelementPlaceholder.style.left = graphicElement.offsetLeft + (graphicElement.clientWidth - middleelementPlaceholder.clientWidth) / 2;
        }
        if (this.placeholderAlignment.hposition == "right") {
            middleelementPlaceholder.style.left = graphicElement.offsetLeft + graphicElement.clientWidth - middleelementPlaceholder.clientWidth + "px";
        }
    }
    if (this.data.grapicImage[groupindex] == "true" && this.data.chartName != "columnSimpleRectangleFill" && this.data.chartName != "column3DRectangle" && this.data.layout.itemFillType == "image") {
        let element = argparent.querySelector(".itembasedlabelelement");
        if (this.data.layout.itemalterpos == "true" && element) {
            element.style.position = "absolute";
            if (groupindex == 0) {
                element.style.right = graphicElement.clientWidth + "px";
            }
            if (groupindex == 1) {
                element.style.left = graphicElement.clientWidth + "px";
            }
        }
    }
    ///DropShadow
    if (this.data.layout.itemShadow) {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
    if (this.data.chartName == "stackedAreaChart") {
        graphicElement.removeAttribute("data-animation");
        graphicElement.setAttribute("class", "chartgraphic graphicnode moodanimation transformOrginBottom");
        graphicElement.style.setProperty("background-color", "unset", "important");
    }
};
BaseColumnSeriesItem.prototype.thicknesCalculation = function (columnWidth, dividerHeight) {
    if (this.data.layout.itemgap) {
        // Stroke width should be proportional to the divider height
        let thickness = Math.max(4, Math.min(8, dividerHeight * 0.05));

        // Amplitude: how much the zigzag deviates from center (should be significant)
        let amplitude = dividerHeight * 0.35; // 35% of height for good visibility

        // Set starting points at the edges to create a continuous line
        let startY = dividerHeight * 0.05; // Start slightly from top edge
        let endY = dividerHeight * 0.95; // End slightly from bottom edge

        // Calculate segment width to ensure we have at least 8-12 segments for a good zigzag
        let optimalSegmentCount = Math.max(8, Math.min(15, Math.floor(columnWidth / 15)));
        let individualWidth = columnWidth / optimalSegmentCount;

        // Adjust amplitude to be proportional to segment width for better visual flow
        let adjustedAmplitude = Math.min(amplitude, individualWidth * 0.5);

        let count = optimalSegmentCount;

        // Adjust top and bottom positions to create the zigzag effect
        let centerY = dividerHeight / 2;
        let topY = centerY - adjustedAmplitude;
        let bottomY = centerY + adjustedAmplitude;

        return {
            thickness: thickness,
            top: topY,
            bottom: bottomY,
            Width: individualWidth,
            count: count,
            startY: startY,
            endY: endY,
        };
    } else {
        return { thickness: 0, top: 0, bottom: 0, Width: 0, count: -1 };
    }
};
BaseColumnSeriesItem.prototype.createRect = function (parentNode, argparent) {
    parentNode.className = "chartgraphic  graphicnode";
    parentNode.dataset.animation = 0;
    parentNode.style.display = "flex";
    parentNode.style.flexDirection = "column-reverse";
    parentNode.style.justifyContent = "flex-start";
    let rectHeight = 8;
    let rectPadding = 3;
    let parentHeight = parentNode.clientHeight;
    let rectCount = Math.round(parentHeight / (rectHeight + rectPadding));

    for (let i1 = 0; i1 < rectCount; i1++) {
        let strStyleClass = this.getBgColorDetails(this.groupindex, this.ChartFonts.graphicBgColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(this.groupindex);
        let rectElement = this.ChartHelper.createDivElement({});
        rectElement.className = strStyleClass + " moodanimation";
        rectElement.dataset.animation = "item" + (this.groupindex + 1);
        rectElement.style.height = rectHeight + "px";
        rectElement.style.margin = rectPadding + "px 0px 0px 0px";
        parentNode.appendChild(rectElement);

        if (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && !this.data.shapeBorder) {
            this.setNoEmphasis(rectElement, "", this.groupindex);
        }
        if (this.data.hasEmphasis && this.data.emphasis[this.groupindex] == true) {
            this.setHasEmphasis(rectElement, strStyleClass, this.groupindex);
        }
        if (this.data.projection[this.groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-grey" || this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert") && !this.data.shapeBorder) {
            rectElement.classList.add("clsNodeSecondarybg");
            rectElement.style.boxShadow = "";
        }
        // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
        //     rectElement.classList.add("prjectionOpacity")
        //     rectElement.dataset.customopacity = "0.5",
        //     rectElement.dataset.hidecustomopacity = "true"
        // }
    }
};
BaseColumnSeriesItem.prototype.createCompareStyle = function (element, eprops, graphicElement) {
    let layoutContainer = this.ChartHelper.createDivElement({});
    layoutContainer.className = "comparestyle2";
    layoutContainer.style.height = element.parentNode.clientHeight - graphicElement.clientHeight - this.maxValueH + "px";
    element.appendChild(layoutContainer);
    let valueContainer = this.ChartHelper.createDivElement({});
    valueContainer.className = "comparestyle2value" + this.ChartFonts.graphicColor(this.groupindex);
    valueContainer.style.width = layoutContainer.clientWidth * 0.4 + "px";
    valueContainer.style.height = layoutContainer.clientHeight * 0.3 + "px";
    valueContainer.innerText = eprops.differentValue;
    let ShapeContainer = this.createCompareStyleShape(layoutContainer);
    layoutContainer.appendChild(valueContainer);
};
BaseColumnSeriesItem.prototype.createCompareStyleShape = function (layoutContainer) {
    let containerHeight = layoutContainer.clientHeight;
    let ContainerWidth = layoutContainer.clientWidth;
    if (this.data.comparisonStyle == "style2") {
        let basesvg = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(basesvg, {
            height: "100%",
            width: "100%",
            style: "position:absolute;",
        });
        layoutContainer.appendChild(basesvg);
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        basesvg.appendChild(defsTag);
        let markerTag = this.data.SVGUtils.createSVGElement("marker");
        defsTag.appendChild(markerTag);
        this.data.SVGUtils.assignAttributes(markerTag, {
            id: "arrow",
            refX: "15",
            refY: "7",
            class: this.ChartFonts.secondaryFill(),
            markerWidth: "14",
            markerHeight: "14",
            orient: "auto-start-reverse",
        });
        let Markerpath = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(Markerpath, {
            d: "M 0 0 L 15 7 L 0 14 z",
            class: "emphasis",
        });
        markerTag.appendChild(Markerpath);
        let polyLine = this.data.SVGUtils.createSVGElement("polyline");
        this.data.SVGUtils.assignAttributes(polyLine, {
            fill: "none",
            class: this.ChartFonts.secondaryStroke() + " emphasis",
            points: ContainerWidth / 2 + "," + 0 + " " + ContainerWidth / 2 + "," + containerHeight,
            "marker-start": "url(#arrow)",
        });
        if (differnceIndex == 1) {
            this.data.SVGUtils.assignAttributes(polyLine, {
                "marker-start": "",
                "marker-end": "url(#arrow)",
            });
        }
        basesvg.appendChild(polyLine);
    }
};
BaseColumnSeriesItem.prototype.setNoEmphasis = function (graphicElement, strStyleClass, groupindex) {
    if ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder) {
        let borderColor = " secondary-border-color";
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + borderColor;
        graphicElement.classList.add("shapeborderall");
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return strStyleClass;
    } else if (this.data._emphasisName == "patternemphasize") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return strStyleClass;
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + this.emphasisColor;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return this.emphasisColor;
    }
};

BaseColumnSeriesItem.prototype.setHasEmphasis = function (graphicElement, strStyleClass, groupindex, borderelement = false) {
    if (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") {
        if (this.data._emphasisName == "emphasize-basic-pattern" && !borderelement) {
            graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.transformOrginValue + " emppattern" + (groupindex + 1);
            graphicElement.dataset.customorgin = this.customOrginValue;
        }
    } else if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "patternemphasize") {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode emphasismoodanimation " + this.transformOrginValue + " " + strStyleClass + " chartborder emppattern" + (groupindex + 1);
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
    }
    return strStyleClass;
};

BaseColumnSeriesItem.prototype.middleElementvalidation = function (element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel, eprops = null) {
    if ((this.valueAlignment && this.valueAlignment.position == "middle") || (this.placeholderAlignment && this.placeholderAlignment.position == "middle") || (this.labelAlignment && this.labelAlignment.position == "middle")) {
        if (
            (this.valueAlignment.vposition == "bottom" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.vposition == "bottom" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "bottom" && this.valueAlignment.position == "middle") {
                subelement.style.marginBottom = parseInt(this.middleVH * 0.5) + "px";
                //  if (subelement.clientHeight < parseInt(this.middleVH * 0.5)) middleelementValue.style.marginTop = -parseInt(this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
                subelement.style.marginBottom = parseInt(this.middlePH * 0.5) + "px";
                //  if (subelement.clientHeight < parseInt(this.middlePH * 0.5)) middleelementPlaceholder.style.marginTop = -parseInt(this.middlePH * 0.5) + "px";
            } else if (this.labelAlignment.vposition == "bottom" && this.labelAlignment.position == "middle") {
                subelement.style.marginBottom = parseInt(this.middleLH * 0.5) + "px";
                // if (subelement.clientHeight < parseInt(this.middleLH * 0.5)) middleelementLabel.style.marginTop = -parseInt(this.middleLH * 0.5) + "px";
            }
        }
        if (
            (this.valueAlignment.vposition == "top" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.vposition == "top" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.vposition == "top" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "top" && this.valueAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.6)) middleelementValue.style.marginBottom = parseInt(subelement.clientHeight - this.middleVH * 0.6) + "px";
            else if (this.placeholderAlignment.vposition == "top" && this.placeholderAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middlePH * 0.6) && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")))
                middleelementPlaceholder.style.marginTop = -parseInt(subelement.clientHeight - this.middlePH * 0.6) + "px";
            else if (this.labelAlignment.vposition == "top" && this.labelAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleLH * 0.6)) middleelementLabel.style.marginTop = -parseInt(subelement.clientHeight - this.middleLH * 0.6) + "px";
        }
        if (
            (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true") ||
            (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")
        ) {
            element.style.alignItems = "flex-end";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") middleelementValue.style.marginLeft = -parseInt(subelement.clientWidth - this.middleVW * 0.5) + "px";
            else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true")
                middleelementPlaceholder.style.marginLeft = -parseInt(subelement.clientWidth - this.middlePW * 0.5) + "px";
            else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") middleelementLabel.style.marginLeft = -parseInt(subelement.clientWidth - this.middleLW * 0.5) + "px";
        }
        if (
            (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")
        ) {
            element.style.alignItems = "flex-start";
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                if (eprops && eprops.value < 0) {
                    element.style.alignItems = "flex-end";
                }
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVW * 0.5) + "px";
            } else if (
                this.placeholderAlignment.hposition == "right" &&
                this.placeholderAlignment.position == "middle" &&
                (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) &&
                this.data.data.getAttribute("primaryplaceholder") &&
                this.labelAlignment.itemBased != "true" &&
                this.valueAlignment.itemBased != "true"
            )
                middleelementPlaceholder.style.marginLeft = parseInt(subelement.clientWidth - this.middlePW * 0.5) + "px";
            else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLW * 0.5) + "px";
        }
        if (
            (this.valueAlignment.vposition == "middle" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "middle" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.hposition == "middle" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "middle" && this.valueAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.6)) middleelementValue.style.marginTop = -parseInt(subelement.clientHeight * 0.6 - this.middleVH * 0.6) + "px";
            else if (this.placeholderAlignment.hposition == "middle" && this.placeholderAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middlePH * 0.5) && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")))
                middleelementPlaceholder.style.marginTop = -parseInt(subelement.clientHeight * 0.6 - this.middlePH * 0.5) + "px";
            else if (this.labelAlignment.hposition == "middle" && this.labelAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleLH * 0.6)) middleelementLabel.style.marginTop = -parseInt(subelement.clientHeight * 0.6 - this.middleLH * 0.6) + "px";
        }
    }
};

BaseColumnSeriesItem.prototype.middleElementvalidationBottom = function (element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel) {
    if (this.valueAlignment.position == "middle" || (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) || this.labelAlignment.position == "middle") {
        if (
            (this.valueAlignment.vposition == "top" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.vposition == "top" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.vposition == "top" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "top" && this.valueAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.5)) {
                subelement.style.marginBottom = parseInt(this.middleVH * 0.5) + "px";
                //  if (subelement.clientHeight < parseInt(this.middleVH * 0.5)) middleelementValue.style.marginTop = -parseInt(this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.vposition == "top" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && subelement.clientHeight > parseInt(this.middleVH * 0.5)) {
                subelement.style.marginBottom = parseInt(this.middlePH * 0.5) + "px";
                //  if (subelement.clientHeight < parseInt(this.middlePH * 0.5)) middleelementPlaceholder.style.marginTop = -parseInt(this.middlePH * 0.5) + "px";
            } else if (this.labelAlignment.vposition == "top" && this.labelAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.5)) {
                subelement.style.marginBottom = parseInt(this.middleLH * 0.5) + "px";
                // if (subelement.clientHeight < parseInt(this.middleLH * 0.5)) middleelementLabel.style.marginTop = -parseInt(this.middleLH * 0.5) + "px";
            }
        }
        if (
            (this.valueAlignment.vposition == "bottom" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.vposition == "bottom" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "bottom" && this.valueAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.5)) middleelementValue.style.marginTop = -parseInt(this.middleVH * 0.5) + "px";
            else if (this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && subelement.clientHeight > parseInt(this.middlePH * 0.5))
                middleelementPlaceholder.style.marginTop = -parseInt(this.middlePH * 0.5) + "px";
            else if (this.labelAlignment.vposition == "bottom" && this.labelAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleLH * 0.5)) middleelementLabel.style.marginTop = -parseInt(this.middleLH * 0.5) + "px";
        }
        if (
            (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") middleelementValue.style.marginLeft = -parseInt(subelement.clientWidth - this.middleVW * 0.5) + "px";
            else if (
                this.placeholderAlignment.hposition == "right" &&
                this.placeholderAlignment.position == "middle" &&
                (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) &&
                this.data.data.getAttribute("primaryplaceholder") &&
                this.labelAlignment.itemBased != "true" &&
                this.valueAlignment.itemBased != "true"
            )
                middleelementPlaceholder.style.marginLeft = -parseInt(subelement.clientWidth - this.middlePW * 0.5) + "px";
            else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") middleelementLabel.style.marginLeft = -parseInt(subelement.clientWidth - this.middleLW * 0.5) + "px";
        }
        if (
            (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")
        ) {
            element.style.alignItems = "flex-end";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") middleelementValue.style.marginLeft = -parseInt(subelement.clientWidth - this.middleVW * 0.5) + "px";
            else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true")
                middleelementPlaceholder.style.marginLeft = -parseInt(subelement.clientWidth - this.middlePW * 0.5) + "px";
            else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") middleelementLabel.style.marginLeft = -parseInt(subelement.clientWidth - this.middleLW * 0.5) + "px";
        }
        if (
            (this.valueAlignment.vposition == "middle" && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment.hposition == "middle" && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ||
            (this.labelAlignment.hposition == "middle" && this.labelAlignment.position == "middle")
        ) {
            if (this.valueAlignment.vposition == "middle" && this.valueAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleVH * 0.5)) middleelementValue.style.marginTop = -parseInt(subelement.clientHeight * 0.5 - this.middleVH * 0.5) + "px";
            else if (this.placeholderAlignment.hposition == "middle" && this.placeholderAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middlePH * 0.5) && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")))
                middleelementPlaceholder.style.marginTop = -parseInt(subelement.clientHeight * 0.5 - this.middlePH * 0.5) + "px";
            else if (this.labelAlignment.hposition == "middle" && this.labelAlignment.position == "middle" && subelement.clientHeight > parseInt(this.middleLH * 0.5)) middleelementLabel.style.marginTop = -parseInt(subelement.clientHeight * 0.5 - this.middleLH * 0.5) + "px";
        }
    }
};

BaseColumnSeriesItem.prototype.middleElementoverlapvalidation = function (name) {
    if (name == "label") {
        if (this.labelAlignment.position == "middle") {
            this.labelAlignment.overlap = "label";
            this.labelAlignment.vposition = "bottom";
        } else if (this.valueAlignment.position == "middle") {
            this.labelAlignment.overlap = "value";
            this.valueAlignment.vposition = "bottom";
        } else if (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
            this.labelAlignment.overlap = "placeholder";
            this.placeholderAlignment.vposition = "bottom";
        }
    }
};

BaseColumnSeriesItem.prototype.createSVGElement = function (middleelement, argprops, name, boolBottom = false, boolPercentage = false) {
    if (this.valueAlignment.position == "middle" && name == "value") {
        this.valueMaxW = this.middleVW;
        this.valueMaxH = this.middleVH;
        if (boolBottom) this.doAddBottomValue(middleelement, argprops);
        else this.doAddTopValue(middleelement, argprops, false, false, boolPercentage);
    }
    if (this.placeholderAlignment.position == "middle" && name == "placeholder" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
        this.placeholderStyle = this.ChartFonts.graphicFillColor(argprops.gindex);
        if (boolBottom) this.doAddBottomPlaceholder(middleelement, argprops);
        else this.doAddTopPlaceholder(middleelement, argprops);
    }
    if (this.labelAlignment.position == "middle" && name == "label") {
        this.labelMaxW = this.middleLW;
        this.labeMaxH = this.middleLH;
        this.doAddLabel(middleelement, argprops);
    }
};

BaseColumnSeriesItem.prototype.labellayoutClassName = function (itemname, boolBottom = false) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        if (boolBottom) {
            if (this.labelAlignment.vposition == "bottom") lLayoutName = lLayoutName + this.labelAlignment.hposition + "top";
            else if (this.labelAlignment.vposition == "top") lLayoutName = lLayoutName + this.labelAlignment.hposition + "bottom";
            else lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
        } else {
            lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
        }
    }
    return lLayoutName;
};

BaseColumnSeriesItem.prototype.placeholderlayoutClassName = function (itemname, boolBottom = false) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.placeholderAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        if (boolBottom) {
            if (this.placeholderAlignment.vposition == "bottom") lLayoutName = lLayoutName + this.placeholderAlignment.hposition + "top";
            else if (this.placeholderAlignment.vposition == "top") lLayoutName = lLayoutName + this.placeholderAlignment.hposition + "bottom";
            else lLayoutName = lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
        } else {
            lLayoutName = lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
        }
    }
    return lLayoutName;
};

BaseColumnSeriesItem.prototype.valuelayoutClassName = function (itemname, boolBottom = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    }
    return vLayoutName;
};

BaseColumnSeriesItem.prototype.doAddBottomValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    // if (this.data.layout.valueColor == "theme" && this.valueStyle == this.ChartFonts.valueOuterColor) {
    //     this.valueStyle = "accent1-color";
    // }

    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value", true);
    const element = this.ChartHelper.createDivElement({});
    element.id = "bottomvalue-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    if (this.data.layout.itemBased != "true") element.style.width = this.valueMaxW + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.boolnegative = "true";
    element.style.order = this.valueAlignment.index;
    element.className = "value bottomvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["bottom"] + "px";
    element.style.paddingBottom = padding["top"] + "px";
    if (this.data.layout.valueAlterPaddingClass) {
        element.classList.add(this.data.layout.valueAlterPaddingClass);
    }
    if (this.data.chartFlip) {
        if (this.data.layout.valuePaddingClass) {
            element.classList.add(this.data.layout.valuePaddingClass);
        }
    }
    if (this.data._projectionName == "projection-alpha" || (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (!this.data.hasEmphasis && !this.data.hasProjection) || (!this.data.hasEmphasis && this.data.hasProjection && this.data.projection[groupindex] != true)) {
        if (!this.overlap) this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    }

    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.ChartFonts.valueThemeClassName;
    !this.data.promptText ? subelement.setAttribute("data-animateItem", "secondarytext" + index) : subelement.setAttribute("data-animateItem", "prompttext" + index);
    let hasDoubleNode = this.data.chartName == "columnSimpleRectangle" && this.data.layout.labelItemBased == "true" ? true : false;
    if (this.data.layout.valueColor && !hasDoubleNode) {
        subelement.classList.remove("clsValueTextColor");

        subelement.classList.remove("cs-inner-text-color");
        if (!this.overlap) subelement.classList.add("cs-inner-text-color");
    }

    subelement.innerText = boolmax ? this.data.longLengthValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.boolnegative = "true";
    element.style.boolnegative = "true";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    if (this.data.highlights[groupindex] && this.data.lineHighlightPoint && this.data.lineHighlightStyle[groupindex] == "true") {
        subelement.style.visibility = "visible";
    }
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (boolenablePer && this.data.displayValueFormat != "number") {
        subelement.innerText = boolmax ? parseFloat(this.data.longLengthValue) + "%" : parseFloat(argprops.valuetext) + "%";
    }
    if (this.data.hasEmphasis || this.data.hasProjection) {
        subelement.classList.add("cs-value-text");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    //subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-type", "value");
    if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison") {
        subelement.setAttribute("data-specialtype", "value");
    }
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", -graphicH);
    if (this.data.chartFlip) {
        subelement.setAttribute("data-graphic-y", graphicH);
    }
    subelement.dataset.animation = !this.data.promptText ? "secondarytext" : "prompttext";
    element.appendChild(subelement);
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    if (this.data.values[groupindex][index] == this.data._rangeNegative) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["bottom"] + 15 + "px";
                element.style.paddingBottom = padding["top"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["bottom"] + 15 + "px";
                element.style.paddingBottom = padding["top"] + 15 + "px";
            }
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                this.valueAlignment.vposition = "bottom";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        if ((this.data.presentMode || this.data.seriesanimation || this.data.disableEdit) && !this.data.promptText) {
            subelement.setAttribute("contenteditable", "false");
        } else {
            subelement.setAttribute("data-dck-selector", "true");
        }
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName != "simpleIconFillRepeatChart") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add("clsAccentColor");
    }
    if ((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.hasProjection && this.data.projection[groupindex] == true && ((this.data._projectionName == "projection-grey" && this.data.shapeBorder) || this.data._projectionName == "projection-basic-border-grey"))) {
        if (this.data.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
        } else {
            subelement.classList.remove("clsContrastTextColor");
            subelement.classList.remove("clsAccentColor");
            subelement.classList.add("clsTextSecondaryColor");
        }
    }

    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" && this.data.seriesLength != 1 ? true : false;
    overlapgrid = this.data.promptText ? false : overlapgrid;
    let calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        let fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (((parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") || (overlapgrid && this.voData.presentMode)) && this.data.chartName != "columnIconFill") {
            this.valueMaxLimit = this.valueOverlapping();
            this.maxValueH = 0;
        } else {
            this.data.data.setAttribute("overlapgrid", "");
        }
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        if (overlapgrid && calloutStyle != "textbgcalloutstyle4top" && this.data.seriesLength != 1) {
            element.style.display = "none";
        } else {
            if (hasDoubleNode && this.data.hasProjection && subelement) {
                subelement.classList.remove("clsValueTextColor");
                subelement.classList.add("clsValueTextColor");
            }
        }
    }
};

BaseColumnSeriesItem.prototype.doAddBottomPlaceholder = function (argparent, argprops) {
    const index = argprops.index;
    const type = String(argprops.placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    const bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    let padding = this.setoverlapPadding("placeholder");
    const pLayoutName = this.placeholderlayoutClassName("placeholder", true);
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.paddingLeft = padding["left"] + "px";
    baseelement.style.paddingRight = padding["right"] + "px";
    baseelement.style.paddingTop = padding["top"] + "px";
    baseelement.style.paddingBottom = padding["bottom"] + "px";
    baseelement.style.pointerEvents = "all";
    baseelement.style.order = this.placeholderAlignment.index;
    baseelement.style.position = "relative";

    // baseelement.className =this.data.layout.placholderGlopalStyle;
    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");

    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");

    if (argparent) argparent.appendChild(baseelement);

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);

    const element = this.ChartHelper.createDivElement({});
    element.id = "primary-placeholder-" + this.groupindex;
    element.className = "primaryplaceholder bottomprimaryplaceholder";
    element.style.position = "relative";
    element.style.width = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.width + "px";
    element.style.height = bounds.height + "px";

    baseelement.appendChild(element);
    if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "outer") {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.className = pLayoutName + " contentContainer  moodanimation";
    } else {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.className = pLayoutName + " contentContainer moodanimation";
    }
    baseelement.appendChild(element);
    if (this.data.layout.placeholderAlterPaddingClass && this.data.chartFlip) {
        baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
    } else {
        if (this.data.layout.placeholderPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderPaddingClass);
        }
    }
    if (this.placeholderAlignment.position == "inner") {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position != "middle") {
        // this.bgProperties(element)
    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && type == "image") {
        // this.bgProperties(element)
    }
    if (this.data.layout.boolplaceholderShape) {
        element.style.alignItems = "center";
        element.style.justifyContent = "center";
    }
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            break;
        case "logo":
            this.doAddImageUseNodeElement(element, argprops, "logo");
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

BaseColumnSeriesItem.prototype.doAddBottomGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightDifferenceHeight = 0;

    // if (this.displayValue(argprops) && this.valuePosition == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basebottomgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment && this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment && this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label", true);
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        if (this.data.chartName == "columnslider") {
            this.middleVW = parseInt(this.state.width * 0.7);
            this.middleVH = parseInt(this.state.width * 0.7);
        }
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        if (this.data.chartName == "columnslider") {
            middleelementValue.classList.add(this.data.ChartFonts.appendgraphicBgColor(groupindex));
        }
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        if (this.data.layout.boolvaluebgShape) {
            this.valuebgProperties(middleelementValue);
        }
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value", true);
        element.style.flexDirection = "column-reverse";
    }
    if (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
        this.middlePW = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        this.middlePH = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        if (this.data.layout.placholderHeight) {
            this.middlePH = this.data.layout.placholderHeight;
        }
        if (this.data.layout.placholderWidth) {
            this.middlePW = this.data.layout.placholderWidth;
        }
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.layout.boolplaceholderShape) {
            // this.bgProperties(middleelementPlaceholder)
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }
    parentHeight = this.state.height;
    //  if(this.data.minValue<0){
    //    parentHeight =this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    //    parentHeight = parentHeight<this.state.height?this.state.height:parentHeight;
    //  }
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = this.data._hdHight1;
    }
    if (this.data.indualHighlight) {
        highlightDifferenceHeight = this.data._hdHight1;
    }
    let baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + highlightDifferenceHeight); //+ this.maxValueH
    if (this.valueAlignment.position == "outer") {
        baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + 2 * this.maxValueH + highlightDifferenceHeight);
    }
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    let baseGraphicHeightPercentage = baseGraphicHeight;
    let dummeyValue = -argprops.value;
    if (this.data.highvaluebreak && argprops.value != this.data._minValue) {
        let differncePercentage = (this.data.rangeNegative * 0.8) / this.data.secondnegativeHighValue;
        dummeyValue = -argprops.value * differncePercentage;
    }
    let graphicHeightPercentage = baseGraphicHeightPercentage * (dummeyValue / totalValue);
    // graphicHeightPercentage = graphicHeightPercentage == 1 ? 0.9 : graphicHeightPercentage;
    let parentPercentage = baseGraphicHeightPercentage * (-argprops.minvalue / totalValue);
    // console.log("bottom"+(parentPercentage+this.maxValueH));
    let seriesItem = this.parent.querySelectorAll(".bottomseriesitem");
    let topSeriesItem = this.parent.querySelectorAll(".topseriesitem");
    // seriesItem.style.height = (parentPercentage+this.maxValueH)+"px";
    // seriesItem.style.height = this.data.SVGUtils.createPercentValue(this.state.height, (parentPercentage+this.maxValueH))
    // for (let j1 = 0; j1 < seriesItem.length; j1++) {
    //     seriesItem[j1].style.height = this.data.SVGUtils.createPercentValue(this.state.height, this.state.height - topSeriesItem[0].clientHeight);
    // }

    let baseParentHeight = this.state.height;
    // if(this.data.minValue<0){
    //  let baseParentHeight = this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    //  baseParentHeight = baseParentHeight<this.state.height?this.state.height:baseParentHeight;
    // }
    // topSeriesItem.style.height = (baseParentHeight-(parentPercentage+this.maxValueH))+"px";
    // topSeriesItem.style.height = this.data.SVGUtils.createPercentValue(this.state.height, (baseParentHeight-(parentPercentage+this.maxValueH)))
    // for (let s1 = 0; s1 < topSeriesItem.length; s1++) {
    //     topSeriesItem[s1].style.height = this.data.SVGUtils.createPercentValue(this.state.height, baseParentHeight - (parentPercentage + this.maxValueH));
    // }
    let ParentHeightValue = parentPercentage + this.maxValueH;
    let backgroundElement = "";
    let backgroundBorderElement = "";
    if (this.data.layout.enableBackground) {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        element.style.position = "relative";
        argparent.style.flexDirection = "column";
        bgClsFillStyle = this.getBgColorDetails(groupindex, this.ChartFonts.emphasizeColor, this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        // if (this.data.layout.enableBackground) bgClsFillStyle = this.ChartFonts.emphasizeColor;
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        backgroundElement.style.height = this.data.SVGUtils.createPercentValue(ParentHeightValue, parentPercentage);
        if (this.data.layout.backgroundOpacity != 0) {
            element.style.setProperty("--bg-opacity", this.data.layout.backgroundOpacity);
        }
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " cs-chart-main-graphic  moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = backgroundElement.style.width;
            backgroundBorderElement.style.height = this.data.SVGUtils.createPercentValue(ParentHeightValue, parentPercentage);
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            backgroundBorderElement.dataset.customopacity = "0.5";
            if (this.data.layout.backgroundborderstyle == "dashed") {
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment + "dashed");
                backgroundBorderElement.style.setProperty("--border-style", "dashed", "");
            } else {
                backgroundBorderElement.style.setProperty("--border-style", "solid", "");
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
            }
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            backgroundBorderElement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");

            if (this.data.layout.backgroundBorder.color == "theme") {
                let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
                backgroundBorderElement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
                if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                    this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex);
                }
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); // this.ChartFonts.graphicBgColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    subelement.style.setProperty("--bg-opacity", "1");
    if (this.valueAlignment.itemBased == "true" || this.labelAlignment.itemBased == "true") {
        subelement.style.width = 100 + "%";
    }
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    // subelement.style.height = this.data.stackedChart ? "100%" : graphicHeightPercentage+"px";
    subelement.style.height = this.data.stackedChart ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue, graphicHeightPercentage);
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";

    //subelement.dataset.animation = "shadowitem";
    //subelement.setAttribute("data-id", groupindex + "_" + index);
    //subelement.setAttribute("data-type", "ITEM");
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.negativeTransformValue + " " + clsStyle;
    graphicElement.dataset.customorgin = this.customNegativeOrginmValue;
    graphicElement.dataset.heightpercnt = argprops.viewport.height / this.state.height;
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
    graphicElement.dataset.animation = "item";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    if (this.data.stackedChart) {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    if (this.data.boolEnableWidthReducer) {
        graphicElement.style.width = "96%";
    }
    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = "50% 0% 0%";
    }
    if (this.style.bgFillType == "gradient" || (this.style.bgFillType == "gradient" && this.data.hasEmphasis && this.data.emphasis[groupindex] == true)) {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.data.highvaluebreak && argprops.value >= this.data._minValue && this.data.seriesLength > 1) {
        let highvalueBreakElemnt = this.ChartHelper.createDivElement({});
        highvalueBreakElemnt.style.height = "7%";
        highvalueBreakElemnt.style.position = "absolute";
        highvalueBreakElemnt.style.width = "100%";
        graphicElement.style.position = "relative";
        graphicElement.appendChild(highvalueBreakElemnt);
        let dividerHeight = highvalueBreakElemnt.clientHeight;
        let dividerWidth = highvalueBreakElemnt.clientWidth;
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.top = "6.5%";
        } else {
            highvalueBreakElemnt.style.bottom = "6.5%";
        }

        let svgParent = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgParent, {
            width: "100%",
            height: "100%",
            style: "position: absolute; top: 0; left: 0;",
        });
        highvalueBreakElemnt.appendChild(svgParent);

        let Bounds = this.thicknesCalculation(dividerWidth, dividerHeight);
        let thickness = Bounds.thickness;
        let topY = Bounds.top;
        let bottomY = Bounds.bottom;
        let segmentWidth = Bounds.Width;
        let segmentCount = Bounds.count;

        // Create a continuous zigzag path starting from left edge to right edge
        let pathValue = "";

        // Start from left edge always at top
        pathValue += "M 0," + topY;

        // Create zigzag segments across the width - alternate between top and bottom
        for (let i = 0; i < segmentCount; i++) {
            let x = (i + 1) * segmentWidth;
            let y = i % 2 === 0 ? bottomY : topY; // First goes down, then up, then down, etc.

            // Ensure we don't exceed the width
            if (x >= dividerWidth) {
                x = dividerWidth;
            }

            pathValue += " L " + x + "," + y;
        }

        // Calculate final Y position after all segments
        // After segmentCount segments, if count is even, we're at topY, if odd, at bottomY
        let finalY = segmentCount % 2 === 0 ? topY : bottomY;

        // End at the right edge with the correct final Y position
        pathValue += " L " + dividerWidth + "," + finalY;

        let svgPath = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: pathValue,
            "stroke-width": thickness + "px",
            stroke: "var(--item" + (groupindex + 1) + "-color)",
            fill: "none",
            class: "dividerpath moodanimation",
            "data-animation": "highvaluebreak",
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
        });
        svgParent.appendChild(svgPath);
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (this.data.chartName != "columnSimpleRectangleFill") {
        ///DropShadow
        // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
        let colorStyle = this.data.layout.itemBoxShdowColor == "item" ? clsStyle : "";
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
        // graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    }
    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "columnborderelement";
        borderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);

        // graphicElement.classList.remove("accent" + (styleIndex + 1) + "-bg-color");
        // graphicElement.classList.add("background-bg-color");

        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        // if (this.voData.shapeBoderColor == "theme") {
        let strBordeStyleClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.voData.shapeBoderColor, "bordercolor");
        // let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
        borderElement.classList.add(strBordeStyleClass);
        if (this.voData.shapeBoderColor == "gradient") {
            borderElement.classList.add("itemborderGrdient");
        }
        this.emphasisColor = " secondary-border-color";
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
            if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
                let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
                graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
            }
        }
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
            this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex, true);
        }
        let highlightPoint = false;
        if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
            if (this.data.highlightDifference.display) highlightPoint = true;
        }
        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
            graphicElement.classList.remove("background-bg-color");
            graphicElement.classList.add(this.data.ChartFonts.appendgraphicBgColor(groupindex));
        }
        borderElement.classList.add("moodanimation");
        borderElement.dataset.animation = "itemborder";
        borderElement.setAttribute("data-graphic-y", -graphicElement.clientHeight);
        if (this.data.chartFlip) {
            borderElement.setAttribute("data-graphic-y", graphicElement.clientHeight);
        }
        // }
        let borderAlign = this.voData.shapeBoderAlign == "top" ? "bottom" : this.voData.shapeBoderAlign == "bottom" ? "top" : this.voData.shapeBoderAlign;
        if (this.data.layout.itemborderstyle == "dashed") {
            borderElement.classList.add("shapeborder" + borderAlign + "dashed");
            borderElement.style.setProperty("--border-style", "dashed", "");
        } else {
            borderElement.style.setProperty("--border-style", "solid", "");
            borderElement.classList.add("shapeborder" + borderAlign);
        }
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        if (graphicHeightPercentage < this.voData.shapeBoderSize) {
            borderElement.style.borderWidth = graphicHeightPercentage + "px";
            borderElement.style.setProperty("--border-width", graphicHeightPercentage + "px", "");
        }
    }

    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = graphicElement.clientHeight + "px 0% 0%";
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation " + this.transformOrginValue + " " + clsStyle + " projection" + (groupindex + 1);
        graphicElement.dataset.customorgin = this.customOrginValue;
    }

    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  " + this.transformOrginValue + " graphicnode " + clsStyle + " projection" + (groupindex + 1);
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
        graphicElement.classList.add("clsNodeSecondarybg");
        graphicElement.style.boxShadow = "";
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert") && this.data.shapeBorder) {
        graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode " + clsStyle;
    }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-alpha") && this.data.shapeBorder) {
    //     graphicElement.classList.add("borderprjectionOpacity")
    //     graphicElement.dataset.customopacity = "0.4";
    //     borderElement.classList.add("borderprjectionOpacity")
    //     borderElement.dataset.customopacity = "0.4"
    // }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder) {
        borderElement.classList.add("secondary-border-color");
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
        let borderColor = "secondary-border-color";
        if (this.data._projectionName == "projection-basic-border-invert") {
            borderColor = this.ChartFonts.graphicBorderColor(groupindex);
        }
        // if (this.data._projectionName != "projection-alpha") {
        //     graphicElement.className = "chartgraphic   cs-chart-main-graphic  graphicnode moodanimation transformOrginBottom " + borderColor
        //     graphicElement.classList.add("shapeborderall")
        //     graphicElement.style.boxShadow = "";
        // } else {
        //     graphicElement.classList.add("prjectionOpacity")
        //     graphicElement.dataset.customopacity = "0.2",
        //     graphicElement.dataset.hidecustomopacity = "true"
        // }
    }
    if (borderElement) {
        borderElement.classList.remove("columnborderelement");
        borderElement.classList.add("columnborderelement");
    }

    if (this.data.grapicImage[groupindex] == "true" && this.data.chartName != "columnSimpleRectangleFill" && this.data.chartName != "column3DRectangle" && this.data.layout.itemFillType == "image") {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage basenodeposition";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
        let item = this.ChartUtils.getOffsetLeftTop(graphicElement, "SLIDE", true);
        graphicElement.setAttribute("data-x", item.x);
        graphicElement.setAttribute("data-y", item.y);
        graphicElement.setAttribute("data-width", graphicElement.clientWidth);
        graphicElement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-width", graphicElement.clientWidth);
        subImgelement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

        subImgelement.setAttribute("data-x", item.x);
        subImgelement.setAttribute("data-y", item.y);
        graphicElement.style.position = "relative";
        graphicElement.style.overflow = "hidden";
        graphicElement.style.pointerEvents = "all";
        this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img");
        if (this.data.data.getAttribute("layout") == "outsidenumberbottom" || this.data.data.getAttribute("layout") == "outsidenumberinsidelabel" || this.data.data.getAttribute("layout") == "outsidenumber" || this.data.data.getAttribute("layout") == "labeloutsidetop") {
            // subImgelement.style.position = "absolute";
            graphicElement.style.position = "relative";
        }
    }

    if (
        ((this.labelAlignment && this.labelAlignment.samepos == "true") || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        ((this.labelAlignment && this.labelAlignment.itemBased == "true") ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            (this.labelAlignment && this.labelAlignment.position == "inner") ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddBottomValue(element, argprops, true);
        let booloverLap = graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container", true);
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = ((this.labelAlignment && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = ((this.labelAlignment && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = (this.labelAlignment && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
        if (this.valueAlignment.position == "inner" && this.labelAlignment.position == "inner" && this.valueAlignment.samepos == "true") {
            sameElement.style.height = "100%";
        }
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment && this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddBottomValue(element, argprops);
            else this.doAddBottomValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddBottomPlaceholder(sameElement, argprops);
        }
    }

    // if (this.displayPrimaryPlaceholder(argprops)) {
    //     if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
    //         this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
    //         this.doAddBottomPlaceholder(element, argprops);
    //     } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
    //         const pLayoutName = this.placeholderlayoutClassName("containerplaceholder", true);
    //         const placeholderElement = this.ChartHelper.createDivElement({});
    //         placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
    //         placeholderElement.className = "placeholderelement " + pLayoutName;
    //         placeholderElement.style.width = (this.labelAlignment && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased == "true" ? 100*this.itemBasedValueWidth+"%" : "100%";
    //         subelement.appendChild(placeholderElement);
    //         this.placeholderStyle = this.ChartFonts.valueInnerColor;
    //         this.doAddBottomPlaceholder(placeholderElement, argprops);
    //     } else if (this.valueAlignment.vposition == "bottom") {
    //         this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
    //         element.style.order = 1;
    //         this.doAddBottomPlaceholder(argparent, argprops);
    //     }
    // }

    if (this.displayLabel(argprops)) {
        graphicH = Math.round(graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment && this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel", true);
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment && this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel", true);
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment && this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment && this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        graphicH = Math.round(graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue", true);
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv);
                label[0].children[0].classList.remove("clsAlterSecondaryColor");
                label[0].children[0].classList.remove("clsContrastColor");
                label[0].children[0].classList.add("clsContrastColor");
                subelement.parentNode.appendChild(label[0]);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(valueElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%;height:100%;",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%";
                graphicElement.style.width = "100%";
                if (borderElement) borderElement.style.width = "100%";
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || (this.data.stackedChart && subelement.clientHeight < this.maxValueH) || graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueOuter = true;
            this.valueStyle = "";
            graphicH = Math.round(subelement.clientHeight) - this.maxValueH;
            if (this.data.layout.enableBackground) {
                this.doAddTopValue(element, argprops);
            } else if (this.data.stackedChart) {
                stackedGraphicH = subelement.clientHeight;
            } else this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.maxValueH) {
            const vLayoutName = this.valuelayoutClassName("containervalue", true);
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(valueElement);
            let highlightPoint = false;
            if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
                if (this.data.highlightDifference.display) highlightPoint = true;
            }
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
            this.valueStyle = this.ChartFonts.valueOuterColor;
            element.style.order = 1;
            if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH) {
                this.overlap = subelement.clientHeight < this.maxValueH;
                this.doAddTopValue(element, argprops);
            } else {
                this.doAddTopValue(argparent, argprops);
            }
        }
    }
    // for (let s1 = 0; s1 < topSeriesItem.length; s1++) {
    //     topSeriesItem[s1].style.height = this.data.SVGUtils.createPercentValue(this.state.height, baseParentHeight - (parentPercentage + this.maxValueH));
    // }
    this.middleElementvalidationBottom(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);
    if (this.data.layout.enableBackground) {
        if (this.voData.layout.backgroundBorderRadiusValues) {
            let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            if (this.data.values[this.groupindex][this.index] < 0) {
                borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
                borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
                borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
                borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            }
            if (this.data.layout.backgroundAlterBorderRadiusClass) {
                if (backgroundElement) backgroundElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
            } else {
                if (backgroundElement) backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            }
        }
    }
    if (backgroundElement) {
        if (this.data.layout.data.background.opacity || this.data.layout.backgroundOpacity) {
            let Class = this.getBgClassList(backgroundElement);
            let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
            backgroundElement.style.setProperty("background-color", rgbavalue, "important");
        }
    }
    if (backgroundElement) {
        backgroundElement.style.width = graphicElement.clientWidth + "px";
        if (backgroundBorderElement) {
            backgroundBorderElement.style.width = graphicElement.clientWidth + "px";
        }
    }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        if (this.data.values[this.groupindex][this.index] < 0) {
            borderRadiuslefttop = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusRightTop = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusRightBottom = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        }
        if (this.data.layout.alterBorderRadiusClass) {
            graphicElement.classList.add(this.data.layout.alterBorderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
        if (!this.data.layout.backgroundBorderRadiusClass) {
            if (backgroundBorderElement) backgroundBorderElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    if (this.data.layout.backgroundBorderRadiusClass) {
        if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
    }
    ///DropShadow
    if (this.data.layout.itemShadow) {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};

BaseColumnSeriesItem.prototype.getValueBounds = function (props) {
    // return this.ChartHelper.getTextMeasurements(this.data.slideID, this.data.longValue, this.valueMaxW, this.valueMaxH, this.maxValueFontSize[this.arrIndex], this.minValueFontSize[this.arrIndex], "value " + this.ChartFonts.valueThemeClassName, false, this.parent);
    return { width: 0, height: 0 };
};

BaseColumnSeriesItem.prototype.getTextMeasurements = function (slideID, text, argMaxWidth, argMaxHeight, argMaxFontSize, argMinFontSize, className = null, parentElement) {
    let element = document.createElement("div");
    element.id = "dummyText" + this.index;
    element.innerText = text;
    element.style.maxWidth = argMaxWidth.toString().split("%")[1] == "%" ? argMaxWidth : argMaxWidth + "px";
    element.style.maxheight = argMaxHeight.toString().split("%")[1] == "%" ? argMaxHeight : argMaxHeight + "px";
    element.style.fontSize = argMaxFontSize + "px";
    if (className) element.className = className;
    parentElement.appendChild(element);
    this.ChartHelper.adjustFontSize(element, argMaxHeight, argMinFontSize, argMaxFontSize);
    let textBoundsW = element.clientWidth;
    let textBoundsH = element.clientHeight;
    let fontsize = window.getComputedStyle(element)["font-size"];
    parentElement.removeChild(element);
    return {
        width: parseInt(textBoundsW),
        height: parseInt(textBoundsH),
        fontsize: fontsize.split("px")[0],
    };
};

BaseColumnSeriesItem.prototype.getPosition = function (props) {
    switch (this.props.layerposition) {
        case "outer":
            console.log(" outer ");
            break;
        case "middle":
            console.log(" middle ");
            break;
        case "inner":
            console.log(" inner ");
            break;
    }
};

BaseColumnSeriesItem.prototype.getPlaceholderBounds = function (props) {
    if (this.data.primaryPlaceholder) {
        if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
            return { width: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.5, height: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.3 };
        } else {
            return { width: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.3, height: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.3 };
        }
    } else {
        return { width: this.state.width, height: 0 };
    }
};

BaseColumnSeriesItem.prototype.setoverlapPadding = function (name) {
    let hposition;
    let vPosition;
    let area = { left: 0, right: 0, top: 0, bottom: 0 };
    if (name == "label") {
        area = { left: this.data.layout.labelPaddingleft, right: this.data.layout.labelPaddingright, top: this.data.layout.labelPaddingtop, bottom: this.data.layout.labelPaddingbottom };
        if (this.labelAlignment && this.labelAlignment.overlap == "value") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.labelPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.labelPaddingright;
            return area;
        } else if (this.labelAlignment ** this.labelAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = (this.middlePH + this.data.layout.labelPaddingbottom) * 0.5;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.labelPaddingright;
            return area;
        }
    } else if (name == "value") {
        area = { left: this.data.layout.valuePaddingleft, right: this.data.layout.valuePaddingright, top: this.data.layout.valuePaddingtop, bottom: this.data.layout.valuePaddingbottom };
        if (this.valueAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleLH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.valuePaddingright;
            return area;
        } else if (this.valueAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middlePH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.valuePaddingright;
            return area;
        }
    } else if (name == "placeholder") {
        area = {
            left: this.data.layout.placeholderPaddingleft,
            right: this.data.layout.placeholderPaddingright,
            top: this.data.layout.placeholderPaddingtop,
            bottom: this.data.layout.placeholderPaddingbottom,
        };
        if (this.placeholderAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = middleValueH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.placeholderPaddingright;
            return area;
        } else if (this.placeholderAlignment.overlap == "placeholder") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.placeholderPaddingright;
            return area;
        }
    }
    return area;
};

BaseColumnSeriesItem.prototype.removeValueElement = function () {
    let valueElements = this.data.stackedChart ? this.parent.querySelectorAll(".value") : this.parent.parentNode.parentNode.parentNode.querySelectorAll(".value");
    if (valueElements) {
        Array.from(valueElements).forEach(function (item) {
            item.style.display = "none";
        });
    }
};

BaseColumnSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax = false, boolLonLabel = true, boolMinHeight = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        if (boolMinHeight) {
            element.className = "minheightvalue label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        }
        element.id = "label-text-" + this.groupindex;
        element.style.minHeight = 10 + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.fontSize = this.maxLabelFontSize[this.index] + "px";
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if (this.boolDisableWidth || this.data.layout.labelItemBased == "true") {
            element.style.width = "";
        } else {
            element.style.width = this.labelMaxW + "px";
        }

        // if (this.graphicElement.alterpos == "true") {
        // if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position != "inner") {
        //     if (this.groupindex == 0) {
        //         element.style.marginLeft = "auto";
        //     } else {
        //         element.style.marginRight = "auto";
        //     }
        // }
        if ((argprops.value < 0 && this.labelAlignment.itemBased != "true") || (this.labelAlignment.itemBased == "true" && this.data.layout.itemalterpos == "true" && this.groupindex == 1 && this.labelAlignment.position != "inner")) {
            element.style.paddingTop = padding["bottom"] + "px";
            element.style.paddingBottom = padding["top"] + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.position == "inner" && graphicH < this.maxLabelH) {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        if (!this.overlap) this.labelStyle = this.getColorDetails(this.groupindex, this.labelStyle, this.data.layout.labelColor, "color");

        if (this.labelAlignment.position == "inner") {
            element.classList.add("minlabelheight");
        }
        this.labelMaxW = this.labelMaxW - (padding["left"] + padding["right"]);

        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        if (this.data.layout.labelInset == "inside") {
            subelement.className = "labeltext " + this.labelStyle;
        }
        subelement.id = "labeltext-" + this.groupindex;
        subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "labeltext-" + this?.groupindex);
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");

        subelement.innerHTML = boolMax && boolLonLabel ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison") {
            subelement.setAttribute("data-specialtype", "label");
        }
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        if (this.data._labelTextColor[this.groupindex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupindex], "important");
        }
        if (this.data.hasEmphasis || this.data.hasProjection) {
            subelement.classList.add("cs-label-text");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.presentMode || this.data.seriesanimation) {
            subelement.setAttribute("contenteditable", "false");
        } else {
            subelement.classList.add("transparentBg");
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
            // let rgbColor = window.getComputedStyle(subelement)["color"];
            // let rgbaColor = rgbColor.replace(")", ", 0.2)").replace("rgb", "rgba");
            // subelement.style.background = rgbaColor;
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 10, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            this.maxCurrentLabelW = element.clientWidth;
            argparent.removeChild(element);
        }
        if (subelement && this.ChartFonts.valueInnerColor && subelement.getAttribute("class") && subelement.getAttribute("class").includes(this.ChartFonts.valueInnerColor)) {
            subelement.classList.remove("cs-inner-text-color");
            subelement.classList.add("cs-inner-text-color");
        }
    }
};
BaseColumnSeriesItem.prototype.doAddSecondaryLabel = function (argparent, argprops, boolMax = false, boolLonLabel = true, boolMinHeight = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "secondaryElement secondarylabel moodanimation  " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        if (boolMinHeight) {
            element.className = "minheightvalue secondaryElement secondarylabel moodanimation  " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        }
        element.id = "label-text-" + this.groupindex;
        element.style.minHeight = 10 + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = 0;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if (this.boolDisableWidth) {
            element.style.width = "";
        } else {
            element.style.width = this.labelMaxW + "px";
        }
        // if (this.graphicElement.alterpos == "true") {
        // if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position != "inner") {
        //     if (this.groupindex == 0) {
        //         element.style.marginLeft = "auto";
        //     } else {
        //         element.style.marginRight = "auto";
        //     }
        // }
        if (argprops.value < 0 && this.data.layout.labelItemBased != "true") {
            element.style.paddingTop = padding["bottom"] + "px";
            element.style.paddingBottom = padding["top"] + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        }
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.position == "inner" && graphicH < this.maxLabelH) {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        this.labelStyle = this.getColorDetails(this.groupindex, this.labelStyle, this.data.layout.labelColor, "color");

        if (this.labelAlignment.position == "inner") {
            element.classList.add("minlabelheight");
        }
        this.labelMaxW = this.labelMaxW - (padding["left"] + padding["right"]);

        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupindex;
        subelement.setAttribute("data-test-id", this?.data?.isLive ? " " : "labeltext-" + this.groupindex);
        if (this.data.arrSecondaryLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrSecondaryLabelOpacity[this.groupindex], "");
        subelement.innerHTML = boolMax && boolLonLabel ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "secondarylabel");
        if (this.data.chartName == "lineChart" || this.data.chartName == "lineCoinChart" || this.data.chartName == "stackedAreaChart" || this.data.chartName == "shapesComparisonChart" || this.data.chartName == "multiImageComparison") {
            subelement.setAttribute("data-specialtype", "secondarylabel");
        }
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        if (this.data.presentMode || this.data.seriesanimation) {
            subelement.setAttribute("contenteditable", "false");
        } else {
            subelement.classList.add("transparentBg");
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
            // let rgbColor = window.getComputedStyle(subelement)["color"];
            // let rgbaColor = rgbColor.replace(")", ", 0.2)").replace("rgb", "rgba");
            // subelement.style.background = rgbaColor;
        }
        if (this.data._secondaryTextColor[this.groupindex]) {
            subelement.style.setProperty("color", this.data._secondaryTextColor[this.groupindex], "important");
        }
        this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            argparent.removeChild(element);
        }
    }
};
BaseColumnSeriesItem.prototype.doSecondaryImage = function (element, argprops) {
    const subelement = document.createElement("img");
    subelement.style.height = "100%";
    subelement.style.order = this.alignment.index;
    subelement.src = this.data.secondaryPlaceholderPath[this.groupindex];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "secondaryElement primaryplaceholdergraphic";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "rgba(var(--th-slide-secondary), 1)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "var(--item" + this.index + "-color)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
};
BaseColumnSeriesItem.prototype.addGradient = function (svgRect, parentElement, bgFill = true, stroke = false, bgElemenet = false) {
    let GradientDatas = bgElemenet ? this.data.layout.backgroundGradientDatas : this.data.layout.itemGradientDatas;
    let opacity1 = GradientDatas && GradientDatas.opacity1 ? GradientDatas.opacity1 : "0.6";
    let opacity2 = GradientDatas && GradientDatas.opacity2 ? GradientDatas.opacity2 : "1";
    let color1 = GradientDatas && GradientDatas.color1 ? this.checkColorValue(GradientDatas.color1) : "var(--accent" + 2 + "-color)";
    let color2 = GradientDatas && GradientDatas.color2 ? this.checkColorValue(GradientDatas.color2) : "var(--accent" + 6 + "-color)";
    let defs = this.data.SVGUtils.createSVGElement("defs");
    parentElement.appendChild(defs);
    let linearGrad = this.data.SVGUtils.createSVGElement("linearGradient");
    this.data.SVGUtils.assignAttributes(linearGrad, {
        id: bgElemenet ? "bggrad" : "grad",
        x1: "0%",
        x2: bgFill ? "0%" : "100%",
        y1: bgFill ? "100%" : "0%",
        y2: "0%",
    });
    defs.appendChild(linearGrad);
    let stop1 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop1, {
        class: "stop1",
        offset: GradientDatas && GradientDatas.percentage1 ? GradientDatas.percentage1 + "%" : "0%",
        style: "stop-color:" + color1 + ";stop-opacity:" + opacity1,
    });
    linearGrad.appendChild(stop1);
    let stop2 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop2, {
        class: "stop2",
        offset: GradientDatas && GradientDatas.percentage2 ? GradientDatas.percentage2 + "%" : "100%",
        style: "stop-color:" + color2 + ";stop-opacity:" + opacity2,
    });
    linearGrad.appendChild(stop2);
    if (bgFill) {
        this.data.SVGUtils.assignAttributes(svgRect, {
            fill: bgElemenet ? "url(#bggrad)" : "url(#grad)",
        });
    }
    if (stroke) {
        this.data.SVGUtils.assignAttributes(svgRect, {
            stroke: bgElemenet ? "url(#bggrad)" : "url(#grad)",
        });
    }
};
BaseColumnSeriesItem.prototype.checkColorValue = function (colorvalue) {
    if (colorvalue) {
        if (colorvalue.includes("item1")) {
            return "var(--item" + 1 + "-color)";
        }
        if (colorvalue.includes("item2")) {
            return "var(--item" + 2 + "-color)";
        }
        if (colorvalue.includes("item3")) {
            return "var(--item" + 3 + "-color)";
        }
        if (colorvalue.includes("item4")) {
            return "var(--item" + 4 + "-color)";
        }
        if (colorvalue.includes("item5")) {
            return "var(--item" + 5 + "-color)";
        }
        if (colorvalue.includes("item6")) {
            return "var(--item" + 6 + "-color)";
        }
    }
};
BaseColumnSeriesItem.prototype.imageSearchCompleteCallback = function (content, slideProps) {
    let hasContentNode = content.data && content.data.length > 0;
    if (hasContentNode) {
        let graphicElement = this.data.redrawOpertion.getSlideContent(slideProps?.slideid, slideProps?.isTakeaway);

        for (let c1 = 0; c1 < content.data.length; c1++) {
            let contentDetails = content.data[c1];
            if (contentDetails?.status == 0 && contentDetails.url && slideProps) {
                let slideId = slideProps?.slideid;
                let indexValue = slideProps?.groupindexValues[c1];
                slideProps.xmlData.children[slideProps?.groupindexValues[c1]].setAttribute("itemgraphicpath", contentDetails.url);
                slideProps.xmlData.children[slideProps?.groupindexValues[c1]].setAttribute("needassetupdate", "false");

                let arrImageNode = graphicElement?.querySelectorAll(".graphicimage");
                let imageNode = arrImageNode[indexValue];
                if (imageNode) {
                    imageNode.src = contentDetails.url;
                    imageNode.setAttribute("data-imagepath", contentDetails.url);
                    let parentNodeWidth = imageNode.parentNode?.clientWidth;
                    let parentNodeHeight = imageNode.parentNode?.clientHeight;
                    this.ChartUtils.updateImageReSize(parentNodeWidth, parentNodeHeight, imageNode, "", "img", this.voData);
                }

                if (this.data.redrawOpertion) {
                    this.data.redrawOpertion.updatexmlData(slideId, "changexmlimage", slideProps.isTakeaway, { contentDetails: contentDetails, index: slideProps?.groupindexValues[c1] });
                    this.data.redrawOpertion.updateAiSearchCount(slideId, "delete");
                }
            }
        }
    }

    return;
};
BaseColumnSeriesItem.prototype.updateaisearchcount = function (slideID) {
    if (this.data.redrawOpertion) this.data.redrawOpertion.updateAiSearchCount(slideID, "add");
    return;
};
BaseColumnSeriesItem.prototype.secondarylayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.alignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.alignment.hposition + this.alignment.vposition;
    }
    return lLayoutName;
};

function BaseCurrencyChart(argParent, argProps) {
    this.widthPercentage = 1;
    this.minSeriesSize = 300;
    this.name = "BaseCuurencyChart";
    BaseChart.call(this, argParent, argProps);
}
BaseCurrencyChart.prototype = Object.create(BaseChart.prototype);
BaseCurrencyChart.prototype.constructor = BaseCurrencyChart;

BaseCurrencyChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BaseCurrencySeries"](argParent, argProps);
};

BaseCurrencyChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddGraphicDesk();
            this.doAddMetaData();
            this.createTooltipCallout(this.parent, this.data);
        }
    }
};

BaseCurrencyChart.prototype.updateBasicData = function () {
    this.length = this.voData.seriesLength;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeries = { x: this.viewport.x, y: this.viewport.y, width: 0, height: 0 };
    this.rectBaseSeries = { x: this.viewport.x, y: this.viewport.y, width: this.viewport.width, height: this.viewport.height };
};

BaseCurrencyChart.prototype.doAddGraphicDesk = function () {
    const pading = 8;
    if (this.data.baseProperties.grid && !this.data._customProperties.showYAxisGrid) this.rectBaseSeries.height -= 20;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";

    this.rectSeries.height = this.rectBaseSeries.height;
    this.rectSeries.width = this.rectBaseSeries.width;

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    element.style.height = seriesHeight;
    element.style.width = seriesWidth;
    element.style.maxHeight = seriesHeight;

    this.parent.appendChild(element);

    this.doAddGraphicElement(element);
};

BaseCurrencyChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 20;
    let moveY = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
};

// ---------------------------------- Enhancement ---------------------------------

BaseCurrencyChart.prototype.doAddLegendDesk = function (argProps) {
    let eProps = {};
    let eParent = null;
    this.addLegendDeskElements(eParent, eProps);
};

BaseCurrencyChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    if (this.data.baseProperties.legend) {
        let eProps = {};
        let element = this.ChartHelper.createDivElement(eProps);
        return element;
    }
    return null;
};

BaseCurrencyChart.prototype.addAxisBaselineDeskElement = function (argParent, argProps) {
    let axisbaseline = new AxisBaseLine(argParent, argProps);
    axisbaseline.data = this.data;
    axisbaseline.rectSeries = argProps.rectSeries;
    axisbaseline.move(0, 0);
    axisbaseline.size(argProps.rectSeries.width, argProps.rectSeries.height);
};

function BaseCurrencySeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
    this.scaleX = 1;
    this.scaleY = 1;
    this.intItemGap = 10;
    this.numRectGrapicX = 0;
    this.numWidthPercentage = 0.64;
    this.numHeightPercentage = 0.58;
    this.name = "BaseSeries";
    this.maxLabelFontSize = [24, 24];
    this.ChartFonts = new window["ChartFonts"]();
    this.minLabelFontSize = [30 - 8, 30 - 8];
    BaseSeries.call(this, argparent, argprops);
}
BaseCurrencySeries.prototype = Object.create(BaseSeries.prototype);
BaseCurrencySeries.prototype.constructor = BaseCurrencySeries;

BaseCurrencySeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["BaseCurrencySeriesItem"](argparent, argprops);
};

BaseCurrencySeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseCurrencySeries.prototype.updateBasicData = function () {
    let _oWidth = 0;
    this.length = this.voData.seriesItemLength;
    this.viewportGroup = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

BaseCurrencySeries.prototype.doMeasurementComputation = function (argprops) {
    if (this.index == 0) {
        this.numRectGrapicX = 0;
        this.data.tempVarData = 0;
    }
    this.rectAvalSize = {
        x: (this.viewportGroup.width * this.numWidthPercentage) / 2,
        y: (this.viewportGroup.height * this.numHeightPercentage) / 2,
        width: this.viewportGroup.width * this.numWidthPercentage,
        height: this.viewportGroup.height * this.numHeightPercentage,
    };
    this.scaleX = this.rectAvalSize.width / this.data?.asset?.data?.[0]?.assetWidth;
    this.scaleY = this.rectAvalSize.height / this.data?.asset?.data?.[0]?.assetHeight;
    let intFitWidth = this.rectAvalSize.width;
    let intFitHeight = this.rectAvalSize.height;
    if (this.scaleX < this.scaleY) {
        intFitHeight = intFitHeight * this.scaleX;
        this.scaleY = intFitHeight / this.data?.asset?.data?.[0]?.assetHeight;
    } else {
        intFitWidth = intFitWidth * this.scaleY;
        this.scaleX = intFitWidth / this.data?.asset?.data?.[0]?.assetWidth;
    }
    this.rectSeriesItemSize = {
        x: (this.viewportGroup.width - intFitWidth) / 2,
        y: (this.viewportGroup.height - intFitHeight) / 2,
        width: intFitWidth,
        height: intFitHeight,
    };
    let intValueWidth = this.getWidth(this.rectSeriesItemSize.width, parseInt(this.data.values[this.index][0]), parseInt(this.data.seriesLength));
    this.numRectGrapicX = this.data.tempVarData;
    this.rectGrapicsItemSize = { x: this.numRectGrapicX, y: 0, width: intValueWidth, height: this.rectSeriesItemSize.height };
    this.data.tempVarData += this.rectGrapicsItemSize.width + this.intItemGap;
};

BaseCurrencySeries.prototype.getWidth = function (width, value, seriesLength) {
    var barPercent = (value * 100) / this.data.totalValue;
    barPercent = this.data.totalValue == 0 ? 100 / seriesLength : barPercent;
    var displace = ((width - (seriesLength - 1) * this.intItemGap) * barPercent) / 100;
    return displace;
};

BaseCurrencySeries.prototype.doAddGraphicElement = function (argprops) {
    let element = this.ChartHelper.createDivElement();
    element.id = "series-" + this.index;
    element.dataset.index = this.index;
    element.dataset.dckSelector = true;
    element.style.position = "absolute";
    element.style.width = "100%";
    element.style.height = "100%";
    element.style.pointerEvents = "none";
    let customColorIndex = this.ChartFonts.customColor(this.index);
    this.data.SVGUtils.assignAttributes(element, {
        class: "series accent" + customColorIndex + " clsMultiColorParent",
    });
    element.classList.add("th-section" + customColorIndex);

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    let intMaxGraphicSize = parseInt(this.data.maxValue * this.numMultiplyFactor);
    let eProps = {
        index: 0,
        scaleX: this.scaleX,
        scaleY: this.scaleY,
        groupIndex: this.index,
        parentWidth: this.rectSeriesItemSize.width,
        parentHeight: this.rectSeriesItemSize.height,
        rectGrapicsItemSize: {
            x: this.rectGrapicsItemSize.x,
            y: this.rectGrapicsItemSize.y,
            width: this.rectGrapicsItemSize.width,
            height: this.rectGrapicsItemSize.height,
        },
    };
    let groupParentElemet = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(groupParentElemet, { x: "0%", y: "0%", width: "100%", height: "100%" });

    let groupElemet = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(groupElemet, {
        id: "seriesItem-" + this.groupIndex + "_" + this.index,
        class: "seriesitem highlightSeriesItem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeriesItemSize.y),
        width: this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeriesItemSize.height),
        "data-y": this.rectSeriesItemSize.y,
        "data-x": this.rectSeriesItemSize.x,
        "data-highlightY": this.rectSeriesItemSize.y + this.rectSeriesItemSize.height / 2,
        "data-highlightX": this.rectSeriesItemSize.x,
    });
    groupParentElemet.appendChild(groupElemet);
    element.appendChild(groupParentElemet);
    if (this.parent) this.parent.appendChild(element);
    let seriesitem = this.seriesItemInstance(groupElemet, eProps);
    seriesitem.ChartHelper = this.ChartHelper;
    seriesitem.ChartUtils = this.ChartUtils;
    seriesitem.data = this.data;
    this.applyLayout(element);
};

BaseCurrencySeries.prototype.applyLayout = function (element) {
    if (this.data.layout.hadCallout || this.data.layout.hadconnector) {
        this.color = "";
        let intLabelMaxHeight = ((this.viewportGroup.height - this.rectSeriesItemSize.height) / 2) * 0.6;
        let intValueMaxHeight = ((this.viewportGroup.height - this.rectSeriesItemSize.height) / 2) * 0.6;
        let intNumerOfItemTop = Math.ceil(this.data.seriesLength / 2);
        let intLabelMaxWidth = this.viewportGroup.width / intNumerOfItemTop;
        this.data.maxValueW = intLabelMaxWidth * 0.6;
        this.data.maxValueH = intValueMaxHeight;
        let objLayoutManager = {
            groupIndex: this.index,
            parentWidth: this.viewportGroup.width,
            parentHeight: this.viewportGroup.height,
            graphicsAreaWidth: this.rectGrapicsItemSize.width,
            graphicsAreaHeight: this.rectGrapicsItemSize.height,
            graphicsAreaX: this.rectSeriesItemSize.x + this.rectGrapicsItemSize.x,
            graphicsAreaY: this.rectSeriesItemSize.y + this.rectGrapicsItemSize.y,
            layoutAreaHeight: this.viewportGroup.height - this.rectGrapicsItemSize.height,
            color: this.color,
            ChartHelper: this.ChartHelper,
            ChartUtils: this.ChartUtils,
            intLabelMaxHeight: intLabelMaxHeight,
            parentElement: element,
        };
        this.layoutManagerRounded = new window["LayoutManagerCurrencyConnector"](objLayoutManager);
        this.layoutManagerRounded.data = this.data;
        this.layoutManagerRounded.ChartHelper = this.ChartHelper;
        this.layoutManagerRounded.ChartUtils = this.ChartUtils;
        this.layoutManagerRounded.svgData;
    }
};

function BaseCurrencySeriesItem(argparent, argProps) {
    this.index = argProps.index;
    this.groupIndex = argProps.groupIndex;
    this.parentWidth = argProps.parentWidth;
    this.parentHeight = argProps.parentHeight;
    this.rectGrapicsItemSize = argProps.rectGrapicsItemSize;
    //this.rectBgImages = argProps.rectBgImages;
    this.scaleX = argProps.scaleX;
    this.scaleY = argProps.scaleY;
    this.intItemGap = 10;
    BaseSeriesItem.call(this, argparent, argProps);
}
BaseCurrencySeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
BaseCurrencySeriesItem.prototype.constructor = BaseCurrencySeriesItem;

BaseCurrencySeriesItem.prototype.doComputation = function () {
    if (this.datavalidation) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseCurrencySeriesItem.prototype.updateBasicData = function () {
    this.length = this.voData.seriesItemLength;
    let intAssetLength = this.voData.asset.data.length;
    if (0 < intAssetLength) this.assetURL = this.voData.asset.data[this.ChartUtils.getFactorIndex(this.groupIndex, 1)].url;
};

BaseCurrencySeriesItem.prototype.doAddGraphicElement = function () {
    let elementGroup = this.data.SVGUtils.createSVGElement("g");
    let boolOdd = this.voData.seriesLength % 2 == 0 ? true : false;
    let strSideAlignment;
    let leftAlignment = Math.ceil(this.voData.seriesLength / 2);
    let rightIndex = this.groupIndex + 1 - leftAlignment;
    let intCurrentIndex = this.groupIndex + 1;
    if (boolOdd) {
        strSideAlignment = this.groupIndex >= leftAlignment ? "right" + rightIndex : "left" + intCurrentIndex;
    } else {
        strSideAlignment = intCurrentIndex > leftAlignment ? "right" + rightIndex : leftAlignment == intCurrentIndex ? "center" : "left" + intCurrentIndex;
    }
    this.data.SVGUtils.assignAttributes(elementGroup, {
        "data-animation": strSideAlignment,
        "data-multiframe": "false",
        class: "moodanimation",
    });

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = 1 < this.voData.seriesItemLength ? "item" + (this.index + 1) : "item" + (this.groupIndex + 1);
    this.data.SVGUtils.assignAttributes(svgElement, {
        class: strStyleClass,
        id: "graphic-" + this.groupIndex + "_" + this.index,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-x": 0,
        "data-y": 0,
    });
    elementGroup.appendChild(svgElement);
    svgElement.style.pointerEvents = "none";
    let imageTag = this.data.SVGUtils.createSVGElement("image");
    this.data.SVGUtils.assignAttributes(imageTag, {
        class: "imagetag",
        id: "item-" + this.groupIndex + "_" + 0,
        "xlink:href": this.data.serverUrl + this.assetURL,
        "data-gap": this.intItemGap,
        "data-type": "IMAGE",
        "data-secondassetsource": this.data.layout.itemFolder,
        x: "0%",
        style: "-webkit-transform:" + "scale(" + this.scaleX + "," + this.scaleY + ")",
    });
    imageTag.style.pointerEvents = "all";

    let rect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(rect, {
        x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y),
        width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight),
        id: "item-" + this.groupIndex + "_" + 0,
        fill: "#fff",
        class: "CalloutRect chartgraphic",
        // "data-highlightPontX":this.parent.dataset.x,
        // "data-highlightPontY":this.parent.dataset.y+(this.parentHeight/2),
        "data-x": this.rectGrapicsItemSize.x,
        "data-y": this.rectGrapicsItemSize.y,
    });
    let rectBorder = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(rectBorder, {
        class: "moodanimation chartmaskrect item" + (this.groupIndex + 1),
        "data-animation": "borderrect",
        id: "strokeitem-" + this.groupIndex + "_" + 0,
        x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y),
        width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight),
        "data-id": this.groupIndex + "_" + this.index,
        "stroke-width": "2px",
        "fill-opacity": "0",
    });
    if (this.groupIndex == 0) {
        this.data.SVGUtils.assignAttributes(rectBorder, {
            x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x + 2),
            y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y + 2),
            width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width - 2),
            height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight - 4),
        });
    } else {
        if (this.groupIndex == this.data.seriesLength - 1) {
            this.data.SVGUtils.assignAttributes(rectBorder, {
                x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x),
                width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width - 4),
            });
        }
        this.data.SVGUtils.assignAttributes(rectBorder, {
            y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y + 2),
            height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight - 4),
        });
    }
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    let maskId = Math.random() + this.data.slideID + "mask" + this.groupIndex;
    this.data.SVGUtils.assignAttributes(mask, { id: maskId, "data-maskelement": "true" });
    defsTag.appendChild(mask);
    mask.appendChild(rect);
    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgGroup, {
        id: "svgGroup-" + this.groupIndex + "_" + 0,
        mask: "url(#" + maskId + ")",
        "data-mask": "true",
        "data-graphicassetimage": "true",
        style: "-webkit-transform:" + "translate(0,0) scale(1,1)",
    });
    svgGroup.appendChild(imageTag);
    svgElement.appendChild(svgGroup);
    svgElement.appendChild(rectBorder);

    this.parent.appendChild(elementGroup);
};

BaseCurrencySeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment.show;
};

function BaseMovieclipColumnChart(argparent, argprops){
    this.name = "BaseMovieclipColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
}
BaseMovieclipColumnChart.prototype = Object.create(BaseColumnChart.prototype);
BaseMovieclipColumnChart.prototype.constructor = BaseMovieclipColumnChart;

function BaseMovieclipColumnSeries(argparent, argprops) {
    this.name = "BaseMovieclipColumnSeries";
    this.seriesWidthPercenge = 1;
    BaseColumnSeries.call(this, argparent, argprops);
}
BaseMovieclipColumnSeries.prototype = Object.create(BaseColumnSeries.prototype);
BaseMovieclipColumnSeries.prototype.constructor = BaseMovieclipColumnSeries;

BaseMovieclipColumnSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    element.className = "series accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    if (this.state.width > 500) {
        element.style.width = this.seriesWidthPercenge * this.state.width + "px";
        this.parent.style.display = "flex";
        this.parent.style.justifyContent = "center";
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    element.classList.add("th-section" + customColorIndex);

    if (this.data.chartName == "columnSimpleCoin") {
        if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
            element.classList.add("cs-chart-emphasis-image-disabled");
            element.dataset.emphasis = "false";
        }
        if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
            element.classList.add("cs-chart-emphasis-image-enabled");
            element.dataset.emphasis = "true";
        }
        if (this.data.projection[this.index] == true && this.data.hasProjection) {
            element.classList.add("cs-chart-projection-image-enabled");
            element.dataset.projection = "true";
        }
        if (this.data.projection[this.index] != true && this.data.hasProjection) {
            element.classList.add("cs-chart-projection-image-disabled");
            element.dataset.projection = "false";
        }
    } else {
        if (this.svgAsset) {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.classList.add("cs-chart-emphasis-svg-disabled");
                element.dataset.emphasis = "false";
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.classList.add("cs-chart-emphasis-svg-enabled");
                element.dataset.emphasis = "true";
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-svg-enabled");
                element.dataset.projection = "true";
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-svg-disabled");
                element.dataset.projection = "false";
            }
        } else if (this.data.grapicImage[this.index] == "true") {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.classList.add("cs-chart-emphasis-image-disabled");
                element.dataset.emphasis = "false";
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.classList.add("cs-chart-emphasis-image-enabled");
                element.dataset.emphasis = "true";
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-image-enabled");
                element.classList.add("projectionEnableGraphic");
                element.dataset.projection = "true";
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-image-disabled");
                element.classList.add("projectionDisabledGraphic");
                element.dataset.projection = "false";
            }
        } else {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.classList.add("cs-chart-emphasis-disabled");
                element.dataset.emphasis = "false";
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.classList.add("cs-chart-emphasis-enabled");
                element.dataset.emphasis = "true";
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-enabled");
                element.dataset.projection = "true";
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("cs-chart-projection-disabled");
                element.dataset.projection = "false";
            }
        }
    }
    // element.style.height = "auto";
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.data.secondaryLabel) {
        if (this.data.layout.secondarySamePosition) {
            this.doAddSecondaryLabelNode(sameElement, argprops, true);
            this.doAddSecondaryLabelNode(sameElement, argprops, false, true);
        } else {
            if (this.data.layout.secondaryPosition) {
                this.doAddSecondaryLabelNode(element, argprops, true);
                this.doAddSecondaryLabelNode(element, argprops, false);
            } else {
                this.doAddSecondaryLabelNode(element, argprops, true);
                this.doAddSecondaryLabelNode(element, argprops, false);
            }
        }
    }
    this.doAddLabel(element, argprops);

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond";
    subelement.style.width = this.widthPercentage * 100 + "%";
    subelement.setAttribute("data-width", this.state.width * this.widthPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addplaceholder: this.addplaceholder };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

function BaseMovieclipColumnSeriesItem(argparent, argprops) {
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
BaseMovieclipColumnSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
BaseMovieclipColumnSeriesItem.prototype.constructor = BaseMovieclipColumnSeriesItem;
BaseMovieclipColumnSeriesItem.prototype.createMicroChartSVG = function (microStyle, parentNode, argprops, assetSize) {
    if (parentNode.parentNode && this.data.layout.microChartGlopalStyle) {
        parentNode.parentNode.classList.add(this.data.layout.microChartGlopalStyle);
    }
    let innerHTML = "";
    parentNode.style.setProperty("--percentageValue", argprops.value + "%");
    parentNode.style.setProperty("--percentageData", argprops.value);
    let customColorIndex = this.ChartFonts.customColor(this.groupindex);
    parentNode.classList.add("th-section" + customColorIndex);
    switch (microStyle) {
        case "clssimpleMicroSimpleFill":
            parentNode.className = "clsMicroChartContent " + microStyle;
            parentNode.innerHTML = '<svg><rect class="clsMicroRect"  x=0 y=0   /> <rect class="clsCircleBG moodanimation" x=0 y=0   /> <rect  x=0 y=0 data-charttype="micro" data-animation="item"  class="clsMainCircle" />  </svg>';
            break;
        case "clsRatingMicro":
            parentNode.className = "clsMicroChartContent " + microStyle;
            innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"  viewBox="0 0 429 71" width="100%">';
            innerHTML += '<defs><clipPath id="clip-path-micro"><rect class="clsMicroRect" id="clsMicroRect" height="100%"/></clipPath></defs>';
            innerHTML +=
                '<path class="clsCircleBG moodanimation" id="clsCircleBG" data-animation="microcirclebg"  d="M14.5,71l2.4-7.2c2.1-6.5,4.2-12.9,6.4-19.4.1-.4.1-.7-.3-.9L1.2,27.9,0,27H29L37.9,0H38l1.4,4.1c2.4,7.4,4.8,14.8,7.3,22.3a.7.7,0,0,0,.8.6H75.9l-.7.5L53,43.4a.9.9,0,0,0-.4,1.1c2.9,8.6,5.7,17.2,8.5,25.8a6.4,6.4,0,0,1,.2.7l-1.1-.8L38.5,54.6a.8.8,0,0,0-1.1,0l-22.3,16Zm91-.4,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7c-2.8-8.6-5.6-17.2-8.5-25.8a.9.9,0,0,1,.4-1.1l22.3-15.9c.1-.2.3-.3.6-.5H137.9a.7.7,0,0,1-.8-.6c-2.4-7.5-4.9-14.9-7.3-22.3L128.4,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.2,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm88.4,0,22.3-16a.8.8,0,0,1,1.1,0L239,70.2l1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.3-1.1l22.3-15.9c.1-.2.3-.3.6-.5H226.3a.7.7,0,0,1-.8-.6c-2.4-7.5-4.9-14.9-7.3-22.3L216.8,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm89.4,0,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.4-1.1l22.2-15.9c.1-.2.3-.3.6-.5H315.7c-.4,0-.6-.2-.8-.6-2.4-7.5-4.9-14.9-7.3-22.3L306.2,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm85.4,0,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.3-1.1l22.3-15.9c.1-.2.3-.3.6-.5H401.1c-.5,0-.6-.2-.8-.6-2.4-7.5-4.9-14.9-7.3-22.3L391.6,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Z" fill="green" />';
            innerHTML +=
                '<g clip-path="url(#clip-path-micro)"><path  class="clsMainCircle"  data-charttype="micro" data-percentageValue="' +
                argprops.value +
                '" data-animation="item" id="clsMainCircle moodanimation" d="M14.5,71l2.4-7.2c2.1-6.5,4.2-12.9,6.4-19.4.1-.4.1-.7-.3-.9L1.2,27.9,0,27H29L37.9,0H38l1.4,4.1c2.4,7.4,4.8,14.8,7.3,22.3a.7.7,0,0,0,.8.6H75.9l-.7.5L53,43.4a.9.9,0,0,0-.4,1.1c2.9,8.6,5.7,17.2,8.5,25.8a6.4,6.4,0,0,1,.2.7l-1.1-.8L38.5,54.6a.8.8,0,0,0-1.1,0l-22.3,16Zm91-.4,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7c-2.8-8.6-5.6-17.2-8.5-25.8a.9.9,0,0,1,.4-1.1l22.3-15.9c.1-.2.3-.3.6-.5H137.9a.7.7,0,0,1-.8-.6c-2.4-7.5-4.9-14.9-7.3-22.3L128.4,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.2,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm88.4,0,22.3-16a.8.8,0,0,1,1.1,0L239,70.2l1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.3-1.1l22.3-15.9c.1-.2.3-.3.6-.5H226.3a.7.7,0,0,1-.8-.6c-2.4-7.5-4.9-14.9-7.3-22.3L216.8,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm89.4,0,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.4-1.1l22.2-15.9c.1-.2.3-.3.6-.5H315.7c-.4,0-.6-.2-.8-.6-2.4-7.5-4.9-14.9-7.3-22.3L306.2,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Zm85.4,0,22.3-16a.8.8,0,0,1,1.1,0l21.7,15.6,1.2.8-.3-.7-8.4-25.8a.8.8,0,0,1,.3-1.1l22.3-15.9c.1-.2.3-.3.6-.5H401.1c-.5,0-.6-.2-.8-.6-2.4-7.5-4.9-14.9-7.3-22.3L391.6,0h-.1l-8.9,27h-29l1.2.9,21.8,15.6c.4.2.4.5.3.9-2.1,6.5-4.3,12.9-6.4,19.4-.8,2.3-1.5,4.7-2.4,7.2Z" fill="red" /></g>';
            innerHTML += "</svg>";
            parentNode.innerHTML = innerHTML;
            break;
        case "clsGradientMicro":
            parentNode.className = "clsMicroChartContent " + microStyle;
            innerHTML = '<svg viewBox="0 0 36 36">';
            innerHTML +=
                '<defs><linearGradient id="gradmicro" x1="1" y1="1" x2="0"><stop offset=".12" stop-color="rgba(var(--gradient2-color-rgb),1)"/><stop offset=".83" stop-color="rgba(var(--gradient1-color-rgb),1)"/></linearGradient><clipPath id="clipMicro"><path class="clsMainCircleClip"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></clipPath> </defs>';
            innerHTML +=
                '<rect class="clsMicroRect"  fill="none" stroke="none" x=0 y=0 width="100%" height="100%" /><path class="clsCircleBG moodanimation" data-animation="itembackground"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831"  /> <path   data-charttype="micro" data-animation="item" data-percentageValue="' +
                argprops.value +
                '"class="clsMainCircle moodanimation"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /><path class="clsMainCircleDash"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></svg>';
            parentNode.innerHTML = innerHTML;
            break;
        case "clsgradientMicro":
            parentNode.className = "clsMicroChartContent " + microStyle;
            innerHTML = '<svg viewBox="0 0 36 36">';
            innerHTML +=
                '<defs><linearGradient id="gradmicro" x1="1" y1="1" x2="0"><stop offset=".12" stop-color="rgba(var(--gradient2-color-rgb),1)"/><stop offset=".83" stop-color="rgba(var(--gradient1-color-rgb),1)"/></linearGradient><clipPath id="clipMicro"><path class="clsMainCircleClip"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></clipPath> </defs>';
            innerHTML +=
                '<rect class="clsMicroRect"  fill="none" stroke="none" x=0 y=0 width="100%" height="100%" /><path class="clsCircleBG moodanimation" data-animation="itembackground" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831"  /> <path   data-charttype="micro" data-animation="item" data-percentageValue="' +
                argprops.value +
                '"class="clsMainCircle"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /><path class="clsMainCircleDash" data-charttype="micro" data-percentageValue="' +
                argprops.value +
                '"data-animation="item" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></svg>';
            parentNode.innerHTML = innerHTML;
            break;
        case "clsPieMicroChart":
            parentNode.className = microStyle;
            let value = argprops.value < 100 ? argprops.value : 100;
            this.radius = parseInt(assetSize / 2);
            this.totalDashArray = Math.PI * this.radius;
            this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
            parentNode.style.setProperty("--dasharray", this.totalDashArray);
            parentNode.style.setProperty("--transformData", "rotate(" + this.startAngle + "deg) translate(" + this.radius + "px," + this.radius + "px)");
            parentNode.style.setProperty("--dashoffset", this.valueDashArray);
            parentNode.style.setProperty("--strokewidth", this.radius);
            // innerHTML += '<defs><linearGradient spreadMethod="pad" id="gradmicro" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:var(--item1-color);stop-opacity:1;"></stop><stop offset="100%" style="stop-color:var(--item6-color);stop-opacity:1;"></stop></linearGradient><clipPath id="clipMicro"><path class="clsMainCircleClip"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></clipPath> </defs>';
            let baseSvg = this.data.SVGUtils.createSVGElement("svg");
            this.data.SVGUtils.assignAttributes(baseSvg, {
                width: "100%",
                height: "100%",
            });
            parentNode.appendChild(baseSvg);
            innerHTML += '<defs><linearGradient id="gradmicro" x1="1" y1="1" x2="0"><stop offset=".12" stop-color="rgba(var(--itemset4-color-rgb),1)"/><stop offset=".83" stop-color="rgba(var(--itemset1-color-rgb),1)"/></linearGradient> </defs>';
            baseSvg.innerHTML = innerHTML;
            let svgBgCircle = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(svgBgCircle, {
                id: "circle1",
                cx: "50%",
                cy: "50%",
                r: "50%",
                "data-animation": "itembackground",
                class: "clsCircleBG moodanimation",
            });
            baseSvg.appendChild(svgBgCircle);
            let svgCircle = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(svgCircle, {
                id: "circle1",
                cx: "50%",
                cy: "50%",
                r: "25%",
                "fill-opacity": "0",
                "stroke-opacity": "1",
                "data-animation": "item",
                "data-microchart": "true",
                class: "path_to moodanimation clsMainCircle ",
                "data-totaldasharray": this.totalDashArray,
                "data-valuedasharray": this.valueDashArray,
                "data-startangle": this.startAngle,
                "data-outerradius": this.radius,
                "data-innerradius": this.innerRadius,
            });
            baseSvg.appendChild(svgCircle);
            // svgCircle.style.transform = "rotate(" + this.startAngle + "deg) translate(" + this.radius + "px," + this.radius + "px)";
            // svgCircle.style.strokeDashoffset = this.valueDashArray;
            // svgCircle.style.strokeDasharray = this.totalDashArray;
            // svgCircle.style.strokeWidth = this.radius;
            svgCircle.style.transformOrigin = "bottom";
            break;
        case "clsPieMicroDiagram":
            parentNode.className = "clsMicroChartContent " + microStyle;
            innerHTML = '<svg viewBox="0 0 32 32" height="100%">';
            //innerHTML += '<circle  class="clsCircleBG moodanimation" id="clsCircleBG" data-animation="microcirclebg"  r="50%" cx="50%" cy="50%" "></circle>';
            innerHTML += '<circle class="clsCircleBG moodanimation" id="clsCircleBG" data-animation="microcirclebg"    r="16" cx="16" cy="16" fill="transparent" stroke="#0000FF" stroke-width="32" stroke-dasharray="100 100" />';
            innerHTML += '<circle class="clsMainCircle" data-charttype="micro" data-animation="item" data-percentageValue="' + argprops.value + '"  id="clsMainCircle" r="16" cx="16" cy="16" fill="transparent" stroke="#FF0000" stroke-width="32" stroke-dasharray="40 100" />';
            //innerHTML += '<circle  fill-opacity= "0" stroke-opacity= "1" class="clsMainCircle"  id="clsMainCircle" r="9px" cx="18px" cy="18px" class="clsMainCircle"> </circle>';
            innerHTML += "</svg>";
            parentNode.innerHTML = innerHTML;
            break;
        default:
            parentNode.className = microStyle;
            innerHTML = '<svg viewBox="0 0 36 36">';
            innerHTML += '<defs><clipPath id="clipMicro"><path class="clsMainCircleClip"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></clipPath> </defs>';
            innerHTML +=
                '<rect class="clsMicroRect"  fill="none" stroke="none" x=0 y=0 width="100%" height="100%" /><path class="clsCircleBG moodanimation"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831"  /> <path   class="clsMainCircle moodanimation" data-charttype="micro" data-percentageValue="' +
                argprops.value +
                '"data-animation="item" data-doughnutmicro="true" data-endangle =' +
                argprops.value +
                ' d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /><path class="clsMainCircleDash"  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831  a 15.9155 15.9155 0 0 1 0 -31.831" /></svg>';
            parentNode.innerHTML = innerHTML;
            break;
    }
};

function BasePieChart(argParent, argProps) {
    this.maxAngle = 360;
    this.minSeriesSize = 300;
    this.widthPercentage = 1;
    this.maxGraphicSize = 600;
    this.name = "BasePieChart";
    this.minValueFontSize = [25, 25];
    this.ChartFonts = new window["ChartFonts"]();
    this.maxValueFontSize = this.ChartFonts.maxValueFontSize;
    this.placeholderStyle = this.ChartFonts.valueOuterColor;
    BaseChart.call(this, argParent, argProps);
}
BasePieChart.prototype = Object.create(BaseChart.prototype);
BasePieChart.prototype.constructor = BasePieChart;

BasePieChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BasePieSeries"](argParent, argProps);
};

BasePieChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            if (this.data.conflictLayout || !this.data.layout.hadconnector) this.doAddLegendDesk();
            this.doAddGraphicDesk();
            if (!this.data.baseProperties.legend) {
                this.doAddLayoutContainer();
            }
            this.doAddMetaData();
            this.createTooltipCallout(this.parent, this.data);
        }
    }
};

BasePieChart.prototype.updateBasicData = function () {
    this.length = this.data.seriesLength;
    this.parent.style.display = "flex";
    this.parent.style.gridTemplateRows = "";
    this.parent.style.gridTemplateColumns = "";
    this.parent.style.alignItems = " center";
    this.parent.style.justifyContent = " center";
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : [22, 22];
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.4 - 8;
    this.labeMaxH = this.checkMaxLabelLineHeight(this.parent, this.labeMaxH);

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage * 0.9;
    this.valueMaxH = this.state.height * 0.4; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });
};

BasePieChart.prototype.doMeasurementComputation = function () {
    let rectSize = 0;
    this.rectBaseLegend = { x: 0, y: 0, width: 0, height: 0 };
    if (this.voData.chartName == "halfPieChart" || this.voData.chartName == "gaugechart") this.maxGraphicSize = 760;
    if (this.data.layout.itemthickness) {
        rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize, this.data.layout.itemthickness);
    } else {
        rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize);
    }
    this.rectBaseSeries = { x: (this.viewport.width - rectSize) / 2, y: (this.viewport.height - rectSize) / 2, width: rectSize, height: rectSize };

    if (this.data.baseProperties.legend && !this.data.layout.hadconnector) {
        const legendMaxSize = 380;
        this.legendposition = this.voData.legendposition == "" ? "right" : this.voData.legendposition;
        if (this.legendposition == "top") {
            this.parent.style.flexDirection = "column";
            rectSize = this.viewport.height - legendMaxSize - 72;
            this.rectBaseSeries = { x: 0, y: 0, width: rectSize, height: rectSize };
            if (this.voData.chartName == "halfPieChart" || this.voData.chartName == "gaugechart") {
                this.rectBaseSeries = { x: 0, y: 0, width: this.viewport.width, height: rectSize };
            }
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width, height: legendMaxSize };
        } else if (this.legendposition == "bottom") {
            this.parent.style.flexDirection = "column-reverse";
            rectSize = this.viewport.height - legendMaxSize;
            if (this.data.layout.itemthickness) {
                rectSize = Math.min(this.viewport.width, this.viewport.height - legendMaxSize, this.maxGraphicSize, this.data.layout.itemthickness);
            } else {
                rectSize = Math.min(this.viewport.width, this.viewport.height - legendMaxSize, this.maxGraphicSize);
            }
            this.rectBaseSeries = { x: 0, y: 0, width: rectSize, height: rectSize };
            if (this.voData.chartName == "halfPieChart" || this.voData.chartName == "gaugechart") {
                this.rectBaseSeries = { x: 0, y: 0, width: this.viewport.width, height: rectSize };
            }
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width, height: legendMaxSize };
        } else if (this.legendposition == "left") {
            this.parent.style.flexDirection = "row";
            if (this.data.layout.itemthickness) {
                rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize, this.data.layout.itemthickness);
            } else {
                rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize);
            }
            rectSize = this.viewport.width * 0.5 < rectSize ? this.viewport.width * 0.5 : rectSize;
            this.rectBaseSeries = {
                x: (this.viewport.width - rectSize) / 2,
                y: (this.viewport.height - rectSize) / 2,
                width: rectSize,
                height: rectSize,
            };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width - rectSize - 72, height: this.viewport.height };
        } else if (this.legendposition == "right") {
            this.parent.style.flexDirection = "row-reverse";
            if (this.data.layout.itemthickness) {
                rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize, this.data.layout.itemthickness);
            } else {
                rectSize = Math.min(this.viewport.width, this.viewport.height, this.maxGraphicSize);
            }
            rectSize = this.viewport.width * 0.5 < rectSize ? this.viewport.width * 0.5 : rectSize;
            this.rectBaseSeries = {
                x: (this.viewport.width - rectSize) / 2,
                y: (this.viewport.height - rectSize) / 2,
                width: rectSize,
                height: rectSize,
            };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width - rectSize, height: this.viewport.height };
        }
    } else {
        if (this.data.layout.hadconnector) {
            rectSize = this.viewport.width * 0.35 < rectSize ? this.viewport.width * 0.35 : rectSize;
            this.rectBaseSeries = {
                x: (this.viewport.width - rectSize) / 2,
                y: (this.viewport.height - rectSize) / 2,
                width: rectSize,
                height: rectSize,
            };
        }
    }
};

// doAddMetaData(argProps) {
//     const element = this.data.SVGUtils.createSVGElement("metadata");
//     return element;
// }

BasePieChart.prototype.doAddGraphicDesk = function () {
    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    element.style.position = "relative";
    element.style.display = "flex";
    element.style.alignItems = "center";
    element.style.justifyContent = "center";
    element.style.width = this.rectBaseSeries.width + "px";
    element.style.minWidth = this.rectBaseSeries.width + "px";
    element.style.height = this.rectBaseSeries.height + "px";
    this.parent.appendChild(element);
    this.doAddGraphicElement(element);
};

BasePieChart.prototype.doAddGraphicElement = function (argparent) {
    let intStartAngle = 270;
    let intEndAngle = intStartAngle;
    for (let i1 = 0; i1 < this.length; i1++) {
        let dummeyTotalValue = this.data.totalValue;
        if (this.data.totalValue == 0 && i1 == 0) {
            this.data.values[i1][0] = 1;
            dummeyTotalValue = 1;
        }

        let intAngle = this.data.baseProperties.maxAllowedSeries == 1 ? (this.maxAngle / 100) * parseFloat(this.data.values[i1][0]) : (this.maxAngle / dummeyTotalValue) * parseFloat(this.data.values[i1][0]);
        // let intMidAngle = intStartAngle + (intEndAngle - intStartAngle) / 2;
        let intPaddingStartAngle = (intEndAngle * Math.PI) / 180;
        let intPaddingeEndAngles = ((intEndAngle + intAngle) * Math.PI) / 180;
        let intMidAngle = intPaddingStartAngle + (intPaddingeEndAngles - intPaddingStartAngle) / 2;
        let pntCenterPointPad = this.distanceMeasurement(intMidAngle, 5);
        intEndAngle += intAngle;
        let eProps = {
            index: i1,
            angle: intAngle,
            midangle: intMidAngle,
            endangle: intEndAngle,
            startangle: intStartAngle,
            centerPointPad: pntCenterPointPad,
            viewportGroup: { x: 0, y: 0, width: this.state.width, height: this.state.height },
        };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(0, 0);
        series.size(this.rectBaseSeries.width, this.rectBaseSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        intStartAngle = intEndAngle;
    }
};

BasePieChart.prototype.distanceMeasurement = function (midAngle, distance) {
    let pntX = distance * Math.cos(midAngle);
    let pntY = distance * Math.sin(midAngle);
    let pntDistance = { x: pntX, y: pntY };
    return pntDistance;
};

BasePieChart.prototype.doAddLegendDesk = function (argparent, argProps) {
    const element = this.ChartHelper.createDivElement();
    element.className = "legend";
    element.style.maxWidth = this.rectBaseLegend.width + "px";
    element.style.maxHeight = this.rectBaseLegend.height + "px";
    this.parent.appendChild(element);
    let eProps = { maxsize: this.rectBaseLegend };
    if (this.data.layout.enableBackground && this.data.layout.backgroundType == "full") {
        element.style.width = this.rectBaseLegend.width + "px";
    }
    if (this.data.layout.legendWidth && (this.legendposition == "left" || this.legendposition == "right")) {
        element.style.maxWidth = this.data.layout.legendWidth;
        element.style.width = this.data.layout.legendWidth;
    }
    this.addLegendDeskElements(element, eProps);
};

BasePieChart.prototype.doAddLayoutContainer = function () {
    this.parent.style.flexDirection = "row-reverse";
    this.parent.style.setProperty("--node-icon-opacity", "0.5");
    for (let i1 = 0; i1 < this.length; i1++) {
        const element = this.ChartHelper.createDivElement();
        let customColorIndex = this.ChartFonts.customColor(i1);
        const vLayoutName = this.labellayoutClassName("container");
        element.className = "sameelement piecompareseries layoutConnector " + vLayoutName + " accent" + customColorIndex + " clsMultiColorParent";
        element.style.flexDirection = "column";
        element.style.height = "100%";
        element.style.position = "unset";
        element.style.width = ((this.state.width - this.rectBaseSeries.width) / 2) * 0.65 + "px";
        element.classList.add("th-section" + customColorIndex);

        this.valueMaxW = ((this.state.width - this.rectBaseSeries.width) / 2) * 0.65;
        this.labelMaxW = ((this.state.width - this.rectBaseSeries.width) / 2) * 0.65;
        let baseSeries = this.parent.querySelector("#base-series");
        if (i1 == 0) {
            this.parent.insertBefore(element, baseSeries);
        } else {
            this.parent.appendChild(element);
        }
        this.groupindex = i1;
        this.index = 0;
        // if(this.data.boolPercentageChart)
        // {
        //     this.data.valuesDenomination[i1][0] = parseFloat(this.data.values[i1][0])
        // }
        let eProps = {
            index: 0,
            gindex: i1,
            valuetext: this.data.prefix[i1][0] + this.data.valuesDenomination[i1][0] + this.data.suffix[i1][0],
        };
        this.doAddTopValue(element, eProps, false);
        this.doAddLabel(element, eProps, false);
        this.placeholderStyle = this.ChartFonts.graphicFillColor(i1);
        this.doAddTopPlaceholder(element, eProps, false);
    }
};

BasePieChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    if (this.data.baseProperties.legend) {
        let legend = new window["Legend"](argParent, argProps);
        legend.move(0, 0);
        legend.ChartHelper = this.ChartHelper;
        legend.ChartUtils = this.ChartUtils;
        legend.size(this.rectBaseLegend.width, this.rectBaseLegend.height);
        legend.data = this.data;
    }
    return null;
};
BasePieChart.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    let valuesMaxWidth = this.valueMaxW - (padding["left"] + padding["right"]);
    element.style.maxWidth = valuesMaxWidth + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }

    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.boolDisableWidth) {
        element.style.width = "";
    } else {
        element.style.width = valuesMaxWidth + "px";
    }

    this.valueStyle = this.getColorDetails(groupindex, this.valueStyle, this.data.layout.valueColor, "color");

    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    let hasInnerValue = this.data.layout.valueInset == "inside";

    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " n1";
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = valuesMaxWidth + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[1] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[1]);
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement, argprops.gindex);
    }
    if (boolenablePer) {
        subelement.innerText = parseFloat(argprops.valuetext) + "%";
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
    }

    subelement.dataset.animation = "secondarytext";
    if (this.data.chartName == "columnStackedRectangle") {
        subelement.dataset.animation = "secondarytext" + (index + 1);
        subelement.dataset.stackedmultiseries = "true";
    }
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    if (this.data.layout.valuebgBorder || this.data.layout.valuebgBorder == "true") {
        const borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "moodanimation valueborder" + this.ChartFonts.graphicBgColor(groupindex);
        borderElement.dataset.animation = "borderelement";
        element.appendChild(borderElement);
        subelement.classList.add("background-bg-color");
        subelement.style.zIndex = 1;
    }
    element.appendChild(subelement);
    if (this.maxValueFontSize[0] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[0] = maxFontSize;
    }
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }

    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.remove(this.ChartFonts.appendgraphicColor(groupindex));
        subelement.classList.add("clsTextSecondaryColor");
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[1]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[1]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        argparent.removeChild(element);
    }
    if (!boolmax) {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        subelement.style.overflow = "hidden";
    }
};
BasePieChart.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    return this.ChartFonts.appendgraphicColor(PropertyIndex); //"accent" + (PropertyIndex + 1) + "-color";
                    break;
                case "bgcolor":
                    return this.data.chartFonts.appendgraphicBgColor(groupindex);
                    break;
            }
        }
    }
};
BasePieChart.prototype.doAddLabel = function (argparent, argprops, boolMax = false, boolLonLabel = true, boolMinHeight = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "minheightvalue label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        element.id = "label-text-" + this.groupindex;
        element.style.minHeight = 10 + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.style.display = "flex";
        element.style.justifyContent = "flex-start";
        element.style.boxSizing = "unset";
        element.style.overflow = "hidden";
        element.style.fontSize = this.maxLabelFontSize[this.groupindex] + "px";
        if (this.data.arrLabelTextSize[this.groupindex]) element.style.fontSize = this.data.arrLabelTextSize[this.groupindex];
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if (this.groupindex == 0) {
            element.style.paddingLeft = padding["right"] + "px";
            element.style.paddingRight = padding["left"] + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        if (this.boolDisableWidth) {
            element.style.width = "";
        } else {
            element.style.width = this.labelMaxW + "px";
        }

        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        let labelColor = this.getColorDetails(this.groupindex, this.labelStyle, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;

        if (this.data.layout.labelColor == "item") {
            this.labelStyle = this.ChartFonts.appendgraphicColor(this.groupindex); // "accent" + (this.groupindex + 1) + "-color";
        }
        if (this.labelAlignment.position == "inner") {
            element.classList.add("minlabelheight");
        }
        this.labelMaxW = this.labelMaxW - (padding["left"] + padding["right"]);
        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupindex;
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");
        subelement.innerHTML = boolMax && boolLonLabel ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.style.overflow = "hidden";
        if (this.data._labelTextColor[this.groupindex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupindex], "important");
        }
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.groupindex);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.groupindex, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
            // let rgbColor = window.getComputedStyle(subelement)["color"];
            // let rgbaColor = rgbColor.replace(")", ", 0.2)").replace("rgb", "rgba");
            // subelement.style.background = rgbaColor;
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        this.calculateMaxFonsize(subelement, boolMax, this.maxValueFontSize[this.arrIndex]);
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            argparent.removeChild(element);
        }
    }
};
BasePieChart.prototype.valuelayoutClassName = function (itemname, boolBottom = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    }
    return vLayoutName;
};
BasePieChart.prototype.labellayoutClassName = function (itemname, boolBottom = false) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        if (boolBottom) {
            if (this.labelAlignment.vposition == "bottom") lLayoutName = lLayoutName + this.labelAlignment.hposition + "top";
            else if (this.labelAlignment.vposition == "top") lLayoutName = lLayoutName + this.labelAlignment.hposition + "bottom";
            else lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
        } else {
            lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
        }
    }
    return lLayoutName;
};
BasePieChart.prototype.setoverlapPadding = function (name) {
    let hposition;
    let vPosition;
    let area = { left: 0, right: 0, top: 0, bottom: 0 };
    if (name == "label") {
        area = { left: this.data.layout.labelPaddingleft, right: this.data.layout.labelPaddingright, top: this.data.layout.labelPaddingtop, bottom: this.data.layout.labelPaddingbottom };
        if (this.labelAlignment && this.labelAlignment.overlap == "value") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.labelPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.labelPaddingright;
            return area;
        } else if (this.labelAlignment ** this.labelAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = (this.middlePH + this.data.layout.labelPaddingbottom) * 0.5;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.labelPaddingright;
            return area;
        }
    } else if (name == "value") {
        area = { left: this.data.layout.valuePaddingleft, right: this.data.layout.valuePaddingright, top: this.data.layout.valuePaddingtop, bottom: this.data.layout.valuePaddingbottom };
        if (this.valueAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleLH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.valuePaddingright;
            return area;
        } else if (this.valueAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middlePH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.valuePaddingright;
            return area;
        }
    } else if (name == "placeholder") {
        area = {
            left: this.data.layout.placeholderPaddingleft,
            right: this.data.layout.placeholderPaddingright,
            top: this.data.layout.placeholderPaddingtop,
            bottom: this.data.layout.placeholderPaddingbottom,
        };
        if (this.placeholderAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = middleValueH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.placeholderPaddingright;
            return area;
        } else if (this.placeholderAlignment.overlap == "placeholder") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.placeholderPaddingright;
            return area;
        }
    }
    return area;
};
BasePieChart.prototype.doAddTopPlaceholder = function (argparent, argprops, customSize = false) {
    const index = this.index;
    let placeholdertype = this.data.primaryPlaceholderType[this.groupindex];
    const type = String(placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    let bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    bounds.height = type != "image" && bounds.height < 80 ? 80 : bounds.height;
    if (customSize) {
        bounds.width = 70;
        bounds.height = 70;
    }
    let padding = this.setoverlapPadding("placeholder");
    const pLayoutName = this.placeholderlayoutClassName("placeholder");
    const element = this.ChartHelper.createDivElement({});
    element.id = "primary-placeholder-" + this.groupindex;
    element.className = "primaryplaceholder topprimaryplaceholder moodanimation " + pLayoutName;
    element.setAttribute("data-animation", "primaryplaceholder");
    element.style.width = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.width + "px";
    element.style.height = 96 + "px";
    element.style.position = "unset";
    element.style.order = this.placeholderAlignment.index;
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    // if (this.graphicElement.alterpos == "true") {

    // }

    switch (type) {
        case "icon":
            this.doAddIconUseNodeElement(element, argprops);
            break;
        case "image":
            this.doAddImageUseNodeElement(element, argprops);
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }

    if (argparent) argparent.appendChild(element);
    else return element;
};

BasePieChart.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond ci-element-icon " + this.placeholderStyle,
        id: "placeholder-" + this.groupindex + "_" + this.index,
        width: "100%",
        height: "100%",
        style: "width:100%;",
    });
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.groupindex + "_" + this.index,
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "xlink:href": "#" + this.data.itemPlacehoders[this.groupindex],
        "data-iconpath": this.data.itemPlacehodersPath[this.groupindex],
        "data-type": this.data.primaryPlaceholderType[this.groupindex],
        "data-placeholderelement": "icon,image",
        "data-id": this.groupindex + "_" + this.index,
        "data-type": "ICON",
    });
    element.appendChild(subelement);
    argparent.appendChild(element);
};

BasePieChart.prototype.doAddImageUseNodeElement = function (argparent, argprops) {
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.borderRadius = "50%";
    subelement.src = this.data.primaryPlaceholderPath[this.groupindex];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.groupindex + "_0";
    subelement.className = "primaryplaceholdergraphic";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.groupindex + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    argparent.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(argparent, "", true, false);
    argparent.setAttribute("data-x", item.x);
    argparent.setAttribute("data-y", item.y);
    argparent.setAttribute("data-width", argparent.clientWidth);
    argparent.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-width", argparent.clientWidth);
    subelement.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[this.groupindex]);

    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);

    this.ChartUtils.updateImageReSize(argparent.clientWidth, argparent.clientHeight, subelement, "", "img");
};
BasePieChart.prototype.placeholderlayoutClassName = function (itemname, boolBottom = false) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.placeholderAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        if (boolBottom) {
            if (this.placeholderAlignment.vposition == "bottom") lLayoutName = lLayoutName + this.placeholderAlignment.hposition + "top";
            else if (this.placeholderAlignment.vposition == "top") lLayoutName = lLayoutName + this.placeholderAlignment.hposition + "bottom";
            else lLayoutName = lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
        } else {
            lLayoutName = lLayoutName + this.placeholderAlignment.hposition + this.placeholderAlignment.vposition;
        }
    }
    return lLayoutName;
};
BasePieChart.prototype.getPlaceholderBounds = function (props) {
    if (this.data.primaryPlaceholder) {
        return { width: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.3, height: this.state.width * this.gapPercentage * this.thicknessPercentage * 0.3 };
    } else {
        return { width: this.state.width, height: 0 };
    }
};
BasePieChart.prototype.valuebgProperties = function (element, groupindex) {
    if (this.data.layout.valuebgShapeType == "circle") {
        element.style.borderRadius = "50%";
    }
    if (this.data.layout.valuebgShapeType == "square") {
        element.style.borderRadius = "0";
    }
    if (this.data.layout.valuebgStyle == "border") {
        if (this.data.layout.valuebgBorderSize) {
            element.style.border = this.data.layout.valuebgBorderSize + "px solid";
        } else {
            element.style.border = "2px solid";
        }
        let strBordeClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.data.layout.valuebgBorderColor, "bordercolor");
        if (this.data.layout.valuebgBorderColor == "gradient") {
            if (
                (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("secondary-border-color");
            } else {
                element.classList.add("bordergradient");
            }
        } else {
            if (
                (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("secondary-border-color");
            } else {
                element.classList.add(strBordeClass);
            }
        }
    }
    if (this.data.layout.valuebgBgColor) {
        let strBgClass = this.getBgColorDetails(groupindex, "clsNodeSecondarybg", this.data.layout.valuebgBgColor, "bgcolor");
        if (
            (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
            (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
        ) {
            element.classList.add("clsNodeSecondarybg");
        } else {
            if (this.data.layout.valuebgOpacity) {
                let rgbavalue = this.ChartUtils.createRBGColor(strBgClass, groupindex, this.data.layout.valuebgOpacity);
                element.style.background = rgbavalue;
            } else {
                element.classList.add(strBgClass);
            }
        }
    }
    if (this.data.layout.valuebgRadius) {
        let borderRadiuslefttop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 0 ? this.data.layout.valuebgRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 1 ? this.data.layout.valuebgRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 2 ? this.data.layout.valuebgRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 3 ? this.data.layout.valuebgRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
};
BasePieChart.prototype.getBgColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "bgcolor":
            if (fillProperty == "bordercolor") {
                return "bgborderColor";
            } else {
                return "itembgColor";
            }
            break;
        case "alternatebg":
            if (fillProperty == "bordercolor") {
                return "ci-alternatebg-primary-border-color";
            } else if (fillProperty == "color") {
                return "clsTextalternatebgColor";
            } else {
                return "clsNodealternatebgbg";
            }
            break;
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                return "clsNodeSecondarybg";
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "cf-background-color-section-primary";
                    }
                    if (this.data.multicolor) {
                        return "cf-background-color-section-primary";
                    } else {
                        return "cf-background-color-section-primary";
                        // return "accent1-bg-color";
                    }
                    break;
                case "bordercolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsBorderAccent";
                    }
                    if (this.data.multicolor) {
                        return "clsBorderAccent";
                    } else {
                        return "clsBorderAccent";
                        // return "accent1-border-color";
                    }
                    break;
            }
        }
    }
};

function BasePieSeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
    this.maxAngle = 360;
    this.name = "BaseSeries";
    BaseSeries.call(this, argparent, argprops);
    if (argprops.viewportGroup) {
        this.viewportGroup = argprops.viewportGroup;
    }
    this.chartGrapicsArea = 0;
}
BasePieSeries.prototype = Object.create(BaseSeries.prototype);
BasePieSeries.prototype.constructor = BasePieSeries;

BasePieSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["BasePieSeriesItem"](argparent, argprops);
};

BasePieSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
        this.createCommonPlaceHolder();
        if (this.data.layout.hadconnector) this.applyLayout();
    }
};

BasePieSeries.prototype.updateBasicData = function () {
    let _oWidth = 0;
    this.length = this.voData.seriesItemLength;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        alterpos: this.data.layout.placeholderalterpos,
    });
};

BasePieSeries.prototype.doMeasurementComputation = function (argprops) {};

BasePieSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.layout.hadconnector) this.applyLayout(true);
    let element = document.createElement("g");
    element.id = "series-" + this.index;
    // element.dataset.animation = "nodeitem";
    element.dataset.index = this.index;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    element.className = "accent" + customColorIndex + " clsMultiColorParent";
    this.data.SVGUtils.assignAttributes(element, {
        style: "position:absolute;top:0;bottom:0;",
        class: "series accent" + customColorIndex + " clsMultiColorParent",
    });
    element.classList.add("th-section" + customColorIndex);

    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    element.classList.add("th-section" + customColorIndex);

    let eProps = {
        index: 0,
        groupindex: this.index,
        angle: this.props.angle,
        endangle: this.props.endangle,
        midangle: this.props.midangle,
        startangle: this.props.startangle,
        centerPointPad: this.props.centerPointPad,
    };
    this.endAngle = this.props.endangle;
    this.startAngle = this.props.startangle;
    if (this.parent) this.parent.appendChild(element);
    let seriesitem = this.seriesItemInstance(element, eProps);
    seriesitem.ChartHelper = this.ChartHelper;
    seriesitem.ChartUtils = this.ChartUtils;
    seriesitem.move(0, 0);
    seriesitem.size(this.state.width, this.state.height);
    seriesitem.data = this.data;
    this.chartGrapicsAreaSize = this.state.width;
};
BasePieSeries.prototype.createCommonPlaceHolder = function (argprops) {
    if (this.voData.customProperties.innerRadius != 0 && this.voData.commonplacholderType && this.index == this.data.seriesLength - 1 && this.voData.chartName != "halfPieChart" && this.voData.chartName != "pieSemiDoughnutStandard") {
        const type = this.voData.commonplacholderType;
        const percentage = type == "image" ? 1 : 0.8;
        let bounds = { width: 70, height: 70 };
        this.outerRadius = this.state.height * 0.7;
        this.innerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt(this.outerRadius * (this.voData.customProperties.innerRadius * 0.01));

        let pathNode = this.parent.querySelector(".path_to");
        if (pathNode && pathNode.getAttribute("data-innerradius")) {
            this.innerRadius = parseFloat(pathNode.getAttribute("data-innerradius"));
        }
        const element = this.ChartHelper.createDivElement({});
        element.id = "commonPlaceholder-" + this.index;
        element.className = "primaryplaceholder topprimaryplaceholder moodanimation ";
        element.setAttribute("data-animation", "commonplaceholder");
        element.style.width = this.innerRadius + "px";
        element.style.height = this.innerRadius + "px";
        if (type == "logo") {
            element.style.width = this.innerRadius + "px";
            element.style.height = this.innerRadius * 0.61 + "px";
        }
        if (type == "icon") {
            element.style.width = this.innerRadius * 0.8 + "px";
            element.style.height = this.innerRadius * 0.8 + "px";
        }
        this.placeholderStyle = this.ChartFonts.graphicFillColor(this.index);
        if (this.parent) this.parent.appendChild(element);
        else return element;

        // let bgElement = this.ChartHelper.createDivElement({});
        // bgElement.classList.add("shapeBgElement");
        // bgElement.classList.add("contentBackground");
        // bgElement.setAttribute("data-nodetype", "contentBackground");
        // bgElement.style.zIndex = "0";
        // element.appendChild(bgElement);

        switch (type) {
            case "icon":
                element.classList.add("iconHolder");
                element.setAttribute("data-nodetype", "iconHolder");
                this.doAddIconUseNodeElement(element);
                break;
            case "image":
                element.classList.add("imageHolder");
                element.setAttribute("data-nodetype", "imageHolder");
                this.doAddImageUseNodeElement(element);
                break;
            case "logo":
                this.doAddLogoUseNodeElement(element, "", "logo");
                // this.doAddImageUseNodeElement(element,"","logo");
                break;
            case "text":
                this.doAddTextUseNodeElement(element);
                break;
        }
    } else {
        return null;
    }
};
BasePieSeries.prototype.doAddTextUseNodeElement = function (element) {
    let placeHolderText = document.createElement("div");
    element.appendChild(placeHolderText);
    placeHolderText.className = this.ChartFonts.placeholderText;
    placeHolderText.id = "placeholdertext";
    placeHolderText.classList.add("clsTextSecondaryColor");
    placeHolderText.classList.add("commonplaceholdertext");
    placeHolderText.classList.add("placeholdertext");
    this.ChartHelper.setTextChangeListner(placeHolderText);
    placeHolderText.setAttribute("contenteditable", "true");
    placeHolderText.setAttribute("data-dck-selector", "true");
    placeHolderText.setAttribute("data-type", "placeholdertext");
    placeHolderText.setAttribute("data-slideid", this.data.slideID);
    placeHolderText.setAttribute("data-id", this.index);
    placeHolderText.setAttribute("data-prompt-text", "Enter Label");
    placeHolderText.style.width = element.clientWidth + "px";
    placeHolderText.style.height = element.clientHeight + "px";
    placeHolderText.style.overflow = "hidden";
    placeHolderText.style.maxHeight = element.clientHeight + "px";
    placeHolderText.style.outline = "none";
    placeHolderText.innerHTML = this.voData.commonplacholdertext;
    this.ChartHelper.adjustFontSize(placeHolderText, 10, 17, this.ChartFonts.maxLabelFontSize(placeHolderText));
    this.checkAlignment(placeHolderText);

    let lineHeight = window.getComputedStyle(placeHolderText)["line-height"] ? parseFloat(window.getComputedStyle(placeHolderText)["line-height"]) : 0;
    let paddingTop = window.getComputedStyle(placeHolderText)["padding-top"] ? parseFloat(window.getComputedStyle(placeHolderText)["padding-top"]) : 0;
    let paddingBottom = window.getComputedStyle(placeHolderText)["padding-bottom"] ? parseFloat(window.getComputedStyle(placeHolderText)["padding-bottom"]) : 0;
    let totalHeight = lineHeight * 3 + paddingTop + paddingBottom;
    if (totalHeight < placeHolderText.clientHeight) {
        placeHolderText.style.height = totalHeight + "px";
    }
    placeHolderText.style.maxHeight = totalHeight + "px";
};
BasePieSeries.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment ? this.placeholderAlignment.show : false;
};
BasePieSeries.prototype.checkAlignment = function (placeholderText) {
    placeholderText.classList.add("removeheight");
    let placeHolderTextHeight = placeholderText.clientHeight;
    let placeholderParentHeight = placeholderText.parentNode.clientHeight;
    placeholderText.classList.remove("removeheight");
    if (placeHolderTextHeight > placeholderParentHeight) {
        placeholderText.style.alignItems = "flex-start";
    }
};
BasePieSeries.prototype.doAddIconUseNodeElement = function (argparent) {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: this.placeholderStyle + " iconNode clsMoodIconStyle iconNode clsMoodIconStyle th-section1",
        "data-nodetype": "iconNode",
        id: "commonPlaceholder-" + 0 + "_" + this.index,
        width: "100%",
        height: "100%",
    });
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        id: "commonPlaceholder-" + 0 + "_" + this.index,
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "xlink:href": "#" + this.data.commonplacholderid,
        "data-placeholderelement": "icon,image",
        "data-id": 0 + "_" + this.index,
        "data-type": "ICON",
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    this.data.SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};
BasePieSeries.prototype.doAddImageUseNodeElement = function (element, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);

    element.style.borderRadius = "50%";
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.src = this.data.commonplacholderid;
    subelement.style.position = "unset";
    subelement.id = "commonPlaceholder-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode clsMoodImageStyle";
    subelement.setAttribute("data-nodetype", "imageNode");
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.commonplacholderid);

    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type);

    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
};
BasePieSeries.prototype.doAddLogoUseNodeElement = function (element, argprops, type = "logo") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);
    // element.style.borderRadius = "50%";
    let alignment = "center";
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.position = "unset";
    subelement.id = "commonPlaceholder-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode clsMoodImageStyle th-section1";
    subelement.setAttribute("data-nodetype", "imageNode");
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-imagecropalignment", alignment);
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    element.appendChild(subelement);
    let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-imagepath", this.data.commonplacholderid);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    CommonImageUtils.updateImageBounds(subelement, "logo");
    subelement.src = this.data.commonplacholderid;
    // this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type)
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
};
BasePieSeries.prototype.applyLayout = function (measurement = false) {
    this.viewportGroup.width = this.parent.parentNode.clientWidth;
    this.viewportGroup.height = this.parent.parentNode.clientHeight;
    let intMinsize = this.viewportGroup.width > this.viewportGroup.height ? this.viewportGroup.height : this.viewportGroup.width;
    this.outerRadius = this.state.height * 0.5;
    this.extraData = 0;
    if (this.data.chartName == "realObjectPieChart") {
        this.outerRadius = this.outerRadius * 0.85;
    }
    if (this.data.layout.enableBackground && this.data.layout.backgroundType == "full") {
        if (this.data.layout.backgroundPieRadius) {
            let currentRadius = 1 - parseFloat(this.data.layout.backgroundPieRadius);
            this.outerRadius = this.outerRadius * currentRadius;
        }
    }
    if (this.data.extraNeativeValue < 0 && !measurement) {
        this.outerRadius = this.outerRadius * 0.6;
    }
    if (false) {
        let objLayoutManager = {
            groupIndex: this.index,
            maxAngle: 360,
            radius: this.outerRadius,
            endAngle: this.endAngle,
            startAngle: this.startAngle,
            graphicsAreaSize: intMinsize,
            parentWidth: this.viewportGroup.width,
            parentHeight: this.viewportGroup.height,
            halfPiePosition: this.chartGrapicsArea,
            valueMaxWidth: 30,
            labelMaxWidth: 70,
            valueMaxHeight: 30,
            labelMaxHeight: 40,
            chartGrapicsAreaSize: this.state.width,
            ChartHelper: this.ChartHelper,
            ChartUtils: this.ChartUtils,
            parentElement: this.parent.parentNode,
        };
        let _layoutManagerRounded = new window["LayoutManagerRoundedSimple"](objLayoutManager);
        _layoutManagerRounded.data = this.data;
        _layoutManagerRounded.move(0, 0);
        _layoutManagerRounded.size(this.viewportGroup.width, this.viewportGroup.height);
        this.parent.parentNode.appendChild(_layoutManagerRounded.svgData);
        this.parent.parentNode.style.position = "relative";
    } else {
        if (measurement && this.index == 0) {
            let intEndAngle = parseInt(270);
            let intStartAngle = parseInt(270);
            let intAngle = "";
            let _layoutManagerRounded;
            for (let i1 = 0; i1 < this.voData.seriesLength; i1++) {
                intAngle = (this.maxAngle / this.data.totalValue) * parseFloat(this.voData.values[i1][0]);
                intEndAngle += intAngle;
                let objLayoutManager = {
                    groupIndex: i1,
                    maxAngle: 360,
                    radius: this.outerRadius,
                    endAngle: intEndAngle,
                    startAngle: intStartAngle,
                    graphicsAreaSize: intMinsize,
                    parentWidth: this.viewportGroup.width,
                    parentHeight: this.viewportGroup.height,
                    halfPiePosition: this.chartGrapicsArea,
                    valueMaxWidth: 30,
                    labelMaxWidth: 70,
                    valueMaxHeight: 30,
                    labelMaxHeight: 40,
                    chartGrapicsAreaSize: this.state.width,
                    ChartHelper: this.ChartHelper,
                    ChartUtils: this.ChartUtils,
                    customindex: this.ChartFonts.customColor(i1),
                    parentElement: this.parent.parentNode,
                    extraYvalue: 0,
                };
                _layoutManagerRounded = new window["LayoutManagerRoundedConnector"](objLayoutManager);
                _layoutManagerRounded.data = this.data;
                _layoutManagerRounded.move(0, 0);
                _layoutManagerRounded.size(this.viewportGroup.width, this.viewportGroup.height);
                // this.parent.parentNode.appendChild(_layoutManagerRounded.svgData);
                this.parent.parentNode.style.position = "relative";
                intStartAngle += intAngle;
            }
            this.data.elementOverlap = !_layoutManagerRounded.conflictsStatus;
            this.data.extraNeativeValue = _layoutManagerRounded.extraData;
        }
        // if (this.data.elementOverlap) {
        //     this.conflictsHandle();
        // } else {
        if (!measurement) {
            let objLayoutManager = {
                groupIndex: this.index,
                maxAngle: 360,
                radius: this.outerRadius,
                endAngle: this.endAngle,
                startAngle: this.startAngle,
                graphicsAreaSize: intMinsize,
                parentWidth: this.viewportGroup.width,
                parentHeight: this.viewportGroup.height,
                halfPiePosition: this.chartGrapicsArea,
                valueMaxWidth: 30,
                labelMaxWidth: 70,
                valueMaxHeight: 30,
                labelMaxHeight: 40,
                chartGrapicsAreaSize: this.state.width,
                ChartHelper: this.ChartHelper,
                ChartUtils: this.ChartUtils,
                customindex: this.ChartFonts.customColor(this.index),
                parentElement: this.parent.parentNode,
                extraYvalue: this.data.extraNeativeValue,
            };
            let _layoutManagerRounded = new window["LayoutManagerRoundedConnector"](objLayoutManager);
            _layoutManagerRounded.data = this.data;
            _layoutManagerRounded.move(0, 0);
            _layoutManagerRounded.size(this.viewportGroup.width, this.viewportGroup.height);
            this.parent.parentNode.appendChild(_layoutManagerRounded.svgData);
            this.parent.parentNode.style.position = "relative";
        }

        // }
    }
};

BasePieSeries.prototype.conflictsHandle = function () {
    let objDetails = {};
    this.data.data.setAttribute("conflictlayout", "true");
    this.data.conflictLayout = true;
    if (this.data.redrawOpertion) this.data.redrawOpertion.updateChartProperties(this.data.slideID, objDetails, true, false, this.data.data, null, null, false, null, null, true);
    return;
};

function BasePieSeriesItem(argparent, argprops) {
    this.voData = null;
    this.pntCenter = {};
    this.endAngle = argprops.endAngle;
    this.startAngle = argprops.startAngle;
    this.centerPointPadding = argprops.centerPointPad;
    BaseSeriesItem.call(this, argparent, argprops);
}
BasePieSeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
BasePieSeriesItem.prototype.constructor = BasePieSeriesItem;

BasePieSeriesItem.prototype.doComputation = function () {
    if (this.datavalidation) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BasePieSeriesItem.prototype.updateBasicData = function () {
    this.endAngle = this.props.endangle;
    this.startAngle = this.props.startangle;
    this.pntCenter.x = this.state.width * 0.5;
    this.pntCenter.y = this.state.height * 0.5;
    this.outerRadius = this.state.height * 0.5;
    if (this.voData.chartName == "halfPieChart") {
        this.outerRadius = this.voData.legendposition == "bottom" || this.voData.legendposition == "top" ? this.state.width * 0.38 : this.state.width * 0.5;
        this.outerRadius = this.outerRadius > this.state.height ? this.state.height : this.outerRadius;
        this.pntCenter.y = this.voData.legendposition == "bottom" || this.voData.legendposition == "top" ? this.state.height : this.state.height / 2;
    }
    if (this.data.layout.enableBackground && this.data.layout.backgroundType == "full") {
        if (this.data.layout.backgroundPieRadius) {
            let currentRadius = 1 - parseFloat(this.data.layout.backgroundPieRadius);
            this.outerRadius = this.outerRadius * currentRadius;
        }
    }
    if (this.data.extraNeativeValue < 0) {
        this.outerRadius = this.outerRadius * 0.6;
    }
    this.innerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt(this.outerRadius * (this.voData.customProperties.innerRadius * 0.01));
    this.length = this.voData.seriesItemLength;

    let intAssetLength = this.data?.asset?.data?.length;
    if (0 < intAssetLength && this.data.data.getAttribute("data-asset")) {
        if (this.voData.chartName == "realObjectPieChart" || this.voData.chartName == "realObjectOverlayPieChart") this.assetURL = this.voData.asset.data[0].url;
        else this.assetURL = this.voData.asset.data[this.ChartUtils.getFactorIndex(this.groupindex, 7)].url;
    }
    this.asset = this.data?.asset?.data;
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });
};

BasePieSeriesItem.prototype.getStepdownPercentage = function (radius, intItemLength, numMinPercentage, numStepDownPercetage, index) {
    //     if (intItemLength == 0) return radius;
    //   //  radius = intItemLength == 0 ? radius : radius - radius * numMinPercentage;
    //     let numPercentage = radius * numStepDownPercetage;
    //     return numPercentage/intItemLength;
    let percentage = radius * numMinPercentage;
    let valuepercentage = (100 - percentage) / intItemLength;
    return radius - valuepercentage * (intItemLength - (intItemLength - index));
};

BasePieSeriesItem.prototype.doAddGraphicElement = function () {
    this.stepDown = this.data.data.getAttribute("data-stepdown") == "true" ? true : false;
    if (
        this.voData.chartName == "piePopoutChart" ||
        this.voData.chartName == "piePercentagePatternChart" ||
        this.voData.chartName == "piePercentageChart" ||
        this.voData.chartName == "doughnutPopoutChart" ||
        this.voData.chartName == "doughnutPercentagePatternChart" ||
        this.voData.chartName == "doughnutPercentageChart"
    ) {
        this.doAddGraphicPopoutChart();
    } else if (this.voData.chartName == "realObjectPercentagePieChart") {
        this.doAddGraphicImageChart();
    } else if (this.voData.chartName == "realObjectPercentage3DPieChart") {
        this.doAddGraphicSpriteImage();
    } else {
        let intStrokeWidth = 2;
        let pntEnd = { x: 0, y: 0 };
        let pntMid = { x: 0, y: 0 };
        let pntStart = { x: 0, y: 0 };
        let pntInnerEnd = { x: 0, y: 0 };
        let pntInnerStart = { x: 0, y: 0 };
        if (this.stepDown) {
            this.minOuterRadius = this.getStepdownPercentage(this.outerRadius - intStrokeWidth, this.data.seriesLength, 0.1, 1, this.data.seriesLength - 1);
            this.innerRadius = this.innerRadius > this.minOuterRadius ? this.minOuterRadius * 0.8 : this.innerRadius;
        }
        this.outerRadius = this.stepDown ? this.getStepdownPercentage(this.outerRadius - intStrokeWidth, this.data.seriesLength, 0.1, 1, this.groupindex) : this.outerRadius - intStrokeWidth;
        pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
        pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
        pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
        pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
        if (pntEnd.x == pntStart.x && this._strokeWidth == 0) {
            pntEnd.y = 0;
            pntStart.y = 0;
        }
        pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
        pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
        pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
        pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
        pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
        pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;

        let midRadius = (this.outerRadius - this.innerRadius) / 2;
        let minAngle = this.startAngle + (this.endAngle - this.startAngle) / 2;
        pntMid.x = Math.round(this.pntCenter.x + midRadius * Math.cos((Math.PI * minAngle) / 180));
        pntMid.y = Math.round(this.pntCenter.y + midRadius * Math.sin((Math.PI * minAngle) / 180));

        this.midAngle = this.startAngle + (this.endAngle - this.startAngle) / 2;

        let svgElement = this.data.SVGUtils.createSVGElement("svg");
        let strStyleClass = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //1 < this.voData.seriesItemLength ? "item" + (this.index + 1) : "item" + (this.groupindex + 1);
        this.data.SVGUtils.assignAttributes(svgElement, {
            x: "0%",
            y: "0%",
            width: this.state.width + "px",
            height: this.state.height + "px",
            id: "graphic-" + this.groupindex + "_" + this.index,
            "data-cx": this.pntCenter.x,
            "data-cy": this.pntCenter.y,
            "data-maxangle": this.maxAngle,
            "data-endangle": this.endAngle,
            "data-startangle": this.startAngle,
            "data-outerradius": this.outerRadius,
            "data-innerradius": this.innerRadius,
            viewBox: 0 + " " + 0 + " " + this.state.width + " " + this.state.height,
        });

        if (this.voData.chartName == "realObjectOverlayPieChart" && this.groupindex == 0) {
            let imageTag = this.data.SVGUtils.createSVGElement("image");
            this.data.SVGUtils.assignAttributes(imageTag, {
                "xlink:href": this.assetURL,
                class: "transformOrgincenter moodanimation",
                "data-animation": "imageitem",
                width: 2 * this.outerRadius,
                height: 2 * this.outerRadius,
                x: this.pntCenter.x - this.outerRadius,
                y: this.pntCenter.y - this.outerRadius,
                id: "item-" + this.groupindex + "_" + this.index,
            });
            svgElement.appendChild(imageTag);
        }
        if (this.data.layout.enableBackground && this.groupindex == 0 && this.data.layout.backgroundType == "full") {
            let bgpie = this.data.SVGUtils.createSVGElement("circle");
            let bgStyleClass = this.data.ChartFonts.graphicFillColor(this.groupindex);
            this.data.SVGUtils.assignAttributes(bgpie, {
                id: "outercircle-" + this.groupindex + "_" + this.index,
                cx: this.pntCenter.x,
                cy: this.pntCenter.y,
                r: this.data.SVGUtils.createPercentValue(this.state.width, this.outerRadius + this.outerRadius * 0.1),
                fill: "red",
                class: "outerCircle",
            });
            // if(this.data.layout.placHolderBgColor == "theme"){
            //     this.data.SVGUtils.assignAttributes(bgpie, {
            //         class: "outerCircle "+bgStyleClass,
            //     });
            // }
            // if(this.data.layout.placHolderBgColor == "secondary"){
            //     bgStyleClass = this.data.ChartFonts.tertiaryFillColor
            //     this.data.SVGUtils.assignAttributes(bgpie, {
            //         class: "outerCircle "+bgStyleClass,
            //     });
            // }
            // if(this.data.layout.placHolderBgColor == "secondary"){
            //     bgStyleClass = this.data.ChartFonts.tertiaryFillColor
            //     this.data.SVGUtils.assignAttributes(bgpie, {
            //         class: "outerCircle "+bgStyleClass,
            //     });
            // }
            svgElement.appendChild(bgpie);
            this.itembgProperties(bgpie, this.index, this.groupindex);
        }
        console.log(this.voData.chartName);
        let svgPathTo = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            id: "path_to-" + this.groupindex + "_" + this.index,
            class: "path_to transformOrgincenter moodanimation chartgraphic " + strStyleClass,
            d:
                "M" +
                pntInnerStart.x +
                "," +
                pntInnerStart.y +
                "L" +
                pntStart.x +
                "," +
                pntStart.y +
                "A" +
                this.outerRadius +
                "," +
                this.outerRadius +
                " 0 " +
                (this.endAngle - this.startAngle > 180 ? 1 : 0) +
                ",1 " +
                pntEnd.x +
                "," +
                pntEnd.y +
                "L" +
                pntInnerEnd.x +
                "," +
                pntInnerEnd.y +
                "A" +
                this.innerRadius +
                "," +
                this.innerRadius +
                ",0," +
                (this.endAngle - this.startAngle > 180 ? 1 : 0) +
                ",0 " +
                pntInnerStart.x +
                "," +
                pntInnerStart.y +
                "z",
            "stroke-width": intStrokeWidth + "px",
            "data-customorgin": "null",
            "data-customtransformboxstart": "null",
            "data-customtransformboxend": "null",
            "data-animation": "item",
            "data-cx": this.pntCenter.x,
            "data-cy": this.pntCenter.y,
            "data-endangle": this.endAngle,
            "data-startangle": this.startAngle,
            "data-outerradius": this.outerRadius,
            "data-innerradius": this.innerRadius,
            "data-highlightPontX": this.highlightPoints().x,
            "data-highlightPontY": this.highlightPoints().y,
            "data-minPointx": pntMid.x,
            "data-minPointy": pntMid.y,
            "fill-opacity": this.voData.chartName == "realObjectOverlayPieChart" ? 0.8 : 1,
        });
        if (!this.data.baseProperties.legend) {
            this.data.SVGUtils.assignAttributes(svgPathTo, {
                class: "path_to transformOrgincenter moodanimation strokeColor chartgraphic " + strStyleClass,
                "stroke-width": "4",
            });
        }
        if (!this.data.baseProperties.legend && !this.data.layout.hadconnector) {
            this.data.SVGUtils.assignAttributes(svgPathTo, {
                "data-removeserires": "true",
            });
        }
        if (this.groupindex == 0 && this.data.totalValue == 0) {
            this.data.SVGUtils.assignAttributes(svgPathTo, {
                id: "path_to-" + this.groupindex + "_" + this.index,
                class: "path_to transformOrgincenter moodanimation chartgraphic " + strStyleClass,
                "fill-opacity": "0",
                "stroke-opacity": "0",
                "data-animation": "",
            });
            let baseCircle = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(baseCircle, {
                id: "path_to-" + this.groupindex + "_" + this.index,
                cx: "50%",
                cy: "50%",
                r: "50%",
                class: "path_to transformOrgincenter moodanimation chartgraphic " + this.data.ChartFonts.appendgraphicStrokeColor(this.groupindex),
                "fill-opacity": "0",
                "stroke-dasharray": "5, 5",
                "fill-opacity": "0.4",
                "data-animation": "item",
            });
            svgElement.appendChild(baseCircle);
        }
        if (this.data.totalValue != 0 && this.data.totalValue == 0) {
            this.data.SVGUtils.assignAttributes(svgPathTo, {
                id: "path_to-" + this.groupindex + "_" + this.index,
                class: "path_to transformOrgincenter moodanimation chartgraphic " + strStyleClass,
                "fill-opacity": "0",
                "stroke-opacity": "0",
                "data-animation": "",
            });
        }
        strStyleClass = this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true ? this.setNoEmphasis(svgPathTo, strStyleClass, this.groupindex) : this.data.hasEmphasis && this.data.emphasis[this.groupindex] == true ? this.setHasEmphasis(svgPathTo, strStyleClass, this.groupindex) : strStyleClass;
        svgElement.appendChild(svgPathTo);
        if (this.data.layout.itemColor == "gradient") {
            this.addGradient(svgPathTo, svgElement);
        }
        this.parent.appendChild(svgElement);
    }
};

BasePieSeriesItem.prototype.setNoEmphasis = function (svgPathTo, strStyleClass, groupindex) {
    if (this.data._emphasisName == "emphasize1") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass,
        });
    } else if (this.data._emphasisName == "emphasize2") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass,
        });
    } else if (this.data._emphasisName == "emphasize3") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass, //ChartFonts.emphasizeFillColor,
            opacity: 0.5,
        });
    }
};

BasePieSeriesItem.prototype.setHasEmphasis = function (svgPathTo, strStyleClass, groupindex) {
    if (this.data._emphasisName == "emphasize1") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass,
        });
    } else if (this.data._emphasisName == "emphasize2") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass,
            opacity: 0.5,
        });
        // svgPathTo.className = strStyleClass;
        // svgPathTo.style.opacity = 0.5;
        // svgPathTo.className = "chartgraphic " + strStyleClass + " chartborder emppattern" + (groupindex + 1);
    } else if (this.data._emphasisName == "emphasize3") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to chartgraphic transformOrgincenter moodanimation " + strStyleClass,
        });
    }
};

BasePieSeriesItem.prototype.doAddGraphicSpriteImage = function () {
    const assetdata = JSON.parse(this.voData.asset.data[0].data);
    const farmes = assetdata.frames;
    const totalfarmes = farmes.length - 1;
    const assetURL = ""; //IndexStore.getInstance().staticServerURL + this.voData.asset.data[1].url;
    const frameIndex = this.voData.values[this.groupindex][0] < 1 ? 0 : Math.ceil((this.voData.values[this.groupindex][0] / 100) * totalfarmes);
    const frame = farmes[frameIndex].frame;
    let spriteCoordinates = [];
    for (let i1 = 0; i1 < totalfarmes + 1; i1++) {
        let eachFrame = farmes[i1].frame;
        let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
        spriteCoordinates.push(eachFrameCoordinates);
    }
    let itemWidth = this.state.width;
    let itemHeight = this.state.height;
    const scaleX = itemWidth / frame.w;
    const scaleY = itemHeight / frame.h;
    const scale = scaleX < scaleY ? scaleX : scaleY;
    const viewWidth = frame.w * scale;
    const viewHeight = frame.h * scale;
    const translateX = (viewWidth - frame.w) / 2;
    const translateY = (viewHeight - frame.h) / 2;
    const divElement = this.ChartHelper.createDivElement({});
    divElement.id = "imagecontainer" + this.groupindex;
    divElement.className = "imagecontainer ";
    divElement.style.width = this.state.width + "px";
    divElement.style.height = this.state.height + "px";
    divElement.style.position = "absolute";
    this.parent.appendChild(divElement);
    const assetelement = this.ChartHelper.createDivElement({});
    assetelement.id = "graphicimage-" + this.groupindex;
    assetelement.className = "graphicimage";
    // assetelement.dataset.animation = "spriteanimation";
    assetelement.dataset.frameindex = frameIndex;
    assetelement.dataset.assetURL = assetURL;
    assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
    assetelement.setAttribute(
        "style",
        "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + 0 + "px) scale(" + scale + "," + scale + ");position: absolute"
    );
    divElement.appendChild(assetelement);
    /////
    const assetdata1 = JSON.parse(this.voData.asset.data[2].data);
    const farmes1 = assetdata1.frames;
    const totalfarmes1 = farmes1.length - 1;
    const assetURL1 = ""; //IndexStore.getInstance().staticServerURL + this.voData.asset.data[3].url;
    const frameIndex1 = this.voData.values[this.groupindex][0] < 1 ? 0 : Math.ceil((this.voData.values[this.groupindex][0] / 100) * totalfarmes1);
    const frame1 = farmes1[frameIndex1].frame;
    let spriteCoordinates1 = [];
    for (let i1 = 0; i1 < totalfarmes1 + 1; i1++) {
        let eachFrame1 = farmes1[i1].frame;
        let eachFrameCoordinates1 = [-eachFrame1.x, -eachFrame1.y];
        spriteCoordinates1.push(eachFrameCoordinates1);
    }
    let itemWidth1 = this.state.width;
    let itemHeight1 = this.state.height;
    const scaleX1 = itemWidth1 / frame1.w;
    const scaleY1 = itemHeight1 / frame1.h;
    const scale1 = scaleX1 < scaleY1 ? scaleX1 : scaleY1;
    const viewWidth1 = frame1.w * scale1;
    const viewHeight1 = frame1.h * scale1;
    const translateX1 = (viewWidth1 - frame1.w) / 2;
    const translateY1 = (viewHeight1 - frame1.h) / 2;
    const divElement1 = this.ChartHelper.createDivElement({});
    divElement1.id = "imagecontainer1" + this.groupindex;
    divElement1.className = "imagecontainer1 ";
    divElement1.style.width = this.state.width + "px";
    divElement1.style.height = this.state.height + "px";
    divElement1.style.position = "absolute";
    this.parent.appendChild(divElement1);
    const assetelement1 = this.ChartHelper.createDivElement({});
    assetelement1.id = "graphicimage-" + this.groupindex;
    assetelement1.className = "graphicimage";
    // assetelement1.dataset.animation = "spriteanimation";
    assetelement1.dataset.frameindex = frameIndex1;
    assetelement1.dataset.assetURL1 = assetURL1;
    assetelement1.dataset.allframes = JSON.stringify(spriteCoordinates1);
    assetelement1.setAttribute(
        "style",
        "width:" + frame1.w + "px; height:" + frame1.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL1 + "'); background-position:" + -frame1.x + "px " + -frame1.y + "px;" + "transform: translate(" + translateX1 + "px," + 0 + "px) scale(" + scale1 + "," + scale1 + ");position: absolute"
    );
    divElement1.appendChild(assetelement1);
    if (this.data.values[this.groupindex][0] > 0 && this.data.values[this.groupindex][0] < 25) {
        divElement.style.left = "20px";
        divElement1.style.top = "30px";
    } else if (this.data.values[this.groupindex][0] >= 25 && this.data.values[this.groupindex][0] < 50) {
        divElement.style.left = "20px";
        divElement1.style.top = "20px";
    }
};

BasePieSeriesItem.prototype.doAddGraphicImageChart = function () {
    let intStrokeWidth = this.voData.customProperties.appearance == "Outline" ? 4 : 0;
    let pntEnd = {
        x: 0,
        y: 0,
    };
    let pntStart = {
        x: 0,
        y: 0,
    };
    let pntBgEnd = {
        x: 0,
        y: 0,
    };
    let pntBgStart = {
        x: 0,
        y: 0,
    };
    let centerPointPadding = this.centerPointPadding;
    centerPointPadding.y = parseFloat(this.voData.values[this.groupindex][0]) != 100 ? centerPointPadding.y : 0;
    this.outerRadius = parseFloat(this.voData.values[this.groupindex][0]) != 100 ? parseInt(this.outerRadius * 0.9) : this.outerRadius;
    this.outerRadius = this.outerRadius - intStrokeWidth;
    this.bgItemOuterRadius = this.outerRadius - 5;
    pntBgEnd.x = Math.round(this.pntCenter.x + this.bgItemOuterRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntBgEnd.y = Math.round(this.pntCenter.y + this.bgItemOuterRadius * Math.sin((Math.PI * this.startAngle) / 180));
    pntBgStart.x = Math.round(this.pntCenter.x + this.bgItemOuterRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntBgStart.y = Math.round(this.pntCenter.y + this.bgItemOuterRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntBgEnd.x = pntBgStart.y == 0 && pntBgEnd.y == 0 ? pntBgEnd.x - 0.001 : pntBgEnd.x;
    pntBgEnd.y = pntBgStart.x == pntBgEnd.x ? pntBgEnd.y - 0.001 : pntBgEnd.y;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    this.intRemaingAngle = (360 / 100) * (100 - parseFloat(this.voData.values[this.groupindex][0])) + this.endAngle;
    pntEnd.x = pntStart.y == 0 && pntEnd.y == 0 ? pntEnd.x - 0.001 : pntEnd.x;
    pntEnd.y = pntStart.x == pntEnd.x ? pntEnd.y - 0.001 : pntEnd.y;
    // this.innerRadius = 0;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        x: "0%",
        y: "0%",
        width: this.state.width + "px",
        height: this.state.height + "px",
        viewBox: 0 + " " + 0 + " " + this.state.width + " " + this.state.height,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgBgPath_to = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath_to, {
        id: "popoutbgpath_to-" + this.groupindex + "_" + this.index,
        class: "popoutbgpath_to",
        d: "M" + this.pntCenter.x + "," + this.pntCenter.y + "L" + pntBgStart.x + "," + pntBgStart.y + "A" + this.bgItemOuterRadius + "," + this.bgItemOuterRadius + " 0 " + (this.intRemaingAngle - this.endAngle > 180 ? 1 : 0) + ",1 " + pntBgEnd.x + "," + pntBgEnd.y + "z",
        fill: "#ccc",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-width": intStrokeWidth + "px",
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.intRemaingAngle,
        "data-startangle": this.endAngle,
        "data-outerradius": this.bgItemOuterRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgBgPath_from = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath_from, {
        id: "bgpath_from-" + this.groupindex + "_" + this.index,
        class: "bgpath_from",
        d: "M" + this.pntCenter.x + "," + this.pntCenter.y + "L" + (pntBgEnd.x + 1) + "," + pntBgEnd.y + "A" + this.bgItemOuterRadius + "," + this.bgItemOuterRadius + " 0 " + "1 " + ",1 " + pntBgEnd.x + "," + pntBgEnd.y + "z",
        "fill-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.intRemaingAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.bgItemOuterRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path_to-" + this.groupindex + "_" + this.index,
        class: "path_to chartgraphic " + strStyleClass,
        d: "M" + this.pntCenter.x + "," + this.pntCenter.y + "L" + pntStart.x + "," + pntStart.y + "A" + this.outerRadius + "," + this.outerRadius + " 0 " + (this.endAngle - this.startAngle > 180 ? 1 : 0) + ",1 " + pntEnd.x + "," + pntEnd.y + "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-width": intStrokeWidth + "px",
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + this.groupindex + "_" + this.index,
        class: "path_from " + strStyleClass,
        d: "M" + this.pntCenter.x + "," + this.pntCenter.y + "L" + this.pntCenter.x + "," + this.pntCenter.y + "A" + 0 + "," + 0 + " 0 " + (this.endAngle - this.startAngle > 180 ? 1 : 0) + ",1 " + this.pntCenter.x + "," + this.pntCenter.y + "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-width": intStrokeWidth + "px",
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
    svgElement.appendChild(svgBgPath_from);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let valueSvgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(valueSvgGroup, {
        id: "valuegroup-" + this.groupindex + "_" + this.index,
        class: "valuegroup",
        "clip-path": "url(#clipPath" + this.groupindex + ")",
        transform: "translate(" + centerPointPadding.x + "," + centerPointPadding.y + ")",
    });
    svgElement.appendChild(valueSvgGroup);
    let bgSvgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(bgSvgGroup, {
        id: "bgSvgGroup-" + this.groupindex + "_" + this.index,
        "clip-path": "url(#clipPath" + (this.groupindex + 1) + ")",
    });
    svgElement.appendChild(bgSvgGroup);
    let intSeriesLength = parseInt(this.data.seriesLength);
    for (let i1 = 0; i1 <= intSeriesLength; i1++) {
        let clipPath = this.data.SVGUtils.createSVGElement("clipPath");
        this.data.SVGUtils.assignAttributes(clipPath, {
            id: "clipPath" + (this.groupindex + i1),
        });
        defsTag.appendChild(clipPath);
        i1 == 0 ? clipPath.appendChild(svgPathTo) : clipPath.appendChild(svgBgPath_to);
        let imageTag = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(imageTag, {
            class: "imagetag" + this.groupindex,
            "xlink:href": this.assetURL,
            width: this.data.SVGUtils.createPercentValue(this.state.width, 2 * this.outerRadius),
            height: this.data.SVGUtils.createPercentValue(this.state.height, 2 * this.outerRadius),
            x: this.data.SVGUtils.createPercentValue(this.state.width, this.pntCenter.x - this.outerRadius),
            y: this.data.SVGUtils.createPercentValue(this.state.height, this.pntCenter.y - this.outerRadius),
            id: "item-" + this.groupindex + "_" + this.index,
            "data-hover": this.data.validHover,
            "data-hover-value": this.numValue,
        });
        i1 == 0 ? valueSvgGroup.appendChild(imageTag) : bgSvgGroup.appendChild(imageTag);
        this.outerRadius = this.bgItemOuterRadius;
    }
    this.parent.appendChild(svgElement);
};

BasePieSeriesItem.prototype.doAddGraphicPopoutChart = function () {
    let pntEnd = { x: 0, y: 0 };
    let pntStart = { x: 0, y: 0 };
    let pntInnerEnd = { x: 0, y: 0 };
    let pntInnerStart = { x: 0, y: 0 };
    let pntBgEnd = { x: 0, y: 0 };
    let pntBgStart = { x: 0, y: 0 };
    let pntBgInnerEnd = { x: 0, y: 0 };
    let pntBgInnerStart = { x: 0, y: 0 };
    let intStrokeWidth = this.voData.customProperties.appearance == "Outline" ? 4 : 0;
    this.outerRadius = parseInt(this.outerRadius * 0.9);
    this.outerRadius = this.outerRadius - intStrokeWidth;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
    pntBgStart = { x: pntEnd.x, y: pntEnd.y };
    pntBgEnd = { x: pntStart.x, y: pntStart.y };
    pntBgEnd.x = pntBgEnd.x == pntBgStart.x && pntBgEnd.y == pntBgStart.y ? pntBgEnd.x - 0.001 : pntBgEnd.x;
    pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    pntBgInnerStart = { x: pntInnerEnd.x, y: pntInnerEnd.y };
    pntBgInnerEnd = { x: pntInnerStart.x, y: pntInnerStart.y };
    pntBgInnerEnd.x = pntBgInnerEnd.x == pntBgInnerStart.x && pntBgInnerEnd.y == pntBgInnerStart.y ? pntBgInnerEnd.x - 0.001 : pntBgInnerEnd.x;
    pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;
    let centerPointPadding = this.centerPointPadding;
    centerPointPadding.y = parseFloat(this.voData.values[this.groupindex][0]) != 100 ? centerPointPadding.y : 0;
    this.intRemaingAngle = (360 / 100) * (100 - parseFloat(this.voData.values[this.groupindex][0])) + this.endAngle;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        class: "graphic ",
        x: "0%",
        y: "0%",
        width: this.state.width + "px",
        height: this.state.height + "px",
        viewBox: 0 + " " + 0 + " " + this.state.width + " " + this.state.height,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgBgPath_to = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath_to, {
        id: "popoutbgpath_to" + this.groupindex + "_" + this.index,
        class: "popoutbgpath_to " + (this.voData.chartName == "piePercentagePatternChart" || this.voData.chartName == "doughnutPercentagePatternChart" ? strStyleClass : ""),
        d:
            "M" +
            pntBgInnerStart.x +
            "," +
            pntBgInnerStart.y +
            "L" +
            pntBgStart.x +
            "," +
            pntBgStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.intRemaingAngle - this.endAngle > 180 ? 1 : 0) +
            ",1 " +
            pntBgEnd.x +
            "," +
            pntBgEnd.y +
            "L" +
            pntBgInnerEnd.x +
            "," +
            pntBgInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.intRemaingAngle - this.endAngle > 180 ? 1 : 0) +
            ",0 " +
            pntBgInnerStart.x +
            "," +
            pntBgInnerStart.y +
            "z",
        fill: "#ccc",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-width": intStrokeWidth + "px",
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.intRemaingAngle,
        "data-startangle": this.endAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path:" + this.groupindex + "_" + this.index,
        class: "path_to chartgraphic " + (this.voData.chartName == "piePercentagePatternChart" || this.voData.chartName == "doughnutPercentagePatternChart" ? "" : strStyleClass),
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntEnd.x +
            "," +
            pntEnd.y +
            "L" +
            pntInnerEnd.x +
            "," +
            pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        fill: this.voData.chartName == "piePercentagePatternChart" || this.voData.chartName == "doughnutPercentagePatternChart" ? "url(#stripe)" : "",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });

    if (this.data.chartName != "piePercentageChart" || this.voData.chartName != "doughnutPercentageChart") svgElement.appendChild(svgBgPath_to);
    let svgOuterCircle = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(svgOuterCircle, {
        id: "outercircle-" + this.groupindex + "_" + this.index,
        cx: this.data.SVGUtils.createPercentValue(this.state.width, this.state.width / 2),
        cy: this.data.SVGUtils.createPercentValue(this.state.height, this.state.height / 2),
        r: this.data.SVGUtils.createPercentValue(this.state.width, this.outerRadius),
        fill: "none",
        stroke: "grey",
        class: "outerCircle",
        "stroke-opacity": 1,
        "stroke-dasharray": "10, 5",
        "stroke-width": "1",
    });
    if (this.data.chartName == "piePercentageChart" || this.voData.chartName == "doughnutPercentageChart") svgElement.appendChild(svgOuterCircle);
    let svgInnerCircle = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(svgInnerCircle, {
        id: "circle2-" + this.groupindex + "_" + this.index,
        class: "innerCircle",
        cx: this.data.SVGUtils.createPercentValue(this.state.width, this.state.width / 2),
        cy: this.data.SVGUtils.createPercentValue(this.state.height, this.state.height / 2),
        r: this.data.SVGUtils.createPercentValue(this.state.width, this.innerRadius),
        "fill-opacity": 0,
        stroke: "grey",
        "stroke-opacity": 1,
        "stroke-dasharray": "10, 5",
        "stroke-width": "1",
    });
    if (this.voData.chartName == "doughnutPercentageChart") svgElement.appendChild(svgInnerCircle);
    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgGroup, {
        class: "valuegroup",
        transform: "translate(" + centerPointPadding.x + "," + centerPointPadding.y + ")",
    });
    svgElement.appendChild(svgGroup);
    svgGroup.appendChild(svgPathTo);
    if (this.data.chartName == "piePercentagePatternChart" || this.data.chartName == "doughnutPercentagePatternChart") {
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsTag);
        let pattern = this.data.SVGUtils.createSVGElement("pattern");
        this.data.SVGUtils.assignAttributes(pattern, {
            patternUnits: "userSpaceOnUse",
            width: "25",
            height: "25",
            id: "stripe",
        });
        defsTag.appendChild(pattern);
        let imageTag = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(imageTag, {
            // "xlink:href": IndexStore.getInstance().staticServerURL + "chart/pattern/highlightStripesPattern.png",
            width: "25",
            height: "25",
        });
        pattern.appendChild(imageTag);
    }
    this.parent.appendChild(svgElement);
};
BasePieSeriesItem.prototype.itembgProperties = function (element, seriesIndex, groupindex) {
    if (this.data.layout.backgroundBorder) {
        let borderSize = this.data.layout.linechartShapeBorderSize ? this.data.layout.linechartShapeBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.linechartShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsSecondaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
            }
        } else {
            element.classList.add("clsSecondaryStroke");
        }
    }
    if (this.data.layout.backgroundColor) {
        if (this.data.layout.backgroundColor == "theme") {
            // if (this.data.hasProjection && this.data.projection[groupindex] == true) {
            //     element.classList.add("clsSecondaryFill")
            //     if (this.data.layout.linechartShapebgOpacity) {
            //         element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
            //     }
            // } else {
            if (this.data.layout.backgroundOpacity) {
                element.style.setProperty("fill-opacity", this.data.layout.backgroundOpacity, "important");
            } else {
                element.classList.add(this.ChartFonts.appendgraphicFillColor(seriesIndex)); //"accent" + (seriesIndex + 1) + "-fill")
            }
            //}
        } else {
            if (this.data.layout.backgroundColor == "secondary") {
                if (this.data.layout.backgroundOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.backgroundOpacity, "important");
                } else {
                    element.classList.add("clsSecondaryFill");
                }
            } else if (this.data.layout.backgroundColor == "bgcolor") {
                if (this.data.layout.backgroundOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.backgroundOpacity, "important");
                } else {
                    element.classList.add("fillbgColor");
                }
            }
        }
    }
};
BasePieSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment.show;
};
BasePieSeriesItem.prototype.highlightPoints = function (argprops) {
    let valueCenterRadius = ((100 + this.innerRadius) * 0.01) / 2;
    let intValueRadius = parseInt(this.outerRadius * valueCenterRadius);
    let x = this.pntCenter.x + intValueRadius * Math.cos(Math.PI * (this.midAngle / 180));
    let y = this.pntCenter.y + intValueRadius * Math.sin(Math.PI * (this.midAngle / 180));
    return { x: x, y: y };
};

