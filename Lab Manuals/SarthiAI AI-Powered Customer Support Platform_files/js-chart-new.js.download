SimpleHorWaterfallSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});

    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valuePosition == "outer") {
        element.style.maxWidth = this.valueMaxW + "px";
    }
    if (this.data.layout.backgroundColor == "bgcolor") {
        element.style.zIndex = 3;
    }
    if (this.valueAlignment.position == "middle") {
        element.classList.add("middleposition");
    }
    if (this.data.chartName == "imageColumnIconFill") {
        element.style.position = "absolute";
        element.style.opacity = "0";
    }
    if (this.valueAlignment.vposition == "top" && this.valueAlignment.itemBased != "true") {
        element.style.alignItems = "flex-end";
    }
    if (this.valueAlignment.position != "middle") {
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
    }
    if (this.data.values[groupindex][index] < 0 || (this.valueAlignment.itemBased == "true" && this.data.layout.itemalterpos == "true" && this.groupindex == 1 && this.valueAlignment.position != "inner")) {
        element.style.paddingTop = padding["bottom"] + "px";
        element.style.paddingBottom = padding["top"] + "px";
        if (this.data.layout.valueAlterPaddingClass) {
            element.classList.add(this.data.layout.valueAlterPaddingClass);
        }
    } else {
        if (this.data.layout.valuePaddingClass) {
            element.classList.add(this.data.layout.valuePaddingClass);
        }
    }
    let valuesMaxWidth = this.valueMaxW;
    element.style.maxWidth = valuesMaxWidth + "px";
    let graphicContainer = argparent.querySelector(".chartgraphic");
    let dummeyGraphicHeight = graphicH;
    if (graphicContainer) {
        dummeyGraphicHeight = graphicContainer.clientHeight > dummeyGraphicHeight ? graphicContainer.clientHeight : dummeyGraphicHeight;
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder") && (this.valueAlignment.vposition == "bottom" || dummeyGraphicHeight < this.middlePW / 2)) {
        element.style.marginBottom = this.middlePW / 2 + 2 + "px";
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }

    if (this.boolDisableWidth || this.data.layout.valueItemBased == "true") {
        element.style.width = "";
    } else {
        element.style.width = valuesMaxWidth + "px";
    }
    if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            element.style.marginLeft = "auto";
        } else {
            element.style.marginRight = "auto";
        }
    }

    if (this.data._projectionName == "projection-alpha" || (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (!this.data.hasEmphasis && !this.data.hasProjection) || (!this.data.hasEmphasis && this.data.hasProjection && this.data.projection[groupindex] != true)) {
        if (!this.overlap) this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    }
    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }
    if (
        ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && !this.valueOuter && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) ||
            (this.voData.shapeBorder && highlightPoint && !this.valueOuter && this.valueAlignment.position == "inner") ||
            this.boolEnableInnerValue) &&
        this.data.chartName != "shapesComparisonChart"
    ) {
        this.valueStyle = this.ChartFonts.valueInnerColor;
    }
    // if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
    //     this.valueStyle = "accent" + (this.groupindex + 1) + "-color";
    // }
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    if (!this.data.layout.microChartText) {
        subelement.className = "valuetext " + this.data.clsValueTextColor + " moodanimation " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    } else {
        subelement.className = "valuetext " + this.data.clsValueTextColor + " moodanimation " + this.data.ChartFonts.valueThemeClassName;
    }
    if ((this.data.layout.valueInset == "inside" || this.data.layout.valueInset == "middle") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + "  moodanimation " + this.data.ChartFonts.valueThemeClassName;
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        subelement.classList.add("cs-inner-text-color");
    }
    subelement.innerText = boolmax ? this.data.longLengthValue : argprops.valuetext;
    subelement.style.maxWidth = valuesMaxWidth + "px";

    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (this.valueStyle == "textgradient" && !this.data.layout.microChartText) {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.hasEmphasis || this.data.hasProjection) {
        subelement.classList.add("cs-value-text");
    }
    if (this.innerValuePlace && this.data.layout.itemFillType == "image" && this.data.grapicImage[groupindex] == "true") {
        subelement.style.pointerEvents = "all";
        element.style.pointerEvents = "none";
    }
    if (boolenablePer) {
        if (this.data.displayValueFormat == "number") {
            // if(this.data.suffix[this.groupindex][this.index]==""){
            //     subelement.innerText = this.data.values[groupindex][index];
            // }
        } else {
            subelement.dataset.defalutPercentage = "true";
            if (this.data.suffix[this.groupindex][this.index] == "") {
                subelement.innerText = argprops.valuetext + "%";
            }
        }
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle" && !this.data.layout.microChartText) {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    if (this.data.chartFlip) {
        subelement.setAttribute("data-graphic-y", -graphicH);
    }
    if (this.data.layout.microChartText) {
        subelement.classList.add(this.data.layout.microChartText);
    }
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
        if (this.data.chartFlip) {
            subelement.setAttribute("data-graphic-y", -customgraphicHeight);
        }
    }

    if (this.data.values[this.groupindex][this.index] < 0) {
        element.style.boolnegative = "true";
        subelement.dataset.boolnegative = "true";
    }
    subelement.dataset.animation = "secondarytext";
    if (this.data.chartName == "columnStackedRectangle") {
        subelement.dataset.animation = "secondarytext" + (index + 1);
        subelement.dataset.stackedmultiseries = "true";
    }
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    let borderElement1;
    if (this.data.layout.valuebgBorder || this.data.layout.valuebgBorder == "true") {
        borderElement1 = this.ChartHelper.createDivElement({});
        borderElement1.className = "moodanimation valueborder " + this.ChartFonts.graphicBgColor(groupindex);
        borderElement1.dataset.animation = "borderelement";
        element.appendChild(borderElement1);
        element.style.position = "relative";
        borderElement1.style.position = "absolute";
        element.style.display = "flex";
        // subelement.style.paddingLeft = padding["left"] + "px";
        // subelement.style.paddingRight = padding["right"] + "px";
        subelement.classList.remove("itembgColor");
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        subelement.classList.add("cs-inner-text-color");
        // subelement.classList.add("valuebg-color")
        subelement.style.zIndex = 1;
    }
    element.appendChild(subelement);
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }

    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        if (this.data.presentMode || this.data.disableEdit || this.data.waterFallData.data[groupindex].isSumValue) {
            subelement.setAttribute("contenteditable", "false");
        }
    }
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit || this.data.waterFallData.data[groupindex].isSumValue) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName != "simpleIconFillRepeatChart") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    if (this.data.waterFallData.data[groupindex].isSumValue) {
        subelement.setAttribute("contenteditable", "false");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor && this.data.layout.valueColor != "contrast") {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    this.ChartUtils.createSpanFormat(subelement, this.data);
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        if (this.data.suffixStyle) {
            let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
            if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
        }
        if (this.data.prefixStyle) {
            let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
            if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
        }
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this.index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (this.data.values[groupindex][this.index] == this.data.rangePositive) {
        element.classList.add("gridmaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (this.data.values[groupindex][index] == this.data.minValue && this.data.minValue < 0) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        this.maxCurrentValueW = element.clientWidth;
        this.maxElementValueW = subelement.clientWidth;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
    }
    if (!boolmax) {
        subelement.style.overflow = "hidden";
        // element.style.display="none"
        if (this.valuePosition == "outer") {
            element.style.removeProperty("min-width");
            this.rectGraphics.x = this.rectGraphics.x < 0 ? 0 : this.rectGraphics.x;
            let graphicX = this.rectGraphics.width - this.rectGraphics.x - this.rectGraphics.height;
            let valueX = graphicX - element.clientWidth;
            if (this.data.chartFlip) {
                element.style.left = valueX + "px";
            } else {
                element.style.right = valueX + "px";
            }
            element.style.position = "absolute";
            element.style.padding = "0px";
            element.style.maxHeight = "100%";
            element.dataset.valueX = valueX;
            element.dataset.graphicx = graphicX;
            element.dataset.graphicWidth = this.rectGraphics.height;
            element.classList.add("outertopvalue");
        }
        if (groupindex == this.data.seriesLength - 1) {
            this.realignValueElement();
        }
    }
};
SimpleHorWaterfallSeriesItem.prototype.realignValueElement = function () {
    let valueElements = this.data.chartName == "columnStackedRectangle" ? this.parent.querySelectorAll(".outertopvalue") : this.parent.parentNode.parentNode.querySelectorAll(".outertopvalue");
    if (valueElements) {
        let padding = 10;
        let data = this.data;
        Array.from(valueElements).forEach(function (item) {
            if (item.classList.contains("outertopvalue")) {
                item.style.removeProperty("min-width");
            }
            let graphicX = item.dataset.graphicx;
            let valueX = item.dataset.valueX;
            let graphicWidth = item.dataset.graphicWidth;
            if (graphicX) {
                if (valueX + item.clientWidth + padding < graphicX) {
                    item.style.left = valueX + "px";
                    item.style.right = "unset";
                } else {
                    item.style.left = parseFloat(graphicX || 0) + parseFloat(graphicWidth || 0) + padding + "px";
                    item.style.right = "unset";
                }
            }
        });
    }
};
SimpleHorWaterfallSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.SVGUtils.createPercentValue(this.state.height, numTopHeight);
    element.style.width = 100 + "%";
    element.setAttribute("data-width", numTopHeight);
    element.setAttribute("data-height", parentWidth);
    if (argparent) argparent.appendChild(element);
    else return element;

    var eprops = {
        height: 30,
        index: index,
        gindex: groupindex,
        item: argprops.item,
        value: argprops.value,
        valuetext: argprops.valuetext,
        length: argprops.length,
        minvalue: argprops.minvalue,
        maxvalue: argprops.maxvalue,
        totalvalue: argprops.totalvalue,
        placeholder: argprops.placeholder,
        placeholdername: argprops.placeholdername,
        placeholdertype: argprops.placeholdertype,
        viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
    };
    this.doAddTopGraphicsContainer(element, eprops);

    // if (this.displayValue(eprops)) {
    //     let subelement = element.getElementsByClassName("valuetext")[0];
    //     if (subelement) {
    //         this.ChartHelper.adjustFontSize(subelement, 10, this.maxValueFontSize[this.arrIndex] - 8, this.maxValueFontSize[this.arrIndex]);
    //         this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.maxValueFontSize[this.arrIndex] - 8, this.maxValueFontSize[this.arrIndex]);
    //         this.ChartHelper.textPositionChangeObserver(subelement);
    //     }
    // }
};

// import BaseBarChart from "../../base/baseChartBar/BaseBarChart";
// import SimpleRectFillBarSeries from "./SimpleRectFillBarSeries.js";
"use strict";
function SimpleRectFillBarChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleRectFillBarChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleRectFillBarChart.prototype = Object.create(BaseBarChart.prototype);
SimpleRectFillBarChart.prototype.constructor = SimpleRectFillBarChart;

SimpleRectFillBarChart.prototype.seriesInstance = function(argparent, argprops) {
    return new window["SimpleRectFillBarSeries"](argparent, argprops);
}


function SimpleRectFillBarSeries(argparent, argprops){
    this.name = "SimpleRectFillBarSeries";
    BaseBarSeries.call(this, argparent, argprops);
}
SimpleRectFillBarSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleRectFillBarSeries.prototype.constructor = SimpleRectFillBarSeries;

SimpleRectFillBarSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new window["SimpleRectFillBarSeriesItem"](argparent, argprops);
}
function SimpleRectFillBarSeriesItem(argparent, argprops) {
    this.name = "SimpleRectFillBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.graphicW = "";
    BaseBarSeriesItem.call(this, argparent, argprops);
}
SimpleRectFillBarSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
SimpleRectFillBarSeriesItem.prototype.constructor = SimpleBarSeriesItem;

SimpleRectFillBarSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // if (this.displayValue(argprops)) {
    //     if (this.valueAlignment.itemBased == "true") {
    //         this.valueStyle =
    //             this.data.hasEmphasis && this.data.emphasis[groupindex] != true
    //                 ? this.ChartFonts.valueOuterColor
    //                 : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
    //                 ? this.ChartFonts.graphicColor(groupindex)
    //                 : this.ChartFonts.valueOuterColor;
    //         const subValueElement =this.ChartHelper.createDivElement({});
    //         subValueElement.id = "topvalue-" + groupindex + "_" + index;
    //         subValueElement.className = "topvalue ";
    //         subValueElement.style.width = this.graphicWidthPercentage * 100 + "%";
    //         argparent.appendChild(subValueElement);
    //         this.doAddRightValue(subValueElement, argprops);
    //     }
    // }

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }

        element.style.alignItems = "flex-start";
    }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddRightValue(element, argprops, true);
    this.doAddLabel(element, argprops, false, true);
    this.doAddRightValue(element, argprops, true);

    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.labelMaxW * 0.5;
        this.middleLH = this.labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middleVH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation ";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middlePH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation ";
        middleelementPlaceholder.setAttribute("data-animation", "primaryplaceholder");
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.data.getAttribute("data-border") == "true") {
            middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
            middleelementPlaceholder.style.backgroundColor = "#fff";
        } else {
            middleelementPlaceholder.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }

    const parentWidth = argparent.getAttribute("data-width");
    let baseGraphicWidth;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") {
        baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + this.maxLabelW);
    } else {
        if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW));
        } else {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW));
        }
    }

    baseGraphicWidth = baseGraphicWidth - this.currentValW;
    const baseGraphicWidthPercentage = baseGraphicWidth / parentWidth;
    let graphicWidthPercentage = baseGraphicWidthPercentage * (argprops.value / argprops.maxvalue);
    graphicWidthPercentage = argprops.maxvalue == 0 ? 0 : graphicWidthPercentage;

    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        let bgStyleClass = this.ChartFonts.emphasizeColor;
        if (this.data.layout.backgroundColor == "transparent") {
            bgStyleClass = " transparent";
        }
        if (this.data.layout.backgroundColor == "theme") {
            bgStyleClass = this.ChartFonts.graphicBgColor(groupindex);
        }
        backgroundElement.className = "backgroundItem moodanimation" + bgStyleClass;
        backgroundElement.style.width = baseGraphicWidthPercentage * 100 + "%";
        backgroundElement.style.opacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = baseGraphicWidthPercentage * 100 + "%";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.height = this.thicknessPercentage * 100 + "%";
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            let borderAlign = this.voData.layout.backgroundBorder.alignment;
            backgroundBorderElement.classList.add("shapeborder" + borderAlign);
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            if (this.data.layout.backgroundBorder.color == "theme") {
                // let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
                backgroundBorderElement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
                if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                    // this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
                }
            }
            if (this.data.layout.backgroundBorder.color == "secondary") {
                backgroundBorderElement.classList.add("boborderOpacity");
                // let strBordeStyleClass = this.ChartFonts.tertiaryBorder(groupindex)
                backgroundBorderElement.classList.add("secondary-border-color");
                if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                    // this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
                }
            }
        }
    }

    //"graphicbg";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : graphicWidthPercentage * 100 + "%";
    subelement.style.height = this.labelAlignment.itemBased != "true" ? 100 * this.thicknessPercentage + "%" : "100%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = "calc(" + graphicWidthPercentage * 100 + "% - " + this.middlePH * 0.5 + "px)";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleVH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
                subelement.style.marginLeft = this.middlePH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleLH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let strStyleClass = "";
    const clsStyle = strStyleClass + "transformOrginLeft";
    const graphicElement = this.ChartHelper.createDivElement({});
    // graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic ";
    graphicElement.dataset.customorgin = "left";
    graphicElement.style.width = 100 + "%";
    graphicElement.style.height = "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") graphicElement.style.borderRadius = this.valueMaxH + "px";
    if (this.data.chartName == "barFillRectangle") graphicElement.style.position = "absolute";
    subelement.appendChild(graphicElement);
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaColor;

    if (this.displayPrimaryPlaceholder(argprops)) {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.placeholderAlignment.position == "outer" || this.graphicW < this.state.height * 0.6) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddRightPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            subelement.style.display = "flex";
            subelement.style.justifyContent = "flex-end";
            this.doAddRightPlaceholder(subelement, argprops);
        }
    }

    if ((this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true") && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")) {
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddRightValue(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true") {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        this.doAddRightValue(element, argprops, true);
        if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true") || this.graphicW < this.currentValW) {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(groupindex) : this.ChartFonts.valueOuterColor;

            let boolOrder = graphicW < this.innerlabelmaxWidth && this.labelAlignment.position == "inner" && this.valueAlignment.itemBased != "true" ? true : false;
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
                this.valueAlignment.position == "inner" ? this.doAddRightValue(element, argprops) : this.doAddRightValue(argparent, argprops);
            } else {
                if (this.labelAlignment.itemBased == "true") {
                    if (this.labelAlignment.itemBased == "true") {
                        let secondaryElement = this.ChartHelper.createDivElement({});
                        secondaryElement.style.display = "flex";
                        secondaryElement.style.width = "100%";
                        secondaryElement.style.height = 100 * this.thicknessPercentage + "%";
                        secondaryElement.style.position = "relative";
                        secondaryElement.style.order = "0";
                        subelement.parentNode.appendChild(secondaryElement);
                        secondaryElement.appendChild(subelement);
                        this.doAddRightValue(secondaryElement, argprops);
                    }
                } else this.doAddRightValue(element, argprops, false, boolOrder);
            }
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            this.doAddRightValue(valueElement, argprops);
        }
    }

    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true") {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            this.doAddRightValue(element, argprops, true);
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = graphicElement?.parentNode?.parentNode?.clientWidth * 0.8 < 150 ? 200 + "px" : graphicElement.parentNode.parentNode.clientWidth * 0.8 + "px";

            element.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
            this.valueMaxH = subelement.clientHeight;
            let elementHeight = 2 - this.thicknessPercentage;
            if (this.valueAlignment.itemBased != "true") {
                labelElement.style.maxHeight = elementHeight * 100 + "%";
                labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                if (labelElement.children[0]) {
                    labelElement.children[0].style.height = "auto";
                    labelElement.parentNode.style.justifyContent = "center";
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
            } else {
                if (labelElement.children[0]) {
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
                let ValueElement = labelElement.parentNode.querySelector(".value");
                if (ValueElement) {
                    ValueElement.parentNode.style.minHeight = ValueElement.clientHeight + "px";
                }
            }
        } else if (this.labelAlignment.position == "outer" || this.graphicW < this.innerlabelmaxWidth) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(element, argprops);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        }
    }

    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic " + clsStyle + " projection" + (groupindex + 1);
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") {
        graphicElement.classList.add("clsNodeSecondarybg");
        graphicElement.style.boxShadow = "";
    }

    if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
    }
    if (this.data.chartName == "barSimpleiconRepeatFill") {
        this.createsvgGraphicFill(graphicElement, argprops, styleIndex);
    } else {
        this.createRectGraphicFill(graphicElement, argprops, styleIndex);
    }
};
SimpleRectFillBarSeriesItem.prototype.createRectGraphicFill = function (parentNode, argprops, styleIndex) {
    let rectWidth = 10;
    let rectPadding = 3;
    let parentWidth = parentNode.clientWidth;
    let rectCount = Math.round(parentWidth / (rectWidth + rectPadding));
    for (let i1 = 0; i1 < rectCount; i1++) {
        let strStyleClass = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        let rectElement = this.ChartHelper.createDivElement({});
        rectElement.className = strStyleClass + " moodanimation";
        rectElement.dataset.animation = "item" + (this.groupindex + 1);
        rectElement.style.width = rectWidth + "px";
        rectElement.style.margin = "0px 0px 0px " + rectPadding + "px";
        if (this.data.hasEmphasis || this.data.hasProjection) {
            rectElement.classList.add("cs-chart-main-graphic");
        }
        parentNode.appendChild(rectElement);
        if (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && !this.data.shapeBorder) {
            this.setNoEmphasis(rectElement, "", this.groupindex);
        }
        // if (this.data.hasEmphasis && this.data.emphasis[this.groupindex] == true) {
        //     this.setHasEmphasis(rectElement, "", this.groupindex)
        // }
        if (this.data.projection[this.groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-grey" || this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert") && !this.data.shapeBorder) {
            rectElement.classList.add("clsNodeSecondarybg");
            rectElement.style.boxShadow = "";
        }
        if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-alpha" && !this.data.shapeBorder) {
            rectElement.classList.add("prjectionOpacity");
            rectElement.dataset.customopacity = "0.5";
        }
    }
};
SimpleRectFillBarSeriesItem.prototype.createsvgGraphicFill = function (parentNode, argprops, styleIndex) {
    let intPadding = 5;
    let parentWidth = parentNode.clientWidth;
    let parentHeight = parentNode.clientHeight;
    // let strStyleClass = this.ChartFonts.graphicFillColor(styleIndex);
    let strStyleClass = this.getBgFillDetails(styleIndex, this.data.ChartFonts.graphicFillColor(styleIndex), this.data.layout.itemColor, "bgcolor");
    let basesvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(basesvg, {
        width: "100%",
        height: "100%",
        class: strStyleClass,
    });
    parentNode.appendChild(basesvg);

    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[this.groupindex],
        "data-name": this.data.itemPlacehoders[this.groupindex],
        "data-iconpath": this.data.itemPlacehodersPath[this.groupindex],
        opacity: 0,
    });
    basesvg.appendChild(dummySVGNode);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(basesvg, basesvg);
    }
    let bounds = dummySVGNode.getBBox();
    let intIconW = bounds.width; //parseInt(xmlData.getAttribute("viewBox").split(" ")[2]);
    let intIconH = bounds.height; //parseInt(xmlData.getAttribute("viewBox").split(" ")[3]);
    let numItemHPercentage = parentHeight / intIconH;
    this.intIconFitH = parseInt(intIconH * numItemHPercentage);
    this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
    this.intTotalIcons = parseInt(parentWidth / this.intIconFitW);
    basesvg.removeChild(dummySVGNode);
    let columnCount = parseInt(parentWidth / this.intIconFitW);
    basesvg.setAttribute("width", this.intIconFitW * columnCount);
    basesvg.parentNode.parentNode.style.width = this.intIconFitW * columnCount + "px";
    for (let i1 = 0; i1 < columnCount; i1++) {
        let xValue = this.intIconFitW * i1;
        let svgElement = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgElement, {
            width: this.intIconFitW - intPadding,
            height: this.intIconFitH,
            class: "moodanimation",
            "data-animation": "item" + (this.groupindex + 1),
            id: "itemplaceholder-" + this.groupindex,
            "data-type": "ICON",
            "xlink:href": "#" + this.data.itemPlacehoders[this.groupindex],
            "data-iconpath": this.data.itemPlacehodersPath[this.groupindex],
            "data-name": this.data.itemPlacehoders[this.groupindex],
            "data-icongroup": this.voData.data.getAttribute("data-iconid"),
            "data-graphic-x": xValue,
            "data-graphic-y": 0,
            x: xValue,
            y: 0,
        });
        basesvg.appendChild(svgElement);
    }
};


function SimpleColumnCoinChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnCoinChart";
    BaseMovieclipColumnChart.call(this, argparent, argprops);
}
SimpleColumnCoinChart.prototype = Object.create(BaseMovieclipColumnChart.prototype);
SimpleColumnCoinChart.prototype.constructor = SimpleColumnCoinChart;

SimpleColumnCoinChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleColumnCoinSeries"](argparent, argprops);
}



function SimpleColumnCoinSeries(argparent, argprops) {
    this.name = "SimpleColumnCoinSeries";
    BaseMovieclipColumnSeries.call(this, argparent, argprops);
}
SimpleColumnCoinSeries.prototype = Object.create(BaseMovieclipColumnSeries.prototype);
SimpleColumnCoinSeries.prototype.constructor = SimpleColumnCoinSeries;

SimpleColumnCoinSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleColumnCoinSeriesItem"](argparent, argprops);
}

function SimpleColumnCoinSeriesItem(argparent, argprops) {
    this.objValue;
    this.graphicH = 0;
    this.groupindex = argprops.groupindex;
    this.name = "SimpleColumnCoinSeriesItem";
    BaseMovieclipColumnSeriesItem.call(this, argparent, argprops);
    this._callAnimation = "";
}
SimpleColumnCoinSeriesItem.prototype = Object.create(BaseMovieclipColumnSeriesItem.prototype);
SimpleColumnCoinSeriesItem.prototype.constructor = SimpleColumnCoinSeriesItem;

SimpleColumnCoinSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    this.objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightDifferenceHeight = 0;
    if (this.data.indualHighlight) {
        highlightDifferenceHeight += 30;
    }
    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    parentHeight = this.state.height;
    // parentHeight =this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    // parentHeight = parentHeight<this.state.height?this.state.height:parentHeight;
    let baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight);
    let valueHeight = argprops.minvalue < 0 ? 2 * this.maxValueH : this.maxValueH;
    if (this.valueAlignment.position == "outer") {
        baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight + valueHeight);
    }

    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;

    const baseGraphicHeightPercentage = baseGraphicHeight;
    let graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / totalValue);
    let parentPercentage = baseGraphicHeightPercentage * (argprops.totalvalue / totalValue);

    let seriesItem = this.parent.querySelector(".topseriesitem");
    seriesItem.style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage + this.maxValueH);
    let ParentHeightValue = parentPercentage + this.maxValueH;

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = styleIndex; //this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "contrast-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = "100px";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    // subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : graphicHeightPercentage * 100 + "%";
    subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue, graphicHeightPercentage);
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic  cs-chart-main-graphic transformOrginBottom moodanimation";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.dataset.animation = "item";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-seconassettype", "IMAGE");
    graphicElement.setAttribute("data-animation", "coin");
    graphicElement.setAttribute("data-secondassetsource", this.data.layout.itemFolder), subelement.setAttribute("data-graphicassetimage", "true");
    graphicElement.setAttribute("data-coinstyle", this.data.data.getAttribute("coinstyle"));
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
    //     graphicElement.dataset.customorgin = "bottom";
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic  cs-chart-main-graphic transformOrginBottom graphicnode " + clsStyle + " projection" + (groupindex + 1);
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     graphicElement.classList.add("emphasis");
    //     graphicElement.dataset.customopacity = "0.5"
    //     graphicElement.style.boxShadow = "";
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
    //     graphicElement.classList.add("prjectionOpacity")
    //     graphicElement.dataset.customopacity = "0.5"
    // }
    const subImageElement = this.ChartHelper.createDivElement({});
    subImageElement.id = "CoinStackBarHolder" + (groupindex + 1);
    graphicElement.appendChild(subImageElement);
    const graphicImageElement = this.ChartHelper.createDivElement({});
    graphicImageElement.id = "CoinStackBar" + (groupindex + 1);
    graphicImageElement.dataset.elementindex = groupindex + 1;
    graphicImageElement.className = "CoinStackBar";
    subImageElement.appendChild(graphicImageElement);

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaColor;

    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection2") {
    //     graphicElement.className = "chartgraphic  cs-chart-main-graphic moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
    //     graphicElement.dataset.customorgin = "bottom";
    // }

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops);
            else this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || (this.labelAlignment.position == "inner" && this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH))) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops);
            else this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops);
        }
    }
    let imageurl = this.data.serverUrl + this.data?.asset?.data?.[0]?.url;
    let clientHeight = graphicElement.clientHeight == 0 ? 1 : graphicElement.clientHeight;
    this._callAnimation = new window["coinColumnAnimation"]();
    graphicElement.dataset.baseHeight = graphicElement.clientHeight;
    let slideId = this.data.slideID;
    this._callAnimation.CoinStackBar(argparent, groupindex + 1, 100, 100, clientHeight, this.data.coinStyle, false, imageurl, this.data.seriesLength, false, slideId);
    if (argparent.clientWidth < 100) {
        argparent.classList.add("minWidthAlign");
        subelement.style.width = "100%";
        let itemParent = subelement.querySelector(".CoinStackBar");
        itemParent.style.width = "100%";
        itemParent.parentNode.style.width = "100%";
    }
    // this._callAnimation.CoinStackBar(argparent, (groupindex + 1), 100, 100, clientHeight, this.data.coinStyle, false, imageurl,subelement);
    // let arrCoins = argparent.getElementsByTagName("img");
    // if(arrCoins.length>0&&arrCoins[arrCoins.length-1].style.bottom){
    //     let topvalue = parseFloat(window.getComputedStyle(arrCoins[arrCoins.length-1])["bottom"])
    //     let heightValue =  parseFloat(window.getComputedStyle(arrCoins[arrCoins.length-1])["height"]);
    //     let parentHeightValue = topvalue+heightValue;
    //     // argparent.style.height =parentHeightValue+"px";
    //     subelement.style.height =parentHeightValue+"px";
    //     element.style.height = "100%";
    //     element.style.alignItems = "center";
    //     element.style.justfyContent = "center";

    // }
};
SimpleColumnCoinSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = "100%";
    element.style.width = "100%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (this.data.chartName == "columnImageHorizontalChart") {
        element.setAttribute("data-height", this.state.height);
    }
    if (argparent) {
        argparent.appendChild(element);
        argparent.parentNode.style.width = "100%";
    } else {
        return element;
    }
    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
};
SimpleColumnCoinSeriesItem.prototype.setNoEmphasis = function (graphicElement, strStyleClass, groupindex) {
    if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode  moodanimation transformOrginBottom ";
        graphicElement.dataset.customopacity = "0.5";
        graphicElement.dataset.customorgin = "bottom";
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation transformOrginBottom ";
        graphicElement.dataset.customopacity = "0.5";
        graphicElement.dataset.customorgin = "bottom";
    }
};
SimpleColumnCoinSeriesItem.prototype.setHasEmphasis = function (graphicElement, strStyleClass, groupindex, borderelement = false) {
    if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation transformOrginBottom ";
        graphicElement.dataset.customorgin = "bottom";
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation transformOrginBottom ";
        graphicElement.dataset.customorgin = "bottom";
    }
};

SimpleColumnCoinSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";

    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.width = this.valueMaxW * 0.7 + "px";
    element.style.maxWidth = this.valueMaxW * 0.7 + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    element.style.alignItems = "flex-start";
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            element.style.marginLeft = "auto";
        } else {
            element.style.marginRight = "auto";
        }
    }
    if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
        this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex); //"accent" + (this.groupindex + 1) + "-color";
    }
    if (this.data.values[groupindex][this.index] == this.data.rangePositive) {
        element.classList.add("gridmaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW * 0.7 + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.style.overflow = "hidden";
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (boolenablePer && this.data.displayValueFormat != "number") {
        // let boolenableSuffix =
        subelement.innerText = parseFloat(argprops.valuetext) + "%";
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    subelement.setAttribute("data-specialtype", "value");
    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
    } else {
        fontsize = window.getComputedStyle(subelement)["font-size"];
        this.ChartUtils.createSpanFormat(subelement, this.data);
        if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
            element.style.display = "none";
        }
    }
};

function SimpleIconFillColumnChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleIconFillColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleIconFillColumnChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleIconFillColumnChart.prototype.constructor = SimpleIconFillColumnChart;

SimpleIconFillColumnChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleIconFillColumnSeries"](argparent, argprops);
};
// SimpleIconFillColumnChart.prototype.doAddGraphicDesk = function () {
//     BaseColumnChart.prototype.doAddGraphicDesk.call(this)
// };
SimpleIconFillColumnChart.prototype.doAddGraphicDesk = function () {
    const pading = 8;
    let dummeyrectBaseSeriesWidth = this.rectBaseSeries.width;
    if (this.data.seriesItemLength > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.rectBaseSeries.x -= this.gridvalueSize;
        dummeyrectBaseSeriesWidth -= this.gridvalueSize;
    }
    // if (this.data.layout.itemSpace) {
    //     let numIndualHeight = this.rectBaseSeries.width * this.data.layout.itemSpace;
    //     dummeyrectBaseSeriesHeight = this.rectBaseSeries.width - (numIndualHeight * (this.length - 1));
    // }
    this.rectSeries.width = dummeyrectBaseSeriesWidth / this.length;
    this.rectSeries.height = this.rectBaseSeries.height;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";
    if (this.data.comparisonStyle == "style1") {
        this.rectBaseSeries.height = this.rectBaseSeries.height - 50;
    }

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    // element.style.width = this.rectBaseSeries.width + "px";
    // element.style.height = this.rectBaseSeries.height + "px";
    // element.style.position = "absolute";
    // element.style.top = "0";
    if (this.data.highlightDifference.display) {
        element.style.zIndex = "15";
    }
    element.style.width = seriesWidth;
    element.style.height = seriesHeight;
    element.style.maxHeight = seriesHeight;
    element.style.position = "absolute";
    element.style.left = Math.round(this.rectBaseSeries.x / this.props.gridsize) * this.props.gridsize + "px";
    element.style.width = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize) * this.props.gridsize + "px";
    element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
    element.style.height = Math.round((this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height)) / -this.props.gridsize) * this.props.gridsize + "px";
    this.parent.appendChild(element);

    const containerElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";
    containerElement.style.width = element.clientWidth + "px";
    containerElement.style.height = element.clientHeight + "px";
    containerElement.classList.add("columnContainer");
    // containerElement.style.position = "absolute";
    containerElement.style.display = "flex";
    if (this.data.seriesItemLength > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        containerElement.style.paddingLeft = "34px";
        containerElement.style.boxSizing = "unset";
    }
    if (this.legendposition == "top" || this.legendposition == "bottom") element.style.flexDirection = "column";
    if (this.legendposition == "top") {
        element.style.flexDirection = "column-reverse";
    }
    if (this.legendposition == "left") {
        element.style.flexDirection = "row-reverse";
    }
    // containerElement.style.top = this.rectBaseSeries.x + "px";
    element.appendChild(containerElement);
    this.doAddLegendDesk(element);
    containerElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - (element.querySelector(".legend").clientWidth + 5) + "px" : element.clientWidth + "px";
    containerElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? element.clientHeight - element.querySelector(".legend").clientHeight + "px" : element.clientHeight + "px";
    this.legendHeight = element.querySelector(".legend") ? element.querySelector(".legend").clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    const subElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";

    if (this.legendposition == "right" || this.legendposition == "left") {
        this.legendWidth = element.querySelector(".legend") ? element.querySelector(".legend").clientWidth : 0;
    }
    subElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - element.querySelector(".legend").clientWidth : element.clientWidth + "px";
    subElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? this.rectBaseSeries.height - element.querySelector(".legend").clientHeight + "px" : this.rectBaseSeries.height + "px";
    subElement.style.position = "relative";
    if ((this.legendposition == "bottom" || this.legendposition == "top") && (this.data.seriesItemLength > 1 || this.data.chartName == "waterfallchart" || this.data.chartName == "horWaterfallchart")) {
        this.rectBaseSeries.height -= this.legendHeight;
        this.rectSeries.height -= this.legendHeight;
    }
    if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) {
        containerElement.style.position = "relative";
        let gapPercentage = this.data.layout.itemgap ? 1 : 0.7;
        let labelMaxW = this.rectBaseSeries.width * gapPercentage;
        let labeMaxH = this.rectBaseSeries.height * 0.2 + (this.data.layout.labelPaddingtop + this.data.layout.labelPaddingbottom);
        let labelBounds = this.lonngLabelMesurement(element, {}, true, labelMaxW, labeMaxH);
        let labelWidth = labelBounds ? labelBounds.width : 0;
        let valueMaxH = this.rectBaseSeries.width * 0.4;
        let valueBounds = this.lonngValueMesurement(element, {}, true, 30, valueMaxH);
        let valueWidth = valueBounds ? valueBounds.width : 0;
        let itemWidth = this.rectBaseSeries.width - (labelWidth + valueWidth);
        TitleHeight = this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader ? this.createHeader(element, true, labelWidth, valueWidth, itemWidth, true) : { width: 0, height: 0 };
        dummeyrectBaseSeriesWidth -= TitleHeight.width;
        this.data._headerHeight = TitleHeight.width - 12;
        if (this.data.layout.labelHeaderPosition == "top") {
            this.titleY = TitleHeight.height;
            this.titleHeight = TitleHeight.height;
        }
    }
    // subElement.style.top = this.rectBaseSeries.x + "px";
    subElement.style.display = "flex";
    containerElement.appendChild(subElement);
    if (this.data.comparisonStyle == "style1") {
        containerElement.style.top = 50 + "px";
    }
    if (
        (this.data.layout.itemSpace == "" && this.data.baseProperties.maxAllowedSeries == 1 && this.data.layout.itemgap != 1 && this.data.layout.valueVPosition == "bottom") ||
        ((this.data.layout.itemSpace || this.data.layout.itemSpace == 0) && this.data.layout.itemgap != 1 && (this.data.baseProperties.maxAllowedSeries > 1 || this.data.chartName == "simpleIconFillRepeatChart" || this.bollEnableSize))
    ) {
        // let numIndualWidth = dummeyrectBaseSeriesHeight/this.length;
        // let numIndualSizeWidth = this.data.layout.itemgap?numIndualWidth * this.data.layout.itemgap:0;
        // let numIndualGapWidth = this.data.layout.itemSpace?numIndualWidth * this.data.layout.itemSpace:0;
        // let numTotalWidth = (numIndualSizeWidth* (this.length - 1))+(numIndualGapWidth*this.length);
        // containerElement.style.width =numTotalWidth+ "px";
        // numGraphicArea = numIndualWidth * this.data.layout.itemgap;
        // this.rectSeries.width = numGraphicArea;
        dummeyrectBaseSeriesWidth = dummeyrectBaseSeriesWidth - this.legendWidth;
        let numIndualWidth = "";
        let numIndualSizeWidth = "";
        let numIndualGapWidth = "";
        let numTotalWidth = "";
        numIndualWidth = dummeyrectBaseSeriesWidth / this.length;
        numIndualSizeWidth = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : numIndualWidth * this.data.layout.itemgap) : 0;
        numIndualGapWidth = this.data.layout.itemSpace ? (this.data.layout.itemSpace > 2 ? this.data.layout.itemSpace : numIndualWidth * this.data.layout.itemSpace) : 0;
        let gapSize = 0;
        numIndualSizeWidth = (dummeyrectBaseSeriesWidth - numIndualGapWidth * (this.length - 1)) / this.length > numIndualSizeWidth ? numIndualSizeWidth : (dummeyrectBaseSeriesWidth - numIndualGapWidth * (this.length - 1)) / this.length;
        numGraphicArea = numIndualSizeWidth;
        numTotalWidth = numIndualGapWidth * (this.length - 1) + numIndualSizeWidth * this.length;
        containerElement.children[0].style.width = numTotalWidth + "px";
        containerElement.style.width = numTotalWidth + "px";
        containerElement.style.justifyContent = "center";
        this.rectSeries.width = numGraphicArea;
        this.ParentElementPosition(element, this.data.layout.parenthPosition);
    } else {
        this.rectSeries.width = (dummeyrectBaseSeriesWidth - this.legendWidth) / this.length;
    }
    if (this.data.connectorLine) {
        this.doAddLineGraphicElement(subElement);
    } else {
        this.doAddGraphicElement(subElement);
        if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader) this.createHeader(element, false, null, null, null, true);
        if (this.data.layout.labelHeaderPosition == "left") {
            element.style.flexDirection = "row-reverse";
        }
    }
    if (containerElement.children.length > 1) {
        if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            // if (this.legendposition == "right")
            // {
            //     let gridWidth = parseFloat(containerElement.dataset.gridWidth);
            //     let graphicWidth = containerElement.children[0].clientWidth;
            //     let indualWidth = (gridWidth-graphicWidth)/2
            //     containerElement.children[0].style.paddingLeft = (indualWidth+48)+ "px";
            //     this.legendWidth = containerElement.children[0].clientWidth;
            // }
            // if(this.legendposition == "left")
            // {
            //     let gridWidth = parseFloat(containerElement.dataset.gridWidth);
            //     let graphicWidth = containerElement.children[1].clientWidth;
            //     let indualWidth = (gridWidth-graphicWidth)/2
            //     containerElement.children[0].style.paddingRight = (indualWidth+58)+ "px";
            //     this.legendWidth = containerElement.children[0].clientWidth;
            // }
        } else {
            // if(this.legendposition == "right")containerElement.children[0].style.paddingRight = "48px"
            // if(this.legendposition == "left")containerElement.children[0].style.paddingLeft  ="48px"
        }
    }
    let arrprojectionEnableDiv = element.querySelectorAll(".projectionEnableGraphic");
    let arrprojectioDisableDiv = element.querySelectorAll(".projectionDisabledGraphic");
    let projectionEnableDiv = arrprojectionEnableDiv.length > 0 ? arrprojectionEnableDiv[0] : "";
    let projectioDisableDiv = arrprojectioDisableDiv.length > 0 ? arrprojectioDisableDiv[arrprojectioDisableDiv.length - 1] : "";
    if (projectionEnableDiv && projectioDisableDiv && this.data.projectionDivider) {
        let disableDiv = { width: projectioDisableDiv.clientWidth, x: projectioDisableDiv.offsetLeft };
        let enableDiv = { width: projectionEnableDiv.clientWidth, x: projectionEnableDiv.offsetLeft };
        let leftValue = 0;
        let gapValue = 0;
        if (disableDiv.x < enableDiv.x) {
            gapValue = enableDiv.x - (disableDiv.x + enableDiv.width);
            leftValue = disableDiv.x + disableDiv.width + gapValue / 2;
        }
        let dividerLine = document.createElement("div");
        dividerLine.classList.add("projectiondivider");
        dividerLine.style.width = "2px";
        dividerLine.style.left = leftValue + "px";
        subElement.appendChild(dividerLine);
    }
};
SimpleIconFillColumnChart.prototype.CreateHightlightDifference = function () {
    return null;
};

function SimpleIconFillColumnSeries(argparent, argprops) {
    this.name = "SimpleIconFillColumnSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleIconFillColumnSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleIconFillColumnSeries.prototype.constructor = SimpleIconFillColumnSeries;

SimpleIconFillColumnSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleIconFillColumnSeriesItem"](argparent, argprops);
}
function SimpleIconFillColumnSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.objValue;
    this.graphicH = 0;
    this.iconWH = 84;
    this.maxGraphicHeightCount = 0;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleIconFillColumnSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleIconFillColumnSeriesItem.prototype.constructor = SimpleIconFillColumnSeriesItem;

SimpleIconFillColumnSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    this.objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? labelMaxW * 0.5 : labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);
    const graphicHeight = baseGraphicHeight * (argprops.value / argprops.maxvalue);
    let maxGraphicHeight = baseGraphicHeightPercentage;
    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgFillDetails(styleIndex, this.data.ChartFonts.graphicFillColor(styleIndex), this.data.layout.itemColor, "bgcolor"); // this.ChartFonts.graphicFillColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "contrast-fill" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = maxGraphicHeight * 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.style.alignItems = "flex-end";
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    this.emphasisColor = " secondary-fill";
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;
    let bgClsStyle = this.ChartFonts.secondaryStroke();
    //iconfillSvg
    ///DropShadow
    // let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    // graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaColor;
    graphicElement.classList.remove("moodanimation");

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops);
            else this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops, "", true);
            else if (this.data.chartName != "imageColumnIconFill") {
                this.doAddTopValue(element, argprops, "", true);
            }
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops, "", true);
        }
    }
    this.maxGraphicHeightCount = subelement.clientHeight;
    subelement.style.height = graphicHeightPercentage * 100 + "%";

    if (!this.data.layout.itemIconCounter) {
        if (this.data.chartName == "imageColumnIconFill") {
            subelement.style.height = 100 + "%";
            for (let k1 = 0; k1 < this.data.seriesItemLength; k1++) {
                let dummeyobject = JSON.parse(JSON.stringify(argprops));
                dummeyobject.valuetext = this.data.values[this.groupindex][k1];
                dummeyobject.index = k1;
                this.doAddTopValue(element, argprops, "", true);
            }
            this.createGraphicPlaceHolder(graphicElement, argprops, this.state.width * this.gapPercentage, graphicHeight, groupindex, clsStyle);
        } else {
            subelement.style.height = 100 + "%";
            this.createGraphicSVG(graphicElement, argprops, this.state.width * this.gapPercentage, graphicElement.clientHeight, groupindex, clsStyle, true);
            this.createGraphicSVG(graphicElement, argprops, this.state.width * this.gapPercentage, graphicElement.clientHeight, groupindex, clsStyle);
        }
    } else {
        this.createGraphicSVG1(graphicElement, argprops, this.state.width * this.gapPercentage, graphicElement.clientHeight, groupindex, clsStyle);
    }
};
SimpleIconFillColumnSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index, clsStyle, boolBg = false) {
    //iconfillSvg
    let baseParentSvg = this.data.SVGUtils.createSVGElement("svg");
    argparent.appendChild(baseParentSvg);
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    baseParentSvg.appendChild(baseSvg);
    let horGap = 16;
    let verGap = 16;
    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[index],
        "data-name": this.data.itemPlacehoders[index],
        "data-iconpath": this.data.itemPlacehodersPath[index],
        width: this.iconWH,
        height: this.iconWH,
        opacity: 0,
    });
    baseSvg.appendChild(dummySVGNode);
    let bounds = dummySVGNode.getBBox();
    let iconOriginalWidth = bounds.width + horGap;
    let iconOrginalHeight = bounds.height + verGap;
    baseSvg.removeChild(dummySVGNode);

    let iconWidthSpace = bounds.height;
    let rowCount = parseInt(height / iconOrginalHeight);
    let columnCount = Math.floor(width / iconOriginalWidth);
    // columnCount = columnCount > 10 ? 10 : columnCount;
    let lastX = (columnCount - 1) * iconOriginalWidth + iconOriginalWidth;
    while (lastX > width) {
        columnCount -= 1;
        lastX = (columnCount - 1) * iconOriginalWidth + iconOriginalWidth;
    }
    let extraSpace = argparent.clientWidth - (columnCount * iconOriginalWidth - horGap);
    extraSpace = extraSpace > 0 && iconOriginalWidth < iconOrginalHeight * 0.6 ? extraSpace / 2 : extraSpace;
    let extraHeightSpace = argparent.clientHeight - (rowCount * iconOrginalHeight - verGap);
    let indualExtraspace = extraSpace / (columnCount - 1);
    let indualExtraHeight = extraHeightSpace / (rowCount - 1);
    iconOriginalWidth += indualExtraspace;
    iconOrginalHeight += indualExtraHeight;
    argparent.className = "chartgraphic transformOrginBottom ";
    let iconGraphicHeight = rowCount * iconWidthSpace;
    let iconGraphicwidth = argparent.clientWidth;
    argparent.style.display = "flex";
    argparent.style.justifyContent = "center";
    this.data.SVGUtils.assignAttributes(baseParentSvg, {
        width: argparent.clientWidth,
        height: argparent.clientHeight,
    });
    if (boolBg) {
        baseParentSvg.style.setProperty("position", "absolute");
        baseParentSvg.style.setProperty("top", 0);
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(baseParentSvg, baseParentSvg);
    }
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    let maskTag = this.data.SVGUtils.createSVGElement("mask");
    let maskValueid = Math.random() + this.data.slideID + "maskelement" + index;
    this.data.SVGUtils.assignAttributes(maskTag, {
        id: maskValueid,
        "data-maskelement": "true",
    });
    defsTag.appendChild(maskTag);
    baseParentSvg.appendChild(defsTag);
    let maskRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(maskRect, {
        width: argparent.clientWidth,
        height: argparent.clientHeight,
        fill: "white",
        class: "transformOrginBottom",
    });
    maskRect.dataset.customorgin = "bottom";
    maskTag.appendChild(maskRect);
    this.data.SVGUtils.assignAttributes(baseSvg, {
        width: argparent.clientWidth,
        height: "100%",
        "data-type": "ICON",
        class: "svgAsset " + clsStyle,
        "data-useContainer": "true",
        mask: "url(#" + maskValueid + ")",
        "data-mask": "true",
    });
    let customColorIndex = this.ChartFonts.customColor(this.groupindex);
    if (boolBg) {
        baseParentSvg.classList.add("th-section-tertiary");

        baseParentSvg.classList.add("accent" + customColorIndex);
        baseParentSvg.classList.add("clsMultiColorParent");
    } else {
        baseParentSvg.style.position = "absolute";
        baseParentSvg.style.setProperty("top", 0);
        baseParentSvg.classList.add("th-section" + customColorIndex);
    }
    argparent.parentNode.style.height = argparent.clientHeight + "px";
    let totalCount = rowCount * columnCount;
    let valueCount = totalCount * (this.data.values[index][0] / this.data.rangePositive);
    let count = 1;
    let adjustX = 0;
    let adjustY = 0;
    for (let i1 = 1; i1 <= rowCount; i1++) {
        for (let i2 = 0; i2 < columnCount; i2++) {
            let iconX = iconOriginalWidth * i2;
            let iconY = iconOrginalHeight * (i1 - 1);
            let svgIcon = this.data.SVGUtils.createSVGElement("use");
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "itemplaceholder-" + this.groupindex + "_" + this.index,
                class: "moodanimation",
                x: iconX - adjustX,
                y: iconY - adjustY,
                width: this.iconWH,
                height: this.iconWH,
                "xlink:href": "#" + this.data.itemPlacehoders[index],
                "data-name": this.data.itemPlacehoders[index],
                "data-iconpath": this.data.itemPlacehodersPath[index],
                "data-type": "ICON",
                "data-graphic-x": iconX + this.iconWH / 2,
                "data-graphic-y": iconY + this.iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "data-icongroup": this.voData.data.getAttribute("data-iconid"),
            });
            if (boolBg) {
                this.data.SVGUtils.assignAttributes(svgIcon, {
                    "fill-opacity": "0.3",
                });
            }
            baseSvg.appendChild(svgIcon);
            let finalBounds = svgIcon.getBBox();
            if (i2 == 0 && finalBounds.x > 0) {
                if (columnCount == 1) {
                    let singleColumnXvalue = (argparent.clientWidth - finalBounds.width) / 2;
                    this.data.SVGUtils.assignAttributes(svgIcon, {
                        x: singleColumnXvalue,
                    });
                } else {
                    adjustX = finalBounds.x;
                    this.data.SVGUtils.assignAttributes(svgIcon, {
                        x: iconX - adjustX,
                    });
                }
            }
            if (i1 == 1 && finalBounds.y > 0) {
                adjustY = finalBounds.y;
                this.data.SVGUtils.assignAttributes(svgIcon, {
                    y: iconY - adjustY,
                });
            }
            if (valueCount < count && !boolBg) {
                svgIcon.style.opacity = 0;
            } else {
                this.data.SVGUtils.assignAttributes(svgIcon, {
                    "data-animation": "item" + (this.groupindex + 1),
                });
            }
            count++;
        }
    }
};
SimpleIconFillColumnSeriesItem.prototype.createGraphicSVG1 = function (argparent, argprops, width, height, index, clsStyle) {
    //iconfillSvg
    height = argparent.clientHeight;
    argparent.className = "chartgraphic transformOrginBottom " + clsStyle;
    this.iconWH = 48;
    let iconWidthSpace = this.iconWH + 8;
    let maxRow = parseInt(this.maxGraphicHeightCount / iconWidthSpace);
    let maxColumn = parseInt(width / iconWidthSpace);
    let totalCount = maxColumn * maxRow;
    let currentValueCount = argprops.value * (totalCount / argprops.maxvalue);
    let hasbelowValue = currentValueCount < 1;
    let rowCount = parseInt(height / iconWidthSpace);
    let columnCount = parseInt(width / iconWidthSpace) > currentValueCount ? Math.ceil(currentValueCount) : parseInt(width / iconWidthSpace);
    // columnCount = columnCount > 10 ? 10 : columnCount;
    if (parseInt(width / iconWidthSpace) > currentValueCount) {
        rowCount = 1;
    } else {
        rowCount = Math.ceil(currentValueCount / columnCount);
    }

    let iconGraphicHeight = rowCount * iconWidthSpace;
    let iconGraphicwidth = columnCount * iconWidthSpace;
    argparent.style.display = "flex";
    argparent.style.justifyContent = "center";
    let baseParentSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseParentSvg, {
        width: columnCount == 1 && !hasbelowValue ? width : columnCount * iconWidthSpace,
        height: rowCount * iconWidthSpace,
    });
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(baseParentSvg, baseParentSvg);
    }
    argparent.parentNode.style.height = rowCount * iconWidthSpace + "px";
    if (this.data.layout.iconassetType == "image") {
        baseParentSvg = this.ChartHelper.createDivElement({});
        baseParentSvg.style.width = columnCount == 1 && !hasbelowValue ? width + "px" : columnCount * iconWidthSpace + "px";
        baseParentSvg.style.height = rowCount * iconWidthSpace + "px";
    }
    argparent.appendChild(baseParentSvg);
    let iconCount = 0;

    for (let i1 = 0; i1 < rowCount; i1++) {
        for (let i2 = 0; i2 < columnCount; i2++) {
            let iconX = iconWidthSpace * i2 + this.iconWH / 2;
            let iconY = rowCount * iconWidthSpace - iconWidthSpace * i1 - this.iconWH / 2;
            if (this.data.layout.iconassetType != "svg" && this.data.layout.iconassetType != "image") {
                let svgIcon = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(svgIcon, {
                    id: "itemplaceholder-" + this.groupindex + "_" + this.index,
                    class: "moodanimation ",
                    cx: iconX,
                    cy: iconY,
                    r: this.iconWH / 2,
                    "data-animation": "item" + (this.groupindex + 1),
                    "data-graphic-x": iconX,
                    "data-graphic-y": iconY,
                    "data-iconanimation": "true",
                    "data-customtransformboxstart": "null",
                    "data-customtransformboxend": "null",
                    "data-customorgin": "null",
                });
                if (iconCount < currentValueCount) baseParentSvg.appendChild(svgIcon);
            } else {
                if (this.data.layout.iconassetType == "svg") {
                    let iconX = iconWidthSpace * i2;
                    let iconY = iconGraphicHeight - iconWidthSpace * i1;
                    let svgIcon = this.data.SVGUtils.createSVGElement("use");
                    this.data.SVGUtils.assignAttributes(svgIcon, {
                        id: "itemplaceholder-" + this.groupindex + "_" + this.index,
                        class: "moodanimation",
                        x: this.data.SVGUtils.createPercentValue(iconGraphicwidth, iconX),
                        y: this.data.SVGUtils.createPercentValue(iconGraphicHeight, iconY),
                        width: this.data.SVGUtils.createPercentValue(iconGraphicwidth, this.iconWH),
                        height: this.data.SVGUtils.createPercentValue(iconGraphicHeight, this.iconWH),
                        "data-iconanimation": "true",
                        "xlink:href": "#" + this.data.itemPlacehoders[index],
                        "data-name": this.data.itemPlacehoders[index],
                        "data-iconpath": this.data.itemPlacehodersPath[index],
                        "data-type": "ICON",
                        "data-animation": "item" + (this.groupindex + 1),
                        "data-graphic-x": iconX + this.iconWH / 2,
                        "data-graphic-y": iconY + this.iconWH / 2,
                        "data-customtransformboxstart": "null",
                        "data-customtransformboxend": "null",
                        "data-customorgin": "null",
                        "data-icongroup": this.voData.data.getAttribute("data-iconid"),
                    });
                    if (iconCount < currentValueCount) baseParentSvg.appendChild(svgIcon);
                }
                if (this.data.layout.iconassetType == "image") {
                    let svgIcon = this.ChartHelper.createDivElement({});
                    svgIcon.className = "imageicon";
                    svgIcon.style.width = this.data.SVGUtils.createPercentValue(iconGraphicwidth, this.iconWH);
                    svgIcon.style.height = this.data.SVGUtils.createPercentValue(iconGraphicHeight, this.iconWH);
                    if (iconCount < currentValueCount) baseParentSvg.appendChild(svgIcon);
                    let imageNode = document.createElement("img");
                    imageNode.style.width = "100%";
                    imageNode.style.height = "100%";
                    imageNode.src = "https://img.freepik.com/free-photo/cascade-boat-clean-china-natural-rural_1417-1356.jpg?size=626&ext=jpg";
                    svgIcon.appendChild(imageNode);
                }
            }
            iconCount++;
        }
    }
};
SimpleIconFillColumnSeriesItem.prototype.createGraphicPlaceHolder = function (argparent, argprops, width, height, index, clsStyle) {
    //iconfillSvg
    height = argparent.clientHeight;
    argparent.className = "chartgraphic transformOrginBottom " + clsStyle;
    this.iconWH = 48;
    if (this.data.chartName == "imageColumnIconFill") {
        this.iconWH = 80;
    }
    let iconWidthSpace = this.iconWH + 4;
    let maxRow = parseInt(this.maxGraphicHeightCount / iconWidthSpace);
    let maxColumn = parseInt(width / iconWidthSpace);
    let totalCount = maxColumn * maxRow;
    let currentValueCount = totalCount;
    let rowCount = parseInt(height / iconWidthSpace);
    let columnCount = parseInt(width / iconWidthSpace) > currentValueCount ? currentValueCount : parseInt(width / iconWidthSpace);
    if (parseInt(width / iconWidthSpace) > currentValueCount) {
        rowCount = 1;
    } else {
        rowCount = Math.ceil(currentValueCount / columnCount);
    }
    let totalValue = 0;
    let length = this.data.values[this.groupindex].length;
    for (let t1 = 0; t1 < length; t1++) {
        totalValue += parseFloat(this.data.values[this.groupindex][t1]);
    }
    let multipleFactorValue = totalCount / totalValue;
    let firstValue = Math.floor(parseFloat(this.data.values[this.groupindex][0]) * multipleFactorValue);
    let secondValue = Math.floor(parseFloat(this.data.values[this.groupindex][1]) * multipleFactorValue);
    let thirdValue = Math.floor(parseFloat(this.data.values[this.groupindex][2]) * multipleFactorValue);
    let fourthValue = Math.floor(parseFloat(this.data.values[this.groupindex][3]) * multipleFactorValue);
    let arrValueCount = [firstValue, secondValue, thirdValue, fourthValue];
    let secondaryCount = 0;
    for (let j1 = 0; j1 < length; j1++) {
        secondaryCount += arrValueCount[j1];
    }
    let differencevalue = totalCount - secondaryCount;
    switch (length) {
        case 1:
            firstValue += differencevalue;
            break;
        case 2:
            secondValue += differencevalue;
            break;
        case 3:
            thirdValue += differencevalue;
            break;
        case 4:
            fourthValue += differencevalue;
            break;
    }
    let iconGraphicHeight = rowCount * iconWidthSpace;
    let iconGraphicwidth = columnCount * iconWidthSpace;
    argparent.style.display = "flex";
    argparent.style.justifyContent = "center";

    let baseParentSvg = this.ChartHelper.createDivElement({});
    baseParentSvg.style.width = columnCount == 1 ? width + "px" : columnCount * iconWidthSpace + "px";
    baseParentSvg.style.height = rowCount * iconWidthSpace + "px";
    argparent.parentNode.style.height = rowCount * iconWidthSpace + "px";
    baseParentSvg.style.display = "flex";
    baseParentSvg.style.flexWrap = "wrap";
    baseParentSvg.style.justifyContent = "space-between";
    argparent.appendChild(baseParentSvg);
    let iconCount = 0;
    let colorCount = 1;
    let previousCount = 1;
    this.arrRowHeight = [];
    this.sameColumn = false;
    this.getPlaceHolderUrl(this.groupindex, totalCount);
    for (let i1 = 0; i1 < rowCount; i1++) {
        for (let i2 = 0; i2 < columnCount; i2++) {
            let svgIcon = this.ChartHelper.createDivElement({});
            colorCount = this.getColorCount(firstValue, secondValue, thirdValue, fourthValue, iconCount + 1, colorCount, i1);
            let customColorIndex = this.ChartFonts.customColor(colorCount - 1);
            svgIcon.className = "imageicon moodanimation accent" + customColorIndex + " clsMultiColorParent";
            svgIcon.style.position = "relative";
            svgIcon.style.overflow = "hidden";
            (svgIcon.id = "itemplaceholder-" + this.groupindex + "_" + this.index + "-" + iconCount), svgIcon.setAttribute("data-type", "IMAGE");
            svgIcon.style.borderRadius = "50%";
            svgIcon.classList.add("th-section" + customColorIndex);
            svgIcon.style.width = this.data.SVGUtils.createPercentValue(iconGraphicwidth, this.iconWH);
            svgIcon.style.height = this.data.SVGUtils.createPercentValue(iconGraphicHeight, this.iconWH);
            if (iconCount < currentValueCount) baseParentSvg.appendChild(svgIcon);
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "data-animation": "item" + (this.groupindex + 1),
                "data-graphic-x": 0,
                "data-graphic-y": 0,
                "data-iconanimation": "true",
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
            });
            let imageNode = document.createElement("img");
            imageNode.style.width = "100%";
            (imageNode.id = "itemplaceholder-" + this.groupindex + "_" + this.index + "-" + iconCount), imageNode.setAttribute("data-type", "IMAGE");
            imageNode.src = this.data.itemImagePlaceHolder[this.groupindex][iconCount];
            imageNode.style.height = "100%";
            imageNode.setAttribute("data-iconcount", iconCount);
            svgIcon.appendChild(imageNode);
            if (this.data.itemImagePlaceHolder[this.groupindex][iconCount].includes("placeholder.png")) {
                imageNode.setAttribute("has-image", "true");
            }
            let item = this.ChartUtils.getOffsetLeftTop(svgIcon, "SLIDE", true);
            svgIcon.setAttribute("data-x", item.x);
            svgIcon.setAttribute("data-y", item.y);
            svgIcon.setAttribute("data-width", svgIcon.clientWidth);
            svgIcon.setAttribute("data-height", svgIcon.clientHeight);
            imageNode.setAttribute("data-width", svgIcon.clientWidth);
            imageNode.setAttribute("data-height", svgIcon.clientHeight);
            imageNode.setAttribute("data-imagepath", this.data.itemImagePlaceHolder[this.groupindex][iconCount]);

            imageNode.setAttribute("data-x", item.x);
            imageNode.setAttribute("data-y", item.y);
            this.ChartUtils.updateImageReSize(svgIcon.clientWidth, svgIcon.clientHeight, imageNode, "", "img");

            let overlayDiv = this.ChartHelper.createDivElement({});
            overlayDiv.style.opacity = "0.5";
            overlayDiv.style.width = "100%";
            overlayDiv.style.height = "100%";
            overlayDiv.style.position = "absolute";
            overlayDiv.style.pointerEvents = "none";
            overlayDiv.className = this.ChartFonts.graphicBgColor(0);
            svgIcon.appendChild(overlayDiv);
            iconCount++;
            //this.gerRowHeight(firstValue,secondValue,thirdValue,fourthValue,iconCount,colorCount,i1,i2,columnCount,totalCount)
        }
    }
};
SimpleIconFillColumnSeriesItem.prototype.getPlaceHolderUrl = function (groupindex, totalCount) {
    let arrPlaceholder = this.ChartHelper.getItemImagePlaceHolderPath(this.data.data, this.data.serverUrl, groupindex, totalCount);
    this.data.itemImagePlaceHolder[groupindex] = arrPlaceholder;
};

SimpleIconFillColumnSeriesItem.prototype.getColorCount = function (fValue, sValue, Tvalue, Fovalue, iconCount, colorCount, row) {
    if (fValue < iconCount && colorCount == 1 && this.data.seriesItemLength > 0 && fValue != 0) {
        return 2;
    } else if (fValue + sValue < iconCount && colorCount == 2 && this.data.seriesItemLength > 1 && sValue != 0) {
        return 3;
    } else if (fValue + sValue + Tvalue < iconCount && colorCount == 3 && this.data.seriesItemLength > 2 && Tvalue != 0) {
        return 4;
    } else if (fValue + sValue + Tvalue + Fovalue < iconCount && this.data.seriesItemLength > 3 && Fovalue != 0) {
        return 5;
    } else return colorCount;
};
SimpleIconFillColumnSeriesItem.prototype.gerRowHeight = function (fValue, sValue, Tvalue, Fovalue, iconCount, colorCount, row, columnindex, columnLength, totalCount) {
    let rowvalue = 0;
    let rowCount = 0;
    if (fValue < iconCount && colorCount == 1 && this.data.seriesItemLength > 0) {
        this.sameColumn = columnindex < columnLength - 2;
        rowCount = row + 1 - 1 == 0 ? 1 : row + 1 - 0;
        if (this.arrRowHeight.length < 1) this.arrRowHeight.push({ startow: 1, endrow: row + 1, rowTotalCount: rowCount });
    } else if (fValue + sValue < iconCount && colorCount == 2 && this.data.seriesItemLength > 1) {
        if (this.sameColumn) {
            rowvalue = this.arrRowHeight[0].endrow;
        } else {
            rowvalue = this.arrRowHeight[0].endrow + 1;
        }
        rowCount = row + 1 - rowvalue == 0 ? 1 : row + 1 - rowvalue;
        if (this.arrRowHeight.length < 2) this.arrRowHeight.push({ startow: rowvalue, endrow: row + 1, rowTotalCount: rowCount });
        this.sameColumn = columnindex < columnLength - 2;
        return 3;
    } else if (fValue + sValue + Tvalue < iconCount && colorCount == 3 && this.data.seriesItemLength > 2) {
        if (this.sameColumn) {
            rowvalue = this.arrRowHeight[0].endrow;
        } else {
            rowvalue = this.arrRowHeight[0].endrow + 1;
        }
        rowCount = row + 1 - rowvalue == 0 ? 1 : row + 1 - rowvalue;
        if (this.arrRowHeight.length < 3) this.arrRowHeight.push({ startow: rowvalue, endrow: row + 1, rowTotalCount: rowCount });
        this.sameColumn = columnindex < columnLength - 2;
        return 4;
    } else if (fValue + sValue + Tvalue + Fovalue < iconCount && this.data.seriesItemLength > 3) {
        if (this.sameColumn) {
            rowvalue = this.arrRowHeight[0].endrow;
        } else {
            rowvalue = this.arrRowHeight[0].endrow + 1;
        }
        rowCount = row + 1 - rowvalue == 0 ? 1 : row + 1 - rowvalue;
        if (this.arrRowHeight.length < 4) this.arrRowHeight.push({ startow: rowvalue, endrow: row + 1, rowTotalCount: rowCount });
        this.sameColumn = columnindex < columnLength - 2;
        return 5;
    } else if (totalCount == iconCount) {
        if (this.sameColumn) {
            rowvalue = this.arrRowHeight[0].endrow;
        } else {
            rowvalue = this.arrRowHeight[0].endrow + 1;
        }
        rowCount = row + 1 - rowvalue == 0 ? 1 : row + 1 - rowvalue;
        if (this.arrRowHeight.length < 4) this.arrRowHeight.push({ startow: rowvalue, endrow: row + 1, rowTotalCount: rowCount });
        this.sameColumn = columnindex < columnLength - 2;
    }
};

var lastChild1;
var lastChild2;
var lastChild3;
var coinAlignStyle;
var coinimg = [];
var defaultnodegap = 15;
var nodegap = -defaultnodegap;
var chartParentNode;
var chartMainCount = 0;

function coinColumnAnimation() {
    this.slideID = "";
}

coinColumnAnimation.prototype.requestAnimFrame = (function (callback) {
    return (
        window.requestAnimationFrame ||
        window.webkitRequestAnimationFrame ||
        window.mozRequestAnimationFrame ||
        window.oRequestAnimationFrame ||
        window.msRequestAnimationFrame ||
        function (callback) {
            window.setTimeout(callback, 1000);
        }
    );
})();
coinColumnAnimation.prototype.test = function (targetId) {
    chartParentNode.querySelector(targetId).coinAnimation.setValue(100);
};

coinColumnAnimation.prototype.CoinStackBar = function (parentElement, index, value, containerwidth, containerheight, coinalignstyle = "normal", coinanimation = false, imageurl, length, lineCoin = false, slideIDvalue) {
    coinimg[0] = imageurl;
    if (index == 1) {
        chartMainCount = 0;
    }
    chartParentNode = parentElement;
    this.slideID = slideIDvalue;
    var targetId = "#CoinStackBar" + index;
    chartParentNode.querySelector("#CoinStackBarHolder" + index).style.position = "relative";
    chartParentNode.querySelector("#CoinStackBarHolder" + index).style.height = "100%";
    chartParentNode.querySelector("#CoinStackBarHolder" + index).style.width = containerwidth + "px";
    chartParentNode.querySelector(targetId).innerHTML = "";
    var width = 100 / containerwidth;
    var totalCount = parseInt(containerheight / 16.66) * width;
    var stackheight = (totalCount / 100) * value;
    this.compareLine = lineCoin;
    coinAlignStyle = coinalignstyle;
    coinAnimation = coinanimation;
    let o = {
        container: chartParentNode.querySelector(targetId),
        coinimgsrc: coinimg,
        coinimgwidth: 200,
        coinimgheight: 100,
        coinheight: 30,
        xoffset: 6,
        startvalue: 0,
        maxstackheight: stackheight,
        containerwidth: containerwidth,
        containerheight: containerheight,
    };
    (this.container = o.container), (this.coinimgsrc = o.coinimgsrc);
    this.coinimgwidth = o.coinimgwidth || 1;
    this.coinimgheight = o.coinimgheight || 1;
    this.coinheight = o.coinheight || 1;
    this.min = o.min || 0;
    this.max = o.max || 100;
    this.value = 0;
    this.maxstackheight = o.maxstackheight == 0 ? o.maxstackheight : o.maxstackheight || 10;
    this.xoffset = o.xoffset || 10;
    this.yoffset = o.yoffset || 5;
    this.setDimensions(o.containerwidth, o.containerheight);
    this.seed = o.seed || Math.random();
    if (o.reseed == "aways" || o.reseed == "never" || o.reseed == "onzero") {
        this.reseed = o.reseed;
    } else {
        this.reseed = "always";
    }
    this.coineffectduration = o.coineffectduration || 300;
    if (typeof o.showshadow != "undefined") {
        this.showshadow = o.showshadow;
    } else {
        this.showshadow = true;
    }
    this.coinanimxdrop = o.coinanimxdrop || 0;
    this.coinanimydrop = o.coinanimydrop || 300;
    this.coins = [];
    this.updateCoin = true;
    this.containerheight = (this.coinimgheight + this.maxstackheight * this.coinheight) * this.stacksize;
    this.containerwidth = (this.coinimgwidth + 2 * this.xoffset) * this.stacksize;
    this.container.style.height = this.containerheight + "px";
    this.container.style.width = this.containerwidth + "px";
    this.container.coinAnimation = this;
    this.setValue(o.startvalue || 0);
    this.update();
    this.test(targetId);
};
function rand(val, seed) {
    return Math.cos(val * Math.cos(val * seed));
}

coinColumnAnimation.prototype.setDimensions = function (containerwidth, containerheight) {
    var picksmaller = "";
    var widthsize = containerwidth / this.coinimgwidth;
    var heightsize = containerheight / (this.coinimgheight + this.maxstackheight * this.coinheight);
    if (typeof containerwidth != "undefined" && typeof containerheight != "undefined") {
        if (widthsize < heightsize) {
            picksmaller = "width";
        } else {
            picksmaller = "width";
        }
    }
    if (typeof containerwidth == "undefined" || picksmaller == "height") {
        this.stacksize = heightsize;
    } else if (typeof containerheight == "undefined" || picksmaller == "width") {
        this.stacksize = widthsize;
    } else {
        this.stacksize = 1;
    }
};
coinColumnAnimation.prototype.updateMinMax = function (newmin, newmax) {
    if (typeof newmin != "undefined") {
        this.min = newmin;
    }
    if (typeof newmax != "undefined") {
        this.max = newmax;
    }
};
coinColumnAnimation.prototype.setValue = function (value, newmin, newmax) {
    if (typeof newmin != "undefined" || typeof newmax != "undefined") {
        this.updateMinMax(newmin, newmax);
    }
    var clamped = Math.min(Math.max(value, this.min), this.max);
    if (clamped == this.value) {
        return false;
    }
    var coins = Math.round((clamped / this.max) * this.maxstackheight);
    var oldcoins = Math.round((this.value / this.max) * this.maxstackheight);
    if (this.reseed == "always" || (coins == 0 && oldcoins != 0 && this.reseed == "onzero")) {
        this.seed = rand(this.seed, this.seed + 1);
    }
    if (coins > oldcoins) {
        for (var i = oldcoins; i < coins; i++) {
            this.createNewCoin(i, i - oldcoins);
        }
    } else if (coins < oldcoins) {
        for (var i = oldcoins; i >= coins; i--) {
            this.fadeOutCoin(i, oldcoins - i);
        }
    }
    this.value = clamped;
    return true;
};
coinColumnAnimation.prototype.createNewCoin = function (i, durationoffset) {
    var coinelem = document.createElement("img");
    if (Object.prototype.toString.call(this.coinimgsrc) === "[object Array]") {
        var index = Math.floor(Math.abs(rand(i + 1, this.seed) * this.coinimgsrc.length));
        coinelem.src = this.coinimgsrc[index];
    } else {
        coinelem.src = this.coinimgsrc;
    }
    if (i == 0) nodegap = -defaultnodegap;
    nodegap = nodegap + defaultnodegap;
    var coinxpos = +rand(i, this.seed) * (this.xoffset * this.stacksize);
    var coinypos = nodegap;

    coinelem.style.position = "absolute";
    coinelem.style.width = this.coinimgwidth * this.stacksize < 100 ? 100 + "px" : this.coinimgwidth * this.stacksize + "px";
    coinelem.style.height = this.coinimgheight * this.stacksize + "px";
    coinelem.style.opacity = 0;
    this.container.appendChild(coinelem);
    var starttime = Date.now();
    if (this.coins.length > 0) {
        if (coinAnimation == true) {
            starttime = Math.max(this.coins[this.coins.length - 1].starttime + this.coineffectduration * 0.15, starttime);
        } else {
            starttime = 0;
        }
    }
    this.coins.push({
        element: coinelem,
        starttime: starttime,
        xpos: coinxpos,
        slideid: this.slideID,
        ypos: coinypos,
        xstart: this.coinanimxdrop,
        ystart: this.coinanimydrop,
        duration: this.coineffectduration,
        status: "fadein",
    });
};
coinColumnAnimation.prototype.fadeOutCoin = function (i, durationoffset) {
    if (this.coins[i] && this.coins[i].status != "fadeout") {
        this.coins[i].starttime = Date.now() + durationoffset * this.coins[i].duration * 0.3;
        this.coins[i].status = "fadeout";
    }
};
coinColumnAnimation.prototype.removeCoin = function (i) {
    var coins = this.container.getElementsByTagName("img");
    if (coins[i]) {
        this.container.removeChild(coins[i]);
        if (this.coins[i]) {
            this.coins.splice(i, 1);
        }
    }
};
coinColumnAnimation.prototype.update = function () {
    if (this.coins.length > 0) {
        this.coins.forEach(function (coin, key, CoinStackBar) {
            if (coin.slideid == this.slideID) {
                var animframe = 1.0 - (coin.starttime + coin.duration - Date.now()) / coin.duration;
                animframe = Math.max(Math.min(1, animframe), 0);
                if (coin.status == "fadein") {
                    if (coinAlignStyle != "normal") {
                        coin.element.style.left = coin.xpos + coin.xstart * (1.0 - animframe) * this.stacksize + "px";
                    } else {
                        coin.element.style.left = "0px";
                    }

                    coin.element.style.bottom = coin.ypos + coin.ystart * (1.0 - animframe) * this.stacksize + "px";
                    let parentHeight = parseFloat(coin.element.parentNode.style.height);
                    let elementHeight = parseInt(this.coins[key].element.style.height);
                    let bottomValue = parseInt(coin.element.style.bottom);
                    coin.element.style.opacity = animframe;
                    let differenceValue = key > 0 ? parseFloat(this.coins[1].element.style.bottom) - parseFloat(this.coins[0].element.style.bottom) : elementHeight;
                    if (parentHeight < bottomValue + differenceValue && this.coins.length > 1) {
                        coin.element.style.opacity = "0";
                    }
                    // if (animframe >= 1) {
                    //     coin.status = "idle";
                    // }
                }
                if (coin.status == "fadeout") {
                    if (coinAlignStyle != "normal") {
                        coin.element.style.left = coin.xpos + coin.xstart * (1.0 - animframe) * this.stacksize + "px";
                    } else {
                        coin.element.style.left = "0px";
                    }
                    coin.element.style.bottom = coin.ypos + coin.ystart * animframe * this.stacksize + "px";
                    coin.element.style.opacity = 1.0 - animframe;
                    if (animframe >= 1) {
                        this.removeCoin(key);
                    }
                    if (this.coins[key - 1]) {
                        coin.element.style.opacity = Math.min(coin.element.style.opacity, CoinStackBar[key - 1].element.style.opacity);
                    }
                    let parentHeight = parseFloat(coin.element.parentNode.style.height);
                    let elementHeight = parseInt(this.coins[key].element.style.height);
                    let bottomValue = parseInt(coin.element.style.bottom);
                    coin.element.style.opacity = animframe;
                    let differenceValue = key > 0 ? parseFloat(this.coins[1].element.style.bottom) - parseFloat(this.coins[0].element.style.bottom) : elementHeight;
                    if (parentHeight < bottomValue + differenceValue && this.coins.length > 1) {
                        coin.element.style.opacity = "0";
                    }
                }
                if (key == this.coins.length - 1) {
                    if (!coinAnimation) this.updateCoin = false;
                    else if (this.coins[key].element.style.opacity == "1" && coinAnimation) this.updateCoin = false;
                    if (!this.compareLine) {
                        let coinBottom = parseInt(this.coins[key].element.style.bottom);
                        let CoinHeight = parseInt(this.coins[key].element.style.height);
                        this.coins[key].element.parentNode.parentNode.parentNode.parentNode.style.height = coinBottom + CoinHeight + "px";
                    }
                }
            }
        }, this);
        chartMainCount++;
    }
    var self = this;
    var requestAnimFrame = (function (callback) {
        return window.requestAnimationFrame || callback();
    })();
    requestAnimFrame(function () {
        if (self.updateCoin) {
            self?.update();
        }
    });
};


