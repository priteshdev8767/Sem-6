            titleFontSizeList = this.FloaterPropertyObjects.HEAD_FONT_STYLING;
            for (let i = 0; i < titleFontSizeList.length; i++) {
                dpTitleFontSize.push(titleFontSizeList[i]);
            }
            let selectedIndex = this.getSelectedIndex(dpTitleFontSize, metaData.children[index].getAttribute("labeltextfontsize"), 0);
            let textselectedIndex = this.getSelectedIndex(textSize["dpsource"], metaData.children[0].getAttribute("labeltexttextsize"), 0);
            textSize["selectedindex"] = textselectedIndex;
            fontListing["dpsource"] = dpTitleFontSize;
            fontListing["selectedindex"] = selectedIndex;
            fontListing["elementvalue"] = "labeltextdynamicalign";
            textSize["elementvalue"] = "labeltextdynamicalign";
            textBold["elementvalue"] = "labeltextdynamicalign";
