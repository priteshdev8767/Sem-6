function VOLayout(argProps, xmlData, objMenu, slide, voBaseProperties, mooddata, hasDirection) {
    this.ChartHelper = new window["ChartHelper"]();
    this.data = argProps ? argProps : {};
    this.xmlData = xmlData;
    this.gridValueSize = 20;
    this.axisLineThickness = 0;
    this.gridLineThickness = 1;
    this.seriesViewPercentage = 100;
    this.legendAlignment = [];
    this._itemLayoutData = [];
    this.disableMultiSeries = false;
    this.arrplacholderGlopalStyle = [];
    let boolMultiSeries = false;
    if (this.data && this.data.label) {
        this.axisLabelRotation = false;
        this.labelHPosition = this.data.label.hasOwnProperty("position") ? (this.data.label.position.length > 0 ? this.data.label.position[0] : "") : "";
        this.labelVPosition = this.data.label.hasOwnProperty("position") ? (this.data.label.position.length > 1 ? this.data.label.position[1] : "") : "";
        this.showLabel = this.data.label.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.label.show) : true;
        this.labelInset = this.data.label.hasOwnProperty("position") ? (this.data.label.position.length > 2 ? this.data.label.position[2] : false) : false;
        this.labelItemBaseHPos = this.data.label.hasOwnProperty("itemBasedHPos") ? this.data.label.itemBasedHPos : false;
        this.labelItemBaseVPos = this.data.label.hasOwnProperty("itemBasedVPos") ? this.data.label.itemBasedVPos : false;
        this.labelPosIndex = this.data.label.hasOwnProperty("posindex") ? this.data.label.posindex : 0;
        this.labelCallout = this.data.label.hasOwnProperty("callout") ? this.data.label.callout : "";
        this.labelSamePos = this.data.label.hasOwnProperty("posindex") ? "true" : "";
        this.labelItemBased = this.data.label.hasOwnProperty("itembased") ? this.data.label.itembased : "";
        this.labeltextbg = this.data.label.hasOwnProperty("textbg") ? "true" : "";
        this.labeltextbgstyle = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.style : "";
        this.labeltextbgcallout = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.callout : "";
        this.labeltextbgItem = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.bgitem : "";

        this.labelPaddingleft = this.data.label.hasOwnProperty("padding") ? (this.data.label.padding.length > 3 ? parseFloat(this.data.label.padding[3]) : "") : "";
        this.labelPaddingright = this.data.label.hasOwnProperty("padding") ? (this.data.label.padding.length > 1 ? parseFloat(this.data.label.padding[1]) : "") : "";
        this.labelPaddingtop = this.data.label.hasOwnProperty("padding") ? (this.data.label.padding.length > 0 ? parseFloat(this.data.label.padding[0]) : "") : "";
        this.labelPaddingbottom = this.data.label.hasOwnProperty("padding") ? (this.data.label.padding.length > 2 ? parseFloat(this.data.label.padding[2]) : "") : "";
        this.labelPadding = this.data.label.hasOwnProperty("padding") ? { left: this.labelPaddingleft, right: this.labelPaddingright, top: this.labelPaddingtop, bottom: this.labelPaddingbottom } : "";
        this.labelPaddingClass = this.data.label.hasOwnProperty("padding") && this.isString(this.data.label.padding) ? this.data.label.padding : "";
        this.labelAlterPaddingClass = this.labelPaddingClass ? this.createAlterClass(this.labelPaddingClass) : "";

        this.labeloverlap = this.data.label.hasOwnProperty("overlap") ? this.data.label.overlap : "";
        this.labelalterpos = this.data.label.hasOwnProperty("alteralign") ? this.data.label.alteralign : "";
        this.labelInterchange = this.data.label.hasOwnProperty("verticalalign") ? this.data.label.verticalalign : "";
        this.labelColor = this.data.label.hasOwnProperty("color") ? this.data.label.color : "";
        this.labelfontsize = this.data.label.hasOwnProperty("fontsize") ? this.data.label.fontsize : "";
        this.labelshadow = this.data.label.hasOwnProperty("shadow") ? "true" : "";
        this.labelShadowClass = this.data.label.hasOwnProperty("shadow") ? this.data.label.shadow : "l";
        if (this.data.label.hasOwnProperty("shape") && Object.keys(this.data.label.shape).length != 0) {
            this.boollabelbgShape = true;
            this.labelbgShapeType = this.data.label.shape.hasOwnProperty("type") ? this.data.label.shape.type : "";
            this.labelbgStyle = this.data.label.shape.hasOwnProperty("style") ? this.data.label.shape.style : "";
            this.labelbgBorderSize = this.data.label.shape.hasOwnProperty("bordersize") ? this.data.label.shape.bordersize : "";
            this.labelbgBorderColor = this.data.label.shape.hasOwnProperty("bordercolor") ? this.data.label.shape.bordercolor : "";
            this.labelbgBgColor = this.data.label.shape.hasOwnProperty("fillcolor") ? this.data.label.shape.fillcolor : "";
            this.labelbgRadius = this.data.label.shape.hasOwnProperty("radius") ? this.data.label.shape.radius : "";
            this.labelbgOpacity = this.data.label.shape.hasOwnProperty("fillopacity") ? this.data.label.shape.fillopacity : "";
            this.labelBgBorderOpacity = this.data.label.shape.hasOwnProperty("borderopacity") ? this.data.label.shape.borderopacity : "";
        }
        this.labelGradientValues = this.createGradientValue(this.data.label) ? this.createGradientValue(this.data.label).strgradientValue : "";
        this.labelGradientDatas = this.createGradientValue(this.data.label) ? this.createGradientValue(this.data.label).gridvalues : "";
        this.labelHeaderTitle = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.label.header.show) : false;
        this.labelHeaderPosition = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("position") ? this.data.label.header.position : "";
        this.labelHeaderIndex = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("index") ? this.data.label.header.index : "0";
        this.labelHeaderHPosition = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("halign") ? this.data.label.header.halign : "left";
        this.haslabelHeaderTitle = this.data.label.hasOwnProperty("header");
        this.labelHeaderPaddingClass = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("padding") ? this.data.label.header.padding : "";
        this.labelHeaderColor = this.data.label.hasOwnProperty("header") && this.data.label.header.hasOwnProperty("color") ? this.data.label.header.color : "";
        this.compareLabel = this.data.label.hasOwnProperty("comparelabel") ? this.data.label.comparelabel : "";
        // this.labelPaddingClass = "clsPaddingTop16"
        // this.labelAlterPaddingClass = "clsPaddingTop16Alter";
        // this.labelPaddingleft = "";
        // this.labelPaddingright = "";
        // this.labelPaddingtop = "";
        // this.labelPaddingbottom ="";
        // this.labelPadding ={ "left": this.labelPaddingleft, "right": this.labelPaddingright, "top": this.labelPaddingtop, "bottom": this.labelPaddingbottom };
    }
    if (this.data && this.data.commonplaceholder && this.data.commonplaceholder.content) {
        xmlData.setAttribute("data-commonplaceholder", "true");
        let placHolderType = xmlData.getAttribute("commonplaceholdertype") ? xmlData.getAttribute("commonplaceholdertype") : this.data.commonplaceholder.content;
        xmlData.setAttribute("commonplaceholdertype", placHolderType);
    }
    if (this.data && this.data.value) {
        this.valueHPosition = this.data.value.hasOwnProperty("position") ? (this.data.value.position.length > 0 ? this.data.value.position[0] : "") : "";
        this.valueVPosition = this.data.value.hasOwnProperty("position") ? (this.data.value.position.length > 1 ? this.data.value.position[1] : "") : "";
        this.showValue = this.data.value.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.value.show) : true;
        this.valueInset = this.data.value.hasOwnProperty("position") ? (this.data.value.position.length > 2 ? this.data.value.position[2] : "outer") : "outer";
        this.valueItemBaseHPos = this.data.value.hasOwnProperty("itemBasedHPos") ? this.data.value.itemBasedHPos : false;
        this.valueItemBaseVPos = this.data.value.hasOwnProperty("itemBasedVPos") ? this.data.value.itemBasedVPos : false;
        this.valuePosIndex = this.data.value.hasOwnProperty("posindex") ? this.data.value.posindex : 0;
        this.valueSamePos = this.data.value.hasOwnProperty("posindex") ? "true" : "";
        this.valueItemBased = this.data.value.hasOwnProperty("itembased") ? this.data.value.itembased : "";
        this.valuetextbg = this.data.value.hasOwnProperty("textbg") ? "true" : "";
        this.valuetextbgstyle = this.data.value.hasOwnProperty("textbg") && this.data.value.textbg.length > 1 ? this.data.value.textbg[1] : "";
        this.valuetextbgcallout = this.data.value.hasOwnProperty("textbg") && this.data.value.textbg.length > 2 ? this.data.value.textbg[2] : "";
        this.valuetextbgItem = this.data.value.hasOwnProperty("textbg") && this.data.value.textbg.length > 3 ? this.data.value.textbg[3] : "";
        this.valuePaddingleft = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 3 ? parseFloat(this.data.value.padding[3]) : "") : "";
        this.valuePaddingright = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 1 ? parseFloat(this.data.value.padding[1]) : "") : "";
        this.valuePaddingtop = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 0 ? parseFloat(this.data.value.padding[0]) : "") : "";
        this.valuePaddingbottom = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 2 ? parseFloat(this.data.value.padding[2]) : "") : "";
        this.valuePadding = this.data.value.hasOwnProperty("padding") ? { left: this.valuePaddingleft, right: this.valuePaddingright, top: this.valuePaddingtop, bottom: this.valuePaddingbottom } : "";
        this.valuePaddingClass = this.data.value.hasOwnProperty("padding") && this.isString(this.data.value.padding) ? this.data.value.padding : "";
        this.valueAlterPaddingClass = this.valuePaddingClass ? this.createAlterClass(this.valuePaddingClass) : "";

        this.valueoverlap = this.data.value.hasOwnProperty("overlap") ? this.data.value.overlap : "";
        this.valuealterpos = this.data.value.hasOwnProperty("alteralign") ? this.data.value.alteralign : "";
        this.valuefontsize = this.data.value.hasOwnProperty("fontsize") ? this.data.value.fontsize : "";
        this.valueshadow = this.data.value.hasOwnProperty("shadow") ? "true" : "";
        this.valueShadowClass = this.data.value.hasOwnProperty("shadow") ? this.data.value.shadow : "s";
        this.valueInterchange = this.data.value.hasOwnProperty("verticalalign") ? this.data.value.verticalalign : "";
        this.valueColor = this.data.value.hasOwnProperty("color") ? this.data.value.color : "";
        this.valuebgBorder = this.data.value.hasOwnProperty("bgborder") ? this.data.value.bgborder : "";
        this.valueGlobalstyle = this.data.value.hasOwnProperty("globalstyle") ? this.data.value.globalstyle : "";

        this.showDataPoints = this.data.value.hasOwnProperty("order") ? this.data.value.order : "";
        if (this.showDataPoints) {
            let boolformat = this.xmlData.getAttribute("displayvalue");
            if (!boolformat) {
                switch (this.showDataPoints) {
                    case "first":
                        this.xmlData.setAttribute("displayvalue", "F");
                        break;
                    case "last":
                        this.xmlData.setAttribute("displayvalue", "L");
                        break;
                    case "firstandlast":
                        this.xmlData.setAttribute("displayvalue", "FL");
                        break;
                    case "all":
                        this.xmlData.setAttribute("displayvalue", "all");
                        break;
                    case "high":
                        this.xmlData.setAttribute("displayvalue", "H");
                        break;
                    case "low":
                        this.xmlData.setAttribute("displayvalue", "LO");
                        break;
                    case "highandlow":
                        this.xmlData.setAttribute("displayvalue", "L,H");
                        break;
                    case "none":
                        this.xmlData.setAttribute("displayvalue", "none");
                        break;
                }
            }
        }
        if (this.data.value.hasOwnProperty("shape") && Object.keys(this.data.value.shape).length != 0) {
            this.boolvaluebgShape = true;
            this.valuebgShapeType = this.data.value.shape.hasOwnProperty("type") ? this.data.value.shape.type : "";
            this.valuebgStyle = this.data.value.shape.hasOwnProperty("style") ? this.data.value.shape.style : "";
            this.valuebgBorderSize = this.data.value.shape.hasOwnProperty("bordersize") ? this.data.value.shape.bordersize : "";
            this.valuebgBorderColor = this.data.value.shape.hasOwnProperty("bordercolor") ? this.data.value.shape.bordercolor : "";
            this.valuebgBgColor = this.data.value.shape.hasOwnProperty("fillcolor") ? this.data.value.shape.fillcolor : "";
            this.valuebgRadius = this.data.value.shape.hasOwnProperty("radius") ? this.data.value.shape.radius : "";
            this.valuebgOpacity = this.data.value.shape.hasOwnProperty("fillopacity") ? this.data.value.shape.fillopacity : "";
            this.valueBgBorderOpacity = this.data.value.shape.hasOwnProperty("borderopacity") ? this.data.value.shape.borderopacity : "";
            this.valueShapeHeight = this.data.value.shape.hasOwnProperty("size") && this.data.value.shape.size.length > 0 ? this.data.value.shape.size[0] : "";
            this.valueShapeWidth = this.data.value.shape.hasOwnProperty("size") && this.data.value.shape.size.length > 1 ? this.data.value.shape.size[1] : "";
            this.valueShapeShadowValues = this.data.value.shape.hasOwnProperty("shadow") ? this.data.value.shape.shadow : "";
        }
        this.valueGradientValues = this.createGradientValue(this.data.value) ? this.createGradientValue(this.data.value).strgradientValue : "";
        this.valueGradientDatas = this.createGradientValue(this.data.value) ? this.createGradientValue(this.data.value).gridvalues : "";
        this.hasValueHeaderTitle = this.data.value.hasOwnProperty("header");
        this.valueHeaderTitle = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.value.header.show) : false;
        this.valueHeaderPosition = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("position") ? this.data.value.header.position : "";
        this.valueHeaderIndex = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("index") ? this.data.value.header.index : "0";

        this.valueCalculateTitle = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("calculatevalue") ? this.data.value.header.calculatevalue : "";
        if (this.valueCalculateTitle) {
            console.log("sadasdasd");
        }
        this.valueHeaderHPosition = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("halign") ? this.data.value.header.halign : "right";
        this.valueHeaderPaddingClass = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("padding") ? this.data.value.header.padding : "";
        this.valueHeaderColor = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("color") ? this.data.value.header.color : this.labelHeaderColor ? this.labelHeaderColor : "";
        this.singlevalueColumn = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("valuesinglecolumn") ? this.data.value.header.valuesinglecolumn : "";
        if (this.singlevalueColumn == "true") {
            this.valueInset = "bgoutside";
        }
        // this.valuePaddingClass = "clsPaddingTop16"
        // this.valueAlterPaddingClass = "clsPaddingTop16Alter";
        // this.valuePaddingleft = "";
        // this.valuePaddingright = "";
        // this.valuePaddingtop = "";
        // this.valuePaddingbottom = "";
        // this.valuePadding =  { "left": this.valuePaddingleft, "right": this.valuePaddingright, "top": this.valuePaddingtop, "bottom": this.valuePaddingbottom }
        if (!this.data.value.hasOwnProperty("header")) {
            this.valueHeaderIndex = 1;
        }
    }
    let chartName = this.xmlData.getAttribute("name");
    if (chartName == "fillcompareChart" || chartName == "barcomparisonmodel") {
        this.labelInset = this.labelInset == "outer" ? false : this.labelInset;
        this.valueInset = this.valueInset == "outer" ? false : this.valueInset;
    }
    if (voBaseProperties && chartName == "columnSimpleRectangle" && (this.valueItemBased == "true" || this.labelItemBased == "true")) {
        voBaseProperties.maxAllowedSeriesItems = 1;
        this.disableMultiSeries = true;
    }
    if (this.data && this.data.placeholder) {
        this.placeholderHPosition = this.data.placeholder.hasOwnProperty("position") ? (this.data.placeholder.position.length > 0 ? this.data.placeholder.position[0] : "") : "";
        this.placeholderVPosition = this.data.placeholder.hasOwnProperty("position") ? (this.data.placeholder.position.length > 1 ? this.data.placeholder.position[1] : "") : "";
        this.showPlaceholder = this.data.placeholder.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.placeholder.show) : true;
        this.placeholderInset = this.data.placeholder.hasOwnProperty("position") ? (this.data.placeholder.position.length > 2 ? this.data.placeholder.position[2] : false) : false;
        this.placeholderItemBaseHPos = this.data.placeholder.hasOwnProperty("itemBasedHPos") ? this.data.placeholder.itemBasedHPos : false;
        this.placeholderItemBaseVPos = this.data.placeholder.hasOwnProperty("itemBasedVPos") ? this.data.placeholder.itemBasedVPos : false;
        this.placeholderPosIndex = this.data.placeholder.hasOwnProperty("posindex") ? this.data.placeholder.posindex : 0;
        this.placeholderSamePos = this.data.placeholder.hasOwnProperty("posindex") ? "true" : "";
        this.placeholderItemBased = this.data.placeholder.hasOwnProperty("itembased") ? this.data.placeholder.itembased : "";
        this.placeholdertextbg = this.data.placeholder.hasOwnProperty("textbg") ? "true" : "";
        this.placeholdertextbgstyle = this.data.placeholder.hasOwnProperty("textbg") && this.data.placeholder.textbg.length > 0 ? this.data.placeholder.textbg[0] : "";
        this.placeholdertextbgcallout = this.data.placeholder.hasOwnProperty("textbg") && this.data.placeholder.textbg.length > 1 ? this.data.placeholder.textbg[1] : "";
        this.placeholdertextbgItem = this.data.placeholder.hasOwnProperty("textbg") && this.data.placeholder.textbg.length > 2 ? this.data.placeholder.textbg[2] : "";
        this.placeholderPaddingleft = this.data.placeholder.hasOwnProperty("padding") ? (this.data.placeholder.padding.length > 3 ? this.data.placeholder.padding[3] : "") : "";
        this.placeholderPaddingright = this.data.placeholder.hasOwnProperty("padding") ? (this.data.placeholder.padding.length > 1 ? this.data.placeholder.padding[1] : "") : "";
        this.placeholderPaddingtop = this.data.placeholder.hasOwnProperty("padding") ? (this.data.placeholder.padding.length > 0 ? this.data.placeholder.padding[0] : "") : "";
        this.placeholderPaddingbottom = this.data.placeholder.hasOwnProperty("padding") ? (this.data.placeholder.padding.length > 2 ? this.data.placeholder.padding[2] : "") : "";
        this.placeholderPadding = this.data.placeholder.hasOwnProperty("padding") ? { left: this.data.placeholderPaddingleft, right: this.data.placeholderPaddingright, top: this.data.placeholderPaddingtop, bottom: this.data.placeholderPaddingbottom } : "";
        this.placeholderPaddingClass = this.data.placeholder.hasOwnProperty("padding") && this.isString(this.data.placeholder.padding) ? this.data.placeholder.padding : "";
        this.placeholderAlterPaddingClass = this.data.placeholder.hasOwnProperty("padding") && this.isString(this.data.placeholder.padding) ? this.createAlterClass(this.placeholderPaddingClass) : "";
        this.placeholderoverlap = this.data.placeholder.hasOwnProperty("overlap") ? this.data.placeholder.overlap : "";
        this.placeholdertype = this.data.placeholder.hasOwnProperty("type") ? this.data.placeholder.type : "";
        this.placeholderalterpos = this.data.placeholder.hasOwnProperty("alteralign") ? this.data.placeholder.alteralign : "";
        this.boolDefaultPlaceHolder = this.data.placeholder.hasOwnProperty("default") ? this.data.placeholder.default : "";
        this.placholderWidth = this.data.placeholder.hasOwnProperty("size") && this.data.placeholder.size.length > 0 ? this.data.placeholder.size[0] : "";
        this.placholderHeight = this.data.placeholder.hasOwnProperty("size") && this.data.placeholder.size.length > 1 ? this.data.placeholder.size[1] : "";
        this.placholderGlopalStyle = "";
        this.tempPlacholderGlopalStyle = this.data.placeholder.hasOwnProperty("globalstyle") ? this.data.placeholder.globalstyle : "";
        this.arrplacholderGlopalStyle = this.tempPlacholderGlopalStyle ? this.tempPlacholderGlopalStyle.split(" ") : [];
        if (this.xmlData.getAttribute("primaryplaceholder-type") && !this.placeholdertype) {
            this.placeholdertype = this.xmlData.getAttribute("primaryplaceholder-type");
        }
        if (this.tempPlacholderGlopalStyle && this.tempPlacholderGlopalStyle.split(" ").length < 3) {
            let arrclassDeatils = this.tempPlacholderGlopalStyle.split(" ");
            let arrNodeElements = ["icon", "image", "logo"];
            for (let j1 = 0; j1 < arrNodeElements.length; j1++) {
                if (this.tempPlacholderGlopalStyle.includes(arrNodeElements[j1])) {
                    for (let k1 = 0; k1 < arrclassDeatils.length; k1++) {
                        if (arrclassDeatils[k1].includes(arrNodeElements[j1])) {
                            this.arrplacholderGlopalStyle[j1] = arrclassDeatils[k1];
                        }
                    }
                } else {
                    this.arrplacholderGlopalStyle[j1] = "c";
                }
            }
