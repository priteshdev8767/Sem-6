    this._hasmultigraphic = this._currentslide?.getAttribute("data-multigraphicsupport") == "true";
    this._darkBg = this.instanceDetails && this.instanceDetails.darkBg ? this.instanceDetails.darkBg : false;
    this._serverUrl = this.instanceDetails && this.instanceDetails.serverUrl ? this.instanceDetails.serverUrl : "";
    this._indexstorefunction = this.instanceDetails && this.instanceDetails.indexstorefunction ? this.instanceDetails.indexstorefunction : "";
    this._isLive = this._indexstorefunction?.serverURL?.includes("app.");
    this._calloutInstance = this.instanceDetails && this.instanceDetails.calloutInstance ? this.instanceDetails.calloutInstance : "";
