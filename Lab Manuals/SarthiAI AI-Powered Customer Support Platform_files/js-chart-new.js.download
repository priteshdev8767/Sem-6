SimpleFillNativeShapeSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "minheightvalue label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        +" " + lLayoutName;
        element.id = "label-text-" + this.groupindex;
        element.style.minHeight = 10 + "px";
        element.style.width = this.labelMaxW + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.setAttribute("data-graphic-y", this.graphicH);
        element.style.order = this.labelAlignment.index;
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px"
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if (this.data.layout.labelPaddingClass) {
            element.classList.add(this.data.layout.labelPaddingClass);
        }
        // if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        // this.labelStyle = this.ChartFonts.labelOuterColor;
        let labelColor = this.getColorDetails(this.groupindex, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;
        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupindex;
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");
        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        if (this.data._labelTextColor[this.groupindex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupindex], "important");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.groupindex);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.groupindex, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
        }
        if (this.data.layout.haddivider && this.voData.voLayout.dividerType == "type1") {
            element.style.paddingTop = padding["top"] + 4 + "px";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        if (this.voData.voLayout.valuetextbgcallout == "true") {
            if (this.groupindex == 0) {
                element.style.marginRight = "30PX";
                element.style.marginLeft = "unset";
            } else {
                element.style.marginLeft = "30PX";
                element.style.marginRight = "unset";
            }
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            argparent.removeChild(element);
        }
    }
};

SimpleFillNativeShapeSeriesItem.prototype.cretaeSvgCallout = function (container, slide) {
    let bounds = { width: container.clientWidth, height: container.clientHeight };
    let point1, point2, point3, point4, point5, point6, point7, point8;
    let d;

    let calloutRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(calloutRect, {
        width: bounds.width - 38.5,
        height: bounds.height - 10,
        "fill-opacity": 0,
        class: "background-fill " + this.data.ChartFonts.appendgraphicStrokeColor(this.groupindex),
        rx: 10,
        ry: 10,
    });

    if (slide == "left") {
        point1 = { x: bounds.width - 40, y: bounds.height / 2 + 30 };
        point2 = { x: bounds.width, y: bounds.height / 2 - 70 };
        point3 = { x: bounds.width - 40, y: bounds.height / 2 - 30 };

        d = "M" + point1.x + " " + point1.y;
        d = d + "L" + point2.x + " " + point2.y;
        d = d + "L" + point3.x + " " + point3.y;
    }
    if (slide == "right") {
        point1 = { x: 40, y: bounds.height / 2 + 30 };
        point2 = { x: 0, y: bounds.height / 2 - 70 };
        point3 = { x: 40, y: bounds.height / 2 - 30 };

        d = "M" + point1.x + " " + point1.y;
        d = d + "L" + point2.x + " " + point2.y;
        d = d + "L" + point3.x + " " + point3.y;
        this.data.SVGUtils.assignAttributes(calloutRect, {
            x: 38.5,
        });
    }

    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        class: "calloutBaseSvg",
    });
    let path = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(path, {
        d: d,
        class: "background-fill " + this.data.ChartFonts.appendgraphicStrokeColor(this.groupindex),
    });
    baseSvg.appendChild(calloutRect);
    baseSvg.appendChild(path);
    container.appendChild(baseSvg);
    let svgHighlight = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgHighlight, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        id: "calloutGroup",
    });
    baseSvg.append(svgHighlight);
    this.createDropShadow(svgHighlight);
    //this.data.SVGUtils.assignAttributes(path, {
    //     filter: "url(#dropshadow)",
    // });
    //this.data.SVGUtils.assignAttributes(calloutRect, {
    //     filter: "url(#dropshadow)",
    // });
};

SimpleFillNativeShapeSeriesItem.prototype.createDropShadow = function (svgElement) {
    let defsTag = null;
    let filterDy = 5;
    let filterDx = 5;
    defsTag = this.data.SVGUtils.createSVGElement("defs");
    let filterTag = this.data.SVGUtils.createSVGElement("filter");
    this.data.SVGUtils.assignAttributes(filterTag, {
        id: "dropshadow",
        x: "0",
        y: "0",
        filterUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(filterTag);
    let feOffsetTag = this.data.SVGUtils.createSVGElement("fegaussianblur");
    this.data.SVGUtils.assignAttributes(feOffsetTag, {
        in: "SourceGraphic",
        dx: filterDx,
        dy: filterDy,
        result: "offOut",
    });
    filterTag.appendChild(feOffsetTag);
    let feDropShadowTag = this.data.SVGUtils.createSVGElement("feDropShadow");
    this.data.SVGUtils.assignAttributes(feDropShadowTag, {
        class: "item1",
        stdDeviation: "10",
        "flood-opacity": "0.8",
        in: "SourceGraphic",
    });
    filterTag.appendChild(feDropShadowTag);
    let feBlendTag = this.data.SVGUtils.createSVGElement("feBlend");
    this.data.SVGUtils.assignAttributes(feBlendTag, {
        in: "SourceGraphic",
        in2: "blurOut",
        mode: "normal",
    });
    svgElement.appendChild(defsTag);
};

function SimpleLogoComparisonChart(argparent, argprops){
    this.name = "SimpleLogoComparisonChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleLogoComparisonChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleLogoComparisonChart.prototype.constructor = SimpleLogoComparisonChart;

SimpleLogoComparisonChart.prototype.seriesInstance=function(argparent, argprops) {
    return new window["SimpleLogoComparisonSeries"](argparent, argprops);
}
SimpleLogoComparisonChart.prototype.CreateHightlightDifference = function () {
    return null;
}

// let objLabel;
// let labelMaxW = 0;
// let labeMaxH = 90;
// let valueMaxW = 0;
// let valueMaxH = 0;
// const minSize = 20;
// let maxSize = 260;
// let paddingvalue = 30;
function SimpleLogoComparisonSeries(argparent, argprops) {
    this.widthPercentage = 0.9;
    this.name = "SimpleLogoComparisonSeries";
    this.gapPercentage = 0.9;
    this.minValueFontSize = [25, 25];
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleLogoComparisonSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleLogoComparisonSeries.prototype.constructor = SimpleLogoComparisonSeries;

SimpleLogoComparisonSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleLogoComparisonSeriesItem"](argparent, argprops);
};

SimpleLogoComparisonSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.chartName == "numberFillComparisonChart") {
        maxSize = 400;
    }
    let customColorIndex = this.ChartFonts.customColor(this.index);
    let moveX = this.viewport.x;
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series accent" + customColorIndex + " clsMultiColorParent";
    element.classList.add("th-section" + customColorIndex);

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }

    element.style.width = this.state.width + "px";
    element.style.justifyContent = "center";
    this.parent.style.justifyContent = "center";
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    if (this.parent) this.parent.appendChild(element);
    if (this.data.chartName != "numberFillComparisonChart") {
        this.doAddDivider(element, argprops, true);
    }
    //boolMax
    this.doAddLabel(element, argprops, true);

    if (this.data.hadSecondaryText) {
        this.addlabel = true;
        this.doAddSecondaryLabelNode(element, argprops);
    }
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.data.chartName == "numberFillComparisonChart") {
        this.doAddDivider(element, argprops, true);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        // this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.widthPercentage = 1;

    let viewSize = this.state.width * this.gapPercentage * this.widthPercentage < this.rectSeriesItem.height ? this.state.width * this.gapPercentage * this.widthPercentage : this.rectSeriesItem.height;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond";
    subelement.style.width = this.gapPercentage * 100 + "%";
    subelement.style.flex = "unset";
    subelement.setAttribute("data-width", viewSize);
    subelement.setAttribute("data-height", viewSize + 50);
    // if (this.data.chartName == "numberFillComparisonChart") {
    //     subelement.style.maxheight = viewSize + 50 + "px";
    // }
    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

SimpleLogoComparisonSeries.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let _oHeight = 0;
    const objValue = this.getValueBounds();
    const objPrimaryPlaceholder = this.getPlaceholderBounds();
    this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : this.gapPercentage;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    let objRuler = this.ChartUtils.ruler(this.data.data);
    if (objRuler) {
        if (this.data.validHover && objRuler.layout) this.data.conflictLayout = "basic";
    }
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    }); //alterPos : "true"
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });
    labelMaxW = this.state.width * this.gapPercentage;
    labeMaxH = this.state.height * 0.2 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });
    valueMaxW = this.state.width * this.gapPercentage;
    valueMaxH = this.state.height * 0.3; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
    });

    // if (this.labelAlignment.position == "outer") {
    //     _oHeight += objLabel.height + this.pad;
    // }

    // if (this.valueAlignment.position == "outer") {
    //     _oHeight += objValue.height + this.pad;
    // }

    // if (this.placeholderAlignment.position == "outer") {
    //     _oHeight += objPrimaryPlaceholder.height;
    // }

    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.9;
    this.length = this.voData.seriesItemLength;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem.width = this.viewport.width / this.length;
    this.rectSeriesItem.height = this.viewport.height - _oHeight;
};

SimpleLogoComparisonSeries.prototype.doAddLabel = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.showLabel) {
        let llayoutname = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.index) + " " + llayoutname;
        element.id = "label-text-" + this.index;
        element.style.minHeight = 10 + "px";
        element.style.width = labelMaxW + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labeMaxH + "px";
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px";
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (this.data.layout.labelPaddingClass) {
            element.classList.add(this.data.layout.labelPaddingClass);
        }
        if (argparent) argparent.appendChild(element);
        else return element;
        let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;
        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.index;
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");

        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.index];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.maxHeight = labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.index);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
        if (this.data._labelTextColor[this.index]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.index], "important");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.index);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                    element.style.paddingBottom = "15px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = "15px";
                    element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        }
        if (this.data.labelLineHeight[this.index]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.index];
        }
        if (this.data.labelLetterSpace[this.index]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.index] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);

        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.rectSeriesItem.height -= subelement.clientHeight;
            argparent.removeChild(element);
        }
    }
};

SimpleLogoComparisonSeries.prototype.doAddDivider = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.hadseparator && (this.index == 0 || this.data.chartName == "numberFillComparisonChart")) {
        let separator = document.createElement("div");
        separator.classList.add("separator"), separator.classList.add("separatorline");
        separator.dataset.customopacity = this.data.layout.separatorOpacity ? this.data.layout.separatorOpacity : 0.5;
        separator.style.width = "0%";
        separator.style.height = "40%";
        separator.style.right = -(this.data.layout.itemSpace / 2) + "px";
        separator.classList.add("moodanimation");
        separator.dataset.animation = "divider";
        if (this.data.chartName == "numberFillComparisonChart") {
            separator.style.width = this.gapPercentage * 100 + "%";
            separator.style.height = "0%";
            separator.classList.remove("separator");
            separator.classList.remove("separatorline");
            separator.classList.add("spaceClass");
        }
        argparent.appendChild(separator);
        if (this.data.layout.separatorStyle == "outline") {
            separator.style.height = "2px";
        }
        if (this.data.layout.separatorStyle == "dashed") {
            separator.style.border = "2px dashed";
        } else {
            separator.style.border = "2px solid";
        }
        if (this.data.layout.separatorOpacity) {
            argparent.style.setProperty("--customItemlineopacity", this.data.layout.separatorOpacity);
        } else {
            argparent.style.setProperty("--customItemlineopacity", "0.5");
        }
        if (this.data.layout.separatorColor != "item") {
            if (this.data.layout.separatorColor == "secondary") {
                separator.classList.add("tertiarybordercolor");
            } else {
                separator.classList.add("contrast-border-color");
            }
        } else {
            separator.classList.add(this.data.ChartFonts.appendgraphicBorderColor(this.index));
        }
    }
};
SimpleLogoComparisonSeries.prototype.doSecondaryLabel = function (argparent, argprops, boolMax = false) {
    let llayoutname = this.labellayoutClassName("label");
    let element = document.createElement("div");
    element.className = "label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.index) + " " + llayoutname;
    element.id = "secondary-label-" + this.index;
    element.style.minHeight = 10 + "px";
    element.style.width = labelMaxW + "px";
    element.style.maxWidth = labelMaxW + "px";
    element.style.maxHeight = labeMaxH + "px";
    element.setAttribute("data-textalign", "vertical");
    element.dataset.animation = "secondarylabel";
    element.style.order = this.labelAlignment.index;
    element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
    element.style.paddingRight = this.data.layout.labelPaddingright + "px";
    element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
    element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.layout.secondaryLabelPaddingClass) {
        element.classList.add(this.data.layout.secondaryLabelPaddingClass);
    }
    let subelement = document.createElement("div");

    let hasInnerLabel = this.data.layout.labelInset == "inside";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);

    subelement.className = "labeltext " + this.ChartFonts.labelOuterColor;
    subelement.id = "labeltext-" + this.index;
    if (this.data.arrSecondaryLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrSecondaryLabelOpacity[this.index], "");
    subelement.innerText = boolMax ? this.data.secondarylongLabel : this.data.secondaryText[this.index];
    subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.style.maxWidth = labelMaxW + "px";
    subelement.style.maxHeight = labeMaxH + "px";
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "secondarylabel");
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", this.index);
    subelement.setAttribute("data-prompt-text", "Enter secondaryText");
    element.appendChild(subelement);
    if (this.labelAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
        if (this.labelAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.labelAlignment.vposition == "bottom") {
                element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                element.style.paddingBottom = "15px";
            } else if (this.labelAlignment.vposition == "top") {
                element.style.paddingTop = "15px";
                element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
        }
    }
    if (this.data._secondaryTextColor[this.index]) {
        subelement.style.setProperty("color", this.data._secondaryTextColor[this.index], "important");
    }
    this.ChartHelper.setTextChangeListner(subelement);

    this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement);
    this.ChartHelper.recalculateMaxHeight(subelement);
    if (boolMax) {
        this.rectSeriesItem.height -= subelement.clientHeight;
        argparent.removeChild(element);
    }
};

const minSize = 20;
let maxSize = 260;

// let objValue;
// let labelMaxW = 230;
// let labeMaxH = 90;
// let valueMaxW = 0;
// let valueMaxH = 0;
// let graphicH = 0;
// let padding = 8;
// let viewSize = 0;
// let graphicW = 0;
function SimpleLogoComparisonSeriesItem(argparent, argprops) {
    this.name = "SimpleLogoComparisonSeriesItem";
    BaseColumnSeriesItem.call(this, argparent, argprops);
    this.minValueFontSize = [25, 25];
    this.boolOverlap = false;
}
SimpleLogoComparisonSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleLogoComparisonSeriesItem.prototype.constructor = SimpleLogoComparisonSeriesItem;

SimpleLogoComparisonSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;

    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    labelMaxW = this.state.width * this.gapPercentage * 0.5;
    labeMaxH = this.state.height * 0.2 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    valueMaxW = this.state.width * this.gapPercentage;
    valueMaxH = this.state.height * 0.3; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
        alterpos: this.data.layout.placeholderalterpos,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    var intAssetLength = this.data.asset.data.length;
    if (0 < intAssetLength) this.assetURL = "genericassets/shapes/firefox-logo-horizontal-lockup.png";
    this.asset = this.data.asset.data;
};

SimpleLogoComparisonSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    labelMaxW = this.state.width * this.gapPercentage * 0.5;
    labeMaxH = this.state.height * 0.2 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    valueMaxW = this.state.width * this.gapPercentage;
    valueMaxH = this.state.height * 0.3; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
        alterpos: this.data.layout.placeholderalterpos,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    var intAssetLength = this.data.asset.data.length;
    if (0 < intAssetLength) this.assetURL = this.data.serverUrl + "genericassets/shapes/firefox-logo-horizontal-lockup.png";
    this.asset = this.data.asset.data;
};

SimpleLogoComparisonSeriesItem.prototype.doAddGraphicElement = function () {
    if (this.data.chartName == "logoGraphicComparisonChart") {
        // this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index]>100?100:this.data.values[this.groupindex][this.index];
        if (this.data.boolPercentageChart) {
            this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
        }
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };
    if (this.data.chartName == "logoGraphicComparisonChart") {
        eProps.valuetext = this.data.prefix[this.groupindex][this.index] + this.data.values[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index];
        if (this.data.suffix[this.groupindex][this.index] == "") {
            eProps.valuetext = this.data.prefix[this.groupindex][this.index] + this.data.values[this.groupindex][this.index] + "%";
        }
    }
    const parentWidth = this.parent.getAttribute("data-width") / this.length;
    const parentHeight = this.parent.getAttribute("data-height");
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = "100%";
    element.style.height = "auto";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    this.parent.appendChild(element);
    this.doAddTopSeriesItemElement(element, eProps);
};

SimpleLogoComparisonSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    if (this.data.chartName == "numberFillComparisonChart") {
        maxSize = 400;
    }
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = "auto";

    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
    }
};

SimpleLogoComparisonSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let sameElement = "";
    //let imageSize = "large"
    // let imageHeight = this.getImageSize(imageSize)
    // let imageWidth = this.getImageSize()
    // if (this.displayValue(argprops) && this.valueAlignment.position == "outer") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "outer") _iHeight += _dataPlaceholder.height;

    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "auto";
    element.style.alignItems = "unset";
    if (argparent) argparent.appendChild(element);
    else return element;

    const baseGraphicHeight = parentHeight - _iHeight;
    const valuePercentage = this.data.chartName == "multiCompPie" || this.data.chartName == "multiFillCompCircle" || this.data.chartName == "multiCompDoughnut" ? 1 : argprops.value / argprops.maxvalue;
    viewSize = parentWidth < baseGraphicHeight ? parentWidth : baseGraphicHeight;
    let assetSize = minSize + (viewSize - minSize) * 1;
    if (this.data.chartName == "iconComparisonChart") {
        element.style.flexDirection = "column";
    }
    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "seriesitem-" + index;
    // subelement.style.display = "block";
    subelement.className = "seriesitem topseriesitem";
    subelement.style.width = "100%";
    subelement.style.height = "auto";
    if (this.data.chartName == "numberFillComparisonChart" || this.data.chartName == "logoGraphicComparisonChart") {
        subelement.style.height = "100%";
    } else {
        subelement.style.height = "auto";
        if (this.data.chartName == "iconComparisonChart") {
            subelement.style.maxHeight = "220px";
            subelement.style.minHeight = "70px";
        } else {
            subelement.style.maxHeight = "120px";
            subelement.style.minHeight = "70px";
        }
    }

    subelement.style.position = "relative";

    subelement.setAttribute("data-width", assetSize);
    subelement.setAttribute("data-height", assetSize);
    element.appendChild(subelement); //multiCompPie
    if (this.data.layout.itemalterpos == "true") {
        if (groupindex == 0) {
            subelement.classList.add("seriesright");
        } else {
            subelement.classList.add("seriesleft");
        }
    }
    const clsStyle = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(this.groupindex);

    if (this.data.chartName == "logoGraphicComparisonChart") {
        this.createGraphicConatiner(subelement, argprops);
    }

    if (this.displayValue(argprops)) {
        if (this.valueAlignment.position == "outer") {
            this.valueStyle = "outerstyle";
            if (this.data.chartName != "numberFillComparisonChart" && this.data.chartName != "logoGraphicComparisonChart") {
                this.doAddTopValue(element, argprops);
            }
        } else if (this.valueAlignment.position == "inner" && this.data.chartName != "logoGraphicComparisonChart") {
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + index;
            valueElement.className = "valueelement topseriesitem";
            valueElement.style.width = "100%";
            valueElement.style.height = "100%";
            valueElement.style.display = "flex";
            valueElement.style.justifyContent = "center";
            valueElement.style.alignItems = "center";
            valueElement.style.overflow = "hidden";
            valueElement.style.position = "absolute";
            subelement.appendChild(valueElement);

            this.valueStyle = "innerstyle";
            if (this.data.chartName != "numberFillComparisonChart") {
                this.doAddTopValue(valueElement, argprops);
            }
        }
    }
    if (this.data.chartName != "numberFillComparisonChart") {
        const assetelement = this.data.SVGUtils.createElement("div");
        this.data.SVGUtils.assignAttributes(assetelement, {
            id: "graphic-" + groupindex + "_" + index,
            class: "chartgraphic  moodanimation transformOrginBottom " + clsStyle,
            "data-animation": "primaryplaceholder",
        });
        assetelement.dataset.customorgin = "bottom";
        // subelement.style.width =  viewSize+"px";
        assetelement.style.width = 120 / 0.61 + "px";
        assetelement.style.height = "120px";
        if (this.data.chartName == "iconComparisonChart") {
            assetelement.style.width = 220 / 0.61 + "px";
            assetelement.style.height = "220px";
        }
        if (this.placeholderAlignment.itemBased && this.placeholderAlignment.samepos) {
            let type = String(argprops.placeholdertype).toLowerCase();
            assetelement.style.width = "120px";
            assetelement.style.height = "120px";
            this.labelMaxW = element.clientWidth - 120;
            sameElement = this.ChartHelper.createDivElement({});
            sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
            sameElement.style.display = "flex";
            sameElement.style.flexDirection = "row";
            sameElement.style.width = "100%";
            sameElement.style.height = assetelement.style.height;

            if (type != "image") {
                assetelement.style.maxWidth = "120px";
                assetelement.style.width = "auto";
                sameElement.style.width = "auto";
            }
            if (this.placeholderAlignment.alterpos && groupindex == 0) {
                sameElement.style.flexDirection = "row-reverse";
            }
            subelement.appendChild(sameElement);
            sameElement.appendChild(assetelement);
        } else {
            subelement.appendChild(assetelement);
        }

        let property = { index: groupindex, placeholdertype: "image" };
        if (argprops.placeholdertype) {
            property.placeholdertype = argprops.placeholdertype;
        }
        if (this.placeholderAlignment.itemBased && this.placeholderAlignment.samepos) {
            this.doAddBottomPlaceholder(assetelement, property);
        } else {
            this.doAddBottomPlaceholder(assetelement, property);
        }
    } else {
        // this.doAddNumberMaskElement(subelement, argprops);
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.doAddLabel(sameElement, argprops, true);
        this.doAddLabel(sameElement, argprops);
    }
};
SimpleLogoComparisonSeriesItem.prototype.createGraphicConatiner = function (argparent, argprops) {
    const graphicParentBaseelement = this.data.SVGUtils.createElement("div");
    this.data.SVGUtils.assignAttributes(graphicParentBaseelement, {
        id: "graphic-base-parent-container" + this.groupindex + "_" + this.index,
        style: "width:100%;background-color:transparent",
    });
    argparent.appendChild(graphicParentBaseelement);
    let padding = this.setoverlapPadding("placeholder");
    graphicParentBaseelement.style.paddingTop = padding["bottom"] + "px";

    let cssBorderStyle = this.ChartFonts.graphicBorderColor(this.groupindex);

    const graphicBaseelement = this.data.SVGUtils.createElement("div");
    this.data.SVGUtils.assignAttributes(graphicBaseelement, {
        id: "graphic-base-container" + this.groupindex + "_" + this.index,
        class: "graphicbasecontainer moodanimation " + cssBorderStyle,
        style: "width:100%;height:70px;",
        "data-animation": "itemborder",
    });

    let borderAlign = this.voData.layout.backgroundBorder.alignment;
    let bgStyleClass = this.getBgColorDetails(this.groupindex, this.ChartFonts.graphicBgColor(this.groupindex), this.data.layout.backgroundColor, "bgcolor");
    graphicBaseelement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
    graphicBaseelement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");
    let bgBorderColor = this.getBgColorDetails(this.groupindex, "secondary-border-color", this.data.layout.backgroundBorder.color, "bordercolor");
    if (this.data.layout.backgroundBorder.color == "secondary") {
        graphicBaseelement.classList.add("boborderOpacity");
        graphicBaseelement.classList.add("secondary-border-color");
    } else if (this.data.layout.backgroundBorder.color == "bgcolor") {
        graphicBaseelement.classList.add("itembgColor");
    } else {
        graphicBaseelement.classList.add(bgBorderColor);
    }
    if (this.data.layout.itemBgborderstyle == "dashed") {
        graphicBaseelement.classList.add("shapeborder" + borderAlign + "dashed");
        graphicBaseelement.style.setProperty("--border-style", "dashed", "");
    } else {
        graphicBaseelement.style.setProperty("--border-style", "solid", "");
        graphicBaseelement.classList.add("shapeborder" + borderAlign);
    }
    graphicParentBaseelement.appendChild(graphicBaseelement);

    if (this.data.layout.itemalterpos == "true" && this.groupindex == 0) {
        graphicBaseelement.style.flexDirection = "row-reverse";
    }
    let BgColor = this.getBgColorDetails(this.groupindex, "clsNodeSecondarybg", this.data.layout.backgroundColor, "bgcolor");
    // graphicBaseelement.classList.add(BgColor)

    let graphicContainerWidth = this.data.values[this.groupindex][this.index] / 100;
    const graphicContainerElement = this.data.SVGUtils.createElement("div");
    this.data.SVGUtils.assignAttributes(graphicContainerElement, {
        id: "graphic-container" + this.groupindex + "_" + this.index,
        class: "logographiccontainer",
    });
    if (this.data.layout.itemColor == "gradient") graphicContainerElement.classList.add("gradient");
    graphicContainerElement.style.width = graphicContainerWidth * 100 + "%";
    graphicBaseelement.appendChild(graphicContainerElement);
    let cssStyle = this.getBgColorDetails(this.groupindex, this.ChartFonts.graphicBgColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(this.groupindex);
    const graphicelement = this.data.SVGUtils.createElement("div");
    this.data.SVGUtils.assignAttributes(graphicelement, {
        id: "graphic" + this.groupindex + "_" + this.index,
        style: "width:100%;height:100%",
        class: "moodanimation " + cssStyle,
        "data-animation": "item",
    });
    if (this.groupindex == 0) {
        graphicelement.classList.add("transformOrginRight");
        graphicelement.dataset.customorgin = "right";
    } else {
        graphicelement.classList.add("transformOrginLeft");
        graphicelement.dataset.customorgin = "left";
    }
    graphicContainerElement.appendChild(graphicelement);
    graphicW = graphicelement.clientWidth;
    if (this.data.layout.borderRadiusClass && this.groupindex == 0) {
        graphicelement.classList.add(this.data.layout.borderRadiusClass);
        if (graphicBaseelement) graphicBaseelement.classList.add(this.data.layout.borderRadiusClass);
    }
    if (this.data.layout.alterBorderRadiusClass && this.groupindex == 1) {
        graphicelement.classList.add(this.data.layout.alterBorderRadiusClass);
        if (graphicBaseelement) graphicBaseelement.classList.add(this.data.layout.alterBorderRadiusClass);
    }
    valueMaxH = graphicBaseelement.clientHeight;
    valueMaxW = graphicBaseelement.clientWidth * 0.5;
    this.valueStyle = this.ChartFonts.graphicColor(this.groupindex);
    this.boolOverlap = graphicBaseelement.clientWidth - graphicContainerElement.clientWidth < valueMaxW;
    if (this.boolOverlap) {
        this.valueStyle = this.ChartFonts.valueInnerColor;
        this.doAddTopValue(graphicContainerElement, argprops, false, true, false, null, true);
    } else {
        this.doAddTopValue(graphicBaseelement, argprops, false, true);
    }
    if (this.data.layout.data.background.opacity) {
        let Class = this.getBgClassList(graphicBaseelement);
        let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
        graphicBaseelement.style.setProperty("background-color", rgbavalue, "important");
    }
};
SimpleLogoComparisonSeriesItem.prototype.doAddNumberMaskElement = function (argparent, argprops) {
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        width: "100%",
        height: "100%",
    });
    argparent.appendChild(baseSvg);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    baseSvg.appendChild(defsTag);
    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        id: this.data.slideID + "maskicon" + argprops.gindex,
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    const parentHeight = argparent.getAttribute("data-height");
    let graphicHeightPercentage = viewSize * (argprops.value / 100);
    // layoutContainer.style.top = (parentHeight - graphicHeightPercentage) + "px";
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + argprops.gindex,
        class: "graphic-container ",
        x: 0,
        y: this.data.SVGUtils.createPercentValue(viewSize, viewSize - graphicHeightPercentage),
        width: "100%",
        height: this.data.SVGUtils.createPercentValue(viewSize, graphicHeightPercentage),
    });
    svgMask.appendChild(graphicContainerSVG);
    // element.appendChild(graphicContainerSVG);

    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + argprops.gindex,
        "data-animation": "item",
        class: "graphic transformOrginBottom",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
    let svgBgTextNode = this.data.SVGUtils.createSVGElement("text");
    this.data.SVGUtils.assignAttributes(svgBgTextNode, {
        id: "itemplaceholder-" + argprops.gindex,
        "font-weight": "bold",
        "dominant-baseline": "hanging ",
        "text-anchor": "middle",
        y: "0em",
        x: "50%",
        class: this.ChartFonts.appendgraphicColor(argprops.gindex) + " transformOrginTop n1",
        "font-family": "Helvetica",
        "font-size": "188px",
        "fill-opacity": "0.3",
        "stroke-opacity": "0",
        "data-animation": "itembackground",
    });
    svgBgTextNode.dataset.customorgin = "top";
    svgBgTextNode.innerHTML = argprops.valuetext;
    baseSvg.appendChild(svgBgTextNode);
    let strText = svgBgTextNode.innerText;
    let maxWidth = viewSize * 0.9;
    let maxHeight = viewSize;
    let fontSize = TextUtils.fitFontSize(svgBgTextNode, strText, maxWidth, maxHeight, 169, true);
    let boundsValues = this.ChartUtils.getTextMeasurement(this.data.slideID, argprops.valuetext, maxWidth, maxHeight, 169, 20, null, null, false);
    let svgUseNode = this.data.SVGUtils.createSVGElement("text");
    this.data.SVGUtils.assignAttributes(svgUseNode, {
        id: "itemplaceholder-" + argprops.gindex,
        "dominant-baseline": "hanging ",
        "font-weight": "bold",
        "text-anchor": "middle",
        y: "0em",
        x: "50%",
        class: "item" + (argprops.gindex + 1) + " transformOrginTop n1",
        "font-family": "Helvetica",
        "font-size": "188px",
        "stroke-opacity": "0",
        mask: "url(#" + this.data.slideID + "maskicon" + argprops.gindex + ")",
    });
    svgUseNode.dataset.customorgin = "top";
    svgUseNode.innerHTML = argprops.valuetext;
    baseSvg.appendChild(svgUseNode);
    TextUtils.fitFontSize(svgUseNode, strText, maxWidth, maxHeight, 169, true);

    let width = boundsValues.width;
    let height = fontSize;

    let graphicViewSize = height;
    graphicHeightPercentage = graphicViewSize * (argprops.value / 100);

    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        y: (graphicViewSize * 0.2) / 2,
        height: graphicViewSize - graphicViewSize * 0.1,
    });
    this.data.SVGUtils.assignAttributes(baseSvg, {
        height: height,
    });
};

