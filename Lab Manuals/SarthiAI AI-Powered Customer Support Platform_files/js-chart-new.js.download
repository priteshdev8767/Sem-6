}
SingleWaffleChart.prototype = Object.create(BaseColumnChart.prototype);
SingleWaffleChart.prototype.constructor = SingleWaffleChart;

SingleWaffleChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SingleWaffleSeries"](argparent, argprops);
}
SingleWaffleChart.prototype.CreateHightlightDifference = function () {
