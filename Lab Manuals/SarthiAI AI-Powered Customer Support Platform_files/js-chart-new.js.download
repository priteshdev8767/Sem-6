    if (editImage) {
        itemId = eltarget.parentNode.getAttribute("id");
    }
    if (chartName == "logoComparisonChart" || chartName == "logoGraphicComparisonChart" || chartName == "iconComparisonChart" || chartName == "pieChart" || chartName == "doughnutChart" || chartName == "ComparisonpieChart" || chartName == "ComparisonDoughnutChart") {
        hasImageProperty = "";
        hasPlaceHolderProperty = "";
    }
    if (customImageSource) {
        editImage = "";
    }
    if (elementType == "multilegendlabel" || elementType == "axistitle" || elementType == "comparelabelheader") {
        hasHightlightProperty = "";
        hasLinkProperty = "";
        hasProjectionProperty = "";
        hasGraphicImageProperty = "";
        hasEmphasisProperty = "";
        hasDeleteProperty = "";
        hasSortOrderProperty = "";
    }

    if (compareImage) {
        hasHightlightProperty = "";
        hasLinkProperty = "";
        hasProjectionProperty = "";
        hasGraphicImageProperty = "";
        hasEmphasisProperty = "";
        hasDeleteProperty = "";
        hasSortOrderProperty = "";
    }
    if (chartName?.toLowerCase()?.includes("dumbell")) {
        hasHightlightProperty = "";
    }
    hasHightlightProperty = "";
    if (
        elementType == "label" ||
        elementType == "value" ||
        elementType == "promt" ||
        elementType == "secondarylabel" ||
        elementType == "legendlabel" ||
        elementType == "sourcetext" ||
        elementType == "projectiontext" ||
        elementType == "charttiletext" ||
        elementType == "chartgrouplabel" ||
        elementType == "multilegendlabel" ||
        elementType == "axistitle" ||
        elementType == "comparelabelheader"
    ) {
        if (elementType != "charttiletext" && elementType != "secondarylabel" && elementType != "chartgrouplabel" && elementType != "value" && elementType != "promt" && elementType != "label" && elementType != "legendlabel" && elementType != "projectiontext") {
            fontListing = {};
        }
        nodeStyle = window.getComputedStyle(eltarget);
        // lineHeightOnRem = (parseFloat(nodeStyle.lineHeight) / parseFloat(nodeStyle.fontSize)).toFixed(1);
        // letterSpacingValue = parseFloat(nodeStyle.letterSpacing);
        //Taking EM values insteed of px
        lineHeightOnRem = (parseFloat(nodeStyle.lineHeight) / parseFloat(nodeStyle.fontSize)).toFixed(2);
        letterSpacingValue = (parseFloat(nodeStyle.letterSpacing) / parseFloat(nodeStyle.fontSize)).toFixed(2);
    }
    let moreFloater = [];
    if (hasProjectionProperty && hasProjectionProperty.visible) {
        hasProjectionProperty["label"] = "floatprojection";
        moreFloater.push(hasProjectionProperty);
    }
    if (hasEmphasisProperty && hasEmphasisProperty.visible) {
        hasEmphasisProperty["label"] = "floatemphasize";
        moreFloater.push(hasEmphasisProperty);
    }
    if (hasSortOrderProperty && hasSortOrderProperty.visible) {
        hasSortOrderProperty["label"] = "floatsortorder";
        moreFloater.push(hasSortOrderProperty);
    }
    if (hasGraphicImageProperty && hasGraphicImageProperty.visible) {
        hasGraphicImageProperty["label"] = "image";
        moreFloater.push(hasGraphicImageProperty);
    }
    if (textSize) {
