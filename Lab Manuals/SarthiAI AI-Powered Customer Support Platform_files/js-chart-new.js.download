BaseBarSeriesItem.prototype.doAddImageUseNodeElement = function (argparent, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    argparent.appendChild(nodeBgElement);

    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.objectFit = "cover";
    subelement.src = this.data.primaryPlaceholderPath[this.groupindex];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.groupindex + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.groupindex + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    subelement.setAttribute("data-nodetype", "imageNode");
    subelement.setAttribute("data-imagepath", this.data.primaryPlaceholderPath[this.groupindex]);
    argparent.appendChild(subelement);
    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.groupindex]);
        if (this.data.logoContrast[this.groupindex] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    let item = this.ChartUtils.getOffsetLeftTop(argparent, "SLIDE", true);
    argparent.setAttribute("data-x", item.x);
    argparent.setAttribute("data-y", item.y);
    argparent.setAttribute("data-width", argparent.clientWidth);
    argparent.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-width", argparent.clientWidth);
    subelement.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    if (type == "logo") {
        this.ChartUtils.updateImageReSize(argparent.clientWidth, argparent.clientHeight, subelement, "", type);
    }

    if (this.data.layout.placeHolderShapeType == "circle") {
        subelement.style.borderRadius = "50%";
    }
    let BgStyle = "var(--item" + 1 + "-color)";
    // if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor") && !this.data.shapeBorder) {
    //     BgStyle = "var(--item" + (5) + "-color)"
    // }
    // if ((this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor") && !this.data.shapeBorder) {
    //     argparent.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle)
    // }
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    argparent.appendChild(overLayDiv);
};

BaseBarSeriesItem.prototype.doAddIconUseNodeElement = function (argparent, argprops, boolMidElement = false) {
    if (this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") {
        this.placeholderStyle = "clsAlterTertiaryColor";
    } else if (
        (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
        (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
    ) {
        this.placeholderStyle = "clsSecondaryFill";
    }
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon",
        id: "placeholder-" + this.groupindex + "_0",
        "data-nodetype": "iconNode",
        width: "100%",
        height: "100%",
    });
    if (this.data.layout.boolplaceholderShape) {
        this.data.SVGUtils.assignAttributes(element, {
            width: "70%",
        });
    }
    if (boolMidElement) {
        this.data.SVGUtils.assignAttributes(element, {
            width: "60%",
            height: "60%",
        });
    }
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "xlink:href": "#" + this.data.primaryPlaceholderName[this.groupindex],
        "data-type": "ICON",
        id: "primaryplaceholdergraphic-" + this.groupindex + "_0",
        class: "primaryplaceholdergraphic",
        "data-placeholderelement": "icon,image",
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    this.data.SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};

BaseBarSeriesItem.prototype.doAddTextUseNodeElement = function (argparent, argprops) {};

BaseBarSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let highlightPoint = "";
    highlightPoint = false;
    let highlightDifferenceHeight = 0;
    let extraElementWidth = 0;
    let layoutParent = "";
    let valueStaticalParent = "";
    let labelStaticalParent = "";
    if (this.data.highlightDifference.display) highlightPoint = true;
    if (this.data.highlightDifference.display && (this.valueAlignment.position == "outer" || this.data.layout.valueInset == "bgoutside" || this.valueAlignment.itemBased == "true")) {
        this.highlightNodes = [this.data.highlightDifference.point1, this.data.highlightDifference.point2];
        this.highlightNodes.sort(function (a, b) {
            return a - b;
        });

        highlightDifferenceHeight = 100;

        if (this.data.layout.valueInset == "bgoutside" || this.valueAlignment.itemBased == "true") {
            highlightDifferenceHeight = 100;
        }
        if (this.data.indualHighlight) {
            highlightDifferenceHeight = 100;
        }
    } else {
        if (this.data.indualHighlight || this.data.highlightDifference.display) {
            highlightDifferenceHeight = 100;
        }
    }
    if (this.data.extraElementBounds?.width) {
        extraElementWidth = this.data.extraElementBounds?.width;
    }
    this.data.hdHeight = highlightDifferenceHeight;
    // if (this.displayValue(argprops)) {
    //     if (this.valueAlignment.itemBased == "true") {
    //         this.valueStyle =
    //             this.data.hasEmphasis && this.data.emphasis[groupindex] != true
    //                 ?this.ChartFonts.valueOuterColor
    //                 : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
    //                 ?this.ChartFonts.graphicColor(groupindex)
    //                 :this.ChartFonts.valueOuterColor;
    //         const subValueElement = this.ChartHelper.createDivElement({});
    //         subValueElement.id = "topvalue-" + groupindex + "_" + index;
    //         subValueElement.className = "topvalue ";
    //         subValueElement.style.width = graphicWidthPercentage * 100 + "%";
    //         argparent.appendChild(subValueElement);
    //         this.doAddRightValue(subValueElement, argprops);
    //     }
    // }
    if (this.placeholderAlignment.itemBased == "true" && this.pla) {
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    if (this.data.layout.itemBgBorder || this.data.layout.itemBgBorder == "true") {
        element.style.border = "2px solid";
        dropShadowHeight = 0;
        element.classList.add(this.data.ChartFonts.appendgraphicBorderColor(index));
    }
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top" && this.valueAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top" && this.labelAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        // if (this.valueAlignment.itemBased == "true" && this.labelAlignment.itemBased == "true") {
        //     if (this.labelAlignment.vposition == "top" && this.valueAlignment.vposition == "bottom") {
        //         element.style.flexDirection = "column-reverse";
        //     }
        // }

        element.style.alignItems = "flex-start";
        if (this.data.chartFlip) {
            element.style.alignItems = "flex-end";
        }
    }
    if (this.alignment.itemBased == "true") {
        if (this.alignment.itemBased == "true") {
            if (this.alignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        element.style.alignItems = "flex-start";
        if (this.data.chartFlip) {
            element.style.alignItems = "flex-end";
        }
    }

    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddRightValue(element, argprops, true);
    if (this.labelAlignment.position == "inner") {
        this.doAddLabel(element, argprops, false, true);
    }

    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.labelMaxW * 0.5;
        this.middleLH = this.labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height);
        this.middleVH = parseInt(this.state.height);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation ";
        middleelementValue.dataset.animation = "bgsecondarytext";
        middleelementValue.style.width = this.middleVW + "px";

        middleelementValue.style.height = this.middleVH + "px";
        if (this.data.layout.boolvaluebgShape) {
            this.valuebgProperties(middleelementValue);
        }
        if (this.data.layout.valuebgBgColor == "theme") {
            this.valueStyle = this.ChartFonts.valueInnerColor;
        }
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        this.middlePH = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        if (this.data.layout.placholderHeight) {
            this.middlePH = this.data.layout.placholderHeight;
        }
        if (this.data.layout.placholderWidth) {
            this.middlePW = this.data.layout.placholderWidth;
        }
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation ";
        middleelementPlaceholder.setAttribute("data-animation", "primaryplaceholder");
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
            middleelementPlaceholder.style.top = "3%";
        }
        if (this.data.layout.boolplaceholderShape) {
            this.bgProperties(middleelementPlaceholder);
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }
    if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.hposition == "left") {
        const placeHolderBounds = this.getPlaceholderBounds();
        if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner") {
        } else {
            this.placeholderWidth = this.data.layout.placholderWidth ? parseFloat(this.data.layout.placholderWidth) : placeHolderBounds.width;
        }
    }
    const parentWidth = this.state.width;
    let baseGraphicWidth;
    let valueWidth = argprops.minvalue < 0 ? 2 * (this.currentValW + 1) : this.currentValW;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") {
        baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + this.maxLabelW + dropShadowHeight + highlightDifferenceHeight + extraElementWidth);
    } else {
        if (this.data.chartName == "bar3DChart" && this.labelAlignment.itemBased != "true") {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + valueWidth + this.placeholderWidth + extraElementWidth);
        } else {
            if (this.data.chartName == "bar3DChart" && this.labelAlignment.itemBased == "true" && this.placeholderAlignment.itemBased == "true") {
                baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + this.placeholderWidth + extraElementWidth);
            } else {
                // if(this.valueAlignment.position == "outer"&&this.valueAlignment.hposition == "right"&&this.valueAlignment.itemBased != "true"){
                //     baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight+valueWidth+highlightDifferenceHeight);
                // }else{
                baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + extraElementWidth);
                // }
            }
        }
    }
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    let baseGraphicWidthPercentage = baseGraphicWidth;
    let bgGraphicWidthPercentage = 1;
    let dummeyValue = argprops.value;
    let differncePercentage = (this.data.rangePositive * 0.8) / this.data.secondPositiveHighValue;
    let dummeySeconHighValue = 0;
    let dummeySecondHighValueWidthPercentage = 0;
    dummeySeconHighValue = this.data.secondPositiveHighValue * differncePercentage;
    if (this.data.highvaluebreak && argprops.value != this.data.rangePositive) {
        dummeyValue = argprops.value * differncePercentage;
    }
    let parentPercentage = baseGraphicWidthPercentage * (argprops.totalvalue / totalValue);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.inset != "bgoutside" && this.labelAlignment.itemBased != "true" && this.valueAlignment.hposition == "right" && this.valueAlignment.itemBased != "true") {
        baseGraphicWidthPercentage = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + valueWidth + highlightDifferenceHeight + extraElementWidth);
        if (argprops.minvalue < 0) {
            baseGraphicWidthPercentage = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + extraElementWidth);
        }
    }
    if (this.data.showStatistical && this.statisticalAlignment.position == "outer" && this.statisticalAlignment.itemBased != "true") {
        this.createStatistacalContainer(element, true);
        baseGraphicWidthPercentage -= this.statisticalWidth;
    }
    let graphicWidthPercentage = baseGraphicWidthPercentage * (dummeyValue / totalValue);
    dummeySecondHighValueWidthPercentage = baseGraphicWidthPercentage * (dummeySeconHighValue / totalValue);
    graphicWidthPercentage = argprops.maxvalue == 0 ? 0 : graphicWidthPercentage;
    let parentWidthValue = parentPercentage + highlightDifferenceHeight + extraElementWidth;
    if (this.valueAlignment.position == "outer" && this.data.layout.valueInset != "bgoutside" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition != "left") {
        parentWidthValue = parentPercentage + this.currentValW + highlightDifferenceHeight + extraElementWidth;
    }

    // let seriesItem = this.parent.querySelectorAll(".rightseriesitem");
    // for (let k1 = 0; k1 < seriesItem.length; k1++) {
    //     seriesItem[k1].style.width = this.data.SVGUtils.createPercentValue(this.state.width, parentWidthValue);
    //     seriesItem[k1].dataset.parentSeriesWidth = parentPercentage + this.currentValW;
    // }

    // let leftSeriesItem = this.parent.querySelectorAll(".leftseriesitem");
    // if (leftSeriesItem.length > 0 && this.data.minValue < 0) {
    //     let baseParentWidth = this.parent.querySelector(".baseseriesitem") ? this.parent.querySelector(".baseseriesitem").clientWidth : 0;
    //     baseParentWidth = this.state.width;
    //     for (let s1 = 0; s1 < leftSeriesItem.length; s1++) {
    //         leftSeriesItem[s1].style.width = this.data.SVGUtils.createPercentValue(this.state.width, baseParentWidth - parentWidthValue);
    //         leftSeriesItem[s1].dataset.parentSeriesWidth = baseParentWidth - parentWidthValue;
    //     }
    // }
    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        let bgStyleClass = this.getBgColorDetails(groupindex, this.ChartFonts.emphasizeColor, this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        backgroundElement.className = "backgroundItem moodanimation " + bgStyleClass;
        // if (this.data.layout.backgroundColor == "transparent"||(this.data.layout.backgroundColor == "bgColor")) {
        //     bgStyleClass = " background-bg-color"
        // }
        // if (this.data.layout.backgroundColor == "theme") {
        //     bgStyleClass = this.ChartFonts.graphicBgColor(groupindex)
        // }
        backgroundElement.className = "backgroundItem moodanimation " + bgStyleClass;
        backgroundElement.style.width = bgGraphicWidthPercentage * 100 + "%";
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity == 0 ? 0.5 : this.data.layout.backgroundOpacity;
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        if (this.data.layout.backgroundColor == "gradient") {
            backgroundElement.style.backgroundImage = this.data.layout.backgroundGradientValues ? this.data.layout.backgroundGradientValues : "";
        }
        if (this.data.layout.backgroundOpacity != 0) {
            element.style.setProperty("--bg-opacity", this.data.layout.backgroundOpacity);
        }
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " cs-chart-main-graphic moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = bgGraphicWidthPercentage * 100 + "%";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.height = this.thicknessPercentage * 100 + "%";
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            let borderAlign = this.voData.layout.backgroundBorder.alignment;
            if (this.data.layout.backgroundborderstyle == "dashed") {
                backgroundBorderElement.classList.add("shapeborder" + borderAlign + "dashed");
                backgroundBorderElement.style.setProperty("--border-style", "dashed", "");
            } else {
                backgroundBorderElement.classList.add("shapeborder" + borderAlign);
                backgroundBorderElement.style.setProperty("--border-style", "solid", "");
            }
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            backgroundBorderElement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");

            let BgBorderColor = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.data.layout.backgroundBorder.color, "bordercolor");
            backgroundBorderElement.classList.add(BgBorderColor);
            backgroundBorderElement.style.boxSizing = "border-box";
            if (this.data.layout.backgroundBorder.color == "gradient") {
                backgroundBorderElement.classList.add("itemborderGrdient");
            }
            // if (this.data.layout.backgroundBorder.color == "theme") {
            //     // let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
            //     backgroundBorderElement.classList.add("accent" + (groupindex + 1) + "-border-color");
            //     if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //         // this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
            //     }
            // }
            // if (this.data.layout.backgroundBorder.color == "secondary") {
            //     backgroundBorderElement.classList.add("boborderOpacity")
            //     // let strBordeStyleClass = this.ChartFonts.tertiaryBorder(groupindex)
            //     backgroundBorderElement.classList.add("secondary-border-color");
            //     if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //         // this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
            //     }
            // }
        }
    }

    //"graphicbg";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    graphicWidthPercentage = graphicWidthPercentage > parentWidthValue ? parentWidthValue : graphicWidthPercentage;
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(parentWidthValue, graphicWidthPercentage);
    subelement.style.height = 100 * this.data.layout.itemthicknesssize + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.setProperty("--bg-opacity", "1");
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = "calc(" + graphicWidthPercentage * 100 + "% - " + this.middlePH * 0.5 + "px)";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleVH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
                subelement.style.marginLeft = this.middlePH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleLH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let strStyleClass = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    // if(this.data.hasEmphasis){
    //     strStyleClass = "";
    // }
    const clsStyle = strStyleClass + " moodanimation " + this.transformOrginValue;
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.dataset.itemlength = this.data.seriesItemLength;
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.dataset.customorgin = this.customOrginValue;
    graphicElement.className = "chartgraphic graphicnode " + clsStyle;
    graphicElement.dataset.graphicwidth = graphicWidthPercentage;
    if (this.data.hasEmphasis || this.data.hasProjection || this.data._arrseriesItemHighValue[this.index] == "true") {
        graphicElement.classList.add("cs-chart-main-graphic");
    }
    if (index == 0 && this.data.chartName.includes("comparisonModel")) {
        graphicElement.dataset.customorgin = this.customNegativeOrginmValue;
    }
    if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.data.seriesLength / 2) {
        graphicElement.dataset.customorgin = this.customOrginValue;
    }
    graphicElement.style.width = 100 + "%";
    graphicElement.style.height = "100%";
    graphicElement.dataset.animation = "item";
    if (
        !this.valuePosInterchange &&
        this.data.chartName == "bar3DChart" &&
        this.labelAlignment.itemBased == "true" &&
        this.valueAlignment.position == "outer" &&
        this.data.layout.valueInset != "bgoutside" &&
        this.valueAlignment.itemBased != "true" &&
        this.valueAlignment.hposition == "right" &&
        this.valueAlignment.itemBased != "true"
    ) {
        graphicElement.style.width = graphicWidthPercentage - valueWidth + "px";
    }
    if (this.data.chartName == "barStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") graphicElement.style.borderRadius = this.valueMaxH + "px";
    if (this.data.chartName == "barFillRectangle") graphicElement.style.position = "absolute";
    subelement.appendChild(graphicElement);
    if (this.style.bgFillType == "gradient" || (this.style.bgFillType == "gradient" && this.data.hasEmphasis && this.data.emphasis[groupindex] == true)) {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");

    if (this.voData.layout.backgroundBorderRadiusValues && backgroundElement) {
        let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";

        if (this.data.layout.backgroundBorderRadiusClass) {
            backgroundElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
            if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
        } else {
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            if (backgroundBorderElement) backgroundBorderElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }

    strStyleClass =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder ? this.setNoEmphasis(graphicElement, strStyleClass, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, strStyleClass, groupindex) : strStyleClass;

    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "borderelement";
        borderElement.style.width = 100 + "%";
        borderElement.style.height = "100%";
        borderElement.style.boxSizing = "border-box";
        subelement.appendChild(borderElement);
        // graphicElement.classList.remove("accent" + (styleIndex + 1) + "-bg-color")
        // graphicElement.classList.remove("background-bg-color");
        // graphicElement.classList.add("background-bg-color");
        let strBordeStyleClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.voData.shapeBoderColor, "bordercolor");

        // if (this.voData.shapeBoderColor == "theme") {
        borderElement.classList.add(strBordeStyleClass);
        if (this.voData.shapeBoderColor == "gradient") {
            borderElement.classList.add("itemborderGrdient");
        }
        this.emphasisColor = " secondary-border-color";
        // if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
        //     if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
        //         let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
        //         let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
        //         graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
        //     }
        // }
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
            this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex);
        }
        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName == "emphasize-basic-fill") || highlightPoint) {
            graphicElement.classList.remove("background-bg-color");
            graphicElement.classList.add(this.data.ChartFonts.appendgraphicBgColor(styleIndex));
        }
        borderElement.classList.add("moodanimation");
        borderElement.dataset.animation = "itemborder";
        borderElement.setAttribute("data-graphic-x", graphicElement.clientWidth);
        if (this.data.chartFlip) {
            borderElement.setAttribute("data-graphic-x", -graphicElement.clientWidth);
        }
        // }
        if (this.data.layout.itemborderstyle == "dashed") {
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign + "dashed");
            borderElement.style.setProperty("--border-style", "dashed", "");
        } else {
            borderElement.style.setProperty("--border-style", "solid", "");
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        }
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");
    }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        if (this.data.layout.borderRadiusClass) {
            graphicElement.classList.add(this.data.layout.borderRadiusClass);
            if (borderElement) borderElement.classList.add(this.data.layout.borderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            if (borderElement) borderElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    if (borderElement) {
        borderElement.classList.remove("borderelement");
        borderElement.classList.add("borderelement");
    }

    let itembasedPlaceHolder = "";
    if (this.displayPrimaryPlaceholder(argprops)) {
        graphicW = graphicWidthPercentage;

        if (this.placeholderAlignment.position == "outer" || graphicW < this.state.height * 0.6) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            if (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.hposition == "left") {
                itembasedPlaceHolder = this.ChartHelper.createDivElement({});
                itembasedPlaceHolder.style.display = "flex";
                itembasedPlaceHolder.style.justifyContent = "center";
                itembasedPlaceHolder.style.alignItems = "center";
                itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
                if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos == "true") {
                    itembasedPlaceHolder.style.height = element.clientHeight + "px";
                }

                element.parentNode.insertBefore(itembasedPlaceHolder, element);
                this.itemBasedPlaceHolderHeight = graphicElement.clientHeight;
                this.doAddRightPlaceholder(itembasedPlaceHolder, argprops);
                element.parentNode.style.alignItems = "flex-start";
                if (this.placeholderAlignment.vposition == "bottom") {
                    element.parentNode.style.alignItems = "flex-end";
                }
                // element.parentNode.style.flexDirection = "row-reverse";
            } else {
                this.doAddRightPlaceholder(element, argprops);
            }
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            subelement.style.display = "flex";
            subelement.style.justifyContent = "flex-end";
            this.doAddRightPlaceholder(subelement, argprops);
        }
    }
    if ((this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true") && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")) {
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        subelement.appendChild(sameElement);

        if (this.labelAlignment.samepos == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddRightValue(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true") {
        // this.doAddLabel(element, argprops, true)
        graphicW = graphicWidthPercentage;
        this.valuePosInterchange = false;
        if ((this.data.chartName.includes("comparisonModel") || this.data.chartName == "barStackedRectangle") && this.valueAlignment.position == "inner") {
            graphicW = subelement.clientWidth;
        }
        this.doAddRightValue(element, argprops, true);
        // let boolOverlap = (graphicBaseelement.clientWidth - graphicContainerElement.clientWidth) < valueMaxW;
        this.boolEnableInnerValue = (this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && this.data.layout.valueInset != "bgoutside" && element.clientWidth - subelement.clientWidth < this.currentValW;
        if (this.valueAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containerlabel");
            const valueLayoutName = this.valuelayoutClassName("containervalue");
            if (this.voData.layout.labelVPosition == this.voData.layout.valueVPosition && this.labelAlignment.itemBased == "true") {
                layoutParent = this.ChartHelper.createDivElement({});
                layoutParent.classList.add("layoutParentNode");
                if (this.voData.layout.valueVPosition == "bottom") {
                    element.insertBefore(layoutParent, subelement);
                } else {
                    element.appendChild(layoutParent);
                }
            } else if (this.voData.layout.statisticalVPosition == this.voData.layout.valueVPosition && this.data.showStatistical) {
                valueStaticalParent = this.ChartHelper.createDivElement({});
                valueStaticalParent.classList.add("layoutParentNode");
                valueStaticalParent.classList.add("valuestatistical");
                this.valueMaxW = element.clientWidth * 0.5;
                if (this.voData.layout.statisticalVPosition == "top") {
                    element.insertBefore(valueStaticalParent, subelement);
                } else {
                    element.appendChild(valueStaticalParent);
                }
            }
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;

            let elementHeight = 2 - this.thicknessPercentage;
            valueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) valueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }

            if (this.valueAlignment.vposition == "bottom") {
                valueElement.style.setProperty("align-items", "flex-start", "important");
            }
            valueElement.className = "itembasedlabelelement " + containerAlignment + " " + valueLayoutName;
            this.valueMaxW = this.state.width * 0.5;
            valueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.valueAlignment.position == "inner") {
                valueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent) {
                valueElement.style.height = 100 + "%";
                valueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                this.valueMaxW = element.clientWidth * 0.2;
                valueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    this.valueMaxW = element.clientWidth * 0.4;
                    valueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                layoutParent.appendChild(valueElement);
                this.valueMaxH = valueElement.clientHeight;
                this.doAddRightValue(element, argprops, true);
            } else if (valueStaticalParent) {
                valueElement.style.height = 100 + "%";
                valueElement.style.setProperty("align-items", "flex-end", "important");
                this.valueMaxW = element.clientWidth * 0.5;
                valueElement.style.width = element.clientWidth * 0.5 + "px";
                if (this.data.promptText) {
                    this.valueMaxW = element.clientWidth * 0.5;
                    valueElement.style.width = element.clientWidth * 0.5 + "px";
                }
                valueStaticalParent.appendChild(valueElement);
                this.doAddRightValue(element, argprops, true);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") {
                    element.insertBefore(valueElement, subelement);
                } else {
                    element.appendChild(valueElement);
                }
            }
            if (this.valueAlignment.itemBased == "true" && this.valueAlignment.vposition == "top" && valueElement && backgroundElement) {
                backgroundElement.style.top = valueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? valueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : valueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                valueElement.style.marginLeft = this.middlePW / 2 + "px";
            }
            this.labelMaxW = element.clientWidth;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            // this.valueMaxH = valueElement.clientHeight;
            this.doAddRightValue(valueElement, argprops);
            if (this.labelAlignment.itemBased != "true") {
                valueElement.style.maxHeight = elementHeight * 100 + "%";
                valueElement.style.height = "auto";
                if (valueElement.children[0]) {
                    valueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.currentValW) {
            this.valueOuterposition = true;
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern"
                    ? this.data._emphasisName == "emphasize-grey"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) || this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern"
                    ? this.ChartFonts.valueOuterColor
                    : this.ChartFonts.valueOuterColor;
            let boolOrder = graphicW < this.innerlabelmaxWidth && this.labelAlignment.position == "inner" && this.valueAlignment.itemBased != "true" ? true : false;
            if (this.data.chartName == "barStackedRectangle") {
                overlapStackedBar = true;
                // if(!this.data.stackedPercentage)this.removeValueElement();
            }
            if (this.data.chartName == "barcomparisonmodel") {
            }
            let multiValueSeriesIndex = this.groupindex;
            if (this.voData.seriesItemLength > 1 && this.data.chartName != "comparisonModelType3") {
                multiValueSeriesIndex = this.index;
            }
            this.valueStyle = this.getColorDetails(multiValueSeriesIndex, this.valueStyle, this.data.layout.valueColor, "color");
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill" || this.data.layout.valueInset == "bgoutside") {
                this.valueAlignment.position == "inner" ? this.doAddRightValue(element, argprops) : this.doAddRightValue(argparent, argprops);
                if (this.data.layout.valueInset == "bgoutside") {
                    argparent.style.display = "flex";
                    if (this.labelAlignment.itemBased != "true") {
                        argparent.style.alignItems = "center";
                    }
                }
            } else {
                graphicW = Math.round(subelement.clientWidth) - (this.currentValW + this.data.layout.valuePaddingleft);
                if ((this.labelAlignment.itemBased == "true" || this.labelAlignment.itemBased == "true") && graphicW < this.currentValW) {
                    let baseContainer = this.ChartHelper.createDivElement({});
                    baseContainer.style.width = "100%";
                    baseContainer.style.height = subelement.style.height;
                    (baseContainer.style.display = "flex"), subelement.parentNode.appendChild(baseContainer);
                    subelement.style.height = "100%";
                    baseContainer.appendChild(subelement);
                    baseContainer.style.alignItems = "center";
                    this.valuePosInterchange = graphicW < this.currentValW ? true : false;
                    if (this.data.chartName == "bar3DChart") {
                        graphicElement.style.width = "100%";
                    }
                    this.doAddRightValue(baseContainer, argprops);
                    let valueElemnt = baseContainer.querySelector(".value");
                    valueElemnt.style.minWidth = "unset";
                } else {
                    if (this.labelAlignment.itemBased == "true" || this.alignment.itemBased == "true") {
                        this.doAddRightValue(subelement, argprops);
                    } else this.doAddRightValue(element, argprops, false, boolOrder);
                }
            }
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            let vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            if (this.data.chartName.includes("comparisonModel") && index == 1) {
                vLayoutName = this.valuelayoutClassName("containervalue", true);
                valueElement.className = "valueelement " + vLayoutName;
            }
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;

            if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-basic-border-invert") {
                this.valueStyle = this.ChartFonts.graphicColor(groupindex);
            }
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            this.doAddRightValue(valueElement, argprops, true);
            this.doAddRightValue(valueElement, argprops);
        }
        if (this.data.layout.itemFillType == "pattern") {
            this.createPatternSvg(graphicElement);
        }
        if (this.data.layout.backgroundFillType == "pattern") {
            this.createPatternSvg(backgroundElement, true);
        }
    }
    if (this.data.showStatistical) {
        graphicW = graphicWidthPercentage;
        if ((this.data.chartName.includes("comparisonModel") || this.data.chartName == "barStackedRectangle") && this.statisticalAlignment.position == "inner") {
            graphicW = subelement.clientWidth;
        }
        this.createStatistacalContainer(element, true);
        this.statisticalStyle = this.getColorDetails(this.groupindex, this.ChartFonts.valueOuterColor, this.data.layout.statisticalColor, "color");
        if (this.statisticalAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            let vLayoutName = this.statisticallayoutClassName("containerlabel");
            let statistacalLayoutName = this.statisticallayoutClassName("containervalue");
            let statistacalValueElement = this.ChartHelper.createDivElement({});
            statistacalValueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            statistacalValueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) statistacalValueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            if (this.statisticalAlignment.vposition == "bottom") {
                statistacalValueElement.style.setProperty("align-items", "flex-start", "important");
            }
            statistacalValueElement.className = "itembasedlabelelement " + containerAlignment + " " + statistacalLayoutName;
            statistacalValueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.statisticalAlignment.position == "inner") {
                statistacalValueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent && (this.statisticalAlignment.vposition == this.valueAlignment.vposition || this.statisticalAlignment.vposition == this.labelAlignment.vposition)) {
                statistacalValueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    statistacalValueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                if (this.valueAlignment.itemBased == "true") {
                    statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                }
                statistacalValueElement.style.height = "100%";
                layoutParent.appendChild(statistacalValueElement);
                // this.createStatistacalContainer(element,true);
            } else if (this.statisticalAlignment.vposition == this.labelAlignment.vposition) {
                labelStaticalParent = this.ChartHelper.createDivElement({});
                labelStaticalParent.classList.add("layoutParentNode");
                labelStaticalParent.classList.add("labelstatistical");
                if (this.voData.layout.statisticalVPosition == "top") {
                    element.insertBefore(labelStaticalParent, subelement);
                } else {
                    element.appendChild(labelStaticalParent);
                }
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                labelStaticalParent.appendChild(statistacalValueElement);
            } else if (valueStaticalParent) {
                valueStaticalParent.style.width = "100%";
                statistacalValueElement.style.height = "100%";
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                valueStaticalParent.appendChild(statistacalValueElement);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.statisticalAlignment.itemBased == "true") {
                    element.insertBefore(statistacalValueElement, subelement);
                } else {
                    element.appendChild(statistacalValueElement);
                }
            }
            if (this.statisticalAlignment.itemBased == "true" && this.statisticalAlignment.vposition == "top" && statistacalValueElement && backgroundElement) {
                backgroundElement.style.top = statistacalValueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? statistacalValueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : statistacalValueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                statistacalValueElement.style.marginLeft = this.middlePW / 2 + "px";
            } // this.valueMaxH = valueElement.clientHeight;
            this.createStatistacalContainer(statistacalValueElement);
            if (this.labelAlignment.itemBased != "true") {
                statistacalValueElement.style.maxHeight = elementHeight * 100 + "%";
                statistacalValueElement.style.height = "auto";
                if (statistacalValueElement.children[0]) {
                    statistacalValueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.statisticalAlignment.position == "outer" && this.statisticalAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.statisticalWidth) {
            // this.valueStyle = this.getColorDetails(multiValueSeriesIndex, this.valueStyle, this.data.layout.statisticalColor, "color");
            if (this.data.layout.statisticalInset == "bgoutside") {
                this.statisticalAlignment.position == "inner" ? this.createStatistacalContainer(element) : this.createStatistacalContainer(argparent);
                if (this.data.layout.statisticalInset == "bgoutside") {
                    argparent.style.display = "flex";
                    if (this.labelAlignment.itemBased != "true") {
                        argparent.style.alignItems = "center";
                    }
                }
            } else {
                graphicW = Math.round(subelement.clientWidth);
                if (this.labelAlignment.itemBased == "true" || this.alignment.itemBased == "true") {
                    this.createStatistacalContainer(subelement);
                } else this.createStatistacalContainer(element, false);
            }
        } else if ((this.statisticalAlignment.position == "inner" && this.statisticalAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            let vLayoutName = this.statisticallayoutClassName("containervalue");
            const statisticalElement = this.ChartHelper.createDivElement({});
            statisticalElement.id = "statisticalElement-" + groupindex + "_" + index;
            statisticalElement.className = "statisticalElement " + vLayoutName;
            statisticalElement.style.width = "100%";
            subelement.appendChild(statisticalElement);
            this.statisticalStyle = this.ChartFonts.valueInnerColor;
            if (this.data.layout.itemColor != "bgcolor") this.statisticalArrowStyle = this.ChartFonts.valueInnerColor;
            if (this.data.chartName.includes("comparisonModel") && index == 1) {
                vLayoutName = this.statisticallayoutClassName("containervalue", true);
                statisticalElement.className = "statisticalElement " + vLayoutName;
            }
            this.createStatistacalContainer(statisticalElement);
        }
    }
    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true" && this.voData.chartName != "comparisonModelType2" && this.voData.chartName != "barStackedRectangle") {
        graphicW = graphicWidthPercentage;

        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            labelElement.style.height = elementHeight * 100 + "%";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            labelElement.className = "itembasedlabelelement " + containerAlignment + " containerlabe" + this.data.layout.labelHPosition;
            labelElement.style.width = element.clientWidth - this.currentValW + "px";
            if (this.valueAlignment.position == "inner" || this.valueAlignment.itemBased == "true") {
                labelElement.style.width = element.clientWidth < 150 ? 200 + "px" : element.clientWidth + "px";
            }
            if (layoutParent) {
                labelElement.style.width = element.clientWidth * 0.8 + "px";
                if (this.data.promptText) labelElement.style.width = element.clientWidth * 0.6 + "px";
                labelElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                labelElement.style.height = "100%";
                layoutParent.appendChild(labelElement);
                if (this.statisticalAlignment.itemBased == "true" && this.data.showStatistical && this.data.layout.labelVPosition == this.statisticalAlignment.vposition) {
                    labelElement.style.width = element.clientWidth * 0.6 + "px";
                }
            } else if (labelStaticalParent) {
                labelElement.style.width = element.clientWidth * 0.5 + "px";
                labelStaticalParent.appendChild(labelElement);
            } else {
                if (this.data.layout.labelVPosition == "top") {
                    element.insertBefore(labelElement, subelement);
                } else {
                    element.appendChild(labelElement);
                }
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labelMaxW = element.clientWidth;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            if (layoutParent) {
                this.labelMaxW = element.clientWidth * 0.8;
                if (this.data.promptText) {
                    this.labelMaxW = element.clientWidth * 0.6;
                }
                if (this.statisticalAlignment.itemBased == "true" && this.data.showStatistical) {
                    this.labelMaxW = element.clientWidth * 0.6;
                }
            } else if (labelStaticalParent) {
                this.labelMaxW = element.clientWidth * 0.5;
            }
            // this.labelMaxH = (labelElement.clientHeight-(parseFloat(this.data.layout.labelPaddingtop)+parseFloat(this.data.layout.labelPaddingbottom)));
            this.doAddLabel(labelElement, argprops);
            this.valueMaxH = subelement.clientHeight;
            if (this.valueAlignment.itemBased != "true") {
                labelElement.style.maxHeight = elementHeight * 100 + "%";
                labelElement.style.height = "auto";
                if (labelElement.children[0]) {
                    if (labelElement.children[0].innerText == "" && this.data.presentMode) {
                        labelElement.children[0].innerText = "Enter Label";
                        labelElement.children[0].style.height = "auto";
                        labelElement.parentNode.style.justifyContent = "center";
                        labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                        labelElement.children[0].innerText = "";
                    } else {
                        labelElement.children[0].style.height = "auto";
                        labelElement.parentNode.style.justifyContent = "center";
                        labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                    }
                }
            } else {
                if (labelElement.children[0]) {
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
                let ValueElement = labelElement.parentNode.querySelector(".value");
                if (ValueElement) {
                    ValueElement.parentNode.style.minHeight = ValueElement.clientHeight + "px";
                    if (this.data.promptText && this.maxValueH > ValueElement.clientHeight) {
                        ValueElement.parentNode.style.minHeight = this.maxValueH + "px";
                    }
                }
            }
        } else if (this.labelAlignment.position == "outer" || graphicW <= this.innerlabelmaxWidth) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labelOverlab = graphicW <= this.innerlabelmaxWidth;
            this.doAddLabel(element, argprops);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (highlightPoint || (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern"))) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.labelMaxW = subelement.clientWidth * 0.9;
            if (this.labelAlignment.position == "inner" && this.valueAlignment.position == "inner") {
                this.labelMaxW = subelement.clientWidth * 0.9 - this.currentValW;
            }
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            if (this.placeholderAlignment.position == "middle") {
                this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
                this.labelMaxW = this.labelMaxW - this.middlePW;
                this.placholderHPos = this.placeholderAlignment.hposition;
                this.doAddLabel(labelElement, argprops);
            } else {
                this.placholderHPos = "";
                this.doAddLabel(labelElement, argprops);
            }
        }
    }
    if (this.data.layout.secondaryElement && this.alignment.itemBased == "true") {
        graphicW = graphicWidthPercentage;

        if (this.alignment.itemBased == "true") {
            this.doAddRightValue(element, argprops, true);
            const vLayoutName = this.secondarylayoutClassName("itemlabel");
            let layoutName = this.secondarylayoutClassName("itemsecondary");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            labelElement.style.height = elementHeight * 100 + "%";
            let containerAlignment = vLayoutName;
            // if (vLayoutName != "containerlabellefttop") {
            //     containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom"
            // if(vLayoutName.includes("containerlabelrighttop")){
            //     containerAlignment = "itemlabelrightbottom"
            // }
            // if(vLayoutName.includes("containerlabelrightbottom")){
            //     containerAlignment = "itemlabelrighttop"
            // }
            // } else {
            //     containerAlignment = "itemlabellefttop";
            // }
            labelElement.className = "itembasedlabelelement " + containerAlignment + " " + layoutName;
            labelElement.style.width = graphicElement.clientWidth < 150 ? 200 + "px" : graphicElement.clientWidth + "px";
            if (this.valueAlignment.position == "inner") {
                labelElement.style.width = element.clientWidth + "px";
            }
            element.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labelMaxW = element.clientWidth;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            this.labelMaxH = labelElement.clientHeight;
            if (this.data.layout.secondaryElementType != "image") {
                this.doAddSecondaryLabel(labelElement, argprops);
            } else {
                this.doSecondaryImage(labelElement, argprops);
            }
            this.valueMaxH = subelement.clientHeight;
        } else if (this.labelAlignment.position == "outer" || graphicW <= this.innerlabelmaxWidth) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (this.data.layout.secondaryElementType != "image") {
                this.doAddSecondaryLabel(element, argprops);
            } else {
                this.doSecondaryImage(element, argprops);
            }
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (highlightPoint || (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern"))) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.labelMaxW = subelement.clientWidth * 0.9;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            if (this.placeholderAlignment.position == "middle") {
                this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
                this.labelMaxW = this.labelMaxW - this.middlePW;
                this.placholderHPos = this.placeholderAlignment.hposition;
                if (this.data.layout.secondaryElementType != "image") {
                    this.doAddSecondaryLabel(labelElement, argprops);
                } else {
                    this.doSecondaryImage(labelElement, argprops);
                }
            } else {
                this.placholderHPos = "";
                if (this.data.layout.secondaryElementType != "image") {
                    this.doAddSecondaryLabel(labelElement, argprops);
                } else {
                    this.doSecondaryImage(labelElement, argprops);
                }
            }
        }
    }
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(parentWidthValue, dummeySecondHighValueWidthPercentage);
    let highValueWidth = subelement.clientWidth > dummeySecondHighValueWidthPercentage ? dummeySecondHighValueWidthPercentage : subelement.clientWidth;
    let chartGraphicNode = subelement.querySelector(".chartgraphic");
    if (this.data.layout.labelItemBased == "true" && this.data.layout.valueItemBased != "true" && chartGraphicNode) {
        highValueWidth = chartGraphicNode.clientWidth > dummeySecondHighValueWidthPercentage ? dummeySecondHighValueWidthPercentage : chartGraphicNode.clientWidth;
    }
    graphicWidthPercentage = graphicWidthPercentage > parentWidthValue ? parentWidthValue : graphicWidthPercentage;
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(parentWidthValue, graphicWidthPercentage);
    if ((this.data.highvaluebreak && argprops.value == this.data.rangePositive) || (this.data.highvaluebreak && this.data.customProperties.yAxisMaxValue && argprops.value == this.data.secondPositiveHighValue)) {
        let highvalueBreakElemnt = this.ChartHelper.createDivElement({});
        highvalueBreakElemnt.style.width = "4%";
        highvalueBreakElemnt.style.position = "absolute";
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.right = highValueWidth + "px";
        } else {
            highvalueBreakElemnt.style.left = highValueWidth + "px";
        }
        highvalueBreakElemnt.style.height = "100%";
        graphicElement.style.position = "relative";
        graphicElement.parentNode.appendChild(highvalueBreakElemnt);
        let dividerHeight = highvalueBreakElemnt.clientHeight;
        let dividerWidth = highvalueBreakElemnt.clientWidth;
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.right = highValueWidth - dividerWidth / 2 + "px";
        } else {
            highvalueBreakElemnt.style.left = highValueWidth - dividerWidth / 2 + "px";
        }
        let svgParent = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgParent, {
            width: "100%",
            height: "100%",
            style: "position: absolute; top: 0; left: 0;",
        });
        highvalueBreakElemnt.appendChild(svgParent);

        let Bounds = this.thicknesCalculation(dividerHeight, dividerWidth);
        let thickness = Bounds.thickness;
        let leftY = Bounds.top; // Left side position (renamed from Topvalue)
        let rightY = Bounds.bottom; // Right side position (renamed from bottom)
        let segmentWidth = Bounds.Width;
        let segmentCount = Bounds.count;

        // Create a continuous zigzag path from top to bottom (vertical for bar chart)
        let pathValue = "";

        // Start from top edge always at left
        pathValue += "M " + leftY + ",0";

        // Create zigzag segments down the height - alternate between left and right
        for (let i = 0; i < segmentCount; i++) {
            let y = (i + 1) * segmentWidth;
            let x = i % 2 === 0 ? rightY : leftY; // First goes right, then left, then right, etc.

            // Ensure we don't exceed the height
            if (y >= dividerHeight) {
                y = dividerHeight;
            }

            pathValue += " L " + x + "," + y;
        }

        // Calculate final X position after all segments
        // After segmentCount segments, if count is even, we're at leftY, if odd, at rightY
        let finalX = segmentCount % 2 === 0 ? leftY : rightY;

        // End at the bottom edge with the correct final X position
        pathValue += " L " + finalX + "," + dividerHeight;

        let svgPath = this.data.SVGUtils.createSVGElement("path");
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: pathValue,
            "stroke-width": thickness + "px",
            stroke: "var(--item" + (groupindex + 1) + "-color)",
            fill: "none",
            class: "dividerpath moodanimation",
            "data-animation": "highvaluebreak",
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
        });
        if (this.data.layout.itemColor == "bgcolor") {
            this.data.SVGUtils.assignAttributes(svgPath, {
                class: "seconddividerpath moodanimation",
            });
        }
        svgParent.appendChild(svgPath);
    }

    if (middleelementValue) {
        middleelementValue.setAttribute("data-graphic-x", graphicElement.clientWidth);
        if (this.data.chartFlip) {
            middleelementValue.setAttribute("data-graphic-x", -graphicElement.clientWidth);
        }
        let value = middleelementValue.querySelector(".value") ? middleelementValue.querySelector(".value").children[0] : "";
        if (value) {
            value.setAttribute("data-graphic-x", 0);
        }
    }
    if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
    }
    if (itembasedPlaceHolder) {
        itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
    }
    if (backgroundElement) {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
        if (backgroundBorderElement) backgroundBorderElement.style.height = graphicElement.clientHeight + 2 + "px";
        if (this.labelAlignment.itemBased == "true" && (this.labelAlignment.vposition == "top" || this.labelAlignment.vposition == "bottom") && backgroundElement) {
            backgroundElement.style.top = graphicElement.parentNode.offsetTop + "px";
            if (backgroundBorderElement) {
                backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? graphicElement.parentNode.offsetTop - this.data.layout.backgroundBorder.width + "px" : graphicElement.parentNode.offsetTop + "px";
            }
            if (this.groupindex != 0) {
                let baseParentNode = this.parent.parentNode.parentNode.parentNode;
                if (baseParentNode) {
                    let series = baseParentNode.querySelector("#series-0");
                    let graphicContainer = series.querySelector(".graphicconatiner");
                    let bgElement = series.querySelector(".backgroundItem");
                    let labelElement = series.querySelector(".label");
                    let currentLabelElement = this.parent.querySelector(".label");
                    if (graphicContainer && bgElement && this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true" && this.data.seriesLength > 3) {
                        let topValue = graphicContainer.offsetTop;
                        bgElement.style.top = topValue + "px";
                        bgElement.style.height = graphicContainer.clientHeight + "px";
                        if (labelElement) {
                            let paddingTop = window.getComputedStyle(currentLabelElement)["padding-top"] ? parseFloat(window.getComputedStyle(currentLabelElement)["padding-top"]) : 0;
                            let paddingBottom = window.getComputedStyle(currentLabelElement)["padding-bottom"] ? parseFloat(window.getComputedStyle(currentLabelElement)["padding-bottom"]) : 0;
                            let currentHeight = currentLabelElement.clientHeight - paddingTop - paddingBottom;
                            labelElement.style.height = currentHeight + "px";
                            let maxHeightValue = parseInt(labelElement.style.maxHeight);
                            if (maxHeightValue < currentHeight) {
                                labelElement.style.maxHeight = currentHeight + 10 + "px";
                            }
                        }
                    }
                }
            }
        }
        if (this.data.layout.data.background.opacity || this.data.layout.backgroundOpacity) {
            let Class = this.getBgClassList(backgroundElement);
            let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
            backgroundElement.style.setProperty("background-color", rgbavalue, "important");
        }
    }
    if (this.placeholderAlignment.vposition == "middle" && this.labelAlignment.vPosition != "top" && middleelementPlaceholder && this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
        middleelementPlaceholder.style.top = (graphicElement.clientHeight - middleelementPlaceholder.clientHeight) / 2 + "px";
    }
    if (this.placeholderAlignment.vposition == "bottom" && this.labelAlignment.vPosition != "top" && middleelementPlaceholder && this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
        middleelementPlaceholder.style.top = graphicElement.clientHeight - middleelementPlaceholder.clientHeight + "px";
    }
    if (this.placeholderAlignment.vposition == "bottom" && this.labelAlignment.vPosition != "top" && middleelementPlaceholder && this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
        middleelementPlaceholder.style.top = graphicElement.clientHeight - middleelementPlaceholder.clientHeight + "px";
    }
    ///DropShadow
    if (this.data.layout.itemShadow) {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
    if (this.groupindex == this.data.seriesLength - 1) {
        if (this.data.showStatistical) this.updateStatisticalFontSize(this.parent);
    }
    if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "outer" && this.labelAlignment.itemBased == "true" && borderElement) {
        borderElement.style.width = graphicElement.clientWidth + "px";
    }
};

BaseBarSeriesItem.prototype.setNoEmphasis = function (graphicElement, strStyleClass, groupindex) {
    if ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder) {
        let borderColor = " secondary-border-color";
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + borderColor;
        graphicElement.classList.add("shapeborderall");
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return strStyleClass;
    } else if (this.data._emphasisName == "patternemphasize") {
        graphicElement.className = "chartgraphic graphicnode  cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return strStyleClass;
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic graphicnode   cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + this.emphasisColor;
        graphicElement.dataset.customorgin = this.customOrginValue;
        return this.emphasisColor;
    }
};

BaseBarSeriesItem.prototype.doSecondaryImage = function (element, argprops) {
    this.thicknessPercentage = this.data.layout.itemthickness && this.data.seriesItemLength < 2 ? this.data.layout.itemthickness : 1;
    let gapPercentage = this.thicknessPercentage * 0.8;

    const subelement = document.createElement("img");
    subelement.style.height = gapPercentage * 100 + "%";
    subelement.style.order = this.alignment.index;
    subelement.style.paddingLeft = this.data.layout.secondaryLogoPaddingleft + "px";
    subelement.style.paddingRight = this.data.layout.secondaryLogoPaddingright + "px";
    subelement.style.paddingTop = this.data.layout.secondaryLogoPaddingtop + "px";
    subelement.style.paddingBottom = this.data.layout.secondaryLogoPaddingbottom + "px";
    subelement.src = this.data.secondaryPlaceholderPath[this.groupindex];
    subelement.style.position = "unset";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "secondaryElement primaryplaceholdergraphic";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    element.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "rgba(var(--th-slide-secondary), 1)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "var(--item" + this.index + "-color)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
};

BaseBarSeriesItem.prototype.setHasEmphasis = function (graphicElement, strStyleClass, groupindex, borderelement = false) {
    if (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") {
        if (this.data._emphasisName == "emphasize-basic-pattern" && !borderelement) {
            graphicElement.className = "chartgraphic graphicnode  cs-chart-main-graphic moodanimation " + this.transformOrginValue + " emppattern" + (groupindex + 1);
            graphicElement.dataset.customorgin = this.customOrginValue;
        }
    } else if (this.data._emphasisName == "emphasize-alpha") {
        graphicElement.className = "chartgraphic graphicnode  cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "patternemphasize") {
        graphicElement.className = "chartgraphic graphicnode  cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + strStyleClass;
        graphicElement.dataset.customorgin = this.customOrginValue;
        graphicElement.className = "chartgraphic graphicnode   cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + strStyleClass + " chartborder emppattern" + (groupindex + 1);
        graphicElement.dataset.customorgin = this.customOrginValue;
    } else if (this.data._emphasisName == "emphasize-grey") {
        graphicElement.className = "chartgraphic graphicnode  cs-chart-main-graphic moodanimation " + this.transformOrginValue + " " + strStyleClass;
    }
    return strStyleClass;
};

BaseBarSeriesItem.prototype.createSVGElement = function (middleelement, argprops, name, boolMidElement = false) {
    if (this.valueAlignment.position == "middle" && name == "value") {
        this.valueMaxW = this.middleVW;
        this.valueMaxH = this.middleVH;
        this.doAddRightValue(middleelement, argprops);
    }
    if (this.placeholderAlignment.position == "middle" && name == "placeholder") {
        this.placeholderStyle = this.ChartFonts.graphicFillColor(argprops.gindex);
        this.doAddRightPlaceholder(middleelement, argprops, boolMidElement);
    }
    if (this.labelAlignment.position == "middle" && name == "label") {
        this.labelMaxW = this.middleLW;
        labeMaxH = this.middleLH;
        this.doAddLabel(middleelement, argprops);
    }
};

BaseBarSeriesItem.prototype.doAddLeftValue = function (argparent, argprops, boolmax = false, boolinnerValue = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let valIndex = this.data.chartName == "comparisonModelType3" ? (groupindex < this.voData.seriesLength / 2 ? 0 : 1) : index;
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;
    this.valueStyle = this.getColorDetails(valGroupIndex, this.valueStyle, this.data.layout.valueColor, "color");

    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valueAlignment.itemBased == "true" ? this.valuelayoutClassName("itemlabel", true) : this.valuelayoutClassName("value", true);
    const element = this.ChartHelper.createDivElement({});
    element.id = "leftvalue-text-" + groupindex + "_" + index;
    element.style.minWidth = 10 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.className = "value leftvalue " + vLayoutName;
    element.dataset.boolnegative = "true";
    element.style.order = this.valueAlignment.index;
    element.style.paddingLeft = padding["right"] + "px";
    element.style.paddingRight = padding["left"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) element.classList.remove(this.data.layout.valuePaddingClass);
    if (this.data.layout.valueAlterPaddingClass) element.classList.add(this.data.layout.valueAlterPaddingClass);
    if (this.valueAlignment.textbgitem == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        element.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
    }
    if (this.valueBackground) {
        element.className = "value " + vLayoutName + " " + this.ChartFonts.graphicColor;
        element.style.left = "20px";
    }
    if (this.data.layout.valueAlterPaddingClass) {
        element.classList.add(this.data.layout.valueAlterPaddingClass);
    }
    if (this.valueAlignment.hposition == "left") element.style.textAlign = "start";
    if (argparent) argparent.appendChild(element);
    else return element;
    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("cs-inner-text-color");
        subelement.classList.add("cs-inner-text-color");
    }
    subelement.id = "valuetext-" + valGroupIndex + "_" + index;
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;

    subelement.dataset.boolnegative = "true";
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    element.appendChild(subelement);
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize = [maxFontSize, maxFontSize];
    }
    let fontSize = this.ChartFonts.maxLabelFontSize(subelement);
    if (this.data.promptText) {
        element.style.whiteSpace = "unset";
        subelement.setAttribute("data-type", "promt");
        subelement.setAttribute("data-index", groupindex + "_" + index);
        subelement.classList.add("prompttext");
        subelement.style.overflow = "hidden";
        element.classList.add("promt");
        subelement.setAttribute("data-prompt-text", "10-15");
        subelement.innerHTML = boolmax ? this.data.promptlongValue : this.data.promptTextValue[groupindex][index];
        this.maxValueFontSize[this.arrIndex] = fontSize;
    }
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.dataset.animation = !this.data.promptText ? "secondarytext" : "prompttext";
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.presentMode || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    }
    if (this.data.layout.valueColor && this.data.layout.valueColor != "contrast") {
        subelement.classList.remove("clsContrastTextColor");

        if (this.data.chartName.includes("comparisonModel")) {
            subelement.classList.add(this.ChartFonts.appendgraphicColor(index));
        } else {
            subelement.classList.add(this.ChartFonts.appendgraphicColor(valGroupIndex)); //"accent" + (valGroupIndex + 1) + "-color");
        }
    }
    // if (
    //     (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) ||
    //     (this.data.hasProjection && this.data.projection[groupindex] == true && (this.data._projectionName == "projection-grey" || this.data._projectionName == "projection-basic-border-grey"))
    // ) {
    //     if (this.data.shapeBorder && this.data.hasEmphasis && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
    //     } else {
    //         subelement.classList.remove("secondary-color");
    //         subelement.classList.remove("accent" + (valGroupIndex + 1) + "-color");
    //         subelement.classList.add("tertiary-color");
    //     }
    // }

    if (this.data.arrHyperlinkUrl.length >= valGroupIndex) {
        element.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[valGroupIndex]);
    }
    if (this.deafaultPercentage) {
        subelement.innerText = parseFloat(argprops.valuetext) + "%";
    }
    if (this.valueAlignment.textbg == "true" && this.valueAlignment.textbgitem != "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            // if (this.valueAlignment.hposition == "right") {
            //     element.style.paddingTop = this.data.layout.valuePaddingtop + 15 + "px";
            //     element.style.paddingBottom = "15px";
            // } else if (this.valueAlignment.hposition == "left") {
            //     element.style.paddingTop = "15px";
            //     element.style.paddingBottom = this.data.layout.valuePaddingbottom + 15 + "px";
            // }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
        }
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (this.data.values[this.groupindex][index] == this.data.minValue && this.data.minValue < 0) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    subelement.style.lineHeight = "1.5";
    let minFontSize = this.minValueFontSize[this.arrIndex];
    if (this.data.valueTextColor[this.groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
    this.ChartHelper.adjustFontSize(subelement, 20, minFontSize, this.maxValueFontSize[this.arrIndex], true);
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, minFontSize, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (boolmax) {
        this.currentValW = element.clientWidth;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        element.remove();
        let multiSeries = this.data._seriesItemLength > 2 || (this.data._seriesItemLength > 1 && this.data.seriesLength > 1);
        if (
            ((parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && this.data.seriesLength > 5) || (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && multiSeries) || (overlapgrid && this.voData.presentMode && this.data.seriesLength > 7)) &&
            this.data.chartName != "barSimpleiconRepeatFill" &&
            !this.data.promptText
        ) {
            this.currentValW = 0;
            this.valueMaxLimit = this.valueOverlapping(false, argprops);
        } else {
            if (overlapgrid) {
                this.removeGrid();
            }
        }
        if (overlapgrid) {
            this.currentValW = 0;
        }
    } else {
        if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
        fontsize = window.getComputedStyle(subelement)["font-size"];
        // element.style.display = "none"
        if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
            if (this.data.suffixStyle) {
                let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
                if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
            }
            if (this.data.prefixStyle) {
                let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
                if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
            }
        }
        if (overlapgrid || (overlapgrid && this.voData.presentMode)) {
            element.style.display = "none";
        }
    }
};

BaseBarSeriesItem.prototype.doAddLeftPlaceholder = function (argparent, argprops, boolMidElement = false, svgelement = false) {
    const index = argprops.index;
    let type = String(argprops.placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    const bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    let padding = this.setoverlapPadding("placeholder");
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.marginLeft = padding["right"] + "px";
    baseelement.style.marginRight = padding["left"] + "px";
    baseelement.style.marginTop = padding["top"] + "px";
    baseelement.style.marginBottom = padding["bottom"] + "px";
    baseelement.style.pointerEvents = "all";
    baseelement.style.position = "relative";
    // baseelement.className =this.data.layout.placholderGlopalStyle;
    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");
    if (argparent) argparent.appendChild(baseelement);
    baseelement.style.position = "relative";
    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");
    // baseelement.classList.add("chartclsContentNode");
    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");
    if (this.data.layout.placeholderPaddingClass) {
        baseelement.classList.add(this.data.layout.placeholderPaddingClass);
    }
    // if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner") {
    // } else {
    //     baseelement.style.height = this.data.layout.placholderHeight ? this.data.layout.placholderHeight + "px" : bounds.height + "px";
    //     baseelement.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    // }

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);

    const element = this.ChartHelper.createDivElement({});
    element.id = "primaryplaceholder-" + index;
    element.style.position = "relative";
    element.style.zIndex = "1";
    element.className = "primaryplaceholder leftprimaryplaceholder";
    element.style.position = "relative";
    element.style.height = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.height + "px";
    element.style.width = bounds.width + "px";
    element.style.order = this.placeholderAlignment.index;
    if (this.placeholderStyle == this.ChartFonts.valueInnerColor) element.style.zIndex = 1;
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position != "middle") {
        // this.bgProperties(element)
    }

    if (this.placeholderStyle == this.ChartFonts.valueInnerColor) element.style.zIndex = 1;
    if (boolMidElement) {
        element.style.display = "flex";
        element.style.justifyContent = "center";
        element.setAttribute("data-animation", "");
        element.className = "primaryplaceholder rightprimaryplaceholder";
    }
    baseelement.appendChild(element);
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

BaseBarSeriesItem.prototype.doAddLeftGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let highlightPoint = false;
    let highlightDifferenceHeight = 0;
    if (this.data.highlightDifference.display && (this.valueAlignment.position != "outer" || this.valueAlignment.itemBased == "true")) {
        this.highlightNodes = [this.data.highlightDifference.point1, this.data.highlightDifference.point2];
        this.highlightNodes.sort(function (a, b) {
            return a - b;
        });
        highlightDifferenceHeight = 70;
        if (this.data.layout.valueInset == "bgoutside" || this.valueAlignment.itemBased == "true") {
            highlightDifferenceHeight = 120;
        }
    }
    let extraElementWidth = 0;
    if (this.data.layout.extraElementWidth) {
        extraElementWidth = this.data.layout.extraElementWidth;
    }
    let layoutParent = "";
    let valueStaticalParent = "";
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baseleftgraphic";
    element.style.height = "100%";
    element.style.width = "calc(100% - " + _oWidth + "px)";
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top") {
                element.style.setProperty("flex-direction", "column-reverse", "important");
            } else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top" && this.labelAlignment.vposition == "top") {
                element.style.setProperty("flex-direction", "column-reverse", "important");
            } else element.style.flexDirection = "column";
        }
        element.style.alignItems = "flex-end";
    }
    if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") {
        element.style.alignItems = "flex-end";
        if (this.data.chartFlip) {
            element.style.alignItems = "flex-start";
        }
    }

    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.valueAlignment.itemBased == "true" && this.labelAlignment.itemBased == "true") {
        if (this.labelAlignment.vposition == "top" && this.valueAlignment.vposition == "bottom") {
            element.style.setProperty("flex-direction", "column-reverse", "important");
        }
    }

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddLeftValue(element, argprops, true);

    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.labelMaxW * 0.5;
        this.middleLH = this.labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middleVH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation ";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle") {
        this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middlePH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
    }

    const parentWidth = this.state.width;
    let baseGraphicWidth;
    let valueWidth = argprops.minvalue < 0 ? 2 * (this.currentValW + 1) : this.currentValW;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") {
        baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + this.maxLabelW + dropShadowHeight + highlightDifferenceHeight + extraElementWidth);
    } else {
        if (this.data.chartName == "bar3DChart" && this.labelAlignment.itemBased != "true") {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + valueWidth + this.placeholderWidth + extraElementWidth);
        } else {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + extraElementWidth);
        }
    }
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const baseGraphicWidthPercentage = baseGraphicWidth;
    const bgGraphicWidthPercentage = 1;
    let dummeyValue = -argprops.value;
    if (this.data.highvaluebreak && argprops.value != this.data._minValue) {
        let differncePercentage = (this.data.rangeNegative * 0.8) / this.data.secondnegativeHighValue;
        dummeyValue = -argprops.value * differncePercentage;
    }
    let graphicWidthPercentage = baseGraphicWidthPercentage * (dummeyValue / totalValue);
    let parentPercentage = baseGraphicWidthPercentage * (-argprops.minvalue / totalValue);
    let parentWidthValue = parentPercentage;
    if (this.valueAlignment.position == "outer" && this.data.layout.valueInset != "bgoutside" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition != "left") {
        parentWidthValue = parentPercentage + this.currentValW;
    }
    // let seriesItem = this.parent.querySelectorAll(".leftseriesitem");
    // // seriesItem.style.height = (parentPercentage+this.maxValueH)+"px";
    // // seriesItem.style.height = this.data.SVGUtils.createPercentValue(this.state.height, (parentPercentage+this.maxValueH))
    // for (let c1 = 0; c1 < seriesItem.length; c1++) {
    //     seriesItem[c1].style.width = this.data.SVGUtils.createPercentValue(this.state.width, parentWidthValue);
    //     seriesItem[c1].dataset.parentSeriesWidth = parentPercentage;
    // }
    // let rightSeriesItemElement = this.parent.querySelectorAll(".rightseriesitem");
    // for (let j1 = 0; j1 < rightSeriesItemElement.length; j1++) {
    //     if (rightSeriesItemElement[j1]) {
    //         let rightseriesWidth = this.state.width - parentWidthValue;
    //         rightSeriesItemElement[j1].style.width = this.data.SVGUtils.createPercentValue(this.state.width, rightseriesWidth);
    //     }
    // }

    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        this.middlePH = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        if (this.data.layout.placholderHeight) {
            this.middlePH = this.data.layout.placholderHeight;
        }
        if (this.data.layout.placholderWidth) {
            this.middlePW = this.data.layout.placholderWidth;
        }
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.setAttribute("data-animation", "primaryplaceholder");
        middleelementPlaceholder.style.marginLeft = this.middlePW * 0.7 + "px";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        element.appendChild(middleelementPlaceholder);
        if (this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
            middleelementPlaceholder.style.top = "3%";
        }

        if (this.data.layout.boolplaceholderShape) {
            this.bgProperties(middleelementPlaceholder);
        }
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }

    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        let bgStyleClass = this.getBgColorDetails(groupindex, this.ChartFonts.emphasizeColor, this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        backgroundElement.className = "backgroundItem moodanimation" + bgStyleClass;
        backgroundElement.style.width = bgGraphicWidthPercentage * 100 + "%";
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundOpacity != 0) {
            element.style.setProperty("--bg-opacity", this.data.layout.backgroundOpacity);
        }
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " cs-chart-main-graphic moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = bgGraphicWidthPercentage * 100 + "%";
            backgroundBorderElement.style.height = this.thicknessPercentage * 100 + "%";
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.boxSizing = "border-box";

            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);

            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            backgroundBorderElement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");

            // if (this.data.layout.backgroundBorder.color == "theme") {
            //     let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
            //     backgroundBorderElement.classList.add("accent" + (groupindex + 1) + "-border-color");
            //     // if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //     //     this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
            //     // }
            // }
        }
    }

    //"graphicbg";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    graphicWidthPercentage = graphicWidthPercentage > parentWidthValue ? parentWidthValue : graphicWidthPercentage;
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(parentWidthValue, graphicWidthPercentage);
    subelement.style.height = 100 * this.data.layout.itemthicknesssize + "%";
    subelement.style.order = 0;
    subelement.style.setProperty("--bg-opacity", "1");
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased != "true") {
        subelement.style.flexDirection = "row-reverse";
    }
    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = "calc(" + -graphicWidthPercentage * 100 + "% + " + this.middlePH * 0.5 + "px)";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            // if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
            //     subelement.style.marginLeft = this.middleVH * 0.5 + "px";
            //     if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            // } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
            //     subelement.style.marginLeft = this.middlePH * 0.5 + "px";
            //     if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            // } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
            //     subelement.style.marginLeft = this.middleLH * 0.5 + "px";
            //     if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            // }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let strStyleClass = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    // if(this.data.hasEmphasis){
    //     strStyleClass = "";
    // }
    const clsStyle = strStyleClass + " moodanimation " + this.negativeTransformValue;
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.dataset.itemlength = this.data.seriesItemLength;
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic graphicnode " + clsStyle;
    graphicElement.dataset.customorgin = this.customNegativeOrginmValue;
    graphicElement.dataset.graphicwidth = graphicWidthPercentage;
    graphicElement.style.width = 100 + "%";
    graphicElement.style.height = "100%";
    graphicElement.dataset.animation = "item";
    if (this.data.hasEmphasis || this.data.hasProjection || this.data._arrseriesItemHighValue[this.index] == "true") {
        graphicElement.classList.add("cs-chart-main-graphic");
    }
    if (this.data.chartName == "barStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") graphicElement.style.borderRadius = this.valueMaxH + "px";
    if (this.data.chartName == "barFillRectangle") graphicElement.style.position = "absolute";
    subelement.appendChild(graphicElement);
    if (this.style.bgFillType == "gradient" || (this.style.bgFillType == "gradient" && this.data.hasEmphasis && this.data.emphasis[groupindex] == true)) {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");

    strStyleClass =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder ? this.setNoEmphasis(graphicElement, strStyleClass, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, strStyleClass, groupindex) : strStyleClass;

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    let colorStyle = this.data.layout.itemBoxShdowColor == "theme" ? clsStyle : this.data.layout.itemBoxShdowColor;
    let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
    //graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;

    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "borderelement";
        borderElement.style.width = 100 + "%";
        borderElement.style.height = "100%";
        borderElement.style.boxSizing = "border-box";
        subelement.appendChild(borderElement);
        graphicElement.classList.remove(this.ChartFonts.appendgraphicBgColor(groupindex));
        // graphicElement.classList.remove("background-bg-color");
        // graphicElement.classList.add("background-bg-color");
        let strBordeStyleClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.voData.shapeBoderColor, "bordercolor");
        if (this.voData.shapeBoderColor == "theme") {
            strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);

            borderElement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            this.emphasisColor = " secondary-border-color";
            if (this.data.layout.itemborderstyle == "dashed") {
                borderElement.style.borderStyle = "dashed";
                borderElement.style.setProperty("--border-style", "dashed", "");
            } else {
                borderElement.style.setProperty("--border-style", "solid", "");
            }
            // if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
            //     if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
            //         let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
            //         let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
            //         graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
            //     }
            // }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex);
            }

            // if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName == "emphasize-basic-fill") || highlightPoint) {
            //     graphicElement.classList.remove("background-bg-color");
            //     graphicElement.classList.add(this.ChartFonts.appendgraphicBgColor(styleIndex));
            // }
            borderElement.classList.add("moodanimation");
            borderElement.dataset.animation = "itemborder";
            borderElement.setAttribute("data-graphic-x", graphicElement.clientWidth);
            if (this.data.chartFlip) {
                borderElement.setAttribute("data-graphic-x", -graphicElement.clientWidth);
            }
        }
        if (this.data.hasEmphasis || this.data._arrseriesItemHighValue[this.index] == "true") {
            borderElement.classList.add("cs-chart-main-graphic");
        }
        let borderAlign = this.voData.shapeBoderAlign == "left" ? "right" : this.voData.shapeBoderAlign == "right" ? "left" : this.voData.shapeBoderAlign;
        borderElement.classList.add("shapeborder" + borderAlign);
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");
        if (this.data.layout.backgroundborderstyle == "dashed") {
            if (backgroundBorderElement) backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment + "dashed");
            borderElement.style.setProperty("--border-style", "dashed", "");
        } else {
            borderElement.style.setProperty("--border-style", "solid", "");
            if (backgroundBorderElement) backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
        }
    }
    if (this.data.layout.backgroundborderstyle == "dashed" && backgroundBorderElement) {
        backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment + "dashed");
    } else {
        if (backgroundBorderElement) backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
    }

    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        if (this.data.layout.alterBorderRadiusClass) {
            graphicElement.classList.add(this.data.layout.alterBorderRadiusClass);
            if (borderElement) borderElement.classList.add(this.data.layout.borderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiusRightBottom + " " + borderRadiusLeftBottom + " " + borderRadiuslefttop + " " + borderRadiusRightTop;
            if (borderElement) borderElement.style.borderRadius = borderRadiusRightBottom + " " + borderRadiusLeftBottom + " " + borderRadiuslefttop + " " + borderRadiusRightTop;
        }
    }
    if (this.voData.layout.backgroundBorderRadiusValues && backgroundElement) {
        let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        if (this.data.layout.backgroundAlterBorderRadiusClass) {
            if (backgroundElement) backgroundElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
        } else {
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    if (borderElement) {
        borderElement.classList.remove("borderelement");
        borderElement.classList.add("borderelement");
    }
    let itembasedPlaceHolder = "";
    if (this.displayPrimaryPlaceholder(argprops)) {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.hposition == "left") {
            itembasedPlaceHolder = this.ChartHelper.createDivElement({});
            itembasedPlaceHolder.style.display = "flex";
            itembasedPlaceHolder.style.justifyContent = "center";
            itembasedPlaceHolder.style.alignItems = "center";
            itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
            element.parentNode.appendChild(itembasedPlaceHolder);
            this.doAddLeftPlaceholder(itembasedPlaceHolder, argprops);
            element.parentNode.style.flexDirection = "row";
        } else {
            if (this.placeholderAlignment.position == "outer" || graphicW < this.state.height * 0.6) {
                this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
                this.doAddLeftPlaceholder(element, argprops);
            } else if (this.placeholderAlignment.position == "inner") {
                this.placeholderStyle = this.ChartFonts.valueInnerColor;
                subelement.style.display = "flex";
                subelement.style.justifyContent = "flex-end";
                this.doAddLeftPlaceholder(subelement, argprops);
            }
        }
    }

    if ((this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true") && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")) {
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddLeftValue(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true") {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        this.doAddLeftValue(element, argprops, true);
        this.boolEnableInnerValue = (this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && element.clientWidth - subelement.clientWidth < this.currentValW;
        if (this.valueAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containerlabel");
            const valueLayoutName = this.valuelayoutClassName("containervalue");
            if (this.voData.layout.labelVPosition == this.voData.layout.valueVPosition && this.labelAlignment.itemBased == "true") {
                layoutParent = this.ChartHelper.createDivElement({});
                layoutParent.classList.add("layoutParentNode");
                layoutParent.style.flexDirection = "row";
                if (this.voData.layout.valueVPosition == "top") {
                    element.insertBefore(layoutParent, subelement);
                } else {
                    element.appendChild(layoutParent);
                }
            }
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;

            let elementHeight = 2 - this.thicknessPercentage;
            valueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) valueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            if (this.valueAlignment.hposition == "right") {
                valueElement.style.justifyContent = "flex-start";
            }

            if (this.valueAlignment.vposition == "bottom") {
                valueElement.style.setProperty("align-items", "flex-start", "important");
            }
            valueElement.className = "itembasedlabelelement " + containerAlignment + " " + valueLayoutName;
            // this.valueMaxW = this.state.width*0.5
            valueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.valueAlignment.position == "inner") {
                valueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent) {
                valueElement.style.height = 100 + "%";
                valueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                this.valueMaxW = element.clientWidth * 0.2;
                valueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    this.valueMaxW = element.clientWidth * 0.4;
                    valueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                layoutParent.appendChild(valueElement);
                this.valueMaxH = valueElement.clientHeight;
                this.doAddRightValue(element, argprops, true);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") {
                    element.insertBefore(valueElement, subelement);
                } else {
                    element.appendChild(valueElement);
                }
            }
            if (this.valueAlignment.itemBased == "true" && this.valueAlignment.vposition == "top" && valueElement && backgroundElement) {
                backgroundElement.style.top = valueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? valueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : valueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                valueElement.style.marginLeft = this.middlePW / 2 + "px";
            }
            this.labelMaxW = element.clientWidth;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            // this.valueMaxH = valueElement.clientHeight;
            this.doAddRightValue(valueElement, argprops);
            if (this.labelAlignment.itemBased != "true") {
                valueElement.style.maxHeight = elementHeight * 100 + "%";
                valueElement.style.height = "auto";
                if (valueElement.children[0]) {
                    valueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.currentValW) {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern"
                    ? this.data._emphasisName == "emphasize-grey"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) || this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern"
                    ? this.ChartFonts.graphicColor(groupindex)
                    : this.ChartFonts.valueOuterColor;

            this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
            if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-basic-border-grey") {
                this.valueStyle = this.ChartFonts.valueOuterColor;
            }
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill" || this.data.layout.valueInset == "bgoutside") this.doAddLeftValue(argparent, argprops);
            else {
                if (this.labelAlignment.itemBased == "true") this.doAddLeftValue(subelement, argprops);
                else this.doAddLeftValue(element, argprops);
            }
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            const vLayoutName = this.valuelayoutClassName("containervalue", true);
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;

            if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            this.doAddLeftValue(valueElement, argprops, false);
        }
    }
    if (false) {
        this.boolEnableInnerValue = (this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && element.clientWidth - subelement.clientWidth < this.currentValW;
        if (this.valueAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containerlabel");
            const valueLayoutName = this.valuelayoutClassName("containervalue");
            if (this.voData.layout.labelVPosition == this.voData.layout.valueVPosition && this.labelAlignment.itemBased == "true") {
                layoutParent = this.ChartHelper.createDivElement({});
                layoutParent.classList.add("layoutParentNode");
                layoutParent.style.flexDirection = "row";
                if (this.voData.layout.valueVPosition == "bottom") {
                    element.insertBefore(layoutParent, subelement);
                } else {
                    element.appendChild(layoutParent);
                }
            }
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;

            let elementHeight = 2 - this.thicknessPercentage;
            valueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) valueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            if (this.valueAlignment.hposition == "right") {
                valueElement.style.justifyContent = "flex-start";
            }

            if (this.valueAlignment.vposition == "bottom") {
                valueElement.style.setProperty("align-items", "flex-start", "important");
            }
            valueElement.className = "itembasedlabelelement " + containerAlignment + " " + valueLayoutName;
            // this.valueMaxW = this.state.width*0.5
            valueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.valueAlignment.position == "inner") {
                valueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent) {
                valueElement.style.height = 100 + "%";
                valueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                this.valueMaxW = element.clientWidth * 0.2;
                valueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    this.valueMaxW = element.clientWidth * 0.4;
                    valueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                layoutParent.appendChild(valueElement);
                this.valueMaxH = valueElement.clientHeight;
                this.doAddRightValue(element, argprops, true);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") {
                    element.insertBefore(valueElement, subelement);
                } else {
                    element.appendChild(valueElement);
                }
            }
            if (this.valueAlignment.itemBased == "true" && this.valueAlignment.vposition == "top" && valueElement && backgroundElement) {
                backgroundElement.style.top = valueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? valueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : valueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                valueElement.style.marginLeft = this.middlePW / 2 + "px";
            }
            this.labelMaxW = element.clientWidth;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            // this.valueMaxH = valueElement.clientHeight;
            this.doAddRightValue(valueElement, argprops);
            if (this.labelAlignment.itemBased != "true") {
                valueElement.style.maxHeight = elementHeight * 100 + "%";
                valueElement.style.height = "auto";
                if (valueElement.children[0]) {
                    valueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.currentValW) {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern"
                    ? this.data._emphasisName == "emphasize-grey"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) || this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern"
                    ? this.ChartFonts.graphicColor(groupindex)
                    : this.ChartFonts.valueOuterColor;

            this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
            if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-basic-border-grey") {
                this.valueStyle = this.ChartFonts.valueOuterColor;
            }
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill" || this.data.layout.valueInset == "bgoutside") this.doAddLeftValue(argparent, argprops);
            else {
                if (this.labelAlignment.itemBased == "true") this.doAddLeftValue(subelement, argprops);
                else this.doAddLeftValue(element, argprops);
            }
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            const vLayoutName = this.valuelayoutClassName("containervalue", true);
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;

            if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            this.doAddLeftValue(valueElement, argprops, false);
        }
    }
    if (this.data.showStatistical) {
        graphicW = graphicWidthPercentage;
        if ((this.data.chartName.includes("comparisonModel") || this.data.chartName == "barStackedRectangle") && this.statisticalAlignment.position == "inner") {
            graphicW = subelement.clientWidth;
        }
        this.createStatistacalContainer(element, true);
        this.statisticalStyle = this.getColorDetails(this.groupindex, this.ChartFonts.valueOuterColor, this.data.layout.statisticalColor, "color");
        if (this.statisticalAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            let vLayoutName = this.statisticallayoutClassName("containerlabel");
            let statistacalLayoutName = this.statisticallayoutClassName("containervalue");
            let statistacalValueElement = this.ChartHelper.createDivElement({});
            statistacalValueElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            statistacalValueElement.style.height = elementHeight * 100 + "%";
            if (this.data.seriesLength > 2) statistacalValueElement.style.overflow = "unset";
            let containerAlignment;
            if (vLayoutName != "containerlabellefttop") {
                containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            } else {
                containerAlignment = "itemlabellefttop";
            }
            if (this.statisticalAlignment.vposition == "bottom") {
                statistacalValueElement.style.setProperty("align-items", "flex-start", "important");
            }
            statistacalValueElement.className = "itembasedlabelelement " + containerAlignment + " " + statistacalLayoutName;
            statistacalValueElement.style.width = graphicElement.clientWidth < 150 ? (this.valueMaxW < 200 ? "300px" : this.valueMaxW + "px") : graphicElement.clientWidth + "px";

            if (this.statisticalAlignment.position == "inner") {
                statistacalValueElement.style.width = element.clientWidth + "px";
            }
            if (layoutParent && (this.statisticalAlignment.vposition == this.valueAlignment.vposition || this.statisticalAlignment.vposition == this.labelAlignment.vposition)) {
                statistacalValueElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                if (this.data.promptText) {
                    statistacalValueElement.style.width = element.clientWidth * 0.4 + "px";
                }
                if (this.valueAlignment.itemBased == "true") {
                    statistacalValueElement.style.width = element.clientWidth * 0.2 + "px";
                }
                statistacalValueElement.style.height = "100%";
                layoutParent.appendChild(statistacalValueElement);
                // this.createStatistacalContainer(element,true);
            } else if (this.statisticalAlignment.vposition == this.labelAlignment.vposition) {
                labelStaticalParent = this.ChartHelper.createDivElement({});
                labelStaticalParent.classList.add("layoutParentNode");
                labelStaticalParent.classList.add("labelstatistical");
                if (this.voData.layout.statisticalVPosition == "top") {
                    element.insertBefore(labelStaticalParent, subelement);
                } else {
                    element.appendChild(labelStaticalParent);
                }
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                labelStaticalParent.appendChild(statistacalValueElement);
            } else if (valueStaticalParent) {
                valueStaticalParent.style.width = "100%";
                statistacalValueElement.style.height = "100%";
                statistacalValueElement.style.width = element.clientWidth * 0.5 + "px";
                valueStaticalParent.appendChild(statistacalValueElement);
            } else {
                if (this.labelAlignment.itemBased == "true" && this.statisticalAlignment.itemBased == "true") {
                    element.insertBefore(statistacalValueElement, subelement);
                } else {
                    element.appendChild(statistacalValueElement);
                }
            }
            if (this.statisticalAlignment.itemBased == "true" && this.statisticalAlignment.vposition == "top" && statistacalValueElement && backgroundElement) {
                backgroundElement.style.top = statistacalValueElement.clientHeight + "px;";
                if (backgroundBorderElement) {
                    backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? statistacalValueElement.clientHeight - this.data.layout.backgroundBorder.width + "px" : statistacalValueElement.clientHeight + "px";
                }
            }
            if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
                statistacalValueElement.style.marginLeft = this.middlePW / 2 + "px";
            } // this.valueMaxH = valueElement.clientHeight;
            this.createStatistacalContainer(statistacalValueElement);
            if (this.labelAlignment.itemBased != "true") {
                statistacalValueElement.style.maxHeight = elementHeight * 100 + "%";
                statistacalValueElement.style.height = "auto";
                if (statistacalValueElement.children[0]) {
                    statistacalValueElement.children[0].style.height = "auto";
                }
            }
        } else if ((this.statisticalAlignment.position == "outer" && this.statisticalAlignment.itemBased != "true" && !this.boolEnableInnerValue) || graphicW < this.statisticalWidth) {
            // this.valueStyle = this.getColorDetails(multiValueSeriesIndex, this.valueStyle, this.data.layout.statisticalColor, "color");
            if (this.data.layout.statisticalInset == "bgoutside") {
                this.statisticalAlignment.position == "inner" ? this.createStatistacalContainer(element) : this.createStatistacalContainer(argparent);
                if (this.data.layout.statisticalInset == "bgoutside") {
                    argparent.style.display = "flex";
                    if (this.labelAlignment.itemBased != "true") {
                        argparent.style.alignItems = "center";
                    }
                }
            } else {
                graphicW = Math.round(subelement.clientWidth);
                if (this.labelAlignment.itemBased == "true" || this.alignment.itemBased == "true") {
                    this.createStatistacalContainer(subelement);
                } else this.createStatistacalContainer(element, false);
            }
        } else if ((this.statisticalAlignment.position == "inner" && this.statisticalAlignment.itemBased != "true") || this.boolEnableInnerValue) {
            let vLayoutName = this.statisticallayoutClassName("containervalue");
            let statisticalLayoutName = this.statisticallayoutClassName("statisticalvalue");
            const statisticalElement = this.ChartHelper.createDivElement({});
            statisticalElement.id = "statisticalElement-" + groupindex + "_" + index;
            statisticalElement.className = "statisticalElement " + vLayoutName + " " + statisticalLayoutName;
            statisticalElement.style.width = "100%";
            subelement.appendChild(statisticalElement);
            this.statisticalStyle = this.ChartFonts.valueInnerColor;
            if (this.data.layout.itemColor != "bgcolor") this.statisticalArrowStyle = this.ChartFonts.valueInnerColor;
            if (this.data.chartName.includes("comparisonModel") && index == 1) {
                vLayoutName = this.statisticallayoutClassName("containervalue", true);
                statisticalElement.className = "statisticalElement " + vLayoutName;
            }
            this.createStatistacalContainer(statisticalElement);
        }
    }
    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true") {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            this.doAddLeftValue(element, argprops, true);
            let vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            labelElement.style.height = elementHeight * 100 + "%";
            if (vLayoutName == "containerlabellefttop") {
                vLayoutName = "containerlabelrighttop";
            }
            if (vLayoutName == "containerlabelleftbottom") {
                vLayoutName = "containerlabelrightbottom";
            }
            labelElement.className = "itembasedlabelelement " + vLayoutName + " containerlabe" + this.data.layout.labelHPosition;
            // labelElement.style.height = (this.labelMaxH + this.data.layout.paddingTop + this.data.layout.paddingBottom) + "px";
            labelElement.style.width = graphicElement.clientWidth < 150 ? 200 + "px" : graphicElement.clientWidth + "px";
            if (layoutParent) {
                labelElement.style.width = element.clientWidth * 0.8 + "px";
                if (this.data.promptText) labelElement.style.width = element.clientWidth * 0.6 + "px";
                labelElement.style.setProperty("align-items", "flex-end", "important");
                layoutParent.style.height = elementHeight * 100 + "%";
                labelElement.style.height = "100%";
                layoutParent.appendChild(labelElement);
            } else {
                element.appendChild(labelElement);
            }
            // this.labelMaxH = labelElement.clientHeight;
            this.labelMaxW = labelElement.clientWidth;
            if (layoutParent) {
                this.labelMaxW = element.clientWidth * 0.8;
                if (this.data.promptText) {
                    this.labelMaxW = element.clientWidth * 0.6;
                }
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops, false, false, true, false, true);

            if (this.valueAlignment.itemBased != "true") {
                labelElement.style.maxHeight = elementHeight * 100 + "%";
                labelElement.style.height = "auto";
                if (labelElement.children[0]) {
                    labelElement.children[0].style.height = "auto";
                    labelElement.parentNode.style.justifyContent = "center";
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
            } else {
                if (labelElement.children[0]) {
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
                let ValueElement = labelElement.parentNode.querySelector(".value");
                if (ValueElement) {
                    ValueElement.parentNode.style.minHeight = ValueElement.clientHeight + "px";
                }
            }
        } else if (this.labelAlignment.position == "outer" || graphicW < this.labelMaxW) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(argparent.parentNode, argprops);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            // if (
            //     this.data.projection[groupindex] == true &&
            //     this.data.hasProjection &&
            //     (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")
            // ) {
            //     this.labelStyle = this.ChartFonts.labelOuterColor;
            //     if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
            //         this.labelStyle = this.ChartFonts.graphicColor(groupindex);
            //     }
            // }
            // if (
            //     this.data.projection[groupindex] == true &&
            //     this.voData.shapeBorder &&
            //     this.data.hasProjection &&
            //     (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")
            // ) {
            //     this.labelStyle = this.ChartFonts.labelInnerColor;
            // }
            if (argprops.value < 0) labelElement.style.justifyContent = "flex-end";
            this.labelMaxW = subelement.clientWidth * 0.9;
            this.labelMaxW = this.labelMaxW < 80 ? 80 : this.labelMaxW;
            this.doAddLabel(labelElement, argprops);
        }
    }
    if (this.data.highvaluebreak && argprops.value == this.data.rangePositive) {
        let highvalueBreakElemnt = this.ChartHelper.createDivElement({});
        highvalueBreakElemnt.style.width = "4%";
        highvalueBreakElemnt.style.position = "absolute";
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.right = "20%";
        } else {
            highvalueBreakElemnt.style.left = "20%";
        }
        highvalueBreakElemnt.style.height = "100%";
        highvalueBreakElemnt.style.backgroundColor = "white";
        graphicElement.style.position = "relative";
        graphicElement.parentNode.appendChild(highvalueBreakElemnt);
    }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode " + clsStyle + " projection" + (groupindex + 1);
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     graphicElement.classList.add("tertiary-bg-color");
    //     graphicElement.style.boxShadow = "";
    // }
    // if (
    //     this.data.projection[groupindex] == true &&
    //     this.data.hasProjection &&
    //     (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert") &&
    //     this.data.shapeBorder
    // ) {
    //     graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode " + clsStyle;
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-alpha" && this.data.shapeBorder) {
    //     graphicElement.classList.add("borderprjectionOpacity");
    //     graphicElement.dataset.customopacity = "0.4";
    //     borderElement.classList.add("borderprjectionOpacity");
    //     borderElement.dataset.customopacity = "0.4";
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder) {
    //     borderElement.classList.add("secondary-border-color");
    // }
    // if (
    //     this.data.projection[groupindex] == true &&
    //     this.data.hasProjection &&
    //     (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") &&
    //     !this.data.shapeBorder
    // ) {
    //     let borderColor = "secondary-border-color";
    //     // if (this.data._projectionName == "projection-basic-border-invert") {
    //     //     borderColor = this.ChartFonts.graphicBorderColor(groupindex);
    //     // }
    //     if (this.data._projectionName != "projection-alpha") {
    //         graphicElement.className = "chartgraphic  cs-chart-main-graphic graphicnode moodanimation transformOrginRight " + borderColor;
    //         graphicElement.style.boxShadow = "";
    //     }
    // } else {
    //     // if (
    //     //     ((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) ||
    //     //         (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey")) &&
    //     //     this.data.shapeBorder &&
    //     //     this.data._emphasisName != "emphasize-basic-fill" &&
    //     //     this.data._emphasisName != "emphasize-basic-pattern"
    //     // ) {
    //     //     let strBordeStyleClass = "secondary-border-color";
    //     //     if (borderElement) borderElement.classList.add(strBordeStyleClass);
    //     //     graphicElement.classList.remove("background-bg-color");
    //     //     graphicElement.classList.add("background-bg-color");
    //     //     let rgbaValue = this.ChartUtils.createRBGColor(strBordeStyleClass, styleIndex, this.data.layout.itemBoxShdowOpacity);
    //     //     graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    //     // }
    // }
    // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
    //     const subImgelement = document.createElement("img");
    //     subImgelement.style.width = "100%";
    //     subImgelement.style.height = "100%";
    //     subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
    //     // subImgelement.style.position = "unset";
    //     subImgelement.id = "graphicimage-" + groupindex + "_" + index;
    //     subImgelement.className = "graphicimage";
    //     subImgelement.setAttribute("data-id", groupindex + "_" + index);
    //     subImgelement.setAttribute("data-type", "IMAGE");
    //     graphicElement.appendChild(subImgelement);
    //     let item = this.ChartUtils.getOffsetLeftTop(graphicElement, "", true, false);
    //     graphicElement.setAttribute("data-x", item.x);
    //     graphicElement.setAttribute("data-y", item.y);
    //     graphicElement.setAttribute("data-width", graphicElement.clientWidth);
    //     graphicElement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-width", graphicElement.clientWidth);
    //     subImgelement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

    //     subImgelement.setAttribute("data-x", item.x);
    //     subImgelement.setAttribute("data-y", item.y);
    //     graphicElement.style.position = "absolute";
    //     graphicElement.style.overflow = "hidden";
    //     this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img");
    //     if (this.data.layout.itemFillType == "imagewithfilter") {
    //         this.ChartUtils.applyOverlayToImage(subImgelement, "var(--item" + (styleIndex + 1) + "-color)");
    //     }
    // }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        if (this.data.layout.alterborderRadiusClass) {
            graphicElement.classList.add(this.data.layout.alterborderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiusRightBottom + " " + borderRadiusLeftBottom + " " + borderRadiuslefttop + " " + borderRadiusRightTop;
        }
    }
    if (this.data.layout.itemFillType == "pattern") {
        this.createPatternSvg(graphicElement);
    }
    if (this.data.layout.backgroundFillType == "pattern") {
        this.createPatternSvg(backgroundElement);
    }
    if (itembasedPlaceHolder) {
        itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
    }
    if (backgroundElement) {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
        if (backgroundBorderElement) backgroundBorderElement.style.height = graphicElement.clientHeight + 2 + "px";
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.vposition == "top" && backgroundElement) {
            backgroundElement.style.top = graphicElement.parentNode.offsetTop + "px";
            if (backgroundBorderElement) {
                backgroundBorderElement.style.top = this.data.layout.backgroundBorder.width ? graphicElement.parentNode.offsetTop - this.data.layout.backgroundBorder.width + "px" : graphicElement.parentNode.offsetTop + "px";
            }
        }
        if (this.data.layout.data.background.opacity || this.data.layout.backgroundOpacity) {
            let Class = this.getBgClassList(backgroundElement);
            let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
            backgroundElement.style.setProperty("background-color", rgbavalue, "important");
        }
    }
    if (this.placeholderAlignment.vposition == "middle" && this.labelAlignment.vPosition == "bottom" && middleelementPlaceholder && this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
        middleelementPlaceholder.style.top = graphicElement.clientHeight / 2 + "px";
    }
    ///DropShadow
    if (this.data.layout.itemShadow && this.data.chartName != "barStackedRectangle") {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
    if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "outer" && this.labelAlignment.itemBased == "true" && borderElement) {
        borderElement.style.width = graphicElement.clientWidth + "px";
    }
};

BaseBarSeriesItem.prototype.labellayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    }
    return lLayoutName;
};

BaseBarSeriesItem.prototype.secondarylayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.alignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        //   if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.alignment.hposition + this.alignment.vposition;
    }
    return lLayoutName;
};

BaseBarSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax, boolInnerValue = false, boolenableminSize = true, disableHeight = false, isNegative = false) {
    if (this.data.layout.showLabel) {
        const groupindex = argprops.gindex;
        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder)) {
        } else if (this.data.layout.labelColor) {
            this.labelStyle = this.getColorDetails(groupindex, this.labelStyle, this.data.layout.labelColor, "color");
        }
        let padding = this.setoverlapPadding("label");
        let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;
        let lLayoutName = this.labelAlignment.itemBased == "true" ? this.labellayoutClassName("itemlabel") : this.labellayoutClassName("label");
        let labelFontStyle = this.data.arrLabelFontStyle[valGroupIndex] ? this.data.arrLabelFontStyle[valGroupIndex] : this.ChartFonts.labelThemeClassName;
        let element = document.createElement("div");
        element.className = "label outerColor1 moodanimation " + labelFontStyle + " " + lLayoutName;
        element.id = "label-text-" + valGroupIndex;
        element.style.minWidth = 10 + "px";
        if (!disableHeight) element.style.height = this.labelMaxH + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labelMaxH + "px";
        element.style.justifyContent = "unset";
        element.setAttribute("data-textalign", "horizantal");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";

        if (this.data.layout.labelfontsize) {
            element.style.fontSize = this.maxLabelFontSize[this.arrIndex] + "px";
        }
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName == "emphasize-basic-pattern" && this.labelAlignment.position == "inner") {
            element.style.visibility = "hidden";
        }
        if (isNegative) {
            element.style.justifyContent = "flex-end";
        }
        if (argprops.value < 0) {
            element.style.paddingLeft = padding["right"] + "px";
            element.style.paddingRight = padding["left"] + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        if (this.placholderHPos == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
            element.style.marginLeft = this.middlePW / 2 + "px";
        }
        if (this.labelAlignment.hposition == "left") element.style.textAlign = "start";
        if (argparent) argparent.appendChild(element);
        else return element;

        let labelColor = this.getColorDetails(groupindex, this.labelStyle, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;

        if (this.labelStyle == "clsAlterTertiaryColor") {
            element.style.position = "absolute";
            element.style.zIndex = 1;
        }
        // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        //     element.style.position = "absolute";
        // }
        let topPadding = window.getComputedStyle(element)["padding-top"] ? parseFloat(window.getComputedStyle(element)["padding-top"]) : 0;
        let bottomPadding = window.getComputedStyle(element)["padding-bottom"] ? parseFloat(window.getComputedStyle(element)["padding-bottom"]) : 0;

        let dummeyHeight = this.labelMaxH - (bottomPadding + topPadding);

        let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //
        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        if (this.labelAlignment.position == "inner" && !this.labelOverlab) {
            subelement.className = "labeltext " + this.labelStyle;
        }
        if (this.labelAlignment.position == "inner" && this.labelOverlab) {
            subelement.dataset.overlaplabel = "true";
        }
        subelement.id = "labeltext-" + valGroupIndex;
        if (this.data.arrLabelOpacity[valGroupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[valGroupIndex], "");
        if (this.data.arrLabeltexttransform[valGroupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[valGroupIndex], "");
        subelement.innerHTML = boolMax || boolInnerValue ? this.data.longLabel : this.data.labels[valGroupIndex];
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = dummeyHeight + "px";
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", valGroupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(valGroupIndex);
        if (this.data.hasEmphasis || this.data.hasProjection) {
            subelement.classList.add("cs-label-text");
        }
        if (this.data._labelTextColor[valGroupIndex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[valGroupIndex], "important");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(valGroupIndex);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, valGroupIndex, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        if (this.labelAlignment.itemBased == "true") {
            subelement.style.overflow = "hidden";
        }
        element.appendChild(subelement);
        if (this.data.presentMode) {
            subelement.setAttribute("data-dck-selector", "false");
            subelement.setAttribute("contenteditable", "false");
        }
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                // if (this.labelAlignment.vposition == "bottom") {
                //     element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                //     element.style.paddingBottom = "15px";
                // } else if (this.labelAlignment.vposition == "top") {
                //     element.style.paddingTop = "15px";
                //     element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                // }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        } else {
            if (this.labelStyle == "clsTextSecondaryColor" || this.labelStyle == " clsTextSecondaryColor") {
                subelement.classList.add("transparentBg");
            } else if (this.labelAlignment.position == "inner") {
                subelement.classList.add("titleColorBg");
            }
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        if (this.labelAlignment.position == "inner") {
            subelement.classList.add("titleColorBg");
        } else {
            subelement.classList.add("transparentBg");
        }
        if ((this.labelAlignment.position == "inner" || argprops.value > 0) && boolenableminSize) element.classList.add("minlabelsize");
        let minFontValue = this.ChartFonts.minFontSize;
        // if(this.valueAlignment.itemBased=="true"&&this.labelAlignment.itemBased=="true"&&this.labelAlignment.vposition=="top"&&(this.data._customProperties.showXAxisTitle||dummeyHeight<this.ChartFonts.maxLabelFontSize(element))){
        //     minFontValue = 12;
        // }
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - minFontValue, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.maxLabelW = element.clientWidth;
            element.remove();
        }
        if (boolInnerValue) {
            this.innerlabelmaxWidth = element.clientWidth;
            element.remove();
        }
        if (subelement && this.ChartFonts.valueInnerColor && subelement.getAttribute("class") && subelement.getAttribute("class").includes(this.ChartFonts.valueInnerColor)) {
            subelement.classList.remove("cs-inner-text-color");
            subelement.classList.add("cs-inner-text-color");
        }
    }
};

BaseBarSeriesItem.prototype.doAddSecondaryLabel = function (argparent, argprops, boolMax, boolInnerValue = false, boolenableminSize = true, disableHeight = false) {
    const groupindex = argprops.gindex;

    if ((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder)) {
    } else if (this.data.layout.labelColor == "item") {
        this.labelStyle = this.ChartFonts.graphicColor(groupindex);
    }

    let padding = this.setoverlapPadding("label");
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;
    let lLayoutName = this.alignment.itemBased == "true" ? this.secondarylayoutClassName("itemlabel") : this.secondarylayoutClassName("label");
    let element = document.createElement("div");
    element.className = "label outerColor1 moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(valGroupIndex) + " " + lLayoutName;
    element.id = "label-text-" + valGroupIndex;
    element.style.minWidth = 10 + "px";
    if (!disableHeight) element.style.height = this.labelMaxH + "px";
    element.style.maxWidth = this.labelMaxW + "px";
    element.style.maxHeight = this.labelMaxH + "px";
    element.style.justifyContent = "unset";
    element.setAttribute("data-textalign", "horizantal");
    element.dataset.animation = "primarytext";
    element.style.order = this.alignment.index;
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName == "emphasize-basic-pattern" && this.labelAlignment.position == "inner") {
        element.style.visibility = "hidden";
    }
    if (argprops.value < 0 && this.alignment.position == "inner") {
        element.style.paddingLeft = padding["right"] + "px";
        element.style.paddingRight = padding["left"] + "px";
        if (this.data.layout.labelAlterPaddingClass) {
            element.classList.add(this.data.layout.labelAlterPaddingClass);
        }
    }
    if (this.placholderHPos == "left" && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        element.style.marginLeft = this.middlePW / 2 + "px";
    }
    if (this.alignment.hposition == "left") element.style.textAlign = "start";
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.labelStyle == "clsAlterTertiaryColor") {
        element.style.position = "absolute";
        element.style.zIndex = 1;
    }
    // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
    //     element.style.position = "absolute";
    // }

    let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //

    let hasInnerLabel = this.data.layout.labelInset == "inside";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
    let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;

    subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
    subelement.id = "labeltext-" + valGroupIndex;
    if (this.data.arrLabelOpacity[valGroupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[valGroupIndex], "");
    if (this.data.arrLabeltexttransform[valGroupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[valGroupIndex], "");
    subelement.innerHTML = boolMax || boolInnerValue ? this.data.longLabel : this.data.labels[valGroupIndex];
    if (this.data.layout.secondaryElementType == "squencenumber") {
        subelement.innerHTML = this.groupindex + 1;
    }
    if (this.labelAlignment.position == "inner" && !this.labelOverlab) {
        subelement.className = "labeltext " + this.labelStyle;
    }
    subelement.style.maxWidth = this.labelMaxW + "px";
    subelement.style.maxHeight = this.labelMaxH + "px";
    subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "label");
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", valGroupIndex);
    subelement.setAttribute("data-prompt-text", "Enter Label");
    subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(valGroupIndex);

    if (this.data._labelTextColor[valGroupIndex][valIndex]) {
        subelement.style.setProperty("color", this.data._labelTextColor[valGroupIndex][valIndex], "important");
    }

    if (this.alignment.itemBased == "true") {
        subelement.style.overflow = "hidden";
    }
    element.appendChild(subelement);
    if (this.data.presentMode) {
        subelement.setAttribute("data-dck-selector", "false");
        subelement.setAttribute("contenteditable", "false");
    }
    if (this.alignment.textbg == "true") {
        subelement.classList.add("textbg" + this.alignment.textbgstyle);
        if (this.alignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            // if (this.alignment.vposition == "bottom") {
            //     element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
            //     element.style.paddingBottom = "15px";
            // } else if (this.alignment.vposition == "top") {
            //     element.style.paddingTop = "15px";
            //     element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
            // }
            subelement.classList.add("textbgcallout" + this.alignment.textbgstyle + this.labelAlignment.vposition);
        }
    } else {
        if (this.labelStyle == "clsTextSecondaryColor" || this.labelStyle == " clsTextSecondaryColor") {
            subelement.classList.add("transparentBg");
        } else if (this.alignment.position == "inner") {
            subelement.classList.add("titleColorBg");
        }
    }
    if ((this.alignment.position == "inner" || argprops.value > 0) && boolenableminSize) element.classList.add("minlabelsize");
    this.ChartHelper.setTextChangeListner(subelement);
    this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement);
    this.ChartHelper.recalculateMaxHeight(subelement);
    if (boolMax) {
        this.maxLabelW = element.clientWidth;
        element.remove();
    }
    if (boolInnerValue) {
        this.innerlabelmaxWidth = element.clientWidth;
        element.remove();
    }
};

BaseBarSeriesItem.prototype.doAddProjection = function (argparent) {
    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond ",
        id: "placeholder-" + this.groupindex + "_0",
        width: "60%",
        height: "60%",
    });
    argparent.style.display = "flex";
    argparent.style.alignItems = "center";
    argparent.style.justifyContent = "center";

    // let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
    // let patternTag = this.data.SVGUtils.createSVGElement("pattern");
    // this.data.SVGUtils.assignAttributes(patternTag, {
    //     id: "pattern",
    //     patternUnits: "userSpaceOnUse",
    //     width: "20",
    //     height: "20"
    // });
    // patternDefsTag.appendChild(patternTag);
    // let groupTag = this.data.SVGUtils.createSVGElement("g");
    // patternTag.appendChild(groupTag);
    let patternImageTag = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(patternImageTag, {
        class: this.ChartFonts.valueInnerColor,
        "xlink:href": "#chartprojectionpattern",
    });
    element.appendChild(patternImageTag);
    argparent.appendChild(element);
};
BaseBarSeriesItem.prototype.removeValueElement = function () {
    let valueElements = this.data.chartName == "barStackedRectangle" ? this.parent.parentNode.parentNode.parentNode.querySelectorAll(".value") : this.parent.parentNode.parentNode.parentNode.querySelectorAll(".value");
    if (valueElements) {
        Array.from(valueElements).forEach(function (item) {
            item.style.display = "none";
        });
    }
};
BaseBarSeriesItem.prototype.getPlaceholderBounds = function (props) {
    if (this.data.primaryPlaceholder) {
        if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
            return { width: this.state.height * 0.6, height: this.state.height * 0.5 };
        } else {
            return { width: this.state.height * 0.5, height: this.state.height * 0.5 };
        }
    } else {
        return { width: 0, height: this.state.height };
    }
};
BaseBarSeriesItem.prototype.labelMinHeight = function (longMinHeight) {
    let valueElements = this.parent && this.parent.parentNode && this.parent.parentNode.parentNode ? this.parent.parentNode.parentNode.querySelectorAll(".label") : [];
    if (valueElements) {
        Array.from(valueElements).forEach(function (item) {
            item.style.minWidth = longMinHeight + "px";
        });
    }
};
BaseBarSeriesItem.prototype.thicknesCalculation = function (barHeight, dividerWidth) {
    if (this.data.layout.itemgap && this.data.layout.itemgap > 2) {
        let differencePercentage = barHeight / this.data.layout.itemgap;
        let thickness = 8 * differencePercentage;
        thickness = thickness < 5 ? 5 : thickness;

        // Amplitude: how much the zigzag deviates from center (should be significant)
        let amplitude = dividerWidth * 0.35; // 35% of width for good visibility

        // Calculate segment width to ensure we have at least 8-12 segments for a good zigzag
        let optimalSegmentCount = Math.max(8, Math.min(15, Math.floor(barHeight / 15)));
        let individualWidth = barHeight / optimalSegmentCount;

        // Adjust amplitude to be proportional to segment width for better visual flow
        let adjustedAmplitude = Math.min(amplitude, individualWidth * 0.5);

        let count = optimalSegmentCount;

        // Adjust left and right positions to create the zigzag effect (vertical for bar chart)
        let centerX = dividerWidth / 2;
        let leftY = centerX - adjustedAmplitude;
        let rightY = centerX + adjustedAmplitude;

        return {
            thickness: thickness,
            top: leftY,
            bottom: rightY,
            Width: individualWidth,
            count: count,
        };
    } else {
        return { thickness: 0, top: 0, bottom: 0, Width: 0, count: -1 };
    }
};
BaseBarSeriesItem.prototype.updateStatisticalFontSize = function (argParent) {
    if (argParent && argParent.parentNode && argParent.parentNode.parentNode) {
        let Values = argParent.parentNode.parentNode.querySelectorAll(".value").length > 0 ? argParent.parentNode.parentNode.querySelectorAll(".value")[0] : "";
        let parentNode = argParent.parentNode.parentNode;
        if (Values) {
            let fontSize = Values.children[0].style.fontSize ? parseFloat(Values.children[0].style.fontSize) : "";
            let arrMarkElement = parentNode.querySelectorAll(".statisticalmark");
            let markFondSize = arrMarkElement.length > 0 && window.getComputedStyle(arrMarkElement[0]) && window.getComputedStyle(arrMarkElement[0])["font-size"] ? parseFloat(window.getComputedStyle(arrMarkElement[0])["font-size"]) : 0;
            let arrStaticalValueElement = parentNode.querySelectorAll(".statisticalValue");
            let ValueFondSize = arrStaticalValueElement.length > 0 && window.getComputedStyle(arrStaticalValueElement[0].children[0]) && window.getComputedStyle(arrStaticalValueElement[0].children[0])["font-size"] ? parseFloat(window.getComputedStyle(arrStaticalValueElement[0].children[0])["font-size"]) : 0;
            let backgroundElement = parentNode.querySelectorAll(".backgroundItem");
            let graphicNode = parentNode.querySelectorAll(".graphicconatiner ");
            for (let s1 = 0; s1 < arrStaticalValueElement.length; s1++) {
                if (fontSize < ValueFondSize) arrStaticalValueElement[s1].children[0].style.fontSize = fontSize + "px";
                if (fontSize < markFondSize) arrMarkElement[s1].style.fontSize = fontSize + "px";
                if (backgroundElement.length > s1 && graphicNode.length > s1) {
                    backgroundElement[s1].style.height = graphicNode[s1].clientHeight + "px";
                    backgroundElement[s1].style.top = graphicNode[s1].offsetTop + "px";
                }
            }
        }
    }
};
BaseBarSeriesItem.prototype.getValueBounds = function (props) {
    // return this.ChartHelper.getTextMeasurements(this.data.slideID, this.data.longValue, this.valueMaxW, this.valueMaxH, this.maxValueFontSize[this.arrIndex], this.minValueFontSize[this.arrIndex], "value n1", false, this.parent);
    return { width: 40, height: this.state.height < 35 ? this.state.height : 35 };
};

BaseBarSeriesItem.prototype.statisticallayoutClassName = function (itemname, boolLeft = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.statisticalAlignment.position == "inner") {
        if (boolLeft) {
            if (this.statisticalAlignment.hposition == "left") {
                vLayoutName = "inset" + vLayoutName + "right" + this.statisticalAlignment.vposition;
            } else if (this.statisticalAlignment.hposition == "right") {
                vLayoutName = "inset" + vLayoutName + "left" + this.statisticalAlignment.vposition;
            } else {
                vLayoutName = "inset" + vLayoutName + this.statisticalAlignment.hposition + this.statisticalAlignment.vposition;
            }
        } else {
            vLayoutName = "inset" + vLayoutName + this.statisticalAlignment.hposition + this.statisticalAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.statisticalAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolLeft) {
            if (this.statisticalAlignment.hposition == "left") {
                vLayoutName = vLayoutName + "right" + this.statisticalAlignment.vposition;
            } else if (this.statisticalAlignment.hposition == "right") {
                vLayoutName = vLayoutName + "left" + this.statisticalAlignment.vposition;
            } else {
                vLayoutName = vLayoutName + this.statisticalAlignment.hposition + this.statisticalAlignment.vposition;
            }
        } else {
            vLayoutName = vLayoutName + this.statisticalAlignment.hposition + this.statisticalAlignment.vposition;
        }
    }
    return vLayoutName;
};

let baseLineValueSize = 0;
let intStartX = 0;
let intLastX = 0;
let intCircleRadius = 8;
let minHeight;
let axisTitleSize = 60;
function BaseColumnChart(argParent, argProps) {
    this.widthPercentage = 1;
    this.minSeriesSize = 300;
    this.maxGraphicSize = 1000;
    this.intCircleRadius = 8;
    this.gridvalueSize = 0;
    this.tickMarkSize = 0;
    this.name = "BaseColumnChart";
    this.legendWidth = 0;
    this.ChartFonts = new window["ChartFonts"]();
    this.bollEnableSize = false;
    this.highlightDifferenceHeight = 0;
    this.projectionHeight = 0;
    this.seondaryGridValueSize = 0;
    this.valueHeight = 0;
    this.negativeValueHeight = 0;
    this.seriesItemLabelMaxWidth = 0;
    this.seriesitemLabelLongLabelWidth = 0;
    this.seriesItemLengthValue = 0;
    this.trendlineHeight = 0;
    BaseChart.call(this, argParent, argProps);
}
BaseColumnChart.prototype = Object.create(BaseChart.prototype);
BaseColumnChart.prototype.constructor = BaseColumnChart;

BaseColumnChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BaseColumnSeries"](argParent, argProps);
};

BaseColumnChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.data._showTickMark && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            this.tickMarkSize = 12;
        }
        if (this.data._secondaryLineChart) {
            this.seondaryGridValueSize = this.data.gridValueSize;
        }
        if (this.hadValidateData) {
            this.calculateGridValueSize();
            this.createCagrContainer();
            this.doAddAxisTitle();
            this.doAddGridValues();
            if (!this.data.hasMultiSlide) {
                this.doAddGraphicDesk();
            } else {
                this.doAddMultiSlideGraphicDesk();
            }
            if (this.data._secondaryLineChart) {
                this.updateSecondaryLineChart();
            }
            this.doAddGridDesk();
            if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
                this.doAddBaseLineDesk();
            }

            if (this.data.highlightDifference.display && !this.data.indualHighlight) {
                this.CreateHightlightDifference();
            }
            if (this.data.indualHighlight && (this.seriesItemLengthValue < 2 || this.data._stackedChart)) this.createIndualHighlight();
            if (this.data.indualHighlight && this.seriesItemLengthValue == 2 && !this.data._stackedChart) this.createTwoSeriesIndualHighlight();
            if (this.data._boolTrendline) this.createTrendline();
            this.createTooltipCallout(this.parent, this.data);
            this.doAddMetaData();
            this.rePositionCagrLabel();
            this.adjustProjectionText();
        }
    }
};
BaseColumnChart.prototype.adjustProjectionText = function () {
    let baseColumContainer = this.parent.querySelector(".baseColumnChartContainer");
    let projectionEnableText = this.parent.querySelector(".projectionenabletext");
    let projectionDisableText = this.parent.querySelector(".projectiondisabletext");
    if (projectionEnableText && baseColumContainer) {
        let columnStart = parseInt(projectionEnableText?.style?.left) / this.props.gridsize;
        let columnEnd = parseInt(projectionEnableText?.style?.width) / this.props.gridsize + columnStart;
        let baseColumContainerColumnStart = baseColumContainer.offsetLeft / this.data.gridValueSize;
        columnStart = columnStart + baseColumContainerColumnStart;
        columnEnd = columnEnd + baseColumContainerColumnStart;
        projectionEnableText.style.left = columnStart * this.props.gridsize + "px";
        projectionEnableText.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
    }
    if (projectionDisableText && baseColumContainer) {
        let columnStart = parseInt(projectionDisableText?.style?.left) / this.props.gridsize;
        let columnEnd = parseInt(projectionDisableText?.style?.width) / this.props.gridsize + columnStart;
        let baseColumContainerColumnStart = baseColumContainer.offsetLeft / this.data.gridValueSize;
        columnStart = columnStart + baseColumContainerColumnStart;
        columnEnd = columnEnd + baseColumContainerColumnStart;
        projectionDisableText.style.left = columnStart * this.props.gridsize + "px";
        projectionDisableText.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
    }
};
BaseColumnChart.prototype.calculateGridValueSize = function () {
    let valueElement = document.createElement("div");
    valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName;
    valueElement.style.width = "fit-content";
    valueElement.style.height = "fit-content";
    let gridValue = this.voData.rangeTotal;
    let deciamlCount = gridValue.toString().split(".").length > 1 ? gridValue.toString().split(".")[1].length : 0;
    if (deciamlCount > 2) {
        gridValue = gridValue.toFixed(1);
    }
    valueElement.innerHTML = this.getDenominationValue(Math.round(gridValue));
    if (this.data.data.getAttribute("data-stackpercentage")) {
        valueElement.innerHTML = "100%";
    }
    if (this.data._boolPercentageChart) {
        let rangeTotalValue = this.voData.rangeTotal > 100 ? 100 : this.voData.rangeTotal;
        valueElement.innerHTML = rangeTotalValue + "%";
    }
    this.parent.appendChild(valueElement);
    let gridvalueSize = valueElement.clientWidth + 20;
    if (gridvalueSize > 20) {
        let gridTemValueSize = Math.round(gridvalueSize / this.props.gridsize);
        this.data.gridValueSize = gridTemValueSize * this.props.gridsize;
    }
    this.parent.removeChild(valueElement);
};
BaseColumnChart.prototype.rePositionCagrLabel = function () {
    if (!this.data._enableChartCagr) return;
    let cagrLabel = this.parent.querySelector(".cagr-container");
    let cagrchildcontainer = this.parent.querySelector(".cagrchildcontainer");
    let legendHeight = 0;
    let legend = this.parent.querySelector(".legend");
    if (legend && this.data.legendposition == "right") {
        legendHeight = legend.clientHeight;
    }
    if (legendHeight > 0) cagrLabel.style.top = legendHeight + "px";
    let legendPadding = 0;
    let arrLegendsseries = this.parent?.querySelectorAll(".seriesItemLabelNode");
    if (arrLegendsseries.length < 1 && legendHeight > 0) {
        arrLegendsseries = legend?.querySelectorAll(".legendseries");
        cagrLabel?.classList.add("clsnopadding");
        legendPadding = parseFloat(window.getComputedStyle(arrLegendsseries[0])["padding-bottom"] || 0) + parseFloat(window.getComputedStyle(arrLegendsseries[0])["padding-top"] || 0);
    } else if (arrLegendsseries.length > 0) {
        cagrLabel?.classList.add("clsnopadding");
    } else {
        if (this.data._cagrPosition) {
            cagrLabel.classList.add("cagr-container-position-" + this.data._cagrPosition);
        } else {
            cagrchildcontainer.style.justifyContent = "flex-start";
        }
    }
    if (arrLegendsseries.length < 1) {
        cagrchildcontainer.classList.add("cagr-container-padding");
    }
    let cagrLabelSeries = cagrLabel?.querySelectorAll(".cagrItemLabel");
    let maxWidth = 0;
    if (arrLegendsseries && cagrLabelSeries) {
        for (let i = 0; i < arrLegendsseries.length; i++) {
            let legendSeries = arrLegendsseries[i];
            let legendSeriesHeight = legendSeries.clientHeight - legendPadding;
            let cagrLabelHeight = cagrLabelSeries[i].clientHeight;
            maxWidth = Math.max(maxWidth, legendSeries.clientWidth);
            let legendSeriesTop = legendSeries.offsetTop;
            let cagrLableTop = legendSeriesTop + (legendSeriesHeight - cagrLabelHeight) / 2;
            if (this.parent?.querySelectorAll(".seriesItemLabelNode")?.length > 0 && legendSeriesTop > cagrLableTop) {
                cagrLableTop = legendSeriesTop;
            }
            if (cagrLableTop) {
                cagrLabelSeries[i].style.position = "absolute";
                cagrLabelSeries[i].style.top = cagrLableTop + "px";
            }
        }
    }
};
BaseColumnChart.prototype.getDenominationValue = function (value) {
    let intDivider = 1;
    let strValueDenominationSuffix = "";
    let intLength = value < 0 ? String(value).split(".")[0].length - 1 : String(value).split(".")[0].length;
    if (intLength >= 10) {
        strValueDenominationSuffix = "B";
        intDivider = 1000000000;
    } else if (intLength >= 8) {
        strValueDenominationSuffix = "M";
        intDivider = 1000000;
    } else if (intLength >= 7) {
        strValueDenominationSuffix = "M";
        intDivider = 1000000;
    } else if (intLength >= 6) {
        strValueDenominationSuffix = "L";
        intDivider = 100000;
    } else if (intLength >= 4) {
        strValueDenominationSuffix = "K";
        intDivider = 1000;
    }
    if (this.data.chartName != "waterfallchart" && this.data.chartName != "horWaterfallchart") {
        let gridValue = value / intDivider;
        let deciamlCount = gridValue.toString().split(".").length > 1 ? gridValue.toString().split(".")[1].length : 0;
        if (deciamlCount > 2) {
            gridValue = gridValue.toFixed(1);
        }
        return gridValue + strValueDenominationSuffix;
    } else {
        // let objinputValue = { input: value.toString() };
        // let objValue = this.chartHelper.formatChartValues(objinputValue);
        // return parseInt(objValue.valueSystem)+objValue.currencySystem;
        let boolFloat = this.isFloat(value / intDivider);
        if (boolFloat) {
            return parseFloat(value / intDivider).toFixed(1) + strValueDenominationSuffix;
        } else {
            return parseFloat(value / intDivider) + strValueDenominationSuffix;
        }
    }
};
BaseColumnChart.prototype.isFloat = function (n) {
    return Number(n) === n && n % 1 !== 0;
};
BaseColumnChart.prototype.updateSecondaryLineChart = function () {
    let values = [];
    let columnContainer = this.parent.querySelector(".columnContainer") ? this.parent.querySelector(".columnContainer") : "";
    for (let i = 0; i < this.data.secondaryLineValues?.length; i++) {
        let seriesValues = [];
        seriesValues.push(this.data.secondaryLineValues[i]);
        values.push(seriesValues);
    }
    let objValues = { values: values };
    this.createSecondaryLineChart(columnContainer, objValues);
};
BaseColumnChart.prototype.createSecondaryLineChart = function (argparent, argprops) {
    let customColorIndex = this.ChartFonts.customColor(this.seriesItemLengthValue, true);

    let element = document.createElement("div");
    element.className = "secondaryElement secondarylinechart accent" + customColorIndex + " clsMultiColorParent";
    element.id = "secondarylinechart-" + this.index;
    element.style.left = argparent?.children[0]?.offsetLeft + "px";
    element.classList.add("th-section" + customColorIndex);

    argparent.appendChild(element);

    let eValue = argparent.getElementsByClassName("value");
    let gridMaxValue = argparent.querySelector(".gridmaxValue");
    let gridNegativeValue = argparent.querySelector(".gridnegativemaxValue");
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };
    let valueNode = eValue[0];
    let VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueBounds.height) : 0;
    let negativeValueHeight = 0;
    if (gridMaxValue) {
        VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false ? parseFloat(gridMaxValue.clientHeight) : 0;
    }
    if (this.data.highlightDifference.display) {
        this.highlightDifferenceHeight = VlaueHeight > 0 ? this.data._hdHight1 : this.data._hdHight2;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.indualHighlight) {
        this.highlightDifferenceHeight = VlaueHeight > 0 ? this.data._hdHight1 : this.data._hdHight2;
        VlaueHeight += this.highlightDifferenceHeight;
    }
    if (this.data.totalValueBounds?.height) {
        VlaueHeight += this.data.totalValueBounds?.height;
    }
    if (this.data.extraElementBounds?.height) {
        VlaueHeight += this.data.extraElementBounds?.height;
    }
    VlaueHeight += parseFloat(this.data.secondaryLineValueMaxHeight || 0);

    if (gridNegativeValue) {
        negativeValueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(gridNegativeValue.clientHeight) : 0;
    }

    let seriesItemContent = argparent?.querySelectorAll(".seriesitemcond");
    let seriesItemValueElement = document.createElement("div");
    seriesItemValueElement.className = "seriesitemvalue accent2 clsMultiColorParent";
    seriesItemValueElement.style.width = "100%";
    seriesItemValueElement.style.height = "100%";
    seriesItemValueElement.style.position = "absolute";
    seriesItemValueElement.style.top = "0";
    seriesItemValueElement.style.left = "0";
    element.appendChild(seriesItemValueElement);
    let secondaryLineChart = this.data.SVGUtils.createSVGElement("svg");
    secondaryLineChart.id = "secondarylinechart-" + this.groupindex;
    secondaryLineChart.className = "secondarylinechart";
    secondaryLineChart.style.width = "100%";
    secondaryLineChart.style.height = "100%";
    element.appendChild(secondaryLineChart);
    let arrSeondaryValues = argprops.values;
    element.style.height = seriesItemContent[0]?.clientHeight + "px";
    let containerHeight = seriesItemContent[0]?.clientHeight || 0;
    let containerWidth = argparent?.children[0]?.clientWidth || 0;
    let intCircleRadius = 0;
    let minHeight = 0;
    let Points = [];
    let indeualColumnWidth = containerWidth / arrSeondaryValues.length;
    let maxRangeValue = Math.max(...arrSeondaryValues.map((item) => Number(item[0])));
    this.data.secondaryLineMaxValue = maxRangeValue;
    let minRangeValue = Math.min(...arrSeondaryValues.map((item) => Number(item[0])));
    this.data.secondaryLineMinValue = minRangeValue;
    let arrSeriesElements = argparent.querySelectorAll(".series");
    for (let c1 = 0; c1 < arrSeondaryValues[0].length; c1++) {
        Points[c1] = [];
        for (let c2 = 0; c2 < arrSeondaryValues.length; c2++) {
            let secondaryValue = arrSeondaryValues[c2][c1];
            let seriesItem = seriesItemContent[c2].querySelectorAll(".seriesitem");
            let seriesItemHeight = 0;
            let positiveSideHeight = seriesItem[0]?.clientHeight || 0;
            let negativeSideHeight = seriesItem[1]?.clientHeight || 0;
            if (this.data.stackedChart) {
                positiveSideHeight = seriesItemContent[c2]?.clientHeight || 0;
                negativeSideHeight = seriesItemContent[c2]?.clientHeight || 0;
            }
            if (secondaryValue < 0) {
                seriesItemHeight = negativeSideHeight;
                if (seriesItemHeight > 0) containerHeight = seriesItemHeight;
                containerHeight -= negativeValueHeight;
                maxRangeValue = Math.min(...arrSeondaryValues.map((item) => Number(item[0])));
                negativeSideHeight = 0;
            } else {
                seriesItemHeight = positiveSideHeight;
                if (seriesItemHeight > 0) containerHeight = seriesItemHeight;
                containerHeight -= VlaueHeight;
                maxRangeValue = Math.max(...arrSeondaryValues.map((item) => Number(item[0])));
                positiveSideHeight = 0;
            }
            let numMultiplyFactor = (containerHeight - (minHeight + intCircleRadius)) / maxRangeValue;
            let intY = positiveSideHeight + VlaueHeight + (containerHeight - secondaryValue * numMultiplyFactor);
            if (this.data.chartFlip) {
                intY = secondaryValue * numMultiplyFactor;
            }
            if (secondaryValue < 0) {
                intY = positiveSideHeight + secondaryValue * numMultiplyFactor;
                if (this.data.chartFlip) {
                    intY = positiveSideHeight + VlaueHeight + (containerHeight - secondaryValue * numMultiplyFactor);
                }
            }
            // let intX = indeualColumnWidth / 2 + c2 * indeualColumnWidth;
            let intX = arrSeriesElements[c2].offsetLeft + arrSeriesElements[c2].offsetWidth / 2;
            let point = { x: intX, y: intY };
            Points[c1].push(point);
        }
        let path = this.data.SVGUtils.createSVGElement("path");
        let pathData = "";
        secondaryLineChart.appendChild(path);
        if (this.data._secondaryLineChartSpline) {
            pathData = this.generateSplinePath(Points[c1], secondaryLineChart, path, c1);
            path.setAttribute("d", pathData);
        } else {
            pathData = `M ${Points[c1][0].x} ${Points[c1][0].y}`;
            path.setAttribute("d", pathData);
            let linePathLength = path.getTotalLength();
            for (let c2 = 1; c2 < Points[c1].length; c2++) {
                if (c2 == 1) {
                    this.createPointShape(Points[c1][0].x, Points[c1][0].y, secondaryLineChart, c1, 0, secondaryLineChart, linePathLength, linePathLength);
                }
                pathData += ` L ${Points[c1][c2].x} ${Points[c1][c2].y}`;
                path.setAttribute("d", pathData);
                linePathLength = path.getTotalLength();
                this.createPointShape(Points[c1][c2].x, Points[c1][c2].y, secondaryLineChart, c1, c2, secondaryLineChart, linePathLength, linePathLength);
            }
        }
        let colorData = this.data.layout.itemColor == "gradient" ? this.data.layout.lineColor : this.data.layout.itemColor;
        let strokeColor = this.getBgFillDetails(this.seriesItemLengthValue - 1, "cf-stroke-section-primary", colorData, "stroke");
        path.setAttribute("class", "secondarylinechartpath item-path " + strokeColor + " moodanimation " + this.data.layout.lineShadow);
        path.setAttribute("data-animation", "itemline");
        path.setAttribute("fill", "none");
        if (this.data._secondaryLineChartValue) this.createSecondaryLineChartValue(seriesItemValueElement, argprops, Points[c1], valueNode);
        this.updateSecondaryLineLegendShapePropeties(secondaryLineChart);
    }
};
BaseColumnChart.prototype.updateSecondaryLineLegendShapePropeties = function (secondaryLineChart) {
    let secondaryLineLegendShape = this.parent.querySelector(".secondarylinelegendshape");
    let lineElement = this.parent.querySelector(".secondarylinelegendpath");
    let secondaryLinePath = secondaryLineChart?.querySelector(".secondarylinechartpath");
    if (lineElement) lineElement.setAttribute("class", secondaryLinePath.getAttribute("class"));
    if (lineElement) lineElement.classList.remove("moodanimation");
    let lineShapeElement = secondaryLineChart?.querySelector(".item-circle")?.cloneNode(true);
    let legendParentNode = secondaryLineLegendShape?.parentElement;
    if (lineShapeElement && legendParentNode) {
        legendParentNode.appendChild(lineShapeElement);
        lineShapeElement.classList.remove("moodanimation");
    }
    if (secondaryLineLegendShape) {
        secondaryLineLegendShape.parentElement.removeChild(secondaryLineLegendShape);
    }
    let shapeX = secondaryLineLegendShape?.dataset.x;
    let shapeY = secondaryLineLegendShape?.dataset.y;
    let shapeElementBounds = { width: lineShapeElement?.clientWidth, height: lineShapeElement?.clientHeight };
    if (lineShapeElement?.tagName == "circle" || lineShapeElement?.tagName == "rect") {
        shapeElementBounds = lineShapeElement?.getBoundingClientRect();
    }
    if (lineShapeElement?.tagName == "circle") {
        lineShapeElement.setAttribute("cx", shapeX);
        lineShapeElement.setAttribute("cy", shapeY);
    } else if (lineShapeElement?.tagName == "rect") {
        lineShapeElement.setAttribute("x", shapeX - shapeElementBounds.width / 2);
        lineShapeElement.setAttribute("y", shapeY - shapeElementBounds.height / 2);
    } else if (lineShapeElement) {
        lineShapeElement.setAttribute("transform", "translate(" + shapeX + "," + shapeY + ")");
    }
};
BaseColumnChart.prototype.createPointShape = function (intX, intY, svgElement, seriesIndex, seriesItemIndex, svgSeiesItem, pathLength, linePathLength) {
    let svgPointShape;
    let dummeyShape;
    let ShapeWidth = 2 * this.intCircleRadius;
    let ShapeHeight = 2 * this.intCircleRadius;
    let shapeX = intX - this.intCircleRadius;
    let shapeY = intY - this.intCircleRadius;
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let strShapePath = "";
    if (this.pointshape == "rect") {
        ShapeWidth = 2 * this.intCircleRadius + 4;
    }
    let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
    emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
    emptySvgNode.appendChild(dummeyLineShape);
    svgElement.appendChild(emptySvgNode);
    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
    if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
        dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-enabled");
    }
    if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
        dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-disabled");
    }
    let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
    svgElement.removeChild(emptySvgNode);
    if (this.data.layout.itemShapeWidth) {
        ShapeWidth = this.data.layout.itemShapeWidth;
    }
    if (this.data.layout.itemShapeHeight) {
        ShapeHeight = this.data.layout.itemShapeHeight;
    }
    if (getShapeBounds) {
        ShapeWidth = getShapeBounds.width ? getShapeBounds.width : ShapeWidth;
        ShapeHeight = getShapeBounds.height ? getShapeBounds.height : ShapeHeight;
    }
    if (this.pointshape == "rect" || this.pointshape == "square") {
        shapeY = intY - ShapeHeight / 2;
        shapeX = intX - ShapeWidth / 2;
        ShapeWidth = ShapeWidth;
        ShapeHeight = ShapeHeight;
    }
    if (this.pointshape == "rhombus") {
        x1 = intX;
        y1 = intY - ShapeHeight / 2;
        x2 = intX - ShapeWidth / 2;
        y2 = intY;
        x3 = intX;
        y3 = intY + ShapeHeight / 2;
        x4 = intX + ShapeHeight / 2;
        y4 = intY;
        strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
    }

    if (this.pointshape == "rect" || this.pointshape == "square") {
        svgPointShape = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(svgPointShape, {
            x: shapeX,
            y: shapeY,
            width: ShapeWidth,
            height: ShapeHeight,
            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
            "data-cxvalues": intX,
            "data-animation": "itemcircle",
            "data-animateitem": "itemcircle" + seriesItemIndex,
            "data-pathLength": pathLength,
            "data-linepathlength": linePathLength,
            visibility: "visible",
        });

        dummeyShape = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(dummeyShape, {
            x: shapeX,
            y: shapeY,
            width: ShapeWidth,
            height: ShapeHeight,
            visibility: "hidden",
        });
        if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
        svgSeiesItem.appendChild(svgPointShape);
    } else {
        if (this.pointshape == "rhombus") {
            svgPointShape = this.data.SVGUtils.createSVGElement("path");

            this.data.SVGUtils.assignAttributes(svgPointShape, {
                d: strShapePath,
                class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                "data-cxvalues": intX,
                "data-animation": "itemcircle",
                "data-animateitem": "itemcircle" + seriesItemIndex,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                visibility: this.pointshape == "rhombus" ? "visible" : "hidden",
                visibility: "visible",
            });
            svgSeiesItem.appendChild(svgPointShape);
        } else {
            svgPointShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(svgPointShape, {
                cx: intX,
                cy: intY,
                r: ShapeWidth / 2,
                class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                "data-cxvalues": intX,
                "data-animation": "itemcircle",
                "data-animateitem": "itemcircle" + seriesItemIndex,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                visibility: this.pointshape == "circle" ? "visible" : "hidden",
                visibility: "visible",
            });
            dummeyShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(dummeyShape, {
                cx: intX,
                cy: intY,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                r: ShapeWidth / 2,
                visibility: "hidden",
            });
            if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
            svgSeiesItem.appendChild(svgPointShape);
        }
    }
    if (this.data.hasProjection) {
        if (this.data.projection[seriesIndex] == true) {
            svgPointShape.classList.add("clsprojectionenableshape");
        } else {
            svgPointShape.classList.add("clsprojectiondisableshape");
        }
    }
    this.itemShapebgProperties(svgPointShape, seriesItemIndex, seriesIndex, dummeyShape);
};

BaseColumnChart.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex, dummeyShape) {
    if (this.data.layout.linechartShapeStyle == "border") {
        let borderSize = this.data.layout.linechartShapeBorderSize ? this.data.layout.linechartShapeBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.linechartShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsTertiaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
                dummeyShape.classList.add(this.data.ChartFonts.appendgraphicColor(seriesIndex));
            }
        } else {
            if (this.data.layout.linechartShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    // element.classList.add("clsTertiaryStroke");
                    // if(dummeyShape)dummeyShape.classList.add("clsSecondaryFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "contrast") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    element.classList.add("contrast-stroke");
                    if (dummeyShape) dummeyShape.classList.add("clsContrastFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("bgfill");
                    element.classList.add("bgstroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "alternateprimary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("alterbgcolor");
                    element.classList.add("alter-background-stroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    this.addGradient(element, element, element.parentNode, false, true, false, seriesIndex);
                }
            } else {
                // element.classList.add("clsTertiaryStroke");
            }
        }
    }
    if (this.data.layout.linechartShapeBgColor) {
        if (this.data.layout.linechartShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsSecondaryFill");
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.linechartShapeBgColor == "secondary") {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    // element.classList.add("clsSecondaryFill");
                }
            } else {
                if (this.data.layout.linechartShapeBgColor == "contrast") {
                    if (this.data.layout.linechartShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                    } else {
                        element.classList.add("contrast-fill");
                    }
                } else if (this.data.layout.linechartShapeBgColor == "alternateprimary") {
                    if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                        // element.classList.add("clsTertiaryStroke");
                    } else {
                        element.classList.remove("cf-fill-section-primary");
                        element.classList.remove("bgfill");
                        element.classList.add("alterbgcolor");
                    }
                } else {
                    if (this.data.layout.linechartShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true, false, seriesIndex);
                    } else if (this.data.layout.linechartShapeBgColor == "bgcolor") {
                        if (this.data.layout.linechartShapebgOpacity) {
                            element.classList.remove("cf-fill-section-primary");
                            element.classList.add("bgfill");
                            element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                        } else {
                            element.classList.add("contrast-fill");
                        }
                    }
                }
            }
        }
    }
    if (this.data.layout.itemShapeShadow) {
        element.classList.add(this.data.layout.itemShapeShadow);
    }
};

BaseColumnChart.prototype.getLineShapeBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    if ((width || width < 1) && (height || height < 1)) {
        return { width: width, height: height };
    } else {
        return null;
    }
};

BaseColumnChart.prototype.createSecondaryLineChartValue = function (argparent, argprops, Points, valueNode) {
    let index = this.seriesItemLengthValue;
    for (let i = 0; i < argprops?.values?.length; i++) {
        let themeClassName = this.ChartFonts.valueThemeClassName;
        let promptTextThemeClass = this.ChartFonts.promptTextClassName;
        if (this.data.promptText) {
            themeClassName = promptTextThemeClass;
        }
        let maxHeight = this.data.secondaryLineValueMaxHeight - this.intCircleRadius;
        if (valueNode.clientHeight > maxHeight) {
            maxHeight = valueNode.clientHeight;
        }
        let element = document.createElement("div");
        element.className = "seriesitemvalue  clsValueTextColor valuetext  clsValueTextColor secondarylinecalcvalue " + themeClassName + " " + valueNode?.dataset?.alignment;
        element.style.width = "auto";
        element.setAttribute("id", "value-text-" + i + "_" + index);
        element.setAttribute("data-index", i + "_" + index);
        element.style.setProperty("max-width", valueNode.clientWidth + "px", "important");
        element.style.setProperty("max-height", maxHeight + "px", "important");
        element.style.overflow = "hidden";
        element.setAttribute("data-id", i + "_" + index);
        element.style.height = "auto";
        element.style.position = "absolute";
        argparent.appendChild(element);
        let SubElement = document.createElement("div");
        SubElement.className = "seriesitemvaluetext moodanimation";
        SubElement.setAttribute("id", "valuetext-" + i + "_" + index);
        SubElement.setAttribute("data-animation", !this.data.promptText ? "secondarytext" + index : "prompttext");
        SubElement.setAttribute("data-animateitem", !this.data.promptText ? "secondarytext" + (index - 1) : "prompttext");
        SubElement.setAttribute("data-stackedmultiseries", "true");
        SubElement.setAttribute("data-id", i + "_" + index);
        SubElement.setAttribute("data-dck-selector", "true");
        SubElement.setAttribute("data-oldinnertext", argprops?.values?.[i]?.[0]);
        SubElement.setAttribute("data-type", "value");
        SubElement.setAttribute("data-prompt-text", "10-15");
        SubElement.setAttribute("data-index", i + "_" + index);
        SubElement.setAttribute("contenteditable", "true");
        SubElement.style.visibility = this.data._valueDisplayFormat[i + " " + index];
        SubElement.style.width = "auto";
        SubElement.style.height = "auto";
        SubElement.style.top = "0";
        SubElement.style.left = "0";
        SubElement.style.overflow = "hidden";
        SubElement.style.fontSize = this.data.secondaryLineValueMaxFontSize || window.getComputedStyle(valueNode?.children[0] || element)["font-size"];
        SubElement.innerHTML = argprops?.values?.[i]?.[0];
        element.appendChild(SubElement);
        if (this.data.promptText) {
            SubElement.innerHTML = this.data.promptTextValue[i][index];
            SubElement.setAttribute("contenteditable", "true");
            SubElement.setAttribute("data-prompt-text", "10-15");
            SubElement.setAttribute("data-type", "promt");
            element.setAttribute("data-type", "promt");
        }
        this.ChartHelper.setTextChangeListner(SubElement);
        if (!this.data.promptText) this.ChartUtils.createSpanFormat(SubElement, this.data);
        element.style.top = Points[i].y - element.clientHeight - this.intCircleRadius + "px";
        element.style.left = Points[i].x - element.clientWidth / 2 + "px";
        if (this.data.chartFlip) {
            element.style.top = Points[i].y + this.intCircleRadius + "px";
        }
    }
};
BaseColumnChart.prototype.generateSplinePath = function (points, secondaryLineChart, pathParent, index) {
    if (points.length < 2) return "";

    const controlPoints = this.getControlPoints(points);
    let path = `M ${points[0].x} ${points[0].y}`;

    for (let i = 1; i < points.length; i++) {
        if (i == 1) {
            pathParent.setAttribute("d", path);
            let linePathLength = pathParent.getTotalLength();
            this.createPointShape(points[i - 1].x, points[i - 1].y, secondaryLineChart, i, index, secondaryLineChart, linePathLength, linePathLength);
        }
        const cp1 = controlPoints[i - 1][1];
        const cp2 = controlPoints[i][0];
        const p = points[i];
        path += ` C ${cp1.x} ${cp1.y}, ${cp2.x} ${cp2.y}, ${p.x} ${p.y}`;
        linePathLength = pathParent.getTotalLength();
        this.createPointShape(points[i].x, points[i].y, secondaryLineChart, i, index, secondaryLineChart, linePathLength, linePathLength);
    }

    return path;
};

BaseColumnChart.prototype.getControlPoints = function (points, tension = 0.2) {
    const controlPoints = [];

    for (let i = 0; i < points.length; i++) {
        const prev = points[i - 1] || points[0];
        const curr = points[i];
        const next = points[i + 1] || points[points.length - 1];

        // Calculate control points
        const dx = next.x - prev.x;
        const dy = next.y - prev.y;

        const c1 = {
            x: curr.x - dx * tension,
            y: curr.y - dy * tension,
        };

        const c2 = {
            x: curr.x + dx * tension,
            y: curr.y + dy * tension,
        };

        controlPoints.push([c1, c2]);
    }

    return controlPoints;
};
BaseColumnChart.prototype.createTwoSeriesIndualHighlight = function () {
    let element = document.createElement("div");
    element.className = "indualhighlightbasenode accent1 clsMultiColorParent";
    let ParentNode = this.parent.querySelector(".baseseries");
    let columnContainer = this.parent.querySelector(".columnContainer") ? this.parent.querySelector(".columnContainer").children[0] : 0;
    let leftValue = this.parent.querySelector(".columnContainer") ? this.parent.querySelector(".columnContainer")?.parentNode?.offsetLeft + this.parent.querySelector(".columnContainer").offsetLeft + this.parent.querySelector(".columnContainer").children[0].offsetLeft : 0;
    let arrSeries = this.parent.querySelector(".columnContainer")?.querySelectorAll(".series");
    let seriesNode = arrSeries?.[0];
    if (this.data._directionenable) {
        seriesNode = arrSeries?.[arrSeries.length - 1];
    }
    let seriesValue = seriesNode?.offsetLeft || 0;
    let childValue = seriesNode?.querySelector(".seriesitemcond")?.offsetLeft || 0;
    leftValue += seriesValue + childValue;
    element.style.width = columnContainer.clientWidth + "px";
    ParentNode.appendChild(element);
    element.style.left = leftValue + "px";
    for (let i1 = 0; i1 < this.data.seriesLength; i1++) {
        let FirstPoint = i1;
        let secondPoint = i1;
        let firstPointValue = this.data.values[FirstPoint][0];
        let secondPointValue = this.data.values[secondPoint][1];
        let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
        this.createtwoseriesHighlightNode(element, FirstPoint, secondPoint, firstValueHigh, i1, this.data.seriesLength);
    }
};
BaseColumnChart.prototype.createIndualHighlight = function () {
    let element = document.createElement("div");
    element.className = "indualhighlightbasenode accent1 clsMultiColorParent";
    let ParentNode = this.parent.querySelector(".baseseries");
    let columnContainer = this.parent.querySelector(".columnContainer") ? this.parent.querySelector(".columnContainer").children[0] : 0;
    let leftValue = this.parent.querySelector(".columnContainer") ? this.parent.querySelector(".columnContainer")?.parentNode?.offsetLeft + this.parent.querySelector(".columnContainer").offsetLeft + this.parent.querySelector(".columnContainer").children[0].offsetLeft : 0;
    let graphicNode = ParentNode.querySelector(".seriesitemcond");
    let legendHeight = 0;
    if (this.parent.querySelector(".legend") && this.data.legendposition == "top") {
        legendHeight = this.parent.querySelector(".legend") ? this.parent.querySelector(".legend").clientHeight : 0;
    }
    element.style.width = columnContainer.clientWidth + "px";
    ParentNode.appendChild(element);
    element.style.left = leftValue + "px";
    if (this.data.chartFlip) element.style.top = graphicNode.offsetTop - 20 + "px";
    else if (legendHeight > 0) element.style.top = legendHeight + "px";
    for (let i1 = 0; i1 < this.data.seriesLength - 1; i1++) {
        let FirstPoint = i1;
        let secondPoint = i1 + 1;
        let firstPointValue = this.data.values[FirstPoint][0];
        let secondPointValue = this.data.values[secondPoint][0];
        if (this.data._stackedChart) {
            firstPointValue = this.data.arrSeriesItemValueTotal[FirstPoint];
            secondPointValue = this.data.arrSeriesItemValueTotal[secondPoint];
        }
        let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
        this.createHighlightNode(element, FirstPoint, secondPoint, firstValueHigh, i1, this.data.seriesLength);
    }
};
BaseColumnChart.prototype.createtwoseriesHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let arrseries = this.parent.querySelectorAll(".series");
    let seriesItemElement = arrseries[index] ? arrseries[index].querySelectorAll(".baseseriesitem") : [];
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][1], index);
    if (this.data.stackedChart) {
        differenceValue = this.createHdDisplayFormat(this.data.arrSeriesItemValueTotal[FirstPoint], this.data.arrSeriesItemValueTotal[secondPoint], index);
    }
    let firstSeriesItem = seriesItemElement.length > 0 ? seriesItemElement[0] : "";
    let secondSeriesItem = seriesItemElement.length > 1 ? seriesItemElement[1] : "";
    let hasfirstValueHigh = parseFloat(this.data.values[FirstPoint][0]) > parseFloat(this.data.values[secondPoint][1]);
    if (this.data.stackedChart) {
        hasfirstValueHigh = parseFloat(this.data.arrSeriesItemValueTotal[FirstPoint]) > parseFloat(this.data.arrSeriesItemValueTotal[secondPoint]);
    }
    let drawDatas = this.getDrawDatas(firstSeriesItem, secondSeriesItem, arrseries[index], hasfirstValueHigh);
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + drawDatas.x1 + "," + drawDatas.y1 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x4 + "," + drawDatas.y4;
    let secondaryPath = "M" + drawDatas.x4 + "," + drawDatas.y4 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x1 + "," + drawDatas.y1;
    if (this.data.HighlightArrowState == "start") {
        strPath = "M" + drawDatas.x4 + "," + drawDatas.y4 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x1 + "," + drawDatas.y1;
    }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "secondary-stroke  moodanimation cs-highlight-difference-line",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode);
    arrowHead.style.offsetPath = "path('" + strPath + "')";
    arrowHead.style.offsetDistance = "100%";
    arrowHead.classList.add("moodanimation");
    arrowHead.dataset.animation = "indualhdarrowhead";
    if (this.data.HighlightArrowState == "both") {
        let arrowHead1 = this.createArrowHeader(svgNode);
        arrowHead1.style.offsetPath = "path('" + secondaryPath + "')";
        arrowHead1.style.offsetDistance = "100%";
        arrowHead1.classList.add("moodanimation");
        arrowHead1.dataset.animation = "indualhdarrowheadend";
    }
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");
        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    let paddingLeft = window.getComputedStyle(callout) && window.getComputedStyle(callout)["padding-left"] ? parseInt(window.getComputedStyle(callout)["padding-left"]) : 0;
    let paddingRight = window.getComputedStyle(callout) && window.getComputedStyle(callout)["padding-right"] ? parseInt(window.getComputedStyle(callout)["padding-right"]) : 0;
    let paddingValue = paddingLeft + paddingRight;
    let childWidth = callout.children[0].clientWidth;
    let calloutWidth = 0;
    let calloutHeight = 0;
    let maxWidth = 0;
    if (drawDatas.drawType == "type2") {
        maxWidth = drawDatas.calloutMaxWidth;
        callout.style.maxWidth = maxWidth + "px";
        callout.style.maxHeight = "60px";
        calloutWidth = callout.clientWidth;
        calloutHeight = callout.clientHeight;
        callout.style.top = drawDatas.y4 + (drawDatas.y1 - drawDatas.y4 - calloutHeight) / 2 + "px";
        callout.style.left = drawDatas.x3 - calloutWidth / 2 + "px";
    } else {
        maxWidth = (drawDatas.x3 - drawDatas.x2) * 0.8;
        callout.style.maxWidth = (drawDatas.x3 - drawDatas.x2) * 0.8 + "px";
    }
    this.ChartHelper.adjustFontSize(callout.children[0], 10, 12, this.ChartFonts.maxLabelFontSize(callout));
    this.ChartHelper.adjustFontSizeWidth(callout.children[0], 10, 12, this.ChartFonts.maxLabelFontSize(callout));
    if (drawDatas.drawType == "type1") {
        childWidth = callout.children[0].clientWidth;
        let orginalwidth = maxWidth - paddingValue;
        callout.style.maxWidth = orginalwidth < childWidth ? (drawDatas.x3 - drawDatas.x2) * 1 + "px" : (drawDatas.x3 - drawDatas.x2) * 0.8 + "px";
        calloutWidth = callout.clientWidth;
        calloutHeight = callout.clientHeight;
        callout.style.top = drawDatas.y2 - calloutHeight / 2 + "px";
        callout.style.left = drawDatas.x3 > drawDatas.x2 ? drawDatas.x2 + (drawDatas.x3 - drawDatas.x2 - calloutWidth) / 2 + "px" : drawDatas.x2 + (drawDatas.x2 - drawDatas.x3 - calloutWidth) / 2 + "px";
    }
};
BaseColumnChart.prototype.getDrawDatas = function (firstSeriesItem, secondSeriesItem, series, firstValueHigh) {
    let firstGraphicNode = firstSeriesItem.querySelector(".graphicconatiner");
    let firstValueNode = firstSeriesItem.querySelector(".value");
    let FirstValueHeight = 0;
    let firstGraphicHeight = 0;
    let elementGap = 7;
    if (((this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top") || this.data.stackedChart) && firstValueNode && firstValueNode.style.display != "none") {
        FirstValueHeight = firstValueNode.clientHeight;
    }
    if (firstGraphicNode) firstGraphicHeight = firstGraphicNode.clientHeight;
    let firstTotalHeight = firstGraphicHeight + FirstValueHeight;

    let secondGraphicNode = secondSeriesItem.querySelector(".graphicconatiner");
    let secondValueNode = secondSeriesItem.querySelector(".value");
    let SecondValueHeight = 0;
    let secondGraphicHeight = 0;
    if (((this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top") || this.data.stackedChart) && secondValueNode && secondValueNode.style.display != "none") {
        SecondValueHeight = secondValueNode.clientHeight;
    }
    if (secondGraphicNode) secondGraphicHeight = secondGraphicNode.clientHeight;
    let SecondTotalHeight = secondGraphicHeight + SecondValueHeight;
    let DifferenceHeight = SecondTotalHeight > firstTotalHeight ? SecondTotalHeight - firstTotalHeight - SecondValueHeight - 5 : firstTotalHeight - SecondTotalHeight - SecondValueHeight - 5;
    let lowValue = SecondTotalHeight < firstTotalHeight ? SecondTotalHeight : firstTotalHeight;
    let type = DifferenceHeight < this.data._hdHight2 ? "type1" : "type2";
    if (type == "type2") {
        let startValue = secondSeriesItem.offsetTop + (secondSeriesItem.clientHeight - lowValue);
        let CurrentNode = firstTotalHeight > SecondTotalHeight ? secondSeriesItem : firstSeriesItem;
        let x1 = series.offsetLeft + CurrentNode.offsetLeft + firstGraphicNode.offsetLeft + firstGraphicNode.clientWidth / 2;
        let y1 = startValue - elementGap;
        let x2 = x1;
        let y2 = startValue - DifferenceHeight / 2;
        let x3 = x1;
        let y3 = startValue - DifferenceHeight;
        let x4 = x1;
        let y4 = startValue - DifferenceHeight;
        return { drawType: type, x1: x1, y1: y1, x2: x2, y2: y2, x3: x3, y3: y3, x4: x4, y4: y4, calloutMaxWidth: firstSeriesItem.clientWidth };
    } else {
        let FirstPoint = 0;
        let secondPoint = 1;
        let grahicNodes = series.querySelectorAll(".chartgraphic");
        let valuNode = series.querySelectorAll(".value");
        let seriesElement = this.parent.querySelectorAll(".series");

        let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint].parentNode : "";
        let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint].parentNode : "";
        let firstSeries = firstSeriesItem;
        let secondSeries = secondSeriesItem;
        let hasValue = false;
        let firstTopGap = 0;
        let secondTopGap = 0;
        let firstargChildNodeTop = 0;
        let secondChildNodeTop = 0;
        if (((this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top") || this.data.stackedChart) && valuNode.length > 0 && valuNode[0].style.display != "none") {
            firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
            secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
            hasValue = true;
            firstTopGap = this.data._hdHight1;
            secondTopGap = this.data._hdHight1;
        } else {
            if (this.data.layout.valueInset == "inside") {
                if (valuNode.length > FirstPoint && valuNode[FirstPoint] && valuNode[FirstPoint].dataset.outerside == "true") {
                    firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
                    firstTopGap = this.data._hdHight1;
                } else {
                    firstargChildNodeTop = grahicNodes[FirstPoint].offsetTop;
                }
                if (valuNode.length > secondPoint && valuNode[secondPoint].dataset.outerside == "true") {
                    secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
                    secondTopGap = this.data._hdHight1;
                } else {
                    secondChildNodeTop = grahicNodes[secondPoint].offsetTop;
                }
            }
        }
        let X1 = 0;
        let Y1 = 0;
        let X2 = 0;
        let Y2 = 0;
        let X3 = 0;
        let Y3 = 0;
        let X4 = 0;
        let Y4 = 0;
        let fisrtNodeLeft = series.offsetLeft + firstSeries.offsetLeft + firstargParentNode.offsetLeft;
        let fisrtNodeRight = firstargParentNode.offsetRight;
        let fisrtNodeWidth = firstargParentNode.clientWidth;
        let fisrtNodeTop = firstargParentNode.offsetTop + firstTopGap + firstargChildNodeTop;
        let fisrtNodeHeight = firstargParentNode.clientHeight;
        let secondNodeLeft = series.offsetLeft + secondSeries.offsetLeft + secondtargParentNode.offsetLeft;
        let secondNodeRight = secondtargParentNode.offsetRight;
        let secondNodeWidth = secondtargParentNode.clientWidth;
        let secondNodeTop = secondtargParentNode.offsetTop + secondTopGap + secondChildNodeTop;
        let secondNodeHeight = secondtargParentNode.clientHeight;
        let topspace = 20;

        if (firstValueHigh && firstargParentNode && secondtargParentNode) {
            X1 = fisrtNodeLeft + fisrtNodeWidth / 2;
            Y1 = fisrtNodeTop - elementGap;
            X2 = fisrtNodeLeft + fisrtNodeWidth / 2;
            Y2 = fisrtNodeTop - topspace;
            X3 = secondNodeLeft + secondNodeWidth / 2;
            Y3 = fisrtNodeTop - topspace;
            X4 = secondNodeLeft + secondNodeWidth / 2;
            Y4 = secondNodeTop - elementGap;
        }
        if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
            X1 = fisrtNodeLeft + fisrtNodeWidth / 2;
            Y1 = fisrtNodeTop - elementGap;
            X2 = fisrtNodeLeft + fisrtNodeWidth / 2;
            Y2 = secondNodeTop - topspace;
            X3 = secondNodeLeft + secondNodeWidth / 2;
            Y3 = secondNodeTop - topspace;
            X4 = secondNodeLeft + secondNodeWidth / 2;
            Y4 = secondNodeTop - elementGap;
        }
        Y1 = Y1 < 0 ? -Y1 : Y1;
        Y2 = Y2 < 0 ? 0 : Y2;
        Y3 = Y3 < 0 ? 0 : Y3;
        Y4 = Y4 < 0 ? -Y4 : Y4;
        return { drawType: type, x1: X1, y1: Y1, x2: X2, y2: Y2, x3: X3, y3: Y3, x4: X4, y4: Y4 };
    }
};

BaseColumnChart.prototype.createHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let grahicNodes = this.parent.querySelectorAll(".chartgraphic");
    let valuNode = this.parent.querySelectorAll(".value");
    let seriesElement = this.parent.querySelectorAll(".series");
    if (this.data._stackedChart) {
        grahicNodes = this.parent.querySelectorAll(".substackitemcond");
        valuNode = this.parent.querySelectorAll(".totalValue");
    }
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][0], index);
    if (this.data.stackedChart) {
        differenceValue = this.createHdDisplayFormat(this.data.arrSeriesItemValueTotal[FirstPoint], this.data.arrSeriesItemValueTotal[secondPoint], index);
    }
    let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint].parentNode : "";
    let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint].parentNode : "";
    let firstSeries = seriesElement.length > FirstPoint ? seriesElement[FirstPoint] : "";
    let secondSeries = seriesElement.length > secondPoint ? seriesElement[secondPoint] : "";
    let hasValue = false;
    let firstTopGap = 0;
    let secondTopGap = 0;
    let firstargChildNodeTop = 0;
    let secondChildNodeTop = 0;
    let elementGap = 7;
    if (((this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top") || this.data.stackedChart) && valuNode.length > 0 && valuNode[0].style.display != "none" && valuNode[0].children[0].style.visibility != "hidden") {
        firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
        secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
        hasValue = true;
        // firstTopGap = 30;
        // secondTopGap = 30;
    } else {
        if (this.data.layout.valueInset == "inside" || valuNode[0].style.display == "none" || valuNode[0].children[0].style.visibility == "hidden") {
            if (valuNode.length > FirstPoint && valuNode[FirstPoint] && valuNode[FirstPoint].dataset.outerside == "true") {
                firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
                // firstTopGap = 30;
            } else {
                firstargChildNodeTop = grahicNodes[FirstPoint].offsetTop;
            }
            if (valuNode.length > secondPoint && valuNode[secondPoint].dataset.outerside == "true") {
                secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
                // secondTopGap = 30;
            } else {
                secondChildNodeTop = grahicNodes[secondPoint].offsetTop;
            }
            // if (this.data.layout.valueInset != "inside" && valuNode[0].children[0].style.visibility == "hidden") {
            //     firstTopGap = 30;
            //     secondTopGap = 30;
            // }
        }
    }
    let X1 = 0;
    let Y1 = 0;
    let X2 = 0;
    let Y2 = 0;
    let X3 = 0;
    let Y3 = 0;
    let X4 = 0;
    let Y4 = 0;
    let fisrtNodeLeft = firstSeries.offsetLeft + firstargParentNode.offsetLeft;
    let fisrtNodeRight = firstargParentNode.offsetRight;
    let fisrtNodeWidth = firstargParentNode.clientWidth;
    let fisrtNodeTop = firstargParentNode.offsetTop + firstTopGap + firstargChildNodeTop;
    let fisrtNodeHeight = firstargParentNode.clientHeight;
    let secondNodeLeft = secondSeries.offsetLeft + secondtargParentNode.offsetLeft;
    let secondNodeRight = secondtargParentNode.offsetRight;
    let secondNodeWidth = secondtargParentNode.clientWidth;
    let secondNodeTop = secondtargParentNode.offsetTop + secondTopGap + secondChildNodeTop;
    let secondNodeHeight = secondtargParentNode.clientHeight;
    let topspace = 20;
    let fistNode = index == 0;
    let secondNode = index == length - 1;
    if (firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y1 = fisrtNodeTop - elementGap;
        X2 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y2 = fisrtNodeTop - topspace;
        X3 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y3 = fisrtNodeTop - topspace;
        X4 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y4 = secondNodeTop - elementGap;
        if (this.data.chartFlip) {
            Y1 = fisrtNodeTop + fisrtNodeHeight + elementGap;
            Y2 = fisrtNodeTop + fisrtNodeHeight + topspace;
            Y3 = fisrtNodeTop + fisrtNodeHeight + topspace;
            Y4 = secondNodeTop + secondNodeHeight + elementGap;
        }
    }

    if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y1 = fisrtNodeTop - elementGap;
        X2 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y2 = secondNodeTop - topspace;
        X3 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y3 = secondNodeTop - topspace;
        X4 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y4 = secondNodeTop - elementGap;
        if (this.data.chartFlip) {
            Y1 = fisrtNodeTop + fisrtNodeHeight + elementGap;
            Y2 = secondNodeTop + secondNodeHeight + topspace;
            Y3 = secondNodeTop + secondNodeHeight + topspace;
            Y4 = secondNodeTop + secondNodeHeight + elementGap;
        }
    }
    Y1 = Y1 < 0 ? -Y1 : Y1;
    Y2 = Y2 < 0 ? 0 : Y2;
    Y3 = Y3 < 0 ? 0 : Y3;
    Y4 = Y4 < 0 ? -Y4 : Y4;
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + X1 + "," + Y1 + " L" + X2 + "," + Y2 + " L" + X3 + "," + Y3 + " L" + X4 + "," + Y4;
    let secondaryPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    if (this.data.HighlightArrowState == "start") {
        strPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "secondary-stroke  moodanimation cs-highlight-difference-line",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode);
    arrowHead.style.offsetPath = "path('" + strPath + "')";
    arrowHead.style.offsetDistance = "100%";
    arrowHead.classList.add("moodanimation");
    arrowHead.dataset.animation = "indualhdarrowhead";
    if (this.data.HighlightArrowState == "both") {
        let arrowHead1 = this.createArrowHeader(svgNode);
        arrowHead1.style.offsetPath = "path('" + secondaryPath + "')";
        arrowHead1.style.offsetDistance = "100%";
        arrowHead1.classList.add("moodanimation");
        arrowHead1.dataset.animation = "indualhdarrowheadend";
    }
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");
        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    callout.style.maxWidth = (X3 - X2) * 0.8 + "px";
    let calloutWidth = callout.clientWidth;
    let calloutHeight = callout.clientHeight;
    callout.style.top = Y2 - calloutHeight / 2 + "px";
    callout.style.left = X3 > X2 ? X2 + (X3 - X2 - calloutWidth) / 2 + "px" : X2 + (X2 - X3 - calloutWidth) / 2 + "px";
    let paddingLeft = window.getComputedStyle(callout)["padding-left"] ? parseFloat(window.getComputedStyle(callout)["padding-left"]) : 0;
    let paddingRight = window.getComputedStyle(callout)["padding-right"] ? parseFloat(window.getComputedStyle(callout)["padding-right"]) : 0;
    let remainingWidth = calloutWidth - paddingLeft - paddingRight;
    this.checkFontSizeBasedOnWidth(callout, remainingWidth, index);

    if (index == length - 2) {
        this.checkFontSize(argParent);
    }
};
BaseColumnChart.prototype.checkFontSize = function (argParent) {
    let highlightElements = argParent.querySelectorAll(".cs-dual-highlight-text-callout");
    for (let i1 = 0; i1 < highlightElements.length; i1++) {
        highlightElements[i1].style.fontSize = this.data.HiglightLabelMinFontSize + "px";
    }
};
BaseColumnChart.prototype.checkFontSizeBasedOnWidth = function (callout, remainingWidth, index = 0) {
    let currentWidth = callout.children[0].scrollWidth;
    let currentFontsize = parseFloat(window.getComputedStyle(callout.children[0])["font-size"]);
    let count = 0;

    while (currentWidth > remainingWidth) {
        currentFontsize--;
        if (currentFontsize < 11) {
            break;
        }
        count++;
        callout.children[0].style.fontSize = currentFontsize + "px";
        currentWidth = callout.children[0].scrollWidth;
        if (count > 80) break;
    }
    this.data.HiglightLabelMinFontSize = index == 0 ? currentFontsize : currentFontsize < this.data.HiglightLabelMinFontSize ? currentFontsize : this.data.HiglightLabelMinFontSize;
};
BaseColumnChart.prototype.createHdDisplayFormat = function (value1, value2, index) {
    let TextValue = "";
    switch (this.data.indualHdFormat) {
        case "number":
            TextValue = value1 - value2;
            let elementMaxValue = value1 > value2 ? -TextValue : -TextValue;
            return this.data.HighlightArrowState == "start" ? -elementMaxValue : elementMaxValue;
            break;
        case "percentage":
            let maxValue = parseFloat(value1);
            let minValue = parseFloat(value2);
            let differnceValue = minValue - maxValue;
            let maxPercentage = 100 / maxValue;
            let percentage = maxPercentage * differnceValue;
            let deciamlCount = percentage.toString().split(".").length > 1 ? percentage.toString().split(".")[1].length : 0;
            if (deciamlCount > 2) {
                return percentage.toFixed(2) + "%";
            } else {
                return percentage + "%";
            }
            break;
        case "fraction":
            let fractionvalue = "";
            let numValue1 = value1 > value2 ? value1 : value2;
            let numValue2 = value1 < value2 ? value1 : value2;
            let countNode = 0;
            for (var i1 = Math.max(numValue1, numValue2); i1 > 1; i1--) {
                if (numValue1 % i1 == 0 && numValue2 % i1 == 0) {
                    numValue1 /= i1;
                    numValue2 /= i1;
                }
                if (countNode > 400) {
                    break;
                }
                countNode++;
            }
            if (numValue2 === 1) {
                fractionvalue = numValue1.toString();
            } else {
                fractionvalue = numValue1.toString() + "/" + numValue2.toString();
            }
            return fractionvalue;

            break;
        case "customlabel":
            return this.data.indualHdFormatText[index][0];
            break;
        case "multiplevalue":
            let percentage1 = ((100 / value1) * value2) / 100;
            let deciamlCount1 = percentage1.toString().split(".").length > 1 ? percentage1.toString().split(".")[1].length : 0;
            if (deciamlCount1 > 2) {
                return percentage1.toFixed(2) + "x";
            } else {
                return percentage1 + "x";
            }
            break;
    }
};
BaseColumnChart.prototype.updateBasicData = function () {
    this.seriesItemLengthValue = this.data.seriesItemLength;
    if (this.data._secondaryLineChart) {
        this.seriesItemLengthValue += 1;
    }
    if (this.data._boolTrendline) {
        this.trendlineHeight = this.state.height * 0.2;
        this.updateTrendlineData();
    }
    this.length = this.voData.seriesLength;
    let boolEnabelBaseLine = this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true") ? true : false;
    // if (boolEnabelBaseLine) {
    //     baseLineValueSize = this.voData._customProperties.showYAxisGrid ? 40 : 40;
    // } else {
    //     baseLineValueSize = 0;
    // }
    this.viewport = { x: baseLineValueSize, y: 0, width: this.state.width - baseLineValueSize, height: this.state.height };
    //
    // this.parent.style.display = "flex";
    // this.parent.style.gridTemplateRows = "";
    // this.parent.style.gridTemplateColumns = "";
    // this.parent.style.alignItems = " center";
    // this.parent.style.justifyContent = " center";
    //
    this.rectSeries = { x: this.viewport.x, y: this.viewport.y, width: 0, height: 0 };
    this.rectBaseSeries = { x: this.viewport.x, y: this.viewport.y, width: this.viewport.width, height: this.viewport.height };
    this.chartGroupWidth = [];
};
BaseColumnChart.prototype.updateTrendlineData = function () {
    let numberOfYears = this.data.seriesLength;
    let beginningValue = parseInt(this.data.values[0][0]);
    let endingValue = parseInt(this.data.values[this.data.seriesLength - 1][0]);
    if (this.data.stackedChart) {
        beginningValue = parseInt(this.data.arrSeriesItemValueTotal[0]);
        endingValue = parseInt(this.data.arrSeriesItemValueTotal[this.data.seriesLength - 1]);
    }
    let hasInterMediateHighValue = false;
    for (let i = 1; i < numberOfYears - 1; i++) {
        if (this.data.stackedChart) {
            if (this.data.arrSeriesItemValueTotal[i] > beginningValue && this.data.arrSeriesItemValueTotal[i] > endingValue) {
                hasInterMediateHighValue = true;
            }
        } else {
            if (this.data.values[i][0] > beginningValue && this.data.values[i][0] > endingValue) {
                hasInterMediateHighValue = true;
            }
        }
    }
    if (hasInterMediateHighValue) {
        this.ChartUtils.setExtraValueBounds(this.data, 0, this.trendlineHeight);
    } else {
        this.trendlineHeight = 50;
        this.ChartUtils.setExtraValueBounds(this.data, 0, this.trendlineHeight);
    }
};
// doAddMetaData(argProps) {
//     const element = this.data.SVGUtils.createSVGElement("metadata");
//     return element;
// }

BaseColumnChart.prototype.doAddAxisTitle = function () {
    if (this.data.baseProperties.axisTitle) {
        let chartalignment = "vertical";
        let displayList = [];
        if (this.data._customProperties.showXAxisTitle && this.data._customProperties.showYAxisTitle) displayList = ["axis-title-left", "axis-title-bottom"];
        else if (this.data._customProperties.showXAxisTitle) displayList = ["axis-title-bottom"];
        else if (this.data._customProperties.showYAxisTitle) displayList = ["axis-title-left"];
        let eProps = {
            gridsize: this.props.gridsize,
            chartalignment: chartalignment,
            rectBaseSeries: this.rectBaseSeries,
            displaylist: displayList,
            slideID: this.data.slideID,
            xAxisTitle: this.data._customProperties.xAxisTitle,
            yAxisTitle: this.data._customProperties.yAxisTitle,
            viewport: { x: this.state.x, y: this.state.y, width: this.state.width, height: this.state.height },
        };
        this.addAxisTitleElement(this.parent, eProps);
    }
};

BaseColumnChart.prototype.addAxisTitleElement = function (argParent, argProps) {
    const top = false;
    const left = true;
    const right = false;
    const bottom = true;
    let displaylist = argProps.displaylist;
    let chartHelper = this.ChartHelper;
    let chartFonts = this.ChartFonts;
    let data = this.data;
    displaylist.map(function (item) {
        switch (item) {
            case "axis-title-left": {
                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-left";
                element.style.position = "absolute";
                element.style.left = "0px";
                element.style.width = Math.round(axisTitleSize / argProps.gridsize) * argProps.gridsize + "px";
                element.style.top = 2 * argProps.gridsize + "px";
                element.style.height = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height - axisTitleSize) / argProps.gridsize) * argProps.gridsize + "px";
                argParent.appendChild(element);
                if (data.chartName == "waterfallchart" || data.chartName == "horWaterfallchart") {
                    element.style.top = 22 * argProps.gridsize + "px";
                    element.style.height = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height - axisTitleSize) / argProps.gridsize) * argProps.gridsize + "px";
                }
                let subelement = document.createElement("div");
                subelement.className = "axistitletext moodanimation clsTextSecondaryColor " + chartFonts.axisLabelThemeClassName;
                subelement.id = "axis-title-left-text";
                subelement.dataset.customstartrotation = "-90deg";
                subelement.dataset.customendrotation = "-90deg";
                subelement.innerText = argProps.yAxisTitle;
                subelement.style.minWidth = element.clientHeight + "px";
                subelement.setAttribute("data-slideid", argProps.slideID);
                subelement.setAttribute("data-id", "yAxis");
                subelement.setAttribute("data-animation", "yaxistitle");
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-prompt-text", "Enter Y Axis Label");
                subelement.style.overflow = "hidden";
                if (data._yaxisTextColor) {
                    subelement.style.setProperty("color", data._yaxisTextColor, "important");
                }
                if (data.axisVerLetterspaceing) subelement.style.letterSpacing = data.axisVerLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                if (data.chartName != "waterfallchart" && data.chartName != "horWaterfallchart") {
                    element.style.width = Math.round(subelement.clientHeight / 4) * argProps.gridsize + "px";
                }
                axisTitleSize = subelement.clientHeight;
                argProps.rectBaseSeries.x += axisTitleSize;
                argProps.rectBaseSeries.width -= axisTitleSize;
                break;
            }
            case "axis-title-right": {
                argProps.rectBaseSeries.width -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-right";
                element.style.position = "absolute";
                let columnStart = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize);
                element.style.left = columnStart * argProps.gridsize + "px";
                element.style.minWidth = Math.round(axisTitleSize / argProps.gridsize) * argProps.gridsize + "px";
                element.style.top = Math.round(argProps.rectBaseSeries.y / argProps.gridsize) * argProps.gridsize + "px";
                element.style.height = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height) / argProps.gridsize) * argProps.gridsize + "px";
                argParent.appendChild(element);

                let subelement = document.createElement("p");
                subelement.className = "axistitletext moodanimation clsTextSecondaryColor";
                subelement.id = "axis-title-right-text";
                subelement.setAttribute("data-animation", "yaxistitle");
                subelement.innerText = "Enter Y Axis Title";
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                if (data.axisVerLetterspaceing) subelement.style.letterSpacing = data.axisVerLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
            case "axis-title-top": {
                argProps.rectBaseSeries.y += axisTitleSize;
                argProps.rectBaseSeries.height -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-top";
                element.style.position = "absolute";
                element.style.left = "0px";
                element.style.width = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize) * argProps.gridsize + "px";
                element.style.top = "0px";
                element.style.height = Math.round(axisTitleSize / argProps.gridsize) * argProps.gridsize + "px";
                argParent.appendChild(element);

                let subelement = document.createElement("p");
                subelement.className = "axistitletext moodanimation clsTextSecondaryColor ";
                subelement.id = "axis-title-top-text";
                subelement.innerText = "Enter X Axis Title";
                subelement.setAttribute("data-animation", "xaxistitle");
                subelement.style.alignItems = "flex-start";
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                if (data.axisHorLetterspaceing) subelement.style.letterSpacing = data.axisHorLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
            case "axis-title-bottom": {
                argProps.rectBaseSeries.height -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-bottom";
                element.style.zIndex = "1";
                element.style.height = "100%";
                element.style.overflow = "hidden";
                element.style.position = "absolute";
                element.style.left = parseInt((argProps.rectBaseSeries.x + 75) / argProps.gridsize) * argProps.gridsize + "px";
                element.style.width = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize) * argProps.gridsize + "px";
                element.style.top = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height) / argProps.gridsize) * argProps.gridsize + "px";
                element.style.height = Math.round(axisTitleSize / argProps.gridsize) * argProps.gridsize + "px";
                argParent.appendChild(element);

                let subelement = document.createElement("div");
                subelement.className = "axistitletext moodanimation clsTextSecondaryColor " + chartFonts.axisLabelThemeClassName;
                subelement.id = "axis-title-bottom-text";
                subelement.style.alignItems = "flex-end";
                subelement.style.height = "100%";
                subelement.innerText = argProps.xAxisTitle;
                subelement.setAttribute("data-slideid", argProps.slideID);
                subelement.setAttribute("data-id", "xAxis");
                subelement.setAttribute("data-animation", "xaxistitle");
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-prompt-text", "Enter X Axis Label");
                if (data._xaxisTextColor) {
                    subelement.style.setProperty("color", data._xaxisTextColor, "important");
                }
                if (data.axisHorLetterspaceing) subelement.style.letterSpacing = data.axisHorLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                if (subelement.innerText == "") {
                    subelement.innerText = "Enter X Axis Label";
                    subelement.style.height = "auto";
                    element.style.height = Math.round(subelement.clientHeight / argProps.gridsize) * argProps.gridsize + "px";
                    subelement.innerText = "";
                } else {
                    subelement.style.height = "auto";
                    element.style.height = Math.round(subelement.clientHeight / argProps.gridsize) * argProps.gridsize + "px";
                    subelement.style.height = "100%";
                }
                break;
            }
        }
    });
};
BaseColumnChart.prototype.createCagrContainer = function () {
    if (!this.data._enableChartCagr) return;
    let position = "right";
    let containerMaxWidth = 0;
    let containerMaxHeight = 0;

    const element = this.ChartHelper.createDivElement();
    element.id = "cagr-container";
    element.className = "cagr-container";
    element.style.position = "absolute";
    this.parent.appendChild(element);
    switch (position) {
        case "right":
        case "left":
            containerMaxWidth = this.rectBaseSeries.width * 0.4;
            containerMaxHeight = this.rectBaseSeries.height;
            element.style.maxWidth = containerMaxWidth + "px";
            element.style.maxHeight = containerMaxHeight + "px";
            this.parent.appendChild(element);
            break;
        case "top":
        case "bottom":
            containerMaxWidth = this.rectBaseSeries.width;
            containerMaxHeight = this.rectBaseSeries.height * 0.4;
            element.style.maxWidth = containerMaxWidth + "px";
            element.style.maxHeight = containerMaxHeight + "px";
            this.parent.appendChild(element);
            break;
    }
    let cagrBaseContainer = this.ChartHelper.createDivElement();
    cagrBaseContainer.className = "cs-cagr-base-container moodanimation cagralign" + position;
    cagrBaseContainer.dataset.animation = "cagrbasecontainer";
    cagrBaseContainer.style.maxWidth = containerMaxWidth + "px";
    cagrBaseContainer.style.maxHeight = containerMaxHeight + "px";
    cagrBaseContainer.style.position = "relative";
    cagrBaseContainer.style.display = "flex";
    element.appendChild(cagrBaseContainer);

    let paddingLeft = parseFloat(window.getComputedStyle(cagrBaseContainer).paddingLeft || 0);
    let paddingRight = parseFloat(window.getComputedStyle(cagrBaseContainer).paddingRight || 0);
    let paddingTop = parseFloat(window.getComputedStyle(cagrBaseContainer).paddingTop || 0);
    let paddingBottom = parseFloat(window.getComputedStyle(cagrBaseContainer).paddingBottom || 0);

    let marginLeft = parseFloat(window.getComputedStyle(cagrBaseContainer).marginLeft || 0);
    let marginRight = parseFloat(window.getComputedStyle(cagrBaseContainer).marginRight || 0);
    let marginTop = parseFloat(window.getComputedStyle(cagrBaseContainer).marginTop || 0);
    let marginBottom = parseFloat(window.getComputedStyle(cagrBaseContainer).marginBottom || 0);

    containerMaxWidth = containerMaxWidth - paddingLeft - paddingRight;
    containerMaxHeight = containerMaxHeight - paddingTop - paddingBottom;

    let containerElement = this.ChartHelper.createDivElement();
    containerElement.style.maxWidth = containerMaxWidth + "px";
    containerElement.style.maxHeight = containerMaxHeight + "px";
    containerElement.style.position = "relative";
    containerElement.className = "cagrchildcontainer cagralign" + position;
    containerElement.style.display = "flex";
    if (position == "right") {
        containerElement.style.flexDirection = "column";
    } else if (position == "left") {
        containerElement.style.flexDirection = "column-reverse";
    } else if (position == "top") {
        containerElement.style.flexDirection = "row";
    } else if (position == "bottom") {
        containerElement.style.flexDirection = "row-reverse";
    }
    cagrBaseContainer.appendChild(containerElement);
    for (let i = 0; i < this.data.seriesItemLength; i++) {
        let startValue = this.data.values[0][i];
        let endValue = this.data.values[this.data.values.length - 1][i];

        let labelElement = this.ChartHelper.createDivElement();
        labelElement.className = "cagrItemLabel accent1 clsMultiColorParent cs-cagr-body-style " + this.ChartFonts.legendLabelThemeClassName;
        labelElement.style.maxWidth = containerMaxWidth + "px";
        labelElement.style.maxHeight = containerMaxHeight / this.data.seriesItemLength + "px";
        labelElement.style.position = "relative";
        labelElement.style.display = "flex";
        containerElement.appendChild(labelElement);
        let labelSubElement = this.ChartHelper.createDivElement();
        labelSubElement.className = "cagrItemLabelText cagrBodyLabel moodanimation";
        labelSubElement.dataset.animation = "cagrItemLabelText";
        labelSubElement.style.maxWidth = containerMaxWidth + "px";
        labelSubElement.style.maxHeight = containerMaxHeight / this.data.seriesItemLength + "px";
        labelSubElement.innerText = this.cagrPercent(startValue, endValue, this.data.seriesLength) + "%";
        labelSubElement.style.position = "relative";
        labelSubElement.style.display = "flex";
        labelElement.appendChild(labelSubElement);
    }
    let baseContainerWidth = cagrBaseContainer?.clientWidth || 0;
    let baseContainerChildWidth = cagrBaseContainer?.children[0]?.clientWidth || 0;
    baseContainerWidth = baseContainerChildWidth < 60 ? 60 + paddingLeft + paddingRight : baseContainerWidth;
    let cagrWidth = baseContainerWidth + marginLeft + marginRight;
    cagrWidth = Math.ceil(cagrWidth / this.props.gridsize) * this.props.gridsize;
    let cagrHeight = cagrBaseContainer.clientHeight + marginTop + marginBottom;
    cagrHeight = Math.ceil(cagrHeight / this.props.gridsize) * this.props.gridsize;
    element.style.width = cagrWidth + "px";
    element.style.height = cagrHeight + "px";
    let columnStart = "";
    let columnEnd = "";
    let rowStart = "";
    let rowEnd = "";
    switch (position) {
        case "left":
            columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
            columnStart = columnStart < 1 ? 1 : columnStart;
            columnEnd = Math.round((this.rectBaseSeries.x + cagrWidth) / this.props.gridsize);
            rowStart = Math.round(this.rectBaseSeries.y / this.props.gridsize);
            rowStart = rowStart < 1 ? 1 : rowStart;
            rowEnd = Math.round((this.rectBaseSeries.y + this.rectBaseSeries.height) / this.props.gridsize);
            element.style.position = "absolute";
            element.style.left = (columnStart < 0 ? 0 : columnStart) * this.props.gridsize + "px";
            element.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
            element.style.top = rowStart * this.props.gridsize + "px";
            element.style.height = (rowEnd - rowStart) * this.props.gridsize + "px";
            element.style.height = containerMaxHeight + "px";
            this.rectBaseSeries.width -= cagrWidth;
            this.rectBaseSeries.x += cagrWidth;
            break;
        case "right":
            this.rectBaseSeries.width -= cagrWidth;
            columnStart = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize);
            columnEnd = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width + cagrWidth) / this.props.gridsize);
            rowStart = Math.round(this.rectBaseSeries.y / this.props.gridsize);
            rowStart = rowStart < 1 ? 1 : rowStart;
            rowEnd = Math.round((this.rectBaseSeries.y + this.rectBaseSeries.height) / this.props.gridsize);
            rowEnd = rowEnd < 1 ? 1 : rowEnd;
            element.style.position = "absolute";
            element.style.left = columnStart * this.props.gridsize + "px";
            element.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
            element.style.height = containerMaxHeight + "px";
            element.style.top = rowStart * this.props.gridsize + "px";
            element.style.height = (rowEnd - rowStart) * this.props.gridsize + "px";
            break;
        case "top":
            columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
            columnStart = columnStart < 1 ? 1 : columnStart;
            columnEnd = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize);
            rowStart = Math.round(this.rectBaseSeries.y / this.props.gridsize);
            rowStart = rowStart < 1 ? 1 : rowStart;
            rowEnd = Math.round((this.rectBaseSeries.y + cagrHeight) / this.props.gridsize);
            element.style.position = "absolute";
            element.style.left = columnStart * this.props.gridsize + "px";
            element.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
            element.style.top = rowStart * this.props.gridsize + "px";
            element.style.height = (rowEnd - rowStart) * this.props.gridsize + "px";
            element.style.width = containerMaxWidth + "px";
            this.rectBaseSeries.height -= cagrHeight;
            this.rectBaseSeries.y += cagrHeight;
            break;
        case "bottom":
            columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
            columnStart = columnStart < 1 ? 1 : columnStart;
            columnEnd = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize);
            rowStart = Math.round((this.rectBaseSeries.y + this.rectBaseSeries.height - cagrHeight) / this.props.gridsize);
            rowStart = rowStart < 1 ? 1 : rowStart;
            rowEnd = Math.round((this.rectBaseSeries.y + this.rectBaseSeries.height) / this.props.gridsize);
            element.style.position = "absolute";
            element.style.left = columnStart * this.props.gridsize + "px";
            element.style.width = (columnEnd - columnStart) * this.props.gridsize + "px";
            element.style.top = rowStart * this.props.gridsize + "px";
            element.style.height = (rowEnd - rowStart) * this.props.gridsize + "px";
            this.rectBaseSeries.height -= cagrHeight;
            break;
    }
    let cagrHeading = this.ChartHelper.createDivElement();
    cagrHeading.className = "cagrHeading cs-cagr-header-style h9 moodanimation";
    cagrHeading.dataset.animation = "cagrheading";
    cagrHeading.style.position = "absolute";
    cagrHeading.style.top = "0";
    cagrHeading.style.width = "calc(100% - " + paddingLeft + "px - " + paddingRight + "px)";
    cagrHeading.style.maxHeight = containerMaxHeight * 0.2 + "px";
    cagrBaseContainer.appendChild(cagrHeading);
    let cagrHeadingText = this.ChartHelper.createDivElement();
    cagrHeadingText.className = "cagrHeaderLabel";
    cagrHeadingText.innerText = "CAGR";
    cagrHeadingText.style.width = "100%";
    cagrHeadingText.style.height = "100%";
    cagrHeadingText.style.position = "relative";
    cagrHeading.appendChild(cagrHeadingText);
    element.style.display = "flex";
    element.style.flexDirection = "column-reverse";
    let headeingMarginBottom = parseFloat(window.getComputedStyle(cagrHeading).marginBottom || 0);
    let cagrHeadingHeight = cagrHeading.clientHeight + headeingMarginBottom;
    this.rectBaseSeries.height -= cagrHeadingHeight + paddingTop + marginTop;
    this.rectBaseSeries.y += cagrHeadingHeight + paddingTop + marginTop;
    cagrHeading.style.top = paddingTop + marginTop + "px";
    containerElement.style.top = cagrHeadingHeight + "px";
    containerElement.style.maxHeight = cagrBaseContainer?.clientHeight - cagrHeadingHeight - paddingTop - paddingBottom + "px";
    cagrHeading.style.removeProperty("position");
    element.style.removeProperty("position");
};
BaseColumnChart.prototype.doAddGridValues = function () {
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.gridvalueSize = this.data.gridValueSize;
        if (!this.data.chartFlip && this.data.enableChartTileText != "true" && this.data.enableProjectionText != "true") {
            this.rectBaseSeries.height -= this.gridvalueSize / 2;
            this.rectBaseSeries.y += this.gridvalueSize / 2;
        }
        if (this.data._showTickMark && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            this.tickMarkSize = 24;
        }
        this.rectBaseSeries.x += this.gridvalueSize;
        this.rectBaseSeries.width -= this.gridvalueSize;
        if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left") {
            // this.rectBaseSeries.x -= this.gridvalueSize;
            this.rectBaseSeries.width += this.gridvalueSize;
        }
        // this.rectBaseSeries.y += 5;
        // this.rectBaseSeries.height -= 5;
    }
    if (this.data._showTickMark && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.tickMarkSize = 12;
    }
};
BaseColumnChart.prototype.createSeriesItemLabel = function (element, containerElement) {
    element.style.display = "flex";
    let seriesMaxWidth = containerElement?.clientWidth * 0.45;
    if (this.data.layout.seriesItemLabelAlignment == "left") {
        element.style.flexDirection = "row-reverse";
        element.style.justifyContent = "space-between";
        seriesMaxWidth -= this.gridvalueSize;
    }
    const seriesItemLabel = this.ChartHelper.createDivElement();
    seriesItemLabel.className = "seriesItemLabel accent1 clsMultiColorParent seriesItemLabelparent seriesItemLabel" + this.data.layout.seriesItemLabelAlignment;
    seriesItemLabel.style.maxWidth = seriesMaxWidth + "px";
    seriesItemLabel.style.maxHeight = containerElement?.clientHeight + "px";
    seriesItemLabel.style.width = "100%";
    seriesItemLabel.style.height = "100%";
    seriesItemLabel.style.position = "relative";
    seriesItemLabel.classList.add("th-section" + 1);
    this.seriesItemLabelMaxWidth = seriesMaxWidth;
    this.seriesItemLabelMaxHeight = containerElement?.clientHeight;
    element.appendChild(seriesItemLabel);
    if (this.data.layout.seriesItemLabelAlignment == "left") {
        seriesItemLabel.style.left = -this.gridvalueSize + "px";
    }
    for (let i = 0; i < this.seriesItemLengthValue; i++) {
        this.seriesItemLabelNodeMaxHeight = containerElement.clientHeight * 0.7;
        this.seriesItemLabelNodeMaxWidth = this.seriesItemLabelMaxWidth * 0.9;
        this.createSeriesItemLabelNode(seriesItemLabel, i);
    }
    this.seriesitemLabelLongLabelWidth = this.seriesitemLabelLongLabelWidth + 5 > seriesMaxWidth ? seriesMaxWidth : this.seriesitemLabelLongLabelWidth + 5;
    seriesItemLabel.style.width = this.seriesitemLabelLongLabelWidth + "px";
    this.rectBaseSeries.width -= seriesItemLabel.clientWidth;
    let ColumnContainerWidth = containerElement?.clientWidth;
    containerElement.style.width = ColumnContainerWidth + "px";
    let objBounds = { width: this.seriesitemLabelLongLabelWidth, height: seriesItemLabel.clientHeight };
    seriesItemLabel.style.display = "none";
    return objBounds;
};

BaseColumnChart.prototype.doAddGraphicDesk = function () {
    const pading = 8;
    let dummeyrectBaseSeriesWidth = this.rectBaseSeries.width;
    if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.rectBaseSeries.x -= this.gridvalueSize;
        dummeyrectBaseSeriesWidth -= this.gridvalueSize;
    }
    if (this.data._showTickMark) {
        dummeyrectBaseSeriesWidth -= this.tickMarkSize;
    }
    if (this.data._secondaryLineChart) {
        dummeyrectBaseSeriesWidth -= this.seondaryGridValueSize;
    }
    // if (this.data.layout.itemSpace) {
    //     let numIndualHeight = this.rectBaseSeries.width * this.data.layout.itemSpace;
    //     dummeyrectBaseSeriesHeight = this.rectBaseSeries.width - (numIndualHeight * (this.length ));
    // }
    this.rectSeries.width = dummeyrectBaseSeriesWidth / this.length;
    this.rectSeries.height = this.rectBaseSeries.height;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";
    if (this.data.comparisonStyle == "style1") {
        this.rectBaseSeries.height = this.rectBaseSeries.height - 50;
    }

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    // element.style.width = this.rectBaseSeries.width + "px";
    // element.style.height = this.rectBaseSeries.height + "px";
    // element.style.position = "absolute";
    // element.style.top = "0";
    if (this.data.highlightDifference.display) {
        element.style.zIndex = "15";
    }
    element.style.position = "absolute";
    element.style.width = seriesWidth;
    element.style.height = seriesHeight;
    element.style.maxHeight = seriesHeight;

    // Calculate position and size using absolute positioning instead of grid
    let left = Math.round(this.rectBaseSeries.x / this.props.gridsize) * this.props.gridsize;
    let top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize;
    let width = (Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize) - Math.round(this.rectBaseSeries.x / this.props.gridsize)) * this.props.gridsize;
    let height = this.rectBaseSeries.height - this.rectBaseSeries.y;
    element.style.left = left + "px";
    element.style.top = top + "px";
    element.style.width = width + "px";
    element.style.height = height + "px";
    this.parent.appendChild(element);

    const containerElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";
    containerElement.style.width = element.clientWidth * 0.4 + "px";
    containerElement.style.height = element.clientHeight + "px";
    containerElement.classList.add("columnContainer");
    containerElement.style.position = "relative";
    containerElement.style.display = "flex";
    // if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
    //     containerElement.style.boxSizing = "unset";
    //     if (this.data._directionenable) {
    //         containerElement.style.paddingRight = "34px";
    //     } else {
    //         if (containerElement.parentNode) containerElement.parentNode.style.paddingLeft = "34px";
    //         else containerElement.style.paddingLeft = "34px";
    //     }
    // }
    if (this.legendposition == "top" || this.legendposition == "bottom") element.style.flexDirection = "column";
    // if (this.legendposition == "bottom") {
    //     element.style.flexDirection = "column-reverse";
    // }
    // if (this.legendposition == "left") {
    //     element.style.flexDirection = "row-reverse";
    // }
    // containerElement.style.top = this.rectBaseSeries.x + "px";
    element.appendChild(containerElement);
    this.doAddLegendDesk(element);
    if (this.data.chartName == "lineChart") {
        let boolMultiseries = this.data.data.children[0].getAttribute("value").split(",").length > 1 ? true : false;
        if (boolMultiseries) containerElement.dataset.multiseries = "true";
    }
    containerElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - (element.querySelector(".legend").clientWidth + 5) + "px" : element.clientWidth + "px";
    containerElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? element.clientHeight - element.querySelector(".legend").clientHeight + "px" : element.clientHeight + "px";
    let BaseColumnChartContainer = this.ChartHelper.createDivElement();
    BaseColumnChartContainer.className = "baseColumnChartContainer";
    BaseColumnChartContainer.style.position = "relative";
    if (this.data._showTickMark) {
        BaseColumnChartContainer.style.left = this.tickMarkSize + "px";
    }
    element.appendChild(BaseColumnChartContainer);
    BaseColumnChartContainer.appendChild(containerElement);
    BaseColumnChartContainer.style.width = containerElement.clientWidth + "px";
    BaseColumnChartContainer.style.height = containerElement.clientHeight + "px";
    if (this.data.showSeriesItemLabel) {
        let seriesItemLabelBounds = this.createSeriesItemLabel(BaseColumnChartContainer, containerElement);
        dummeyrectBaseSeriesWidth -= seriesItemLabelBounds.width;
    }
    this.legendHeight = element.querySelector(".legend") ? element.querySelector(".legend").clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    const subElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";

    if (this.legendposition == "right" || this.legendposition == "left") {
        this.legendWidth = element.querySelector(".legend") ? element.querySelector(".legend").clientWidth : 0;
    }
    subElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - element.querySelector(".legend").clientWidth - this.seondaryGridValueSize : element.clientWidth - this.seondaryGridValueSize + "px";
    subElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? this.rectBaseSeries.height - element.querySelector(".legend").clientHeight + "px" : this.rectBaseSeries.height + "px";
    subElement.style.position = "relative";
    if ((this.legendposition == "bottom" || this.legendposition == "top") && (this.seriesItemLengthValue > 1 || this.data.chartName == "waterfallchart")) {
        this.rectBaseSeries.height -= this.legendHeight;
        this.rectSeries.height -= this.legendHeight;
    }
    if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) {
        containerElement.style.position = "relative";
        let gapPercentage = this.data.layout.itemgap ? 1 : 0.7;
        let labelMaxW = this.rectBaseSeries.width * gapPercentage;
        let labeMaxH = this.rectBaseSeries.height * 0.2 + (this.data.layout.labelPaddingtop + this.data.layout.labelPaddingbottom);
        let labelBounds = this.lonngLabelMesurement(element, {}, true, labelMaxW, labeMaxH);
        let labelWidth = labelBounds ? labelBounds.width : 0;
        let valueMaxH = this.rectBaseSeries.width * 0.4;
        let valueBounds = this.lonngValueMesurement(element, {}, true, 30, valueMaxH);
        let valueWidth = valueBounds ? valueBounds.width : 0;
        let itemWidth = this.rectBaseSeries.width - (labelWidth + valueWidth);
        TitleHeight = this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader ? this.createHeader(element, true, labelWidth, valueWidth, itemWidth, true) : { width: 0, height: 0 };
        dummeyrectBaseSeriesWidth -= TitleHeight.width;
        this.data._headerHeight = TitleHeight.width - 12;
        if (this.data.layout.labelHeaderPosition == "top") {
            this.titleY = TitleHeight.height;
            this.titleHeight = TitleHeight.height;
        }
    }
    // subElement.style.top = this.rectBaseSeries.x + "px";
    subElement.style.display = "flex";
    containerElement.appendChild(subElement);
    let baseContainerWidth = 0;
    let gapValue = 0;
    if (this.data.comparisonStyle == "style1") {
        containerElement.style.top = 50 + "px";
    }
    let itemCount = this.length;
    if (
        (this.data.layout.itemSpace == "" && this.data.baseProperties.maxAllowedSeries == 1 && this.data.layout.valueVPosition == "bottom") ||
        ((this.data.layout.itemSpace || this.data.layout.itemSpace == 0) && (this.data.baseProperties.maxAllowedSeries > 1 || this.data.chartName == "simpleIconFillRepeatChart" || this.bollEnableSize))
    ) {
        // let numIndualWidth = dummeyrectBaseSeriesHeight/this.length;
        // let numIndualSizeWidth = this.data.layout.itemgap?numIndualWidth * this.data.layout.itemgap:0;
        // let numIndualGapWidth = this.data.layout.itemSpace?numIndualWidth * this.data.layout.itemSpace:0;
        // let numTotalWidth = (numIndualSizeWidth* (this.length - 1))+(numIndualGapWidth*this.length);
        // containerElement.style.width =numTotalWidth+ "px";
        // numGraphicArea = numIndualWidth * this.data.layout.itemgap;
        // this.rectSeries.width = numGraphicArea;
        dummeyrectBaseSeriesWidth = dummeyrectBaseSeriesWidth - this.legendWidth;
        let numIndualWidth = "";
        let numIndualSizeWidth = "";
        let numIndualGapWidth = "";
        let numTotalWidth = "";
        numIndualWidth = dummeyrectBaseSeriesWidth / itemCount;
        numIndualSizeWidth = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : numIndualWidth * this.data.layout.itemgap) : 0;
        numIndualGapWidth = this.data.layout.itemSpace ? (this.data.layout.itemSpace > 2 ? this.data.layout.itemSpace : numIndualWidth * this.data.layout.itemSpace) : 0;
        numTotalWidth = numIndualGapWidth * (itemCount - 1) + numIndualSizeWidth * itemCount;
        let gapSize = 0;
        gapSize = numIndualGapWidth * this.graphicCornerGap;

        if (this.data.baseProperties.grid) {
            gapSize = numIndualGapWidth * this.graphicCornerGap;
            if (this.data._removeGridGap) gapSize = 0;
        }
        if (numTotalWidth + gapSize > dummeyrectBaseSeriesWidth) {
            dummeyrectBaseSeriesWidth = dummeyrectBaseSeriesWidth - gapSize;
            let sizePercentage = dummeyrectBaseSeriesWidth / numTotalWidth;
            numTotalWidth = dummeyrectBaseSeriesWidth;
            numGraphicArea = numIndualSizeWidth * sizePercentage;
            if (this.data.chartName == "waterfallchart") {
                numGraphicArea = dummeyrectBaseSeriesWidth / itemCount;
            }
            let currentIndualGap = (dummeyrectBaseSeriesWidth - numGraphicArea * itemCount) / (itemCount - 1);
            let gapDiffernceValue = (numIndualGapWidth - currentIndualGap) * this.graphicCornerGap;
            let adjustGap = gapSize > 0 ? gapDiffernceValue / (itemCount + 1) : 0;
            numTotalWidth = dummeyrectBaseSeriesWidth + adjustGap * (itemCount - 1);
            numIndualGapWidth = currentIndualGap + adjustGap * this.graphicCornerGap;
        } else {
            if (this.data.layout.itemgap > 2) {
                numGraphicArea = this.data.layout.itemgap;
                if (this.data.chartName == "waterfallchart") {
                    numGraphicArea = this.data.layout.itemgap + numIndualGapWidth;
                }
            } else {
                numGraphicArea = numIndualWidth * this.data.layout.itemgap;
            }
        }
        containerElement.children[0].style.width = numTotalWidth + "px";
        if (this.data._removeGridGap) numIndualGapWidth = 0;
        if (this.data.baseProperties.grid) {
            containerElement.style.width = numTotalWidth + numIndualGapWidth * this.graphicCornerGap + "px";
            baseContainerWidth = numTotalWidth + numIndualGapWidth * this.graphicCornerGap;
        } else {
            // containerElement.style.width = numTotalWidth + "px";
            // baseContainerWidth = numTotalWidth;
            containerElement.style.width = numTotalWidth + numIndualGapWidth * this.graphicCornerGap + "px";
            baseContainerWidth = numTotalWidth + numIndualGapWidth * this.graphicCornerGap;
        }
        gapValue = numIndualGapWidth;
        this.calculateMergedGraphicAreaWidth(gapValue, numGraphicArea, containerElement, numTotalWidth, true);
        containerElement.style.justifyContent = "center";
        this.ParentElementPosition(element, this.data.layout.parenthPosition);
    } else {
        this.rectSeries.width = (dummeyrectBaseSeriesWidth - this.legendWidth) / itemCount;
        baseContainerWidth = dummeyrectBaseSeriesWidth - this.legendWidth;
    }
    let projectionDisableBounds = this.createChartProjuctionDisableLabel(this.parent, baseContainerWidth, this.state.height, this.data, this.data.instancedetail, element, containerElement, gapValue);
    let projectionBounds = this.createChartProjuctionLabel(this.parent, baseContainerWidth, this.state.height, this.data, this.data.instancedetail, element, containerElement, gapValue, 0, projectionDisableBounds);
    let finalProjectionBounds = projectionBounds;
    if (projectionBounds?.height < projectionDisableBounds?.height) {
        finalProjectionBounds = projectionDisableBounds;
    }
    if (finalProjectionBounds.height > 0) {
        this.rectSeries.height -= finalProjectionBounds.height;
        let subElementHeight = subElement.clientHeight;
        subElement.style.height = subElementHeight - finalProjectionBounds.height + "px";
        let containerElementHeight = containerElement.clientHeight;
        containerElement.style.height = containerElementHeight - finalProjectionBounds.height + "px";
        if (containerElement.parentElement) containerElement.parentElement.style.height = containerElementHeight - finalProjectionBounds.height + "px";
        let baseElementHeight = element.clientHeight;
        element.style.height = baseElementHeight - finalProjectionBounds.height + "px";
        // Update height calculation for absolute positioning
        element.style.height = this.rectBaseSeries.height - finalProjectionBounds.height + "px";
        this.rectBaseSeries.y += finalProjectionBounds.height - 2;
        this.projectionHeight = finalProjectionBounds.height;
    }

    if (this.data.connectorLine) {
        this.doAddLineGraphicElement(subElement);
    } else {
        this.doAddGraphicElement(subElement);
        if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader) this.createHeader(element, false, null, null, null, true);
        if (this.data.layout.labelHeaderPosition == "left") {
            element.style.flexDirection = "row-reverse";
        }
    }
    let arrprojectionEnableDiv = element.querySelectorAll(".projectionEnableGraphic");
    let arrprojectioDisableDiv = element.querySelectorAll(".projectionDisabledGraphic");
    let projectionEnableDiv = arrprojectionEnableDiv.length > 0 ? arrprojectionEnableDiv[0] : "";
    let projectioDisableDiv = arrprojectioDisableDiv.length > 0 ? arrprojectioDisableDiv[arrprojectioDisableDiv.length - 1] : "";
    if (projectionEnableDiv && projectioDisableDiv && this.data.projectionDivider) {
        let disableDiv = { width: projectioDisableDiv.clientWidth, x: projectioDisableDiv.offsetLeft };
        let enableDiv = { width: projectionEnableDiv.clientWidth, x: projectionEnableDiv.offsetLeft };
        let leftValue = 0;
        let gapValue = 0;
        if (disableDiv.x < enableDiv.x) {
            gapValue = enableDiv.x - (disableDiv.x + enableDiv.width);
            leftValue = disableDiv.x + disableDiv.width + gapValue / 2;
            if (this.data.chartName == "lineChart" || this.data.chartName == "stackedAreaChart") {
                leftValue = disableDiv.x + disableDiv.width + gapValue + enableDiv.width / 2;
            }
        }

        if (leftValue == 0) {
            leftValue = 10;
        }
        if (gapValue == 0) {
            gapValue = 10;
        }
        let dividerLine = document.createElement("div");
        dividerLine.className = "projectiondivider moodanimation";
        dividerLine.setAttribute("data-animation", "projectiondividerline");
        dividerLine.style.width = "2px";
        dividerLine.style.left = leftValue + "px";
        dividerLine.style.top = -finalProjectionBounds.height + "px";
        if (this.data.chartFlip) {
            dividerLine.style.top = "0px";
        }
        dividerLine.style.height = "calc(100% + " + finalProjectionBounds.height + "px)";
        subElement.appendChild(dividerLine);
    }
    this.checkSeriesAnimation(element);
    if (this.data.showSeriesItemLabel) this.reArrangeSeriesItemLabel(element);
    if (this.data.showSeriesItemConnector) this.createSeriesItemConnector(element);
    let secondaryGridLineSize = this.legendposition == "right" && this.data.showLegend ? this.seondaryGridValueSize : 0;
    if (BaseColumnChartContainer) {
        let columnContaineWidth = containerElement?.clientWidth || 0;
        let seriesItemLabelWidth = BaseColumnChartContainer.querySelector(".seriesItemLabelparent")?.clientWidth || 0;
        BaseColumnChartContainer.style.width = columnContaineWidth + seriesItemLabelWidth + secondaryGridLineSize + "px";
        if (this.data.chartBorder && !this.data._showTickMark) BaseColumnChartContainer.style.removeProperty("left");
    }
    if (this.data._boolChartGroupLabel) this.createGroupNodeLabel(containerElement, subElement);
};
BaseColumnChart.prototype.createGroupNodeLabel = function (containerElement, subElement) {
    let groupNodeMaxHeight = containerElement.clientHeight * 0.4;
    let arrChartGroupNodes = containerElement.querySelectorAll(".chartgroupnode");
    if (!arrChartGroupNodes || arrChartGroupNodes.length == 0) return;
    let chartGroupLabelNode = document.createElement("div");
    chartGroupLabelNode.className = "chartgroupLabelBaseElement clsMultiColorParent";
    chartGroupLabelNode.style.maxHeight = groupNodeMaxHeight + "px";
    chartGroupLabelNode.style.width = subElement.clientWidth + "px";
    chartGroupLabelNode.style.top = "0";
    chartGroupLabelNode.style.left = "0";
    containerElement.appendChild(chartGroupLabelNode);
    let labelCount = this.data.groupCount;
    containerElement.style.flexDirection = "column";
    containerElement.style.alignItems = "center";
    if (this.data.chartFlip) {
        containerElement.style.flexDirection = "column-reverse";
    }
    let maxHeightValue = 0;
    for (let i = 0; i < labelCount; i++) {
        let groupIndex = this.data.groupOrderIndex[i];
        let chartGroupLabelFontClass = this.data._chartGroupLabelFontClass?.[i] || this.ChartFonts.dynamiclabelThemeClassName(i);
        let labelNode = document.createElement("div");
        labelNode.className = "chartgrouplabelnodeparent cs-group-label-style " + this.data.layout.groupLabelPaddingClass + " " + this.data.layout.groupLabelGlobalClassName + " " + chartGroupLabelFontClass;
        labelNode.id = "groupparentlabelnode-" + i;
        labelNode.style.maxWidth = this.chartGroupWidth[groupIndex] + "px";
        labelNode.style.maxHeight = groupNodeMaxHeight + "px";
        labelNode.style.overflow = "hidden";
        labelNode.style.left = arrChartGroupNodes[i]?.offsetLeft + "px";
        let labelText = document.createElement("div");
        labelText.className = "chartgrouplabeltext moodanimation";
        labelText.setAttribute("data-animation", "grouplabeltext");
        labelText.id = "grouplabeltext-" + groupIndex;
        labelText.style.maxWidth = this.chartGroupWidth[groupIndex] + "px";
        labelText.style.maxHeight = groupNodeMaxHeight + "px";
        labelText.setAttribute("contenteditable", "true");
        labelText.setAttribute("data-themeclass", chartGroupLabelFontClass);
        labelText.setAttribute("data-slideid", this.data.slideID);
        labelText.setAttribute("data-id", groupIndex);
        labelText.setAttribute("data-prompt-text", "Enter Group Label");
        labelText.setAttribute("data-dck-selector", "true");
        labelText.setAttribute("data-type", "chartgrouplabel");
        labelText.innerHTML = this.data.chartGroupLabel[groupIndex] || "";
        chartGroupLabelNode.appendChild(labelNode);
        if (this.data._chartGroupLabelTransform?.[groupIndex]) labelNode.style.setProperty("text-transform", this.data._chartGroupLabelTransform?.[groupIndex], "important");
        if (this.data._chartGroupLabelBold?.[groupIndex] == "true") {
            labelText.style.setProperty("font-weight", "bold", "important");
        }
        if (this.data._chartGroupLabelItalic?.[groupIndex] == "true") {
            labelText.style.setProperty("font-style", "italic", "important");
        }
        if (this.data._chartGroupLabelOpacity?.[groupIndex]) {
            labelNode.style.opacity = this.data._chartGroupLabelOpacity?.[groupIndex];
        }
        if (this.data._chartGroupLabelTextSize?.[groupIndex] != "false") {
            labelNode.style.fontSize = this.data._chartGroupLabelTextSize?.[groupIndex];
            labelNode.dataset.userfontSize = "true";
        }
        if (this.data._chartGroupLabelTextColor?.[groupIndex]) {
            labelText.style.setProperty("color", this.data._chartGroupLabelTextColor?.[groupIndex], "important");
            TextHighLightUtils.clearStylesBasedOnType(labelText, "textcolor");
        } else {
            labelNode.classList.add("clsLabelTextColor");
        }
        if (this.data._chartGroupLabelTextColor?.[groupIndex]) {
            labelText.style.setProperty("color", this.data._chartGroupLabelTextColor?.[groupIndex], "important");
            TextHighLightUtils.clearStylesBasedOnType(labelText, "textcolor");
        }
        if (this.data._chartGroupLabelLineHeight?.[groupIndex]) labelText.style.lineHeight = this.data._chartGroupLabelLineHeight?.[groupIndex];
        if (this.data._chartGroupLabelLetterSpace?.[groupIndex]) labelText.style.letterSpacing = this.data._chartGroupLabelLetterSpace?.[groupIndex] + "em";
        labelNode.appendChild(labelText);
        let maxFontSize = this.ChartFonts.maxLabelFontSize(labelNode);
        this.ChartHelper.setTextChangeListner(labelText);
        this.ChartHelper.adjustFontSize(labelText, 10, 10, maxFontSize);
        this.ChartHelper.adjustFontSizeWidth(labelText, 10, 10, maxFontSize);
        if (labelCount - 1 == i) {
            let arraLabelNode = containerElement.querySelectorAll(".chartgrouplabeltext");
            let minFontSize = maxFontSize;
            for (let j = 0; j < arraLabelNode.length; j++) {
                let fontSize = parseFloat(window.getComputedStyle(arraLabelNode[j]).fontSize);
                if (fontSize < minFontSize && !arraLabelNode[j]?.parentNode?.dataset.userfontSize) minFontSize = fontSize;
            }
            for (let j = 0; j < arraLabelNode.length; j++) {
                if (!arraLabelNode[j]?.parentNode?.dataset.userfontSize) arraLabelNode[j].style.fontSize = minFontSize + "px";
                maxHeightValue = arraLabelNode[j]?.parentNode?.clientHeight > maxHeightValue ? arraLabelNode[j]?.parentNode?.clientHeight : maxHeightValue;
                let labelNodeWidth = arraLabelNode[j].clientWidth;
                let groupNodeWidth = arrChartGroupNodes[j]?.clientWidth;
                let groupNodeLeft = arrChartGroupNodes[j]?.offsetLeft;
                let calcLabelNodeWidth = groupNodeLeft + (groupNodeWidth - labelNodeWidth) / 2;
                arraLabelNode[j].parentNode.style.left = calcLabelNodeWidth + "px";
            }
        }
    }
    chartGroupLabelNode.style.minHeight = maxHeightValue + "px";
};
BaseColumnChart.prototype.calculateMergedGraphicAreaWidth = function (gapValue, numGraphicArea, containerElement, numTotalWidth, boolAdjustSize) {
    let groupingElementGap = this.data.layout.gropElementGap ? (this.data.layout.gropElementGap > 2 ? this.data.layout.gropElementGap : gapValue * this.data.layout.gropElementGap) : 0;
    let boolAdjustGap = groupingElementGap > gapValue ? false : true;
    let finalSeriesWidth = numGraphicArea;
    let finalTotalWidth = null;
    if (boolAdjustGap && this.data.chartGroup) {
        let numGroupNodeGapCount = this.data.groupGapCount;
        let oldTotalGap = gapValue * numGroupNodeGapCount;
        let newTotalGap = groupingElementGap * numGroupNodeGapCount;
        let differenceGap = oldTotalGap - newTotalGap;

        if (boolAdjustSize) {
            let indualExtaSize = (differenceGap * 0.5) / this.data.seriesLength;
            let seriesWidth = numGraphicArea + indualExtaSize;
            finalSeriesWidth = seriesWidth;
            finalTotalWidth = numTotalWidth - (groupingElementGap * numGroupNodeGapCount - 1);
            for (let i = 0; i < this.data.groupCount; i++) {
                this.chartGroupWidth[i] = seriesWidth * this.data.arrChartGroupDatas[i].length + (groupingElementGap * this.data.arrChartGroupDatas[i].length - 1);
            }
        } else {
            finalTotalWidth = numTotalWidth - differenceGap;
        }
    }

    this.rectSeries.width = finalSeriesWidth;
    if (finalTotalWidth) containerElement.children[0].style.width = finalTotalWidth + "px";
};
BaseColumnChart.prototype.createSeriesItemConnector = function (element) {
    let columnContainer = element.querySelector(".columnContainer");
    let baseColumnContainer = element.querySelector(".baseColumnChartContainer");
    let graphicArea = columnContainer?.children[0];
    let connector = this.ChartHelper.createDivElement();
    connector.className = "seriesItemConnector";
    connector.style.width = "100%";
    connector.style.height = "100%";
    connector.style.position = "absolute";
    connector.style.top = "0";
    connector.style.left = "0";
    baseColumnContainer.appendChild(connector);
    let leftValue = graphicArea.offsetLeft;
    let connectorWidth = graphicArea.clientWidth;
    connector.style.width = connectorWidth + "px";
    connector.style.left = leftValue + "px";
    this.createSeriesItemConnectorLine(connector, element);
};
BaseColumnChart.prototype.createSeriesItemConnectorLine = function (connector, element) {
    let voData = this.data;
    let arrSeriesItemContainer = connector.parentElement.querySelectorAll(".seriesitemcond");
    connector.style.height = arrSeriesItemContainer[0].clientHeight + "px";
    connector.style.top = connector.parentElement?.offsetTop + arrSeriesItemContainer[0].offsetTop + "px";
    let arrSeries = element.querySelectorAll(".series");
    for (let i = 0; i < arrSeriesItemContainer.length - 1; i++) {
        let startNode = arrSeriesItemContainer[i];
        let endNode = arrSeriesItemContainer[i + 1];
        let leftValue = arrSeries[i].offsetLeft + startNode.offsetLeft + startNode.offsetWidth;
        let leftWidthValue = arrSeries[i + 1].offsetLeft + endNode.offsetLeft;
        let connectorWidth = leftWidthValue - leftValue;
        let BaseSeriesStartIteams = startNode.querySelectorAll(".baseseriesitem");
        let BaseSeriesEndIteams = endNode.querySelectorAll(".baseseriesitem");
        let connectorLineBaseElement = document.createElement("div");
        connectorLineBaseElement.className = "seriesItemconnectorlineseries";
        connectorLineBaseElement.style.width = connectorWidth + "px";
        connectorLineBaseElement.style.height = "100%";
        connectorLineBaseElement.style.position = "absolute";
        connectorLineBaseElement.style.top = "0";
        connectorLineBaseElement.style.left = leftValue + "px";
        connector.appendChild(connectorLineBaseElement);

        let connectorSvg = this.data.SVGUtils.createSVGElement("svg");
        connectorSvg.style.width = "100%";
        connectorSvg.style.height = "100%";
        connectorLineBaseElement.appendChild(connectorSvg);

        for (let j = 0; j < BaseSeriesStartIteams.length; j++) {
            let startItem = BaseSeriesStartIteams[j];
            let endItem = BaseSeriesEndIteams[j];
            let startItemBouns = { x: startItem.offsetLeft, y: startItem.offsetTop, width: startItem.clientWidth, height: startItem.clientHeight };
            let endItemBouns = { x: endItem.offsetLeft, y: endItem.offsetTop, width: endItem.clientWidth, height: endItem.clientHeight };
            let intStartX = 0;
            let intStartY = startItemBouns.y;
            let intEndX = connectorWidth;
            let intEndY = endItemBouns.y;
            if (this.data.chartFlip) {
                intStartY = startItemBouns.y + startItemBouns.height;
                intEndY = endItemBouns.y + endItemBouns.height;
            }
            let connectorLine = voData.SVGUtils.createSVGElement("path");
            connectorLine.setAttribute("d", "M " + intStartX + " " + intStartY + " L " + intEndX + " " + intEndY);
            connectorLine.setAttribute("class", "seriesItemConnectorLine moodanimation " + this.data.layout.seriesItemConnectorLineClass + " " + this.data._seriesItemConnectorType);
            connectorLine.setAttribute("data-animation", "seriesitemconnectorline");
            if (this.data._seriesItemConnectorThickness) {
                connectorLine.style.strokeWidth = this.data._seriesItemConnectorThickness + "px";
            }
            if (this.data._seriesItemConnectorColor) {
                connectorLine.style.stroke = this.data._seriesItemConnectorColor;
            }
            connectorSvg.appendChild(connectorLine);
            let strokeWidth = parseFloat(this.data._seriesItemConnectorThickness || window.getComputedStyle(connectorLine)["stroke-width"] || 2);
            let dottedArray = "0, " + strokeWidth * 2;
            let dashArray = parseInt(strokeWidth * 3) + ", " + parseInt(strokeWidth * 3);
            let lineType = window.getComputedStyle(connectorLine).getPropertyValue("--connector-line-type");
            let connectorLineType = this.data._seriesItemConnectorType ? this.data._seriesItemConnectorType : lineType || "dashed";
            if (!this.data._seriesItemConnectorType && lineType) {
                this.data.data.setAttribute("seriesitemconnectortype", lineType);
                connectorLine.classList.add(lineType);
            }
            if (!this.data._seriesItemConnectorThickness || strokeWidth) {
                this.data.data.setAttribute("seriesitemconnectorthickness", strokeWidth);
            }
            if (connectorLineType) {
                switch (connectorLineType) {
                    case "dashed":
                        connectorLine.style.strokeDasharray = dashArray;
                        break;
                    case "dotted":
                        connectorLine.style.strokeDasharray = dottedArray;
                        break;
                    case "solid":
                        connectorLine.style.strokeDasharray = "0";
                        break;
                }
            }
        }
    }
};
BaseColumnChart.prototype.reArrangeSeriesItemLabel = function (element) {
    let BaseSeriesItemLabel = element.querySelector(".seriesItemLabel");
    if (BaseSeriesItemLabel) BaseSeriesItemLabel.style.removeProperty("display");
    let arrSeriesItemContainer = element.querySelectorAll(".seriesitemcond");
    BaseSeriesItemLabel.style.top = arrSeriesItemContainer[0].offsetTop + "px";
    let seriesItemContainer = arrSeriesItemContainer[arrSeriesItemContainer.length - 1];
    if (this.data.layout.seriesItemLabelAlignment == "left") {
        seriesItemContainer = arrSeriesItemContainer[0];
    }
    let baseSeriesItemContainerHeight = seriesItemContainer.clientHeight;
    BaseSeriesItemLabel.style.height = baseSeriesItemContainerHeight + "px";
    let arrSeriesItemLabel = BaseSeriesItemLabel.querySelectorAll(".seriesItemLabel");
    let arrBaseSeriesItems = seriesItemContainer.querySelectorAll(".baseseriesitem");
    let baseColumnContainer = element.querySelector(".baseColumnChartContainer");
    let arrBaseSeriesItemBouns = [];
    let arrSeriesItemLabelBouns = [];
    for (let i = 0; i < arrBaseSeriesItems.length; i++) {
        let baseSeriesItem = arrBaseSeriesItems[i];
        arrBaseSeriesItemBouns.push({ id: baseSeriesItem.getAttribute("id"), x: baseSeriesItem.offsetLeft, y: baseSeriesItem.offsetTop, width: baseSeriesItem.clientWidth, height: baseSeriesItem.clientHeight });
    }
    let previousY = 0;
    let gapValue = 20;
    let hasConnector = false;
    arrSeriesItemLabel.forEach(function (item, index) {
        item.style.maxHeight = baseSeriesItemContainerHeight * 0.7 + "px";
        let seriesitemBounds = arrBaseSeriesItemBouns[index];
        let itemBounds = { width: item.clientWidth, height: item.clientHeight };
        let boolOverLapValue = false;
        if (seriesitemBounds.height >= itemBounds?.height) {
            let topValue = seriesitemBounds.y + (seriesitemBounds.height - itemBounds.height) / 2;
            if (index > 0) boolOverLapValue = topValue + itemBounds.height > previousY;
            if (boolOverLapValue) {
                topValue = previousY - itemBounds.height - gapValue;
            }
            if (boolOverLapValue) {
                itemBounds.enableConnector = true;
                hasConnector = true;
            }
            itemBounds.top = topValue;
            item.style.top = topValue + "px";
            previousY = topValue;
        } else if (seriesitemBounds.height < itemBounds?.height) {
            let topValue = seriesitemBounds.y - (itemBounds.height - seriesitemBounds.height);
            if (index > 0) boolOverLapValue = topValue + itemBounds.height > previousY;
            if (boolOverLapValue) {
                topValue = previousY - itemBounds.height - gapValue;
            }
            itemBounds.enableConnector = true;
            hasConnector = true;
            itemBounds.top = topValue;
            item.style.top = topValue + "px";
            previousY = topValue;
        }
        arrSeriesItemLabelBouns.push(itemBounds);
    });
    if (hasConnector) this.createSeriesItemLabelConnector(baseColumnContainer, arrBaseSeriesItemBouns, arrSeriesItemLabelBouns);
};

BaseColumnChart.prototype.createSeriesItemLabelConnector = function (element, arrBaseSeriesItemBouns, arrSeriesItemLabelBouns) {
    let connector = this.ChartHelper.createDivElement();
    connector.className = "seriesItemLabelConnector";
    connector.style.width = "100%";
    connector.style.height = "100%";
    connector.style.position = "absolute";
    connector.style.top = "0";
    connector.style.left = "0";
    element.appendChild(connector);
    let seriesItemLabel = element.querySelector(".seriesItemLabel");
    let columnContainer = element.querySelector(".columnContainer");
    let graphicArea = columnContainer.children[0];
    let leftValue = seriesItemLabel.offsetLeft + seriesItemLabel.clientWidth;
    let GraphicAreaOffsetLeft = columnContainer.offsetLeft + graphicArea.offsetLeft;
    let graphicAreaWidth = GraphicAreaOffsetLeft - leftValue;
    if (this.data.layout.seriesItemLabelAlignment == "right") {
        leftValue = GraphicAreaOffsetLeft + graphicArea.clientWidth;
        graphicAreaWidth = seriesItemLabel.offsetLeft - leftValue;
    }
    connector.style.width = graphicAreaWidth + "px";
    connector.style.left = leftValue + "px";
    this.createSeriesItemLabelConnectorLine(connector, arrSeriesItemLabelBouns, GraphicAreaOffsetLeft, arrBaseSeriesItemBouns);
};
BaseColumnChart.prototype.createSeriesItemLabelConnectorLine = function (connector, arrSeriesItemLabelBouns, GraphicAreaOffsetLeft, arrBaseSeriesItemBouns) {
    let connectorSvg = this.data.SVGUtils.createSVGElement("svg");
    connectorSvg.style.width = "100%";
    connectorSvg.style.height = "100%";
    connector.appendChild(connectorSvg);
    let voData = this.data;
    arrSeriesItemLabelBouns.forEach(function (item, index) {
        if (item.enableConnector) {
            let graphicAreaStartX = GraphicAreaOffsetLeft;
            let connectorLine = voData.SVGUtils.createSVGElement("path");
            let startX = 0;
            let startY = item.top + item.height / 2;
            let endX = graphicAreaStartX;
            let endY = arrBaseSeriesItemBouns[index].y + arrBaseSeriesItemBouns[index].height / 2;
            if (voData.layout.seriesItemLabelAlignment == "right") {
                startY = arrBaseSeriesItemBouns[index].y + arrBaseSeriesItemBouns[index].height / 2;
                endY = item.top + item.height / 2;
            }
            connectorLine.setAttribute("d", "M " + startX + " " + startY + " L " + endX + " " + endY);
            connectorLine.setAttribute("class", "seriesItemLabelConnectorLine moodanimation " + voData.layout.seriesItemLabelConnectorLineClass);
            connectorLine.setAttribute("data-animation", "seriesitemlabelconnectorline");
            connectorLine.style.fill = "none";
            connectorSvg.appendChild(connectorLine);
        }
    });
};
BaseColumnChart.prototype.checkSeriesAnimation = function (element) {
    if (this.data.seriesanimation) {
        let arrGraphicElement = element.querySelectorAll("[data-animation= 'item']");
        let xmlData = this.data.data;
        let oldWidth = [];
        let newWidth = [];
        Array.from(arrGraphicElement).forEach(function (item, index) {
            oldWidth.push(xmlData.children[index] && xmlData.children[index].getAttribute("oldHeight") ? xmlData.children[index].getAttribute("oldHeight") : 0);
            newWidth.push(item.clientHeight);
            let scaleValue = oldWidth[index] != 0 ? oldWidth[index] / newWidth[index] : 0;
            xmlData.children[index].setAttribute("oldHeight", newWidth[index]);
            if (scaleValue != 0) {
                item.dataset.customstartopacity = "1";
                item.style.setProperty("opacity", "1");
                item.dataset.customstartscaley = scaleValue;
                item.dataset.extraduration = "8";
                item.style.transform = "scaleY(" + scaleValue + ")";
            }
        });
        let arrValueElement = element.querySelectorAll("[data-animation= 'secondarytext']");
        Array.from(arrValueElement).forEach(function (item, index) {
            let oldMoveY = xmlData.children[index] && xmlData.children[index].getAttribute("oldgraphicy") ? xmlData.children[index].getAttribute("oldgraphicy") : 0;
            let newy = newWidth[index] - oldWidth[index];
            xmlData.children[index].setAttribute("oldgraphicy", newy);
            if (oldMoveY != 0 || parseInt(newWidth[index]) == parseInt(oldWidth[index])) {
                item.dataset.customstartopacity = "1";
                item.style.setProperty("opacity", "1");
                item.dataset.extraduration = "8";
                item.dataset.customsmovey = newy + "px";
                item.style.transform = "translatey(" + newy + "px)";
            }
        });
    }
};
BaseColumnChart.prototype.doAddMultiSlideGraphicDesk = function () {
    const pading = 8;
    let dummeyrectBaseSeriesWidth = this.rectBaseSeries.width;
    if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.rectBaseSeries.x -= this.gridvalueSize;
        dummeyrectBaseSeriesWidth -= this.gridvalueSize;
    }
    if (this.data._showTickMark) {
        dummeyrectBaseSeriesWidth -= this.tickMarkSize;
    }
    this.rectSeries.width = dummeyrectBaseSeriesWidth / this.length;
    this.rectSeries.height = this.rectBaseSeries.height;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";
    if (this.data.comparisonStyle == "style1") {
        this.rectBaseSeries.height = this.rectBaseSeries.height - 50;
    }
    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    if (this.data.highlightDifference.display) {
        element.style.zIndex = "15";
    }
    element.style.position = "absolute";
    element.style.width = seriesWidth;
    element.style.height = seriesHeight;
    element.style.maxHeight = seriesHeight;

    // Calculate position and size using absolute positioning instead of grid
    let left = Math.round(this.rectBaseSeries.x / this.props.gridsize) * this.props.gridsize;
    let top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize;
    let width = (Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize) - Math.round(this.rectBaseSeries.x / this.props.gridsize)) * this.props.gridsize;
    let height = (Math.round((this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height)) / -this.props.gridsize) - Math.round(this.rectBaseSeries.y / this.props.gridsize)) * this.props.gridsize;

    element.style.left = left + "px";
    element.style.top = top + "px";
    element.style.width = width + "px";
    element.style.height = height + "px";
    this.parent.appendChild(element);

    const containerElement = this.ChartHelper.createDivElement();
    containerElement.style.width = element.clientWidth + "px";
    containerElement.style.height = element.clientHeight + "px";
    containerElement.classList.add("columnContainer");
    containerElement.style.display = "flex";
    if (this.seriesItemLengthValue > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        containerElement.style.boxSizing = "unset";
        if (this.data._directionenable) {
            containerElement.style.paddingRight = "34px";
        } else {
            containerElement.style.paddingLeft = "34px";
        }
    }
    if (this.legendposition == "top" || this.legendposition == "bottom") element.style.flexDirection = "column";
    if (this.legendposition == "top") {
        element.style.flexDirection = "column-reverse";
    }
    if (this.legendposition == "left") {
        element.style.flexDirection = "row";
    }
    element.appendChild(containerElement);

    let BaseColumnChartContainer = this.ChartHelper.createDivElement();
    BaseColumnChartContainer.className = "baseColumnChartContainer";
    BaseColumnChartContainer.style.position = "relative";
    if (this.data._showTickMark) {
        BaseColumnChartContainer.style.left = this.tickMarkSize + "px";
    }
    element.appendChild(BaseColumnChartContainer);
    BaseColumnChartContainer.appendChild(containerElement);
    BaseColumnChartContainer.style.width = containerElement.clientWidth + "px";
    BaseColumnChartContainer.style.height = containerElement.clientHeight + "px";
    if (this.data.showSeriesItemLabel) {
        let seriesItemLabelBounds = this.createSeriesItemLabel(BaseColumnChartContainer, containerElement);
        dummeyrectBaseSeriesWidth -= seriesItemLabelBounds.width;
    }

    this.doAddLegendDesk(element);
    containerElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - (element.querySelector(".legend").clientWidth + 5) + "px" : element.clientWidth + "px";
    containerElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? element.clientHeight - element.querySelector(".legend").clientHeight + "px" : element.clientHeight + "px";
    this.legendHeight = element.querySelector(".legend") ? element.querySelector(".legend").clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    let multislideBounds = this.getMultiSlideBounds();
    let currentlength = 0;
    let currentIndex = 0;
    for (c1 = 0; c1 < multislideBounds.slideCount; c1++) {
        this.length = multislideBounds.elementCount[c1];
        currentlength += multislideBounds.elementCount[c1];
        if (c1 != 0) {
            containerElement.style.overflow = "hidden";
            containerElement.style.position = "relative";
            currentIndex += multislideBounds.elementCount[c1 - 1];
        }
        let subElement = this.ChartHelper.createDivElement();
        if (this.legendposition == "right" || this.legendposition == "left") {
            this.legendWidth = element.querySelector(".legend") ? element.querySelector(".legend").clientWidth : 0;
        }
        if (this.data.hasMultiSlide && c1 != 0) {
            subElement.classList.add("clsmultislide");
        }
        subElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - element.querySelector(".legend").clientWidth : element.clientWidth + "px";
        subElement.style.height = element.querySelector(".legend") && (this.legendposition == "top" || this.legendposition == "bottom") ? element.clientHeight - element.querySelector(".legend").clientHeight + "px" : element.clientHeight + "px";
        subElement.style.position = "relative";
        if ((this.legendposition == "bottom" || this.legendposition == "top") && (this.seriesItemLengthValue > 1 || this.data.chartName == "waterfallchart")) {
            this.rectBaseSeries.height -= this.legendHeight;
            this.rectSeries.height -= this.legendHeight;
        }
        if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) {
            containerElement.style.position = "relative";
            let gapPercentage = this.data.layout.itemgap ? 1 : 0.7;
            let labelMaxW = this.rectBaseSeries.width * gapPercentage;
            let labeMaxH = this.rectBaseSeries.height * 0.2 + (this.data.layout.labelPaddingtop + this.data.layout.labelPaddingbottom);
            let labelBounds = this.lonngLabelMesurement(element, {}, true, labelMaxW, labeMaxH);
            let labelWidth = labelBounds ? labelBounds.width : 0;
            let valueMaxH = this.rectBaseSeries.width * 0.4;
            let valueBounds = this.lonngValueMesurement(element, {}, true, 30, valueMaxH);
            let valueWidth = valueBounds ? valueBounds.width : 0;
            let itemWidth = this.rectBaseSeries.width - (labelWidth + valueWidth);
            TitleHeight = this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader ? this.createHeader(element, true, labelWidth, valueWidth, itemWidth, true) : { width: 0, height: 0 };
            dummeyrectBaseSeriesWidth -= TitleHeight.width;
            this.data._headerHeight = TitleHeight.width - 12;
            if (this.data.layout.labelHeaderPosition == "top") {
                this.titleY = TitleHeight.height;
                this.titleHeight = TitleHeight.height;
            }
        }
        subElement.style.display = "flex";
        containerElement.appendChild(subElement);
        let baseContainerWidth = 0;
        let gapValue = 0;
        if (this.data.comparisonStyle == "style1") {
            containerElement.style.top = 50 + "px";
        }
        if (
            (this.data.layout.itemSpace == "" && this.data.baseProperties.maxAllowedSeries == 1 && this.data.layout.valueVPosition == "bottom") ||
            ((this.data.layout.itemSpace || this.data.layout.itemSpace == 0) && (this.data.baseProperties.maxAllowedSeries > 1 || this.data.chartName == "simpleIconFillRepeatChart" || this.bollEnableSize))
        ) {
            dummeyrectBaseSeriesWidth = dummeyrectBaseSeriesWidth - this.legendWidth;
            let numIndualWidth = "";
            let numIndualSizeWidth = "";
            let numIndualGapWidth = "";
            let numTotalWidth = "";
            numIndualWidth = dummeyrectBaseSeriesWidth / this.length;
            numIndualSizeWidth = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : numIndualWidth * this.data.layout.itemgap) : 0;
            numIndualGapWidth = this.data.layout.itemSpace ? (this.data.layout.itemSpace > 2 ? this.data.layout.itemSpace : numIndualWidth * this.data.layout.itemSpace) : 0;
            numTotalWidth = numIndualGapWidth * (this.length - 1) + numIndualSizeWidth * this.length;
            let gapSize = 0;
            if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
                gapSize = numIndualGapWidth * this.graphicCornerGap;
                if (this.data._removeGridGap) gapSize = 0;
            }
            if (numTotalWidth + gapSize > dummeyrectBaseSeriesWidth) {
                let differnceValue = numTotalWidth - dummeyrectBaseSeriesWidth;
                // numGraphicArea = (this.data.layout.itemgap-percentageForSize);
                dummeyrectBaseSeriesWidth = dummeyrectBaseSeriesWidth - gapSize;
                let sizePercentage = dummeyrectBaseSeriesWidth / numTotalWidth;
                numTotalWidth = dummeyrectBaseSeriesWidth;
                numGraphicArea = numIndualSizeWidth * sizePercentage;
                if (this.data.chartName == "waterfallchart") {
                    numGraphicArea = dummeyrectBaseSeriesWidth / this.length;
                }
                let currentIndualGap = (dummeyrectBaseSeriesWidth - numGraphicArea * this.length) / (this.length - 1);
                let gapDiffernceValue = (numIndualGapWidth - currentIndualGap) * this.graphicCornerGap;
                let adjustGap = gapSize > 0 ? gapDiffernceValue / (this.length + 1) : 0;
                numTotalWidth = dummeyrectBaseSeriesWidth + adjustGap * (this.length - 1);
                numIndualGapWidth = currentIndualGap + adjustGap * this.graphicCornerGap;
            } else {
                if (this.data.layout.itemgap > 2) {
                    numGraphicArea = this.data.layout.itemgap;
                    if (this.data.chartName == "waterfallchart") {
                        numGraphicArea = this.data.layout.itemgap + numIndualGapWidth;
                    }
                } else {
                    numGraphicArea = numIndualWidth * this.data.layout.itemgap;
                }
            }
            subElement.style.width = numTotalWidth + "px";
            if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
                if (c1 == 0) containerElement.style.width = numTotalWidth + numIndualGapWidth * this.graphicCornerGap + "px";
                baseContainerWidth = numTotalWidth + numIndualGapWidth * this.graphicCornerGap;
            } else {
                if (c1 == 0) containerElement.style.width = numTotalWidth + "px";
                baseContainerWidth = numTotalWidth;
            }
            gapValue = numIndualGapWidth;
            if (c1 == 0) containerElement.style.justifyContent = "center";
            subElement.dataset.gapvalues = gapValue;
            this.rectSeries.width = numGraphicArea;
            this.ParentElementPosition(element, this.data.layout.parenthPosition);
        } else {
            this.rectSeries.width = (dummeyrectBaseSeriesWidth - this.legendWidth) / this.length;
            baseContainerWidth = dummeyrectBaseSeriesWidth - this.legendWidth;
        }
        if (c1 == 0) {
            let projectionBounds = this.createChartProjuctionLabel(this.parent, baseContainerWidth, this.state.height, this.data, this.data.instancedetail, element, containerElement, gapValue, c1);
            if (projectionBounds.height > 0) {
                this.rectSeries.height -= projectionBounds.height;
                let subElementHeight = subElement.clientHeight;
                subElement.style.height = subElementHeight - projectionBounds.height + "px";
                let containerElementHeight = containerElement.clientHeight;
                if (c1 == 0) containerElement.style.height = containerElementHeight - projectionBounds.height + "px";
                let baseElementHeight = element.clientHeight;
                element.style.height = baseElementHeight - projectionBounds.height + "px";
                element.style.height = Math.round((this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height)) / -this.props.gridsize) * this.props.gridsize + "px";
                this.rectBaseSeries.y += projectionBounds.height - 2;
                this.projectionHeight = projectionBounds.height;
            }
        }

        if (this.data.connectorLine) {
            this.doAddLineGraphicElement(subElement);
        } else {
            this.doAddGraphicElement(subElement, currentlength, currentIndex);
            if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.itemHeader) this.createHeader(element, false, null, null, null, true);
            if (this.data.layout.labelHeaderPosition == "left") {
                element.style.flexDirection = "row-reverse";
            }
        }
        if (multislideBounds.slideCount > 0 && this.data.multislideIndex != c1 && !this.data.presentMode) {
            let indexValue = c1 + 1;
            if (this.data.multislideIndex > c1) {
                subElement.style.left = containerElement.clientWidth * indexValue + 10 + "px";
            } else {
                subElement.style.left = -(containerElement.clientWidth * indexValue + 10) + "px";
            }
        } else {
            if (multislideBounds.slideCount > 0 && this.data.multislideIndex == c1) {
                subElement.style.left = "unset";
            }
        }
        let arrprojectionEnableDiv = element.querySelectorAll(".projectionEnableGraphic");
        let arrprojectioDisableDiv = element.querySelectorAll(".projectionDisabledGraphic");
        let projectionEnableDiv = arrprojectionEnableDiv.length > 0 ? arrprojectionEnableDiv[0] : "";
        let projectioDisableDiv = arrprojectioDisableDiv.length > 0 ? arrprojectioDisableDiv[arrprojectioDisableDiv.length - 1] : "";
        if (projectionEnableDiv && projectioDisableDiv && this.data.projectionDivider) {
            let disableDiv = { width: projectioDisableDiv.clientWidth, x: projectioDisableDiv.offsetLeft };
            let enableDiv = { width: projectionEnableDiv.clientWidth, x: projectionEnableDiv.offsetLeft };
            let leftValue = 0;
            let gapValue = 0;
            if (disableDiv.x < enableDiv.x) {
                gapValue = enableDiv.x - (disableDiv.x + enableDiv.width);
                leftValue = disableDiv.x + disableDiv.width + gapValue / 2;
            }
            if (leftValue == 0) {
                leftValue = 10;
            }
            if (gapValue == 0) {
                gapValue = 10;
            }
            let dividerLine = document.createElement("div");
            dividerLine.className = "projectiondivider moodanimation";
            dividerLine.setAttribute("data-animation", "projectiondividerline");
            dividerLine.style.width = "2px";
            dividerLine.style.left = leftValue + "px";
            dividerLine.style.top = -projectionBounds.height + "px";
            dividerLine.style.height = "calc(100% + " + projectionBounds.height + "px)";
            subElement.appendChild(dividerLine);
        }
        let arrObj = Array.from(containerElement.querySelectorAll("[data-animation]"));
        arrObj.map((item) => {
            let animateId = item.getAttribute("data-animation");
            item.setAttribute("data-multislideanimation", animateId);
        });
    }
    if (this.data.showSeriesItemLabel) this.reArrangeSeriesItemLabel(element);
    if (this.data.showSeriesItemConnector) this.createSeriesItemConnector(element);
    let secondaryGridLineSize = this.legendposition == "right" && this.data.showLegend ? this.seondaryGridValueSize : 0;
    if (BaseColumnChartContainer) {
        let columnContaineWidth = containerElement?.clientWidth || 0;
        let seriesItemLabelWidth = BaseColumnChartContainer.querySelector(".seriesItemLabelparent")?.clientWidth || 0;
        BaseColumnChartContainer.style.width = columnContaineWidth + seriesItemLabelWidth + secondaryGridLineSize + "px";
        if (this.data.chartBorder && !this.data._showTickMark) BaseColumnChartContainer.style.removeProperty("left");
    }
};
BaseColumnChart.prototype.createChartProjuctionLabel = function (basechart, gridWidth, gridHeight, voData, instancedetail, secondaryBaseChart, containerElement, gapValue, index = 0, projectionDisableBounds = null) {
    if (gapValue == 0) {
        gapValue = 10;
    }
    if (this.data.projectionDivider) {
        gapValue = 12;
    }
    if (voData.enableProjectionText == "true") {
        let projectionAreaBounds = this.calculateProjectionWidth(gridWidth, containerElement);
        let projectionWidth = projectionAreaBounds.width;
        let element = document.createElement("div");
        element.className = "projectionenabletext projectionTitle cs-projection-title-text-parent";
        element.style.zIndex = "1";
        element.style.position = "absolute";
        element.style.left = Math.round((projectionAreaBounds.x + gapValue) / this.props.gridsize) * this.props.gridsize + "px";
        element.style.width = (Math.round((projectionAreaBounds.x + projectionWidth) / this.props.gridsize) - Math.round((projectionAreaBounds.x + gapValue) / this.props.gridsize)) * this.props.gridsize + "px";
        element.style.top = Math.round(projectionAreaBounds.y / this.props.gridsize) * this.props.gridsize + "px";
        element.style.height = Math.round(250 / 4) * this.props.gridsize + "px";
        if (this.data.projectionDivider) {
            element.style.paddingLeft = "16px";
        }
        basechart.appendChild(element);
        let totalHeight = basechart.clientHeight * 0.3;
        let targetElemetHeight = 0;
        if (voData._boolEnableProjectionHeadingText == "true") {
            targetElemetHeight = this.createProjectionHeadingText(element, voData, totalHeight * 0.5, projectionWidth);
        }
        targetElemetHeight += this.createProjectionText(element, voData, totalHeight - targetElemetHeight, projectionWidth);
        if (projectionDisableBounds?.height > targetElemetHeight) {
            targetElemetHeight = projectionDisableBounds.height;
        }
        let position = "top";
        let marginBottom = 0;
        switch (position) {
            case "top":
                if (this.data.chartFlip) {
                    if (this.data._customProperties.showYAxisTitle) {
                    }
                    secondaryBaseChart.style.height = Math.round((gridHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                    element.style.top = Math.round((secondaryBaseChart.clientHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                    element.style.height = Math.round(targetElemetHeight / 4) * this.props.gridsize + "px";
                } else {
                    element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
                    element.style.height = Math.round((this.rectBaseSeries.y + targetElemetHeight) / this.props.gridsize) * this.props.gridsize + "px";
                    secondaryBaseChart.style.top = Math.round((this.rectBaseSeries.y + targetElemetHeight) / this.props.gridsize) * this.props.gridsize + "px";
                    secondaryBaseChart.style.height = Math.round((gridHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                }
                if (index > 1) basechart.removeChild(element);
                if (this.data.chartFlip) {
                    return { x: 0, y: 0, element: element, width: 0, height: targetElemetHeight, marginBottom: marginBottom };
                } else {
                    return { x: 0, y: 0, width: 0, height: targetElemetHeight };
                }
                break;
            case "bottom":
                // secondaryBaseChart.style.gridRowStart = 1;
                // secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight-subelement.clientHeight-marginTop)/4);
                // element.style.gridRowStart = secondaryBaseChart.style.gridRowEnd;
                element.style.height = Math.round(gridHeight / 4) * this.props.gridsize + "px";
                if (index > 1) basechart.removeChild(element);
                return { x: 0, y: 0, element: element, width: 0, height: targetElemetHeight + marginTop };
                break;
        }
    } else {
        return { x: 0, y: 0, width: 0, height: 0 };
    }
};
BaseColumnChart.prototype.createChartProjuctionDisableLabel = function (basechart, gridWidth, gridHeight, voData, instancedetail, secondaryBaseChart, containerElement, gapValue, index = 0) {
    if (gapValue == 0) {
        gapValue = 10;
    }
    if (this.data.projectionDivider) {
        gapValue = 12;
    }
    if (voData._boolEnableProjectionDisabledText == "true" && this.data.projectionindex > 0) {
        let projectionAreaBounds = this.calculateProjectionDisableWidth(gridWidth, containerElement);
        let projectionWidth = projectionAreaBounds.width;
        let element = document.createElement("div");
        element.className = "projectiondisabletext projectionTitle cs-projection-title-text-parent";
        element.style.zIndex = "1";
        element.style.position = "absolute";
        element.style.left = Math.round(projectionAreaBounds.x / this.props.gridsize) * this.props.gridsize + "px";
        element.style.width = (Math.round((projectionAreaBounds.x + projectionWidth) / this.props.gridsize) - Math.round(projectionAreaBounds.x / this.props.gridsize)) * this.props.gridsize + "px";
        element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
        element.style.height = Math.round(250 / 4) * this.props.gridsize + "px";
        if (this.data.projectionDivider) {
            element.style.paddingLeft = "16px";
        }
        basechart.appendChild(element);
        let totalHeight = basechart.clientHeight * 0.3;
        let targetElemetHeight = 0;
        if (voData._boolEnableProjectionDisabledHeadingText == "true") {
            targetElemetHeight = this.createProjectionDisableHeadingText(element, voData, totalHeight * 0.5, projectionWidth);
        }
        targetElemetHeight += this.createProjectionDisableText(element, voData, totalHeight - targetElemetHeight, projectionWidth);
        let position = "top";
        let marginBottom = 0;
        switch (position) {
            case "top":
                if (this.data.chartFlip) {
                    if (this.data._customProperties.showYAxisTitle) {
                    }
                    if (voData.enableProjectionText != "true") secondaryBaseChart.style.height = Math.round((gridHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                    element.style.top = Math.round((secondaryBaseChart.clientHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                    element.style.height = Math.round(targetElemetHeight / 4) * this.props.gridsize + "px";
                } else {
                    element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
                    element.style.height = Math.round((this.rectBaseSeries.y + targetElemetHeight) / this.props.gridsize) * this.props.gridsize + "px";
                    if (voData.enableProjectionText != "true") {
                        secondaryBaseChart.style.top = Math.round((this.rectBaseSeries.y + targetElemetHeight) / this.props.gridsize) * this.props.gridsize + "px";
                        secondaryBaseChart.style.height = Math.round((gridHeight - targetElemetHeight) / 4) * this.props.gridsize + "px";
                    }
                }
                if (index > 1) basechart.removeChild(element);
                if (this.data.chartFlip) {
                    return { x: 0, y: 0, element: element, width: 0, height: targetElemetHeight, marginBottom: marginBottom };
                } else {
                    return { x: 0, y: 0, width: 0, height: targetElemetHeight };
                }
                break;
            case "bottom":
                // secondaryBaseChart.style.gridRowStart = 1;
                // secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight-subelement.clientHeight-marginTop)/4);
                // element.style.gridRowStart = secondaryBaseChart.style.gridRowEnd;
                element.style.height = Math.round(gridHeight / 4) * this.props.gridsize + "px";
                if (index > 1) basechart.removeChild(element);
                return { x: 0, y: 0, element: element, width: 0, height: targetElemetHeight + marginTop };
                break;
        }
    } else {
        return { x: 0, y: 0, width: 0, height: 0 };
    }
};
BaseColumnChart.prototype.createProjectionText = function (argParent, voData, totalHeight, projectionWidth = null) {
    let themeClassName = "p4";
    if (this.ChartFonts && this.ChartFonts.projectiontext) {
        themeClassName = this.ChartFonts.projectiontext;
    }
    if (voData.projectionTitleTextFontSize) {
        themeClassName = voData.projectionTitleTextFontSize;
    }
    let element = document.createElement("div");
    element.className = "cls-proj-description-parent";
    element.style.maxHeight = totalHeight + "px";
    element.style.width = "100%";
    if (projectionWidth) element.style.maxWidth = projectionWidth + "px";
    argParent.appendChild(element);
    if (voData.projectionTextAlign) {
        element.classList.add(voData.projectionTextAlign);
    } else {
        element.classList.add("projectiontextleftalign");
    }
    let subelement = document.createElement("div");
    subelement.className = "cls-proj-description moodanimation  cs-projection-title-text-child " + themeClassName;
    subelement.id = "projectionTitletext-text";
    subelement.style.zIndex = "1";
    subelement.style.height = "auto";
    subelement.style.maxWidth = projectionWidth + "px";
    subelement.innerHTML = voData.projectiontext;
    subelement.setAttribute("maxFontSize", 30);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "projectiontext");
    subelement.setAttribute("data-animation", "projectiontiletext");
    subelement.setAttribute("data-prompt-text", "Enter your projection text");
    if (voData._projectionTextBold) {
        subelement.style.setProperty("font-weight", "bold", "important");
    }
    if (voData._projectionTextItalic) {
        subelement.style.setProperty("font-style", "italic", "important");
    }
    if (voData.projectionTextLineHeight) subelement.style.lineHeight = voData.projectionTextLineHeight;
    if (voData.projectionTextLetterSpace) subelement.style.letterSpacing = voData.projectionTextLetterSpace + "em";
    if (voData.projectionTextSize) subelement.style.setProperty("font-size", voData.projectionTextSize, "important");
    if (voData.projectionTextOpacity) subelement.style.setProperty("opacity", voData.projectionTextOpacity, "important");
    if (voData.projectionTextTransform) subelement.style.setProperty("text-transform", voData.projectionTextTransform, "important");
    this.ChartHelper.setTextChangeListner(subelement);
    element.appendChild(subelement);
    let parentBg = window.getComputedStyle(element)["background-color"];
    let childBg = window.getComputedStyle(subelement)["background-color"];
    if (childBg != "rgba(0, 0, 0, 0)" || parentBg != "rgba(0, 0, 0, 0)") {
        subelement.classList.add("titleColorBg");
    } else {
        subelement.classList.add("transparentBg");
    }
    let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : 0;
    let paddingTop = window.getComputedStyle(element)["padding-top"] ? parseFloat(window.getComputedStyle(element)["padding-top"]) : 0;
    let paddingBottom = window.getComputedStyle(element)["padding-bottom"] ? parseFloat(window.getComputedStyle(element)["padding-bottom"]) : 0;
    let marginTop = window.getComputedStyle(element)["margin-top"] ? parseFloat(window.getComputedStyle(element)["margin-top"]) : 0;
    let marginBottom = window.getComputedStyle(element)["margin-bottom"] ? parseFloat(window.getComputedStyle(element)["margin-bottom"]) : 0;
    subelement.style.maxHeight = totalHeight - paddingTop - paddingBottom + "px";
    let lineCount = Math.floor(subelement?.clientHeight / lineHeight);
    lineCount = lineCount > 1 ? lineCount : 1;
    subelement.style.height = lineCount * lineHeight + "px";

    if (this.data._projectionTextColor) {
        subelement.style.setProperty("color", this.data._projectionTextColor, "important");
        TextHighLightUtils.clearStylesBasedOnType(subelement, "textcolor");
    }
    let height = element?.clientHeight > 0 ? element?.clientHeight + marginTop + marginBottom : 0;
    return height;
};
