                    gridNegLineElement.appendChild(lineElement);
                    lineElementHeight = lineElement.clientWidth;
                    lineElement.classList.add("reverse");
                }

                gridNegValueElement = document.createElement("div");
                gridNegValueElement.className = "gridValuecontainer";
                gridNegValueElement.style.width = this.negBounds.width - this.negValueBounds.width - this.gridValueSizeW - this.gridthickMarkerW + "px";
                gridNegValueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                gridNegValueElement.style.position = "absolute";
                gridNegValueElement.style.top = this.viewport.height - this.gridValueSizeH + "px";
                this.parent.appendChild(gridNegValueElement);

                if (this.data.chartFlip) {
                    gridNegValueElement.style.left = gridLineElement.clientWidth + "px";
                    gridNegValueElement.classList.add("negflipvaluecontainer");
                }

                for (let i2 = 0; i2 < this.negativeGridCount; i2++) {
                    let valueElement = document.createElement("div");
                    valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                    valueElement.style.width = negWidth;
                    valueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                    valueElement.innerHTML = this.getDenominationValue(Math.round((this.voData.rangeNegative / this.negativeGridCount) * (this.negativeGridCount - i2)));
                    if (this.data.displayValueFormat == "percentage") {
                        let valueDifference = (this.voData.rangeNegative / this.voData.rangeTotal) * 100;
                        valueElement.innerHTML = Math.round((valueDifference / this.negativeGridCount) * (this.negativeGridCount - i2)) + "%";
                    }
                    if (this.voData.rangeNegative > -1) {
                        valueElement.innerHTML = this.getDenominationValue((this.voData.rangeNegative / this.negativeGridCount) * (this.negativeGridCount - i2));
                    }

                    valueElement.style.textAlign = "start";
                    valueElement.dataset.animation = "gridvalue";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        valueElement.style.opacity = "0";
                        valueElement.style.visibility = "hidden";
                    }
                    gridNegValueElement.appendChild(valueElement);
                    if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                    if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != this.negativeGridCount - 1) {
                        valueElement.style.setProperty("opacity", "0", "important");
                    }
                }
            }
        }

        if (this.type == "vertical") {
            let lineElementHeight = 0;
            for (let i1 = 0; i1 < this.positiveGridCount; i1++) {
                let lineElement = document.createElement("div");
                lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                lineElement.style.width = this.viewport.width - this.gridValueSizeW - this.gridthickMarkerW + "px";
                lineElement.style.height = height;
                lineElement.dataset.animation = "gridlines";

                if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
