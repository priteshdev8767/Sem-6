SimpleShapeComparisonSeriesItem.prototype.doMaskPieComputation = function (assetSize, groupindex, index, subelement, argprops) {
    assetSize = parseInt(assetSize);
    let intMaxAngle = 360;
    this.pntCenter.x = parseInt(assetSize / 2);
    this.pntCenter.y = parseInt(assetSize / 2);
    let value = argprops.value < 100 ? argprops.value : 100;
    this.radius = parseInt(assetSize / 2);
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
    this.endAngle = this.startAngle + (intMaxAngle * value) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.ChartFonts.graphicFillColor(groupindex);
    let strBgStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);

    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "micropie",
        x: "0%",
        y: "0%",
        width: parseInt(assetSize) + "px",
        height: parseInt(assetSize) + "px",
        viewBox: 0 + " " + 0 + " " + parseInt(assetSize) + " " + parseInt(assetSize),
    });
    subelement.appendChild(svgElement);

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to  " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray,
        mask: "url(#mask" + groupindex + ")",
    });

    let circlesvg = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(circlesvg, {
        id: "maskcircle" + groupindex,
        class: "moodanimation transformOrgincenter " + strBgStyleClass,
        cx: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.x),
        cy: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.y),
        r: this.data.SVGUtils.createPercentValue(assetSize, this.radius),
        "data-animation": "itembackground",
        "fill-opacity": this.data.layout.backgroundOpacity,
        "stroke-opacity": 0,
    });
    svgElement.appendChild(circlesvg);
    svgElement.appendChild(svgPathTo);
};

SimpleShapeComparisonSeriesItem.prototype.doDoughnutComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let intMaxAngle = 360;
    this.pntCenter.x = assetSize / 2;
    this.pntCenter.y = assetSize / 2;
    this.radius = assetSize / 2;
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (intValue / 100);
    this.innerRadius = this.radius * 0.8;
    this.endAngle = this.startAngle + (intMaxAngle * intValue) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.ChartFonts.graphicFillColor(groupindex);
    let strBgStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let strBgStrokeStyleClass = this.getBgFillDetails(groupindex, "clsSecondaryStroke", this.data.layout.backgroundColor, "stroke"); //this.ChartFonts.graphicFillColor(groupindex);

    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "micropie " + strStyleClass,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
        viewBox: 0 + " " + 0 + " " + assetSize + " " + assetSize,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-type": "CHARTITEM",
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    subelement.appendChild(svgElement);

    let svgBgDonghnutPath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
        id: "svgBgDonghnutPath-" + groupindex + "_" + index,
        class: this.ChartUtils.moodClassName + " " + strBgStyleClass + " " + strBgStrokeStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 1 1 " +
            (this.pntStart.x - 0.001) +
            "," +
            this.pntStart.y +
            "L" +
            (this.pntInnerStart.x - 0.001) +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            " 0 1 0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "data-animation": "itembackground",
    });
    svgElement.appendChild(svgBgDonghnutPath);
    if (this.data.layout.backgroundColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
            fill: "",
            stroke: "",
        });
        this.addGradient(svgBgDonghnutPath, svgElement);
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray,
        mask: "url(#mask" + groupindex + ")",
    });
    svgElement.appendChild(svgPathTo);
    if (this.data.layout.itemColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to ",
        });
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }

    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + groupindex + "_" + index,
        class: "path_from",
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "L" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": 0,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
    if (this.data.layout.itemColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgPathFrom, {
            fill: "",
            stroke: "",
        });
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathFrom, svgElement);
    }
};

SimpleShapeComparisonSeriesItem.prototype.doFillComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let svgFilterElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgFilterElement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        //filter: "url(#dropshadow)"
    });
    subelement.appendChild(svgFilterElement);

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "svgElement-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
    });
    svgFilterElement.appendChild(svgElement);

    let svgIcon = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgIcon, {
        class: "bgsvg moodanimation",
        "data-animation": "itembackground",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        fill: "#efefef",
        "xlink:href": "#" + this.data.asset.data[0].id,
    });
    svgElement.appendChild(svgIcon);
    let baseSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSVG, {
        id: "baseSVG-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        mask: "url(#maskicon" + this.groupindex + ")",
    });
    svgElement.appendChild(baseSVG);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        id: "maskicon" + this.groupindex,
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    let svgAsset;
    if (!this.data.layout.boolitemShape) {
        svgAsset = this.data.asset.data[0].data.cloneNode(true);
        svgMask.appendChild(svgAsset);
    } else {
        this.data.SVGUtils.assignAttributes(svgIcon, {
            "xlink:href": "#assetelement",
        });
        this.createGraphicShape(svgElement, svgMask, assetSize);
    }
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.rectHeight = (assetSize * intValue) / 100;
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + groupindex + "_" + index,
        class: "graphic-container",
        x: "0%",
        y: assetSize - this.rectHeight + "px",
        width: "100%",
        height: this.rectHeight + "px",
    });
    baseSVG.appendChild(graphicContainerSVG);
    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + groupindex + "_" + index,
        class: "transformOrginBottom moodanimation " + strStyleClass,
        "data-type": "CHARTITEM",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-animation": "item",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
};
SimpleShapeComparisonSeriesItem.prototype.createGraphicShape = function (argParent, maskelement, assetsize) {
    if (!this.data.layout.boolitemShape) {
        let svgAsset = this.data.asset.data[0].data.cloneNode(true);
        maskelement.appendChild(svgAsset);
    } else {
        let maskShape = "";
        if (this.data.layout.itemShapeType == "circle") {
            maskShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(maskShape, {
                cx: assetsize / 2,
                cy: assetsize / 2,
                r: assetsize / 2,
            });
            if (this.data.layout.itemStyle == "border") {
                this.data.SVGUtils.assignAttributes(maskShape, {
                    r: assetsize / 2 - 5,
                });
            }
        } else {
            if (this.data.layout.itemShapeType == "square") {
                maskShape = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(maskShape, {
                    x: 0,
                    y: 0,
                    width: assetsize,
                    height: assetsize,
                });
                if (this.data.layout.itemStyle == "border") {
                    this.data.SVGUtils.assignAttributes(maskShape, {
                        x: 2.5,
                        y: 2.5,
                        width: assetsize - 5,
                        height: assetsize - 5,
                    });
                }
            }
        }
        this.data.SVGUtils.assignAttributes(maskShape, {
            id: "assetelement",
        });
        this.itemShapebgProperties(maskShape, this.groupindex, this.groupindex);
        let duplicateElement = maskShape.cloneNode(true);
        if (this.data.layout.itemShapeType == "circle") {
            if (this.data.layout.itemStyle == "border") {
                this.data.SVGUtils.assignAttributes(duplicateElement, {
                    r: assetsize / 2 - 7,
                });
            }
        } else {
            if (this.data.layout.itemShapeType == "square") {
                if (this.data.layout.itemStyle == "border") {
                    this.data.SVGUtils.assignAttributes(duplicateElement, {
                        x: 3.5,
                        y: 3.5,
                        width: assetsize - 7,
                        height: assetsize - 7,
                    });
                }
            }
        }
        maskelement.parentNode.appendChild(maskShape);
        maskelement.appendChild(duplicateElement);
    }
};
SimpleShapeComparisonSeriesItem.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex) {
    if (this.data.layout.itemStyle == "border") {
        let borderSize = this.data.layout.itemBorderSize ? this.data.layout.itemBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.itemBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsSecondaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
            }
        } else {
            element.classList.add("clsSecondaryStroke");
        }
    }
    if (this.data.layout.itemBgColor) {
        if (this.data.layout.itemBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsSecondaryFill");
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                }
            } else {
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.itemBgColor == "secondary") {
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                } else {
                    element.classList.add("clsSecondaryFill");
                }
            }
        }
    }
};

SimpleShapeComparisonSeriesItem.prototype.positionValueOnArc = function (assetsize, outerRadius, innerRadius, value, totalValue, tempStartAngle = 0) {
    let startAngle = tempStartAngle > 0 ? tempStartAngle : 270; // Start from top
    let maxAngle = 360;
    let endAngle = startAngle + (maxAngle / totalValue) * parseFloat(value);

    // FIXED: Correct radius calculation
    let midRadius = innerRadius + (outerRadius - innerRadius) / 2;
    let diffAngle = endAngle - startAngle;
    // This part was correct
    let midAngle = startAngle + (endAngle - startAngle) / 2;

    let pntCenter = { x: 0, y: 0 };
    let pntMid = { x: 0, y: 0 };
    pntCenter.x = assetsize * 0.5;
    pntCenter.y = assetsize * 0.5;
    pntMid.radius = outerRadius;
    pntMid.x = Math.round(pntCenter.x + midRadius * Math.cos((Math.PI * midAngle) / 180));
    pntMid.y = Math.round(pntCenter.y + midRadius * Math.sin((Math.PI * midAngle) / 180));
    pntMid["diffangle"] = diffAngle;
    this.pntMidPoints.push(pntMid);
    return endAngle;
};

function SimpleBarComparisonModelChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleBarComparisonModelChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleBarComparisonModelChart.prototype = Object.create(BaseBarChart.prototype);
SimpleBarComparisonModelChart.prototype.constructor = SimpleBarComparisonModelChart;

SimpleBarComparisonModelChart.prototype.seriesInstance = function (argparent, argprops) {
    return new SimpleBarComparisonModelSeries(argparent, argprops);
};
SimpleBarComparisonModelChart.prototype.calculateMaxHeight = function (subelement) {
    let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : 0;
    let paddingTop = window.getComputedStyle(subelement)["padding-top"] ? parseFloat(window.getComputedStyle(subelement)["padding-top"]) : 0;
    let paddingBottom = window.getComputedStyle(subelement)["padding-bottom"] ? parseFloat(window.getComputedStyle(subelement)["padding-bottom"]) : 0;
    let totalHeight = lineHeight * 3 + paddingTop + paddingBottom;
    subelement.style.maxHeight = totalHeight + "px";
    subelement.style.overflow = "hidden";
    if (totalHeight < subelement.clientHeight) {
        subelement.style.height = totalHeight + "px";
    }
};

SimpleBarComparisonModelChart.prototype.doAddGridValues = function () {
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        gridvalueSize = 30;
        this.rectBaseSeries.height -= gridvalueSize;
    }
};

SimpleBarComparisonModelChart.prototype.doAddGraphicDesk = function () {
    const pading = 8;
    if (this.data.baseProperties.grid && !this.data._customProperties.showYAxisGrid) this.rectBaseSeries.height -= 20;
    this.rectBaseSeries.width += 10;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";
    let dummeyrectBaseSeriesHeight = this.rectBaseSeries.height;
    let numGraphicArea = 0;
    let DifferenceValue = 0;

    this.rectSeries.height = this.rectBaseSeries.height / this.length;
    this.rectSeries.width = this.rectBaseSeries.width;

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    element.style.height = seriesHeight;
    element.style.width = seriesWidth;
    element.style.maxHeight = seriesHeight;
    element.style.position = "absolute";
    element.style.left = Math.round(this.rectBaseSeries.x / this.props.gridsize) * this.props.gridsize + "px";
    element.style.width = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize) * this.props.gridsize + "px";
    element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
    element.style.height = this.rectBaseSeries.height + "px";
    this.parent.appendChild(element);

    const containerElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";
    containerElement.style.width = element.clientWidth + "px";
    containerElement.style.height = element.clientHeight + "px";
    containerElement.style.position = "absolute";
    containerElement.style.display = "flex";
    containerElement.style.flexDirection = "column";
    // containerElement.style.top = this.rectLegendBaseSeries.x + "px";
    if (this.data.layout.labelHPosition != "center" && !this.data.layout.labelInset) {
        containerElement.style.alignItems = "flex-end";
    }
    if (this.legendposition != "bottom") {
        containerElement.style.alignItems = "center";
    }
    element.appendChild(containerElement);
    if ((this.data.chartName.includes("comparisonModel") || this.data.chartName.includes("comparisonmodel")) && this.data.layout.labelHPosition != "center" && !this.data.layout.labelInset) {
        this.computeLongLabel(containerElement);
    }
    this.doAddLegendDesk(containerElement);
    let compareTitleBounds = this.doCreateTitleNode(containerElement);
    this.legendHeight = containerElement.children[0] ? containerElement.children[0].clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    const subElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    if (this.data.compareDivider) subElement.className = "basecontainer";
    containerElement.appendChild(subElement);
    let paddingBounds = this.getPaddingBounds(subElement);
    let legendBounds = this.computLegendSize(containerElement);
    if (this.legendposition == "right" || this.legendposition == "left") {
        this.legendWidth = containerElement.children[0].clientWidth;
    }
    subElement.style.width = containerElement.children[0] && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - containerElement.children[0].clientWidth + "px" : element.clientWidth + "px";
    subElement.style.height = this.rectBaseSeries.height - legendBounds.height - compareTitleBounds.height + "px";
    dummeyrectBaseSeriesHeight -= legendBounds.height;
    dummeyrectBaseSeriesHeight -= compareTitleBounds.height;
    dummeyrectBaseSeriesHeight -= paddingBounds.ver;
    let numIndualHeight = "";
    let numIndualSizeHeight = "";
    let numIndualGapHeight = "";
    let numTotalHeight = "";
    let gridGapHeight = 0;
    if ((this.data.layout.itemSpace || this.data.layout.itemSpace == 0) && this.data.layout.itemgap != 1 && this.data.layout.itemgap) {
        numIndualHeight = dummeyrectBaseSeriesHeight / this.length;
        numIndualSizeHeight = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : numIndualHeight * this.data.layout.itemgap) : 0;
        numIndualGapHeight = this.data.layout.itemSpace ? (this.data.layout.itemSpace > 2 ? this.data.layout.itemSpace : numIndualHeight * this.data.layout.itemSpace) : 0;
        numTotalHeight = numIndualGapHeight * (this.length - 1) + numIndualSizeHeight * this.length;
        if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            gridGapHeight = numIndualGapHeight * 2;
        }
        if (numTotalHeight + gridGapHeight > dummeyrectBaseSeriesHeight) {
            // let differnceValue = numTotalHeight-dummeyrectBaseSeriesHeight;
            // let percentageForSize=(differnceValue*0.6)/this.length;
            // let percentageForGap=differnceValue*0.4;
            let sizePercentage = dummeyrectBaseSeriesHeight / numTotalHeight;
            numTotalHeight = dummeyrectBaseSeriesHeight;
            // numGraphicArea = (this.data.layout.itemgap-percentageForSize);
            numGraphicArea = numIndualSizeHeight * sizePercentage;
        } else {
            if (this.data.layout.itemgap > 2) {
                numGraphicArea = this.data.layout.itemgap;
            } else {
                numGraphicArea = numIndualHeight * this.data.layout.itemgap;
            }
        }
    }

    this.rectSeries.height = numGraphicArea != 0 ? numGraphicArea : dummeyrectBaseSeriesHeight / this.length;
    // subElement.style.top = this.rectLegendBaseSeries.x + "px";
    subElement.style.display = "flex";
    subElement.style.flexDirection = "column";
    containerElement.appendChild(subElement);
    this.doAddGraphicElement(subElement);
    if (containerElement.children.length > 1 && this.data.layout.itemgap != 1 && this.data.layout.itemgap) {
        containerElement.style.justifyContent = "center";
        subElement.style.height = numTotalHeight - gridGapHeight + paddingBounds.ver + "px";
        containerElement.style.alignItems = "center";
        containerElement.dataset.gridHeight = numTotalHeight;
        this.ParentElementPosition(element, this.data.layout.parentvPosition);
    } else {
        if (this.data.layout.itemgap != 1 && this.data.layout.itemgap) {
            containerElement.style.height = numTotalHeight + paddingBounds.ver + "px";
            containerElement.style.justifyContent = "center";
            containerElement.children[0].style.height = numTotalHeight - gridGapHeight + paddingBounds.ver + "px";
            this.ParentElementPosition(element, this.data.layout.parentvPosition);
        }
    }
};
SimpleBarComparisonModelChart.prototype.getPaddingBounds = function (containerElement) {
    let style = window.getComputedStyle(containerElement);
    let paddingleft = style["padding-left"] ? parseInt(style["padding-left"]) : 0;
    let paddingRight = style["padding-right"] ? parseInt(style["padding-right"]) : 0;
    let paddingTop = style["padding-top"] ? parseInt(style["padding-top"]) : 0;
    let paddingBottom = style["padding-bottom"] ? parseInt(style["padding-bottom"]) : 0;
    let horPadding = paddingleft + paddingRight;
    let verPadding = paddingTop + paddingBottom;
    return { hor: horPadding, ver: verPadding };
};
SimpleBarComparisonModelChart.prototype.doAddGridDesk = function () {
    let eParent = this.parent;
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let eBaseSeries = eParent.getElementsByClassName("baseseriesitem");
    let seriesElement = eParent.getElementsByClassName("series");
    let baseelement = seriesElement ? seriesElement[0].parentNode : eBaseSeries[0];
    let negseries = eParent.getElementsByClassName("leftseriesitem");
    let rightGraphic = eBaseSeries[0].getElementsByClassName("basegraphic");
    let eLabel = eParent.getElementsByClassName("label");
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth - 20), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    let baseBounds = negseries[0] ? { width: parseInt(eBaseSeries[0].clientWidth - 10), height: parseInt(eBaseSeries[0].clientHeight) } : { width: 0, height: 0 };
    let labelBounds = eLabel[0] ? { width: parseInt(eLabel[0].clientWidth), height: parseInt(eLabel[0].clientHeight) } : { width: 0, height: 0 };
    if (this.data.chartName == "comparisonModelType3") {
        baseBounds = rightGraphic[0] ? { width: parseInt(rightGraphic[0].clientWidth), height: parseInt(rightGraphic[0].clientHeight) } : { width: 0, height: 0 };
    }
    let element = document.createElement("div");
    element.className = "grid";
    element.style.position = "absolute";
    element.style.left = Math.round(this.rectBaseSeries.x / this.props.gridsize) * this.props.gridsize + "px";
    element.style.width = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize) * this.props.gridsize + "px";
    element.style.top = Math.round(this.rectBaseSeries.y / this.props.gridsize) * this.props.gridsize + "px";
    element.style.height = Math.round((this.state.height - (this.rectBaseSeries.y + baseelement.clientHeight)) / -this.props.gridsize) * this.props.gridsize + "px";
    eParent.appendChild(element);

    ////////////
    // if (this.data.chartName = "comparisonModelType3") {
    let elementRect = document.createElement("div");
    elementRect.style.width = baseBounds.width + 10 + "px";
    elementRect.style.height = this.rectBaseSeries.y + baseelement.clientHeight + gridvalueSize + "px";
    elementRect.style.display = "flex";
    elementRect.style.position = "absolute";
    elementRect.style.flexDirection = "row-reverse";
    element.appendChild(elementRect);

    let elementConatiner = document.createElement("div");
    elementConatiner.style.width = baseBounds.width + "px";
    elementConatiner.style.height = this.rectBaseSeries.y + baseelement.clientHeight + gridvalueSize + "px";
    elementRect.appendChild(elementConatiner);
    let rectSeries = {
        x: 0,
        y: 0,
        width: this.data.chartName == "comparisonModelType2" ? elementConatiner.clientWidth + 5 - negBounds.width : elementConatiner.clientWidth - negBounds.width - 10,
        height: elementConatiner.clientHeight,
        top: elementConatiner.offsetTop,
        left: elementConatiner.offsetLeft + baseBounds.width - 10,
    };
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        disablemargin: true,
        gridvalueSize: { width: 0, height: gridvalueSize },
        type: "horizontal",
        reverse: true,
        viewport: { y: this.state.y, x: this.state.x, height: baseelement.clientHeight, width: this.state.width },
    };
    this.addGridDeskElement(elementConatiner, eProps);
    // }
    ///////////////////////////////
    let elementRect1 = document.createElement("div");
    elementRect1.style.width = "100%";
    elementRect1.style.height = this.rectBaseSeries.y + baseelement.clientHeight + gridvalueSize + "px";
    elementRect1.style.display = "flex";
    elementRect1.style.position = "absolute";
    elementRect1.style.flexDirection = "row-reverse";
    element.appendChild(elementRect1);

    let elementConatiner1 = document.createElement("div");
    elementConatiner1.style.width = baseBounds.width + "px";
    elementConatiner1.style.marginRight = 10 + "px";
    elementConatiner1.style.height = this.rectBaseSeries.y + baseelement.clientHeight + gridvalueSize + "px";
    elementRect1.appendChild(elementConatiner1);

    let rectSeries1 = {
        x: 0,
        y: 0,
        width: elementConatiner1.clientWidth - negBounds.width,
        height: elementConatiner1.clientHeight,
        top: elementConatiner1.offsetTop,
        left: elementConatiner1.offsetLeft,
    };
    this.voData._customProperties.showYAxisLine = false;
    let eProps1 = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries1,
        gridvalueSize: { width: 0, height: gridvalueSize },
        type: "horizontal",
        viewport: { y: this.state.y, x: this.state.x, height: baseelement.clientHeight, width: this.state.width },
    };
    this.addGridDeskElement(elementConatiner1, eProps1);
};

SimpleBarComparisonModelChart.prototype.addGridDeskElement = function (argParent, argProps) {
    if (this.data.baseProperties.grid) {
        let grid = new window["Grid"](argParent, argProps);
        grid.data = this.data;
        grid.rectSeries = argProps.rectSeries;
        grid.move(0, 0);
        grid.size(argProps.rectSeries.width, argProps.rectSeries.height);
    }
    return null;
};

SimpleBarComparisonModelChart.prototype.doAddLegendDesk = function (argParent) {
    if ((this.voData.seriesItemLength > 1 && this.data.baseProperties.maxAllowedSeriesItems > 1) || this.data.chartName.includes("comparisonModel")) {
        const element = this.ChartHelper.createDivElement();
        element.className = "legend";
        this.rectBaseLegend.width = this.rectBaseLegend.width - this.maxLabelW;
        element.style.maxWidth = this.rectBaseLegend.width + "px";
        element.style.minWidth = "121px";
        element.style.maxHeight = this.rectBaseLegend.height + "px";
        if (this.legendposition == "bottom") {
            element.style.width = this.rectBaseLegend.width + "px";
        }
        if (this.data.layout.legendWidth && (this.legendposition == "left" || this.legendposition == "right")) {
            element.style.maxWidth = this.data.layout.legendWidth;
            element.style.width = this.data.layout.legendWidth;
        }
        if (this.legendposition == "bottom" || this.legendposition == "right") element.style.order = 1;
        argParent.appendChild(element);
        let eProps = { maxsize: this.rectBaseLegend, legendlabel: true };
        this.addLegendDeskElements(element, eProps);
    }
};
SimpleBarComparisonModelChart.prototype.doCreateTitleNode = function (argParent) {
    if (!this.data.compareDivider) return { height: 0 };
    this.createBg(argParent);
    const element = this.ChartHelper.createDivElement();
    element.className = "compareheader";
    // this.rectBaseLegend.width = this.rectBaseLegend.width
    element.style.width = "100%";
    element.style.height = "auto";
    argParent.appendChild(element);

    if (this.data.comparePlaceholder) {
        let palceholderSeries = this.ChartHelper.createDivElement();
        palceholderSeries.className = "placeholderseries";
        palceholderSeries.style.paddingBottom = "20px";
        element.appendChild(palceholderSeries);
        for (let i1 = 0; i1 < 2; i1++) {
            let seriesElement = this.ChartHelper.createDivElement();
            seriesElement.className = "placeholderserieselement";
            palceholderSeries.appendChild(seriesElement);
            let argProprs = {
                index: i1,
                placeholdertype: this.data.primaryPlaceholderType[i1] ? this.data.primaryPlaceholderType[i1] : "logo",
            };
            seriesElement.style.justifyContent = "center";
            this.doAddPrimaryPlaceholder(seriesElement, argProprs);
        }
    }
    let titleSeries = this.ChartHelper.createDivElement();
    titleSeries.className = "placeholdertitle p6";
    element.appendChild(titleSeries);
    for (let i1 = 0; i1 < 2; i1++) {
        let titleSeriesElement = this.ChartHelper.createDivElement();
        titleSeriesElement.className = this.data.fontClassName ? "titleserieselement  accent" + (i1 + 1) + " clsMultiColorParent " + this.data.fontClassName : "titleserieselement  accent" + (i1 + 1) + " clsMultiColorParent " + this.ChartFonts.dynamiclabelThemeClassName(0);
        titleSeriesElement.classList.add("th-section" + (i1 + 1));

        titleSeriesElement.style.justifyContent = "center";
        titleSeriesElement.style.textAlign = "center";
        titleSeries.appendChild(titleSeriesElement);
        let ColorValue = "clscomparevaluealtercolor";
        let textNode = this.ChartHelper.createDivElement();
        textNode.className = this.data.fontClassName ? "comparetitlenode moodanimation " + this.data.titleClassName + " " + ColorValue : "comparetitlenode moodanimation " + this.ChartFonts.titleClassName + " " + ColorValue;
        textNode.setAttribute("contenteditable", "true");
        textNode.setAttribute("data-dck-selector", "true");

        textNode.setAttribute("data-id", i1);
        textNode.setAttribute("id", "comparetitle" + i1 + "_0");
        textNode.setAttribute("data-prompt-text", "Enter Title");
        textNode.setAttribute("data-animation", "comparetitle");
        textNode.setAttribute("data-type", "comparelabelheader");
        if (this.data.compareTitleLineHeight[i1]) {
            textNode.style.lineHeight = this.data.compareTitleLineHeight[i1];
        }
        if (this.data.compareTitleLetterSpace[i1]) {
            textNode.style.letterSpacing = this.data.compareTitleLetterSpace[i1] + "em";
        }
        textNode.innerHTML = this.data.compareTitleData[i1];
        this.ChartHelper.setTextChangeListner(textNode);
        titleSeriesElement.appendChild(textNode);
        this.calculateMaxHeight(titleSeriesElement);
    }

    return { height: element.clientHeight };
};
SimpleBarComparisonModelChart.prototype.createBg = function (argParent) {
    let bgParentNode = this.ChartHelper.createDivElement();
    bgParentNode.className = "bgparentnode";
    argParent.appendChild(bgParentNode);
    let customColorIndex = this.ChartFonts.customColor(1);
    let bgelement1 = this.ChartHelper.createDivElement();
    bgelement1.className = "bgelement1 accent1 clsMultiColorParent moodanimation";
    bgelement1.classList.add("th-section" + customColorIndex);
    bgelement1.setAttribute("data-animation", "bgelement");
    let bgChild1 = this.ChartHelper.createDivElement();
    bgChild1.className = "bgchild cf-background-color-section-primary";
    // bgChild1.style.backgroundColor = "rgba(var(--th-slide-contrast),1)"
    bgelement1.appendChild(bgChild1);
    bgParentNode.appendChild(bgelement1);
    let bgelement2 = this.ChartHelper.createDivElement();
    bgelement2.classList.add("th-section" + 1);
    bgelement2.className = "bgelement2 accent6 clsMultiColorParent moodanimation";
    bgelement2.setAttribute("data-animation", "bgelement");
    bgParentNode.appendChild(bgelement2);
    let bgChild2 = this.ChartHelper.createDivElement();
    bgChild2.className = "bgchild cf-background-color-section-primary";
    bgelement2.appendChild(bgChild2);
};
SimpleBarComparisonModelChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    if (this.data.baseProperties.legend && this.data.showLegend) {
        let legend = new window["Legend"](argParent, argProps, true);
        legend.move(0, 0);
        legend.ChartHelper = this.ChartHelper;
        legend.ChartUtils = this.ChartUtils;
        legend.size(this.rectBaseLegend.width, this.rectBaseLegend.height);
        legend.data = this.data;
    }
    //this.doMeasurementComputation(argParent);
    return null;
};

SimpleBarComparisonModelChart.prototype.doAddMetaData = function () {
    const element = this.data.SVGUtils.createSVGElement("metadata");
    this.data.SVGUtils.assignAttributes(element, {
        slideID: this.data.slideID,
        maxvalue: this.data.maxValue,
        class: "metadata_group_chart",
        length: this.data.seriesLength,
        sublength: this.data.seriesItemLength == 1 ? 2 : this.data.seriesItemLength,
        viewportwidth: this.state.width,
        viewportheight: this.state.height,
        conflictLayoutList: this.data.conflictLayout,
        emphasis: this.data.baseProperties.hasEmphasis,
        isdivChart: this.data.baseProperties.isDivChart,
        minseries: this.data.baseProperties.minAllowedSeries,
        negativechart: this.data.baseProperties.isNegativeChart,
        projection: this.data.baseProperties.hasProjectionEnable,
        percentagechart: this.data.baseProperties.isPercentageChart,
        minseriesitem: this.data.baseProperties.minAllowedSeriesItems,
        graphicimage: this.data.baseProperties.hasGraphicImage && this.data.seriesItemLength == 1,
        maxseries: this.data.baseProperties.maxAllowedSeries,
        maxseriesitem: this.data.baseProperties.maxAllowedSeriesItems,
    });
    this.parent.appendChild(element);
};
SimpleBarComparisonModelChart.prototype.doAddPrimaryPlaceholder = function (argparent, argprops) {
    const index = argprops.index;
    const bounds = this.getPlaceholderBounds();
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.marginLeft = this.data.layout.placeholderPaddingleft + "px";
    baseelement.style.marginRight = this.data.layout.placeholderPaddingright + "px";
    baseelement.style.marginTop = this.data.layout.placeholderPaddingtop + "px";
    baseelement.style.marginBottom = this.data.layout.placeholderPaddingbottom + "px";
    if (this.data.chartFlip) {
        baseelement.style.marginLeft = this.data.layout.placeholderPaddingright + "px";
        baseelement.style.marginRight = this.data.layout.placeholderPaddingleft + "px";
        if (this.data.layout.placeholderAlterPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
        }
    } else {
        if (this.data.layout.placeholderPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderPaddingClass);
        }
    }

    baseelement.style.position = "relative";
    // baseelement.className =this.data.layout.placholderGlopalStyle;
    // baseelement.style.overflow = "hidden";
    // baseelement.classList.add("chartclsContentNode");
    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");
    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");
    if (argparent) argparent.appendChild(baseelement);

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);

    const element = this.ChartHelper.createDivElement({});
    element.id = "primaryplaceholder-" + index;
    element.className = "primaryplaceholder topprimaryplaceholder";
    element.dataset.assettype = "compareasset";
    element.style.position = "relative";
    element.style.zIndex = "1";
    element.style.height = this.data.layout.placholderHeight && this.data.layout.placholderHeight < bounds.height ? this.data.layout.placholderHeight * this.data.placeholderSizeRatio + "px" : bounds.height * this.data.placeholderSizeRatio + "px";
    element.style.minWidth = this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    element.style.width = this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    baseelement.appendChild(element);
    let type = argprops.placeholdertype ? argprops.placeholdertype.toLowerCase() : "";
    let logoBounds = this.getLogoBounds();
    if (type == "logo" && logoBounds) {
        element.style.height = this.data.layout.placholderHeight && this.data.layout.placholderHeight < logoBounds.height ? this.data.layout.placholderHeight * this.data.placeholderSizeRatio + "px" : logoBounds.height * this.data.placeholderSizeRatio + "px";
        element.style.minWidth = this.data.layout.placholderWidth && this.data.layout.placholderWidth < logoBounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : logoBounds.width * this.data.placeholderSizeRatio + "px";
        element.style.width = this.data.layout.placholderWidth && this.data.layout.placholderWidth < logoBounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : logoBounds.width * this.data.placeholderSizeRatio + "px";
    }
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            element.classList.add("accent" + (index + 1));
            element.classList.add("clsMultiColorParent");
            element.classList.add("th-section-contract");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            this.setBorderWidth(baseelement);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddLogoUseNodeElement(element, argprops);
            this.setImageBorderWidth(baseelement);
            break;
        case "logo":
            if (this.data.layout.arrplacholderGlopalStyle.length > 2) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[2]);
            this.doAddLogoUseNodeElement(element, argprops, "logo");
            break;
    }
};
SimpleBarComparisonModelChart.prototype.setBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--cutomNodeBorderWidthPercent");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".iconHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
};
SimpleBarComparisonModelChart.prototype.setImageBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--customNodeBorderImageWidth");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".imageHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderImageWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
};
SimpleBarComparisonModelChart.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    let SVGUtils = new window["SVGUtils"]();
    const element = SVGUtils.createSVGElement("svg");
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon",
        "data-nodetype": "iconNode",
        id: "primaryplaceholdergraphic-" + argprops.index + "_0",
        "data-type": "ICON",
        "data-assettype": "compareasset",
        width: "100%",
        height: "100%",
    });
    argparent.style.display = "flex";
    argparent.style.alignItems = "center";
    if (this.index == 0) {
        argparent.style.justifyContent = "flex-end";
    } else {
        argparent.style.justifyContent = "flex-start";
    }

    let fillClass = this.ChartFonts.graphicFillColor(this.index);
    if (this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") {
        fillClass = "clsAlterTertiaryColor";
    } else {
        if (
            (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
            (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
        ) {
            fillClass = "clsSecondaryFill";
        }
    }
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ci-element-icon " + fillClass,
    });
    const subelement = SVGUtils.createSVGElement("use");
    SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + argprops.index + "_0",
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-id": +argprops.index + "_0",
        "data-type": "ICON",
        "data-name": this.data.comparePlaceholderPath[argprops.index],
        "xlink:href": "#" + this.data.comparePlaceholderPath[argprops.index],
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};
SimpleBarComparisonModelChart.prototype.doAddLogoUseNodeElement = function (element, argprops, type = "image") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);
    let alignment = "center";
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.position = "absolute";
    subelement.style.margin = "auto";
    subelement.style.left = "0";
    subelement.style.right = "0";
    subelement.id = "primaryplaceholdergraphic-" + argprops.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode clsMoodImageStyle";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-assettype", "compareasset");
    subelement.setAttribute("data-id", argprops.index);
    subelement.setAttribute("data-type", "IMAGE");
    subelement.setAttribute("data-imagecropalignment", alignment);
    subelement.setAttribute("data-nodetype", "imageNode");
    element.appendChild(subelement);

    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[argprops.index]);
        if (this.data.logoContrast[argprops.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
        CommonImageUtils.updateImageBounds(subelement, "logo");
    }
    subelement.src = this.data.comparePlaceholderPath[argprops.index];
    if (type != "logo") {
        let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
        element.setAttribute("data-x", item.x);
        element.setAttribute("data-y", item.y);
        element.setAttribute("data-width", element.clientWidth);
        element.setAttribute("data-height", element.clientHeight);
        subelement.setAttribute("data-width", element.clientWidth);
        subelement.setAttribute("data-height", element.clientHeight);
        subelement.setAttribute("data-x", item.x);
        subelement.setAttribute("data-y", item.y);
    }
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    if (type != "logo") this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type);
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
};
SimpleBarComparisonModelChart.prototype.getPlaceholderBounds = function (props) {
    let dummeyWidth = this.state.width * 0.3 > 120 ? 120 : this.state.width * 0.3;
    return { width: dummeyWidth, height: dummeyWidth };
};
SimpleBarComparisonModelChart.prototype.getLogoBounds = function (props) {
    let Height = 100;
    let Width = 260;
    return { width: Width, height: Height };
};

function SimpleBarComparisonModelSeries(argparent, argprops) {
    this.name = "SimpleBarComparisonModelSeries";
    BaseBarSeries.call(this, argparent, argprops);
}
SimpleBarComparisonModelSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleBarComparisonModelSeries.prototype.constructor = SimpleBarComparisonModelSeries;

SimpleBarComparisonModelSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleBarComparisonModelSeriesItem"](argparent, argprops);
};

SimpleBarComparisonModelSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveY = this.viewport.y;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    let element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series overflow";
    element.style.height = this.state.height + "px";
    element.style.maxWidth = "100%";
    element.style.maxHeight = this.state.height + "px";
    element.setAttribute("data-width", this.state.width);
    element.setAttribute("data-height", this.state.height);
    if (this.labelAlignment.vposition == "top") {
        element.style.flexDirection = "column";
        element.style.justifyContent = "center";
    }
    if (this.labelAlignment.hposition == "center" || this.data.chartName == "comparisonModelType3" || this.data.chartName == "barcomparisonmodel") {
        let customColorIndex = this.ChartFonts.customColor(this.index);
        element.className = "series overflow accent" + customColorIndex + " clsMultiColorParent";
        element.classList.add("th-section" + customColorIndex);
    }

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    if (this.parent) {
        this.parent.appendChild(element);
        this.parent.style.position = "relative";
    }

    if ((!this.labelAlignment.inset || this.labelAlignment.inset == "outer") && this.labelAlignment.index == "0" && this.labelAlignment.hposition != "right" && this.labelAlignment.hposition != "center") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }
    if (!this.labelAlignment.inset && this.labelAlignment.index == "1" && this.labelAlignment.hposition != "right" && this.labelAlignment.hposition != "center") this.doAddLabel(element, argprops);

    let subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond overflow";
    subelement.style.alignItems = "center";
    subelement.style.height = this.data._customProperties.showMergeItems ? "100%" : this.labelAlignment.vposition == "top" ? this.state.height * 0.6 + "px" : "100%";
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2" || this.data.chartName == "comparisonModelType3") subelement.style.display = "flex";

    if (element) element.appendChild(subelement);
    let length = this.data.chartName == "comparisonModelType3" ? this.length : 2;
    for (let i1 = 0; i1 < length; i1++) {
        let eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        let seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(this.rectSeriesItem.x, moveY);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveY += this.rectSeriesItem.height;
    }
};

// let objValue;
// let graphicW;
// let overlapStackedBar = false;
// let dropShadowHeight = 10;
function SimpleBarComparisonModelSeriesItem(argparent, argprops) {
    this.name = "SimpleBarComparisonModelSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseBarSeriesItem.call(this, argparent, argprops);
}
SimpleBarComparisonModelSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
SimpleBarComparisonModelSeriesItem.prototype.constructor = SimpleBarComparisonModelSeries;

//this.data.chartName == "comparisonModelType3" ? this.data.values[this.index][this.groupindex] :
// this.data.chartName == "comparisonModelType3"
// ? this.data.prefix[this.index][this.groupindex] + this.data.valuesDenomination[this.index][this.groupindex] + this.data.suffix[this.index][this.groupindex]
// :

SimpleBarComparisonModelSeriesItem.prototype.doAddGraphicElement = function () {
    // let myIndex = this.data.chartName == "comparisonModelType3" ? this.valueIndex : this.groupindex;
    let currentValue = this.data.values[this.groupindex][this.index].toString().match(/\d+/)[0];
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: currentValue,
        valuetext: this.data.prefix[this.groupindex][0] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][0],
        viewport: { y: 0, x: 0, height: this.state.height, width: this.state.width },
    };
    const stackWidth = eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const element = this.ChartHelper.createDivElement({});
    let customColorIndex = this.ChartFonts.customColor(this.index);
    if (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2 && !this.data.compareDivider) {
        customColorIndex = 6;
    }
    // if(this.data.compareDivider){
    //     if(this.index==0){
    //         customColorIndex =1;
    //     }else{
    //         customColorIndex =6;
    //     }
    // }
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem accent" + customColorIndex + " clsMultiColorParent";
    element.classList.add("th-section" + customColorIndex);
    element.style.height = this.data.chartName == "barStackedRectangle" ? "100%" : 100 / this.length + "%";
    element.style.width = this.data.chartName == "barStackedRectangle" ? stackWidth * 100 + "%" : "100%";
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") {
        if (this.index == 0) element.style.paddingRight = "10px";
        else if (this.index == 1) element.style.paddingLeft = "10px";
    }
    if (this.data.values[this.groupindex][this.index] < 0) {
        element.style.flexDirection = "row-reverse";
    }
    if (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2) {
        element.style.justifyContent = "flex-end";
        this.labelAlignment.hposition = this.labelAlignment.hposition == "left" ? "right" : this.labelAlignment.hposition == "right" ? "left" : this.labelAlignment.hposition;
    }
    this.parent.appendChild(element);
    this.doAddLeftSeriesItemElement(element, eProps);
    this.doAddRightSeriesItemElement(element, eProps);
    if ((this.labelAlignment.hposition == "center" && this.index == 0 && !this.data.compareDivider) || (this.index != 0 && this.data.compareDivider)) {
        this.labelMaxH = element.clientHeight;
        if (this.data.compareDivider) {
            this.labelMaxH = this.state.height;
            this.labelMaxW = this.state.height;
        }
        this.doAddLabel(this.parent, eProps, true, "", false);
        this.doAddLabel(this.parent, eProps, "", "", false);
    }
};

SimpleBarComparisonModelSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax, boolInnerValue = false, boolenableminSize = true, disableHeight = false) {
    if (this.data.layout.showLabel) {
        const groupindex = argprops.gindex;

        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder)) {
        } else if (this.data.layout.labelColor) {
            this.labelStyle = this.getColorDetails(groupindex, this.labelStyle, this.data.layout.labelColor, "color");
        }

        let padding = this.setoverlapPadding("label");
        let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;
        let lLayoutName = this.labelAlignment.itemBased == "true" ? this.labellayoutClassName("itemlabel") : this.labellayoutClassName("label");
        let element = document.createElement("div");
        let comparisonId = this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2 ? "comparisonlabel-text-" : "label-text-";
        element.className = "label  moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(valGroupIndex) + " " + lLayoutName + " " + this.ChartFonts.labelOuterColor;
        element.id = comparisonId + valGroupIndex;
        element.style.minWidth = 10 + "px";
        if (!disableHeight) element.style.height = this.labelMaxH + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labelMaxH + "px";
        if (this.labelAlignment.hposition != "center") element.style.justifyContent = "unset";
        element.setAttribute("data-textalign", "horizantal");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        // element.style.fontSize = this.maxLabelFontSize[this.index] + "px";
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if ((argprops.value < 0 && this.labelAlignment.position == "inner") || (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2)) {
            element.style.paddingLeft = padding["right"] + "px";
            element.style.paddingRight = padding["left"] + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        if (this.data.compareDivider) {
            element.style.paddingTop = padding["right"] + "px";
            element.style.paddingBottom = padding["right"] + "px";
        }
        if (this.labelAlignment.hposition == "left") element.style.textAlign = "start";
        if (argparent) argparent.appendChild(element);
        else return element;
        if (this.labelStyle == "clsAlterTertiaryColor") {
            element.style.position = "absolute";
            element.style.zIndex = 1;
        }
        // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        //     element.style.position = "absolute";
        // }
        if (this.data.compareDivider) {
            element.style.position = "absolute";
            element.style.margin = "auto";
            element.style.left = "0";
            element.style.right = "0";
            element.classList.add("clscomparelabel");
        }
        let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        let comparisonSecondaryId = this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2 ? "comparisonlabeltext-" : "labeltext-";
        subelement.id = comparisonSecondaryId + valGroupIndex;
        subelement.innerHTML = boolMax || boolInnerValue ? this.data.longLabel : this.data.labels[valGroupIndex];
        if (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2) {
            subelement.innerHTML = boolMax || boolInnerValue ? this.data.longLabel : this.data.comparisonLabels[valGroupIndex];
        }

        if (this.data.arrLabelOpacity[groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[groupindex], "");
        if (this.data.arrLabelTextSize[groupindex]) subelement.style.setProperty("font-size", this.data.arrLabelTextSize[groupindex], "");
        if (this.data.arrLabeltexttransform[groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[groupindex], "");

        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labelMaxH + "px";
        subelement.style.overflow = "hidden";
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";

        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");

        let comparisonType = this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2 ? "comparisonlabel" : "label";
        subelement.setAttribute("data-type", comparisonType);
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", valGroupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(valGroupIndex);
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                // if (this.labelAlignment.vposition == "bottom") {
                //     element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                //     element.style.paddingBottom = "15px";
                // } else if (this.labelAlignment.vposition == "top") {
                //     element.style.paddingTop = "15px";
                //     element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                // }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        } else {
            if (this.labelAlignment.position == "inner") {
                subelement.classList.add("titleColorBg");
            } else {
                subelement.classList.add("transparentBg");
            }
        }
        if ((this.labelAlignment.position == "inner" || argprops.value > 0) && boolenableminSize) element.classList.add("minlabelsize");
        if (this.labelAlignment.hposition == "center" && boolMax) {
            element.style.position = "absolute";
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        if (this.labelAlignment.hposition == "center") {
            if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement, false);
        } else {
            if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement, true);
        }
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);

        if (boolMax) {
            this.maxLabelW = element.clientWidth;
            element.remove();
        }
        if (!boolMax && this.labelAlignment.hposition == "center" && parseInt(window.getComputedStyle(element)["min-width"]) < this.maxLabelW && !this.data.compareDivider) {
            this.labelMinHeight(this.maxLabelW);
        }
        if (boolInnerValue) {
            this.innerlabelmaxWidth = element.clientWidth;
            element.remove();
        }
        if (this.data.compareDivider) {
            element.style.maxHeight = this.labelMaxH + "px";
            element.style.maxHeight = this.labelMaxH + "px";
            element.style.minWidth = this.labelMaxH + "px";
        }
    }
};
SimpleBarComparisonModelSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // if (this.displayValue(argprops)) {
    //     if (this.valueAlignment.itemBased == "true") {
    //         this.valueStyle =
    //             this.data.hasEmphasis && this.data.emphasis[groupindex] != true
    //                 ? this.this.ChartFonts.valueOuterColor
    //                 : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
    //                 ? this.this.ChartFonts.graphicColor(groupindex)
    //                 : this.this.ChartFonts.valueOuterColor;
    //         const subValueElement = this.ChartHelper.createDivElement({});
    //         subValueElement.id = "topvalue-" + groupindex + "_" + index;
    //         subValueElement.className = "topvalue ";
    //         subValueElement.style.width = graphicWidthPercentage * 100 + "%";
    //         argparent.appendChild(subValueElement);
    //         this.doAddRightValue(subValueElement, argprops);
    //     }
    // }

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    if (this.data.layout.itemBgBorder || this.data.layout.itemBgBorder == "true") {
        element.style.border = "2px solid";
        dropShadowHeight = 0;
        element.classList.add(this.data.ChartFonts.appendgraphicBorderColor(index));
    }
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }

        element.style.alignItems = "flex-start";
    }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddRightValue(element, argprops, true);
    if (this.labelAlignment.position == "inner") {
        this.doAddLabel(element, argprops, false, true);
    }
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.labelMaxW * 0.5;
        this.middleLH = this.labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid var(--item" + (groupindex + 1) + "-color)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middleVH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation ";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid var(--item" + (groupindex + 1) + "-color)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        this.middlePH = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation ";
        middleelementPlaceholder.setAttribute("data-animation", "primaryplaceholder");
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.data.getAttribute("data-border") == "true") {
            middleelementPlaceholder.style.border = "4px solid var(--item" + (groupindex + 1) + "-color)";
            middleelementPlaceholder.style.backgroundColor = "#fff";
        } else {
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && this.data._emphasisName == "greyemphasize") {
                middleelementPlaceholder.classList.add("clsNodeSecondarybg");
            } else {
                middleelementPlaceholder.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
            }
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }

    const parentWidth = argparent.getAttribute("data-width");
    let baseGraphicWidth;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") {
        baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + this.maxLabelW + dropShadowHeight);
    } else {
        if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight);
        } else {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight);
        }
    }
    const baseGraphicWidthPercentage = baseGraphicWidth / parentWidth;
    let graphicWidthPercentage = baseGraphicWidthPercentage * (argprops.value / argprops.maxvalue);

    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        let bgCurrentStyle = this.data.layout.backgroundColor;
        if (this.data.compareDivider) {
            if (this.index != 0) bgCurrentStyle = "theme";
            if (this.index == 0) bgCurrentStyle = "theme";
        }
        let bgStyleClass = this.getBgColorDetails(index, this.ChartFonts.emphasizeColor, bgCurrentStyle, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);

        backgroundElement.className = "backgroundItem comparebg moodanimation " + bgStyleClass;
        backgroundElement.style.width = 100 + "%";
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity == 0 ? 0.5 : this.data.layout.backgroundOpacity;
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        element.style.setProperty("--custom-opacity", this.data.layout.backgroundOpacity);
        if (this.data.layout.backgroundColor == "gradient") {
            backgroundElement.style.backgroundImage = this.data.layout.backgroundGradientValues ? this.data.layout.backgroundGradientValues : "";
        }
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = baseGraphicWidthPercentage * 100 + "%";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.height = this.thicknessPercentage * 100 + "%";
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            let borderAlign = this.voData.layout.backgroundBorder.alignment;
            if (this.data.layout.backgroundborderstyle == "dashed") {
                backgroundBorderElement.classList.add("shapeborder" + borderAlign + "dashed");
            } else {
                backgroundBorderElement.classList.add("shapeborder" + borderAlign);
            }
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";

            let BgBorderColor = this.getBgColorDetails(index, this.data.ChartFonts.appendgraphicBorderColor(index), this.data.layout.backgroundBorder.color, "bordercolor");
            backgroundBorderElement.classList.add(BgBorderColor);
            backgroundBorderElement.style.boxSizing = "border-box";
            if (this.data.layout.backgroundBorder.color == "gradient") {
                backgroundBorderElement.classList.add("itemborderGrdient");
            }
        }
        if (this.data.layout.backgroundBorderRadiusClass) {
            if (this.data.chartName == "comparisonModelType2" && this.index == 0) {
                if (this.data.layout.backgroundAlterBorderRadiusClass) {
                    backgroundElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
                    if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
                } else {
                    backgroundElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
                    if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
                }
            }
            if (this.data.chartName == "comparisonModelType3" && this.groupindex <= this.data.seriesLength / 2) {
                if (this.data.layout.backgroundAlterBorderRadiusClass) {
                    backgroundElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
                    if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundAlterBorderRadiusClass);
                } else {
                    backgroundElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
                    if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
                }
            } else {
                backgroundElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
                if (backgroundBorderElement) backgroundBorderElement.classList.add(this.data.layout.backgroundBorderRadiusClass);
            }
        } else {
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
            if (backgroundBorderElement) backgroundBorderElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }

    //"graphicbg";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : graphicWidthPercentage * 100 + "%";
    subelement.style.height = 100 * this.thicknessPercentage + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = "calc(" + graphicWidthPercentage * 100 + "% - " + this.middlePH * 0.5 + "px)";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleVH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
                subelement.style.marginLeft = this.middlePH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleLH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    if (this.data.chartName == "comparisonModelType3") {
        styleIndex = groupindex < this.data.seriesLength / 2 ? index : 5;
    }
    let currentStyle = this.data.layout.itemColor;
    if (this.data.compareDivider) {
        if (this.index != 0) currentStyle = "theme";
        if (this.index == 0) currentStyle = "theme";
    }
    let strStyleClass = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), currentStyle, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    const clsStyle = strStyleClass + " moodanimation transformOrginLeft";

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.dataset.customorgin = "left";

    graphicElement.className = "chartgraphic " + clsStyle;
    if (index == 1) {
        graphicElement.classList.remove("chartgraphic");
    }
    if (index == 0 && this.data.chartName.includes("comparisonModel")) {
        graphicElement.dataset.customorgin = "right";
    }
    if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.data.seriesLength / 2) {
        graphicElement.dataset.customorgin = "left";
    }
    graphicElement.style.width = 100 + "%";
    graphicElement.style.height = "100%";
    graphicElement.dataset.animation = "item";
    if (this.data.chartName == "barStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") graphicElement.style.borderRadius = this.valueMaxH + "px";
    if (this.data.chartName == "barFillRectangle") graphicElement.style.position = "absolute";
    subelement.appendChild(graphicElement);
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");

    strStyleClass =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder ? this.setNoEmphasis(graphicElement, strStyleClass, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, strStyleClass, groupindex) : strStyleClass;

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    let colorStyle = this.data.layout.itemBoxShdowColor == "item" || this.data.layout.itemBoxShdowColor == "theme" ? clsStyle : "";
    let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
    graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;

    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "borderelement";
        borderElement.style.width = 100 + "%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);
        graphicElement.classList.remove(this.data.chartFonts.appendgraphicBgColor(groupindex));
        graphicElement.classList.remove("background-bg-color");
        graphicElement.classList.add("background-bg-color");
        if (this.voData.shapeBoderColor == "theme") {
            let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
            borderElement.classList.add();
            this.emphasisColor = " secondary-border-color";
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
                let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
                rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, 0.5);
                graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaValue;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex);
            }
            borderElement.classList.add("moodanimation");
            borderElement.dataset.animation = "itemborder";
        }

        borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
    }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        if (this.data.layout.borderRadiusClass) {
            if (this.data.chartName == "comparisonModelType2" && this.index == 0) {
                if (this.data.layout.alterBorderRadiusClass) graphicElement.classList.add(this.data.layout.alterBorderRadiusClass);
                else graphicElement.classList.add(this.data.layout.borderRadiusClass);
            }
            if (this.data.chartName == "comparisonModelType3" && this.groupindex <= this.data.seriesLength / 2) {
                if (this.data.layout.alterBorderRadiusClass) graphicElement.classList.add(this.data.layout.alterBorderRadiusClass);
                else graphicElement.classList.add(this.data.layout.borderRadiusClass);
            } else {
                graphicElement.classList.add(this.data.layout.borderRadiusClass);
            }
        } else {
            graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    if (borderElement) {
        borderElement.classList.remove("borderelement");
        borderElement.classList.add("borderelement");
    }
    if (this.displayPrimaryPlaceholder(argprops)) {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.placeholderAlignment.position == "outer" || graphicW < this.state.height * 0.6) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddRightPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            subelement.style.display = "flex";
            subelement.style.justifyContent = "flex-end";
            this.doAddRightPlaceholder(subelement, argprops);
        }
    }
    if ((this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true") && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")) {
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        subelement.appendChild(sameElement);

        if (this.labelAlignment.samepos == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.graphicWidthValue = subelement.clientWidth;
            this.doAddRightValue(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true") {
        // this.doAddLabel(element, argprops, true)
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.data.chartName.includes("comparisonModel") && this.valueAlignment.position == "inner") {
            graphicW = graphicElement.clientWidth;
            this.graphicWidthValue = graphicElement.clientWidth;
        }
        if ((this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") && this.index == 0) {
            graphicW = (graphicElement.parentNode.parentNode.clientWidth / 2) * graphicWidthPercentage;
        }

        if (this.data.chartName == "barcomparisonmodel") {
            graphicW = graphicW * 0.8;
        }
        this.doAddRightValue(element, argprops, true);
        // let boolOverlap = (graphicBaseelement.clientWidth - graphicContainerElement.clientWidth) < valueMaxW;
        let boolEnableInnerValue = (this.data.layout.itemBgBorder || this.data.layout.itemBgBorder == "true") && element.clientWidth - subelement.clientWidth < this.currentValW;
        if (
            (this.data.chartName == "comparisonModelType2" && this.index == 0 && graphicW * 0.5 < this.currentValW) ||
            (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && !boolEnableInnerValue) ||
            graphicW < this.currentValW ||
            (this.data.chartName == "comparisonModelType2" && graphicW * 0.8 < this.currentValW) ||
            (this.data.chartName == "barcomparisonmodel" && subelement.clientWidth * 0.8 < this.currentValW)
        ) {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.data._emphasisName == "greyemphasize"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                    ? this.ChartFonts.graphicColor(groupindex)
                    : this.ChartFonts.valueOuterColor;
            if (this.data.compareDivider) {
                this.valueStyle = " clscomparevaluealtercolor";
            }
            let boolOrder = graphicW < this.innerlabelmaxWidth && this.labelAlignment.position == "inner" && this.valueAlignment.itemBased != "true" ? true : false;
            if (this.data.chartName == "barStackedRectangle") {
                overlapStackedBar = true;
                this.removeValueElement();
            }
            if (this.data.chartName == "barcomparisonmodel") {
                this.overlapnode = true;
            }
            graphicW = Math.round(subelement.clientWidth) - (this.currentValW + this.data.layout.valuePaddingleft);
            if (this.labelAlignment.itemBased == "true") this.doAddRightValue(subelement, argprops);
            else this.doAddRightValue(element, argprops, false, boolOrder);
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") || boolEnableInnerValue) {
            let vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            if ((!this.data.chartName.includes("comparisonModelType3") && this.data.chartName.includes("comparisonModel") && index == 1) || (this.data.chartName.includes("comparisonModelType3") && this.groupindex >= this.data.seriesLength / 2)) {
                vLayoutName = this.valuelayoutClassName("containervalue", true);
                valueElement.className = "valueelement " + vLayoutName;
            }
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (this.data.layout.valueColor) {
                this.valueStyle = this.getColorDetails(groupindex, this.valueStyle, this.data.layout.valueColor, "color");
            }
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            if (this.data.compareDivider) {
                this.valueStyle = " clscomparevaluealtercolor";
            }
            this.doAddRightValue(valueElement, argprops);
        }
    }

    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true" && this.voData.chartName != "comparisonModelType2") {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);

        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            this.doAddRightValue(element, argprops, true);
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = graphicElement.clientWidth - this.currentValW + "px";
            element.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
            this.valueMaxH = subelement.clientHeight;
        } else if (this.labelAlignment.position == "outer" || graphicW <= this.innerlabelmaxWidth) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(element, argprops);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.labelMaxW = subelement.clientWidth * 0.7;
            if (this.placeholderAlignment.position == "middle") {
                this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
                this.labelMaxW = this.labelMaxW - this.middlePW;
                this.placholderHPos = this.placeholderAlignment.hposition;
                this.doAddLabel(labelElement, argprops);
            } else {
                this.placholderHPos = "";
                this.doAddLabel(labelElement, argprops);
            }
        }
    }

    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic " + clsStyle + " projection" + (groupindex + 1);
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
        graphicElement.classList.add("clsNodeSecondarybg");
        graphicElement.style.boxShadow = "";
    } else {
        if (((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey")) && this.data.shapeBorder) {
            let strBordeStyleClass = "secondary-border-color";
            if (borderElement) borderElement.classList.add(strBordeStyleClass);
            graphicElement.classList.remove("background-bg-color");
            graphicElement.classList.add("background-bg-color");
            rgbaValue = this.ChartUtils.createRBGColor(strBordeStyleClass, styleIndex, 0.5);
            graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaValue;
        }
    }
    // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
    //     const subImgelement = document.createElement("img");
    //     subImgelement.style.width = "100%";
    //     subImgelement.style.height = "100%";
    //     subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
    //     // subImgelement.style.position = "unset";
    //     subImgelement.id = "graphicimage-" + groupindex + "_" + index;
    //     subImgelement.className = "graphicimage";
    //     subImgelement.setAttribute("data-id", groupindex + "_" + index);
    //     subImgelement.setAttribute("data-type", "IMAGE");
    //     graphicElement.appendChild(subImgelement);
    //     let item = this.ChartUtils.getOffsetLeftTop(graphicElement);
    //     graphicElement.setAttribute("data-x", item.x);
    //     graphicElement.setAttribute("data-y", item.y);
    //     graphicElement.setAttribute("data-width", graphicElement.clientWidth);
    //     graphicElement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-width", graphicElement.clientWidth);
    //     subImgelement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

    //     subImgelement.setAttribute("data-x", item.x);
    //     subImgelement.setAttribute("data-y", item.y);
    //     graphicElement.style.position = "absolute";
    //     graphicElement.style.overflow = "hidden";
    //     this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img");
    // }
    if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
    }
    if (backgroundElement && this.data.layout.data.background.opacity) {
        let Class = this.getBgClassList(backgroundElement);
        let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
        backgroundElement.style.setProperty("background-color", rgbavalue, "important");
    }
    if (this.data.layout.itemShadow) {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};

function SimpleWaterfallChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleWaterfallChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleWaterfallChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleWaterfallChart.prototype.constructor = SimpleWaterfallChart;

SimpleWaterfallChart.prototype.doAddGridDesk = function (argProps) {
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.gridvalueSize = this.data.gridValueSize;
    }
    if (this.data._showTickMark && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        this.tickMarkSize = 12;
    }
    let eParent = this.parent;
    let eLabel = eParent.getElementsByClassName("label");
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let Container = eParent.getElementsByClassName("columnContainer");
    let negseries = eParent.getElementsByClassName("bottomseriesitem");
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series").querySelector(".columnContainer") : "";
    let secondarySeriesWidth = secondarySeries ? (secondarySeries.dataset.gridWidth ? parseFloat(secondarySeries.dataset.gridWidth) : secondarySeries.clientWidth) : 0;
    if (negseries[0] && negseries[0].children.length > 0) {
        let childSeries = eParent.querySelectorAll(".basebottomgraphic");
        negseries = childSeries.length > 0 ? childSeries : negseries;
    }
    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    if (eSeries[0] && eSeries[0].dataset.enablenegative == "true") {
        let negativeHeight = eSeries[0].dataset.negativeheightvalue;
        negBounds = { width: parseInt(eSeries[0].clientWidth), height: parseFloat(negativeHeight) };
    }
    let eValue = eParent.getElementsByClassName("value");
    let gridMaxValue = eParent.querySelector(".gridmaxValue");
    let gridNegativeValue = eParent.querySelector(".gridnegativemaxValue");
    let ePlaceholder = eParent.getElementsByClassName("primaryplaceholder");
    let labelBounds = eLabel[0] ? { width: parseInt(eLabel[0].clientWidth), height: parseInt(eLabel[0].clientHeight) } : { width: 0, height: 0 };
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };
    let placeholderBounds = { width: 0, height: 0 };

    let VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueBounds.height) : 0;
    let negativeValueHeight = 0;
    if (gridMaxValue) {
        VlaueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false ? parseFloat(gridMaxValue.clientHeight) : 0;
    }
    if (this.data.highlightDifference.display) {
        VlaueHeight += 30;
    }
    if (gridNegativeValue) {
        negativeValueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "bgoutside" ? parseFloat(gridNegativeValue.clientHeight) : 0;
    }
    totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) - parseFloat(VlaueHeight) } : { width: 0, height: 0 };

    if (this.data.layout.showPlaceholder && !this.data.layout.placeholderInset && ePlaceholder[0]) {
        placeholderBounds = { width: parseInt(ePlaceholder[0].clientWidth), height: parseInt(ePlaceholder[0].clientHeight + 10) };
    }

    let columnstart = parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize);
    // if(this.data.layout.parenthPosition  == "left" ){
    //     columnstart = 1;
    // }
    let columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    let legendArea = this.parent.querySelector(".legend");
    if ((this.data.chartName == "columnStackedRectangle" || this.data.chartName == "lineChart" || this.data.chartName == "columnSimpleRectangle") && this.legendposition == "left") {
        this.rectBaseSeries.x += legendArea.clientWidth;
        columnstart = Math.round(parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize) < 0 ? 1 : parseInt((this.rectBaseSeries.x - this.gridvalueSize) / this.props.gridsize));
        columnEnd = parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth)) / this.props.gridsize);
    }
    if (this.data.chartName == "columnStackedRectangle" && this.legendposition == "top" && eSeries[0]) {
        this.rectBaseSeries.x += eSeries[0].offsetLeft - 4;
        columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
    }
    let element = document.createElement("div");
    element.className = "grid accent1 clsMultiColorParent";
    element.style.display = "flex";
    element.style.position = "relative";
    element.style.position = "absolute";
    element.style.left = columnstart * this.props.gridsize + "px";
    element.style.width = (columnEnd - columnstart) * this.props.gridsize + "px";
    element.classList.add("th-section1");

    element.style.top = parseInt((this.rectBaseSeries.y + this.legendY + VlaueHeight) / this.props.gridsize) * this.props.gridsize + "px";
    element.style.height = parseInt((totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
    if (this.data.chartFlip && eSeries[0]) {
        if (negBounds.height > 0) {
            element.style.top = parseInt((eSeries[0].offsetTop + VlaueHeight + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
        } else {
            element.style.top = Math.round(parseInt((eSeries[0].offsetTop + this.legendY) / this.props.gridsize)) * this.props.gridsize + "px";
        }
        element.style.height = parseInt((eSeries[0].offsetTop + totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
    }
    if (parseFloat(element.style.height) < 0) {
        element.style.height = parseInt((totalBounds.height + this.legendY) / this.props.gridsize) * this.props.gridsize + "px";
    }
    eParent.appendChild(element);
    let DiffernceValue = 0;
    if (this.data.layout.parenthPosition == "center") {
        DiffernceValue = element.clientWidth - this.gridvalueSize - secondarySeriesWidth;
        let borderWidth = 0;
        if (this.data.chartBorder) {
            borderWidth = this.data._chartBorderWidth;
        }
        columnstart = columnstart + Math.round((element.clientWidth - 40 - secondarySeriesWidth) / 2 / this.props.gridsize);
        let extraPropertisWidth = Math.round((borderWidth + this.tickMarkSize) / this.props.gridsize);
        if (extraPropertisWidth > 0) {
            columnstart = columnstart - extraPropertisWidth;
        }
        if (columnstart > 0) {
            element.style.left = columnstart * this.props.gridsize + "px";
        }
        let AxisTitle = eParent.querySelector("#axis-title-left");
        let topValue = Container.length > 0 ? Container[0]?.parentNode?.offsetLeft : 0;
        topValue = topValue <= 4 ? 4 : topValue;
        if (Container.length > 0 && !AxisTitle) {
            element.style.left = (Math.round(topValue / this.props.gridsize) - extraPropertisWidth) * this.props.gridsize + "px";
        }
        let baseLineValue = 0;
        if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
            baseLineValue = 30;
        }
        if (AxisTitle) {
            if (this.legendposition != "left") {
                AxisTitle.style.gridColumnStart = columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1 ? 1 : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
                AxisTitle.style.gridColumnEnd = columnstart;
            } else {
                if (this.legendposition == "left") {
                    AxisTitle.style.gridColumnStart =
                        columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize) < 1
                            ? 1
                            : columnstart - Math.round(axisTitleSize / this.props.gridsize) - Math.round(this.legendWidth / this.props.gridsize) - Math.round(baseLineValue / this.props.gridsize);
                    AxisTitle.style.gridColumnEnd = columnstart - Math.round(this.legendWidth / this.props.gridsize);
                }
            }
        }
    } else {
        if (this.legendWidth > 0 && this.legendposition == "left") {
            if (columnstart > 0) {
                element.style.left = (columnstart + Math.round(this.legendWidth / this.props.gridsize)) * this.props.gridsize + "px";
            }
        }
    }

    let rectSeries = {
        x: 0,
        y: 0,
        width: secondarySeriesWidth != 0 && (this.data.layout.parenthPosition == "center" || this.data.layout.parenthPosition == "left") ? secondarySeriesWidth + this.gridvalueSize : element.clientWidth,
        height: totalBounds.height,
        top: element.offsetTop > element.clientHeight ? 10 - negBounds.height : element.offsetTop - negBounds.height,
        left: element.offsetLeft + this.gridvalueSize + this.tickMarkSize,
    };
    if (this.data.seriesItemLength > 1 && this.data.layout.legendPosition == "left" && this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
        rectSeries.width = secondarySeriesWidth != 0 && this.data.layout.parenthPosition == "center" ? secondarySeriesWidth : element.clientWidth;
    }
    if (this.data.layout.parenthPosition == "center") {
        rectSeries.left = this.gridvalueSize + this.tickMarkSize - 2;
    } else {
        rectSeries.left = rectSeries.left >= 100 ? this.gridvalueSize + this.tickMarkSize : rectSeries.left;
    }

    rectSeries.top = rectSeries.top > element.clientHeight ? element.clientHeight : rectSeries.top;
    let graphicContainer = eParent.querySelector(".chartgraphic");
    let grid3dspace = graphicContainer && graphicContainer.getAttribute("data-movey") ? graphicContainer.getAttribute("data-movey") : 0;
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        valueHeight: VlaueHeight,
        negativeHeight: negativeValueHeight,
        negBounds: negBounds,
        gridvalueSize: { width: this.gridvalueSize, height: 0 },
        gridthickMarkerSize: { width: this.tickMarkSize, height: 0 },
        move3dspace: grid3dspace,
        type: "vertical",
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    this.addGridDeskElement(element, eProps);
    if (this.data.chartName == "columnStackedRectangle" && this.legendposition == "top") {
        let xaxis = this.parent.querySelector(".axisXlines");
        let legendArea = this.parent.querySelector(".legend");
        if (xaxis && legendArea) {
            let topElementValue = xaxis.parentNode.offsetTop + legendArea.clientHeight;
            xaxis.parentNode.style.top = topElementValue + "px";
        }
        let yaxis = this.parent.querySelector(".axisYlines");
        if (yaxis) {
            yaxis.parentNode.style.top = legendArea.clientHeight + "px";
        }
    }
    if (this.data.layout.parenthPosition == "center") {
        let axisLine = element.querySelector("#xaxis");
        let yAxis = element.querySelector("#yaxis");
        if (this.legendposition == "top" && yAxis) {
            yAxis.style.top = "unset";
        }
        if (axisLine) axisLine.style.top = rectSeries.height - negBounds.height - parseFloat(grid3dspace) + "px";
        if (axisLine && this.data.chartFlip) {
            axisLine.style.bottom = rectSeries.height - negBounds.height - parseFloat(grid3dspace) - 4 + "px";
            axisLine.style.removeProperty("top");
        }
        element.style.position = "relative";
        if (this.data.minValue < 0) {
            let containerElement = element.querySelectorAll(".gridcontainer");
            let gridvalueContainer = element.querySelectorAll(".gridValuecontainer");
            if (containerElement.length > 1 && gridvalueContainer.length > 1) {
                if (this.data.chartFlip) {
                    containerElement[1].style.bottom = containerElement[0].clientHeight + "px";
                    gridvalueContainer[1].style.bottom = containerElement[0].clientHeight + 9 + "px";
                    if (axisLine) {
                        axisLine.style.bottom = containerElement[0].clientHeight + "px";
                        axisLine.style.removeProperty("top");
                    }
                    gridvalueContainer[0].style.marginTop = negBounds.height - negativeValueHeight + "px";
                    containerElement[0].style.marginTop = negBounds.height - negativeValueHeight + "px";
                } else {
                    containerElement[1].style.top = containerElement[0].clientHeight + "px";
                    gridvalueContainer[1].style.top = containerElement[0].clientHeight + "px";
                    if (axisLine) axisLine.style.top = containerElement[0].clientHeight + "px";
                }
            }
        }
    }
};
SimpleWaterfallChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleWaterfallSeries"](argparent, argprops);
};
SimpleWaterfallChart.prototype.CreateHightlightDifference = function () {
    return null;
};

let intRectStartY = 0;
let intRectY = 0;
let previousRectHeight = 0;
let preHighY = 0;
let secondaryPosTotalValue = 0;
let gridPosTotal = 0;
let preNegValueY = 0;
let secondaryNegtiveTotalValue = 0;
let gridNegtiveTotal = 0;
let secondaryNegTotalValue = 0;
let gridNegTotal = 0;
function SimpleWaterfallSeries(argparent, argprops) {
    this.name = "SimpleWaterfallSeries";
    this.widthPercentage = 0.7;
    this.SVGUtils = new window["SVGUtils"]();
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleWaterfallSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleWaterfallSeries.prototype.constructor = SimpleWaterfallSeries;

SimpleWaterfallSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.index == 0) {
        preHighY = this.rectSeriesItem.height;
        secondaryPosTotalValue = 0;
        gridPosTotal = 0;
        preNegValueY = this.rectSeriesItem.height;
        secondaryNegtiveTotalValue = 0;
        gridNegtiveTotal = 0;
        secondaryNegTotalValue = 0;
        gridNegTotal = 0;
    }

    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.alignItems = "flex-start";
    element.style.position = "relative";
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    element.classList.add("th-section" + customColorIndex);
    let bounds = null;
    if (this.data.layout.itemgap) {
        let currentWidth = 0;
        if (this.data.layout.itemgap + this.data.layout.itemSpace > this.state.width) {
            currentWidth = this.state.width - this.data.layout.itemSpace;
            this.widthPercentage = parseFloat(this.data.SVGUtils.createPercentValue(this.state.width, currentWidth)) / 100;
        } else {
            currentWidth = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : this.state.width * this.data.layout.itemgap) : 0;
            this.widthPercentage = parseFloat(this.data.SVGUtils.createPercentValue(this.state.width, currentWidth)) / 100;
        }
        bounds = { width: currentWidth };
    }

    if (this.data.secondaryLabel) {
        if (this.data.layout.secondarySamePosition) {
            this.doAddSecondaryLabelNode(sameElement, argprops, true);
            this.doAddSecondaryLabelNode(sameElement, argprops, false, true);
        } else {
            if (this.data.layout.secondaryPosition) {
                this.doAddSecondaryLabelNode(element, argprops, true);
                this.doAddSecondaryLabelNode(element, argprops, false);
            } else {
                this.doAddSecondaryLabelNode(element, argprops, true);
                this.doAddSecondaryLabelNode(element, argprops, false);
            }
        }
    }

    this.doAddLabel(element, argprops, true, false, bounds);
    this.doAddLabel(element, argprops, false, false, bounds);

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond";
    subelement.style.width = this.widthPercentage * 100 + "%";
    subelement.style.height = 100 + "%";
    subelement.setAttribute("data-width", this.state.width * this.widthPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);
    this.numMultiplyFactor = this.rectSeriesItem.height / this.data.waterFallData.maxAreaValue;
    if (element) element.appendChild(subelement);
    if (this.index == this.data.seriesLength - 1) {
        element.style.width = this.state.width * this.widthPercentage + "px";
        subelement.style.width = 100 + "%";
        let differnceWidth = this.state.width - this.state.width * this.widthPercentage;
        let totalWidth = this.data.seriesLength * this.state.width - differnceWidth;
        if (element.parentNode) element.parentNode.style.width = totalWidth + "px";
    }
    for (let i1 = 0; i1 < 1; i1++) {
        let intGraphicsItemSize = 0;

        this.objRectLine = {
            x: this.rectSeriesItem.x,
            y: this.rectSeriesItem.y,
            width: this.rectSeriesItem.width,
            height: this.rectSeriesItem.height,
        };
        if (!this.data.waterFallData.data[this.index].isSumValue) {
            let numValue = this.data.waterFallData.data[this.index].value;
            intGraphicsItemSize = Math.abs(this.data.waterFallData.data[this.index].value) * this.numMultiplyFactor;
            previousRectHeight = intGraphicsItemSize;
            let rectyvalue = this.data.waterFallData.data[this.index].startValue + Math.abs(this.data.waterFallData.negDiffValue);
            if (numValue > 0) {
                intRectY = this.rectSeriesItem.height - rectyvalue * this.numMultiplyFactor - intGraphicsItemSize + intRectStartY;
                this.objRectLine.y = intRectY;
            } else {
                intRectY = this.rectSeriesItem.height - rectyvalue * this.numMultiplyFactor + intRectStartY;
                this.objRectLine.y = intRectY + intGraphicsItemSize;
            }
            if (numValue < 0) {
                secondaryPosTotalValue += numValue;
            }
            if (preHighY > intRectY && numValue > 0) {
                preHighY = intRectY;
                let dummeyValue = secondaryPosTotalValue + numValue;
                secondaryPosTotalValue = 0;
                gridPosTotal += dummeyValue;
            }

            if (this.index == 0) {
                preNegValueY = intRectY + intGraphicsItemSize;
            }
            if (this.data.waterFallData.data[0].value < 0) {
                secondaryNegTotalValue += numValue;
                if (preNegValueY < intRectY + intGraphicsItemSize && numValue < 0) {
                    preNegValueY = intRectY + intGraphicsItemSize;
                    let dummeyNegValue1 = secondaryNegTotalValue;
                    secondaryNegTotalValue = 0;
                    gridNegTotal += dummeyNegValue1;
                }
                if (gridNegTotal == 0 && this.index == this.data.seriesLength - 2) {
                    gridNegTotal = this.data.waterFallData.data[0].value;
                }
            } else {
                if (numValue > 0) {
                    secondaryNegTotalValue += numValue;
                }
                if (preNegValueY < intRectY + intGraphicsItemSize && numValue < 0) {
                    preNegValueY = intRectY + intGraphicsItemSize;
                    let dummeyNegValue = secondaryNegTotalValue + numValue;
                    secondaryNegTotalValue = 0;
                    gridNegTotal += dummeyNegValue;
                } else {
                    if (numValue < 0) {
                        secondaryNegTotalValue += numValue;
                    }
                }
            }
            this.data.rangeNegative = gridNegTotal;
        } else {
            let numSumValue = this.data.waterFallData.data[this.index].value;
            intGraphicsItemSize = parseFloat(Math.abs(numSumValue) * this.numMultiplyFactor);
            if (numSumValue < 0) {
                if (this.data.waterFallData.data[this.index - 1].value < 0) {
                    let dummeyY = intRectY + previousRectHeight;
                    intRectY = dummeyY - intGraphicsItemSize;
                    this.objRectLine.y = intRectY + intGraphicsItemSize;
                } else {
                    intRectY = intRectY - intGraphicsItemSize;
                    this.objRectLine.y = intRectY + intGraphicsItemSize;
                }
            } else {
                if (this.data.waterFallData.data[this.index - 1].value < 0) {
                    intRectY = intRectY + previousRectHeight;
                    this.objRectLine.y = intRectY;
                } else {
                    intRectY = intRectY;
                    this.objRectLine.y = intRectY;
                }
            }
        }

        let rectSeriesItemSize = {
            x: 0,
            y: intRectY,
            width: this.rectSeriesItem.width,
            height: this.rectSeriesItem.height,
        };

        const eProps = { index: i1, groupindex: this.index, graphicSize: rectSeriesItemSize, graphicsItemSize: intGraphicsItemSize, objRectLine: this.objRectLine };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
        if (intRectY + intGraphicsItemSize < this.rectSeriesItem.height && this.index == 0) {
            subelement.dataset.enablenegative = "true";
            subelement.dataset.negativeheightvalue = this.rectSeriesItem.height - (intRectY + intGraphicsItemSize);
        }
        if (this.data.waterFallData.data[0].value < 0) {
            subelement.dataset.enablenegative = "true";
            subelement.dataset.negativeheightvalue = this.rectSeriesItem.height - intRectY;
        }
        if (this.index == this.data.seriesLength - 1) {
            this.data.rangeTotal = gridPosTotal;
        }
        let svgLine = this.createWaterfallLineSvg(element);
        element.appendChild(svgLine);
    }
};

SimpleWaterfallSeries.prototype.createWaterfallLineSvg = function (seriesElement) {
    let positionY = this.objRectLine.y - 5 < 0 ? 0 : this.objRectLine.y;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "waterfall-line_container",
        style: "position:absolute;top:" + positionY + "px;left:0%;",
        width: "100%",
    });
    if (this.data?.chartFlip) {
        let seriesHeight = seriesElement?.clientHeight;
        svgElement.style.top = seriesHeight - positionY + "px";
    }
    let svgDottedLine = this.data.SVGUtils.createSVGElement("line");
    this.data.SVGUtils.assignAttributes(svgDottedLine, {
        x1: this.widthPercentage * 100 + "%",
        y1: 0,
        x2: "100%",
        y2: 0,
        id: "waterfall-line",
        class: "waterfall-line  secondary-stroke moodanimation",
        "stroke-opacity": "0.6",
        "data-animation": "waterfallline",
        "stroke-width": 2 + "px",
        "stroke-dasharray": "5,5",
    });
    if (this.index != this.data.seriesLength - 1) svgElement.appendChild(svgDottedLine);
    return svgElement;
};

SimpleWaterfallSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleWaterfallSeriesItem"](argparent, argprops);
};

// let objValue;
// let valueMaxW = 0;
// let valueMaxH = 70;
// let graphicH = 0;
function SimpleWaterfallSeriesItem(argparent, argprops) {
    this.name = "SimpleWaterfallSeriesItem";
    this.groupindex = argprops.groupindex;
    this.rectGraphics = {
        x: argprops.graphicSize.x,
        y: argprops.graphicSize.y,
        width: argprops.graphicSize.width,
        height: argprops.graphicsItemSize,
    };
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleWaterfallSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleWaterfallSeriesItem.prototype.constructor = SimpleWaterfallSeriesItem;
SimpleWaterfallSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += objValue.height;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - _iHeight;
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = this.rectGraphics.height;
    let customColorIndex = this.ChartFonts.customColor(0);
    if (this.data.waterFallData.data[groupindex].value < 0) {
        customColorIndex = 6;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    element.style.position = "relative";
    element.style.display = "flex";
    element.style.justifyContent = "center";
    element.style.overflow = "hidden";
    element.classList.add("th-section" + customColorIndex);

    if (argparent) argparent.appendChild(element);
    else return element;

    let clsStyle = this.data.waterFallData.data[groupindex].value < 0 ? "cf-background-color-section-primary" : "cf-background-color-section-primary";
    clsStyle = (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || this.data.waterFallData.data[groupindex].isSumValue ? "clsNodeSecondarybg" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 + "%";
    subelement.style.height = graphicHeightPercentage + "px";
    subelement.style.display = "flex";
    subelement.style.position = "absolute";
    if (this.data.chartFlip) {
        subelement.style.bottom = this.rectGraphics.y + "px";
    } else {
        subelement.style.top = this.rectGraphics.y + "px";
    }
    // subelement.setAttribute("data-id", groupindex + "_" + index);
    // subelement.setAttribute("data-type", "ITEM");
    element.appendChild(subelement);
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic moodanimation " + clsStyle;
    if ((this.data.waterFallData.data[groupindex].value > 0 && !this.data.waterFallData.data[groupindex].isSumValue) || (this.data.waterFallData.data[groupindex].isSumValue && this.data.waterFallData.data[groupindex].value < 0)) {
        graphicElement.className = "chartgraphic moodanimation transformOrginBottom " + clsStyle;
        graphicElement.dataset.customorgin = "bottom";
        graphicElement.dataset.customopacity = "0.5";
    }
    if ((this.data.waterFallData.data[groupindex].value < 0 && !this.data.waterFallData.data[groupindex].isSumValue) || (this.data.waterFallData.data[groupindex].isSumValue && this.data.waterFallData.data[groupindex].value > 0)) {
        graphicElement.className = "chartgraphic moodanimation transformOrginTop " + clsStyle;
        graphicElement.dataset.customorgin = "top";
        if (this.data.waterFallData.data[groupindex].isSumValue) {
            graphicElement.dataset.customopacity = "0.5";
        }
    } else {
        graphicElement.dataset.customopacity = "1";
    }
    graphicElement.style.height = 100 + "%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    subelement.appendChild(graphicElement);

    if (this.data.projection[groupindex] == true && this.data.hasProjection) {
        graphicElement.className = "chartgraphic moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
        graphicElement.dataset.customorgin = "bottom";
    }

    if (this.data.waterFallData.data[groupindex].isSumValue) {
        graphicElement.classList.add("sumopacityvalue");
    }
    this.valueMaxW = graphicElement.clientWidth * 0.7;
    this.valueMaxH = 70; //

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "middle") {
            this.placeholderStyle = "outerColor1";
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = "innerColor1";
            this.doAddTopPlaceholder(subelement, argprops);
        }
    }
    if (this.displayValue(argprops)) {
        this.doAddTopValue(element, argprops, true);
        graphicH = this.rectGraphics.height;
        if (this.valueAlignment.position == "middle" || graphicH < this.valueMaxH) {
            this.valuePosition = "outer";
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "clsContrastTextColor " + this.data.clsValueTextColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.appendgraphicColor(groupindex) : "clsContrastTextColor " + this.data.clsValueTextColor;
            this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner") {
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement";
            valueElement.style.width = "100%";
            valueElement.style.height = "100%";
            valueElement.style.display = "flex";
            valueElement.style.justifyContent = "center";
            valueElement.style.alignItems = "center";
            valueElement.style.overflow = "hidden";
            valueElement.style.position = "absolute";
            valueElement.style.pointerEvents = "none";
            if (this.data.chartFlip) {
                valueElement.style.bottom = 0;
            } else {
                valueElement.style.top = 0;
            }
            subelement.appendChild(valueElement);
            this.valueStyle = "clsContrastColor";
            this.doAddTopValue(valueElement, argprops);
        }
    }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        if (this.data.values[this.groupindex][this.index] < 0) {
            borderRadiuslefttop = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusRightTop = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            borderRadiusRightBottom = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        }
        if (this.data.layout.borderRadiusClass) {
            graphicElement.classList.add(this.data.layout.borderRadiusClass);
        } else {
            graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    if (this.data.layout.itemShadow) {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};
SimpleWaterfallSeriesItem.prototype.doAddGraphicElement = function () {
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType,
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = 100 + "%";
    element.setAttribute("data-width", numParentWidth);
    this.parent.appendChild(element);

    this.doAddTopSeriesItemElement(element, eProps);
};
SimpleWaterfallSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.valueMaxW = this.state.width * 0.7;
    this.valueMaxH = this.state.height * 0.4; //< 35 ? this.state.height : 35;
    this.length = this.voData.seriesItemLength;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
    });
    this.labelAlignment = {};
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
    });
};
