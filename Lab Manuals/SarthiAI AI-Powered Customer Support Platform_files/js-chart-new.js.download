function ChartTableChangeHandler() {
    // Constructor function - can be empty or contain initialization logic
}

ChartTableChangeHandler.prototype.getTextChangeOperationListener = function () {
    this.ChartUtils = new window["ChartUtils"]();
    let appStore = this.ChartUtils.getAppStore();
    this.chartTextChangeHandler = new window["ChartTextChangeHandler"]();
    let unsubscribe = appStore.subscribe(
        (state) => {
            return state.chartTableData;
        },
        (chartTableData) => {
            this.onDataTableDataChangeHandler(chartTableData?.slideId, chartTableData?.objDetails, chartTableData?.callback);
        }
    );

    // Store the subscription for proper cleanup
    if (window.addSubscription) {
        window.addSubscription(unsubscribe);
    }
};

ChartTableChangeHandler.prototype.onDataTableDataChangeHandler = function (slideID, objTempDetails, callback = null) {
    let graphicElement = getGraphicDiv();
    let xmlData = graphicElement?.querySelector(".chartbase");
    let chartName = xmlData?.getAttribute("name");
    let targetIdValue = objTempDetails?.targetId;
    let multisell = objTempDetails?.multisell;
    let arrTargetIdValue = multisell?.length > 0 ? multisell : [objTempDetails];
    let element = null;
    let boolRedraw = false;
    let objDetails = {};
    for (let i = 0; i < arrTargetIdValue.length; i++) {
        objDetails = arrTargetIdValue[i];
        if (!objDetails?.chartItem) objDetails["chartItem"] = objDetails?.item;
        let hasOldElement = this.onCheckAddColRowHandler(slideID, objDetails, xmlData);
        if (!hasOldElement) {
            this.ChartUtils.chartRecreate(slideID, xmlData, null, graphicElement, callback);
            return;
        }
        targetIdValue = objDetails?.targetId || objDetails?.item?.data?.id;
        let indexValue = "";
        if (targetIdValue.includes("label")) {
            indexValue = targetIdValue.split("-")[1];
            let arrLabelElement = graphicElement?.querySelectorAll(".labeltext");
            if (targetIdValue.includes("comparelabel")) {
                arrLabelElement = graphicElement?.querySelectorAll("[data-type='comparisonlabel']");
            }
            element = arrLabelElement[indexValue];
            element?.setAttribute("value", objDetails?.value);
            if (element) element.innerText = objDetails?.value;
            //let xmlChildData = xmlData?.children[indexValue];
            //let labelText = xmlChildData?.getAttribute("name");
            // if (labelText != objDetails?.value) {
            //     xmlChildData.setAttribute("name", objDetails?.value);
            //     boolRedraw = true;
            // }
        } else if (targetIdValue.includes("stackedwidthvalue")) {
            indexValue = targetIdValue.split("-")[1];
            let groupIndex = indexValue?.split("_")[0];
            let xmlChildData = xmlData?.children[groupIndex];
            let oldValue = xmlChildData?.getAttribute("seriesitemwidth");
            if (oldValue != objDetails?.value) {
                xmlChildData.setAttribute("seriesitemwidth", objDetails?.value);
                boolRedraw = true;
            }
            type = "stackedwidthvalue";
        } else if (targetIdValue.includes("value")) {
            indexValue = targetIdValue.split("-")[1];
            let groupIndex = indexValue?.split("_")[0];
            let seriesItemIndex = indexValue?.split("_")[1];
            if (chartName == "comparisonModelType3" && seriesItemIndex > 0) {
                seriesItemIndex = 1;
            }
            let userValue = objDetails?.value?.replaceAll(",", "");
            if (userValue == "") {
                userValue = "0";
            }
            let xmlChildData = xmlData?.children[groupIndex];
            let arrValue = xmlChildData?.getAttribute("value")?.split(",");
            let arrAsenteredValue = xmlChildData?.getAttribute("asenteredvalue")?.split("^");
            let idValue = "valuetext-" + indexValue;
            element = graphicElement?.querySelector("[id='" + idValue + "']");
            boolRedraw = true;
            if (arrValue[seriesItemIndex] != userValue && !element) {
                // arrValue[seriesItemIndex] = userValue;
                // arrAsenteredValue[seriesItemIndex] = objDetails?.value;
                // xmlChildData?.setAttribute("value", arrValue.join(","));
                // xmlChildData?.setAttribute("asenteredvalue", arrAsenteredValue.join("^"));
            }
        }
        let type = element?.getAttribute("data-type");
        if (!type && !element) {
            type = targetIdValue?.includes("value") && !targetIdValue.includes("stackedwidthvalue") ? "value" : type;
        }
        switch (type) {
            case "label":
            case "legendlabel":
            case "comparisonlabel":
            case "placeholdertext":
            case "comparelabel":
                element.parentElement.scrollTop = 0;
                boolRedraw = this.chartTextChangeHandler.assignLabelData(element, type, callback, xmlData, true);
                break;
            case "value":
            case "promt":
            case "legendvalue":
                this.chartTextChangeHandler.assignValueWithoutElementData(objDetails?.value, { id: indexValue }, xmlData, graphicElement);
                break;
            case "stackedwidthvalue":
                this.chartTextChangeHandler.assignStackedWidthValue(objDetails?.value, { id: indexValue });
                break;
            default:
        }
        if (boolRedraw) {
            this.ChartUtils.chartRecreate(slideID, xmlData, null, graphicElement, callback);
        }
    }
};
ChartTableChangeHandler.prototype.onCheckAddColRowHandler = function (slideID, objDetails, xmlData) {
    let chartItem = objDetails?.chartItem;
    let indexValue = chartItem?.index;
    if (!indexValue) return true;
    let indexValueArray = indexValue?.split("_");
    let rowIndex = parseInt(indexValueArray?.[0] || 0);
    let columnIndex = parseInt(indexValueArray?.[1] || 0);
    let currentRow = xmlData?.children.length;
    let valueLength = xmlData?.children[0]?.getAttribute("value")?.split(",")?.length;
    if (columnIndex > valueLength + 1 || rowIndex > currentRow + 1) {
        if (objDetails?.event) {
            objDetails.event.target.innerText = "";
        }
    }
    rowIndex = rowIndex > currentRow + 1 ? currentRow + 1 : rowIndex;
    columnIndex = columnIndex > valueLength + 1 ? valueLength + 1 : columnIndex;
    if (rowIndex > currentRow && columnIndex > 0) {
        columnIndex = 1;
    }
    let value = "";
    let asenteredvalue = "";
    let hasupdateUpdate = false;
    let userValue = columnIndex && parseInt(columnIndex) > 0 ? objDetails?.value?.replaceAll(",", "") : 0;
    userValue = userValue?.replace(/[^\d]/g, "");
    if (userValue == "") {
        userValue = 0;
    }
    for (let i = 0; i < valueLength; i++) {
        if (columnIndex && parseInt(columnIndex) > 0) {
            if (i == parseInt(columnIndex) - 1) {
                if (i == 0) {
                    value = userValue;
                    asenteredvalue = objDetails?.value;
                } else {
                    value += "," + userValue;
                    asenteredvalue += "^" + objDetails?.value;
                }
            } else if (i == 0) {
                value = 0;
                asenteredvalue = 0;
            } else {
                value += "," + 0;
                asenteredvalue += "^" + 0;
            }
        } else {
            if (i == 0) {
                value = 0;
                asenteredvalue = 0;
            } else {
                value += "," + 0;
                asenteredvalue += "^" + 0;
            }
        }
    }
    if (!objDetails?.value && rowIndex > currentRow - 1) return false;
    if (rowIndex > currentRow) {
        hasupdateUpdate = true;
        let item = document.createElement("metadata");
        item.setAttribute("class", "chartitem");
        item.setAttribute("name", columnIndex == 0 ? objDetails?.value : "");
        item.setAttribute("index", currentRow);
        item.setAttribute("asenteredvalue", asenteredvalue);
        item.setAttribute("value", value);
        item.setAttribute("prefix", "");
        item.setAttribute("suffix", "");
        item.setAttribute("denomination", "");
        xmlData.appendChild(item);
    }
    if (columnIndex > valueLength && objDetails?.value) {
        if (columnIndex && parseInt(columnIndex) - 1 > 0) {
            let ValueIndex = columnIndex - 1;
            let Value = 0;
            let asentered = 0;
            for (let c1 = 0; c1 < xmlData.children.length; c1++) {
                let arrItemValues = xmlData.children[c1].getAttribute("value")?.split(",");
                let arrItemAsenterdValues = xmlData.children[c1].getAttribute("asenteredvalue")?.split("^") || [];
                if (c1 == rowIndex - 1) {
                    hasupdateUpdate = true;
                    Value = userValue;
                    asentered = objDetails?.value;
                } else {
                    Value = 0;
                    asentered = 0;
                }
                if (arrItemValues[ValueIndex]) {
                    arrItemValues[ValueIndex] = Value;
                } else {
                    arrItemValues.push(Value);
                }
                if (arrItemAsenterdValues[ValueIndex]) {
                    arrItemAsenterdValues[ValueIndex] = asentered;
                } else {
                    arrItemAsenterdValues.push(asentered);
                }
                xmlData.children[c1].setAttribute("value", arrItemValues.join(","));
                xmlData.children[c1].setAttribute("asenteredvalue", arrItemAsenterdValues.join("^"));
            }
        }
    }
    if (hasupdateUpdate) {
        return false;
    } else {
        return true;
    }

    // if (columnIndex > currentColumn) {
    //     return true;
    // }
};

function CssChartAssetManager() {
    // Constructor function
    this.STR_DEFAULT_ICONGROUP = "currencyicon";
    this.STR_DEFAULT_ICONPATH = "genericassets/icons/placeholder/placeholder.svg";
    this.STR_DEFAULT_IMAGEPATH = "genericassets/genericassets/images/placeholder.png";
    this.STR_DEFAULT_ICONID = "placeholder";
}

CssChartAssetManager.prototype.getChartAssetList = function (value, xmlData, menuData = null, moodsData = null) {
    let arrAssets = [];
    const slideID = value.slideID;
    const elementID = value.elementID;
    const chartName = value.chartName;
    const assetName = xmlData.getAttribute("data-asset");
    const appearance = xmlData.getAttribute("data-appearance");
    this.getShapeList(slideID, chartName, assetName, arrAssets, appearance, xmlData, menuData);
    this.iconstyle = this.iconstyle || moodsData?.assetstyle?.iconstyle || "fill";
    if (xmlData.getAttribute("primaryplaceholder") == "true" || xmlData.getAttribute("data-primaryplaceholder") == "true") arrAssets = this.getIconList(slideID, this.STR_DEFAULT_ICONGROUP, arrAssets, xmlData);
    // let chartName = xmlData.getAttribute("name")
    if (
        chartName == "fillcompareChart" ||
        chartName == "columnIconFill" ||
        chartName == "barSimpleIconFill" ||
        chartName == "scaleiconcompareChart" ||
        chartName == "singleIconFill" ||
        chartName == "simpleIconFillRepeatChart" ||
        chartName == "iconComparisonChart" ||
        chartName == "barSimpleiconRepeatFill" ||
        chartName == "logoGraphicComparisonChart" ||
        chartName == "ComparisonpieChart"
    ) {
        //let iconGroup = this.data.getAttribute("data-iconid")?this.data.getAttribute("data-iconid"):"flaticon"
        arrAssets = this.getIconList(slideID, this.STR_DEFAULT_ICONGROUP, arrAssets, xmlData, chartName);
    }
    if (xmlData.getAttribute("commonplaceholdertype")) {
        arrAssets = this.getCommonIconList(slideID, this.STR_DEFAULT_ICONGROUP, arrAssets, xmlData);
    }

    //arrAssets = arrAssets.length > 0 ? [arrAssets, ...arrIconAssets] : arrIconAssets;
    //
    let strStyleSheetURL = "chart/css/chartnew.css"; //jsonChartItemMetaData.stylesheet;
    if (strStyleSheetURL != undefined) {
        let patternSvg = this.getAssetListDetails(xmlData, menuData, true);
        let lineHeadShape = this.getAssetListDetails(xmlData, menuData, false, true);
        if (patternSvg && patternSvg.assetName) {
            arrAssets.push({
                type: "icon",
                slideID: slideID,
                id: "chartprojectionpattern",
                url: "chart/pattern/" + patternSvg.assetName + ".svg",
            });
        }
        if (lineHeadShape && lineHeadShape.assetName) {
            arrAssets.push({
                type: "icon",
                slideID: slideID,
                id: "lineheadshape",
                url: "chart/lineheadstyle/" + lineHeadShape.assetName + ".svg",
            });
        }
    }
    //
    return { slideID: slideID, elementID: elementID, arrAssets: arrAssets };
};

CssChartAssetManager.prototype.getShapeList = function (strSlideID, strChartName, strAssetName, arrStorage, strappearance, xmlData, menuData) {
    let filltype = "";
    let appearance = "";
    let assetDatas = this.getAssetListDetails(xmlData, menuData);
    if (assetDatas) {
        strAssetName = assetDatas.assetName;
        strappearance = assetDatas.appearance;
    }
    let assets = strAssetName ? strAssetName.split(",") : [strAssetName];
    let assetType = assetDatas && assetDatas.assetType ? assetDatas.assetType.split(",") : [null];
    for (let i1 = 0; i1 < assets.length; i1++) {
        strAssetName = assets[i1];
        let objAsset = JSON.parse(JSON.stringify(assetDatas)); //strChartName,
        if (objAsset) objAsset.assetType = assetType.length > i1 ? assetType[i1] : assetType[assetType.length - 1];
        if (objAsset && objAsset.assetType != undefined) {
            if (objAsset.assetType == "svg" && appearance != "RealImage") {
                let assetName = assets[i1].toLowerCase();
                if (appearance == "Outline") assetName = assetName + "outline";
                else if (appearance == "Overlay") assetName = assetName + "overlay";

                arrStorage.push({
                    type: "icon",
                    id: assetName,
                    iconType: "fxg",
                    fillType: filltype,
                    slideID: strSlideID,
                    assetName: assetName,
                    appearance: appearance,
                    url: "genericassets/shapes/" + assetName + ".svg",
                    assetList: objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : assetName,
                });
            } else if (objAsset.assetType == "image" && strAssetName) {
                if (
                    strChartName == "realObjectPieChart" ||
                    strChartName == "realObjectEarthChart" ||
                    strChartName == "barVerticalMaskChart" ||
                    strChartName == "objectComparisonChart" ||
                    strChartName == "currencyPercentageChart" ||
                    strChartName == "realObjectSinglePieChart" ||
                    strChartName == "realObjectSinglePieChart" ||
                    strChartName == "realObjectOverlayPieChart" ||
                    strChartName == "realObjectPercentagePieChart" ||
                    strChartName == "realObjectOverlayPiePercentageChart" ||
                    strChartName == "assetPercentageChart" ||
                    strChartName == "columnSimpleCoin" ||
                    strChartName == "lineCoinChart" ||
                    strChartName == "AngularGauge" ||
                    strChartName == "SingleAssetPieOverlayChart"
                ) {
                    // let assetList = objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : objAsset.assets;
                    // let length = assetList.length;
                    appearance = strChartName == "assetPercentageChart" ? "realimage" : strappearance;
                    if (strChartName == "AngularGauge" || strChartName == "columnSimpleCoin" || strChartName == "lineCoinChart" || strChartName == "currencyPercentageChart" || strChartName == "SingleAssetPieOverlayChart") {
                        appearance = "";
                    }
                    if (objAsset.assetfolder) {
                        appearance = "";
                    }
                    // for (let i = 0; i < length; i++) {
                    const assetname = (strAssetName + appearance).toLocaleLowerCase();

                    let currentPath = objAsset.assetfolder ? "genericassets/images/" + objAsset.assetfolder + "/" + assetname + ".png" : "genericassets/images/" + assetname + ".png";
                    if (assetname.includes("http:") || assetname.includes("https:")) {
                        currentPath = assetname;
                    }
                    arrStorage.push({
                        type: "IMAGE",
                        id: strAssetName,
                        filltype: filltype,
                        slideID: strSlideID,
                        assetList: assets,
                        appearance: appearance,
                        assetWidth: objAsset.assetWidth,
                        assetHeight: objAsset.assetHeight,
                        url: currentPath,
                    });
                    // }
                } else {
                    arrStorage.push({
                        type: "JS",
                        styleName: "",
                        fillType: filltype,
                        slideID: strSlideID,
                        appearance: appearance,
                        id: objAsset.assetSource,
                        movieClipAsset: objAsset,
                        assetWidth: objAsset.assetWidth,
                        assetHeight: objAsset.assetHeight,
                        folderPath: "chart/js/" + objAsset.assetSource + "/",
                        url: "chart/js/" + objAsset.assetSource + "/" + objAsset.assetSource + ".js",
                        assetList: objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : objAsset.assets,
                    });
                }
            } else if (objAsset.assetType == "spritesheet") {
                const arrAssetList = objAsset.assetName.split(",");
                const length = arrAssetList.length;
                for (let i1 = 0; i1 < length; i1++) {
                    let assetName = arrAssetList[i1];
                    if (appearance == "Outline") assetName = assetName + "outline";
                    else if (appearance == "Overlay") assetName = assetName + "overlay";
                    if (objAsset.multiasset == "true") {
                        for (let i2 = 0; i2 < 2; i2++) {
                            arrStorage.push({
                                type: "json",
                                styleName: "",
                                fillType: filltype,
                                slideID: strSlideID,
                                appearance: appearance,
                                id: assetName, //objAsset.assetSource,
                                movieClipAsset: objAsset,
                                assetWidth: objAsset.assetWidth,
                                assetHeight: objAsset.assetHeight,
                                folderPath: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/",
                                url: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/" + assetName + ".json", //objAsset.assetSource
                                assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                            });
                            arrStorage.push({
                                type: "asset",
                                styleName: "",
                                fillType: filltype,
                                slideID: strSlideID,
                                appearance: appearance,
                                id: assetName, //objAsset.assetSource,
                                movieClipAsset: objAsset,
                                assetWidth: objAsset.assetWidth,
                                assetHeight: objAsset.assetHeight,
                                folderPath: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/",
                                url: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/" + assetName + ".png", //objAsset.assetSource
                                assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                            });
                        }
                    } else {
                        arrStorage.push({
                            type: "json",
                            styleName: "",
                            fillType: filltype,
                            slideID: strSlideID,
                            appearance: appearance,
                            id: assetName, //objAsset.assetSource,
                            movieClipAsset: objAsset,
                            assetWidth: objAsset.assetWidth,
                            assetHeight: objAsset.assetHeight,
                            folderPath: "genericassets/shapes/" + assetName + "/",
                            url: "genericassets/shapes/" + assetName + "/" + assetName + ".json", //objAsset.assetSource
                            assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                        });
                        arrStorage.push({
                            type: "asset",
                            styleName: "",
                            fillType: filltype,
                            slideID: strSlideID,
                            appearance: appearance,
                            id: assetName, //objAsset.assetSource,
                            movieClipAsset: objAsset,
                            assetWidth: objAsset.assetWidth,
                            assetHeight: objAsset.assetHeight,
                            folderPath: "genericassets/shapes/" + assetName + "/",
                            url: "genericassets/shapes/" + assetName + "/" + assetName + ".png", //objAsset.assetSource
                            assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                        });
                    }
                }
            }
        }
    }
};

CssChartAssetManager.prototype.getIconList = function (strSlideID, strGroupName, arrStorage = [], xmlData, chartName = null) {
    let iconGroup;
    let arrAssets = arrStorage.length == 0 ? [] : arrStorage;
    let length = xmlData.children.length;
    let iconCount = 0;
    let defaultIconCount = 0;
    let defaultIcons = this.getDefaultContentForType("icon");
    for (let i1 = 0; i1 < length; i1++) {
        if (defaultIconCount >= defaultIcons.length) {
            defaultIconCount = 0;
        }
        if (defaultIcons && defaultIcons.length > defaultIconCount) {
            this.STR_DEFAULT_ICONPATH = defaultIcons[defaultIconCount]["value"];
            this.STR_DEFAULT_ICONID = defaultIcons[defaultIconCount]["id"];
        }
        defaultIconCount++;
        let placeholderpath = chartName ? xmlData.children[i1].getAttribute("itemplaceholderpath") : xmlData.children[i1].getAttribute("placeholderpath");
        let placeholder = chartName ? xmlData.children[i1].getAttribute("itemplaceholder") : xmlData.children[i1].getAttribute("placeholder");
        let hasOldErrorSvgnode = placeholder?.startsWith("cdn") || placeholder == "devcdn";
        if (hasOldErrorSvgnode) {
            if (chartName) {
                xmlData.children[i1].setAttribute("itemplaceholderpath", this.STR_DEFAULT_ICONPATH);
                xmlData.children[i1].setAttribute("itemplaceholder", this.STR_DEFAULT_ICONID);
            } else {
                xmlData.children[i1].setAttribute("placeholderpath", this.STR_DEFAULT_ICONPATH);
                xmlData.children[i1].setAttribute("placeholder", this.STR_DEFAULT_ICONID);
            }
        }
        if (placeholderpath && placeholder && !hasOldErrorSvgnode) {
            arrAssets.push({ type: "icon", url: placeholderpath, id: placeholder, slideID: strSlideID });
        } else {
            let itemPlaceHolderIcons = xmlData.getAttribute("data-icon") ? xmlData.getAttribute("data-icon").split(",") : "";
            if (itemPlaceHolderIcons && !xmlData.children[i1].getAttribute("itemplaceholder")) {
                placeholderpath = xmlData.children[iconCount].getAttribute("itemplaceholderpath");
                placeholder = xmlData.children[iconCount].getAttribute("itemplaceholder");
                if (placeholderpath && placeholder) {
                    xmlData.children[i1].setAttribute("itemplaceholder", placeholder);
                    xmlData.children[i1].setAttribute("itemplaceholderpath", placeholderpath);
                    arrAssets.push({ type: "icon", url: placeholderpath, id: placeholder, slideID: strSlideID });
                } else {
                    arrAssets.push({ type: "icon", url: this.STR_DEFAULT_ICONPATH, id: this.STR_DEFAULT_ICONID, slideID: strSlideID });
                }
                iconCount++;
                if (itemPlaceHolderIcons.length == iconCount) {
                    iconCount = 0;
                }
            } else {
                arrAssets.push({ type: "icon", url: this.STR_DEFAULT_ICONPATH, id: this.STR_DEFAULT_ICONID, slideID: strSlideID });
            }
        }
    }
    return arrAssets;
};

CssChartAssetManager.prototype.getCommonIconList = function (strSlideID, strGroupName, arrStorage = [], xmlData, chartName = null) {
    let iconGroup;
    let arrAssets = arrStorage.length == 0 ? [] : arrStorage;

    let commonplaceholderpath = xmlData.getAttribute("commonplaceholderpath");
    let commonplaceholder = xmlData.getAttribute("commonplaceholder");

    if (commonplaceholderpath && commonplaceholder) {
        arrAssets.push({ type: "icon", url: commonplaceholderpath, id: commonplaceholder, slideID: strSlideID });
    } else {
        if (xmlData.getAttribute("commonplaceholdertype") == "image") {
            arrAssets.push({ type: "image", url: this.STR_DEFAULT_IMAGEPATH, id: "placeholder", slideID: strSlideID });
        } else {
            arrAssets.push({ type: "icon", url: this.STR_DEFAULT_ICONPATH, id: this.STR_DEFAULT_ICONID, slideID: strSlideID });
        }
    }

    return arrAssets;
};

CssChartAssetManager.prototype.getAssetListDetails = function (xmlData, menuData, boolEnablePattern = false, boolEnableLineHead = false) {
    let graphicName = xmlData.getAttribute("graphicname");
    let className = xmlData.getAttribute("name");
    let userAsset = xmlData.getAttribute("userasset");
    let childrenLength = xmlData.children.length;
    let jsonChartItemMetaData = menuData;
    if (!jsonChartItemMetaData) {
        return null;
    }
    let layoutItems = jsonChartItemMetaData && jsonChartItemMetaData?.template?.chartlayout ? jsonChartItemMetaData?.template?.chartlayout.item : "";
    let layoutData = null;
    if (jsonChartItemMetaData && boolEnablePattern && jsonChartItemMetaData?.template?.chartlayout) {
        let layoutBgItem = jsonChartItemMetaData?.template?.chartlayout ? jsonChartItemMetaData?.template?.chartlayout.background : "";
        if (layoutBgItem && layoutBgItem.fill && layoutBgItem.fill.length > 0 && layoutBgItem.fill[0] == "pattern") {
            layoutData = { assetName: layoutBgItem.fill[1] };
            return layoutData;
        }
        if (layoutItems && layoutItems.fill && layoutItems.fill.length > 0 && layoutItems.fill[0] == "pattern") {
            layoutData = { assetName: layoutItems.fill[1] };
            return layoutData;
        }
    } else {
        if (layoutItems && boolEnableLineHead && jsonChartItemMetaData && jsonChartItemMetaData?.template?.chartlayout) {
            let lineHeadShape = layoutItems.headStyle;
            if (lineHeadShape && lineHeadShape.type == "svg") {
                layoutData = { assetName: lineHeadShape.name };
                return layoutData;
            } else {
                return null;
            }
        } else {
            if (layoutItems && layoutItems.asset) {
                layoutData = { assetName: layoutItems.asset, assetType: layoutItems.type, appearance: layoutItems.appearance, multiasset: layoutItems.multiasset, assetfolder: layoutItems.id };
                let userAssetBounds = [];
                if (userAsset) {
                    userAssetBounds = this.getUserAssetBounds(userAsset);
                    layoutData.assetName = userAsset;
                }
                if (layoutItems.source) {
                    layoutData.assetSource = layoutItems.source;
                }
                if (layoutItems.assetsize && layoutItems.assetsize.length > 1) {
                    layoutData.assetWidth = layoutItems.assetsize[0];
                    layoutData.assetHeight = layoutItems.assetsize[1];
                }
                if (userAssetBounds && userAssetBounds.length > 0) {
                    layoutData.assetWidth = userAssetBounds[0];
                    layoutData.assetHeight = userAssetBounds[1];
                }
                return layoutData;
            } else {
                return null;
            }
        }
    }
};

CssChartAssetManager.prototype.getUserAssetBounds = function (userAsset) {
    switch (userAsset) {
        case "americandollar":
            return [770, 340];
            break;
        case "brazilianreais":
            return [680, 301];
            break;
        case "canadiandollars":
            return [770, 350];
            break;
        case "chineseyuan":
            return [688, 340];
            break;
        case "europeaneuro":
            return [581, 322];
            break;
        case "frenchfrancs":
            return [680, 384];
            break;
        case "indianrupees":
        case "japaneseyen":
            return [770, 325];
            break;
        case "singaporedollars":
            return [690, 328];
            break;
        case "newzealanddollar":
            return [770, 340];
            break;
        case "southafricanrand":
            return [770, 366];
            break;
        case "australiandollar":
            return [770, 340];
            break;
        case "swedishkrona":
            return [770, 340];
            break;
        case "unitedkingdompound":
            return [770, 340];
            break;
        default:
            return null;
            break;
    }
};
CssChartAssetManager.prototype.getDefaultContentForType = function (type = "image", subtype) {
    // Use iconstyle property set on the instance, with fallback to default
    let iconstyle = this.iconstyle || "fill";
    let assetDetails = {
        image: [
            {
                value: "https://devcdn.presentations.ai/docs/htmlAssets/assets/projectresources/genericassets/images/app/abstract1.jpg",
                type: "image",
                contenttype: "image",
            },
            {
                value: "https://devcdn.presentations.ai/docs/htmlAssets/assets/projectresources/genericassets/images/app/darkstreet.jpg",
                type: "image",
                contenttype: "image",
            },
            {
                value: "https://devcdn.presentations.ai/docs/htmlAssets/assets/projectresources/genericassets/images/app/abstract3.jpg",
                type: "image",
                contenttype: "image",
            },
            {
                value: "https://devcdn.presentations.ai/docs/htmlAssets/assets/projectresources/genericassets/images/app/abstract2.jpg",
                type: "image",
                contenttype: "image",
