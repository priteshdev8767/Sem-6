                gridNegLineElement.className = "gridcontainer";
                gridNegLineElement.style.position = "absolute";
                gridNegLineElement.style.width = this.viewport.width - this.gridValueSizeW - this.gridthickMarkerW + "px";
                gridNegLineElement.style.height = this.negBounds.height - this.negValueBounds.height - this.negativeHeight + "px";
                gridNegLineElement.style.left = this.rectSeries.left + "px";
                if (this.data.chartFlip) {
                    gridNegLineElement.style.bottom = this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                } else {
                    if (this.data.secondarylineNegativeValue) {
                        gridNegLineElement.style.top = this.viewport.height - this.negBounds.height - this.gridValueSizeH + "px";
                    } else {
                        gridNegLineElement.style.top = this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                    }
                }
                this.parent.appendChild(gridNegLineElement);
                let negHeight = 0;
                for (let i1 = 0; i1 < this.negativeGridCount; i1++) {
                    negHeight = this.negBounds.height / this.negativeGridCount + "px";
                    let lineElement = document.createElement("div");
                    lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                    lineElement.style.width = this.viewport.width - this.gridValueSizeW - this.gridthickMarkerW + "px";
                    lineElement.style.height = negHeight;
                    lineElement.dataset.animation = "gridlines";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        lineElement.style.opacity = "0";
                        lineElement.style.visibility = "hidden";
                    }
                    if (this.data.layout.gridLineOpacity) {
                        lineElement.style.opacity = this.data.layout.gridLineOpacity;
                    }
                    if (this.data.layout.gridLineColor) {
                        let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.gridLineColor, "bordercolor");
                        lineElement.classList.add(colorValue);
                    }
                    if (this.data.layout.gridLineStyle) {
                        lineElement.style.borderTopStyle = this.data.layout.gridLineStyle;
                    }
                    if (this.data.layout.gridLineStyleClass) {
                        lineElement.classList.add(this.data.layout.gridLineStyleClass);
                    }
                    if (this.data.layout.gridLineThickness) {
                        lineElement.style.borderTopWidth = this.data.layout.gridLineThickness;
                    }
                    gridNegLineElement.appendChild(lineElement);
                    lineElementHeight = lineElement.clientHeight;
                    lineElement.classList.add("reverse");
                    if (i1 == this.negativeGridCount - 1 && this.move3dY) {
                        let width = lineElement.clientWidth;
                        let moveX = Math.round(10);
                        width = width - moveX;
                        let height = lineElement.clientHeight + Math.round(lineElement.clientHeight * 0.07);
                        let intY = Math.round(height * 0.2) + Math.round(lineElement.clientHeight * 0.09);
                        let moveY = 0;
                        let svg3dshape = this.data.SVGUtils.createSVGElement("svg");
                        this.data.SVGUtils.assignAttributes(svg3dshape, {
                            width: "100%",
                        });
                        svg3dshape.style.position = "absolute";
                        svg3dshape.style.top = lineElement.offsetTop + lineElement.clientHeight + "px";
                        gridNegLineElement.appendChild(svg3dshape);
                        let pathElement = this.data.SVGUtils.createSVGElement("path");
                        this.data.SVGUtils.assignAttributes(pathElement, {
                            d: "M0" + "," + intY + "L" + moveX + "," + moveY + "L" + (width + moveX) + "," + moveY + "L" + width + "," + intY + " Z",
                            "fill-opacity": 0.15,
                            class: "moodanimation",
                            "data-animation": "gridlines",
                            fill: "rgba(var(--th-slide-contrast),1)",
                        });
                        svg3dshape.appendChild(pathElement);
