            elementType == "secondarylabel" ||
            elementType == "valueheader" ||
            elementType == "secondaryheader" ||
            elementType == "labelheader" ||
            elementType == "sourcetext" ||
            elementType == "charttiletext" ||
            elementType == "projectiontext" ||
            elementType == "itemheader" ||
            elementType == "seriesItemLabel" ||
