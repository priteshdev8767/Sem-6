let svgAssetdummey = null;
function SimpleScaleBarChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleScaleBarChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleScaleBarChart.prototype = Object.create(BaseBarChart.prototype);
SimpleScaleBarChart.prototype.constructor = SimpleScaleBarChart;

SimpleScaleBarChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleScaleBarSeries"](argparent, argprops);
};

SimpleScaleBarChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveY = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
    if (this.data.layout.enableBackground && this.data.layout.backgroundItemType == "svg") {
        this.createGraphicsShape("", "", true);
    }
    this.createGraphicsShape();
};

SimpleScaleBarChart.prototype.createGraphicsShape = function (argparent, argprops, bgItem = false) {
    let slide = document.getElementById(this.voData.slideID);

    let element = this.parent.querySelectorAll(".chartgraphic");
    if (bgItem) {
        element = this.parent.querySelectorAll(".backgroundItem");
    }
    this.asset = this.data.asset.data[0].data;
    this.assetName = this.data.asset.name;
    for (let i1 = 0; i1 < element.length; i1++) {
        let index = element[i1] && element[i1].getAttribute("id") && element[i1].getAttribute("id").split("-").length > 1 && element[i1].getAttribute("id").split("-")[1].split("_").length > 0 ? parseInt(element[i1].getAttribute("id").split("-")[1].split("_")[0]) : i1;
        let itemMinSize = 43;
        let intGraphicsWidth = itemMinSize < element[i1].clientWidth ? element[i1].clientWidth : itemMinSize; //argparent.getAttribute("data-width");
        let intGraphicsHeight = this.data.layout.labelVPosition == "top" || this.data.layout.valueVPosition == "top" || this.data._customProperties.showMergeItems ? element[i1].clientHeight : element[i1].clientHeight;
        // let oldPercentageW = element[i1].getAttribute("data-oldpercentage");
        // let newPercentageW = element[i1].getAttribute("data-newpercentage");
        let percentageDiff = itemMinSize < element[i1].clientWidth ? 0 : itemMinSize - element[i1].clientWidth;

        // let intGraphicsWidth = this.data._customProperties.showMergeItems ? argparent.getAttribute("data-width") : argparent.getAttribute("data-width") * 0.7;
        // let intGraphicsHeight = argparent.getAttribute("data-height");

        let clstyle = this.data.hasEmphasis && this.data.emphasis[index] != true ? "clsSecondaryFill" : this.data.hasEmphasis && this.data.emphasis[index] == true ? "cf-fill-section-primary" : this.getBgFillDetails(index, this.data.ChartFonts.appendgraphicFillColor(index), this.data.layout.itemColor, "bgcolor"); //"accent" + (index + 1) + "-fill";
        if (bgItem) {
            clstyle = this.data.hasEmphasis && this.data.emphasis[index] != true ? "clsSecondaryFill" : this.data.hasEmphasis && this.data.emphasis[index] == true ? "cf-fill-section-primary" : this.getBgFillDetails(index, this.data.ChartFonts.appendgraphicFillColor(index), this.data.layout.backgroundColor, "bgcolor"); //"accent" + (index + 1) + "-fill";
        }
        // let previousElement =  element[i1].querySelector("#graphicmask-container");
        // previousElement.remove();
        let svgGraphicMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
            id: "graphicmask-container",
            x: "0%",
            y: "0%",
            width: "100%",
            // filter: "url(#f1" +index + ")",
            height: intGraphicsHeight,
            class: clstyle + "  cs-chart-main-graphic",
        });
        svgGraphicMaskContainer.style.strokeOpacity = "0";
        if (bgItem && this.data.layout.backgroundOpacity) {
            this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
                "fill-opacity": this.data.layout.backgroundOpacity,
            });
        }
        if (this.data.projection[index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.add("clsSecondaryFill");
        }

        if (this.data.projection[index] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.add("prjectionOpacity");
            svgGraphicMaskContainer.dataset.customopacity = "0.5";
        }
        if (this.data.projection[index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.remove("cf-fill-section-primary");
            svgGraphicMaskContainer.classList.add("acf-fill-section-primary");
        }
        if (this.data.projection[index] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.remove("cf-fill-section-primary");
            svgGraphicMaskContainer.classList.add("cf-fill-section-primary");
        }
        element[i1].appendChild(svgGraphicMaskContainer);
        let maskElements = element[i1].querySelectorAll("#graphicmask-container");
        for (let j1 = 1; j1 < maskElements.length; j1++) {
            maskElements[0].remove();
        }
        let defs = this.data.SVGUtils.createSVGElement("defs");
        svgGraphicMaskContainer.appendChild(defs);

        let svgMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgMaskContainer, {
            id: "mask-container",
            x: "0%",
            y: "0%",
            width: "100%",
            height: "100%",
            "data-mask": "true",
        });
        svgGraphicMaskContainer.appendChild(svgMaskContainer);
        let svgRect = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(svgRect, {
            id: "rect-container",
            class: clstyle,
            x: "0%",
            y: "0%",
            width: "100%",
            height: "100%",
        });
        if (this.data.layout.itemColor == "gradient") {
            this.data.SVGUtils.assignAttributes(svgRect, {
                class: "",
            });
            this.addGradient(svgRect, svgMaskContainer);
        }

        if (this.data.layout.itemShadowValues.length > 0) {
            let filterTag = this.data.SVGUtils.createSVGElement("filter");
            defs.appendChild(filterTag);
            this.data.SVGUtils.assignAttributes(filterTag, {
                id: "f1" + index,
                x: "0",
                y: "0",
                width: "100%",
                height: "100%",
            });

            let insetFilterTag1 = this.data.SVGUtils.createSVGElement("feOffset");
            this.data.SVGUtils.assignAttributes(insetFilterTag1, {
                result: "offOut",
                in: "SourceGraphic",
                dx: this.data.layout.itemShadowValues[0],
                dy: this.data.layout.itemShadowValues[1],
            });
            filterTag.appendChild(insetFilterTag1);
            let insetFilterTag3 = this.data.SVGUtils.createSVGElement("feGaussianBlur");
            this.data.SVGUtils.assignAttributes(insetFilterTag3, {
                result: "blurOut",
                in: "offOut",
                stdDeviation: this.data.layout.itemShadowValues[2],
            });
            filterTag.appendChild(insetFilterTag3);
            let insetFilterTag2 = this.data.SVGUtils.createSVGElement("feBlend");
            this.data.SVGUtils.assignAttributes(insetFilterTag2, {
                in: "SourceGraphic",
                in2: "inOut",
                mode: "normal",
            });
            filterTag.appendChild(insetFilterTag2);
        }

        let svgContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgContainer, {
            id: "container",
            x: "0%",
            y: "0%",
            width: intGraphicsWidth + "px",
            height: "100%",
            style: "position:absolute;overflow:hidden!important",
        });
        svgMaskContainer.appendChild(svgContainer);

        // if (this.data.projection[i1] == true && this.data.hasProjection) {
        //     this.createProjection(svgContainer, i1);
        // }
        //
        let rotate = element[i1].getAttribute("data-negative") ? 180 : 0;
        let svgBaseGroup = this.data.SVGUtils.createSVGElement("g");
        this.data.SVGUtils.assignAttributes(svgBaseGroup, {
            style: rotate == 180 ? "transform-origin:center; transform:rotate(" + rotate + "deg)" : "",
            "data-animation": "shapeitem",
            "data-graphic-x": element[i1].clientWidth,
            class: "moodanimation",
        });
        // if (this.data.projection[i1] == true && this.data.hasProjection) {
        //     this.data.SVGUtils.assignAttributes(svgBaseGroup, {
        //         mask: "url(#mask" + i1 + "_" + 0 + ")",
        //     });
        // }
        svgContainer.appendChild(svgBaseGroup);
        let svgGroup = this.data.SVGUtils.createSVGElement("g");
        svgBaseGroup.appendChild(svgGroup);
        let svgAsset;
        if (!this.asset) {
            svgAsset = this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0].cloneNode("true");
            this.data.SVGUtils.assignAttributes(svgAsset, {
                width: "",
                height: "",
            });
        } else {
            svgAsset = this.asset.cloneNode(true);
        }
        // let svgAsset = new DOMParser().parseFromString(this.asset, "image/svg+xml").documentElement.cloneNode(true);
        svgGroup.appendChild(svgAsset);
        let arrViewBox = svgAsset.getAttribute("viewBoxDefault") ? svgAsset.getAttribute("viewBoxDefault").split(" ") : svgAsset.getAttribute("viewboxdefault").split(" ");
        let numProportionateScale = intGraphicsHeight / arrViewBox[3];
        let numContainerProportionateScale = 100 / (numProportionateScale * 100);
        let minSize = arrViewBox[2] * (100 / intGraphicsWidth);
        //let boolMiniSize = intGraphicsWidth * 0.5 < arrViewBox[2] ? true : false;

        // let clstyle =
        //     this.data.hasEmphasis && this.data.emphasis[index] != true
        //         ? "contrast-fill"
        //         : this.data.hasEmphasis && this.data.emphasis[index] == true
        //         ? "accent" + (index + 1) + "-fill"
        //         : "accent" + (index + 1) + "-fill";
        this.data.SVGUtils.assignAttributes(svgGroup, {
            //class: clstyle,
            style: "transform : translateX(" + -parseInt(percentageDiff) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",
        }); // percentageDiff == 0  : "transform: translateX(" + -parseInt(percentageDiff*0.5) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",?
        this.data.SVGUtils.assignAttributes(svgAsset, {
            width: numContainerProportionateScale * 100 + "%",
            height: numContainerProportionateScale * 100 + "%",
        });
        this.updateSize(svgAsset, intGraphicsWidth * numContainerProportionateScale, intGraphicsHeight);
    }
};

SimpleScaleBarChart.prototype.createProjection = function (argParent, index) {
    let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
    let patternTag = this.data.SVGUtils.createSVGElement("pattern");
    this.data.SVGUtils.assignAttributes(patternTag, {
        id: "pattern",
        patternUnits: "userSpaceOnUse",
        width: "20",
        height: "20",
    });
    patternDefsTag.appendChild(patternTag);
    let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(patternMaskTag, {
        id: "mask" + index + "_" + 0,
        patternUnits: "userSpaceOnUse",
    });
    patternDefsTag.appendChild(patternMaskTag);
    let patternImageTag = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(patternImageTag, {
        "xlink:href": "#chartprojectionpattern",
    });
    patternTag.appendChild(patternImageTag);
    let patternRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(patternRect, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        fill: "url(#pattern)",
    });
    patternMaskTag.appendChild(patternRect);
    argParent.appendChild(patternDefsTag);
};

SimpleScaleBarChart.prototype.updateSize = function (svgAsset, width, height) {
    let lw = this.getViewBoxValue(svgAsset.getElementById(this.assetName.toLowerCase() + "-left"), 2);
    let rw = this.getViewBoxValue(svgAsset.getElementById(this.assetName.toLowerCase() + "-right"), 2);
    let cw = width - (lw + rw) + 3;
    let intpad = 1;
    cw = cw < 0 ? 1 : cw;
    cw += intpad;
    if (cw != NaN && rw != 0) {
        let x = Number(svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").getAttribute("x")) - intpad / 2;
        x = x < 0 ? 1 : x;
        svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").setAttribute("x", 1);
        svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").setAttribute("width", cw);
    }
};

SimpleScaleBarChart.prototype.getViewBoxValue = function (element, index) {
    return element != null ? parseFloat(element.getAttribute("viewBox").split(/\s+|,/)[index]) : 0;
};

// import BaseBarSeries from "../../base/baseChartBar/BaseBarSeries";
// import SimpleScaleBarSeriesItem from "./SimpleScaleBarSeriesItem.js";
function SimpleScaleBarSeries(argparent, argprops){
    this.name = "SimpleScaleBarSeries";
    BaseBarSeries.call(this, argparent, argprops);
    this.svgAsset = true;
}
SimpleScaleBarSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleScaleBarSeries.prototype.constructor = SimpleScaleBarSeries;

SimpleScaleBarSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new window["SimpleScaleBarSeriesItem"](argparent, argprops)
}

// let valueMaxW = 0;
// let valueMaxH = 0;
// let labelMaxW = 0;
// let labelMaxH = 0;
// let graphicW;
// let oldpercentage;
// let newpercentage;
// let percentageW;
// let objValue;
// let overlapStackedBar = false;
// let dropShadowHeight = 10;
function SimpleScaleBarSeriesItem(argparent, argprops) {
    this.name = "SimpleScaleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.minValueFontSize = [25, 25];
    BaseBarSeriesItem.call(this, argparent, argprops);
}
SimpleScaleBarSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
SimpleScaleBarSeriesItem.prototype.constructor = SimpleScaleBarSeriesItem;
SimpleScaleBarSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.thicknessPercentage = this.data.layout.itemthickness && this.data.seriesItemLength < 2 ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") this.length = 1;

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });
    this.labelMaxW = this.data.chartName == "comparisonModelType3" ? this.state.width * 0.3 * 0.5 : this.state.width * 0.3;
    this.labelMaxH = this.data.chartName.includes("comparisonModel") && this.labelAlignment.hposition == "center" ? this.state.height : this.state.height * this.gapPercentage * this.thicknessPercentage * 0.7;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });
    this.valueMaxW = this.state.width * 0.3;
    this.valueMaxH = this.valueAlignment.itemBased == "true" ? (this.state.height * 0.4) / this.length : (this.state.height * this.gapPercentage * this.thicknessPercentage) / this.length;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        padding: this.data.layout.placeholderPadding,
    });
    if (this.placeholderAlignment.position == "middle") {
        this.removeGrid();
        this.data.data.setAttribute("enablegrid", "false");
    } else {
        this.data.data.setAttribute("enablegrid", "");
    }
    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") this.labelMaxH = this.valueMaxH = this.state.height * 0.4;
        else {
            if (this.labelAlignment.itemBased == "true") {
                this.labelMaxH = this.state.height * 0.4;
                this.valueMaxH = this.state.height * 0.6;
            } else {
                this.labelMaxH = this.state.height * 0.6;
                this.valueMaxH = this.state.height * 0.4;
            }
            if (this.labelAlignment.itemBased == "true" && this.labelAlignment.vposition == "top" && this.labelAlignment.hposition == "left" && this.labelAlignment.inset == "outside") {
                this.labelMaxH = this.state.height * 0.5;
                this.valueMaxH = this.state.height * 0.4;
            }
        }
    }
};
SimpleScaleBarSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    this.boolEnableInnerValue = false;
    let highlightDifferenceHeight = 0;
    if (this.data.indualHighlight) {
        highlightDifferenceHeight = 100;
    }
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = 70;
        if (this.data.layout.valueInset == "bgoutside" || this.valueAlignment.itemBased == "true") {
            highlightDifferenceHeight = 120;
        }
    }
    this.data.hdHeight = highlightDifferenceHeight;
    // if (this.displayValue(argprops)) {
    //     if (this.valueAlignment.itemBased == "true") {
    //         this.valueStyle =
    //             this.data.hasEmphasis && this.data.emphasis[groupindex] != true
    //                 ? this.ChartFonts.valueOuterColor
    //                 : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
    //                 ? this.ChartFonts.graphicColor(groupindex)
    //                 : this.ChartFonts.valueOuterColor;
    //         const subValueElement = this.ChartHelper.createDivElement({});
    //         subValueElement.id = "topvalue-" + groupindex + "_" + index;
    //         subValueElement.className = "topvalue ";
    //         subValueElement.style.width = graphicWidthPercentage * 100 + "%";
    //         argparent.appendChild(subValueElement);
    //         this.doAddRightValue(subValueElement, argprops);
    //     }
    // }

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    if (this.data.layout.itemBgBorder || this.data.layout.itemBgBorder == "true") {
        element.style.border = "2px solid";
        dropShadowHeight = 0;
        element.classList.add(this.data.chartFonts.appendgraphicBgColor(index));
    }
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }

        element.style.alignItems = "flex-start";
    }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddRightValue(element, argprops, true);
    if (this.labelAlignment.position == "inner") {
        this.doAddLabel(element, argprops, false, true);
    }
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.labelMaxW * 0.5;
        this.middleLH = this.labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middleVH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation ";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.placeholderAlignment.position == "middle";
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
        this.middlePW = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        this.middlePH = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation ";
        middleelementPlaceholder.setAttribute("data-animation", "primaryplaceholder");
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.seriesLength == 2 && this.labelAlignment.itemBased == "true") {
            middleelementPlaceholder.style.top = "3%";
        }
        if (this.data.layout.boolplaceholderShape) {
            this.bgProperties(middleelementPlaceholder);
        }
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder", true);
    }

    const parentWidth = this.state.width;
    let baseGraphicWidth;
    let valueWidth = argprops.minvalue < 0 ? 2 * (this.currentValW + 1) : this.currentValW;
    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") {
        baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + this.maxLabelW + dropShadowHeight + highlightDifferenceHeight);
    } else {
        if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right" && this.labelAlignment.itemBased != "true") {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight + valueWidth);
        } else {
            baseGraphicWidth = parentWidth - (parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW) + dropShadowHeight + highlightDifferenceHeight);
        }
    }
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const baseGraphicWidthPercentage = baseGraphicWidth;
    const bgGraphicWidthPercentage = baseGraphicWidth / parentWidth;
    let graphicWidthPercentage = baseGraphicWidthPercentage * (argprops.value / totalValue);
    graphicWidthPercentage = argprops.maxvalue == 0 ? 0 : graphicWidthPercentage;
    let parentPercentage = baseGraphicWidthPercentage * (argprops.totalvalue / totalValue);
    let parentWidthValue = this.state.width;
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right" && this.labelAlignment.itemBased != "true") {
        parentWidthValue = parentPercentage + this.currentValW;
    }

    let seriesItem = this.parent.querySelector(".rightseriesitem");
    seriesItem.style.width = this.data.SVGUtils.createPercentValue(this.state.width, parentPercentage + this.currentValW);
    seriesItem.dataset.parentSeriesWidth = parentPercentage + this.currentValW;

    let leftSeriesItem = this.parent.querySelector(".leftseriesitem");
    if (leftSeriesItem && this.data.minValue && this.data.minValue < 0) {
        let baseParentWidth = this.parent.querySelector(".baseseriesitem") ? this.parent.querySelector(".baseseriesitem").clientWidth : 0;
        baseParentWidth = baseParentWidth < this.state.width ? this.state.width : baseParentWidth;
        leftSeriesItem.style.width = this.data.SVGUtils.createPercentValue(this.state.width, baseParentWidth - (parentPercentage + this.currentValW));
        leftSeriesItem.dataset.parentSeriesWidth = baseParentWidth - (parentPercentage + this.currentValW);
    }

    let backgroundElement;
    if (this.data.layout.enableBackground) {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        let bgStyleClass = this.ChartFonts.emphasizeColor;
        if (this.data.layout.backgroundColor == "transparent") {
            bgStyleClass = " transparent";
        }
        if (this.data.layout.backgroundColor == "theme") {
            bgStyleClass = this.ChartFonts.graphicBgColor(groupindex);
        }
        backgroundElement.className = "backgroundItem moodanimation" + bgStyleClass;
        if (this.data.layout.backgroundItemType == "svg") {
            backgroundElement.className = "backgroundItem moodanimation";
        }
        backgroundElement.style.width = baseGraphicWidthPercentage * 100 + "%";
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
        if (this.data.layout.backgroundBorder) {
            let backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = " moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = baseGraphicWidthPercentage * 100 + "%";
            backgroundBorderElement.style.height = this.thicknessPercentage * 100 + "%";
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            if (this.data.layout.backgroundBorder.color == "theme") {
                let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
                backgroundBorderElement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
                // if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                //     this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
                // }
            }
        }
    }

    //"graphicbg";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(parentWidthValue, graphicWidthPercentage);
    subelement.style.height = 100 * this.thicknessPercentage + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = "calc(" + graphicWidthPercentage * 100 + "% - " + this.middlePH * 0.5 + "px)";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleVH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
                subelement.style.marginLeft = this.middlePH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleLH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let strStyleClass = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    const clsStyle = strStyleClass + " moodanimation transformOrginLeft";
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.dataset.customorgin = "left";

    graphicElement.className = "chartgraphic graphicnode ";
    if (index == 0 && this.data.chartName.includes("comparisonModel")) {
        graphicElement.dataset.customorgin = "right";
    }
    // if(this.data.hasEmphasis)
    // {
    //     graphicElement.classList.add("cs-chart-main-graphic")
    // }
    if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.data.seriesLength / 2) {
        graphicElement.dataset.customorgin = "left";
    }
    graphicElement.style.width = 100 + "%";
    graphicElement.style.height = "100%";
    if (this.data.chartName == "barStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") graphicElement.style.borderRadius = this.valueMaxH + "px";
    if (this.data.chartName == "barFillRectangle") graphicElement.style.position = "absolute";
    subelement.appendChild(graphicElement);
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");

    if (this.voData.layout.backgroundBorderRadiusValues && backgroundElement) {
        let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }

    strStyleClass = "";

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    let colorStyle = this.data.layout.itemBoxShdowColor == "item" ? clsStyle : "";
    let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);

    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "borderelement";
        borderElement.style.width = 100 + "%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);
        graphicElement.classList.remove(this.data.chartFonts.appendgraphicBgColor(styleIndex));
        graphicElement.classList.remove("background-bg-color");
        graphicElement.classList.add("background-bg-color");
        if (this.voData.shapeBoderColor == "theme") {
            let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
            borderElement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
            this.emphasisColor = " secondary-border-color";
            // if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
            //     // let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex)
            //     let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
            // }
            // if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //     this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex)
            // }
            borderElement.classList.add("moodanimation");
            borderElement.dataset.animation = "itemborder";
            borderElement.setAttribute("data-graphic-x", graphicElement.clientWidth);
        }

        borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
    }
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
    if (borderElement) {
        borderElement.classList.remove("borderelement");
        borderElement.classList.add("borderelement");
    }
    let itembasedPlaceHolder = "";
    if (this.displayPrimaryPlaceholder(argprops)) {
        graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.placeholderAlignment.position == "outer" || graphicW < this.state.height * 0.6) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            if (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.hposition == "left") {
                itembasedPlaceHolder = this.ChartHelper.createDivElement({});
                itembasedPlaceHolder.style.display = "flex";
                itembasedPlaceHolder.style.justifyContent = "center";
                itembasedPlaceHolder.style.alignItems = "center";
                itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
                element.parentNode.appendChild(itembasedPlaceHolder);
                if (this.placeholderAlignment.vposition == "bottom") {
                    element.parentNode.style.alignItems = "flex-end";
                }
                this.doAddRightPlaceholder(itembasedPlaceHolder, argprops);
                element.parentNode.style.flexDirection = "row-reverse";
            } else {
                this.doAddRightPlaceholder(element, argprops);
            }
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            subelement.style.display = "flex";
            subelement.style.justifyContent = "flex-end";
            if (this.placeholderAlignment.hposition == "left") {
                graphicElement.style.alignItems = "center";
                this.doAddRightPlaceholder(graphicElement, argprops, "", true);
            } else {
                this.doAddRightPlaceholder(subelement, argprops);
            }
        }
    }
    if ((this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true") && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")) {
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        subelement.appendChild(sameElement);

        if (this.labelAlignment.samepos == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddRightValue(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true") {
        // this.doAddLabel(element, argprops, true)
        graphicW = graphicWidthPercentage;
        if (this.data.chartName.includes("comparisonModel") && this.valueAlignment.position == "inner") {
            graphicW = subelement.clientWidth;
        }
        this.doAddRightValue(element, argprops, true);
        // let boolOverlap = (graphicBaseelement.clientWidth - graphicContainerElement.clientWidth) < valueMaxW;
        let boolEnableInnerValue = (this.data.layout.itemBgBorder || this.data.layout.itemBgBorder == "true") && element.clientWidth - subelement.clientWidth < this.currentValW;
        if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && !boolEnableInnerValue) || graphicW < this.currentValW) {
            this.valueStyle = "";

            let boolOrder = graphicW < this.innerlabelmaxWidth && this.labelAlignment.position == "inner" && this.valueAlignment.itemBased != "true" ? true : false;
            if (this.data.chartName == "barStackedRectangle") {
                overlapStackedBar = true;
                this.removeValueElement();
            }
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill" || this.data.layout.valueInset == "bgoutside") {
                this.valueAlignment.position == "inner" ? this.doAddRightValue(element, argprops) : this.doAddRightValue(argparent, argprops);
            } else {
                graphicW = Math.round(subelement.clientWidth) - (this.currentValW + this.data.layout.valuePaddingleft);
                if (this.labelAlignment.itemBased == "true" && graphicW < this.currentValW) {
                    let baseContainer = this.ChartHelper.createDivElement({});
                    baseContainer.style.width = "100%";
                    baseContainer.style.height = subelement.style.height;
                    (baseContainer.style.display = "flex"), subelement.parentNode.appendChild(baseContainer);
                    subelement.style.height = "100%";
                    baseContainer.appendChild(subelement);
                    this.doAddRightValue(baseContainer, argprops);
                } else {
                    if (this.labelAlignment.itemBased == "true") this.doAddRightValue(subelement, argprops);
                    else this.doAddRightValue(element, argprops, false, boolOrder);
                }
            }
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") || boolEnableInnerValue) {
            let vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            if (this.data.chartName.includes("comparisonModel") && index == 1) {
                vLayoutName = this.valuelayoutClassName("containervalue", true);
                valueElement.className = "valueelement " + vLayoutName;
            }
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;

            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            // else subelement.style.justifyContent = "flex-end";
            this.boolEnableInnerValue = true;
            this.doAddRightValue(valueElement, argprops);
        }
        if (this.data.layout.itemFillType == "pattern") {
            this.createPatternSvg(graphicElement);
        }
        if (this.data.layout.backgroundFillType == "pattern") {
            this.createPatternSvg(backgroundElement, true);
        }
    }

    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true" && this.voData.chartName != "comparisonModelType2") {
        graphicW = graphicWidthPercentage;

        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            this.doAddRightValue(element, argprops, true);
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            let elementHeight = 2 - this.thicknessPercentage;
            let containerAlignment = vLayoutName == "itemlabelleftbottom" ? "itemlabellefttop" : "itemlabelleftbottom";
            labelElement.className = "itembasedlabelelement " + containerAlignment;
            labelElement.style.width = graphicElement.clientWidth - this.currentValW + "px";
            if (this.valueAlignment.position == "inner") {
                labelElement.style.width = element.clientWidth + "px";
            }
            element.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labelMaxW = element.clientWidth;
            this.doAddLabel(labelElement, argprops);
            this.valueMaxH = subelement.clientHeight;
            if (this.valueAlignment.itemBased != "true") {
                labelElement.style.maxHeight = elementHeight * 100 + "%";
                labelElement.style.height = "auto";
                if (labelElement.children[0]) {
                    labelElement.children[0].style.height = "auto";
                    labelElement.parentNode.style.justifyContent = "center";
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
            } else {
                if (labelElement.children[0]) {
                    labelElement.style.minHeight = labelElement.children[0].clientHeight + "px";
                }
                let ValueElement = labelElement.parentNode.querySelector(".value");
                if (ValueElement) {
                    ValueElement.parentNode.style.minHeight = ValueElement.clientHeight + "px";
                }
            }
        } else if (this.labelAlignment.position == "outer" || graphicW <= this.innerlabelmaxWidth) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(element, argprops);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
            //     this.labelStyle = this.ChartFonts.labelOuterColor;
            //     if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
            //         this.labelStyle = this.ChartFonts.graphicColor(groupindex);
            //     }
            // }
            // if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
            //     this.labelStyle =this.ChartFonts.labelInnerColor;
            // }
            this.labelMaxW = subelement.clientWidth * 0.7 < this.labelMaxW ? this.labelMaxW : subelement.clientWidth * 0.7;
            if (this.placeholderAlignment.position == "middle") {
                this.middlePW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
                this.labelMaxW = this.labelMaxW - this.middlePW;
                this.placholderHPos = this.placeholderAlignment.hposition;
                this.doAddLabel(labelElement, argprops);
            } else {
                this.placholderHPos = "";
                this.doAddLabel(labelElement, argprops);
            }
        }
    }

    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic graphicnode " + clsStyle + " projection" + (groupindex + 1);
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     // graphicElement.classList.add("clsNodeSecondarybg");
    // } else {
    //     if (((this.data.hasEmphasis && this.data.emphasis[groupindex] != true) || (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey")) && this.data.shapeBorder) {
    //         let strBordeStyleClass = "secondary-border-color"
    //         if (borderElement) borderElement.classList.add(strBordeStyleClass)
    //         graphicElement.classList.remove("background-bg-color");
    //         graphicElement.classList.add("background-bg-color");
    //         let rgbaValue = this.ChartUtils.createRBGColor(strBordeStyleClass, styleIndex, this.data.layout.itemBoxShdowOpacity);
    //     }
    // }
    // if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
    //     const subImgelement = document.createElement("img");
    //     subImgelement.style.width = "100%";
    //     subImgelement.style.height = "100%";
    //     subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
    //     // subImgelement.style.position = "unset";
    //     subImgelement.id = "graphicimage-" + groupindex + "_" + index;
    //     subImgelement.className = "graphicimage";
    //     subImgelement.setAttribute("data-id", groupindex + "_" + index);
    //     subImgelement.setAttribute("data-type", "IMAGE");
    //     graphicElement.appendChild(subImgelement);
    //     let item = this.ChartUtils.getOffsetLeftTop(graphicElement);
    //     graphicElement.setAttribute("data-x", item.x);
    //     graphicElement.setAttribute("data-y", item.y);
    //     graphicElement.setAttribute("data-width", graphicElement.clientWidth);
    //     graphicElement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-width", graphicElement.clientWidth);
    //     subImgelement.setAttribute("data-height", graphicElement.clientHeight);
    //     subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

    //     subImgelement.setAttribute("data-x", item.x);
    //     subImgelement.setAttribute("data-y", item.y);
    //     graphicElement.style.position = "absolute";
    //     graphicElement.style.overflow = "hidden";
    //     this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img")
    //     if(this.data.layout.itemFillType=="imagewithfilter"){
    //         SlideUtils.applyOverlayToImage(subImgelement,"var(--item" + (styleIndex + 1) + "-color)")
    //        }
    // }
    if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
    }
    if (itembasedPlaceHolder) {
        itembasedPlaceHolder.style.height = graphicElement.clientHeight + "px";
    }
    if (backgroundElement) {
        backgroundElement.style.height = graphicElement.clientHeight + "px";
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.vposition == "top" && backgroundElement) {
            backgroundElement.style.top = graphicElement.parentNode.offsetTop + "px";
        }
    }
    ///DropShadow
    if (this.data.layout.itemShadow && this.data.chartName != "barStackedRectangle") {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};

function SimpleColumnChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleColumnChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleColumnChart.prototype.constructor = SimpleColumnChart;

SimpleColumnChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleColumnSeries"](argparent, argprops);
}



function SimpleColumnSeries(argparent, argprops) {
    this.name = "SimpleColumnSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleColumnSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleColumnSeries.prototype.constructor = SimpleColumnSeries;

SimpleColumnSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleColumnSeriesItem"](argparent, argprops);
}

function SimpleColumnSeriesItem(argparent, argprops){
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleColumnSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleColumnSeriesItem.prototype.constructor = SimpleColumnSeriesItem;


function SimpleStackedAreaChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleStackedAreaChart";
    this.intCircleRadius = 8;
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleStackedAreaChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleStackedAreaChart.prototype.constructor = SimpleStackedAreaChart;

SimpleStackedAreaChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleStackedAreaSeries"](argparent, argprops);
};
SimpleStackedAreaChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.data._secondaryLineChart) {
            this.seondaryGridValueSize = 60;
        }
        if (this.hadValidateData) {
            this.doAddAxisTitle();
            this.doAddGridValues();
            if (!this.data.hasMultiSlide) {
                this.doAddGraphicDesk();
            } else {
                this.doAddMultiSlideGraphicDesk();
            }
            if (this.data._secondaryLineChart) {
                this.updateSecondaryLineChart();
            }
            this.doAddGridDesk();
            if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
                this.doAddBaseLineDesk();
            }

            if (this.data.highlightDifference.display && !this.data.indualHighlight) {
                this.CreateHightlightDifference();
            }
            if (this.data.indualHighlight && this.data.seriesItemLength < 2) this.createIndualHighlight();
            if (this.data.indualHighlight && this.data.seriesItemLength == 2) this.createTwoSeriesIndualHighlight();
            this.calculateLinePoints();
            this.createTooltipCallout(this.parent, this.data);
            // this.adjustLegendDesk();
            this.doAddMetaData();
        }
    }
};

SimpleStackedAreaChart.prototype.calculateProjectionWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let width = projectionLength * indualWidth - indualWidth / 2;
    let x = startingProjectionPoint * indualWidth + indualWidth / 2;
    return { x: containerElement.offsetLeft + this.rectBaseSeries.x + x, width: width };
};

SimpleStackedAreaChart.prototype.calculateLinePoints = function () {
    let argParent = this.parent;
    let baseSeriesItem = argParent.querySelector(".baseseries");
    let valueElement = argParent.querySelectorAll(".value");
    let ValueHeight = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueElement[0].clientHeight) : 0;
    let drawingBaseAreaElement = argParent.querySelectorAll(".seriesitemcond");
    let drawingBaseAreaElementTop = drawingBaseAreaElement[0].offsetTop;
    let drawingAreaTopPosition = drawingBaseAreaElement[0].offsetTop + 2;
    let series = argParent.querySelectorAll(".series");
    let ColumnContainer = argParent.querySelector(".columnContainer");
    let containerOffsetLeft = ColumnContainer?.offsetLeft || 0;
    let containerOffsetTop = ColumnContainer?.offsetTop || 0;
    let parentOffsetLeft = ColumnContainer?.parentElement?.offsetLeft || 0;
    let containerChildrenOffsetLeft = ColumnContainer?.children[0]?.offsetLeft || 0;
    let drawingBaseAreaElementHeight = drawingBaseAreaElement[0].clientHeight;
    let drawingBaseAreaElementWidth = ColumnContainer?.children[0]?.clientWidth || 0;
    let actaulDrawingArea = drawingBaseAreaElementHeight - ValueHeight;
    let numMultipleFactor = actaulDrawingArea / this.data.rangeTotal;
    let points = [];
    for (let si = 0; si < this.data.seriesItemLength; si++) {
        points[si] = [];
        let length = this.data.seriesLength * 2;
        let indexValue = this.data.seriesLength - 1;
        for (let s = 0; s < length; s++) {
            let previousY = drawingBaseAreaElementHeight + drawingBaseAreaElementTop;
            let objPoints = {};
            let itemY = 0;
            let intX = 0;
            if (this.data.chartFlip) {
                previousY = 0;
            }
            let ValueNode = series[s]?.querySelector("[id=value-text-" + s + "_" + si + "]");
            if (s >= this.data.seriesLength) {
                if (si != 0) {
                    previousY = points[si - 1][indexValue].intY;
                }
                if (this.data.chartFlip) {
                    previousY = si == 0 ? 0 : points[si - 1][indexValue].intY;
                }
                intX = points[si][indexValue].x;
                objPoints = {
                    intY: previousY,
                    x: intX,
                };
                indexValue--;
                points[si].push(objPoints);
            } else {
                let numValue = this.data.values[s][si];
                let calculatedHeight = parseInt(numValue * numMultipleFactor);
                if (si != 0) {
                    previousY = points[si - 1][s].intY;
                }
                if (this.data.chartFlip) {
                    previousY = si == 0 ? 0 : points[si - 1][s].intY;
                }
                itemY = previousY - calculatedHeight;
                if (this.data.chartFlip) {
                    itemY = previousY + calculatedHeight;
                }
                intX = series[s].offsetLeft + series[s].clientWidth / 2;
                let ValuePosition = itemY - ValueHeight;
                if (this.data.chartFlip) {
                    ValuePosition = itemY;
                }
                objPoints = {
                    intY: itemY,
                    x: intX,
                };
                if (ValueNode) {
                    ValueNode.style.setProperty("position", "absolute", "important");
                    ValueNode.style.setProperty("top", ValuePosition + "px", "important");
                }
                points[si].push(objPoints);
                if (si == 0) {
                    series[s].classList.add("stackedareaseries");
                }
            }
        }
    }
    let LineAreaContainer = document.createElement("div");
    LineAreaContainer.style.position = "absolute";
    LineAreaContainer.style.width = drawingBaseAreaElementWidth + "px";
    LineAreaContainer.style.height = drawingBaseAreaElementHeight + "px";
    LineAreaContainer.style.left = containerOffsetLeft + parentOffsetLeft + containerChildrenOffsetLeft + "px";
    if (baseSeriesItem) {
        LineAreaContainer.style.top = baseSeriesItem.offsetTop + containerOffsetTop + "px";
    }
    if (this.data.chartFlip) {
        LineAreaContainer.style.top = drawingAreaTopPosition + "px";
    }
    argParent.appendChild(LineAreaContainer);
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "base-series-item",
        class: "commonitem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, 0),
        y: this.data.SVGUtils.createPercentValue(this.state.height, 0),
        width: drawingBaseAreaElementWidth,
        height: drawingBaseAreaElementHeight,
    });
    svgElement.style.setProperty("position", "absolute", "important");
    this.createPathSVG(points, svgElement, drawingBaseAreaElementWidth);
    LineAreaContainer.appendChild(svgElement);

    if (this.data.hasProjection) {
        let projectionElement = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(projectionElement, {
            id: "projection-base-series-item",
            class: "commonitem",
            x: this.data.SVGUtils.createPercentValue(this.state.width, 0),
            y: this.data.SVGUtils.createPercentValue(this.state.height, 0),
            width: drawingBaseAreaElementWidth,
            height: drawingBaseAreaElementHeight,
        });
        projectionElement.style.setProperty("position", "absolute", "important");
        LineAreaContainer.appendChild(projectionElement);
        this.createProjectionPathSVG(LineAreaContainer, projectionElement, points, drawingBaseAreaElementWidth);
    }
};
SimpleStackedAreaChart.prototype.createProjectionPathSVG = function (LineAreaContainer, projectionElement, points, drawingBaseAreaElementWidth) {
    let baseProjectionSeriesItem = LineAreaContainer?.cloneNode(true);
    let arrProjectionDisableSeriesItem = LineAreaContainer.querySelectorAll(".areaseriesitem");
    let arrSeriesItems = baseProjectionSeriesItem.querySelectorAll(".areaseriesitem");

    for (let si = 0; si < arrSeriesItems.length; si++) {
        let seriesItem = arrSeriesItems[si];
        projectionElement.appendChild(seriesItem);
        let linePathElement = seriesItem.querySelector(".itemlinepath");
        let areaPathElement = seriesItem.querySelector(".itemareapath");
        linePathElement.setAttribute("data-animation", "projectionstackeditemline" + (si + 1));
        areaPathElement.setAttribute("data-animation", "projectionstackeditemareapath" + (si + 1));
        let hasDashed = true;
        this.randomkey = Math.random();
        if (hasDashed) {
            //creating dashed line mask
            let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
            seriesItem.appendChild(patternDefsTag);
            let maskID = this.randomkey + this.data.slideID + "mask" + si;
            let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
            this.data.SVGUtils.assignAttributes(patternMaskTag, {
                id: maskID,
                class: "mask cs-line-area-projection-enabled",
                maskUnits: "userSpaceOnUse",
            });
            patternDefsTag.appendChild(patternMaskTag);
            let ProjectionMaskLine = linePathElement.cloneNode(true);
            ProjectionMaskLine.classList.add("clsProjectionMaskLine");
            patternMaskTag.appendChild(ProjectionMaskLine);
            linePathElement.setAttribute("mask", "url(#" + maskID + ")");
        }
        //reposition projection pointing shapes;
        let projectionPointingShapes = arrProjectionDisableSeriesItem[si].querySelectorAll(".clsprojectionenableshape");
        for (let p1 = 0; p1 < projectionPointingShapes.length; p1++) {
            let projectionPointingShape = projectionPointingShapes[p1];
            seriesItem.appendChild(projectionPointingShape);
        }
        let projectionDisablePointingShapes = seriesItem.querySelectorAll(".clsprojectiondisableshape");
        for (let p2 = 0; p2 < projectionDisablePointingShapes.length; p2++) {
            if (projectionDisablePointingShapes[p2]) {
                seriesItem.removeChild(projectionDisablePointingShapes[p2]);
            }
        }
    }

    //create projection enable mask rect
    let projectionindex = this.data.projectionindex;
    let projectionx = points[0][projectionindex].x - this.intCircleRadius;
    let projectionWidthValue = this.data.SVGUtils.createPercentValue(drawingBaseAreaElementWidth, projectionx + this.intCircleRadius);
    let projectionWidthPercentage = 100 - parseFloat(projectionWidthValue);
    this.randomkey = Math.random();
    let projectionEnableMaskID = this.randomkey + this.data.slideID + "mask";
    let projectionEnableMaskElement = baseProjectionSeriesItem.querySelector(".projectiondisablemaskstyle");
    this.data.SVGUtils.assignAttributes(projectionEnableMaskElement, {
        id: projectionEnableMaskID,
        class: "mask projectionenablemaskstyle",
        maskUnits: "userSpaceOnUse",
    });
    projectionElement.appendChild(projectionEnableMaskElement);
    let ProjectionEnableMaskRect = projectionEnableMaskElement.querySelector("#projection-disable-mask-rect");
    this.data.SVGUtils.assignAttributes(ProjectionEnableMaskRect, {
        width: projectionWidthPercentage + "%",
        height: "100%",
        x: this.data.SVGUtils.createPercentValue(drawingBaseAreaElementWidth, projectionx),
        y: "0",
        id: "projection-enable-mask-rect",
        fill: "white",
    });
    projectionElement.setAttribute("mask", "url(#" + projectionEnableMaskID + ")");

    //reposition projection pointing shapes;
};

SimpleStackedAreaChart.prototype.createPathSVG = function (points, svgElement, drawingBaseAreaElementWidth) {
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = this.style.lineThickness;
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.bgFill = this.style.bgFill;
    this.gradient = this.style.bgFillType == "gradient";
    this.areaGradient = this.data.layout.areaColor == "gradient";
    this.lineGradient = this.data.layout.lineColor == "gradient";
    this.pointshape = this.data.layout.linechartshape;
    this.dashedarray = this.style.dashed;
    if (this.data.layout.linestyle == "dashed") {
        this.dashedarray = "15,15";
    }
    for (let p1 = 0; p1 < points.length; p1++) {
        this.customColorIndex = this.ChartFonts.customColor(p1);
        let areaPathElement = this.data.SVGUtils.createSVGElement("path");
        let svgSeriesItemElement = this.data.SVGUtils.createSVGElement("svg");
        svgSeriesItemElement.setAttribute("width", "100%");
        svgSeriesItemElement.setAttribute("height", "100%");
        svgSeriesItemElement.setAttribute("class", "areaseriesitem clsMultiColorParent");
        svgSeriesItemElement.classList.add("th-section" + this.customColorIndex);
        let svgPathParentElement = this.data.SVGUtils.createSVGElement("svg");
        svgPathParentElement.setAttribute("width", "100%");
        svgPathParentElement.setAttribute("height", "100%");
        svgPathParentElement.setAttribute("class", "pathparentelement");
        svgSeriesItemElement.appendChild(svgPathParentElement);

        let areaFillColor = this.getBgFillDetails(p1, this.data.ChartFonts.appendgraphicFillColor(p1), this.data.layout.itemColor, "bgcolor");
        let objPathDetails = {
            strAreaPath: "",
            strLinePath: "",
        };
        if (this.chart == "spline") {
            objPathDetails = this.createSplineAreaPathSVG(points[p1], objPathDetails);
        } else {
            objPathDetails = this.createAreaPathSVG(points[p1], objPathDetails);
        }
        areaPathElement.setAttribute("d", objPathDetails.strAreaPath);
        areaPathElement.setAttribute("class", "itemareapath " + areaFillColor + " moodanimation " + this.data.layout.areaShadow);
        areaPathElement.setAttribute("data-animation", "stackeditemareapath" + (p1 + 1));
        areaPathElement.setAttribute("fill-opacity", this.data.layout.areaOpacity && (this.data.layout.areaOpacity < 0.5 || this.data.seriesItemLength == 1) ? this.data.layout.areaOpacity : 0.5);
        areaPathElement.setAttribute("stroke-opacity", "0");
        svgPathParentElement.appendChild(areaPathElement);
        svgElement.appendChild(svgSeriesItemElement);

        let strokeColor = this.getBgFillDetails(p1, "cf-stroke-section-primary", this.data.layout.itemColor, "stroke");
        let linePathElement = this.data.SVGUtils.createSVGElement("path");
        linePathElement.setAttribute("d", objPathDetails.strLinePath);
        this.data.SVGUtils.assignAttributes(linePathElement, {
            d: objPathDetails.strLinePath,
            class: "itemlinepath " + strokeColor + " moodanimation " + this.data.layout.lineShadow,
            "data-animation": "stackeditemline" + (p1 + 1),
            "data-linechart": "true",
            "data-seriesitemindex": p1.toString(),
            fill: "transparent",
            "series-itemindex": p1,
            "stroke-opacity": this.data.layout.lineOpacity ? this.data.layout.lineOpacity : 0.5,
            "stroke-width": this.linethickness + "px",
        });
        svgPathParentElement.appendChild(linePathElement);
        let linePathLength = linePathElement.getTotalLength();
        for (let i1 = 0; i1 < this.data.seriesLength; i1++) {
            this.createPointShape(points[p1][i1].x, points[p1][i1].intY, svgElement, i1, p1, svgSeriesItemElement, linePathLength, linePathLength);
        }
    }
    if (this.data.hasProjection) {
        //create projection disable mask rect;
        let projectionindex = this.data.projectionindex;
        let projectionx = points[0][projectionindex].x - this.intCircleRadius;
        this.randomkey = Math.random();
        let maskID = this.randomkey + this.data.slideID + "mask";
        let defsElement = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsElement);
        let ProjectionDisableMaskElement = this.data.SVGUtils.createSVGElement("mask");
        this.data.SVGUtils.assignAttributes(ProjectionDisableMaskElement, {
            id: maskID,
            class: "mask projectiondisablemaskstyle",
            maskUnits: "userSpaceOnUse",
        });
        defsElement.appendChild(ProjectionDisableMaskElement);
        let ProjectionDisableMaskRect = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(ProjectionDisableMaskRect, {
            width: this.data.SVGUtils.createPercentValue(drawingBaseAreaElementWidth, projectionx),
            height: "100%",
            id: "projection-disable-mask-rect",
            fill: "white",
        });
        ProjectionDisableMaskElement.appendChild(ProjectionDisableMaskRect);
        svgElement.setAttribute("mask", "url(#" + maskID + ")");
    }
};

SimpleStackedAreaChart.prototype.createAreaPathSVG = function (points, objPathDetails) {
    for (let p2 = 0; p2 < points.length; p2++) {
        let value = points[p2];
        let intX = value.x;
        let intY = value.intY;
        if (p2 == 0) {
            strPath += `M${intX},${intY}`;
        } else {
            strPath += `L${intX},${intY}`;
        }
    }
    objPathDetails.strAreaPath = strPath;
    return objPathDetails;
};

SimpleStackedAreaChart.prototype.createSplineAreaPathSVG = function (series, objPathDetails) {
    const upperPoints = series.slice(0, series.length / 2);
    const lowerPoints = series.slice(series.length / 2);

    // Generate upper spline
    const upperPath = this.generateSplinePath(upperPoints);

    // Generate lower spline
    const lowerPath = this.generateSplinePath(lowerPoints, true);

    // Combine into a complete area path

    objPathDetails.strAreaPath = `${upperPath} ${lowerPath} L ${upperPoints[0].x} ${upperPoints[0].intY}`;
    objPathDetails.strLinePath = upperPath;
    return objPathDetails;
};

SimpleStackedAreaChart.prototype.generateSplinePath = function (points, lowerPath = false) {
    if (points.length < 2) return "";

    const controlPoints = this.getControlPoints(points);
    let path = lowerPath ? `L ${points[0].x} ${points[0].intY}` : `M ${points[0].x} ${points[0].intY}`;

    for (let i = 1; i < points.length; i++) {
        const cp1 = controlPoints[i - 1][1];
        const cp2 = controlPoints[i][0];
        const p = points[i];
        path += ` C ${cp1.x} ${cp1.y}, ${cp2.x} ${cp2.y}, ${p.x} ${p.intY}`;
    }

    return path;
};

SimpleStackedAreaChart.prototype.getControlPoints = function (points, tension = 0.2) {
    const controlPoints = [];

    for (let i = 0; i < points.length; i++) {
        const prev = points[i - 1] || points[0];
        const curr = points[i];
        const next = points[i + 1] || points[points.length - 1];

        // Calculate control points
        const dx = next.x - prev.x;
        const dy = next.intY - prev.intY;

        const c1 = {
            x: curr.x - dx * tension,
            y: curr.intY - dy * tension,
        };

        const c2 = {
            x: curr.x + dx * tension,
            y: curr.intY + dy * tension,
        };

        controlPoints.push([c1, c2]);
    }

    return controlPoints;
};

SimpleStackedAreaChart.prototype.createPointShape = function (intX, intY, svgElement, seriesIndex, seriesItemIndex, svgSeiesItem, pathLength, linePathLength) {
    let svgPointShape;
    let dummeyShape;
    let ShapeWidth = 2 * this.intCircleRadius;
    let ShapeHeight = 2 * this.intCircleRadius;
    let shapeX = intX - this.intCircleRadius;
    let shapeY = intY - this.intCircleRadius;
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let strShapePath = "";
    if (this.pointshape == "rect") {
        ShapeWidth = 2 * this.intCircleRadius + 4;
    }
    let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
    emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
    emptySvgNode.appendChild(dummeyLineShape);
    svgElement.appendChild(emptySvgNode);
    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
    if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
        dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-enabled");
    }
    if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
        dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-disabled");
    }
    let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
    svgElement.removeChild(emptySvgNode);
    if (this.data.layout.itemShapeWidth) {
        ShapeWidth = this.data.layout.itemShapeWidth;
    }
    if (this.data.layout.itemShapeHeight) {
        ShapeHeight = this.data.layout.itemShapeHeight;
    }
    if (getShapeBounds) {
        ShapeWidth = getShapeBounds.width ? getShapeBounds.width : ShapeWidth;
        ShapeHeight = getShapeBounds.height ? getShapeBounds.height : ShapeHeight;
    }
    if (this.pointshape == "rect" || this.pointshape == "square") {
        shapeY = intY - ShapeHeight / 2;
        shapeX = intX - ShapeWidth / 2;
        ShapeWidth = ShapeWidth;
        ShapeHeight = ShapeHeight;
    }
    if (this.pointshape == "rhombus") {
        x1 = intX;
        y1 = intY - ShapeHeight / 2;
        x2 = intX - ShapeWidth / 2;
        y2 = intY;
        x3 = intX;
        y3 = intY + ShapeHeight / 2;
        x4 = intX + ShapeHeight / 2;
        y4 = intY;
        strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
    }

    if (this.pointshape == "rect" || this.pointshape == "square") {
        svgPointShape = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(svgPointShape, {
            x: shapeX,
            y: shapeY,
            width: ShapeWidth,
            height: ShapeHeight,
            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
            "data-cxvalues": intX,
            "data-animation": "itemcircle" + seriesItemIndex,
            "data-animateitem": "itemcircle" + seriesItemIndex,
            "data-pathLength": pathLength,
            "data-linepathlength": linePathLength,
            visibility: "visible",
        });

        dummeyShape = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(dummeyShape, {
            x: shapeX,
            y: shapeY,
            width: ShapeWidth,
            height: ShapeHeight,
            visibility: "hidden",
        });
        if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
        svgSeiesItem.appendChild(svgPointShape);
    } else {
        if (this.pointshape == "rhombus") {
            svgPointShape = this.data.SVGUtils.createSVGElement("path");

            this.data.SVGUtils.assignAttributes(svgPointShape, {
                d: strShapePath,
                class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                "data-cxvalues": intX,
                "data-animation": "itemcircle" + seriesItemIndex,
                "data-animateitem": "itemcircle" + seriesItemIndex,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                visibility: this.pointshape == "rhombus" ? "visible" : "hidden",
                visibility: "visible",
            });
            svgSeiesItem.appendChild(svgPointShape);
        } else {
            svgPointShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(svgPointShape, {
                cx: intX,
                cy: intY,
                r: ShapeWidth / 2,
                class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                "data-cxvalues": intX,
                "data-animation": "itemcircle" + seriesItemIndex,
                "data-animateitem": "itemcircle" + seriesItemIndex,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                visibility: this.pointshape == "circle" ? "visible" : "hidden",
                visibility: "visible",
            });
            dummeyShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(dummeyShape, {
                cx: intX,
                cy: intY,
                "data-pathLength": pathLength,
                "data-linepathlength": linePathLength,
                r: ShapeWidth / 2,
                visibility: "hidden",
            });
            if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
            svgSeiesItem.appendChild(svgPointShape);
        }
    }
    if (this.data.hasProjection) {
        if (this.data.projection[seriesIndex] == true) {
            svgPointShape.classList.add("clsprojectionenableshape");
        } else {
            svgPointShape.classList.add("clsprojectiondisableshape");
        }
    }
    this.itemShapebgProperties(svgPointShape, seriesItemIndex, seriesIndex, dummeyShape);
};

SimpleStackedAreaChart.prototype.getLineShapeBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    if ((width || width < 1) && (height || height < 1)) {
        return { width: width, height: height };
    } else {
        return null;
    }
};

SimpleStackedAreaChart.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex, dummeyShape) {
    if (this.data.layout.linechartShapeStyle == "border") {
        let borderSize = this.data.layout.linechartShapeBorderSize ? this.data.layout.linechartShapeBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.linechartShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsTertiaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
                dummeyShape.classList.add(this.data.ChartFonts.appendgraphicColor(seriesIndex));
            }
        } else {
            if (this.data.layout.linechartShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    // element.classList.add("clsTertiaryStroke");
                    // if(dummeyShape)dummeyShape.classList.add("clsSecondaryFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "contrast") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    element.classList.add("contrast-stroke");
                    if (dummeyShape) dummeyShape.classList.add("clsContrastFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("bgfill");
                    element.classList.add("bgstroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "alternateprimary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("alterbgcolor");
                    element.classList.add("alter-background-stroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    this.addGradient(element, element, element.parentNode, false, true, false, seriesIndex);
                }
            } else {
                // element.classList.add("clsTertiaryStroke");
            }
        }
    }
    if (this.data.layout.linechartShapeBgColor) {
        if (this.data.layout.linechartShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsSecondaryFill");
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.linechartShapeBgColor == "secondary") {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    // element.classList.add("clsSecondaryFill");
                }
            } else {
                if (this.data.layout.linechartShapeBgColor == "contrast") {
                    if (this.data.layout.linechartShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                    } else {
                        element.classList.add("contrast-fill");
                    }
                } else if (this.data.layout.linechartShapeBgColor == "alternateprimary") {
                    if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                        // element.classList.add("clsTertiaryStroke");
                    } else {
                        element.classList.remove("cf-fill-section-primary");
                        element.classList.remove("bgfill");
                        element.classList.add("alterbgcolor");
                    }
                } else {
                    if (this.data.layout.linechartShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true, false, seriesIndex);
                    } else if (this.data.layout.linechartShapeBgColor == "bgcolor") {
                        if (this.data.layout.linechartShapebgOpacity) {
                            element.classList.remove("cf-fill-section-primary");
                            element.classList.add("bgfill");
                            element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                        } else {
                            element.classList.add("contrast-fill");
                        }
                    }
                }
            }
        }
    }
    if (this.data.layout.itemShapeShadow) {
        element.classList.add(this.data.layout.itemShapeShadow);
    }
};
SimpleStackedAreaChart.prototype.addGradient = function (svgPath, svgAreaPath, parentElement, bgFill = true, stroke = false, seriesItemIndex) {
    let lineOpacity1 = this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.opacity1 ? this.data.layout.lineGradientDatas.opacity1 : "0.6";
    let lineOpacity2 = this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.opacity2 ? this.data.layout.lineGradientDatas.opacity2 : "1";
    let lineColor1 = this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.color1 ? "rgba(" + this.data.layout.lineGradientDatas.color1 + "," + 1 + ")" : "rgba(var(--gradient1-color-rgb), 1)";
    let lineColor2 = this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.color2 ? "rgba(" + this.data.layout.lineGradientDatas.color2 + "," + 1 + ")" : "rgba(var(--gradient2-color-rgb), 1)";
    if (this.data.seriesItemLength > 1) {
        lineColor1 = "var(--item" + this.customColorIndex + "-color)";
        lineColor2 = "var(--item" + this.customColorIndex + "-color)";
    }
    let areaOpacity1 = this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.opacity1 ? this.data.layout.areaGradientDatas.opacity1 : "0.6";
    let areaOpacity2 = this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.opacity2 ? this.data.layout.areaGradientDatas.opacity2 : "1";
    let areaColor1 = this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.color1 ? "rgba(" + this.data.layout.areaGradientDatas.color1 + "," + 1 + ")" : "rgba(var(--gradient1-color-rgb), 1)";
    let areaColor2 = this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.color2 ? "rgba(" + this.data.layout.areaGradientDatas.color2 + "," + 1 + ")" : "rgba(var(--gradient2-color-rgb), 1)";
    if (this.data.seriesItemLength > 1) {
        areaColor1 = "var(--item" + this.customColorIndex + "-color)";
        areaColor2 = "var(--item" + this.customColorIndex + "-color)";
    }
    let defs = this.data.SVGUtils.createSVGElement("defs");
    parentElement.appendChild(defs);

    if (this.lineGradient) {
        // let lineAlignmentValues = this.getGradientAlignment(this.data.layout.lineGradientDatas.align);
        let linearGrad = this.data.SVGUtils.createSVGElement("linearGradient");
        this.data.SVGUtils.assignAttributes(linearGrad, {
            id: "grad" + seriesItemIndex,
            "data-gradientmasknode": "true",
            gradientTransform: "rotate(" + this.data.layout.lineGradientDatas.align + " 0.5 0.5)",
        });
        defs.appendChild(linearGrad);
        let linestop1 = this.data.SVGUtils.createSVGElement("stop");
        this.data.SVGUtils.assignAttributes(linestop1, {
            class: "stop1",
            offset: this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.percentage1 ? this.data.layout.lineGradientDatas.percentage1 + "%" : "0%",
            style: "stop-color:" + lineColor1 + ";stop-opacity:" + lineOpacity1,
        });
        linearGrad.appendChild(linestop1);
        let linestop2 = this.data.SVGUtils.createSVGElement("stop");
        this.data.SVGUtils.assignAttributes(linestop2, {
            class: "stop2",
            offset: this.data.layout.lineGradientDatas && this.data.layout.lineGradientDatas.percentage2 ? this.data.layout.lineGradientDatas.percentage2 + "%" : "100%",
            style: "stop-color:" + lineColor2 + ";stop-opacity:" + lineOpacity2,
        });
        linearGrad.appendChild(linestop2);
        if (svgPath) {
            this.data.SVGUtils.assignAttributes(svgPath, {
                class: "item-path moodanimation " + this.data.layout.lineShadow,
                "data-gradientelement": "true",
                stroke: "url(#grad" + seriesItemIndex + ")",
            });
        }
    }

    if (this.areaGradient) {
        // let areaAlignmentValues = this.getGradientAlignment(this.data.layout.areaGradientDatas.align);
        let areaGrad = this.data.SVGUtils.createSVGElement("linearGradient");
        this.data.SVGUtils.assignAttributes(areaGrad, {
            id: "areagrad" + seriesItemIndex,
            gradientTransform: "rotate(" + this.data.layout.areaGradientDatas.align + " 0.5 0.5)",
        });
        defs.appendChild(areaGrad);
        let areastop1 = this.data.SVGUtils.createSVGElement("stop");
        this.data.SVGUtils.assignAttributes(areastop1, {
            class: "stop1",
            offset: this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.percentage1 ? this.data.layout.areaGradientDatas.percentage1 + "%" : "0%",
            style: "stop-color:" + areaColor1 + ";stop-opacity:" + areaOpacity1,
        });
        areaGrad.appendChild(areastop1);
        let areastop2 = this.data.SVGUtils.createSVGElement("stop");
        this.data.SVGUtils.assignAttributes(areastop2, {
            class: "stop2",
            offset: this.data.layout.areaGradientDatas && this.data.layout.areaGradientDatas.percentage2 ? this.data.layout.areaGradientDatas.percentage2 + "%" : "100%",
            style: "stop-color:" + areaColor2 + ";stop-opacity:" + areaOpacity2,
        });
        areaGrad.appendChild(areastop2);
        if (bgFill) {
            this.data.SVGUtils.assignAttributes(svgAreaPath, {
                class: "path_to item-lines " + this.data.layout.areaShadow,
                fill: "url(#areagrad" + seriesItemIndex + ")",
            });
        }
    }
};

