                sequencenumber: "true",
                innerValue: "false",
                maxAllowedSeries: "32",
                minAllowedSeries: "2",
                maxAllowedSeriesItems: "2",
                minAllowedSeriesItems: "2",
                valueDisplayFormat: "true",
                animationClass: "Bar",
                highlightType: "Pattern",
                defaultHighlight: "true",
                primary: "true",
                sort: "true",
                referencename: "bar",
