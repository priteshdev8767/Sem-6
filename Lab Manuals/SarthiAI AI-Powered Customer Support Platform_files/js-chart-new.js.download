            this.parent.appendChild(gridValueElement);

            for (let i1 = 0; i1 < this.positiveGridCount; i1++) {
                let lineElement = document.createElement("div");
                lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                lineElement.style.width = width;
                lineElement.style.height = this.viewport.height - this.gridValueSizeH + "px";
                lineElement.dataset.animation = "gridlines";
                if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                    lineElement.style.opacity = "0";
                    lineElement.style.visibility = "hidden";
                }
                if (this.data.layout.gridLineOpacity) {
                    lineElement.style.opacity = this.data.layout.gridLineOpacity;
                }
                if (this.data.layout.gridLineColor) {
                    let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.gridLineColor, "bordercolor");
                    lineElement.classList.add(colorValue);
                }
                if (this.data.layout.gridLineStyle) {
                    lineElement.style.borderRightStyle = this.data.layout.gridLineStyle;
                    if (this.data.chartFlip) {
                        lineElement.style.borderLeftStyle = this.data.layout.gridLineStyle;
                    }
                }
                if (this.data.layout.gridLineThickness) {
                    lineElement.style.borderRightWidth = this.data.layout.gridLineThickness;
                    if (this.data.chartFlip) {
                        lineElement.style.borderLeftWidth = this.data.layout.gridLineThickness;
                    }
                }
                if (this.data.layout.gridLineStyleClass) {
                    lineElement.classList.add(this.data.layout.gridLineStyleClass);
                }
                gridLineElement.appendChild(lineElement);
                lineElementHeight = lineElement.clientWidth;
                if (this.reverse) lineElement.classList.add("reverse");
                if (i1 == this.positiveGridCount - 1 && this.move3dY && this.negBounds.width != 0) {
                    let poswidth = lineElement.clientWidth;
                    let posmoveX = Math.round(this.move3dY);
                    poswidth = poswidth - posmoveX;
                    let posheight = gridLineElement.clientHeight;
                    let posintY = this.move3dY;
                    let posmoveY = 0;
                    let svgPos3dshape = this.data.SVGUtils.createSVGElement("svg");
                    this.data.SVGUtils.assignAttributes(svgPos3dshape, {
                        height: "100%",
                    });
                    svgPos3dshape.style.position = "absolute";
                    svgPos3dshape.style.top = "0px";
                    gridLineElement.appendChild(svgPos3dshape);
                    let pospathElement = this.data.SVGUtils.createSVGElement("path");
                    this.data.SVGUtils.assignAttributes(pospathElement, {
                        d: "M" + 0 + "," + posintY + "L" + posmoveX + "," + posmoveY + "L" + posmoveX + "," + (posheight - posintY * 2 + posmoveY) + "L" + 0 + "," + (posheight - 2) + " Z",
                        "fill-opacity": 0.15,
                        class: "moodanimation",
                        "data-animation": "gridlines",
                        fill: "rgba(var(--th-slide-contrast),1)",
                    });
                    svgPos3dshape.appendChild(pospathElement);
                }
            }

            for (let i2 = 0; i2 < this.positiveGridCount; i2++) {
                let valueElement = document.createElement("div");
                valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                valueElement.style.width = width;
                valueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                let gridValue = this.reverse ? (this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2) : (this.voData.rangeTotal / this.positiveGridCount) * (i2 + 1);
                let deciamlCount = gridValue.toString().split(".").length > 1 ? gridValue.toString().split(".")[1].length : 0;
                if (deciamlCount > 2) {
                    gridValue = gridValue.toFixed(1);
                }
                valueElement.innerHTML = this.getDenominationValue(gridValue);
                if (this.data.data.getAttribute("data-stackpercentage")) {
                    valueElement.innerHTML = this.getDenominationValue(Math.round((100 / this.positiveGridCount) * (i2 + 1))) + "%";
                }
                if (this.data.highvaluebreak && i2 != this.positiveGridCount - 1) {
                    valueElement.innerHTML = this.reverse ? this.getDenominationValue(Math.round((this.voData.secondPositiveHighValue / this.positiveGridCount) * (this.positiveGridCount - i2))) : this.getDenominationValue(Math.round((this.voData.secondPositiveHighValue / (this.positiveGridCount - 1)) * (i2 + 1)));
                }
                if (valueElement.innerHTML == "0") {
                    valueElement.innerHTML = this.reverse ? this.getDenominationValue(Math.round((this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2))) : this.getDenominationValue(Math.round((this.voData.rangeTotal / this.positiveGridCount) * (i2 + 1)));
                }
                if (this.data._boolPercentageChart) {
                    let rangeTotalValue = this.voData.rangeTotal > 100 ? 100 : this.voData.rangeTotal;
                    valueElement.innerHTML = this.reverse ? Math.round((rangeTotalValue / this.positiveGridCount) * (this.positiveGridCount - i2)) + "%" : Math.round((rangeTotalValue / this.positiveGridCount) * (i2 + 1)) + "%";
                }
                valueElement.style.textAlign = this.reverse ? "start" : "end";
