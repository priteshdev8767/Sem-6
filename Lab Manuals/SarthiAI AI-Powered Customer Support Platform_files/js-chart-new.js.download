function SimpleLineChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleLineChart";
    this.ChartFonts = new window["ChartFonts"]();
    this.intStartX = 0;
    this.intLastX = 0;
    this.intCircleRadius = 8;
    this.minHeight;
    this.projectionArray = [];
    this.maskPathId = "";
    this.maskRectId = "";
    this.maskprojection = "projectionmaskrect";
    this.baseMaskRect = "";
    this.customColorIndex = 1;
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleLineChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleLineChart.prototype.constructor = SimpleLineChart;

SimpleLineChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleLineSeries"](argparent, argprops);
};

SimpleLineChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.calculateGridValueSize();
            this.createCagrContainer();
            this.doAddAxisTitle();
            this.doAddGridValues();
            this.doAddGraphicDesk();
            this.doAddGridDesk();
            this.doAddBaseLineDesk();
            if (this.data.highlightDifference.display) {
                this.CreateHightlightDifference();
            }
            if (this.data.indualHighlight) this.createIndualHighlight();
            this.createTooltipCallout(this.parent, this.data);
            this.doAddMetaData();
            this.rePositionCagrLabel();
            this.adjustProjectionText();
        }
    }
};

SimpleLineChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveX = this.rectSeries.y;
    this.maskprojection = Math.random() + "projectionmaskrect";
    let element = document.createElement("div");
    element.style.width = "100%";
    element.style.height = "100%";
    element.style.display = "flex";
    element.style.flexDirection = "column";
    element.style.position = "relative";
    argparent.appendChild(element);

    let serieselement = document.createElement("div");
    serieselement.style.width = "100%";
    serieselement.style.height = "100%";
    serieselement.style.display = "flex";
    serieselement.style.position = "absolute";
    element.appendChild(serieselement);

    // this.rectSeries.y += 40;
    // this.rectSeries.height -= 40;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(serieselement, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(moveX, this.rectSeries.y);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveX += this.rectSeries.width;
    }

    let labelElement = element.getElementsByClassName("label")[0];

    let containerHeight = element && element.querySelector("#seriesitemcond-1") ? element.querySelector("#seriesitemcond-1").clientHeight : 0;
    if (containerHeight == 0) {
        containerHeight = element && element.querySelector("#seriesitemcond-0") ? element.querySelector("#seriesitemcond-0").clientHeight : 0;
    }
    this.minHeight = labelElement ? labelElement.clientHeight : 0;
    this.minHeight += this.data._customProperties.showXAxisTitle ? 40 : 0;
    let subelement = document.createElement("div");
    subelement.style.width = "100%";
    subelement.style.height = this.state.height - this.minHeight + "px";
    subelement.style.display = "flex";
    subelement.style.position = "absolute";
    element.appendChild(subelement);
    if (this.data.chartFlip) {
        subelement.style.height = 15 + this.state.height - this.minHeight + "px";
    }
    serieselement.remove();
    element.appendChild(serieselement);
    this.fullLine = this.data.layout.linechartfull == "true" ? true : false;
    this.createPathSVG(subelement, containerHeight, element);
    this.createProjectionSVG(subelement);
    this.checkBottomSeriesItemPositions(argparent);
    this.updateLegendShapePropeties(this.parent);
};
SimpleLineChart.prototype.updateLegendShapePropeties = function (element) {
    let arrayLegendShape = element.querySelectorAll(".secondarylinelegendshape");
    let arrayLineElement = element.querySelectorAll(".secondarylinelegendpath");
    for (let i1 = 0; i1 < arrayLegendShape.length; i1++) {
        let secondaryLineLegendShape = arrayLegendShape[i1];
        let lineElement = arrayLineElement[i1];
        let secondaryLinePath = element?.querySelector(".item-path");
        if (lineElement) lineElement.setAttribute("class", secondaryLinePath.getAttribute("class"));
        lineElement.classList.remove("moodanimation");
        let lineShapeElement = element?.querySelector(".item-circle")?.cloneNode(true);
        let legendParentNode = secondaryLineLegendShape?.parentElement;
        if (lineShapeElement && legendParentNode) {
            legendParentNode.appendChild(lineShapeElement);
            lineShapeElement.classList.remove("moodanimation");
        }
        if (secondaryLineLegendShape) {
            secondaryLineLegendShape.parentElement.removeChild(secondaryLineLegendShape);
        }
        let shapeX = secondaryLineLegendShape?.dataset.x;
        let shapeY = secondaryLineLegendShape?.dataset.y;
        let shapeElementBounds = { width: lineShapeElement?.clientWidth, height: lineShapeElement?.clientHeight };
        if (lineShapeElement?.tagName == "circle" || lineShapeElement?.tagName == "rect") {
            shapeElementBounds = lineShapeElement?.getBoundingClientRect();
        }
        if (lineShapeElement?.tagName == "circle") {
            lineShapeElement.setAttribute("cx", shapeX);
            lineShapeElement.setAttribute("cy", shapeY);
        } else if (lineShapeElement?.tagName == "rect") {
            lineShapeElement.setAttribute("x", shapeX - shapeElementBounds.width / 2);
            lineShapeElement.setAttribute("y", shapeY - shapeElementBounds.height / 2);
        } else if (lineShapeElement) {
            lineShapeElement.setAttribute("transform", "translate(" + shapeX + "," + shapeY + ")");
        }
    }
};
SimpleLineChart.prototype.checkBottomSeriesItemPositions = function (argparent) {
    let bottomSeries = argparent.querySelectorAll(".bottomseriesitem");
    for (i1 = 0; i1 < bottomSeries.length; i1++) {
        if (bottomSeries[i1]) bottomSeries[i1].style.position = "relative";
    }
};
SimpleLineChart.prototype.createPathSVG = function (argparent, containerHeight, element) {
    let boolSameValue = this.data.minValue == this.data.positiveMaxValue;
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = this.style.lineThickness;
    this.parentWidth = argparent.clientWidth;
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.bgFill = this.style.bgFill;
    this.gradient = this.style.bgFillType == "gradient";
    this.areaGradient = this.data.layout.areaColor == "gradient";
    this.lineGradient = this.data.layout.lineColor == "gradient";
    this.pointshape = this.data.layout.linechartshape;
    this.dashedarray = this.style.dashed;
    if (this.data.layout.linestyle == "dashed") {
        this.dashedarray = "15,15";
    }
    this.randomkey = Math.random();
    this.state.height -= 40;
    let sereiesX = 17;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "series-common",
        class: "commonitem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, sereiesX),
        y: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeries.y),
        width: this.data.SVGUtils.createPercentValue(this.state.width, this.state.width),
        height: this.data.SVGUtils.createPercentValue(this.state.height, this.state.height),
        "data-width": this.state.width,
        "data-height": this.state.height,
    });
    argparent.appendChild(svgElement);
    if (this.data.indualHighlight && !this.data.chartFlip) {
        argparent.style.top = "30px";
    }
    if (this.data.layout.itemCoinChart) {
        argparent.parentNode.classList.add("coinlineparent");
        argparent.classList.add("coinline");
    }
    ///
    let seriesItemLength = this.voData.seriesItemLength;
    let intPreviousX = 0;
    let intPreviousY = 0;
    let intPreviousProjectionX = 0;
    let intPreviousProjectionWidth = 0;

    for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
        this.customColorIndex = this.ChartFonts.customColor(seriesItemIndex);
        let svgSeiesItem = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgSeiesItem, {
            id: "svgseriesitem-" + seriesItemIndex,
            class: "svgseriesitem accent" + this.customColorIndex + " clsMultiColorParent " + this.data.layout.lineareaGlopalStyle,
            //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
        });
        if (this.data.hasProjection) {
            this.data.SVGUtils.assignAttributes(svgSeiesItem, {
                class: "svgseriesitem accent" + this.customColorIndex + " clsMultiColorParent cs-line-area-projection-disabled " + this.data.layout.lineareaGlopalStyle,
                //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
            });
        }
        svgSeiesItem.classList.add("th-section" + this.customColorIndex);

        let strPath = "";
        let strAreaPath = "";
        let intX = "";
        let intY = "";
        let intStartYPoint = "";
        let intstartPoint = "";
        let strLinePathTo = "";
        let strPathTo = "";
        let svgAreaPath;
        let AreaBaseSvg = "";
        if (this.bgFill) {
            AreaBaseSvg = this.data.SVGUtils.createSVGElement("svg");
            svgSeiesItem.appendChild(AreaBaseSvg);
            svgAreaPath = this.data.SVGUtils.createSVGElement("path");
            AreaBaseSvg.appendChild(svgAreaPath);
        }
        let svgPath = this.data.SVGUtils.createSVGElement("path");
        if (this.dropshadow) {
            this.createDropShadow(svgElement);
            if (this.bgFill) {
                this.data.SVGUtils.assignAttributes(svgPath, {
                    filter: "url(#dropshadow)",
                });
            }
        }
        if (this.bgFill) {
            AreaBaseSvg.appendChild(svgPath);
        } else {
            if (this.dropshadow) {
                let dropsadowSvg = this.data.SVGUtils.createSVGElement("svg");
                this.data.SVGUtils.assignAttributes(dropsadowSvg, {
                    filter: "url(#dropshadow)",
                });
                let dropsadowRect = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(dropsadowRect, {
                    width: this.state.width,
                    height: this.state.height,
                    fill: "transparent",
                });
                dropsadowSvg.appendChild(dropsadowRect);
                svgSeiesItem.appendChild(dropsadowSvg);
                dropsadowSvg.appendChild(svgPath);
            } else {
                svgSeiesItem.appendChild(svgPath);
            }
        }
        let container;
        let seriesContainer;
        let seriesItemContainer;

        let arrProjection = [];
        this.projectionArray = [];
        let rectWidth = "";
        let point1 = { x: 0, y: 0 };
        let arrPoints = [];
        let areaFirstPoint = { x: 0, y: 0 };
        if (this.chart == "spline") {
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                // let strLine = "";
                let svgLinePath = this.data.SVGUtils.createSVGElement("path");
                // this.intCircleRadius = this.data.hasEmphasis && this.data.emphasis[seriesIndex] == true ? 2 * 5 : 5;
                // let svgItems = this.items[seriesIndex];
                let intQX1;
                let intQX2;
                let intQY1;
                let intQY2;
                let intCY;
                let intCX;
                let intBeginY;
                let numMultiplyFactor = (containerHeight - (this.minHeight + this.intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (this.minHeight + height + this.intCircleRadius)) + this.intCircleRadius;
                itemY -= numValue > 0 ? 0 : this.minHeight + this.intCircleRadius;
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                if (!seriesItemContainer) {
                    return;
                }
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0 || (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0)) {
                    graphicContainer = seriesContainer[1].querySelector(".chartelementgraphic");
                    if (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0) {
                        graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                        itemY = seriesContainer[0].querySelector(".value").parentNode.parentNode.offsetTop;
                    } else {
                        itemY = seriesContainer[1].offsetTop + seriesContainer[1].querySelector(".value").offsetTop;
                    }
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + graphicContainer.parentNode.offsetTop;
                    }
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                    itemY = seriesContainer[0].querySelector(".value").offsetTop + seriesContainer[0].querySelector(".value").offsetHeight;
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + seriesContainer[0].offsetTop + graphicContainer.clientHeight;
                    }
                }
                if (this.data.highlightDifference.display && !this.data.chartFlip) {
                    itemY = itemY + 30;
                }

                intX = sereiesX + this.rectSeries.width / 2 - this.intCircleRadius * 2;
                intY = itemY;
                intY = intY > containerHeight && !this.data.chartFlip ? containerHeight - this.intCircleRadius : intY;
                if (this.data.totalValueBounds.height) {
                    intY = intY + this.data.totalValueBounds.height;
                }
                intStartYPoint = itemY + graphicContainer.clientHeight;
                if (this.data.chartFlip) {
                    intStartYPoint = itemY - graphicContainer.clientHeight;
                }
                if (seriesIndex == 0) {
                    if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                        height = seriesContainer[1].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY - height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY + height;
                        }
                    } else {
                        height = seriesContainer[0].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY + height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY - height;
                        }
                    }
                    if (this.bgFill) this.intStartX = intX;
                    intStartYPoint = intStartYPoint + 0.001;
                    intY = intY + 0.001;
                    strAreaPath += this.bgFill ? "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " " : "M" + intX + "," + intY;
                    if (this.fullLine && this.bgFill) {
                        strPath += "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " ";
                    } else {
                        strPath += "M" + intX + "," + intY;
                    }
                    intPreviousX = intX;
                    intPreviousY = intY;
                    intBeginY = intPreviousY;
                    areaFirstPoint = { x: intX, y: intStartYPoint };
                }
                intCY = intY;
                intCX = intX;
                if (seriesIndex != 0) {
                    intQX1 = parseFloat(intPreviousX + (intX - intPreviousX) / 4);
                    intQY1 = intPreviousY > intY ? parseFloat(intPreviousY + 5) : parseFloat(intPreviousY - 5);
                    if (seriesIndex == 1) {
                        intQX1 = intPreviousX;
                        intQX2 = intPreviousY < intY ? intX : parseFloat(intX - (intX - intPreviousX) / 3);
                        intQY1 = intPreviousY > intY ? parseFloat(intPreviousY + 5) : parseFloat(intPreviousY - 5);
                        intQY2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intY + 20 : intY - 5;
                        intQX2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intQX2 - 20 : intQX2;
                        intQY1 = intPreviousY == intY ? parseInt(intPreviousY) : intQY1;
                        intQY2 = intPreviousY == intY ? parseInt(intPreviousY) : intQY2;
                        intQY1 = intQY1 > argparent.clientHeight ? argparent.clientHeight : intQY1;
                        intQY2 = intQY2 > argparent.clientHeight ? argparent.clientHeight : intQY2;

                        if (intPreviousY < intY && intY - intPreviousY < this.rectSeries.height * 0.6) {
                            intQY2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intY + 20 : intY;
                            strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5);
                            strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5) : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5);
                            intCY = intY - 5;
                        } else {
                            strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                            strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                        }
                    } else {
                        intQX1 = parseFloat(intPreviousX + (intX - intPreviousX) / 3);
                        intQX2 = seriesIndex == this.seriesLength - 1 ? parseFloat(intX) : parseFloat(intX - (intX - intPreviousX) / 3);
                        intQY1 = intPreviousY;
                        intQY2 = intY;
                        intQY1 = intPreviousY == intY ? parseInt(intPreviousY) : intQY1;
                        intQY2 = intPreviousY == intY ? parseInt(intPreviousY) : intQY2;
                        intQY2 = intPreviousY - intBeginY > this.rectSeries.height * 0.6 ? parseInt(intQY2 + 50) : intQY2;

                        intQY1 = intQY1 > argparent.clientHeight ? argparent.clientHeight : intQY1;
                        intQY2 = intQY2 > argparent.clientHeight ? argparent.clientHeight : intQY2;

                        strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                        strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                    }
                    intPreviousX = intX;
                    intPreviousY = intY;
                }
                arrPoints.push({ x: intX, y: intY });
                if (seriesIndex != 0) {
                    if (this.bgFill) {
                        strPath = this.makePath(arrPoints, null, argparent);
                        strAreaPath = this.makePath(arrPoints, areaFirstPoint, argparent);
                    } else {
                        strPath = this.makePath(arrPoints, null, argparent);
                        strAreaPath = this.makePath(arrPoints, null, argparent);
                    }
                }
                // point1 = seriesIndex == this.voData.seriesLength - 2 ? { x: shapeX, y: shapeY } : point1;
                // let point2 = { x: shapeX, y: shapeY };
                if (seriesIndex == this.voData.seriesLength - 1 && this.data.layout.lineHead) {
                    if (this.data.layout.lineHead) {
                        let arrowPoints = this.doMeasurementArrow(arrPoints, seriesItemIndex);
                        strPath += "L" + arrowPoints.x + "," + arrowPoints.y;
                    }
                    // let angle = this.getAngle(point1, point2);
                    let arrowHead = document.createElement("div");
                    let arrowHeadParent = document.createElement("div");
                    arrowHeadParent.className = "arrowheadParent accent" + this.customColorIndex + " clsMultiColorParent";
                    arrowHeadParent.classList.add("th-section" + this.customColorIndex);
                    // arrowHeadGroup.style.transform = "translate("+shapeX+"px, "+(shapeY-13)+"px) rotate("+angle+"deg)"
                    if (arrowHead) {
                        arrowHeadParent.appendChild(arrowHead);
                        argparent.appendChild(arrowHeadParent);
                        arrowHeadParent.style.offsetPath = "path('" + strPath + "')";
                        arrowHeadParent.style.offsetDistance = "100%";
                        arrowHeadParent.classList.add("moodanimation");
                        arrowHead.classList.add("cf-background-color-section-primary");
                        arrowHead.classList.add("cs-chart-arrow-head");
                        arrowHeadParent.dataset.animation = "arrowhead";
                    }
                    // arrowHeadParent.appendChild(arrowHeadGroup);
                    // svgSeiesItem.appendChild(arrowHeadParent)
                }
                let dummeyPath = this.data.SVGUtils.createSVGElement("path");
                this.data.SVGUtils.assignAttributes(dummeyPath, {
                    visblity: "hidden",
                    d: strPath,
                });
                let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyPath);
                this.ChartUtils.addDummySvg(emptySvgNode, this.data.slideObj);
                let pathLength;
                let linePathLength = "";
                pathLength = dummeyPath.getTotalLength();
                if (this.bgFill) linePathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.data.slideObj);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
                // this.linethickness = 6;
                let clsstyle = this.gradient && !this.bgFill ? this.ChartFonts.graphicFillColor(seriesIndex) : this.ChartFonts.graphicFillColor(0);
                if (this.data.layout.lineShapeStroke) {
                    clsstyle = this.ChartFonts.graphicFillColor(0) + " " + this.ChartFonts.graphicStrokeColor(0) + " strokestyle";
                }

                let svgCircle = "";
                let dummeyShape = "";
                let ShapeWidth = 2 * this.intCircleRadius;
                let ShapeHeight = 2 * this.intCircleRadius;
                let shapeX = intX - this.intCircleRadius;
                let shapeY = intY - this.intCircleRadius;
                if (this.pointshape == "rect") {
                    ShapeWidth = 2 * this.intCircleRadius + 4;
                }
                let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
                emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyLineShape);
                svgElement.appendChild(emptySvgNode);
                dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-enabled");
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " cs-line-area-shape-projection-disabled");
                }
                let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
                svgElement.removeChild(emptySvgNode);
                if (this.data.layout.itemShapeWidth) {
                    ShapeWidth = this.data.layout.itemShapeWidth;
                }
                if (this.data.layout.itemShapeHeight) {
                    ShapeHeight = this.data.layout.itemShapeHeight;
                }
                if (getShapeBounds) {
                    ShapeWidth = getShapeBounds.width ? getShapeBounds.width : 0;
                    ShapeHeight = getShapeBounds.height ? getShapeBounds.height : 0;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    shapeY = intY - ShapeHeight / 2;
                    shapeX = intX - ShapeWidth / 2;
                    ShapeWidth = ShapeWidth;
                    ShapeHeight = ShapeHeight;
                }
                if (this.pointshape == "rhombus") {
                    x1 = intX;
                    y1 = intY - ShapeHeight / 2;
                    x2 = intX - ShapeWidth / 2;
                    y2 = intY;
                    x3 = intX;
                    y3 = intY + ShapeHeight / 2;
                    x4 = intX + ShapeHeight / 2;
                    y4 = intY;
                    strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    svgCircle = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(svgCircle, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                        id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                        "data-cxvalues": intCX,
                        "data-animation": "itemcircle",
                        "data-animateitem": "itemcircle" + seriesItemIndex,
                        "data-pathLength": pathLength,
                        "data-linepathlength": linePathLength,
                        visibility: "visible",
                    });
                    dummeyShape = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(dummeyShape, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        visibility: "hidden",
                    });
                    if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                    svgSeiesItem.appendChild(svgCircle);
                } else {
                    if (this.pointshape == "rhombus") {
                        svgCircle = this.data.SVGUtils.createSVGElement("path");

                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            d: strShapePath,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-seriesitemindex": seriesItemIndex.toString(),
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "rhombus" ? "visible" : "hidden",
                        });
                        svgSeiesItem.appendChild(svgCircle);
                    } else {
                        svgCircle = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            cx: intX,
                            cy: intY,
                            r: ShapeWidth / 2,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intCX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "circle" ? "visible" : "hidden",
                        });
                        dummeyShape = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(dummeyShape, {
                            cx: intX,
                            cy: intY,
                            r: ShapeWidth / 2,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: "hidden",
                        });
                        if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                        svgSeiesItem.appendChild(svgCircle);
                    }
                }
                // if(this.data.layout.lineShapeStroke){
                //     svgCircle.classList.add("strokestyle");
                // }
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPoint && this.data.lineHighlightStyle[seriesIndex] == "true") {
                    svgCircle.setAttribute("visibility", "hidden");
                    let highlightShape = this.createHighlightShape(intX, intY, ShapeWidth, seriesIndex, pathLength);
                    highlightShape.dataset.animation = "linehighlightcircle";
                    highlightShape.dataset.animationitem = "highlightcircle-" + seriesIndex + "_" + seriesItemIndex;
                    svgSeiesItem.appendChild(highlightShape);
                    let valueElement = seriesContainer[0].querySelector(".value");
                    if (!valueElement && seriesContainer[1]) {
                        valueElement = seriesContainer[1].querySelector(".value");
                    }
                    if (valueElement) {
                        let ElementHeight = valueElement.clientHeight;
                        let valueTop = intY - ElementHeight / 2;
                        if (this.data.layout.valuePaddingClass) {
                            valueElement.classList.remove(this.data.layout.valuePaddingClass);
                        }
                        if (this.data.layout.valueAlterPaddingClass) {
                            valueElement.classList.remove(this.data.layout.valueAlterPaddingClass);
                        }
                        valueElement.children[0].dataset.hashighlight = "true";
                        // valueElement.style.top = valueTop+"px";
                        valueElement.children[0].classList.remove("cs-line-highlight-callout-text");
                        valueElement.classList.remove("cs-line-highlight-callout");
                        valueElement.children[0].classList.add("cs-line-highlight-callout-text");
                        valueElement.classList.add("cs-line-highlight-callout");
                        valueElement.children[0].classList.remove("clsValueTextColor");
                        valueElement.children[0].classList.remove("cs-inner-text-color");
                        valueElement.children[0].classList.add("cs-inner-text-color");
                    }
                    let topValue = valueElement && window.getComputedStyle(valueElement) && window.getComputedStyle(valueElement)["top"] ? parseFloat(window.getComputedStyle(valueElement)["top"]) : "";
                    if (topValue && !isNaN(topValue) && this.data.chartFlip && !valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                    if (topValue && !isNaN(topValue) && !this.data.chartFlip && valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    // svgCircle.classList.remove(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                    svgCircle.classList.remove("bgfill");
                    svgCircle.classList.remove("clsSecondaryFill");
                    svgCircle.classList.add("cs-line-area-shape-projection-enabled");
                    if (dummeyShape) {
                        dummeyShape.classList.add("cs-line-area-shape-projection-enabled");
                    }
                } else if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    svgCircle.classList.add("cs-line-area-shape-projection-disabled");
                    if (dummeyShape) {
                        dummeyShape.classList.add("cs-line-area-shape-projection-disabled");
                    }
                }
                this.itemShapebgProperties(svgCircle, seriesItemIndex, seriesItemIndex, dummeyShape);
                // if(seriesItemIndex>0){
                //     svgCircle.style.setProperty("fill","rgba(var(--node-theme-color),1)","important")
                // }
                if (this.data.hasProjection && rectWidth == "" && this.data.projection[seriesIndex] == true) {
                    rectWidth = this.data.hasProjection && this.data.projection[seriesIndex] == true ? intX : "";
                    arrProjection.push({
                        x: 0,
                        width: rectWidth,
                    });
                    this.projectionArray.push({
                        x: intX,
                        width: this.parentWidth - rectWidth,
                    });
                } else {
                    if (this.data.hasProjection && arrProjection.length != 0 && this.data.projection[seriesIndex - 1] == true && this.data.projection[seriesIndex] == false) {
                        intPreviousProjectionX = intX;
                        intPreviousProjectionWidth = this.width - intX;
                        // arrProjection.push({ x: intPreviousProjectionX, width: intPreviousProjectionWidth });
                        if (this.projectionArray.length >= 1) {
                            this.projectionArray[this.projectionArray.length - 1].width = intPreviousProjectionX - this.projectionArray[this.projectionArray.length - 1].x;
                        }
                    } else {
                        if (this.data.hasProjection && this.data.projection[seriesIndex] == true && this.data.projection[seriesIndex - 1] == false) {
                            intPreviousProjectionWidth = intX;
                            if (arrProjection.length > 1) arrProjection[arrProjection.length - 1].width = intPreviousProjectionWidth - arrProjection[arrProjection.length - 1].x;
                            this.projectionArray.push({
                                x: intX,
                                width: this.parentWidth - intX,
                            });
                        }
                    }
                }

                this.data.SVGUtils.assignAttributes(svgLinePath, {
                    d: strAreaPath,
                    class: this.ChartFonts.graphicStrokeColor(seriesItemIndex) + " " + this.data.layout.areaShadow,
                    "fill-opacity": 0,
                    "stroke-opacity": 0,
                    "stroke-width": this.linethickness + "px",
                    id: "itemlines-" + seriesIndex + "_" + seriesItemIndex,
                });
                // svgSeiesItem.appendChild(svgLinePath);
                sereiesX += this.rectSeries.width;
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPointStyle1) {
                    let objBounds = this.getChartHighLightValue(this.parent.parentNode, seriesIndex);
                    let targetBounds = objBounds.targetBounds;
                    let highlightData = {
                        title: this.data.lineHighlightText[seriesIndex] ? this.data.lineHighlightText[seriesIndex] : "Enter highlight text",
                        content: {
                            type: "",
                            value: {},
                        },
                        position: { primary: "vertical", secondary: "center" },
                    };
                    let hightlight = "";
                    if (this.data.moodData.calloutstyle) {
                        try {
                            hightlight = new window[this.data.moodData.calloutstyle](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        } catch (error) {
                            hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        }
                    } else {
                        hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                    }
                    if (hightlight) {
                        hightlight.style.pointerEvents = "none";
                        let textNode = hightlight.querySelector("#callout-title");
                        if (textNode) {
                            textNode.setAttribute("contenteditable", "true");
                            textNode.setAttribute("data-dck-selector", "true");
                            textNode.setAttribute("data-prompt-text", "Enter highlight text");
                            this.ChartHelper.setTextChangeListner(textNode);
                            textNode.setAttribute("data-type", "highlightlabel");
                            textNode.setAttribute("index", seriesIndex);
                            textNode.setAttribute("id", "lineheightlighttext" + seriesIndex);
                            textNode.classList.add("linehighlightlabel");
                            textNode.style.pointerEvents = "all";
                            if (!this.data.lineHighlightText[seriesIndex]) {
                                textNode.innerText = "";
                            }
                        }
                        hightlight.setAttribute("data-animation", "linehighlightshape");
                        hightlight.classList.add("moodanimation");
                    }
                }
            }
            sereiesX = 17;
        } else {
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let numMultiplyFactor = (containerHeight - (this.minHeight + this.intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (this.minHeight + height + this.intCircleRadius)) + this.intCircleRadius;
                itemY -= numValue > 0 ? 0 : this.minHeight + this.intCircleRadius;

                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0 || (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0)) {
                    graphicContainer = seriesContainer[1].querySelector(".chartelementgraphic");
                    if (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0) {
                        graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                        itemY = seriesContainer[0].querySelector(".value").parentNode.parentNode.offsetTop;
                    } else {
                        itemY = seriesContainer[1].offsetTop + seriesContainer[1].querySelector(".value").offsetTop;
                    }
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + graphicContainer.parentNode.offsetTop;
                    }
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                    itemY = seriesContainer[0].querySelector(".value").offsetTop + seriesContainer[0].querySelector(".value").offsetHeight;
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + seriesContainer[0].offsetTop + graphicContainer.clientHeight;
                    }
