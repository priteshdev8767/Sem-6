function Simple3DColumnChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
    this.svgAsset =true;
}
Simple3DColumnChart.prototype = Object.create(BaseColumnChart.prototype);
Simple3DColumnChart.prototype.constructor = Simple3DColumnChart;

Simple3DColumnChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["Simple3DColumnSeries"](argparent, argprops);
}
function Simple3DColumnSeries(argparent, argprops) {
    this.name = "Simple3DColumnSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
Simple3DColumnSeries.prototype = Object.create(BaseColumnSeries.prototype);
Simple3DColumnSeries.prototype.constructor = Simple3DColumnSeries;

Simple3DColumnSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["Simple3DColumnSeriesItem"](argparent, argprops);
}
function Simple3DColumnSeriesItem(argparent, argprops) {
    this.name = "Simple3DColumnSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
Simple3DColumnSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
Simple3DColumnSeriesItem.prototype.constructor = Simple3DColumnSeriesItem;

Simple3DColumnSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    BaseColumnSeriesItem.prototype.doAddTopGraphicsContainer.call(this, argparent, argprops);
    const index = argprops.index;
    const groupindex = argprops.gindex;

    const element = argparent.getElementsByClassName("chartgraphic")[0];
    element.className = "chartgraphic moodanimation transformOrginBottom";
    element.dataset.customorgin = "bottom";
    element.style.boxShadow = "unset";
    element.style.overflow = "hidden";
    let padding = 5;
    let moveX = element.clientWidth * 0.2; // Math.round
    let moveY = element.clientWidth * 0.2; //(element.clientHeight * 0.06);//Math.round
    let width = element.clientWidth - moveX;
    let seriesParentElement = argparent.parentNode;
    let height = element.clientHeight < moveY + padding ? moveY + padding : element.clientHeight;
    if (element.clientHeight < moveY + padding) element.parentElement.style.height = height + "px";
    let sideopacity = 0.8;
    let topopacity = 0.5;
    element.dataset.movey = moveY;
    if (this.index == 1) {
        seriesParentElement.style.position = "relative";
        seriesParentElement.style.left = -moveX + "px";
    }
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: height,
    });
    element.appendChild(svgElement);

    let clstyle =
        this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true
            ? "clsSecondaryFill"
            : this.data.hasEmphasis && this.data.emphasis[this.groupindex] == true
            ? this.data.ChartFonts.appendgraphicFillColor(this.groupindex)
            : this.getBgFillDetails(this.groupindex, this.data.ChartFonts.appendgraphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor");

    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     clstyle = " clsSecondaryFill";
    // }

    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
    //     clstyle += " prjectionOpacity";
    // }
    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (6) + "-fill";
    // }
    // if (this.data.projection[this.groupindex] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (1) + "-fill";
    // }

    let groupElement = this.data.SVGUtils.createSVGElement("g");
    // this.data.SVGUtils.assignAttributes(groupElement, {
    //     transform: "translate(5.935,38.2)",
    // });
    svgElement.appendChild(groupElement);

    let groupElement_1 = this.data.SVGUtils.createSVGElement("g");
    groupElement.appendChild(groupElement_1);

    let groupElement_2 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElement_2, {
        class: clstyle,
        "stroke-opacity": 0,
    });
    groupElement_1.appendChild(groupElement_2);

    let groupElement_3 = this.data.SVGUtils.createSVGElement("g");
    groupElement_2.appendChild(groupElement_3);

    let groupElementPath_4 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_4, {
        class: clstyle + "  cs-chart-main-graphic",
        "fill-opacity": sideopacity,
    });
    groupElement_3.appendChild(groupElementPath_4);
    let pathElement_4 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_4, {
        d: "M" + width + "," + moveY + "L" + (width + moveX) + "," + 0 + "L" + (width + moveX) + "," + (height - moveY) + "L" + width + "," + height + " Z",
    });
    groupElementPath_4.appendChild(pathElement_4);

    let groupElementPath_5 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_5, {
        class: clstyle + "  cs-chart-main-graphic",
        opacity: topopacity,
    });
    groupElement_3.appendChild(groupElementPath_5);
    let pathElement_5 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_5, {
        d: "M" + 0 + "," + moveY + "L" + moveX + "," + 0 + "L" + (width + moveX) + "," + 0 + "L" + width + "," + moveY + " Z",
    });
    groupElementPath_5.appendChild(pathElement_5);

    let groupElementPath_6 = this.data.SVGUtils.createSVGElement("g");
    groupElement_3.appendChild(groupElementPath_6);
    let pathElement_6 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_6, {
        d: "M0" + "," + moveY + "L" + width + "," + moveY + "L" + width + "," + height + "L" + 0 + "," + height + " Z",
    });
    groupElementPath_6.appendChild(pathElement_6);
};
Simple3DColumnSeriesItem.prototype.doAddBottomGraphicsContainer = function (argparent, argprops) {
    BaseColumnSeriesItem.prototype.doAddBottomGraphicsContainer.call(this, argparent, argprops);
    const index = argprops.index;
    const groupindex = argprops.gindex;

    const element = argparent.getElementsByClassName("chartgraphic")[0];
    element.className = "chartgraphic moodanimation transformOrginBottom";
    element.dataset.customorgin = "bottom";
    element.style.boxShadow = "unset";
    element.style.overflow = "hidden";
    let padding = 5;
    let moveX = element.clientWidth * 0.2; // Math.round
    let moveY = element.clientWidth * 0.2; //(element.clientHeight * 0.06);//Math.round
    let width = element.clientWidth - moveX;
    let height = element.clientHeight < moveY + padding ? moveY + padding : element.clientHeight;
    if (element.clientHeight < moveY + padding) element.parentElement.style.height = height + "px";
    let sideopacity = 0.8;
    let topopacity = 0.5;
    element.dataset.movey = moveY;
    let seriesParentElement = argparent.parentNode;
    if (this.index == 1) {
        seriesParentElement.style.position = "relative";
        seriesParentElement.style.left = -moveX + "px";
        argparent.style.position = "relative";
        argparent.style.top = -moveY + "px";
    }
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        x: "0%",
