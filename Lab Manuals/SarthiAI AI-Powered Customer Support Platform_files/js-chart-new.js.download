    { data: "left_middle", index: 10 },
    { data: "left_bottom", index: 9 },
];
function VOCustomProperties(argProp) {
    let ChartHelper = new window["ChartHelper"]();
    let ChartUtils = new window["ChartUtils"]();
    let ChartPropertiesName = new window["ChartPropertiesName"]();
    objAllProperties = {};
    let data = argProp.data;
    let hadSequeceNumber = null;
    let hadhighvaluebreak = null;
    let hadChartFlip = null;
    let objAsset = argProp.asset;
    let voLayout = argProp.voLayout;
    let objBaseProperties = argProp.baseProperties;
    let chartName = data.getAttribute("name");
    let slideContent = argProp.currentslide;
    let hasMultiGraphic = slideContent?.dataset?.multigraphicsupport == "true";
    let layoutName = data.getAttribute("layout");
    let chartCatagories = objBaseProperties.hasOwnProperty("chartCatagories") ? objBaseProperties.chartCatagories : "";
    let maxAllowedSeries = objBaseProperties.hasOwnProperty("maxAllowedSeries") ? objBaseProperties.maxAllowedSeries : 12;
    let minAllowedSeries = objBaseProperties.hasOwnProperty("minAllowedSeries") ? objBaseProperties.minAllowedSeries : 4;
    let maxAllowedSeriesItems = objBaseProperties.hasOwnProperty("maxAllowedSeriesItems") ? objBaseProperties.maxAllowedSeriesItems : 1;
    let isNegativeChart = objBaseProperties.hasOwnProperty("negativeChart") ? (objBaseProperties.negativeChart == "true" ? true : false) : false;
    let defaultindex = 0;
    hadDefaultShowValue = objBaseProperties.hasOwnProperty("showvalue");
    if (hadDefaultShowValue) voLayout.showValue = false;
    let hadPrefixSuffix = objBaseProperties.hasOwnProperty("prefixsuffix") ? ChartUtils.parseBoolen(objBaseProperties.prefixsuffix) : true;
    hadDataPoints = (objBaseProperties.hasOwnProperty("valueDisplayFormat") ? objBaseProperties.valueDisplayFormat : false) && voLayout.showValue;
    hadMergeItems = objBaseProperties.hasOwnProperty("merged") ? objBaseProperties.merged : false;
    hadGrid = objBaseProperties.hasOwnProperty("grid") ? objBaseProperties.grid : false;
    hadAxisTitle = objBaseProperties.hasOwnProperty("axisTitle") ? objBaseProperties.axisTitle : false;
    hadAxisLine = objBaseProperties.hasOwnProperty("axisLine") ? true : false;
    hadCagr = objBaseProperties.hasOwnProperty("hadCagr") ? true : false;
    hadAnnotation = objBaseProperties.hasOwnProperty("annotation") && 1 < data.children.length ? objBaseProperties.annotation : false;
    hadLegend = objBaseProperties.hasOwnProperty("legend") ? true : false;
    hadHighlightDiff = objBaseProperties.hasOwnProperty("highLightDiff") ? true : false;
    hadBaseLine = objBaseProperties.hasOwnProperty("baseLine") ? true : false;
    hadSeriesItemConnector = objBaseProperties.hasOwnProperty("seriesItemConnector") ? true : false;
    hadSeriesItemLabel = objBaseProperties.hasOwnProperty("seriesItemLabel") ? true : false;
    hadShowTotalValue = objBaseProperties.hasOwnProperty("showtotalvalue") ? true : false;
    hadSpline = objBaseProperties.hasOwnProperty("spline") ? true : false;
    hadLineHead = objBaseProperties.hasOwnProperty("linehead") ? true : false;
    hadIndualHd = false;
    hadScatter = objBaseProperties.hasOwnProperty("scatter") ? ChartUtils.parseBoolen(objBaseProperties.scatter) : false;
    hadRank = objBaseProperties.hasOwnProperty("isRankingChart") ? ChartUtils.parseBoolen(objBaseProperties.isRankingChart) : false;
    hadDataPointsLegend = objBaseProperties.hasOwnProperty("showDataPoints") ? ChartUtils.parseBoolen(objBaseProperties.showDataPoints) : false;
    hadGraphicSeperator = objBaseProperties.hasOwnProperty("seperator");
    hadSequeceNumber = objBaseProperties.hasOwnProperty("sequencenumber") ? objBaseProperties.hasOwnProperty("sequencenumber") : false;
    hadhighvaluebreak = objBaseProperties.hasOwnProperty("highvaluebreak") ? objBaseProperties.hasOwnProperty("highvaluebreak") : false;
    hadValueSeperator = objBaseProperties.hasOwnProperty("valueSeperator");
    hasSecondary = objBaseProperties.hasOwnProperty("secondary");
    hadPlaceholder = objBaseProperties.hasOwnProperty("primary");
    hadCommonPlaceholder = objBaseProperties.hasOwnProperty("commonPlaceholder");
    hadShadow = objBaseProperties.hasOwnProperty("shadow");
    hadMultiShadow = objBaseProperties.hasOwnProperty("multishadow");
    hadCustomLegend = objBaseProperties.hasOwnProperty("customLegend");
    hadSemiChart = objBaseProperties.hasOwnProperty("semiChart");
    hadCustomDoughnut = objBaseProperties.hasOwnProperty("customDoughnut");
    hadSecondaryText = objBaseProperties.hasOwnProperty("secondaryText");
    hadSum = objBaseProperties.hasOwnProperty("hasSumData") ? objBaseProperties.hasSumData : false;
    hadSeriesItemTitle = objBaseProperties.hasOwnProperty("isSeriesItemTitle") ? ChartUtils.parseBoolen(objBaseProperties.isSeriesItemTitle) : false;
    prefixData = objBaseProperties.hasOwnProperty("prefixdata") ? objBaseProperties.prefixdata : "";
    suffixData = objBaseProperties.hasOwnProperty("suffixdata") ? "" : "";
    hadChartFlip = objBaseProperties.hasOwnProperty("chartflip") ? objBaseProperties.hasOwnProperty("chartflip") : false;
    hadshowLabel = objBaseProperties.hasOwnProperty("haslabel") ? objBaseProperties.hasOwnProperty("haslabel") : false;
    hadCustomMaxValue = objBaseProperties.hasOwnProperty("hadCustomMaxValue");
    hadPromptText = objBaseProperties.hasOwnProperty("hadprompt") ? objBaseProperties.hasOwnProperty("hadprompt") : false;
    hadSorceText = objBaseProperties.hasOwnProperty("sourcetext") ? objBaseProperties.hasOwnProperty("sourcetext") : false;
    boolDisableAdditem = objBaseProperties.hasOwnProperty("disableadditem");
    hadDefaultPercentage = objBaseProperties.hasOwnProperty("defaultpercentage") ? true : false;
    hadhighlightvalue = objBaseProperties.hasOwnProperty("hadhighlightvalue") ? true : false;
    multislideCount = objBaseProperties.hasOwnProperty("multislidecount") ? objBaseProperties.multislidecount : 70;
    hadMultislide = objBaseProperties.hasOwnProperty("hadmultislide") ? true : false;
    hadSeriesAnimation = objBaseProperties.hasOwnProperty("hadseriesanimation") ? true : false;
    let length = data.children[0].getAttribute("value").split(",").length;

    hadSorting = objBaseProperties.hasOwnProperty("isCombination") || objBaseProperties.hasOwnProperty("isComparison") || !objBaseProperties.hasOwnProperty("sort") ? false : length != 1 ? false : 1 < data.children.length ? true : false;
    hadSorting = objBaseProperties.sort == "false" ? false : hadSorting;
    disableMerge = objBaseProperties.hasOwnProperty("disaplemerge") ? argProp.disaplemerge : false;
    hadComparison = objBaseProperties.hasOwnProperty("isComparison") ? true : false;
    hadCombination = objBaseProperties.hasOwnProperty("isCombination") ? true : false;
    hadPercentageFormat = objBaseProperties.hasOwnProperty("percentageType") ? true : false;
    hadInnerradius = objBaseProperties.hasOwnProperty("innerradius") ? true : false;
    hadDataPointsFormat = objBaseProperties.hasOwnProperty("showdefaultvalueformat") ? objBaseProperties.showdefaultvalueformat : false;
    boolDisableMaxValue = objBaseProperties.hasOwnProperty("disablemax") ? ChartUtils.parseBoolen(objBaseProperties.disablemax) : false;
    hadSecondaryLineChart = objBaseProperties.secondaryLineChart == "false" ? false : true;
    hadTrendline = objBaseProperties.hasOwnProperty("trendline") ? true : false;
    hadGroupLabel = objBaseProperties.hasOwnProperty("chartgroup") ? true : false;
    hadStatisticalLabel = objBaseProperties.hasOwnProperty("chartstatisticallabel") ? true : false;
    this._stackedChart = chartName == "columnStackedRectangle" || chartName == "barStackedRectangle" || chartName == "stackedAreaChart" ? true : false;
    this.percentageFormat = objBaseProperties.percentageType;
    this.baseLine = objBaseProperties.hasOwnProperty("baseLine");
    this.singleSeperator = objBaseProperties.hasOwnProperty("isSingleSeperator");
    this.axisBaseLine = data.getAttribute("axisbaseline") == "true" ? true : false;
    this.isSingleSeries = objBaseProperties.hasOwnProperty("isSingleSeries") ? true : false;
    this.isPercentageChart = objBaseProperties.hasOwnProperty("isPercentageChart") ? true : false;
    this._validHover = data.getAttribute("hover") ? (data.getAttribute("hover") == "true" ? true : false) : false;
    this.showSeriesItemTitle = objBaseProperties.hasOwnProperty("isSeriesItemTitle");
    this.alignment = objBaseProperties.hasOwnProperty("type") ? objBaseProperties.type : "vertical";
    this.hasChartGroup = ChartUtils.checkChartGroup(data);
    let values = [];
    let copyLabel = [];
    let copyIndex = [];
    let secondaryValues = [];
    let maxValue = 0;
    let minValue = 0;
    objCoinType = {};
    let seriesItemLength = 0;
    this.customMaxValue = 0;
    let item = data.getElementsByClassName("chartitem");
    let seriesLength = maxAllowedSeries < data.children.length ? maxAllowedSeries : data.children.length;
    let copyData = data.cloneNode(true);
    ChartUtils.doSort(null, copyData, Number(copyData.children.length));
    hadGrid = voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true" ? false : hadGrid;
    if (chartName == "barFXGVerticalChart" && voLayout.labelVPosition == "top") {
        hadGrid = false;
    }
    if (data.getAttribute("data-stackedsizevalue") == "true") {
        hadSecondaryLineChart = false;
        hadSeriesItemConnector = false;
        boolDisableMaxValue = true;
    }
    for (let seriesIndex = 0; seriesIndex < seriesLength; seriesIndex++) {
        let chartItem = data.children[seriesIndex];
        let copyChartItem = copyData.children[seriesIndex];
        values[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.value).split(",");
        copyIndex[seriesIndex] = copyChartItem.getAttribute(ChartPropertiesName.index);
        copyLabel[seriesIndex] = "";
        if (hadCombination | hadComparison) secondaryValues[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.secondaryValue) ? chartItem.getAttribute(ChartPropertiesName.secondaryValue).split(",") : chartItem.getAttribute(ChartPropertiesName.value).split(",");
        seriesItemLength = values[seriesIndex].length == 0 ? 1 : values[seriesIndex].length;
        seriesItemLength = maxAllowedSeriesItems < seriesItemLength ? maxAllowedSeriesItems : seriesItemLength;
        for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
            let numValue = parseFloat(values[seriesIndex][seriesItemIndex]);
            let numSecondaryValue = seriesIndex < secondaryValues.length ? parseFloat(secondaryValues[seriesIndex][seriesItemIndex]) : 0;
            numValue = isNegativeChart ? numValue : numValue < 0 ? 0 : numValue;
            if (hadComparison || hadCombination) {
                if (seriesIndex == 0 && seriesItemIndex == 0) {
                    if (numValue < numSecondaryValue) {
                        this._minValue = numValue;
                        this._maxValue = numSecondaryValue;
                    } else {
                        this._minValue = numSecondaryValue;
                        this._maxValue = numValue;
                    }
                } else {
                    let comarisonMinValue;
                    let comarisonMaxValue;
                    if (numValue < numSecondaryValue) {
                        comarisonMinValue = numValue;
                        comarisonMaxValue = numSecondaryValue;
                    } else {
                        comarisonMinValue = numSecondaryValue;
                        comarisonMaxValue = numValue;
                    }
                    minValue = minValue < comarisonMinValue ? minValue : comarisonMinValue;
                    maxValue = comarisonMaxValue < maxValue ? maxValue : comarisonMaxValue;
                }
            } else {
                if (seriesIndex == 0 && seriesItemIndex == 0) {
                    minValue = maxValue = numValue;
                } else {
                    minValue = minValue < numValue ? minValue : numValue;
                    maxValue = numValue < maxValue ? maxValue : numValue;
                }
            }
        }
    }
    if (seriesLength == 2 && chartName == "columnSimpleRectangle" && (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true")) {
        boolDisableAdditem = "true";
    }
    this.grid = hadGrid == "true" ? true : false;

    //------------------------------------------  percentage format  -----------------------------------------------------

    this.percentageFormattype = data.getAttribute("datavaluetype") ? data.getAttribute("datavaluetype") : this.percentageFormat == "percentage" ? "numeric" : "percentage";

    let intPercentageFormatindex = ChartUtils.getSelectedIndex(arrPercentageFormatList, this.percentageFormattype);
    let objPercentageFormat = {
        visible: hadPercentageFormat,
        dpSource: arrPercentageFormatList,
        selectedindex: intPercentageFormatindex,
    };

    //------------------------------------------  innerRadius  -----------------------------------------------------

    let strChartName = data.getAttribute("name");
    if (!!strChartName) {
        if (strChartName.includes("pie") || strChartName.includes("Pie")) {
            this.innerRadius = hadInnerradius ? data.getAttribute("innerradius") : 0;
            this.innerRadius = !!this.innerRadius ? parseInt(this.innerRadius) : 0;
        }
        if (strChartName.toLowerCase().includes("doughnut") || strChartName.includes("Doughnut") || strChartName.includes("gaugechart")) {
            this.innerRadius = hadInnerradius ? data.getAttribute("innerradius") : 0;
            this.innerRadius = !!this.innerRadius ? parseInt(this.innerRadius) : 50;
        }
        this.innerRadius = this.innerRadius > 80 ? 80 : this.innerRadius;
    }

    let minimum = objBaseProperties.minInnerRadius;
    let maximum = objBaseProperties.maxInnerRadius;
    let objInnerradius = {
        minimum: minimum,
        maximum: maximum,
        visible: hadInnerradius,
        value: this.innerRadius,
        // property:"innerradius"
    };

    //------------------------------------------  legend  -----------------------------------------------------

    let showlegend = false;
    if (data.getAttribute("comparedivider") == "true") {
        hadLegend = false;
    }

    if (hadLegend && voLayout.showLegend) {
        if (1 < parseInt(maxAllowedSeries)) {
            if (1 < parseInt(maxAllowedSeriesItems)) {
                if (1 < seriesItemLength) {
                    showlegend = true;
                    this.legendPosition = voLayout.legendPosition ? voLayout.legendPosition : "bottom";
                }
            } else if (7 != parseInt(maxAllowedSeries)) showlegend = true;
        }
        // if(showlegend){
        this.legendPosition = data.getAttribute("customlegendposition") ? data.getAttribute("customlegendposition") : this.legendPosition;
        this.legendPosition = this.legendPosition ? this.legendPosition : voLayout.legendPosition;
        // }
    }
    let arrLegendPosition = voLayout.legendAlignment;
    this.legendPosition = data.getAttribute("customlegendposition") ? data.getAttribute("customlegendposition") : this.legendPosition;
    this.legendPositionAlignment = data.getAttribute("legendpositionalignment") ? data.getAttribute("legendpositionalignment") : "";
    if (!this.legendPositionAlignment) {
        if (this.legendPosition == "bottom" || this.legendPosition == "top") {
            let legendSecondaryAlign = voLayout.legendSecondaryAlign == "center" || voLayout.legendSecondaryAlign == "left" || voLayout.legendSecondaryAlign == "right" ? voLayout.legendSecondaryAlign : "left";
            this.legendPositionAlignment = this.legendPosition + "_" + legendSecondaryAlign;
        } else if (this.legendPosition == "left" || this.legendPosition == "right") {
            let legendSecondaryAlign = voLayout.legendSecondaryAlign == "middle" || voLayout.legendSecondaryAlign == "top" || voLayout.legendSecondaryAlign == "bottom" ? voLayout.legendSecondaryAlign : "middle";
            this.legendPositionAlignment = this.legendPosition + "_" + legendSecondaryAlign;
        }
    }
    let intLegendPositionAlignmentIndex = ChartUtils.getSelectedIndex(dpLegendPositions, this.legendPositionAlignment);
    let objLegendPosition = {
        visible: showlegend,
        dpSource: arrLegendPos,
        selectedindex: intLegendPositionAlignmentIndex,
    };

    //------------------------------------------  appearance  -----------------------------------------------------

    this.fillType = "all";
    this.appearance = "solid";
    let arrAppearanceList = [];
    if (objAsset != null && objAsset.colorApply) {
        let arrAppearance = objAsset.colorApply.split(",");
        let length = arrAppearance.length;
        for (let i1 = 0; i1 < length; i1++) {
            let arrAppearanceItem = arrAppearance[i1].split(":");
            arrAppearanceList[i1] = {
                value: arrAppearanceItem[0],
                colorObj: arrAppearanceItem[1],
            };
        }
    } else {
        arrAppearanceList[0] = {
            value: hadShadow && (seriesItemLength == 1 || hadMultiShadow) ? "Shadow" : "solid",
            colorObj: "all",
        };
    }

    let strCustomAppearance = data.getAttribute(ChartPropertiesName.appearance);
    if (strCustomAppearance != null) {
        this.appearance = strCustomAppearance;
        let length = arrAppearanceList.length;
        for (let i1 = 0; i1 < length; i1++) {
            if (strCustomAppearance == arrAppearanceList[i1].value) {
                this.fillType = arrAppearanceList[i1].colorObj;
                break;
            }
        }
    } else {
        this.fillType = arrAppearanceList[0].colorObj;
        this.appearance = arrAppearanceList[0].value;
    }
    // if (layoutName == "toplabel" || layoutName == "topvalue")  this.appearance = "solid";
    //------------------------------------------  graphics seperator  -----------------------------------------------------

    hadGraphicSeperator = minValue >= 0 ? hadGraphicSeperator : false;
    this.graphicSeperator = minValue >= 0 ? (data.getAttribute("enablegraphicseperator") ? (data.getAttribute("enablegraphicseperator") == "true" ? true : false) : false) : false;
    this.graphicSeperatorType = data.getAttribute("graphicseperatortype") ? data.getAttribute("graphicseperatortype") : "line";
    this.graphicSeperatorAlignType = data.getAttribute("graphicSeperatorAlignType") ? data.getAttribute("graphicSeperatorAlignType") : "horizontal";
    this.graphicSeperatorLineType = data.getAttribute("graphicSeperatorLineType") ? data.getAttribute("graphicSeperatorLineType") : "dotted";
    let arrGraphicSeperatorAlignList = this.singleSeperator ? arrSingleSeperator : arrMultiSeperator;
    let intGraphicSeperatorIndex = ChartUtils.getSelectedIndex(arrGraphicSeperatorList, this.graphicSeperatorType);
    let intGraphicSeperatorAlignIndex = ChartUtils.getSelectedIndex(arrGraphicSeperatorAlignList, this.graphicSeperatorAlignType);
    let intGraphicSeperatorLineIndex = ChartUtils.getSelectedIndex(arrGraphicSeperatorlineList, this.graphicSeperatorLineType);
    let objGraphicSeperator = {
        visible: hadGraphicSeperator,
        value: this.graphicSeperator,
        dpSeperatorType: arrGraphicSeperatorList,
        selectedseperatorindex: intGraphicSeperatorIndex,
        dpSeperatorAlignType: arrGraphicSeperatorAlignList,
        selectedseperatoralignindex: intGraphicSeperatorAlignIndex,
        dpSeperatorlineType: arrGraphicSeperatorlineList,
        selectedseperatorlineindex: intGraphicSeperatorLineIndex,
    };

    //------------------------------------------  coin Type  -----------------------------------------------------
    if (objBaseProperties.hasOwnProperty("coinStyle") && ChartHelper.parseBoolen(objBaseProperties.coinStyle)) {
        let coinType = data.getAttribute("coinstyle");
        coinType = coinType == undefined ? "zigzag" : coinType;

        objCoinType = {
            visible: true,
            dpcharttype: arrCoinType,
            selectedindex: ChartUtils.getSelectedIndex(arrCoinType, coinType),
        };
    }
    //------------------------------------------  animation  -----------------------------------------------------
    if (hasMultiGraphic) {
        data.removeAttribute("animation");
    }
    let animationType = data.getAttribute("animation");
    animationType = animationType == undefined ? "allatonce" : animationType;
    arrAnimationType = [
        {
            data: "animationoff",
            label: "floateranimtaionoff",
        },
        {
            data: "animateoneatatime",
            label: "floateroneafteranother",
        },
        {
            data: "animateallatonce",
            label: "animationallatonce",
        },
    ];
    if (parseInt(maxAllowedSeries) == 1 || (data.children.length == 1 && (strChartName == "barStackedRectangle" || strChartName == "columnStackedRectangle"))) {
        arrAnimationType = [
            {
                data: "animationoff",
                label: "floateranimtaionoff",
            },
            {
                data: "animateallatonce",
                label: "animationallatonce",
            },
        ];
    }
    if (hadSeriesAnimation && seriesItemLength > 1 && data.getAttribute("multislide") != "true") {
        arrAnimationType = [
            {
                data: "animationoff",
                label: "floateranimtaionoff",
            },
            {
                data: "animateoneatatime",
                label: "floateroneafteranother",
            },
            {
                data: "animateallatonce",
                label: "animationallatonce",
            },
        ];
    }
    if (this.hasChartGroup || (data.getAttribute("secondarylinechart") == "true" && objBaseProperties.secondaryLineChart != "false")) {
        arrAnimationType = [
            {
                data: "animationoff",
                label: "floateranimtaionoff",
            },
            {
                data: "animateallatonce",
                label: "animationallatonce",
            },
        ];
    }
    arrAnimationType = [
        {
            data: "animationoff",
            label: "floateranimtaionoff",
        },
        {
            data: "animateallatonce",
            label: "animationallatonce",
        },
    ];
    let indexValue = parseInt(maxAllowedSeries) == 1 || data.children.length == 1 || this.hasChartGroup ? 1 : 1;
    let boolsingleValue = parseInt(maxAllowedSeries) == 1 || data.children.length == 1 ? true : false;
    let swithValue = animationType == "animationoff" ? false : true;
    let boolMultisereis = hadSeriesAnimation && seriesItemLength > 1 && data.getAttribute("multislide") != "true";
    let hasAnimation = data.getAttribute("isTakeaway") == "true" || hasMultiGraphic ? false : true;
    hasAnimation = false;
    let objAnimation = {
        visible: hasAnimation,
        singlevalue: boolsingleValue,
        multiseries: boolMultisereis,
        dpcharttype: arrAnimationType,
        selectedindex: ChartUtils.getSelectedIndex(arrAnimationType, animationType, indexValue),
        value: swithValue,
    };
    //------------------------------------------  value Format  -----------------------------------------------------
    this.showValueFormat = objBaseProperties.hasOwnProperty("valueFormat") ? true : false;
    let valueFormat = data.getAttribute("valueformat");

    valueFormat = valueFormat == undefined ? (suffixData == "%" || hadDefaultPercentage ? "percentage" : "asentered") : valueFormat;
    if (chartName.includes("pie") || "doughnutChart") {
        arrValueDisplayFormat = [
            { data: "percentage", label: "floaterpercentage" },
            { data: "asentered", label: "floateraseneteredvalue" },
        ];
    } else {
        arrValueDisplayFormat = [
            { data: "number", label: "number" },
            { data: "percentage", label: "floaterpercentage" },
            { data: "currency", label: "currency" },
            { data: "asentered", label: "floateraseneteredvalue" },
        ];
    }
    let objValueFormat = {
        visible: this.showValueFormat,
        dpcharttype: arrValueDisplayFormat,
        selectedindex: ChartUtils.getSelectedIndex(arrValueDisplayFormat, valueFormat, 0),
        property: "valueformat",
    };
    if (strChartName == "simpleIconFillRepeatChart") {
        objValueFormat = {
            visible: this.showValueDisplayFormat,
            dpcharttype: arrValueFormatType,
            selectedindex: ChartUtils.getSelectedIndex(arrValueFormatType, valueFormat, 0),
            property: "valueformat",
        };
    }
    let valueMaxCount = data.getAttribute("maxvaluecount");
    let objMaxValueCount = {
        visible: this.showValueFormat,
        dpcharttype: arrMaxValueCount,
        selectedindex: ChartUtils.getSelectedIndex(arrMaxValueCount, valueMaxCount, 4),
    };

    //------------------------------------------  value Display Format  -----------------------------------------------------
    this.showValueDisplayFormat = objBaseProperties.valuedisplayformatdisable == "true" ? false : true; //objBaseProperties.hasOwnProperty("valueFormat") ? true : false;
    let valueDisplayFormat = data.getAttribute("valuedisplayformat");
    valueDisplayFormat = valueDisplayFormat == undefined ? "number" : valueDisplayFormat;
    if (chartName.includes("pie")) {
        arrValueDisplayFormat = [
            { data: "percentage", label: "floaterpercentage" },
            { data: "asentered", label: "floateraseneteredvalue" },
        ];
    } else {
        arrValueDisplayFormat = [
            { data: "number", label: "number" },
            { data: "percentage", label: "floaterpercentage" },
            { data: "currency", label: "currency" },
            { data: "asentered", label: "floateraseneteredvalue" },
        ];
    }
    let objValueDisplayFormat = {
        visible: this.showValueDisplayFormat,
        dpcharttype: arrValueDisplayFormat,
        selectedindex: ChartUtils.getSelectedIndex(arrValueDisplayFormat, valueFormat, 0),
        property: "valueformat",
        label: "floatervaluedisplayformat",
    };
    if (strChartName == "simpleIconFillRepeatChart") {
        objValueDisplayFormat = {
            visible: this.showValueDisplayFormat,
            dpcharttype: arrValueFormatType,
            selectedindex: ChartUtils.getSelectedIndex(arrValueFormatType, valueFormat, 0),
            property: "valueformat",
            label: "floatervaluedisplayformat",
        };
        objValueDisplayFormat.interchange = true;
    }

    //------------------------------------------  stacked  -----------------------------------------------------

    this.showStack = objBaseProperties.hasOwnProperty("stackChart") && seriesItemLength > 1 ? true : false;
    let selectedIndex = data.getAttribute("chartstack");
    let objStacking = {
        visible: this.showStack,
        selectedindex: ChartUtils.getSelectedIndex(arrStack, selectedIndex),
    };

    //------------------------------------------  prefix suffix  -----------------------------------------------------

    let prefixIndex = 0;
    let suffixIndex = 0;
    let showSuffix = hadPrefixSuffix;
    let showPrefix = hadPrefixSuffix;
    let showValueSeperator = true;
    this.datalabels = hadLegend || hadDataPoints || voLayout.showValue ? (data.getAttribute("datalabels") == "false" ? false : true) : false;
    let hadValuePoints = hadDataPointsLegend ? true : hadDataPoints;
    this.datalabels = hadDataPointsLegend ? true : this.datalabels;
    let showScale = maxAllowedSeries == 1 ? false : hadValuePoints;
    let showDisplay = maxAllowedSeries == 1 ? false : hadDataPoints;

    if (this.datalabels) {
        let prefixtype = data.getAttribute("valueprefixtype");
        let suffixtype = data.getAttribute("valuesuffixtype");
        this.prefix = data.getAttribute("valueprefixtype");
        this.suffix = data.getAttribute("valuesuffixtype");
        this.showDataPoints = hadDataPoints;
        // if(data.getAttribute("overlapgrid")=="true"){
        //     this.showDataPoints =false;
        // }
        if (this.prefix == null && prefixData) {
            this.prefix = prefixData;
        }
        if (this.suffix == null && suffixData) {
            this.suffix = suffixData;
        }
        if ((this.prefix == null || this.prefix == undefined) && (prefixtype == null || prefixtype == undefined)) prefixtype = "none";
        if (prefixtype == null || prefixtype == undefined) prefixtype = "custom";
        if (prefixtype != "none" && prefixtype != "custom") this.prefix = prefixtype;
        prefixIndex = ChartUtils.getSelectedIndex(arrPrefix, prefixtype);

        if ((this.suffix == null || this.suffix == undefined) && (suffixtype == null || suffixtype == undefined)) suffixtype = "none";
        if (suffixtype == null || suffixtype == undefined) suffixtype = "custom";
        if (suffixtype != "none" && suffixtype != "custom") this.suffix = suffixtype;
        if (suffixtype != "none" && suffixtype != "custom") this.suffix = suffixtype;
        suffixIndex = ChartUtils.getSelectedIndex(arrPrefix, suffixtype);

        this.prefix = this.prefix == null || this.prefix == undefined || prefixtype == "none" ? "" : this.prefix;
        this.suffix = this.suffix == null || this.suffix == undefined || suffixtype == "none" ? "" : this.suffix;
        this.denominationPrefix = data.getAttribute("valuescale") ? data.getAttribute("valuescale") : "none";
        this.suffix = this.denominationPrefix == "none" ? this.suffix : this.denominationPrefix == "auto" ? (maxValue < 100000 ? this.suffix : "") : "";
        this.suffix = this.suffix.length < 2 ? this.suffix : " " + this.suffix;
        this.labelSize = data.getAttribute("labelsize");
        this.labelSize = this.labelSize == undefined ? "large" : this.labelSize;
        this.datapoint = hadDataPointsFormat && !data.getAttribute("displayvalue") ? hadDataPointsFormat : data.getAttribute("displayvalue");
        this.datapoint = this.datapoint == null || this.datapoint == undefined ? "all" : this.datapoint;
    } else {
        this.suffix = "";
        this.prefix = "";
        this.showDataPoints = false;
        this.datapoint = "all";
        this.labelSize = "large";
        this.denominationPrefix = "none";
    }
    this.showDataPoints = !data.getAttribute("disaplevalueformat") ? this.showDataPoints : false;
    if (this._validHover && !data.getAttribute("displayvalue")) this.datapoint = "none";

    let selectedindexscale = ChartUtils.getSelectedIndex(arrDenominationPrefix, this.denominationPrefix);
    showSuffix = selectedindexscale == 0 ? showSuffix : false;

    if (this.isSingleSeries && this.isPercentageChart) {
        this.suffix = "";
        this.prefix = "";
        showScale = false;
        showSuffix = false;
        showPrefix = false;
        showValueSeperator = false;
    }
    if (voLayout.valueItemBased == "true") {
        arrDisplay = [
            {
                data: "all",
                label: "all",
            },
            {
                data: "F",
                label: "chartdatapointsfirstonly",
            },
            {
                data: "L",
                label: "chartdatapointslastonly",
            },
            {
                data: "F,L",
                label: "chartdatapointsfirstandlast",
            },
            {
                data: "H",
                label: "chartdatapointshigh",
            },
            {
                data: "LO",
                label: "chartdatapointslow",
            },
            {
                data: "L,H",
                label: "chartdatapointslowandheigh",
            },
        ];
    } else {
        arrDisplay = [
            {
                data: "all",
                label: "all",
            },
            {
                data: "F",
                label: "chartdatapointsfirstonly",
            },
            {
                data: "L",
                label: "chartdatapointslastonly",
            },
            {
                data: "F,L",
                label: "chartdatapointsfirstandlast",
            },
            {
                data: "H",
                label: "chartdatapointshigh",
            },
            {
                data: "LO",
                label: "chartdatapointslow",
            },
            {
                data: "L,H",
                label: "chartdatapointslowandheigh",
            },
            {
                data: "none",
                label: "none",
            },
        ];
    }
    this.suffix = this.suffix.includes("%,%,%") ? "" : this.suffix;
    this.prefix = this.prefix.includes("$,$,$") ? "" : this.prefix;
    // if (strChartName == "waterfallchart"&&) {
    this.suffix = this.suffix ? this.suffix.split(",")[0] : this.suffix;
    this.prefix = this.prefix ? this.prefix.split(",")[0] : this.prefix;
    // }
    if (valueFormat == "asentered" || valueFormat == "percentage") {
        showSuffix = false;
        showPrefix = false;
    }

    let objPrefixSuffix = {
        value: true,
        dpSource: "",
        showscale: showScale,
        showdisplay: showDisplay,
        showsuffix: showSuffix,
        showprefix: showPrefix,
        showvalueseperator: showValueSeperator,
        showLabelSize: false, //voLayout.showValue,
        visible: hadPrefixSuffix,
        prefixtype: this.prefix,
        suffixtype: this.suffix,
        showdisplay: this.showDataPoints,
        selectedindexsuffix: suffixIndex,
        selectedindexprefix: prefixIndex,
        selectedindexscale: selectedindexscale,
        selectedindexdisplay: ChartUtils.getSelectedIndex(arrDisplay, this.datapoint),
        selectedindexsize: ChartUtils.getSelectedIndex(arrLabelSize, this.labelSize),
        displayFormat: arrDisplay,
    };

    //------------------------------------------  sorting  -----------------------------------------------------

    this.sortType = seriesItemLength <= 1 ? data.getAttribute("sort") : null;
    let defaultSort = objBaseProperties.sortType;
    if (this.sortType == null || objBaseProperties.name == "pyramidChart" || objBaseProperties.name == "funnelChart") this.sortType = defaultSort != null ? defaultSort : "";

    let intSelectedindex = ChartUtils.getSelectedIndex(arrSortingList, this.sortType);
    let objSorting = {
        visible: hadSorting,
        value: 0 < intSelectedindex ? true : false,
        dpSource: arrSortingList,
        selectedindex: intSelectedindex,
        property: "sort",
    };
    //------------------------------------------  iconsize  -----------------------------------------------------

    this.iconSize = data.getAttribute("iconsize");
    hadPlaceholderSize = hadPlaceholder || data.getAttribute("comparedivider") == "true";
    let inticonSelectedindex = ChartUtils.getSelectedIndex(arrIconSize, this.iconSize, 0);
    let objiconsize = {
        visible: hadPlaceholderSize,
        value: 0 < inticonSelectedindex ? true : false,
        dpSource: arrIconSize,
        selectedindex: inticonSelectedindex,
    };
    //------------------------------------------  highlight diffrents  -----------------------------------------------------
    hadComapreHighlight = !hadHighlightDiff || data.getAttribute("data-baseline") == "true" ? false : hadHighlightDiff;
    if ((seriesLength <= 2 || maxAllowedSeries <= 2) && chartName == "columnSimpleRectangle" && (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true")) {
        hadComapreHighlight = false;
    }
    if (seriesItemLength > 1 && chartName == "lineChart") {
        hadComapreHighlight = false;
    }
    let highlightdifference = data.getAttribute("highlightdifference") || data.getAttribute("data-highlightdifference") || data.getAttribute("data-indualhighlight");
    this.showComparisonHighlight = hadComapreHighlight ? (highlightdifference ? ChartUtils.parseBoolen(highlightdifference) : false) : false;

    if (!highlightdifference) {
        data.setAttribute("highlightdifferencepoint1", 0 + "," + (seriesLength - 1));
    }

    this.valuecomparisondescription = data.getAttribute("highlightdifferencedescription");
    this.valueComparisonDisplay = data.getAttribute("highlightdifferencedisplay");
    this.primaryValue = Number(data.getAttribute("highlightdifferencepoint1")?.split(",")[0]);
    this.secondaryValue = Number(data.getAttribute("highlightdifferencepoint1")?.split(",")[1]);

    if (this.primaryValue > item.length - 1 || this.secondaryValue > item.length - 1 || !hadComapreHighlight || data.getAttribute("multislide") == "true") {
        this.showComparisonHighlight = false;
        data.removeAttribute("highlightdifference");
        data.removeAttribute("highlightdifferencepoint1");
        data.removeAttribute("highlightdifferencepoint2");
        data.removeAttribute("highlightdifferencedisplay");
        data.removeAttribute("highlightdifferencedescription");
    }
    let arrLabel = copyLabel;
    let arrIndex = copyIndex;
    if (this.primaryValue == this.secondaryValue) {
        this.primaryValue = 0;
        this.secondaryValue = seriesLength - 1;
    }
    this.comapreHighlight = hadComapreHighlight && 1 < seriesLength ? true : false;
    if (data.getAttribute("multislide") == "true") {
        this.comapreHighlight = false;
    }
    if (seriesItemLength > 1) {
        this.primaryValue = "";
        this.secondaryValue = "";
    }
    let hdType = data.getAttribute("hdtype") ? data.getAttribute("hdtype") : "";
    if (seriesItemLength > 1 && !this._stackedChart) {
        dpHighlightType = [{ data: "all", label: "floaterhdall" }];
    } else {
        dpHighlightType = [
            { data: "single", label: "floaterhdsingle" },
            { data: "all", label: "floaterhdall" },
        ];
    }
    let hdTypeIndex = ChartUtils.getSelectedIndex(dpHighlightType, hdType);
    let minNegativeValue = data.getAttribute("minvalue") ? parseFloat(data.getAttribute("minvalue")) : 0;
    let objHdType = {
        dpSource: dpHighlightType,
        selectedindex: hdTypeIndex,
    };
    let hdFormat = data.getAttribute("hddisplayformat") ? data.getAttribute("hddisplayformat") : "percentage";
    let hdDisplayIndex = ChartUtils.getSelectedIndex(dpHighlightDisplay, hdFormat);
    let objDisplayFormat = {
        dpSource: dpHighlightDisplay,
        selectedindex: hdDisplayIndex,
        property: "hddisplayformat",
    };
    //------------------------------------------  Highlight Differnce Reverser -----------------------------------------------------
    let defaultArrowPosition = seriesItemLength == 2 ? "both" : "end";
    let hdArrowState = data.getAttribute("indualhdrev") ? data.getAttribute("indualhdrev") : defaultArrowPosition;
    let hdarrowstateIndex = ChartUtils.getSelectedIndex(dpArrowState, hdArrowState);
    let objIndualHdRev = {
        dpSource: dpArrowState,
        selectedindex: hdarrowstateIndex,
    };
    if ((seriesItemLength > 2 && !this._stackedChart) || this.valueBaseLine) {
        this.comapreHighlight = false;
        this.showComparisonHighlight = false;
        objHdType = {};
        objIndualHdRev = {};
        objDisplayFormat = {};
    }
    this.comapreHighlight = data.getAttribute("isTakeaway") == "true" ? false : this.comapreHighlight;
    let addHighlight = maxAllowedSeriesItems > seriesItemLength ? true : false;
    let highlightindexLength = data.getAttribute("highlightdifferencecount") ? parseInt(data.getAttribute("highlightdifferencecount")) : 0;
    let objAddHighlight = {
        visible: this.showComparisonHighlight && hdType != "all" && seriesLength > 2,
        value: addHighlight,
        index: highlightindexLength + 1,
    };
    let objHighlightDiffrents = {
        visible: this.comapreHighlight,
        value: this.showComparisonHighlight,
        // highlightdifferencedescription: this.valuecomparisondescription,
        highlightdifferencepoints: [],
        highlightdifferencedisplay: ChartUtils.getSelectedIndex(arrComparisonHighlightType, this.valueComparisonDisplay, 0),
        arrLabel: arrLabel,
        arrIndex: arrIndex,
        count: seriesLength,
        HighlightDifferencType: objHdType,
        HighlightDifferencDisplay: objDisplayFormat,
        HighlightDifferencRev: objIndualHdRev,
        addHighlight: objAddHighlight,
        highlightdifferencecount: highlightindexLength + 1,
    };
    for (let h1 = 0; h1 < highlightindexLength + 1; h1++) {
        let primaryIndex =
            Number(
                data
                    .getAttribute("highlightdifferencepoint" + parseInt(h1 + 1))
                    ?.split(",")[0]
                    ?.toString(),
            ) || this.primaryValue;
        let secondaryIndex =
            Number(
                data
                    .getAttribute("highlightdifferencepoint" + parseInt(h1 + 1))
                    ?.split(",")[1]
                    ?.toString(),
            ) || this.secondaryValue;
        objHighlightDiffrents.highlightdifferencepoints.push({
            highlightdifferencepoint1: primaryIndex,
            highlightdifferencepoint2: secondaryIndex,
        });
    }
    //------------------------------------------  x axis  -----------------------------------------------------

    let xAxis = data.getAttribute("xaxis");
    this.xAxisTitle = data.getAttribute("xaxistitle");
    this.xAxisTitle = this.xAxisTitle ? (this.xAxisTitle.trim() == "" ? "" : this.xAxisTitle) : "";
    let defaultxAxisTitle = data.getAttribute("data-showxaxistitle") == "true" ? true : false;
    let defaultxAxisLine = data.getAttribute("data-showxaxisline") == "true" ? true : voLayout.showXAxisCustomLine == "true" ? true : false;
    // let disbleXaxis = objBaseProperties.hasOwnProperty("disablexaxis") ? ChartUtils.parseBoolen(objBaseProperties.disablexaxis) : false;
    // xAxis = disbleXaxis?"false":xAxis;
    this.showLabels = data.getAttribute("showlabel") == "false" ? false : hadshowLabel ? true : false;
    if (hadAxisTitle) {
        if (xAxis == null) {
            //default
            xAxis = true;
            this.showLabels = data.getAttribute("showlabel") == "false" ? false : true;
            this.showXAxisTitle = data.getAttribute("showxaxistitle") ? (data.getAttribute("showxaxistitle") == "true" ? true : false) : defaultxAxisTitle;
            this.showXAxisLine = data.getAttribute("showxaxisline") ? (data.getAttribute("showxaxisline") == "true" ? true : false) : defaultxAxisLine;
            if (voLayout.showXAxisCustomLine == "true" && !this.showXAxisLine) {
                if (data.getAttribute("showcustomxaxisline") == "false") {
                } else {
                    this.showXAxisLine = voLayout.showXAxisCustomLine == "true";
                }
            }
            this.showXAxisGrid = false;
        } else if (xAxis == "false") {
            xAxis = false;
            this.showLabels = false;
            this.showXAxisTitle = false;
            this.showXAxisLine = false;
            this.showXAxisGrid = false;
        } else {
            xAxis = true;
            this.showLabels = data.getAttribute("showlabel") == "true" ? true : false;
            this.showXAxisTitle = data.getAttribute("showxaxistitle") == "true" ? true : false;
            this.showXAxisLine = data.getAttribute("showxaxisline") == "true" ? true : false; //xaxisline
            this.showXAxisGrid = data.getAttribute("showxaxisgridline") == "true" ? true : false;
        }
        if (xAxis && this.grid) {
            data.setAttribute("showlabel", this.showLabels);
            data.setAttribute("showxaxistitle", this.showXAxisTitle);
            data.setAttribute("showxaxisline", this.showXAxisLine);
            // data.setAttribute("showxaxisgridline",this.showXAxisGrid);
        }
    } else {
        if (hadshowLabel) {
            this.showLabels = data.getAttribute("showlabel") == "false" ? false : true;
        } else {
            this.showLabels = true;
        }
        this.showXAxisTitle = false;
        this.showXAxisLine = false;
        this.showXAxisGrid = false;
    }
    if (voLayout.showLabel) voLayout.showLabel = this.showLabels;
    let hasItemBased = voLayout.labelItemBased == "true";
    let objShaowLabel = {
        visible: (hadAxisTitle || hadshowLabel) && !hasItemBased,
        value: this.showLabels,
        property: "showlabel",
        label: "label",
    };
    if (layoutName == "sidelabel") {
        this.showXAxisLine = false;
    }
    let objXAxis = {
        value: xAxis,
        visible: hadAxisTitle,
        visibleXAxis: strChartName != "bar3DChart" && xAxis && this.grid,
        showname: this.showXAxisTitle,
        showline: this.showXAxisLine,
        showgrid: this.showXAxisGrid,
        datalabels: data.getAttribute("showlabel") == "true" ? true : false,
        dataname: data.getAttribute("showxaxistitle") == "true" ? true : false,
        dataline: data.getAttribute("showxaxisline") == "true" ? true : false,
        datagrid: data.getAttribute("showxaxisgridline") == "true" ? true : false,
        property: "xaxis",
        label: "floatersettingschartaxisline",
    };
    objXAxis["secondaryProperty"] = [{ property: "showxaxistitle", label: "floatersettingschartaxisname", value: objXAxis.dataname }];

    // if (this.showXAxisLine) this.showXAxisLine = minValue > 0;
    // if (this.showXAxisGrid) this.showXAxisGrid = minValue > 0;
    //------------------------------------------  barspace  -----------------------------------------------------

    let barSpace = data.getAttribute("barspace") ? data.getAttribute("barspace") : data.getAttribute("data-barspace");
    let barSpaceIndex = ChartUtils.getSelectedIndex(arrBarSpace, barSpace);
    hadMergeItems = voLayout.placeholderInset == "middle" || voLayout.labelItemBased == "true" || !disableMerge ? false : hadMergeItems;
    let objBarSpace = {
        visible: hadMergeItems,
        selectedindex: barSpaceIndex,
    };
    this.showMergeItems = barSpace == "Contiguous" ? true : false;
    if (voLayout.itemalignment == "contiguous") {
        this.showMergeItems = true;
    }
    //------------------------------------------  y axis  -----------------------------------------------------

    let yAxisSuffixType = "";
    let yAxisPrefixType = "";
    let yAxisPrefixIndex = 0;
    let yAxisSuffixIndex = 0;
    let yAxis = data.getAttribute("yaxis");
    let enablegrid = data.getAttribute("enablegrid");
    this.yAxisTitle = data.getAttribute("yaxistitle");
    this.yAxisTitle = this.yAxisTitle ? (this.yAxisTitle.trim() == "" ? "" : this.yAxisTitle) : "";
    this.yAxisMaxValue = data.getAttribute("yaxismaxvalue") ? data.getAttribute("yaxismaxvalue") : "";
    this.yAxisMinValue = data.getAttribute("yaxisminvalue") ? data.getAttribute("yaxisminvalue") : 0;
    let defaultyaxisTitle = data.getAttribute("data-showyaxistitle") == "true" ? true : false;
    let defaultyaxisLine = data.getAttribute("data-showyaxisline") == "true" ? true : voLayout.showYAxisCustomLine == "true" ? true : false;
    let defaultyaxisGrid = data.getAttribute("data-showyaxisgrid") == "true" ? true : false;
    let defaultGrid = data.getAttribute("data-showdefaultgrid") == "true" ? true : false;
    if ((defaultGrid || voLayout.defaultGrid == "true") && voLayout.labelItemBased != "true") {
        defaultyaxisGrid = defaultGrid || voLayout.defaultGrid == "true" ? true : false;
    }
    if (hadAxisTitle) {
        if (yAxis == null) {
            //default
            yAxis = true;
            this.showYAxisTitle = data.getAttribute("showyaxistitle") ? (data.getAttribute("showyaxistitle") == "true" ? true : false) : defaultyaxisTitle;
            this.showYAxisLine = data.getAttribute("showyaxisline") ? (data.getAttribute("showyaxisline") == "true" ? true : false) : defaultyaxisLine;
            this.showYAxisGrid = data.getAttribute("showyaxisgrid") ? (data.getAttribute("showyaxisgrid") == "true" ? true : false) : defaultyaxisGrid;
            if (defaultyaxisGrid && !this.showYAxisGrid) {
                if (data.getAttribute("showcustomyaxisgrid") == "false") {
                } else {
                    this.showYAxisGrid = defaultyaxisGrid;
                    if (defaultyaxisGrid) {
                        data.setAttribute("data-showyaxisgrid", defaultyaxisGrid);
                    }
                }
            }
            this.showYAxisGridValue = this.showYAxisGrid; //data.getAttribute("showgridvalue") == "false" ? false : true;
            if (defaultyaxisLine && !this.showYAxisLine) {
                if (data.getAttribute("showcustomyaxisline") == "false") {
                } else {
                    this.showYAxisLine = defaultyaxisLine;
                }
            }
            this.stepType = data.getAttribute("yaxissteps") ? data.getAttribute("yaxissteps") : "auto";
            this.textsteps = data.getAttribute("textsteps") ? data.getAttribute("textsteps") : "";
            yAxisPrefixType = data.getAttribute("yaxisprefixtype") ? data.getAttribute("yaxisprefixtype") : "none";
            yAxisPrefixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisPrefixType);
            this.yAxisPrefix = data.getAttribute("yaxisprefix") ? data.getAttribute("yaxisprefix") : "";
            yAxisSuffixType = data.getAttribute("yaxissuffixtype") ? data.getAttribute("yaxissuffixtype") : "none";
            yAxisSuffixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisSuffixType);
            this.yAxisSuffix = data.getAttribute("yaxissuffix") ? data.getAttribute("yaxissuffix") : "";
        } else if (yAxis == "true") {
            yAxis = true;
            this.showYAxisTitle = data.getAttribute("showyaxistitle") == "true" ? true : false;
            this.showYAxisLine = data.getAttribute("showyaxisline") == "true" ? true : false;
            this.showYAxisGrid = data.getAttribute("showyaxisgrid") == "true" ? true : false;
            this.showYAxisGridValue = this.showYAxisGrid; //data.getAttribute("showgridvalue") == "true" ? true : false;
            this.stepType = data.getAttribute("yaxissteps");
            this.textsteps = data.getAttribute("textsteps");
            yAxisSuffixType = data.getAttribute("yaxissuffixtype");
            yAxisSuffixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisSuffixType);
            this.yAxisSuffix = data.getAttribute("yaxissuffix");
            yAxisPrefixType = data.getAttribute("yaxisprefixtype");
            yAxisPrefixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisPrefixType);
            this.yAxisPrefix = data.getAttribute("yaxisprefix");
        } else if (yAxis == "false") {
            yAxis = false;
            this.stepType = "auto";
            this.textsteps = "";
            this.yAxisSuffix = "";
            this.yAxisPrefix = "";
            this.showYAxisLine = false;
            this.showYAxisTitle = false;
            this.showYAxisGrid = false;
            this.showYAxisGridValue = this.showYAxisGrid;
            yAxisSuffixType = "none";
            yAxisSuffixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisSuffixType);
            yAxisPrefixType = "none";
            yAxisPrefixIndex = ChartUtils.getSelectedIndex(arrPrefix, yAxisPrefixType);
        }

        this.textsteps = data.getAttribute("textsteps") ? (Number(data.getAttribute("textsteps")) <= 20 ? Math.abs(data.getAttribute("textsteps")).toString() : "20") : "";
        this.yAxisPrefix = yAxisPrefixType == "none" || yAxisPrefixType == "custom" ? this.yAxisPrefix : yAxisPrefixType;
        this.yAxisSuffix = yAxisSuffixType == "none" || yAxisSuffixType == "custom" ? this.yAxisSuffix : yAxisSuffixType;
        this.yAxisSuffix = maxValue < 100000 ? this.yAxisSuffix : "";

        if (yAxis && this.grid) {
            data.setAttribute("showyaxistitle", this.showYAxisTitle);
            // data.setAttribute("showyaxisline", this.showYAxisLine);
            // data.setAttribute("showyaxisgrid", this.showYAxisGrid);
            data.setAttribute("yaxissteps", this.stepType);
            data.setAttribute("textsteps", this.textsteps);
            data.setAttribute("yaxisprefixtype", yAxisPrefixType);
            data.setAttribute("yaxissuffixtype", yAxisSuffixType);
            data.setAttribute("yaxisprefix", this.yAxisPrefix);
            data.setAttribute("yaxissuffix", this.yAxisSuffix);
        }
    } else {
        this.textsteps = false;
        this.showYAxisLine = false;
        this.showYAxisGrid = false;
        this.showYAxisTitle = false;
        this.showYAxisGridValue = false;
        this.yAxisMinValue = 0;
        this.yAxisMaxValue = 0;
        this.yAxisPrefix = "";
        this.yAxisSuffix = "";
    }
    if (layoutName == "sidelabel") {
        this.showYAxisLine = false;
        this.showYAxisGrid = false;
        this.showYAxisGridValue = this.showYAxisGrid;
    }

    this.boolGridmax = strChartName == "barStackedRectangle" ? true : false;
    this.showYAxisGrid = this.grid ? this.showYAxisGrid : false;
    let hadAxisSteps = this.grid && this.showYAxisGrid ? true : false;
    hadPrefixSuffix = this.grid && (this.showYAxisGrid || this.axisBaseLine) ? true : false;
    this.showYAxisGrid = this.grid;
    this.showGridLine = this.grid && data.getAttribute("showyaxisgridline") == "false" ? false : !data.hasAttribute("showyaxisgridline") && voLayout.showGridCustomLine == "false" ? false : true;
    this.showGridValueNode = this.grid && data.getAttribute("showyaxisgridvalue") == "false" ? false : true;
    let objYAxis = {
        value: yAxis,
        visible: hadAxisTitle,
        visibleYAxis: strChartName != "column3DRectangle" && yAxis && this.grid,
        visibleGrid: this.grid,
        visibleSteps: hadAxisSteps,
        visiblePrefix: hadPrefixSuffix,
        showname: this.showYAxisTitle,
        showline: this.showYAxisLine,
        showgrid: this.showGridLine,
        showgridvalue: this.showGridValueNode,
        showsteps: hadScatter || hadRank || hadSum || this.boolGridmax ? false : true,
        showmaxvalue: boolDisableMaxValue || !hadCustomMaxValue ? false : true,
        maxvalue: data.getAttribute("yaxissteps") == "true" ? true : false,
        textsteps: this.textsteps,
        selectedindexsteps: ChartUtils.getSelectedIndex(arrSteps, this.stepType),
        yaxisminvalue: this.yAxisMinValue,
        yaxismaxvalue: data.getAttribute("customdisplaymaxvalue") || this.yAxisMaxValue,
        prefix: this.yAxisPrefix,
        suffix: this.yAxisSuffix,
        selectedindexsuffix: yAxisSuffixIndex,
        selectedindexprefix: yAxisPrefixIndex,
        selectedindexgridline: 0,
        showbarspace: hadMergeItems,
        selectedindexbarspace: barSpaceIndex,
        datalabels: data.getAttribute("showgridvalue") == "true" ? true : false,
        dataname: data.getAttribute("showyaxistitle") == "true" ? true : false,
        dataline: data.getAttribute("showyaxisline") == "true" ? true : false,
        datagrid: data.getAttribute("showyaxisgrid") == "true" ? true : false,
        property: "yaxis",
        label: "floatersettingschartaxisline",
    };
    if (hadAxisTitle)
        objYAxis["secondaryProperty"] = [
            { property: "showyaxistitle", label: "floatersettingschartaxisname", value: objYAxis.dataname },
            { property: "showyaxisline", label: "floatersettingschartaxisline", value: objYAxis.dataline },
        ];

    // if (this.showXAxisGrid) this.showXAxisGrid = minValue > 0;
    // if (this.showYAxisLine) this.showYAxisLine = minValue > 0;

    //------------------------------------------  common placeholder  -----------------------------------------------------

    if (!hadCommonPlaceholder) {
        hadCommonPlaceholder = data.getAttribute("data-commonplaceholder");
    }
    let CommonPlaceholderSwitch = chartName.toLowerCase().includes("doughnut") ? true : data.getAttribute("innerradius") && data.getAttribute("innerradius") != 0 ? true : false;
    if (data.getAttribute("commonplaceholdertypeSWITCH")) {
        CommonPlaceholderSwitch = data.getAttribute("commonplaceholdertypeSWITCH");
    }
    let enableDoughnut = chartName.toLowerCase().includes("doughnut");
    this.commonPlaceholderType = hadCommonPlaceholder && data.getAttribute("commonplaceholdertype") ? data.getAttribute("commonplaceholdertype") : "none";
    let intcommonPlaceholderindex = ChartUtils.getSelectedIndex(arrCommonPlaceholder, this.commonPlaceholderType);
    this.commonPlaceholderElements = intcommonPlaceholderindex == 0 ? false : true;
    CommonPlaceholderSwitch = CommonPlaceholderSwitch == "false" ? false : CommonPlaceholderSwitch == "true" ? true : CommonPlaceholderSwitch;
    let objCommonPlaceHolder = {
        visible: hadCommonPlaceholder,
        dpSource: arrCommonPlaceholder,
        value: CommonPlaceholderSwitch,
        selectedindex: intcommonPlaceholderindex,
        dountelement: enableDoughnut,
    };

    //------------------------------------------  secondary  -----------------------------------------------------

    this.secondaryType = hadAxisTitle && data.getAttribute("secondaryplaceholder") ? data.getAttribute("secondaryplaceholder") : "none";
    let intSecondaryindex = ChartUtils.getSelectedIndex(arrSecondaryList, this.secondaryType);
    this.secondaryElements = intSecondaryindex == 0 ? false : true;
    voLayout.showSecondaryPlaceholder = this.secondaryElements && hasSecondary;
    let objSecondaryplaceholder = {
        visible: hasSecondary,
        dpSource: arrSecondaryList,
        value: this.secondaryElements,
        selectedindex: intSecondaryindex,
    };
    //------------------------------------------  sequence number  -----------------------------------------------------

    this.valueSequenceNumber = hadSequeceNumber && data.getAttribute("sequencenumber") == "true" ? true : false;
    let objSequenceNumber = {
        visible: hadSequeceNumber,
        value: this.valueSequenceNumber,
    };
    //------------------------------------------  highvaluebreak number  -----------------------------------------------------
    hadhighvaluebreak = chartName == "columnSimpleRectangle" && (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true") ? false : hadhighvaluebreak;
    this.valueHighvalueBreak = hadhighvaluebreak && (data.getAttribute("highvaluebreak") == "true" || data.getAttribute("userhighvaluebreak") == "true") ? true : false;
    if (data.getAttribute("yaxissteps") == "true") {
        this.valueHighvalueBreak = false;
        hadhighvaluebreak = false;
    }
    let objHighValueBreak = {
        visible: hadhighvaluebreak,
        value: this.valueHighvalueBreak,
    };
    if (this.valueHighvalueBreak) objYAxis.showmaxvalue = false;
    //------------------------------------------   chart flip  -----------------------------------------------------
    hadChartFlip = chartName == "columnSimpleRectangle" && (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true") ? false : hadChartFlip;
    this.chartFlip = hadChartFlip && data.getAttribute("chartflip") == "true" ? true : false;
    let objChartFlip = {
        visible: hadChartFlip,
        value: this.chartFlip,
        property: "chartflip",
        label: "flip",
    };
    //------------------------------------------ trendline  -----------------------------------------------------
    this.enableTrendline = hadTrendline && data.getAttribute("trendline") == "true" ? true : false;
    let objTrendline = {
        visible: hadTrendline,
        value: this.enableTrendline,
    };
    //------------------------------------------ group label  -----------------------------------------------------
    this.enableGroupLabel = data.getAttribute("chartgrouplabel") == "false" ? false : hadGroupLabel ? true : false;
    let objGroupLabel = {
        visible: hadGroupLabel && this.hasChartGroup,
        value: this.enableGroupLabel,
        property: "chartgrouplabel",
        label: "chartgrouplabel",
    };
    //------------------------------------------ statistical label  -----------------------------------------------------
    this.enableStatisticalLabel = data.getAttribute("chartstatisticallabel") == "true" && hadStatisticalLabel ? true : false;
    let objStatisticalLabel = {
        visible: hadStatisticalLabel && seriesItemLength < 3,
        value: this.enableStatisticalLabel,
        property: "chartgrouplabel",
        label: "chartgrouplabel",
    };
    //------------------------------------------  BaseLine  -----------------------------------------------------
    this.enableBaseLine = hadBaseLine || data.getAttribute("data-baseline") ? true : false;
    this.enableBaseLine = data.getAttribute("data-highlightdifference") == "true" || data.getAttribute("multislide") == "true" ? false : this.enableBaseLine;
    this.enableBaseLine = chartName == "columnStackedRectangle" && (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true") ? false : this.enableBaseLine;
    this.valueBaseLine = data.getAttribute("data-baseline") || data.getAttribute("axisbaseline") == "true" ? true : false;
    if (this.valueBaseLine && data.getAttribute("data-baseline") == "false") {
        this.valueBaseLine = false;
    }
    if (voLayout.disablebaseline) {
        this.enableBaseLine = false;
    }
    this.enableBaseLine = data.getAttribute("isTakeaway") == "true" ? false : this.enableBaseLine;
    // if (seriesItemLength > 1) {
    //     if (seriesItemLength == 2 && hadSecondaryLineChart) {
    //     } else if (seriesItemLength > 1) {
    //         this.enableBaseLine = false;
    //     }
    // }
    let objBaseLine = {
        visible: this.enableBaseLine,
        value: this.valueBaseLine,
        property: "data-baseline",
        label: "chartbaseline",
    };
    if (this.valueBaseLine) {
        enablegrid = false;
    }
    //------------------------------------------  Series Item Connector  -----------------------------------------------------
    this.enableSeriesItemConnector = hadSeriesItemConnector ? true : false;
    this.valueSeriesItemConnector = data.getAttribute("seriesItemConnector") ? ChartUtils.parseBoolen(data.getAttribute("seriesItemConnector")) : false;
    let objSeriesItemConnector = {
        visible: this.enableSeriesItemConnector,
        value: this.valueSeriesItemConnector,
    };

    let minimumThickness = 1;
    let maximumThickness = 16;
    let thickness = data.getAttribute("seriesitemconnectorthickness") ? data.getAttribute("seriesitemconnectorthickness") : 1.5;
    let objSeriesItemConnectorThickness = {
        minimum: minimumThickness,
        maximum: maximumThickness,
        visible: hadSeriesItemConnector && this.valueSeriesItemConnector,
        value: thickness,
        property: "seriesitemconnectorthickness",
    };
    let strokeStyle = data.getAttribute("seriesitemconnectortype") ? data.getAttribute("seriesitemconnectortype") : "dashed";
    let seriesitemconnectortype = {
        visible: hadSeriesItemConnector && this.valueSeriesItemConnector,
        value: strokeStyle,
        dpSource: arrSeriesItemConnectorType,
        selectedindex: ChartUtils.getSelectedIndex(arrSeriesItemConnectorType, strokeStyle),
        property: "seriesitemconnectortype",
        label: "seriesitemconnectortype",
    };
    let color = data.getAttribute("seriesitemconnectorcolor") ? data.getAttribute("seriesitemconnectorcolor") : "#000";
    let objSeriesItemConnectorColor = {
        visible: hadSeriesItemConnector && this.valueSeriesItemConnector,
        value: color,
        property: "seriesitemconnectorcolor",
    };
    //------------------------------------------  Show Total Value  -----------------------------------------------------
    this.enableShowTotalValue = hadShowTotalValue && seriesItemLength > 1 ? true : false;
    this.valueShowTotalValue = data.getAttribute("showtotalvalue") ? ChartUtils.parseBoolen(data.getAttribute("showtotalvalue")) : false;
    let objShowTotalValue = {
        visible: this.enableShowTotalValue,
        value: this.valueShowTotalValue,
    };
    //------------------------------------------  Spline  -----------------------------------------------------
    this.enableSpline = hadSpline ? true : false;
    this.valueSpline = data.getAttribute("data-spline") ? ChartUtils.parseBoolen(data.getAttribute("data-spline")) : voLayout.linechartType == "spline" ? true : false;
    let objSpline = {
        visible: this.enableSpline,
        value: this.valueSpline,
    };
    //------------------------------------------  LINE HEAD  -----------------------------------------------------
    this.enableLineHead = hadLineHead && data.getAttribute("data-bgFill") != "true" ? true : false;
    this.valueLineHead = data.getAttribute("data-linehead") ? ChartUtils.parseBoolen(data.getAttribute("data-linehead")) : voLayout.lineHead ? true : false;
    let objLineHead = {
        visible: this.enableLineHead,
        value: this.valueLineHead,
    };
    //------------------------------------------  multiSlide  -----------------------------------------------------
    this.enableMultiSlide = hadMultislide && seriesLength > multislideCount ? true : false;
    this.enableMultiSlide = this.valueBaseLine || this.showComparisonHighlight ? false : this.enableMultiSlide;
    this.valueMultiSlide = data.getAttribute("multislide") == "true" ? true : false;
    let objMultiSlide = {
        visible: false, //this.enableMultiSlide,
        value: this.valueMultiSlide,
    };
    // //------------------------------------------  CompareLabel  -----------------------------------------------------

    // this.enableCompareTitle = voLayout.compareLabel;
    // this.valueCompareTitle = data.getAttribute("enablecomparetitle") == "true" ? true : false;
    // let objCompareTitle = {
    //     visible: this.enableCompareTitle,
    //     value: this.valueCompareTitle,
    // };

    //------------------------------------------  highlight value  -----------------------------------------------------

    this.enableHighlightValue = hadhighlightvalue && data.getAttribute("highlightvalue") ? true : false;
    this.valueHighlightValue = data.getAttribute("highlightvalue") == "true" ? true : false;
    let objHighlightValue = {
        visible: this.enableHighlightValue,
        value: this.valueHighlightValue,
    };
    //------------------------------------------  labelHeader  -----------------------------------------------------
    let hasHeader = voLayout.haslabelHeaderTitle || voLayout.hasvalueHeaderTitle || voLayout.hasitemHeaderTitle || voLayout.hasPlaceholderHeaderTitle;
    this.enableLabelHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    this.valueLabelHeader = data.getAttribute("boollabelheader") == "true" ? true : false;
    let objLabelHeader = {
        visible: this.enableLabelHeader,
        value: this.valueLabelHeader,
    };
    //------------------------------------------  valueHeader  -----------------------------------------------------
    this.enableValueHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    let valueNode = data.getAttribute("overlapgrid") == "true";
    if (valueNode) {
        this.enableValueHeader = false;
    }
    this.valueValueHeader = data.getAttribute("boolvalueheader") == "true" ? true : false;
    let selectedValueFormat = data.getAttribute("valueheaderformat") ? data.getAttribute("valueheaderformat") : "";
    let selectedindex = ChartUtils.getSelectedIndex(dpValueHeaderFormat, selectedValueFormat);
    let objValueHeader = {
        visible: this.enableValueHeader,
        value: this.valueValueHeader,
        formatIndex: selectedindex,
    };
    //------------------------------------------  itemHeader  -----------------------------------------------------

    this.enableItemHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    this.valueItemHeader = data.getAttribute("boolitemheader") == "true" ? true : false;
    let objItemHeader = {
        visible: this.enableItemHeader,
        value: this.valueItemHeader,
    };
    //------------------------------------------  placeholderHeader  -----------------------------------------------------

    this.enablePlaceholderHeader = hasHeader; //data.getAttribute("data-baseline") ? true : false;
    this.valuePlaceholderHeader = data.getAttribute("boolplaceholderheader") == "true" ? true : false;
    let objPlaceholderHeader = {
        visible: this.enablePlaceholderHeader,
        value: this.valuePlaceholderHeader,
    };
    //------------------------------------------  Highlight Differnce  -----------------------------------------------------

    this.enableindulaHd = hadIndualHd || data.getAttribute("data-indualhighlight") == "true" ? true : false;
    this.valueIndualHd = data.getAttribute("data-indualhighlight") == "true" || data.getAttribute("indualhd") == "true" ? true : false;
    let objIndualHd = {
        visible: this.enableindulaHd,
        value: this.valueIndualHd,
    };

    //------------------------------------------  prompttext  -----------------------------------------------------

    this.enablePrompttext = hadPromptText;
    this.valuePrompttext = data.getAttribute("prompttext") == "true" ? true : false;
    let objPromptText = {
