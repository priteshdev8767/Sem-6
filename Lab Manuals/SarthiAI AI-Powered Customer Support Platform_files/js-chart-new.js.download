ChartBuilder.prototype.changeMenuMoodsData = function (objDetails, xmldata) {
    let xmlData = objDetails.slideContent && objDetails.slideContent.querySelector(".chartbase") ? objDetails.slideContent.querySelector(".chartbase") : "";
    let graphicName = objDetails.slideContent && objDetails.slideContent.querySelector(".chartbase") ? objDetails.slideContent.querySelector(".chartbase").getAttribute("graphicname") : "";
    let menuData = MenuParser.getInstance().getMenuDetail(graphicName);
    if (menuData) {
        objDetails.menu = menuData;
        objDetails.moodchange = false;
        xmlData.removeAttribute("uniqueLayoutName");
        xmlData.removeAttribute("uniqueLayout");
        this.ChartUtils.updateChartProperties(this.slideID, objDetails);
        return;
    }
};

ChartBuilder.prototype.getGraphicDiv = function (slideId, tempSlideObj) {
    let slideObj = tempSlideObj ? tempSlideObj : DocumentStore.getInstance().getSlideDetails(slideId);
    let graphic = slideObj ? slideObj.content.querySelector("[id='graphic']") : "";
    return graphic;
};
ChartBuilder.prototype.chartRedrawOperation = function (menuData = menuDetails, argParent = null, object = null, instanceDetails = null) {
    let slide = object ? object.slide : null;
    menuData = menuData ? menuData : menuDetails;
    let parentNode = object ? object.slide : argParent;

    // Try to get graphic index from parentNode if available
    let graphicIndex = null;
    if (parentNode) {
        let graphicDiv = parentNode.querySelector("[data-graphic-index]") || parentNode.querySelector("[data-chart-id]");
        if (graphicDiv) {
            let chartId = graphicDiv.getAttribute("data-chart-id");
            graphicIndex = chartId || graphicDiv.getAttribute("data-graphic-index");
        }
    }
    let divParent = this.buildAsset(menuData, parentNode, instanceDetails);
    let xmlData = divParent.querySelector("desc") && divParent.querySelector("desc").children.length > 0 ? divParent.querySelector("desc").children[0] : null;
    if (xmlData) {
        let conflicData = xmlData.getAttribute("conflictlayout") == "true" ? true : false;
        let legendArea = divParent.querySelector(".legendbase");
        if (conflicData && !legendArea) {
            divParent = "";
            divParent = null;
        }
    }
    return divParent;
};
ChartBuilder.prototype.addNode = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let childLength = this.xmlData.children.length;
    let object = { property: "dropdowncount", value: childLength + 1 };
    let objectValue = { slide: slide };
    this.addoperation = true;
    this.chartRedrawOperation(menuDetails, "", objectValue, "");
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.deleteNode = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let childLength = this.xmlData.children.length;
    let object = { property: "dropdowncount", value: childLength - 1 };
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue, "", true);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.showEmpahsis = function () {
    let hasEmphasis = menuDetails.menu.hasOwnProperty("variationproperties") && menuDetails.menu.variationproperties.hasOwnProperty("emphasize");
    let strvalue = hasEmphasis ? menuDetails.menu.variationproperties.emphasize.value[0] : "middle";
    let index = 1;
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    switch (strvalue) {
        case "first":
            index = 1;
            break;
        case "last":
            index = this.xmlData.children.length - 1;
            break;
        case "middle":
            index = parseInt(this.xmlData.children.length / 2);
            break;
        default:
            index = parseInt(strvalue) - 1;
            break;
    }
    this.xmlData.setAttribute("emphasis", true);
    this.xmlData.children[index].setAttribute("emphasis", true);
    let objectValue = { slide: slide };

    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.hideEmpahsis = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    for (let i2 = 0; i2 < this.xmlData.children.length; i2++) {
        this.xmlData.removeAttribute("emphasis");
        this.xmlData.children[i2].removeAttribute("emphasis");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
