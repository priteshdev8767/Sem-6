BaseChart.prototype.doAddLegendDesk = function (argProps) {
    return null;
};

BaseChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    return null;
};

BaseChart.prototype.doAddGridDesk = function (argProps) {
    return null;
};

BaseChart.prototype.addGridDeskElement = function (argParent, argProps) {
    return null;
};
BaseChart.prototype.getBgFillDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            if (fillProperty && fillProperty == "color") {
                PropertyIndex = 0;
            } else {
                PropertyIndex = groupindex;
            }
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "bgcolor":
            if (fillProperty == "stroke") {
                return "bgstroke";
            } else {
                return "fillbgColor";
            }
            break;
        case "alternateprimary":
            if (fillProperty == "stroke") {
                return "ci-alternate-primary-stroke";
            } else {
                return "ci-alternate-primary-fill";
            }
            break;
        case "alternatebg":
            if (fillProperty == "stroke") {
                return "ci-alternatebg-primary-stroke";
            } else {
                return "ci-alternatebg-primary-fill";
            }
            break;
        case "secondary":
            if (fillProperty == "stroke") {
                return "clsSecondaryStroke";
            } else {
                return "clsSecondaryFill";
            }
            break;
        case "contrast":
            if (fillProperty == "stroke") {
                return "contrast-stroke";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-fill";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = PropertyIndex != 0 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        // return "accent" + (colorValue + 1) + "-fill";
                        return "cf-fill-section-primary";
                    }
                    // return "accent" + (groupindex + 1) + "-fill";
                    if (this.data.multicolor) {
                        return "cf-fill-section-primary";
                    } else {
                        return "cf-fill-section-primary";
                        // return "accent1-fill";
                    }
                    break;
                case "stroke":
                    return this.data.ChartFonts.appendgraphicStrokeColor(groupindex);
                    break;
            }
        }
    }
};
BaseChart.prototype.getChartHighLightValue = function (parentNode, highlightindex, targetNode, classValue = "graphic", targetOnly = false) {
    let elementDiv = parentNode;
    let XmlData = this.data.data;
    let valueLength = XmlData.children[0].getAttribute("value").split(",");
    highlightindex = highlightindex < 0 || isNaN(highlightindex) ? 0 : highlightindex;
    let eSeries = elementDiv.getElementsByClassName("baseseries");
    let highlightSeriesElemnt = elementDiv.getElementsByClassName("highlightSeriesItem");
    let eGraphic = [];
    if (valueLength.length > 1) {
        eGraphic = elementDiv.getElementsByClassName("chartgraphic");
        eGraphic = eGraphic && eGraphic.length != 0 ? eGraphic : elementDiv.getElementsByClassName("graphicconatiner");
    } else {
        eGraphic = elementDiv.getElementsByClassName("graphicconatiner");
        eGraphic = eGraphic && eGraphic.length != 0 ? eGraphic : elementDiv.getElementsByClassName("chartgraphic");
    }
    let target = targetNode ? targetNode : eGraphic[highlightindex];
    let secGraphic = elementDiv.getElementsByClassName("secondarychartgraphic");
    let viewPortBounds = eSeries[0].getBoundingClientRect();
    let targetBounds = target.getBoundingClientRect();
    let itemParent = target;
    let item = target;
    viewPortBounds.x = parseFloat(window.getComputedStyle(eSeries[0])["x"].split("px")[0]);
    viewPortBounds.y = parseFloat(window.getComputedStyle(eSeries[0])["y"].split("px")[0]);
    viewPortBounds.width = parseFloat(window.getComputedStyle(eSeries[0])["width"].split("px")[0]);
    viewPortBounds.height = parseFloat(window.getComputedStyle(eSeries[0])["height"].split("px")[0]);
    targetBounds.width = parseFloat(window.getComputedStyle(target)["width"].split("px")[0]);
    targetBounds.height = parseFloat(window.getComputedStyle(target)["height"].split("px")[0]);
    if (item.tagName == "svg" || item.tagName == "rect" || item.tagName == "circle" || item.tagName == "path") {
        let bound;
        if (item.tagName != "svg" && item.tagName != "path" && item.tagName != "rect") {
            bound = this.globalCoordination(itemParent.parentNode, itemParent);
            bound.x = eSeries[0].offsetLeft + bound.x;
            bound.y = eSeries[0].offsetTop + bound.y;
            bound.width = eSeries[0].clientWidth + bound.width;
        } else {
            bound = item.getBBox();
            if (highlightSeriesElemnt.length > 0) {
                let SecondaryBoundsX = parseFloat(highlightSeriesElemnt[0].getAttribute("data-highlightX"));
                let secondaryBoundsY = parseFloat(highlightSeriesElemnt[0].getAttribute("data-highlightY"));
                bound.x = SecondaryBoundsX ? SecondaryBoundsX + eSeries[0].offsetLeft + bound.x : eSeries[0].offsetLeft + bound.x;
                bound.y = secondaryBoundsY ? secondaryBoundsY + eSeries[0].offsetTop + bound.y : eSeries[0].offsetTop + bound.y;
            } else {
                bound.x = eSeries[0].offsetLeft + bound.x;
                bound.y = eSeries[0].offsetTop + bound.y;
            }
            if (secGraphic.length > highlightindex && secGraphic[highlightindex]) {
                let secBounds = secGraphic[highlightindex].getBBox();
                bound.x = eSeries[0].offsetLeft + bound.x + secBounds.x;
                bound.y = eSeries[0].offsetTop + bound.y + secBounds.y;
            }
            if (item.tagName == "path" && item.getAttribute("data-highlightPontX") && item.getAttribute("data-highlightPontY")) {
                bound.y = eSeries[0].offsetTop + parseFloat(item.getAttribute("data-highlightPontY"));
            }
        }
        targetBounds.x = bound.x;
        targetBounds.y = bound.y;
        targetBounds.width = bound.width;
        targetBounds.height = bound.height;
    } else {
        item.x = 0;
        item.y = 0;
        while (itemParent && !itemParent.className.includes(classValue)) {
            item.x = itemParent.offsetLeft + item.x;
            item.y = itemParent.offsetTop + item.y;
            itemParent = itemParent.offsetParent;
        }
        targetBounds.x = item.x;
        targetBounds.y = item.y;
    }
    if (targetBounds.y > parentNode.clientHeight) {
        targetBounds.y = targetBounds.y - parentNode.clientHeight;
    }
    if (targetOnly) {
        return targetBounds;
    }
    ////
    let xmlData = XmlData;
    let highlightText = xmlData.children[highlightindex].getAttribute("caption");
    let alignment = xmlData.children[highlightindex].getAttribute("calloutType");
    let highlightStyle = xmlData.children[highlightindex].getAttribute("highlightstyle");
    let highlighIconPath = xmlData.children[highlightindex].getAttribute("highlighticonpath");
    if ((highlightStyle == "texticon" || highlightStyle == "textimage" || highlighIconPath) && highlighIconPath != "null") {
        let highlightIcon = "";
        if (highlightStyle == "texticon") {
            highlightIcon = highlighIconPath.split("/");
            highlightIcon = highlightIcon[highlightIcon.length - 1].split(".")[0];
        }
        return {
            viewPortBounds: viewPortBounds,
            targetBounds: targetBounds,
            highlightText: highlightText,
            alignment: alignment,
            objGraphic: {
                value: highlighIconPath,
                id: highlightIcon,
                contenttype: highlightStyle == "texticon" ? "icon" : "image",
            },
        };
    }
    return {
        viewPortBounds: viewPortBounds,
        targetBounds: targetBounds,
        highlightText: highlightText,
        alignment: alignment,
    };
};

BaseChart.prototype.ParentElementPosition = function (element, alignment) {
    switch (alignment) {
        case "right":
            element.style.justifyContent = "flex-end";
            break;
        case "left":
            element.style.justifyContent = "flex-start";
            if (this.data.layout.legendPosition == "left") {
                element.style.justifyContent = "flex-end";
            }
            element.style.alignItems = "flex-start";
            break;
        case "center":
            element.style.justifyContent = "center";
            break;
        case "top":
            element.style.alignItems = "flex-start";
            break;
        case "bottom":
            element.style.alignItems = "flex-end";
            break;
        case "middle":
            element.style.alignItems = "center";
            break;
    }
};

BaseChart.prototype.createHeader = function (parentNode, measurment = false, labelWidth = 0, baseValueWidth = 0, baseItemWidth = 0, column = false, boolLabelItemBased = false) {
    let element = document.createElement("div");
    element.id = "header-" + 0;
    element.className = "header overflow accent1 clsMultiColorParent";
    parentNode.appendChild(element);
    if (this.data.layout.labelHeaderPosition) {
        element.className = "header overflow accent1 clsMultiColorParent headerpos" + this.data.layout.labelHeaderPosition;
    } else {
        if (this.data.layout.valueHeaderPosition) {
            element.className = "header overflow accent1 clsMultiColorParent headerpos" + this.data.layout.valueHeaderPosition;
        } else {
            element.className = "header overflow accent1 clsMultiColorParent headerpos" + this.data.layout.itemHeaderPosition;
        }
    }
    // element.style.height = this.data._headerHeight + "px";
    let lableTextAlign = "left";
    let itemTextAlign = "center";
    let valueTextAlign = "right";
    if (column) {
        element.style.maxWidth = measurment ? "230px" : this.data._headerHeight + "px";
        // element.dataset.animation = "nodeitem";
        element.style.maxHeight = "100%";
        if (this.data.layout.labelHeaderPosition == "left") {
            element.style.paddingRight = "16px";
        } else {
            element.style.paddingLeft = "16px";
        }
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
    } else {
        element.style.maxWidth = "100%";
        // element.dataset.animation = "nodeitem";`
        element.style.maxHeight = measurment ? "60px" : this.data._headerHeight + "px";
        if (this.data.layout.labelHeaderPosition == "top" || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top") {
            element.style.paddingBottom = "16px";
        } else {
            element.style.paddingTop = "16px";
        }
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
    }

    if (this.voData.arrHyperlinkUrl[0]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[0]);
    }

    element.classList.add("th-section" + 1);

    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    let labelClientWidth = labelWidth;
    let secondaryElementWidth = 220;
    let itemWidth = baseItemWidth;
    let valueWidth = baseValueWidth;
    let labelFontsize = 0;
    let headerWidth = 0;
    let hasValue = true;
    if (!measurment) {
        headerWidth = boolLabelItemBased && !column ? parentNode.querySelector(".seriesitemcond").clientWidth : "";
        if (headerWidth) element.style.width = headerWidth + "px";
        let seiesElement = parentNode.querySelector(".series");
        let baseGraphicElement = parentNode.querySelector(".baserightgraphic");
        let serieslabel = seiesElement.querySelector(".label");
        let seriesValue = seiesElement.querySelector(".value");
        hasValue = seriesValue && seriesValue.style.display == "none" ? false : true;
        labelFontsize = serieslabel && serieslabel.children[0] && serieslabel.children[0].style.fontSize ? parseFloat(serieslabel.children[0].style.fontSize) : "";
        lableTextAlign = serieslabel && serieslabel.children[0] && serieslabel.children[0].style.textAlign ? serieslabel.children[0].style.textAlign : "";
        let secondarylabelElement = seiesElement.querySelector(".secondaryElement");
        let Item = seiesElement.querySelector(".seriesitemcond");
        labelClientWidth = serieslabel ? (column ? serieslabel.clientHeight - parseFloat(this.data.layout.labelPaddingtop) : serieslabel.clientWidth) : 0;
        valueWidth = seriesValue ? (column ? seriesValue.clientHeight : seriesValue.clientWidth) : 0;
        secondaryElementWidth = secondarylabelElement ? (column ? secondarylabelElement.clientHeight : secondarylabelElement.clientWidth) : 0;
        itemWidth = Item ? (column ? Item.clientHeight - valueWidth : Item.clientWidth - valueWidth) : 0;
        if (boolLabelItemBased && !column && Item) {
            valueWidth = this.data.enableValueHeader ? valueWidth : 0;
            parentNode.style.alignItems = "flex-end";
            itemWidth = Item.clientWidth - valueWidth - labelClientWidth;
        } else {
            itemWidth += valueWidth;
            valueWidth = this.data.enableValueHeader ? valueWidth : 0;
        }
        if (this.data.layout.labelInset == "inside") {
            labelClientWidth = baseGraphicElement.clientWidth;
            if (this.data._headerValueDisplayFormat != "calvalueheader") {
                let valueRemainingWidth = 0;
                if (this.data.enableValueHeader) {
                    valueRemainingWidth = 191;
                }
                labelClientWidth = baseGraphicElement.clientWidth - valueRemainingWidth;
            }
            if (this.data.enableItemHeader) {
                itemWidth = baseGraphicElement.clientWidth * 0.5;
                labelClientWidth -= itemWidth;
            }
        }
        element.style.maxHeight = "100%";
        if (column) {
            element.style.height = parentNode.clientHeight + "PX";
        }
    }

    //***label width**//
    let labelHeader = document.createElement("div");
    let labelColor = this.getColorDetails(0, "", this.data.layout.labelHeaderColor, "color");
    labelHeader.className = "labelheader moodanimation clslabelheadercolor" + this.ChartFonts.headingClassName + " clslabel" + this.data.labelheaderalign + " " + labelColor;
    if (this.data.enableLabelHeader) {
        labelHeader.innerText = this.data.labelHeader;
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-prompt-text", "Enter Title");
        // if(labelFontsize)labelHeader.style.fontSize = labelFontsize+"px";
        if (column) labelHeader.style.alignItems = "flex-start";
        if (this.data.layout.labelHeaderPaddingClass) labelHeader.classList.add(this.data.layout.labelHeaderPaddingClass);
    } else {
        labelHeader.style.visibility = "hidden";
    }

    column ? (labelHeader.style.height = labelClientWidth + "px") : (labelHeader.style.minWidth = labelClientWidth + "px");
    if (!column) {
        // labelHeader.style.textAlign = lableTextAlign;
        labelHeader.style.maxWidth = labelClientWidth + "px";
        if (!measurment) labelHeader.style.maxHeight = this.data._headerHeight + "px";
    }
    column ? (labelHeader.style.width = "100%") : (labelHeader.style.height = "100%");
    labelHeader.setAttribute("maxFontSize", 30);
    if (this.data.layout.labelHeaderIndex) labelHeader.style.setProperty("order", this.data.layout.labelHeaderIndex);
    labelHeader.setAttribute("data-id", "label-header");
    labelHeader.setAttribute("data-animation", "labeltitle");
    labelHeader.setAttribute("id", "label-header");
    labelHeader.setAttribute("data-slideid", this.data.slideID);
    labelHeader.setAttribute("contenteditable", "true");
    labelHeader.setAttribute("data-type", "labelheader");
    if (this.data._labelHeaderColor) {
        labelHeader.style.setProperty("color", this.data._labelHeaderColor, "important");
    }
    if (this.data.layout.labelHeaderHPosition) labelHeader.classList.add("header" + this.data.layout.labelHeaderHPosition);
    this.ChartHelper.setTextChangeListner(labelHeader);
    if (this.data.chartFlip) {
        labelHeader.style.paddingRight = this.data.layout.labelPaddingleft + "px";
        labelHeader.style.paddingLeft = this.data.layout.labelPaddingright + "px";
        // if(this.data.layout.labelAlterPaddingClass)
        // {
        //     labelHeader.classList.add(this.data.layout.labelAlterPaddingClass)
        // }
    } else {
        // if(this.data.layout.labelPaddingClass)
        // {
        //     labelHeader.classList.add(this.data.layout.labelPaddingClass)
        // }
    }
    element.appendChild(labelHeader);
    if (!column) {
        labelHeader.classList.add("removemaxwidth");
        this.data.labelHeaderWidth = labelHeader.clientWidth;
    }
    if (this.data.layout.bgTabel) {
        labelHeader.classList.add("enabletable");
    }
    this.checkMaxLineCount(labelHeader, "bar");

    //placeholder Titlte///
    let secondaryHeader = document.createElement("div");
    secondaryHeader.className = "secondaryheader clssecondaryheadercolor " + this.ChartFonts.headingClassName + " clsplaceholder" + this.data.secondaryheaderalign;
    if (this.data.enablePlaceholderHeader) {
        secondaryHeader.innerText = this.data.secondaryHeader;
        secondaryHeader.setAttribute("contenteditable", "true");
        secondaryHeader.setAttribute("data-prompt-text", "Enter Title");
        // if(labelFontsize)secondaryHeader.style.fontSize = labelFontsize+"px";
    } else {
        secondaryHeader.style.visibility = "hidden";
    }
    secondaryHeader.setAttribute("maxFontSize", 30);
    secondaryHeader.style.height = "100%";
    secondaryHeader.setAttribute("id", "secondary-Header");
    secondaryHeader.setAttribute("data-id", "secondary-Header");
    if (this.data.layout.placeholderHeaderIndex) secondaryHeader.style.setProperty("order", this.data.layout.placeholderHeaderIndex);
    secondaryHeader.setAttribute("data-slideid", this.data.slideID);
    secondaryHeader.setAttribute("data-type", "secondaryheader");
    this.ChartHelper.setTextChangeListner(secondaryHeader);
    if (this.data._secondaryHeaderColor) {
        secondaryHeader.style.setProperty("color", this.data._secondaryHeaderColor, "important");
    }
    if (this.data.layout.placeholderHeaderHPosition) secondaryHeader.classList.add("header" + this.data.layout.placeholderHeaderHPosition);
    if (this.data.layout.bgTabel) {
        secondaryHeader.classList.add("enabletable");
    }
    column ? (secondaryHeader.style.height = secondaryElementWidth + "px") : (secondaryHeader.style.width = secondaryElementWidth + "px");
    element.appendChild(secondaryHeader);

    //value Titlte///
    let valueHeader = document.createElement("div");
    let valueColor = this.getColorDetails(0, "", this.data.layout.valueHeaderColor, "color");
    valueHeader.className = "secondaryheader valueheader moodanimation clsvalueheadercolor " + this.ChartFonts.headingClassName + " clsvalue" + this.data.valueheaderalign + " " + valueColor;
    if (this.data.enableValueHeader) {
        valueHeader.innerText = this.data.valueHeaderTitle;
        if (this.data._headerValueDisplayFormat == "calvalueheader") {
            valueHeader.innerText = this.data.prefix[0][0] + this.data.valueHeaderTitle + this.data.suffix[0][0];
        }
        if (this.data._headerValueDisplayFormat != "calvalueheader") valueHeader.setAttribute("contenteditable", "true");
        valueHeader.setAttribute("data-prompt-text", "Enter Title");
        // if(labelFontsize)valueHeader.style.fontSize = labelFontsize+"px";
        valueHeader.style.width = valueWidth + "px";
        this.data._headerValueDisplayFormat != "calvalueheader" ? (valueHeader.style.minWidth = "191px") : (valueHeader.style.minWidth = valueWidth + "px");
        if (this.data.layout.valueHeaderPaddingClass) valueHeader.classList.add(this.data.layout.valueHeaderPaddingClass);
    } else {
        valueHeader.style.visibility = "hidden";
        valueHeader.style.width = "0px";
    }
    valueHeader.setAttribute("maxFontSize", 30);
    valueHeader.setAttribute("data-animation", "valuetitle");
    valueHeader.style.height = "100%";
    if (this.data.layout.valueHeaderIndex) {
        if (this.data.layout.valueHeaderIndex == "2") {
            valueHeader.style.setProperty("text-align", "right");
        }
        valueHeader.style.setProperty("order", this.data.layout.valueHeaderIndex);
    }
    valueHeader.setAttribute("id", "value-Header");
    valueHeader.setAttribute("data-id", "value-Header");
    valueHeader.setAttribute("data-slideid", this.data.slideID);
    valueHeader.setAttribute("data-type", "valueheader");
    if (this.data._valueHeaderColor) {
        valueHeader.style.setProperty("color", this.data._valueHeaderColor, "important");
    }
    if (this.data.layout.valueHeaderHPosition) valueHeader.classList.add("header" + this.data.layout.valueHeaderHPosition);
    this.ChartHelper.setTextChangeListner(valueHeader);
    if (this.data.layout.bgTabel) {
        valueHeader.classList.add("enabletable");
    }
    column ? (valueHeader.style.height = valueWidth + "px") : (valueHeader.style.width = valueWidth + "px");
    if (!column) {
        // valueHeader.style.textAlign = valueTextAlign;
        valueHeader.style.maxWidth = valueWidth + "px";
        if (!measurment) valueHeader.style.maxHeight = this.data._headerHeight + "px";
    }
    if (hasValue) element.appendChild(valueHeader);
    if (this.data._headerValueDisplayFormat == "calvalueheader") this.ChartUtils.createSpanFormat(valueHeader, this.data);
    //item Titlte///
    let seriesItemHeader = document.createElement("div");
    let itemHeaderColor = this.getColorDetails(0, "", this.data.layout.itemHeaderColor, "color");
    seriesItemHeader.className = "secondaryitemheader moodanimation clsitemheadercolor " + this.ChartFonts.headingClassName + " clsitem" + this.data.itemheaderalign + " " + itemHeaderColor;
    if (this.data.enableItemHeader) {
        seriesItemHeader.innerText = this.data.itemHeader;
        seriesItemHeader.setAttribute("data-prompt-text", "Enter Title");
        seriesItemHeader.setAttribute("contenteditable", "true");
        // if(labelFontsize)seriesItemHeader.style.fontSize = labelFontsize+"px";
        if (this.data.layout.itemHeaderPaddingClass) seriesItemHeader.classList.add(this.data.layout.itemHeaderPaddingClass);
    } else {
        seriesItemHeader.style.width = "0px";
        seriesItemHeader.style.visibility = "hidden";
    }
    column ? (seriesItemHeader.style.height = itemWidth + "px") : (seriesItemHeader.style.width = itemWidth + "px");
    seriesItemHeader.setAttribute("maxFontSize", 30);
    if (this.data.layout.itemHeaderIndex) seriesItemHeader.style.setProperty("order", this.data.layout.itemHeaderIndex);
    column ? (seriesItemHeader.style.width = "100%") : (seriesItemHeader.style.height = "100%");
    if (!column) {
        seriesItemHeader.style.maxHeight = "60px";
    }
    seriesItemHeader.setAttribute("id", "item-Header");
    seriesItemHeader.setAttribute("data-id", "item-Header");
    seriesItemHeader.setAttribute("data-slideid", this.data.slideID);
    seriesItemHeader.setAttribute("data-type", "itemheader");
    seriesItemHeader.setAttribute("data-animation", "graphictitle");
    this.ChartHelper.setTextChangeListner(seriesItemHeader);
    if (this.data._itemHeaderTextColor) {
        seriesItemHeader.style.setProperty("color", this.data._itemHeaderTextColor, "important");
    }
    if (this.data.layout.itemHeaderHPosition) seriesItemHeader.classList.add("header" + this.data.layout.itemHeaderHPosition);
    element.appendChild(seriesItemHeader);
    if (this.data.layout.bgTabel) {
        seriesItemHeader.classList.add("enabletable");
    }
    if (measurment) {
        let obj = column ? { width: element.clientWidth, height: element.clientHeight } : { width: element.clientWidth, height: element.clientHeight + 5 };
        if (!column) {
            let lineHeight = window.getComputedStyle(element)["line-height"] ? parseFloat(window.getComputedStyle(element)["line-height"]) : false;
            if (lineHeight) {
                let lineCount = Math.ceil((element.clientHeight - 16) / lineHeight);
                lineCount = lineCount > 3 ? 3 : lineCount;
                let maxHeight = lineCount * lineHeight;
                obj.height = maxHeight + 21;
            }
        }
        parentNode.removeChild(element);
        return obj;
    } else {
        parentNode.style.flexWrap = "unset";
    }
};
BaseChart.prototype.checkMaxLineCount = function (element, catagorie = null) {
    if (catagorie) {
        let lineHeight = 0;
        let lineCount = 0;
        switch (catagorie) {
            case "bar":
                element.style.height = "100%";
                lineHeight = parseFloat(window.getComputedStyle(element)["line-height"]);
                lineCount = Math.floor(element.clientHeight / lineHeight);
                lineCount = lineCount < 1 ? 1 : lineCount;
                element.style.height = lineCount * lineHeight + "px";
                break;
            case "column":
                element.style.height = "100%";
                lineHeight = parseFloat(window.getComputedStyle(element)["line-height"]);
                lineCount = Math.floor(element.clientHeight / lineHeight);
                lineCount = lineCount < 1 ? 1 : lineCount;
                element.style.height = lineCount * lineHeight + "px";
                break;
        }
    }
};
BaseChart.prototype.lonngLabelMesurement = function (argparent, argprops, boolMax = false, labelMaxW, labelMaxH) {
    if (this.data.layout.showLabel) {
        let vLayoutName = "";
        let labelFontStyle = this.data.arrLabelFontStyle[0] ? this.data.arrLabelFontStyle[0] : this.ChartFonts.headingClassName;
        let element = document.createElement("div");
        let comparisonId = "label-text-";
        element.id = comparisonId + 1;
        element.className = "label moodanimation " + vLayoutName + " " + labelFontStyle;
        element.style.minWidth = 10 + "px";
        element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";
        element.setAttribute("data-textalign", "horizantal");
        element.dataset.animation = "primarytext";
        element.style.order = "0";
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (argparent) argparent.appendChild(element);
        else return element;
        if (this.data.layout.bgTabel) {
            element.classList.add("enabletable");
        }
        this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : [24, 24];
        if (this.data.layout.labelfontsize) {
            element.style.fontSize = this.maxLabelFontSize[0] + "px";
        }
        let labelColor = "";
        this.labelStyle = labelColor ? labelColor : this.ChartFonts.labelOuterColor;
        let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        subelement.className = this.data.layout.labelColor ? "labeltext " + this.labelStyle : "labeltext  " + this.data.clsLabelTextColor + this.labelStyle;
        subelement.id = "labeltext-" + 0;
        if (this.data.arrLabelOpacity[0]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[0], "");
        if (this.data.arrLabeltexttransform[0]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[0], "");
        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[0];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", 0);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = labelFontStyle ? labelFontStyle.trim() : "";
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(0);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, 0, this.data.layout.valueTextShdowOpacity);
            subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        if (this.data.presentMode) {
            subelement.setAttribute("contenteditable", "false");
        }
        let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(0, this.voData.seriesLength / 2) : 0;
        subelement.setAttribute("data-id", valGroupIndex);
        let comparisonType = this.data.chartName == "comparisonModelType3" && 0 >= this.data.seriesLength / 2 ? "comparisonlabel" : "label";
        subelement.setAttribute("data-type", comparisonType);
        element.appendChild(subelement);
        this.ChartHelper.setTextChangeListner(subelement);
        element.style.height = labelMaxH + "px";

        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            let width = element.clientWidth;
            let height = element.clientHeight;
            argparent.removeChild(element);
            return { width: width, height: height };
        }
    }
};
BaseChart.prototype.lonngValueMesurement = function (argparent, argprops, boolmax = false, valueMaxW, valueMaxH, boolOrder = false, overlapValue = true, graphiccustomW) {
    this.graphicWidthValue = graphicW ? graphicW : this.graphicWidthValue;
    const index = 0;
    const groupindex = 1;
    let valIndex = 1;
    let valGroupIndex = 1;
    this.valueMaxW = valueMaxW;
    this.valueMaxH = valueMaxH;
    let padding = {
        left: this.data.layout.placeholderPaddingleft,
        right: this.data.layout.placeholderPaddingright,
        top: this.data.layout.placeholderPaddingtop,
        bottom: this.data.layout.placeholderPaddingbottom,
    };
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.maxValueFontSize;

    let vLayoutName = "";
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + valGroupIndex + "_" + valIndex;
    element.style.minWidth = 20 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.className = "value " + vLayoutName;
    element.style.order = boolOrder ? "1" : "0";
    if (this.data.layout.backgroundFillType == "pattern") {
        element.style.zIndex = "1";
    }
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valueInset == "bgoutside") {
        element.classList.remove("minlabelsize");
    }
    let tempMaxValue = this.valueMaxW;
    let tempMaxHeight = this.valueMaxH;
    tempMaxValue = this.valueMaxW - (parseFloat(padding["left"]) + parseFloat(padding["right"]));
    tempMaxHeight = tempMaxHeight < 0 ? 0 : tempMaxHeight;
    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext  " + colorTabValueCustomClass + " " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    }
    subelement.id = "valuetext-" + valGroupIndex + "_" + valIndex;
    subelement.innerHTML = boolmax ? this.data.longValue : "";
    subelement.style.maxWidth = tempMaxValue + "px";
    subelement.style.maxHeight = tempMaxHeight + "px";
    subelement.style.fontSize = this.maxValueFontSize[0] + "px";
    subelement.style.visibility = boolmax ? "visible" : this.voData._valueDisplayFormat[valGroupIndex + " " + valIndex];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[0]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + valIndex);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-graphic-x", this.graphicWidthValue);

    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }

    if (this.data.chartName.includes("comparisonModel") && index == 0) {
        subelement.setAttribute("data-graphic-x", -this.graphicWidthValue);
    }
    if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.data.seriesLength / 2) {
        subelement.setAttribute("data-graphic-x", this.graphicWidthValue);
    }
    if (graphiccustomW) {
        subelement.setAttribute("data-graphic-x", graphiccustomW);
    }

    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(valGroupIndex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, valGroupIndex, this.data.layout.valueTextShdowOpacity);
        subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }

    if (this.data.chartName == "barStackedRectangle") {
        subelement.dataset.animation = "secondarytext" + (valIndex + 1);
        subelement.dataset.stackedmultiseries = "true";
    }
    element.appendChild(subelement);
    this.ChartHelper.setTextChangeListner(subelement);
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.maxValueFontSize[0] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize = [maxFontSize, maxFontSize];
    }
    let minFontSize = this.minValueFontSize[0];
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.ChartUtils.createSpanFormat(subelement, this.data);
    this.ChartHelper.adjustFontSize(subelement, 20, minFontSize, this.maxValueFontSize[0], true);
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, minFontSize, this.maxValueFontSize[0]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (boolmax) {
        let width = element.clientWidth;
        let height = element.clientHeight;
        element.remove();
        return { width: width, height: height };
    }
};
BaseChart.prototype.setMaxHeight = function (childNode) {
    let lineHeight = window.getComputedStyle(childNode) && window.getComputedStyle(childNode)["line-height"] ? parseFloat(window.getComputedStyle(childNode)["line-height"]) : 0;
    let lineCount = 1;
    let maxHeight = lineHeight * lineCount;
    childNode.style.maxHeight = maxHeight + "px";
    childNode.style.overflow = "hidden";
};
BaseChart.prototype.checkMaxLabelLineHeight = function (parentNode, labelMaxHeight) {
    let dummeyDivElement = document.createElement("div");
    let labelFontStyle = this.data.arrLabelFontStyle[0] ? this.data.arrLabelFontStyle[0] : this.ChartFonts.labelThemeClassName;
    dummeyDivElement.className = labelFontStyle;
    parentNode.appendChild(dummeyDivElement);
    let lineHeight = window.getComputedStyle(dummeyDivElement)["line-height"];
    if (lineHeight) {
        parentNode.removeChild(dummeyDivElement);
        let totalLineHeight = parseFloat(lineHeight);
        let maxLineCount = Math.floor(labelMaxHeight / totalLineHeight);
        return totalLineHeight * maxLineCount;
        // if(labelMaxHeight<totalLineHeight){
        //     return totalLineHeight
        // }else{
        //     return labelMaxHeight
        // }
    } else {
        return labelMaxHeight;
    }
};
BaseChart.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize) {
    if (this.groupindex == this.data.seriesLength - 1 && !boolmax && !this.data.promptText) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        this.data.data.removeAttribute("valuemaxfontsize");
    }
};
BaseChart.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            return "clsAccentColor";
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "secondary":
            if (fillProperty == "color") {
                return "clsTextSecondaryColor";
            } else {
                return "clsNodeSecondarybg";
            }
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            return "";
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    }
};
BaseChart.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
BaseChart.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};
BaseChart.prototype.createSeriesItemLabelNode = function (element, seriesItemIndex) {
    let themeClassName = "p5";
    if (this.data.fontDeatils && this.data.fontDeatils.seriesItemLabel) {
        themeClassName = this.data.fontDeatils.seriesItemLabel;
    }
    if (this.data._seriesItemLabelFontSize?.[seriesItemIndex] && this.data._seriesItemLabelFontSize?.[seriesItemIndex] != "false") {
        themeClassName = this.data._seriesItemLabelFontSize?.[seriesItemIndex];
    }

    const seriesItemLabel = this.ChartHelper.createDivElement();
    seriesItemLabel.className = "seriesItemLabel seriesItemLabelNode moodanimation clsLabelTextColor " + themeClassName + " " + this.data.layout.seriesItemLabelPaddingClass + " " + this.data.layout.seriesItemLabelGlobalClassName;
    seriesItemLabel.setAttribute("data-animation", "seriesitemlabel");
    let SVGUtils = new window["SVGUtils"]();

    SVGUtils.assignAttributes(seriesItemLabel, {
        id: "seriesItemLabel-" + seriesItemIndex,
        contenteditable: "true",
        "data-id": seriesItemIndex.toString(),
        "data-themeclass": themeClassName,
        "data-slideid": this.data.slideID,
        "data-prompt-text": "Enter Label",
        "data-dck-selector": "true",
        "data-type": "seriesItemLabel",
    });
    seriesItemLabel.style.maxWidth = this.seriesItemLabelNodeMaxWidth + "px";
    seriesItemLabel.style.maxHeight = this.seriesItemLabelNodeMaxHeight + "px";
    // seriesItemLabel.style.width = this.seriesItemLabelNodeMaxWidth + "px";
    seriesItemLabel.style.position = "absolute";
    seriesItemLabel.style.top = "0";
    seriesItemLabel.style.left = "0";

    if (this.data._seriesItemLabelTransform?.[seriesItemIndex]) seriesItemLabel.style.setProperty("text-transform", this.data._seriesItemLabelTransform?.[seriesItemIndex], "important");

    if (this.data._seriesItemLabelBold?.[seriesItemIndex] == "true") {
        seriesItemLabel.style.setProperty("font-weight", "bold", "important");
    }
    if (this.data._seriesItemLabelItalic?.[seriesItemIndex] == "true") {
        seriesItemLabel.style.setProperty("font-style", "italic", "important");
    }
    if (this.data._seriesItemLabelOpacity?.[seriesItemIndex]) {
        seriesItemLabel.style.opacity = this.data._seriesItemLabelOpacity?.[seriesItemIndex];
    }
    if (this.data._seriesItemLabelTextSize?.[seriesItemIndex] != "false") {
        seriesItemLabel.style.fontSize = this.data._seriesItemLabelTextSize?.[seriesItemIndex];
    }
    if (this.data._seriesItemLabelTextColor?.[seriesItemIndex]) {
        seriesItemLabel.style.setProperty("color", this.data._seriesItemLabelTextColor?.[seriesItemIndex], "important");
        TextHighLightUtils.clearStylesBasedOnType(seriesItemLabel, "textcolor");
    }
    seriesItemLabel.innerHTML = this.data.seriesItemLabels[seriesItemIndex];
    element.appendChild(seriesItemLabel);
    this.ChartHelper.setTextChangeListner(seriesItemLabel);
    this.seriesitemLabelLongLabelWidth = this.seriesitemLabelLongLabelWidth > seriesItemLabel.clientWidth ? this.seriesitemLabelLongLabelWidth : seriesItemLabel.clientWidth;
    this.seriesitemLabelLongLabelHeight = this.seriesitemLabelLongLabelHeight > seriesItemLabel.clientHeight ? this.seriesitemLabelLongLabelHeight : seriesItemLabel.clientHeight;
};
BaseChart.prototype.createTooltipCallout = function (eParent, data) {
    this.ChartUtils.createTooltipCallout(eParent, null, null, data?.data);
};

// Function to position tooltip near cursor
BaseChart.prototype.positionTooltip = function (e, tooltip) {
    const x = e.clientX + 10; // Offset from cursor
    const y = e.clientY - 20;

    // Adjust position if tooltip would go off-screen
    const tooltipRect = tooltip.getBoundingClientRect();
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;

    let finalX = x;
    let finalY = y;

    if (x + tooltipRect.width > viewportWidth) {
        finalX = x - tooltipRect.width - 20; // Position to left of cursor if would overflow
    }

    if (y + tooltipRect.height > viewportHeight) {
        finalY = y - tooltipRect.height - 10;
    }

    if (y < tooltipRect.height) {
        finalY = y + 30; // Position below cursor if too close to top
    }

    tooltip.style.left = finalX + "px";
    tooltip.style.top = finalY + "px";
};

// Basic CAGR calculation
BaseChart.prototype.calculateCAGR = function (startValue, endValue, years) {
    return (endValue / startValue) ** (1 / years) - 1;
};

// CAGR as percentage
BaseChart.prototype.cagrPercent = function (startValue, endValue, years) {
    years = years - 1;
    if (years == 0) {
        return "0";
    }
    const cagr = ((endValue / startValue) ** (1 / years) - 1) * 100;
    if (cagr == 0) {
        return "0";
    }
    const rounded = Math.round(cagr * 100) / 100;
    return rounded % 1 === 0 ? `${rounded}` : `${rounded.toFixed(2)}`;
};

function BaseSeries(argparent, argprops) {
    this.voData = null;
    this.name = "BaseSeries";
    this.index = argprops.index;
    this.ChartFonts = new window["ChartFonts"]();
    this.totalValueMaxFontSize = 30;
    DComponent.call(this, argparent, argprops);
}
BaseSeries.prototype = Object.create(DComponent.prototype);
BaseSeries.prototype.constructor = BaseSeries;

BaseSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["BaseSeriesItem"](argparent, argprops);
};

BaseSeries.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            return "textgradient";
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsNodeBackgroundbg";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "secondary":
            if (fillProperty == "color") {
                return "clsTextSecondaryColor";
            } else {
                return "clsNodeSecondarybg";
            }
        case "tertiary":
            if (fillProperty == "color") {
                return "clsQuaternaryColor";
            } else {
                return "clsQuaternaryBg";
            }
        case "alternatebg":
            if (fillProperty == "color") {
                return "clsTextalternatebgColor";
            } else {
                return "clsNodealternatebgbg";
            }
            break;
        case "contrast":
            if (fillProperty == "color") {
                return "clsContrastTextColor";
            } else {
                return "clsNodeSecondarybg";
            }
            break;
        default:
            return valueStyle;
            break;
    }
    if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
        switch (fillProperty) {
            case "color":
                return this.ChartFonts.appendgraphicColor(PropertyIndex);
                break;
            case "bgcolor":
                return this.data.ChartFonts.appendgraphicBgColor(groupindex); //"accent" + (groupindex + 1) + "-bg-color";
                break;
        }
    }
};

BaseSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doElementsComputation();
    }
};

BaseSeries.prototype.updateBasicData = function () {
    this.seriesItemLength = this.voData.seriesItemLength;
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
};

