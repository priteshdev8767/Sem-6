            isImageNode = false;
            if (itemId?.includes("graphicimage-") || elementType == "IMAGE" || elementType == "ICON") {
                isImageNode = true;
            }
        }
        if (isImageNode && (elementType == "ICON" || elementType == "IMAGE" || elementType == "logo")) {
            let arrPlaceHolder = [];
            let selectedIndex = 0;
            iconGroup = eltarget.getAttribute("data-icongroup");
            iconGroup = iconGroup ? iconGroup : "";
            parent = this.getParentElementProp(eltarget);
            let placeholderElements = eltarget.getAttribute("data-placeholderelement");
            if (placeholderElements) {
                arrPlaceHolder = [
                    {
                        ["data"]: "icon",
                        ["label"]: "Icon",
                        icon: "appicons/ic_icon_graphics.svg",
                    },
                    {
                        ["data"]: "image",
                        ["label"]: "Image",
                        icon: "appicons/ic_image_rect_outline.svg",
                    },
                    {
                        ["data"]: "logo",
                        ["label"]: "Logo",
                        icon: "appicons/ic_highlight_circle_outline.svg",
                    },
                ];
                for (let i = 0; i < arrPlaceHolder.length; i++) {
                    if (elementType.toLowerCase() == arrPlaceHolder[i].data) selectedIndex = i;
                }
                hasPlaceHolderProperty = {
                    ["iconnode"]: "icon",
                    ["dpsource"]: arrPlaceHolder,
                    ["selectedindex"]: selectedIndex,
                    ["floaterproperty"]: "diagramgraphictype",
                };
            }

