        this.totalValueshadow = this.data.totalvalue.hasOwnProperty("shadow") ? "true" : "";
        this.totalValueShadowClass = this.data.totalvalue.hasOwnProperty("shadow") ? this.data.totalvalue.shadow : "s";
        this.totalValueInterchange = this.data.totalvalue.hasOwnProperty("verticalalign") ? this.data.totalvalue.verticalalign : "";
        this.totalValueColor = this.data.totalvalue.hasOwnProperty("color") ? this.data.totalvalue.color : "";
        this.totalValuebgBorder = this.data.totalvalue.hasOwnProperty("bgborder") ? this.data.totalvalue.bgborder : "";
        this.totalValueGlobalstyle = this.data.totalvalue.hasOwnProperty("globalstyle") ? this.data.totalvalue.globalstyle : "";
    }
    this.seriesItemLabelAlignment = this.data.seriesItem?.hasOwnProperty("alignment") ? this.data.seriesItem.alignment : "right";
    this.seriesItemLabelGlobalClassName = this.data.seriesItem?.hasOwnProperty("globalstyle") ? this.data.seriesItem.globalstyle : "cs-chart-series-label-style";
    this.seriesItemLabelAlignment = this.xmlData.getAttribute("customseriesitemlabelposition") ? this.xmlData.getAttribute("customseriesitemlabelposition") : this.seriesItemLabelAlignment;
    this.seriesItemLabelPaddingClass = this.data.seriesItem?.hasOwnProperty("padding") ? this.data.seriesItem.padding : "clsPaddingRight32";
    if (this.seriesItemLabelAlignment == "right") {
        this.seriesItemLabelPaddingClass = this.createAlterClass("clsPaddingLeft32");
    }
    this.seriesItemLabelConnectorLineClass = this.data?.seriesItem?.connector?.hasOwnProperty("globalstyle") ? this.data?.seriesItem?.connector?.globalstyle : "cs-chart-series-label-connector-style";
    this.seriesItemLabelAlterPaddingClass = this.seriesItemLabelPaddingClass ? this.createAlterClass(this.seriesItemLabelPaddingClass) : "";
    this.seriesItemConnectorLineClass = this.data?.seriesitemconnector?.hasOwnProperty("globalstyle") ? this.data.seriesitemconnector.globalstyle : "cs-stacked-bar-connector-line";

    this.groupLabelGlobalClassName = this.data.grouplabel?.hasOwnProperty("globalstyle") ? this.data.grouplabel.globalstyle : "";
    this.groupLabelPaddingClass = this.data.grouplabel?.hasOwnProperty("padding") ? this.data.grouplabel.padding : "";
    this.groupLabelAlterPaddingClass = this.groupLabelPaddingClass ? this.createAlterClass(this.groupLabelPaddingClass) : "";
}
VOLayout.prototype.createAlterClass = function (classname) {
    let alterClass = "";
    if (classname) {
        if (classname?.includes("top")) {
            alterClass = classname.replace("top", "bottom");
        } else if (classname?.includes("bottom")) {
            alterClass = classname.replace("bottom", "top");
        }
        if (classname?.includes("left")) {
            alterClass = classname.replace("left", "right");
        } else if (classname?.includes("right")) {
            alterClass = classname.replace("right", "left");
        }
        if (classname?.includes("positive")) {
            alterClass = classname.replace("positive", "negative");
        } else if (classname?.includes("negative")) {
            alterClass = classname.replace("negative", "positive");
        }
    }
    return alterClass || classname;
};
VOLayout.prototype.getPositionBounds = function (slide) {
    let styleDatas = window.getComputedStyle(slide);
    let vPosition = window.getComputedStyle(slide).getPropertyValue("--graphicVAlign"); //styleDatas["--graphicVAlign"]?styleDatas["--graphicVAlign"]:"";
    let hPosition = window.getComputedStyle(slide).getPropertyValue("--graphicHAlign"); //styleDatas["--graphicHAlign"]?styleDatas["--graphicHAlign"]:"";
    vPosition = vPosition ? vPosition : "";
    hPosition = hPosition ? hPosition : "";
    vPosition = vPosition == "center" ? "middle" : vPosition;
    return { valign: vPosition, halign: hPosition };
};
VOLayout.prototype.createBoxShadow = function () {
    this.shadowxValue = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 0 ? this.data.item.shadow[0] + "px" : 0 + "px";
    this.shadowyValue = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 1 ? this.data.item.shadow[1] + "px" : 0 + "px";
    this.shadowblurValue = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 2 ? this.data.item.shadow[2] + "px" : 20 + "px";
    this.shadowspreadValue = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 3 ? this.data.item.shadow[3] + "px" : -4 + "px";
    return this.shadowxValue + " " + this.shadowyValue + " " + this.shadowblurValue + " " + this.shadowspreadValue;
};
VOLayout.prototype.createValueShapeBoxShadow = function () {
    this.valueShapeshadowxValue = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shape.shadow.length > 0 ? this.data.value.shape.shadow[0] + "px" : 0 + "px";
    this.valueShapeshadowyValue = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shape.shadow.length > 1 ? this.data.value.shape.shadow[1] + "px" : 0 + "px";
    this.valueShapeshadowblurValue = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shape.shadow.length > 2 ? this.data.value.shape.shadow[2] + "px" : 20 + "px";
    this.valueShapeshadowspreadValue = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shape.shadow.length > 3 ? this.data.value.shape.shadow[3] + "px" : -4 + "px";
    return this.valueShapeshadowxValue + " " + this.valueShapeshadowyValue + " " + this.valueShapeshadowblurValue + " " + this.valueShapeshadowspreadValue;
};

VOLayout.prototype.createBgBoxShadow = function () {
    this.bgShadowxValue = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 0 ? this.data.background.shadow[0] + "px" : 0 + "px";
    this.bgShadowyValue = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 1 ? this.data.background.shadow[1] + "px" : 0 + "px";
    this.bgShadowblurValue = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 2 ? this.data.background.shadow[2] + "px" : 20 + "px";
    this.bgShadowspreadValue = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 3 ? this.data.background.shadow[3] + "px" : -4 + "px";
    return this.bgShadowxValue + " " + this.bgShadowyValue + " " + this.bgShadowblurValue + " " + this.bgShadowspreadValue;
};
VOLayout.prototype.createTextShadow = function () {
    let xValue = this.data.value && this.data.value.hasOwnProperty("shadow") && this.data.value.shadow.length > 0 ? this.data.value.shadow[0] + "px" : 2 + "px";
    let yValue = this.data.value && this.data.value.hasOwnProperty("shadow") && this.data.value.shadow.length > 1 ? this.data.value.shadow[1] + "px" : 2 + "px";
    let blurValue = this.data.value && this.data.value.hasOwnProperty("shadow") && this.data.value.shadow.length > 2 ? this.data.value.shadow[2] + "px" : 4 + "px";
    return xValue + " " + yValue + " " + blurValue;
};
VOLayout.prototype.createLabelTextShadow = function (legendLabel = false) {
    let baseData = this.data.label;
    if (legendLabel && this.data.legend) {
        baseData = this.data.legend.label;
    }
    let xValue = baseData && baseData.hasOwnProperty("shadow") && baseData.shadow.length > 0 ? baseData.shadow[0] + "px" : 2 + "px";
    let yValue = baseData && baseData.hasOwnProperty("shadow") && baseData.shadow.length > 1 ? baseData.shadow[1] + "px" : 2 + "px";
    let blurValue = baseData && baseData.hasOwnProperty("shadow") && baseData.shadow.length > 2 ? baseData.shadow[2] + "px" : 4 + "px";
    return xValue + " " + yValue + " " + blurValue;
};
VOLayout.prototype.itemborderRadius = function (itemvalues) {
    if (itemvalues.radius) {
        let radius = itemvalues.radius;
        let objBorderRadiusValues = { letftop: radius[0], righttop: radius[1], leftbottom: radius[2], rightbottom: radius[3] };
        return objBorderRadiusValues;
    } else {
        return null;
    }
};
VOLayout.prototype.createGradientValue = function (valueData, index = "") {
    let gradientValues = index ? valueData[index + "gradient"] : valueData["gradientValue"];
    let alignment = gradientValues && gradientValues.rotation ? gradientValues.rotation : "to right";
    let color1 = gradientValues && gradientValues.color1 ? "var(--" + gradientValues.color1 +")" : "var(--gradient1-color-rgb)";
    let color2 = gradientValues && gradientValues.color2 ? "var(--" + gradientValues.color2 + ")" : "var(--gradient2-color-rgb)";
    let opacity1 = gradientValues && gradientValues.color1opacity ? gradientValues.color1opacity : "0";
    let opacity2 = gradientValues && gradientValues.color2opacity ? gradientValues.color2opacity : "0";
    let percentage1 = gradientValues && gradientValues.color1start ? gradientValues.color1start : "0";
    let percentage2 = gradientValues && gradientValues.color2stop ? gradientValues.color2stop : "100";
    let gradientValue = "linear-gradient(" + alignment + ", rgba(" + color1 + "," + opacity1 + ") " + percentage1 + "%, rgba(" + color2 + "," + opacity2 + ") " + percentage2 + "%)";
    return { strgradientValue: gradientValue, gridvalues: { align: alignment, color1: color1, color2: color2, opacity1: opacity1, opacity2: opacity2, percentage1: percentage1, percentage2: percentage2 } };
};
VOLayout.prototype.getRgpaValue = function (colorValue) {
    let colorValues = "";
    switch (colorValue) {
        case "item1":
            colorValues = "var(--item1-color-rgb)";
            break;
        case "item2":
            colorValues = "var(--item2-color-rgb)";
            break;
        case "item3":
            colorValues = "var(--item3-color-rgb)";
            break;
        case "item4":
            colorValues = "var(--item4-color-rgb)";
            break;
        case "item5":
            colorValues = "var(--item5-color-rgb)";
            break;
        case "item6":
            colorValues = "var(--item6-color-rgb)";
            break;
        case "bgcolor":
            colorValues = "var(--item6-color-rgb)";
            break;
    }
    return colorValues;
};
VOLayout.prototype.itemBorder = function (itemvalues) {
    if (itemvalues.border) {
        let border = itemvalues.border;
        let objBorder = { alignment: border[0], width: border[1], color: border[2] };
        return objBorder;
    } else {
        return null;
    }
};
VOLayout.prototype.isString = function (value) {
    if (typeof value === "string") {
        return true;
    } else {
        return false;
    }
};
Object.defineProperties(VOLayout.prototype, {
    itemLayoutData: {
        get: function () {
            return this._itemLayoutData;
        },
    },
});

