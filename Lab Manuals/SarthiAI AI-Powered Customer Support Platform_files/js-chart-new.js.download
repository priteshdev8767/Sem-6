BaseSeries.prototype.getBgColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "alternatebg":
            if (fillProperty == "bordercolor") {
                return "ci-alternatebg-primary-border-color";
            } else if (fillProperty == "color") {
                return "clsTextalternatebgColor";
            } else {
                return "clsNodealternatebgbg";
            }
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "bgcolor":
            if (fillProperty == "bordercolor") {
                return "bgborderColor";
            } else {
                return "itembgColor";
            }
            break;
        case "alternatebg":
            if (fillProperty == "bordercolor") {
                return "ci-alternatebg-primary-border-color";
            } else {
                return "ci-alternatebg-primary-fill";
            }
            break;
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                return "clsNodeSecondarybg";
            }
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsQuaternaryColor";
            } else {
                return "clsQuaternaryBg";
            }
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "cf-background-color-section-primary";
                    }
                    if (this.data.multicolor) {
                        return "cf-background-color-section-primary";
                    } else {
                        return "cf-background-color-section-primary";
                        // return "accent1-bg-color";
                    }
                    break;
                case "bordercolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsBorderAccent";
                    }
                    if (this.data.multicolor) {
                        return "clsBorderAccent";
                    } else {
                        return "clsBorderAccent";
                        // return "accent1-border-color";
                    }
                    break;
            }
        }
    }
};
BaseSeries.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize) {
    if (this.groupindex == this.data.seriesLength - 1 && !boolmax && !this.data.promptText) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        if (!this.addvalue) this.data.data.removeAttribute("valuemaxfontsize");
    }
};
BaseSeries.prototype.setBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--cutomNodeBorderWidthPercent");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".iconHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
};
BaseSeries.prototype.setImageBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--customNodeBorderImageWidth");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".imageHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderImageWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
};

BaseSeries.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
BaseSeries.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};

BaseSeries.prototype.createTotalValueContainer = function (element, mesurment = false) {
    if (this.data.showTotalValue) {
        // let themeClassName = "h1";
        // if (this.ChartFonts && this.ChartFonts.projectiontext) {
        //     themeClassName = this.ChartFonts.projectiontext;
        // }

        let totalValueContainer = this.ChartHelper.createDivElement({});
        totalValueContainer.className = "totalvalueelement";
        totalValueContainer.setAttribute("data-animation", "totalvaluetext");
        totalValueContainer.style.maxHeight = this.totalValueHeight + "px";
        totalValueContainer.style.maxWidth = this.totalValueWidth + "px";
        totalValueContainer.style.overflow = "hidden";
        let deviation = 0.6;
        if (this.data.layout.totalValuePaddingClass) totalValueContainer.classList.add(this.data.layout.totalValuePaddingClass);
        element.appendChild(totalValueContainer);
        this.doAddTotalValue(totalValueContainer, mesurment);
        // if (this.index == this.data.seriesLength - 1) this.checkMinWidth();
        if (mesurment) {
            if (this.data.promptText) {
                this.longTotalvalueWidth = this.data.totalValueBounds.width > totalValueContainer.clientWidth ? this.data.totalValueBounds.width : totalValueContainer.clientWidth + deviation;
                this.longTotalvalueHeight = this.data.totalValueBounds.height > totalValueContainer.clientHeight ? this.data.totalValueBounds.height : totalValueContainer.clientHeight + deviation;
            } else {
                this.longTotalvalueWidth = totalValueContainer.clientWidth;
                this.longTotalvalueHeight = totalValueContainer.clientHeight;
            }
            totalValueContainer.remove();
            this.data.totalValueBounds = { width: this.longTotalvalueWidth, height: this.longTotalvalueHeight };
        } else {
            totalValueContainer.style.minWidth = this.longTotalvalueWidth + "px";
            totalValueContainer.style.minHeight = this.longTotalvalueHeight + "px";
        }
    }
};

BaseSeries.prototype.formatNumber = function (num) {
    return num % 1 === 0 ? num : Math.floor(num * 100) / 100;
};
BaseSeries.prototype.doAddTotalValue = function (argparent, mesurment = false) {
    let themeClassName = this.ChartFonts.valueThemeClassName;
    let promptTextThemeClass = this.ChartFonts.promptTextClassName;
    if (this.data.promptText) {
        themeClassName = promptTextThemeClass;
    }

    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }

    let paddingHorizontalValue = parseFloat(window.getComputedStyle(argparent)["padding-left"] || 0) + parseFloat(window.getComputedStyle(argparent)["padding-right"] || 0);
    let paddingVerticalValue = parseFloat(window.getComputedStyle(argparent)["padding-top"] || 0) + parseFloat(window.getComputedStyle(argparent)["padding-bottom"] || 0);

    const vLayoutName = this.totalValuelayoutClassName("totalvalue", true);
    const element = this.ChartHelper.createDivElement({});
    element.style.minWidth = 20 + "px";
    element.style.minHeight = 20 + "px";
    element.style.height = "100%";
    element.style.maxWidth = this.totalValueWidth - paddingHorizontalValue + "px";
    element.style.maxHeight = this.totalValueHeight - paddingVerticalValue + "px";
    element.style.overflow = "hidden";
    element.className = "totalValue " + this.totalValueStyle + " " + vLayoutName + " " + themeClassName;
    const subelement = document.createElement("div");
    subelement.className = themeClassName + " moodanimation";
    if (argparent) argparent.appendChild(element);
    else return element;
    element.appendChild(subelement);

    if (this.maxValueFontSize[0] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[0] = maxFontSize;
    }

    let fontSize = window.getComputedStyle(element)["font-size"] ? parseFloat(window.getComputedStyle(element)["font-size"]) : 30;
    subelement.innerHTML = mesurment ? this.formatNumber(this.data.longTotalValue) : this.formatNumber(this.data.arrSeriesItemValueTotal[this.index]);
    if (this.data._stackedPercentage && !this.data.promptText) {
        subelement.innerHTML = "100%";
    }
    let hasVisible = Object.values(this.data._valueDisplayFormat).some((value) => value === "visible");
    if (hasVisible) subelement.style.visibility = this.voData._valueDisplayFormat[this.index + " " + 0];
    subelement.setAttribute("data-dck-selector", "true");
    subelement.style.pointerEvents = "all";
    subelement.setAttribute("id", "totalvalue-" + this.index);
    subelement.setAttribute("data-id", this.index);
    subelement.setAttribute("data-index", this.index);

    subelement.setAttribute("data-animation", !this.data.promptText ? "secondarytext" + parseInt(this.data.seriesItemLength) : "prompttext");
    subelement.setAttribute("data-animateitem", !this.data.promptText ? "secondarytext" + this.data.seriesItemLength : "prompttext");
    subelement.setAttribute("data-stackedmultiseries", "true");
    if (this.data.chartName == "lineChart") {
        subelement.setAttribute("data-animation", !this.data.promptText ? "totalvaluesecondarytext" : "totalvalueprompttext");
    }
    subelement.setAttribute("data-type", "totalvalue");
    if (this.data._totalValueTextColor[this.index]) {
        subelement.style.setProperty("color", this.data._totalValueTextColor[this.index], "important");
    }
    if (this.data.promptText) {
        subelement.innerHTML = mesurment ? this.data.longTotalPromptText || "Total Value" : this.data.totalValuePromptText[this.index];
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-prompt-text", "Total Value");
        subelement.setAttribute("data-type", "totalvalueprompt");
        if (!mesurment) this.ChartHelper.setTextChangeListner(subelement);
        element.classList.add("totalvalueprompt");
    }
    if (mesurment) {
        subelement.setAttribute("maxFontSize", fontSize);
        subelement.style.fontSize = parseFloat(this.maxValueFontSize[0] || fontSize) + "px";
        subelement.style.lineHeight = "1.5";
        this.ChartUtils.updateValueTextProperties(subelement, this.data);
        this.calculateMaxFonsize(subelement, false, parseFloat(this.maxValueFontSize[0] || fontSize));
        this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[0], parseFloat(this.maxValueFontSize[0] || fontSize));
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[0], parseFloat(this.maxValueFontSize[0] || fontSize));
        subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
        this.totalValueMaxFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"] || 0);
    } else {
        subelement.style.fontSize = this.totalValueMaxFontSize + "px";
    }
    if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
};

// import ChartHelper from "../../../this.ChartHelper.js";
// import DComponent from "../DComponent.js";
// import SVGUtils from "../../../../../util/this.SVGUtils.js";

function BaseSeriesItem(argparent, argprops) {
    this.voData = null;
    this.name = "BaseSeries";
    this.index = argprops.index;
    this.groupindex = argprops.groupindex;
    DComponent.call(this, argparent, argprops);
}
BaseSeriesItem.prototype = Object.create(DComponent.prototype);
BaseSeriesItem.prototype.constructor = BaseSeriesItem;

BaseSeriesItem.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doElementsComputation();
    }
};

BaseSeriesItem.prototype.updateBasicData = function () {
    this.seriesItemLength = this.voData.seriesItemLength;
};
BaseSeriesItem.prototype.checkMaxLabelLineHeight = function (parentNode, labelMaxHeight) {
    let dummeyDivElement = document.createElement("div");
    let labelFontStyle = this.data.arrLabelFontStyle[0] ? this.data.arrLabelFontStyle[0] : this.ChartFonts.labelThemeClassName;
    dummeyDivElement.className = labelFontStyle;
    parentNode.appendChild(dummeyDivElement);
    let lineHeight = window.getComputedStyle(dummeyDivElement)["line-height"];
    if (lineHeight) {
        parentNode.removeChild(dummeyDivElement);
        let totalLineHeight = parseFloat(lineHeight) * 3;
        if (labelMaxHeight < totalLineHeight) {
            return totalLineHeight;
        } else {
            return labelMaxHeight;
        }
    } else {
        return labelMaxHeight;
    }
};
BaseSeriesItem.prototype.valuebgProperties = function (element) {
    if (this.data.layout.valuebgShapeType == "circle") {
        element.style.borderRadius = "50%";
    }
    if (this.data.layout.valuebgShapeType == "square") {
        element.style.borderRadius = "0";
    }
    if (this.data.layout.valuebgStyle == "border") {
        if (this.data.layout.valuebgBorderSize) {
            element.style.border = this.data.layout.valuebgBorderSize + "px solid";
            element.style.setProperty("--border-width", this.data.layout.valuebgBorderSize + "px", "");
        } else {
            element.style.setProperty("--border-width", "2px", "");
            element.style.border = "2px solid";
        }
        let strBordeClass = this.getBgColorDetails(this.groupindex, this.data.ChartFonts.appendgraphicBorderColor(this.groupindex), this.data.layout.valuebgBorderColor, "bordercolor");
        if (this.data.layout.valuebgBorderColor == "gradient") {
            if (
                (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("secondary-border-color");
            } else {
                element.classList.add("bordergradient");
            }
        } else {
            if (
                (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("secondary-border-color");
            } else {
                if (this.data.layout.valueBgBorderOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBordeClass, this.groupindex, this.data.layout.valueBgBorderOpacity);
                    element.style.borderColor = rgbavalue;
                } else {
                    element.classList.add(strBordeClass);
                }
            }
        }
    }
    if (this.data.layout.valuebgBgColor) {
        let strBgClass = this.getBgColorDetails(this.groupindex, "clsNodeSecondarybg", this.data.layout.valuebgBgColor, "bgcolor");
        if (this.data.layout.valuebgBgColor == "gradient") {
            if (
                (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("clsNodeSecondarybg");
            } else {
                element.classList.add("gradient");
            }
        } else {
            if (
                (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("clsNodeSecondarybg");
            } else {
                if (this.data.layout.valuebgOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBgClass, this.groupindex, this.data.layout.valuebgOpacity);
                    element.style.background = rgbavalue;
                } else {
                    element.classList.add(strBgClass);
                }
            }
        }
    }
    if (this.data.layout.valuebgRadius) {
        let borderRadiuslefttop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 0 ? this.data.layout.valuebgRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 1 ? this.data.layout.valuebgRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 2 ? this.data.layout.valuebgRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 3 ? this.data.layout.valuebgRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
};

BaseSeriesItem.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "alternatebg":
            if (fillProperty == "color") {
                return "clsTextalternatebgColor";
            } else {
                return "clsNodealternatebgbg";
            }
        case "secondary":
            if (fillProperty == "color") {
                return "clsTextSecondaryColor";
            } else {
                return "clsNodeSecondarybg";
            }
        case "tertiary":
            if (fillProperty == "color") {
                return "clsQuaternaryColor";
            } else {
                return "clsQuaternaryBg";
            }
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor") && styleProperty == "multiple") {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        // return "accent" + (colorValue + 1) + "-bg-color";
                        return "cf-background-color-section-primary";
                    }
                    // return "accent" + (groupindex + 1) + "-bg-color";
                    if (this.data.multicolor) {
                        return "cf-background-color-section-primary";
                    } else {
                        return "cf-background-color-section-primary";
                        // return "accent1-bg-color";
                    }
                    break;
            }
        }
    }
};
BaseSeriesItem.prototype.getBgColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "contrast":
            if (fillProperty == "bordercolor") {
                return "contrast-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "bgcolor":
            if (fillProperty == "bordercolor") {
                return "bgborderColor";
            } else {
                return "itembgColor";
            }
            break;
        case "alternatebg":
            if (fillProperty == "bordercolor") {
                return "ci-alternatebg-primary-border-color";
            } else if (fillProperty == "color") {
                return "clsTextalternatebgColor";
            } else {
                return "clsNodealternatebgbg";
            }
            break;
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                return "clsNodeSecondarybg";
            }
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsQuaternaryColor";
            } else {
                return "clsQuaternaryBg";
            }
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 && this.data.seriesItemLength == 1 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicColor(PropertyIndex);
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 && this.data.seriesItemLength == 1 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicBgColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicBgColor(groupindex);
                    break;
                case "bordercolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicBorderColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicBorderColor(groupindex);
                    break;
            }
        }
    }
};
BaseSeriesItem.prototype.getBgFillDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            if (fillProperty && fillProperty == "color") {
                PropertyIndex = 0;
            } else {
                PropertyIndex = groupindex;
            }
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "bgcolor":
            if (fillProperty == "stroke") {
                return "bgstroke";
            } else {
                return "fillbgColor";
            }
            break;
        case "alternatebg":
            if (fillProperty == "stroke") {
                return "ci-alternatebg-primary-stroke";
            } else {
                return "ci-alternatebg-primary-fill";
            }
            break;
        case "secondary":
            if (fillProperty == "stroke") {
                return "clsSecondaryStroke";
            } else {
                return "clsSecondaryFill";
            }
            break;
        case "contrast":
            if (fillProperty == "stroke") {
                return "contrast-stroke";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastTextColor";
                } else {
                    return "contrast-fill";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = PropertyIndex != 0 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        // return "accent" + (colorValue + 1) + "-fill";
                        return "cf-fill-section-primary";
                    }
                    // return "accent" + (groupindex + 1) + "-fill";
                    if (this.data.multicolor) {
                        return "cf-fill-section-primary";
                    } else {
                        return "cf-fill-section-primary";
                        // return "accent1-fill";
                    }
                    break;
                case "stroke":
                    return this.data.ChartFonts.appendgraphicStrokeColor(groupindex);
                    break;
            }
        }
    }
};
BaseSeriesItem.prototype.doMeasurementComputation = function (argProps) {};

BaseSeriesItem.prototype.doElementsComputation = function (argProps) {};

BaseSeriesItem.prototype.computeValueMeasurement = function (argProps) {};

BaseSeriesItem.prototype.createGroupSVG = function (argParents, argProps) {
    let eProps = {};
    let element = this.ChartHelper.createDivElement(eProps);
    return element;
};

