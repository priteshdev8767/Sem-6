    BasePieSeriesItem.call(this, argparent, argprops);
}
SimpleStackedVennSeriesItem.prototype = Object.create(BasePieSeriesItem.prototype);
SimpleStackedVennSeriesItem.prototype.constructor = SimpleStackedVennSeriesItem;
SimpleStackedVennSeriesItem.prototype.doAddGraphicElement=function() {
    let clsStyle = this.getBgColorDetails(this.groupindex, this.data.ChartFonts.graphicBgColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    let graphicWidthPercentage = this.state.height*this.data.values[this.groupindex][this.index]/this.data._postiveMaxValue;;
    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + this.groupindex + "_" + this.index,
    subelement.className = "graphicconatiner ";
    subelement.style.width =this.data.SVGUtils.createPercentValue(this.state.width,graphicWidthPercentage)
    subelement.style.height =this.data.SVGUtils.createPercentValue(this.state.height,graphicWidthPercentage)
    subelement.style.setProperty("--bg-opacity", "1");
    this.parent.appendChild(subelement);
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + this.groupindex + "_" + this.index,
    graphicElement.className = "chartgraphic graphicnode moodanimation " + this.transformOrginValue+" "+this.data.layout.itemGlobalStyle+" "+clsStyle;
    graphicElement.dataset.customorgin = this.customOrginValue;
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = "100%";
    if (this.data.boolEnableWidthReducer) {
        graphicElement.style.width = "96%";
    }
    graphicElement.dataset.animation = "item";
    subelement.appendChild(graphicElement)
}

function BaseTable(argParent, argProps) {
    this.maxAngle = 360;
    this.minSeriesSize = 300;
    this.widthPercentage = 1;
    this.maxGraphicSize = 400;
    this.name = "BaseTable";
    this.minValueFontSize = [25, 25];
    this.ChartFonts = new window["ChartFonts"]();
    this.maxValueFontSize = this.ChartFonts.maxValueFontSize;
    this.placeholderStyle = this.ChartFonts.valueOuterColor;
    BaseChart.call(this, argParent, argProps);
}
BaseTable.prototype = Object.create(BaseChart.prototype);
BaseTable.prototype.constructor = BaseTable;

BaseTable.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BaseTableSeries"](argParent, argProps);
};

BaseTable.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddGraphicDesk();
            this.doAddMetaData();
        }
    }
};

BaseTable.prototype.updateBasicData = function () {
    this.length = this.data.seriesLength;
    this.parent.style.display = "flex";
    this.parent.style.gridTemplateRows = "";
    this.parent.style.gridTemplateColumns = "";
    this.parent.style.alignItems = " center";
    this.parent.style.justifyContent = " center";
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : [22, 22];
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.4 - 8;
    this.labeMaxH = this.checkMaxLabelLineHeight(this.parent, this.labeMaxH);

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage * 0.9;
    this.valueMaxH = this.state.height * 0.4; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });
};

BaseTable.prototype.doMeasurementComputation = function () {
    let rectSize = 0;
    this.rectBaseLegend = { x: 0, y: 0, width: 0, height: 0 };
    this.rectBaseSeries = { x: (this.viewport.width - rectSize) / 2, y: (this.viewport.height - rectSize) / 2, width: this.viewport.width, height: this.viewport.height };
};

BaseTable.prototype.doAddGraphicDesk = function () {
    const element = document.createElement("table");
    element.id = "base-series";
    element.style.width = this.rectBaseSeries.width * 0.9 + "px";
    element.style.height = this.rectBaseSeries.height + "px";
    element.id = "base-series";
    element.className = "moodanimation";
    element.dataset.animation = "charttable";
    this.parent.style.alignItems = "center";
    this.parent.style.overflow = "scroll";
    this.parent.appendChild(element);
    this.doAddGraphicElement(element);
    if (this.parent.clientHeight <= element.clientHeight) {
        this.parent.style.alignItems = "flex-start";
    }
};

BaseTable.prototype.doAddGraphicElement = function (argparent) {
    let intStartAngle = 270;
    let intEndAngle = intStartAngle;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = {
            index: i1,
            viewportGroup: { x: 0, y: 0, width: this.state.width, height: this.state.height },
        };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(0, 0);
        series.size(this.rectBaseSeries.width, this.rectBaseSeries.height);
        series.data = this.data;
        this.items[i1] = series;
    }
};

BaseTable.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    return this.ChartFonts.appendgraphicColor(PropertyIndex); //"accent" + (PropertyIndex + 1) + "-color";
                    break;
                case "bgcolor":
                    return this.data.chartFonts.appendgraphicBgColor(groupindex);
                    break;
            }
        }
    }
};

function BaseTableSeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
