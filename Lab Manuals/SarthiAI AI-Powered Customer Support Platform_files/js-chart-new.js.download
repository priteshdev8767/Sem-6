    hadValueSeperator = hadValueSeperator ? false : true;
    hadValueSeperator = this.datapoint == "none" ? false : hadValueSeperator;
    this.seperator = data.getAttribute("showvalueseperator") ? (data.getAttribute("showvalueseperator") == "true" ? true : false) : true;
