function ChartAssetLoader() {
    this.loadAssetCount = 0;
}

ChartAssetLoader.Constants = {
    // icon style
    iconStyle: ["fill", "stroke", "glyph", "duotone", "colorfull", "line", "dual", "detailedline", "smoothline", "rounded", "roundfill", "dualline"],
};

ChartAssetLoader.arrInLoading = [];

ChartAssetLoader.prototype.loadAssets = function (diagramParent, arrayAssets, appAssetURL) {
    this.loadCount = 0;
    return new Promise((resolve, reject) => {
        if (!arrayAssets || arrayAssets.length === 0) {
            resolve();
            return;
        }
        for (let i = 0; i < arrayAssets.length; i++) {
            if (arrayAssets[i] && (arrayAssets[i].type == "icon" || arrayAssets[i].type == "image" || arrayAssets[i].type == "json" || arrayAssets[i].type == "asset")) {
                const strAssetUrl = arrayAssets[i].url;
                let strAssetPrefixURL = appAssetURL;
                strAssetPrefixURL = !!arrayAssets[i].corporateUrl && arrayAssets[i].corporateUrl != "" ? appCorporateURL : strAssetPrefixURL;
                this.downloadAsset(arrayAssets, strAssetPrefixURL + strAssetUrl, i, resolve, reject, diagramParent);
            } else {
                this.loadCount = this.loadCount + 1;
                if (arrayAssets.length == this.loadCount) resolve();
            }
        }
    });
};

ChartAssetLoader.prototype.appenDefs = function (item, nodeParent) {
    if (item != null) {
        let defs = this.getDocumentDefs(nodeParent);
        let name = this.getIconName(item);
        if (!this.isAssetInDefs(name, item.url, defs)) {
            let tempDiv = document.createElement("div");
            tempDiv.innerHTML = item.data;
            let svgDOM = tempDiv.querySelector("svg");
            if (svgDOM) {
                svgDOM.setAttribute("id", name);
                svgDOM.setAttribute("uid", item.url.replaceAll("/", "").replaceAll(".", "").toLowerCase());
                svgDOM.setAttribute("removeonmood", "true");
                svgDOM.setAttribute("iconpath", item.url);
                defs.appendChild(svgDOM);
            }
        }
    }
};

ChartAssetLoader.prototype.getAssertFromDefs = function (assetId, iconpath, defs) {
    for (let i1 = 0; i1 < defs.children.length; i1++) {
        let defNode = defs.children[i1];
        let deficonPath = defNode.getAttribute("iconpath");
        if (defNode.getAttribute("id") == assetId && (!deficonPath || deficonPath == iconpath)) return defNode;
    }
    return null;
};

ChartAssetLoader.prototype.isAssetInDefs = function (assetId, iconPath, defs) {
    for (let i1 = 0; i1 < defs.children.length; i1++) {
        let defNode = defs.children[i1];
        let uid = iconPath.replaceAll("/", "").replaceAll(".", "").toLowerCase();
        let defIconPath = defNode.getAttribute("iconpath");
        if (defNode.getAttribute("id") == assetId && defNode.getAttribute("uid") == uid && (!defIconPath || defIconPath == iconPath)) return true;
    }
    return false;
};

ChartAssetLoader.prototype.getIconStyle = function (item) {
    let arrIconStyle = ChartAssetLoader.Constants.iconStyle;
    let iconStyle = null;
    arrIconStyle.forEach((element) => {
        if (item.value && item.value.includes("/" + element + "/") && item.id && !item.id.endsWith("_" + element)) iconStyle = "_" + element;
    });
    return iconStyle;
};

ChartAssetLoader.prototype.getIconName = function (item) {
    if (!item.id) {
        item.id = item.value.substring(item.value.lastIndexOf("/") + 1).split(".")[0];
    }
    return item.id + (item.id != "placeholder" && this.getIconStyle(item) ? this.getIconStyle(item) : "");
};

ChartAssetLoader.prototype.getDocumentDefs = function (nodeParent, localDefs = null) {
    let defName = localDefs == true || nodeParent != document.body ? "svgDefsLocal" : "svgDefs";
    let svgDefs = nodeParent.querySelector("[id='" + defName + "']");
    if (!svgDefs) {
        svgDefs = this.createSVGElement("svg");
        this.assignSVGNodeAttributes(svgDefs, {
            width: 0,
            height: 0,
            id: defName,
        });
        nodeParent.appendChild(svgDefs);
    }
    let defs = svgDefs.querySelector("defs");
    if (!defs) {
        defs = this.createSVGElement("defs");
        svgDefs.appendChild(defs);
    }
    return defs;
};

ChartAssetLoader.prototype.createSVGElement = function (nodeName) {
    return document.createElementNS("http://www.w3.org/2000/svg", nodeName);
};

ChartAssetLoader.prototype.assignSVGNodeAttributes = function (node, attributes) {
    for (let attribute in attributes) {
        node.setAttributeNS(null, attribute, attributes[attribute]);
    }
};

ChartAssetLoader.prototype.downloadAsset = function (arrayAssets, assetURL, index, resolve, reject, diagramParent) {
    const xhr = new XMLHttpRequest();
    xhr.open("GET", assetURL);
    xhr.onload = (data) => {
        arrayAssets[index].data = data.target.response;
        if (xhr.status == 200) this.appenDefs(arrayAssets[index], diagramParent);
        this.loadCount++;
        if (arrayAssets.length == this.loadCount) resolve();
    };

    xhr.onerror = () => {
        this.loadCount++;
        if (arrayAssets.length == this.loadCount) resolve();
        if (reject) reject(xhr.statusText);
        console.log("File could not be loaded..." + xhr.statusText);
    };
    xhr.send();
};

ChartAssetLoader.prototype.oneAssetTimeDownload = function (resolve, objData, addToDefs = false, defsParent = null, reject = null, isAsync = true) {
    const xhr = new XMLHttpRequest();
    xhr.open("GET", objData.value, isAsync);
    xhr.onload = (data) => {
        objData.data = data.target.response;
        if (xhr.status == 200) {
            this.addSVGtoDefs(objData, addToDefs, defsParent);
            resolve(objData);
        } else {
            reject?.(data.target.response);
        }
    };
    xhr.onerror = () => {
        reject?.(xhr.statusText);
        console.log("File could not be loaded..." + xhr.statusText);
    };
    xhr.send();
};

ChartAssetLoader.prototype.addSVGtoDefs = function (objData, addToDefs = false, defsParent = null) {
    let tempDiv = document.createElement("div");
    objData.data = this.replaceImagePathInSvgString(objData.data, objData.value);
    tempDiv.innerHTML = objData.data;
    let svgNode = tempDiv.querySelector("svg");
    if (svgNode) {
        svgNode.setAttribute("width", "100%");
        svgNode.setAttribute("height", "100%");
        svgNode.setAttribute("path", objData.value);
        objData.data = svgNode.outerHTML;
    }
    if (addToDefs && defsParent) {
        this.appenDefs(objData, defsParent);
    }
};

ChartAssetLoader.prototype.replaceImagePathInSvgString = function (data, value) {
    let arrMatch = data?.match(/href=(["'])(.*?)\1/g);
    if (arrMatch && arrMatch.length > 0) {
        let mainPath = value.substring(0, value.lastIndexOf("/")) + "/";
        arrMatch.reduce((acc, element) => {
            let skipReplace = acc.includes(element) || element?.includes("#");
            if (!skipReplace) {
                let imagePath = element?.replace("href=", "")?.replaceAll('"', "");
                data = data.replaceAll(imagePath, mainPath + imagePath);
            }
            acc.push(element);
            return acc;
        }, []);
    }
    return data;
};

ChartAssetLoader.prototype.oneTimeDownload = function (objData, addToDefs = false, defsParent = null, isAsync = true) {
    return new Promise((resolve, reject) => {
        if (addToDefs && defsParent) {
            let defs = this.getDocumentDefs(defsParent);
            let updateDiagram = this.getAssertFromDefs(objData.id, objData.value, defs);
            if (updateDiagram) {
                //objData.data = updateDiagram.outerHTML;
                let tempDiv = document.createElement("div");
                tempDiv.innerHTML = updateDiagram.outerHTML;
                objData.data = this.replaceImagePathInSvgString(objData.data, objData.value);
                let svgNode = tempDiv?.firstChild;
                if (svgNode) {
                    svgNode.setAttribute("width", "100%");
                    svgNode.setAttribute("height", "100%");
                    svgNode.setAttribute("path", objData.value);
                    // DiagramNodeUtils.replaceImagePathToNonLinearAssets(svgNode, objData.value); // Remove this for image load opacity conflict.
                    objData.data = svgNode.outerHTML;
                }
                resolve(objData);
            } else {
                this.oneAssetTimeDownload(resolve, objData, addToDefs, defsParent, reject, isAsync);
            }
        } else {
            this.oneAssetTimeDownload(resolve, objData, addToDefs, defsParent, reject);
        }
    });
};

ChartAssetLoader.prototype.loadDiagramAssets = function (diagramParent, arrayAssets, appAssetURL) {
    this.loadAssetCount = 0;
    return new Promise((resolve, reject) => {
        for (let i = 0; i < arrayAssets.length; i++) {
            if (arrayAssets[i] && (arrayAssets[i].type == "icon" || arrayAssets[i].type == "image" || arrayAssets[i].type == "json" || arrayAssets[i].type == "asset")) {
                const strAssetUrl = arrayAssets[i].value;
                let strAssetPrefixURL = appAssetURL;
                strAssetPrefixURL = !!arrayAssets[i].corporateUrl && arrayAssets[i].corporateUrl != "" ? appCorporateURL : strAssetPrefixURL;
                this.downloadDiagramAsset(arrayAssets, strAssetPrefixURL + strAssetUrl, i, resolve, reject, diagramParent);
            } else {
                this.loadAssetCount = this.loadAssetCount + 1;
                if (arrayAssets.length == this.loadAssetCount) resolve();
            }
        }
    });
};

ChartAssetLoader.prototype.downloadDiagramAsset = function (arrayAssets, assetURL, index, resolve, reject, diagramParent) {
    const xhr = new XMLHttpRequest();
    xhr.open("GET", assetURL);
    xhr.onload = (data) => {
        arrayAssets[index].data = data.target.response;
        if (xhr.status == 200) this.appenDefs(arrayAssets[index], diagramParent);
        this.loadAssetCount++;
        if (arrayAssets.length == this.loadAssetCount) resolve();
    };

    xhr.onerror = () => {
        this.loadAssetCount++;
        if (arrayAssets.length == this.loadAssetCount) resolve();
        if (reject) reject(xhr.statusText);
        console.log("File could not be loaded..." + xhr.statusText);
    };

    xhr.send();
};

ChartAssetLoader.prototype.oneTimeSimpleDownload = async function (objData, addToDefs = false, defsParent = null) {
    let defs = this.getDocumentDefs(document.body);
    let updateDiagram = this.getAssertFromDefs(objData.id, objData.value, defs);
    if (updateDiagram || ChartAssetLoader.arrInLoading.includes(this.getIconName(objData))) {
        console.log("Already In Defs or Inloading");
        return Promise.resolve();
    } else {
        return new Promise((resolve, reject) => {
            ChartAssetLoader.arrInLoading.push(this.getIconName(objData));
            const xhr = new XMLHttpRequest();
            xhr.open("GET", objData.value);
            xhr.onload = (data) => {
                if (xhr.status == 200) {
                    objData.data = data.target.response;
                    this.appenDefs(objData, document.body);
                    let index = ChartAssetLoader.arrInLoading.indexOf(this.getIconName(objData));
                    console.log("Loaded" + objData.id);
                    if (index !== -1) {
                        ChartAssetLoader.arrInLoading.splice(index, 1);
                    }
                    resolve();
                } else {
                    let index = ChartAssetLoader.arrInLoading.indexOf(this.getIconName(objData));
                    if (index !== -1) {
                        ChartAssetLoader.arrInLoading.splice(index, 1);
                    }
                    reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
                }
            };
            xhr.onerror = () => {
                let index = ChartAssetLoader.arrInLoading.indexOf(this.getIconName(objData));
                if (index !== -1) {
                    ChartAssetLoader.arrInLoading.splice(index, 1);
                }
                console.log("File could not be loaded..." + xhr.statusText);
                reject(new Error(`Network error: ${xhr.statusText}`));
            };
            xhr.send();
        });
    }
};

//used for zoomdiagram

ChartAssetLoader.prototype.loadAssetGroup = function (diagramParent, arrayAssets, appAssetURL) {
    let arrPromises = arrayAssets.map((asset) => {
        return new Promise((resolve, reject) => {
            const strAssetUrl = asset.value;
            let strAssetPrefixURL = appAssetURL;
            strAssetPrefixURL = !!asset.corporateUrl && asset.corporateUrl != "" ? appCorporateURL : strAssetPrefixURL;
            this.downloadGroupAsset(asset, strAssetPrefixURL + strAssetUrl, resolve, reject, diagramParent);
        });
    });

    return Promise.all(arrPromises);
};

ChartAssetLoader.prototype.downloadGroupAsset = function (asset, assetURL, resolve, reject, diagramParent) {
    const xhr = new XMLHttpRequest();
    xhr.open("GET", assetURL);
    xhr.onload = (data) => {
        asset.data = data.target.response;
        if (xhr.status == 200) this.appenDefs(asset, diagramParent);
        resolve();
    };

    xhr.onerror = () => {
        if (reject) reject(xhr.statusText);
        console.log("File could not be loaded..." + xhr.statusText);
    };
    xhr.send();
};

function ChartHelper() {
    this.SVGUtils = new window["SVGUtils"]();
    // this.ChartDataGenerator = new window["ChartDataGenerator"]();
    this.ChartUtils = new window["ChartUtils"]();
    this.eventManager = new window["ChartEventManager"]();
}
ChartHelper.prototype.createDivElement = function (props) {
    let element = this.SVGUtils.createElement("div");
    this.applyProperties(element, props);
    return element;
};

ChartHelper.prototype.applyProperties = function (element, props) {
    for (var key in props) {
        element[key] = props[key];
    }
};

ChartHelper.prototype.setTextChangeListner = function (element) {
    if (element) {
        element.removeEventListener("focusout", (event) => {
            // CssChartHelper.onFocusoutHandler(element);
            console.log("element.dataset.keyentered");
            this.setTextChangeDetilsOnStore(element);
        });
        element.addEventListener("focusout", (event) => {
            console.log("element.dataset.keyentered");
            this.setTextChangeDetilsOnStore(element, event);
        });
        // Keydown (Enter) uses same flow as focusout to update value
        var classList = element.className && typeof element.className === "string" ? element.className : "";
        var isValueElement = classList.indexOf("prompttext") === -1 && (classList.indexOf("valuetext") !== -1 || classList.indexOf("baselinevalue") !== -1 || classList.indexOf("pvalue") !== -1);
        if (isValueElement) {
            element.addEventListener("keydown", (event) => {
                if (event.keyCode === 13) {
                    event.preventDefault();
                    this.setTextChangeDetilsOnStore(element, event);
                }
            });
        }
    }
};

ChartHelper.prototype.setTextChangeDetilsOnStore = function (element, event) {
    let slideID = element.getAttribute("data-slideid");
    let graphicElement = this.getElementSlide(element, true);
    let elementDiv = graphicElement ? graphicElement.querySelector("#ELEMENT_DIV") : graphicElement;
    let xmlData = elementDiv ? elementDiv.querySelector("desc")?.children[0] : "";
    if (xmlData && element) {
        let objPropData = {
            xmlData: xmlData,
            elementid: element.getAttribute("data-id"),
            elementtype: element.getAttribute("data-type"),
            elementvalue: element.innerHTML,
            slideid: slideID,
            randomId: Math.random().toString(36).substring(2, 15),
            graphicIndex: graphicElement?.getAttribute("data-graphic-index"),
            event: event,
            assetType: "chart",
        };

        // Check if this is a temp slide - if so, skip appStore subscription
        let isTempSlide = window.getIsTempSlide && slideID ? window.getIsTempSlide(slideID) : false;
        if (!isTempSlide) {
            // Use dynamic import to access AppStore without interfering with module system
            this.CssChartTextChangeHandler = new window["ChartTextChangeHandler"]();
            this.CssChartTextChangeHandler.getTextChangeOperationListener();
            let appStore = this.ChartUtils.getAppStore();
            appStore?.setState((prevState) => ({
                ...prevState,
                pendingTextOperation: objPropData,
            }));
        }
    }
};

ChartHelper.prototype.textChangeObserver = function (element) {
    let maxFontSize = element.getAttribute("maxFontSize");
    maxFontSize = parseInt(maxFontSize ? maxFontSize : 36);
    this.adjustFontSize(element, 10, maxFontSize - ChartFonts.minFontSize, maxFontSize);
    this.textPositionChangeObserver(element);
};
ChartHelper.prototype.onKeyDownHandler = function (element) {
    if (event.keyCode == 13) {
        event.preventDefault();
        const type = element.getAttribute("data-type");
        switch (type) {
            case "value":
            case "legendvalue":
                this.ChartDataGenerator.assignValueData(element);
                break;
            default:
        }
    }
};

ChartHelper.prototype.onFocusoutHandler = function (element) {
    const type = element.getAttribute("data-type");
    const slideID = this.getElementSlide(element).getAttribute("id"); //element.getAttribute("data-slideid");
    const slide = this.getElementSlide(element); //document.getElementById(slideID);

    // if (slideID && slide) {
    //     let grid = slide ? slide.getElementsByClassName("grid") : "";
    //     if (!!grid[0]) {
    //         grid[0].style.opacity = 0;
    //         let removeListner = grid[0].getElementsByClassName("removelistner");
    //         for (let i1 = 0; i1 < removeListner.length; i1++) {
    //             removeListner[i1].setAttribute("data-listner", "false");
    //         }
    //     }
    // }

    switch (type) {
        case "label":
        case "legendlabel":
        case "comparisonlabel":
        case "placeholdertext":
        case "comparelabel":
            element.parentElement.scrollTop = 0;
            this.ChartDataGenerator.assignLabelData(element, type);
            break;
        case "multilegendlabel":
            element.parentElement.scrollTop = 0;
            this.ChartDataGenerator.assignLegendLabelData(element);
            break;
        case "value":
        case "legendvalue":
        case "promt":
            if (element.dataset.enabled != "true") {
                this.ChartDataGenerator.assignValueData(element);
            }
            break;
        case "axistitle":
            element.scrollLeft = 0;
            this.ChartDataGenerator.assignAxisTitleData(element);
            break;
        case "baselinecallout":
            this.ChartDataGenerator.assignBaseLineData(element);
            break;
        case "basevalue":
            this.ChartDataGenerator.assignBaseLinevalueData(element);
            break;
        case "baseleftvalue":
            this.ChartDataGenerator.assignBaseLineLeftvalueData(element);
            break;
        case "secondarylabel":
            this.ChartDataGenerator.assignSecondaryData(element);

        default:
    }
};

ChartHelper.prototype.getElementSlide = function (element, returnorginal = true) {
    if (!element) {
        return null;
    } else if (element?.getAttribute("class")?.includes("ci-layout-container")) {
        if (returnorginal) {
            return element;
        } else {
            return element.parentElement;
        }
    } else {
        return this.getElementSlide(element.parentElement, returnorginal);
    }
    return null;
};
ChartHelper.prototype.getElementDiv = function (element) {
    if (element.getAttribute("id") == "ELEMENT_DIV") {
        return element;
    } else {
        return this.getElementDiv(element.parentElement);
    }
};
ChartHelper.prototype.textPositionChangeObserver = function (element, label = false) {
    let type = element.getAttribute("data-type");

    let graphicDiv = this.getElementSlide(element, true);

    if (graphicDiv) {
        let grid = graphicDiv ? graphicDiv.getElementsByClassName("grid") : "";
        type = type == "comparisonlabel" ? "label" : type;
        switch (type) {
            case "label":
            case "legendlabel":
            case "secondarylabel":
            case "placeholdertext":
            case "comparelabel":
                let elementDiv = graphicDiv.querySelectorAll("#ELEMENT_DIV");
                let CurrentDiv = elementDiv.length > 1 ? elementDiv[elementDiv.length - 1] : elementDiv.length > 0 ? elementDiv[0] : graphicDiv;
                const arrLabel = CurrentDiv.getElementsByClassName(type);
                const textAlign = arrLabel.length > 0 ? arrLabel[0].getAttribute("data-textalign") : "";
                const length = arrLabel.length;
                if (!!grid[0]) {
                    grid[0].style.opacity = 0;
                    let removeListner = grid[0].getElementsByClassName("removelistner");
                    for (let i1 = 0; i1 < removeListner.length; i1++) {
                        removeListner[i1].setAttribute("data-listner", "false");
                    }
                    if (length) {
                        if (textAlign == "vertical") {
                            this.alignVerticalLabel(arrLabel, label);
                        } else if (textAlign == "horizantal") {
                            this.alignHorizantalLabel(arrLabel, label);
                        }
                    }
                } else {
                    if (length > 0) {
                        if (textAlign == "vertical") {
                            this.alignVerticalLabel(arrLabel, label);
                        } else if (textAlign == "horizantal") {
                            this.alignHorizantalLabel(arrLabel, label);
                        }
                    }
                }

                break;
            case "value":
            case "legendvalue":
            case "promt":
                let secondarySlide = this.getElementDiv(element);
                const arrValue = secondarySlide.getElementsByClassName(type);
                const Vlength = arrValue.length;
                if (Vlength) this.assignFontSizeValue(arrValue);
                if (type == "legendvalue") this.alignHorizantalLabel(arrValue);
                break;
            case "axistitle":
                break;
            default:
        }
    } else {
        console.log("sucess");
    }
};

ChartHelper.prototype.alignVerticalLabel = function (arrLabel) {
    let minHeight = 0;
    const length = arrLabel.length;
    let maxHeight = parseInt(window.getComputedStyle(arrLabel[0])["maxHeight"]);
    let fontSize = 0;
    for (let i3 = 0; i3 < length; i3++) {
        let childMaxHeight = parseInt(window.getComputedStyle(arrLabel[i3])["maxHeight"]);
        maxHeight = maxHeight < childMaxHeight ? childMaxHeight : maxHeight;
    }
    for (let i1 = 0; i1 < length; i1++) {
        let childHeight = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["height"]);
        minHeight = minHeight < childHeight ? childHeight : minHeight;
        let childFontSize = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let height = maxHeight < minHeight ? maxHeight : minHeight;
        arrLabel[i2].style.minHeight = height + "px";
        arrLabel[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

ChartHelper.prototype.alignHorizantalLabel = function (arrLabel, label = false) {
    let minWidth = 0;
    let fontSize = 0;
    const length = arrLabel.length;
    const maxWidth = parseInt(window.getComputedStyle(arrLabel[0])["maxWidth"]);
    for (let i1 = 0; i1 < length; i1++) {
        arrLabel[i1].style.minWidth = 10 + "px"; //ranjith
        let childWidth = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["width"]);
        //let childWidth = parseInt(window.getComputedStyle(arrLabel[i1])["width"]);
        minWidth = minWidth < childWidth ? childWidth : minWidth;
        let childFontSize = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let width = maxWidth < minWidth ? maxWidth : minWidth;
        // arrLabel[i2].style.width = "auto";
        width = width < 139 && label ? 139 : width;
        arrLabel[i2].style.minWidth = width + 1 + "px";
        if (arrLabel[i2].dataset.headerWidthTitle && arrLabel[i2].dataset.headerWidthTitle > width) {
            arrLabel[i2].style.minWidth = arrLabel[i2].dataset.headerWidthTitle + "px";
        }
        arrLabel[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

ChartHelper.prototype.assignFontSizeValue = function (arrValue) {
    let minWidth = 0;
    let fontSize = 0;
    const length = arrValue.length;
    const maxWidth = parseInt(window.getComputedStyle(arrValue[0])["maxWidth"]);
    for (let i1 = 0; i1 < length; i1++) {
        let childWidth = parseInt(window.getComputedStyle(arrValue[i1].childNodes[0])["width"]);
        minWidth = minWidth < childWidth ? childWidth : minWidth;
        let childFontSize = parseInt(window.getComputedStyle(arrValue[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let width = maxWidth < minWidth ? maxWidth : minWidth;
        if (arrValue[i2].dataset.hasstatistical != "true") arrValue[i2].style.minWidth = width + 1 + "px";
        arrValue[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

ChartHelper.prototype.getValueBounds = function (argProps) {
    let result = { maxheight: 30 };
    return result;
};

ChartHelper.prototype.getPixelValueFromPercentage = function (strInput, numDefaultValue) {
    return numDefaultValue;
};

ChartHelper.prototype.adjustFontSize = function (nodeTextElement, numMaxH, intMinFontSize, intMaxFontSize, barValue = false) {
    if (nodeTextElement) {
        let boolContinueEdit = true;
        const cssValue = window.getComputedStyle(nodeTextElement);
        let intFontSize = this.getPixelValueFromPercentage(cssValue["font-size"], intMaxFontSize);
        let numScrollH = nodeTextElement.scrollHeight;
        let numClientH = nodeTextElement.clientHeight;
        let sizeDifference = barValue ? 5 : 0;
        if (numScrollH < 1 && numClientH < 1) {
            nodeTextElement.style.setProperty("font-size", 23 + "px", "");
            return false;
        }
        if (numClientH === numScrollH && numClientH) {
            while (numScrollH <= numClientH) {
                intFontSize += 1;
                if (intFontSize > intMaxFontSize) {
                    boolContinueEdit = false;
                    break;
                }
                nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
                numScrollH = nodeTextElement.scrollHeight;
                numClientH = nodeTextElement.clientHeight;
            }
        }

        if (numClientH + sizeDifference < numScrollH) {
            while (numScrollH > numClientH) {
                intFontSize -= 1;
                if (intFontSize < intMinFontSize) {
                    boolContinueEdit = false;
                    break;
                }
                nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
                numScrollH = nodeTextElement.scrollHeight;
                numClientH = nodeTextElement.clientHeight;
            }
        }
        return boolContinueEdit;
    }
    return true;
};

ChartHelper.prototype.adjustFontSizeWidth = function (nodeTextElement, numMaxW, intMinFontSize, intMaxFontSize) {
    if (nodeTextElement) {
        let boolContinueEdit = true;
        nodeTextElement.style.width = "100%";
        const cssValue = window.getComputedStyle(nodeTextElement);
        let intFontSize = cssValue["font-size"].split("px")[0]; //this.getPixelValueFromPercentage(cssValue["font-size"], intMaxFontSize);
        let numScrollW = nodeTextElement.scrollWidth;
        let numClientW = nodeTextElement.clientWidth;
        if (numScrollW < 1 && numClientW < 1) {
            nodeTextElement.style.setProperty("font-size", 23 + "px", "");
            return false;
        }
        while (numScrollW > numClientW && intFontSize > intMinFontSize) {
            intFontSize = parseFloat(intFontSize) - 1;
            nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
            numScrollW = nodeTextElement.scrollWidth;
        }
        return false;
    }
    return true;
};

ChartHelper.prototype.getMaxValue = function (argDataMax, argCustomMax, boolClose = false) {
    let value = argDataMax;
    if (!isNaN(argCustomMax)) if (argDataMax < argCustomMax) return argCustomMax;
    let length = 0 < value && value < 1 ? 0 : String(value).split(".")[0].length;
    if (argDataMax == 0) {
        value = argDataMax;
    } else if (argDataMax < 10) {
        value = argDataMax + 1;
    } else {
        if (0 < length) value = this.getValueTens(argDataMax, length, argCustomMax, boolClose);
        else if (length == 0) value = 1;
    }
    return value;
};

ChartHelper.prototype.getValueTens = function (argDataMax, length, maxValue, closeValue = false) {
    let intTens;
    let intvalue;
    let originalValue;
    if (length > 1) intTens = 10;
    else if (length > 2) intTens = 100;
    else if (length > 3) intTens = 1000;
    else if (length > 4) intTens = 10000;
    else if (length > 5) intTens = 100000;
    else if (length > 6) intTens = 1000000;
    else if (length > 7) intTens = 10000000;
    else if (length > 8) intTens = 100000000;
    else if (length > 9) intTens = 1000000000;
    const value = (argDataMax / intTens).toString();
    const tensValue_1 = parseInt(value.split(".")[0]);
    const tensValue_2 = parseInt(value.split(".")[1]);
    const originaltens = intTens * tensValue_1;
    let paddingValue = 0;
    // if (argDataMax >= 100) intvalue = tensValue_2 >= 5 ? 25 : 20;
    // else intvalue = tensValue_2 >= 5 || argDataMax >= 25 ? 10 : 5;
    //return originaltens + intvalue;
    if (argDataMax >= 100) {
        if (tensValue_2 >= 5) {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        } else {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        }
    } else {
        if (tensValue_2 >= 5 || argDataMax >= 25) {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        } else {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        }
    }
    originalValue = originaltens + intvalue;
    originalValue = this.gridValueValidation(originalValue, maxValue, paddingValue);
    return originalValue;
};

ChartHelper.prototype.gridValueValidation = function (value, maxValue, paddingValue) {
    let boolGridCount = false;
    let dummyValue;
    let gridCount = 4;
    for (let i1 = gridCount; i1 <= 10; i1++) {
        dummyValue = value / i1;
        if (dummyValue % 5 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        } else if (dummyValue % 10 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        }
    }
    dummyValue = value / 5;
    if (dummyValue % 5 == 0) {
        gridCount = 5;
        boolGridCount = true;
    }
    if (!boolGridCount) {
        this.getMaxValue(value, maxValue, true);
        return value + paddingValue;
    }
    return value;
};

ChartHelper.prototype.parseBoolen = function (value) {
    switch (value) {
        case "true":
        case true:
            return true;
        default:
            return false;
    }
};

ChartHelper.prototype.getMenuDetail = function (menuName) {
    this.menuData = window.menuJSON;
    let intLength = this.menuData.categories.length;
    for (let i = 0; i < intLength; i++) {
        let category = this.menuData.categories[i];
        for (let j = 0; j < category.menu.length; j++) {
            let menu = category.menu[j];
            for (let k = 0; k < menu.variations.length; k++) {
                let variations = menu.variations[k];
                for (let l = 0; l < variations.style.length; l++) {
                    let style = variations.style[l];
                    if (style.name == menuName) {
                        return JSON.parse(JSON.stringify(style));
                    } else if (style.shapes) {
                        for (let m = 0; m < style.shapes.length; m++) {
                            let shape = style.shapes[m];
                            if (shape.name == menuName) {
                                return JSON.parse(JSON.stringify(shape));
                            }
                        }
                    }
                }
            }
        }
    }
};

ChartHelper.prototype.getChartOldMenuDetail = function (menuName, count) {
    this.menuData = window.menuJSON;
    let intLength = this.menuData.categories.length;
    for (let i = 0; i < intLength; i++) {
        let category = this.menuData.categories[i];
        for (let j = 0; j < category.menu.length; j++) {
            let menu = category.menu[j];
            for (let k = 0; k < menu.variations.length; k++) {
                let variations = menu.variations[k];
                for (let l = 0; l < variations.style.length; l++) {
                    let style = variations.style[l];
                    if (style.classname == menuName) {
                        if (style?.template?.nodecount && style?.template?.nodecount?.min <= count && count <= style?.template?.nodecount?.max) {
                            return JSON.parse(JSON.stringify(style));
                        }
                    } else if (style.shapes) {
                        for (let m = 0; m < style.shapes.length; m++) {
                            let shape = style.shapes[m];
                            if (shape.classname == menuName) {
                                if (shape?.template?.nodecount && shape?.template?.nodecount?.min <= count && count <= shape?.template?.nodecount?.max) {
                                    return JSON.parse(JSON.stringify(shape));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
};
ChartHelper.prototype.getLayout = function (objectDetails, strItemName, strclassName, xmlData, boolmutiseries = false, multicolumn = false, menuDetails = null) {
    // let chartListData = ChartHelper.getChartListDataByName(strItemName);
    let graphicName = xmlData.getAttribute("graphicname");
    let className = xmlData.getAttribute("name");
    let childLength = xmlData.children.length;
    let jsonChartItemMetaData = menuDetails ? menuDetails : this.getMenuDetail(graphicName);
    if (!jsonChartItemMetaData) {
        jsonChartItemMetaData = this.getChartOldMenuDetail(className, childLength);
        if (!jsonChartItemMetaData) {
            graphicName = this.getOldMenu(graphicName);
            jsonChartItemMetaData = this.getMenuDetail(graphicName);
        }
    }
    let layoutData = jsonChartItemMetaData?.template?.chartlayout;
    let secondaryLayout = {};
    if (layoutData && !boolmutiseries) {
        return layoutData;
    } else {
        if (boolmutiseries) {
            if (multicolumn) {
                secondaryLayout = getChartMultiLayout("", false, true);
            } else {
                secondaryLayout = getChartMultiLayout("", true, false);
            }
            return secondaryLayout;
        }
    }
};
ChartHelper.prototype.getChartMultiLayout = function (moodName = "elegant", barchart = false, columnChart = false) {
    let jsonValues = {
        elegant: {
            barchart: {
                chartlayout: {
                    label: { position: ["left", "middle"], padding: [0, 20, 0, 0] },
                    value: { position: ["right", "middle"], padding: [0, 0, 0, 20], fontsize: "38", color: "multiple" },
                    placeholder: {
                        position: ["left", "middle"],
                        padding: [0, 20, 0, 0],
                        shape: {
                            type: "circle",
                            style: "border",
                            bordercolor: "gradient",
                            fillcolor: "secondary",
                        },
                    },
                    common: { nodesize: "160px", gap: "16px", vPosition: "middle" },
                },
            },
            columnchart: {
                chartlayout: {
                    label: { position: ["center", "bottom"], padding: [20, 0, 0, 0] },
                    value: { position: ["center", "top"], padding: [0, 0, 20, 0] },
                    placeholder: {
                        position: ["center", "bottom"],
                        padding: [20, 0, 0, 0],
                        shape: {
                            type: "circle",
                            style: "border",
                            bordercolor: "theme",
                            fillcolor: "bgcolor",
                        },
                    },
                    common: { nodesize: "160px", gap: "16px", hPosition: "center" },
                },
            },
        },
    };
    let layout = "";
    if (barchart) {
        layout = jsonValues[moodName].barchart;
    } else {
        layout = jsonValues[moodName].columnchart;
    }
    return layout.chartlayout;
};

