ChartTextChangeHandler.prototype.assignTotalValuePromptLabelData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    if (labelText && labelText.includes("<div>")) labelText = TextHighLightUtils.highlightToString(element.innerHTML);
    let index = parseFloat(element?.getAttribute("data-index") || 0) || 0;
    let slideID = this.getSlideId(element);
    let oldLabel = xmlData?.children[index]?.getAttribute("totalvalueprompt");
    if (oldLabel != labelText) {
        element.innerHTML = oldLabel;
        xmlData?.children[index]?.setAttribute("totalvalueprompt", labelText);

        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.assignpromptLabelData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    if (labelText && labelText.includes("<div>")) labelText = TextHighLightUtils.highlightToString(element.innerHTML);
    if (labelText && labelText.includes("\n")) labelText = labelText.replaceAll("\n", "<br>");
    let index = element.getAttribute("data-index") ? element.getAttribute("data-index").split("_") : ["0", "0"];
    let seriesIndex = index[0];
    let seriesItemIndex = index[1];
    let slideID = this.getSlideId(element);
    this.promptText = xmlData.children[seriesIndex].getAttribute("prompttext").split(",");
    this.newText = labelText;
    element.innerHTML = this.promptText[seriesItemIndex];
    this.promptText[seriesItemIndex] = this.newText;
    this.newText = "";
    this.newText = this.promptText.join(",");
    xmlData.children[seriesIndex].setAttribute("prompttext", this.newText);
    // Get divParent from element context
    let divParent = this.getElementSlide(element, true);

    // Get stored data from data store
    // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
    let chartId = divParent?.getAttribute("data-chart-id");
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

    // Use stored data if available, otherwise use null
    let finalMenuData = storedMenuData || null;

    this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
};
ChartTextChangeHandler.prototype.assignIndualHdLabelData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    if (labelText && labelText.includes("<div>")) labelText = TextHighLightUtils.highlightToString(element.innerHTML);
    if (labelText && labelText.includes("\n")) labelText = labelText.replaceAll("\n", "<br>");
    let index = element.getAttribute("data-index") ? element.getAttribute("data-index").split("_") : ["0", "0"];
    let seriesIndex = index[0];
    let seriesItemIndex = index[1];
    let slideID = this.getSlideId(element);

    let indualHighlight = xmlData.getAttribute("data-indualhighlight") ? xmlData.getAttribute("data-indualhighlight") == "true" : false;
    indualHighlight = xmlData.getAttribute("indualhd") && xmlData.getAttribute("indualhd") == "true" ? true : indualHighlight;
    if (!indualHighlight) {
        this.promptText = xmlData.getAttribute("hdcustomtext").split(",");
        this.newText = labelText;
        element.innerText = this.promptText[seriesIndex];
        this.promptText[seriesIndex] = this.newText;
        this.newText = "";
        this.newText = this.promptText.join(",");
        xmlData.setAttribute("hdcustomtext", this.newText);
    } else {
        this.promptText = xmlData.children[seriesIndex].getAttribute("hdcustomtext").split(",");
        this.newText = labelText;
        element.innerText = this.promptText[seriesItemIndex];
        this.promptText[seriesItemIndex] = this.newText;
        this.newText = "";
        this.newText = this.promptText.join(",");
        xmlData.children[seriesIndex].setAttribute("hdcustomtext", this.newText);
    }

    // Get divParent from element context
    let divParent = this.getElementSlide(element, true);

    // Get stored data from data store
    // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
    let chartId = divParent?.getAttribute("data-chart-id");
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

    // Use stored data if available, otherwise use null
    let finalMenuData = storedMenuData || null;

    this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
};
ChartTextChangeHandler.prototype.assignSecondaryData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = this.getSlideId(element);
    let oldLabel = xmlData.children[index].getAttribute("secondaryName");
    let oldIndexHtml = xmlData.children[index].getAttribute("innerHtml");
    if (oldIndexHtml != element.innerHTML || oldLabel != labelText) {
        element.innerHTML = oldIndexHtml;
        xmlData.children[index].setAttribute("secondaryName", labelText);

        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.assignValueData = function (element, callback = null, xmlData, hasRedraw = true) {
    this.chartUtils = new ChartUtils();
    let valueText = element.innerText.replace(/\s/g, "");
    let mainText = element.querySelector(".clSpanMainText")?.textContent;
    if (mainText) element.querySelector(".clSpanMainText").textContent = mainText.replace(/\s/g, "");
    element.innerHTML = element.innerHTML;
    let graphicDiv = this.getElementSlide(element, true);
    let slideID = this.getSlideId(element);
    let displayFormat = xmlData.getAttribute("valueformat") ? xmlData.getAttribute("valueformat") : "asentered";
    valueText = displayFormat == "currency" ? valueText.replaceAll("$", "") : valueText;
    let tempValue = valueText.includes(",") ? valueText.replace(/,/g, "") : valueText;
    let arrInputValue = [
        {
            input: tempValue.toString(),
        },
    ];
    arrInputValue[0] = this.chartUtils.formatChartValues(arrInputValue[0]);
    let boolsum = !arrInputValue.validData && element.hasAttribute("sumvalue") && valueText.toLowerCase() == "sum" ? true : false;
    let indexId = element.getAttribute("data-id");
    let groupIndex = parseInt(indexId.split("_")[0]);
    let index = parseInt(indexId.split("_")[1]);
    let oldElement = graphicDiv.cloneNode("true");
    let arrValue = xmlData.children[groupIndex].getAttribute("value").split(",");
    let arrAsEnteredValue = xmlData.children[groupIndex].getAttribute("asenteredvalue")?.split("^");
    let arrPrefix = xmlData.children[groupIndex].getAttribute("prefix");
    let arrSuffix = xmlData.children[groupIndex].getAttribute("suffix");
    let arrdenomination = xmlData.children[groupIndex].getAttribute("denomination");
    let arrcurrencySymbol = xmlData.children[groupIndex].getAttribute("currencysymbol")
        ? xmlData.children[groupIndex].getAttribute("currencysymbol").split(",").length > 1
            ? xmlData.children[groupIndex].getAttribute("currencysymbol").split(",")[1]
            : xmlData.children[groupIndex].getAttribute("currencysymbol").split(",")[0]
        : "";
    let chartName = xmlData.getAttribute("name");
    let value;
    let asEnterdValue;
    let prefix;
    let suffix;
    let denomination;
    let currencysymbol;
    let oldValue = xmlData.children[groupIndex].getAttribute("value").split(",")[index];
    let oldSuffix = xmlData.children[groupIndex].getAttribute("suffix") == "," || xmlData.children[groupIndex].getAttribute("suffix") == ",," || xmlData.children[groupIndex].getAttribute("suffix") == ",,," ? "" : xmlData.children[groupIndex].getAttribute("suffix").split(",")[index];
    oldSuffix = chartName == "fillcompareChart" && oldSuffix == "" ? "%" : oldSuffix;
    if (oldElement) {
        let oldValueElement = oldElement.querySelector("#value-text-" + indexId);
        if (oldValueElement && oldValueElement.children[0] && oldValueElement.children[0].getAttribute("data-oldinnertext")) {
            if (oldValueElement && oldValueElement.children.length > 0) oldValueElement.children[0].innerHTML = oldValueElement.children[0].getAttribute("data-oldinnertext");
        } else {
            if (oldValueElement && oldValueElement.children.length > 0) oldValueElement.children[0].innerText = arrcurrencySymbol + oldValue + oldSuffix;
        }
    }
    let hasChangeValue = displayFormat == "currency" ? arrcurrencySymbol + oldValue + oldSuffix != valueText.replaceAll(",", "") : arrcurrencySymbol + oldValue + oldSuffix != valueText;
    if (displayFormat != "asentered" && displayFormat != "percentage" && arrInputValue[0].currencySystem) {
        hasChangeValue = arrcurrencySymbol + oldValue + arrInputValue[0].currencySystem + oldSuffix != valueText.replaceAll(",", "");
    }
    let oldDataValue = xmlData.children[groupIndex].getAttribute("asenteredvalue");
    if (hasChangeValue && displayFormat == "asentered" && oldDataValue == valueText) {
        hasChangeValue = false;
    }
    if (hasChangeValue) {
        element.setAttribute("data-enabled", "true");
        for (let i1 = 0; i1 < arrValue.length; i1++) {
            if (i1 == index) {
                if (i1 == 0) {
                    asEnterdValue = valueText;
                    value = boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0; // valueText;
                    prefix = arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix;
                    suffix = arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix;
                    denomination = arrInputValue[0].currencySystem == undefined ? "" : arrInputValue[0].currencySystem;
                    currencysymbol = arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol;
                } else {
                    asEnterdValue += "^" + valueText;
                    value += "," + (boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0); // valueText;
                    prefix += "," + (arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix);
                    suffix += "," + (arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix);
                    denomination += "," + (arrInputValue[0].denomination == undefined ? "" : arrInputValue[0].denomination);
                    currencysymbol += "," + (arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol);
                }
            } else {
                if (i1 == 0) {
                    asEnterdValue = arrAsEnteredValue[i1];
                    value = arrValue[i1];
                    prefix = arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "";
                    suffix = arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "";
                    denomination = arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "";
                    currencysymbol = arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "";
                } else {
                    asEnterdValue += "^" + arrAsEnteredValue[i1];
                    value += "," + arrValue[i1];
                    prefix += "," + (arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "");
                    suffix += "," + (arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "");
                    denomination += "," + (arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "");
                    currencysymbol += "," + (arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "");
                }
            }
            value = value == undefined ? "" : value;
            prefix = prefix == undefined ? "" : prefix;
            suffix = suffix == undefined ? "" : suffix;
            denomination = denomination == undefined ? "" : denomination;
            currencysymbol = currencysymbol == undefined ? "" : currencysymbol;
        }
        // suffix = booldefaultPercentage && suffix == "%" ? "" : suffix;
        if (value && value.length > 10 && value.split(",").length == 1) {
            value = value.substr(0, 10);
        }
        this.changeAseneterFormat(displayFormat, asEnterdValue, xmlData, groupIndex);
        xmlData.children[groupIndex].setAttribute("value", value);
        xmlData.children[groupIndex].setAttribute("prefix", prefix);
        xmlData.children[groupIndex].setAttribute("suffix", suffix);
        xmlData.children[groupIndex].setAttribute("denomination", denomination);
        xmlData.children[groupIndex].setAttribute("currencysymbol", currencysymbol);
        if (hasRedraw) {
            // Get divParent from element context
            let divParent = this.getElementSlide(element, true);

            // Get stored data from data store
            // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
            let chartId = divParent?.getAttribute("data-chart-id");
            let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
            let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

            // Use stored data if available, otherwise use null
            let finalMenuData = storedMenuData || null;

            this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
        }
    }
};
ChartTextChangeHandler.prototype.assignStackedWidthValue = function (numberValueText, objDetails) {
    let valueText = numberValueText.replace(/\s/g, "");
    let slideID = this.getSlideId();
    const slide = document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    xmlData = this.getXmlData(slide, xmlData);
};

ChartTextChangeHandler.prototype.assignValueWithoutElementData = function (numberValueText, objDetails, xmlData, graphicDiv) {
    let valueText = numberValueText.replace(/\s/g, "");
    let displayFormat = xmlData.getAttribute("valueformat") ? xmlData.getAttribute("valueformat") : "asentered";
    valueText = displayFormat == "currency" ? valueText.replaceAll("$", "") : valueText;
    let tempValue = valueText.includes(",") ? valueText.replace(/,/g, "") : valueText;
    let arrInputValue = [
        {
            input: tempValue.toString(),
        },
    ];
    arrInputValue = [this.ChartUtils.formatChartValues(arrInputValue[0])];
    let boolsum = !arrInputValue[0].validData && valueText.toLowerCase() == "sum" ? true : false;
    let indexId = objDetails.id;
    let groupIndex = parseInt(indexId.split("_")[0]);
    let index = parseInt(indexId.split("_")[1]);
    let arrValue = xmlData.children[groupIndex].getAttribute("value").split(",");
    let arrAsEnteredValue = xmlData.children[groupIndex].getAttribute("asenteredvalue")?.split("^");
    let arrPrefix = xmlData.children[groupIndex].getAttribute("prefix");
    let arrSuffix = xmlData.children[groupIndex].getAttribute("suffix");
    let arrdenomination = xmlData.children[groupIndex].getAttribute("denomination");
    let arrcurrencySymbol = xmlData.children[groupIndex].getAttribute("currencysymbol")
        ? xmlData.children[groupIndex].getAttribute("currencysymbol").split(",").length > 1
            ? xmlData.children[groupIndex].getAttribute("currencysymbol").split(",")[1]
            : xmlData.children[groupIndex].getAttribute("currencysymbol").split(",")[0]
        : "";
    let chartName = xmlData.getAttribute("name");
    let value;
    let asEnterdValue;
    let prefix;
    let suffix;
    let denomination;
    let currencysymbol;
    let oldValue = xmlData.children[groupIndex].getAttribute("value").split(",")[index];
    let oldSuffix = xmlData.children[groupIndex].getAttribute("suffix") == "," || xmlData.children[groupIndex].getAttribute("suffix") == ",," || xmlData.children[groupIndex].getAttribute("suffix") == ",,," ? "" : xmlData.children[groupIndex].getAttribute("suffix").split(",")[index];
    oldSuffix = chartName == "fillcompareChart" && oldSuffix == "" ? "%" : oldSuffix;
    let oldValueElement = graphicDiv.querySelector("#value-text-" + indexId);
    if (oldValueElement && oldValueElement.children[0] && oldValueElement.children[0].getAttribute("data-oldinnertext")) {
        if (oldValueElement && oldValueElement.children.length > 0) oldValueElement.children[0].innerHTML = oldValueElement.children[0].getAttribute("data-oldinnertext");
    } else {
        if (oldValueElement && oldValueElement.children.length > 0) oldValueElement.children[0].innerText = arrcurrencySymbol + oldValue + oldSuffix;
    }

    let hasChangeValue = displayFormat == "currency" ? arrcurrencySymbol + oldValue + oldSuffix != valueText.replaceAll(",", "") : arrcurrencySymbol + oldValue + oldSuffix != valueText;
    if (displayFormat != "asentered" && displayFormat != "percentage" && arrInputValue[0].currencySystem) {
        hasChangeValue = arrcurrencySymbol + oldValue + arrInputValue[0].currencySystem + oldSuffix != valueText.replaceAll(",", "");
    }
    let oldDataValue = xmlData.children[groupIndex].getAttribute("asenteredvalue");
    if (hasChangeValue && displayFormat == "asentered" && oldDataValue == valueText) {
        hasChangeValue = false;
    }
    if (hasChangeValue) {
        for (let i1 = 0; i1 < arrValue.length; i1++) {
            if (i1 == index) {
                if (i1 == 0) {
                    asEnterdValue = valueText;
                    value = boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0; // valueText;
                    prefix = arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix;
                    suffix = arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix;
                    denomination = arrInputValue[0].currencySystem == undefined ? "" : arrInputValue[0].currencySystem;
                    currencysymbol = arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol;
                } else {
                    asEnterdValue += "^" + valueText;
                    value += "," + (boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0); // valueText;
                    prefix += "," + (arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix);
                    suffix += "," + (arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix);
                    denomination += "," + (arrInputValue[0].denomination == undefined ? "" : arrInputValue[0].denomination);
                    currencysymbol += "," + (arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol);
                }
            } else {
                if (i1 == 0) {
                    asEnterdValue = arrAsEnteredValue[i1];
                    value = arrValue[i1];
                    prefix = arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "";
                    suffix = arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "";
                    denomination = arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "";
                    currencysymbol = arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "";
                } else {
                    asEnterdValue += "^" + arrAsEnteredValue[i1];
                    value += "," + arrValue[i1];
                    prefix += "," + (arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "");
                    suffix += "," + (arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "");
                    denomination += "," + (arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "");
                    currencysymbol += "," + (arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "");
                }
            }
            value = value == undefined ? "" : value;
            prefix = prefix == undefined ? "" : prefix;
            suffix = suffix == undefined ? "" : suffix;
            denomination = denomination == undefined ? "" : denomination;
            currencysymbol = currencysymbol == undefined ? "" : currencysymbol;
        }
        // suffix = booldefaultPercentage && suffix == "%" ? "" : suffix;
        if (value && value.length > 10 && value.split(",").length == 1) {
            value = value.substr(0, 10);
        }
        this.changeAseneterFormat(displayFormat, asEnterdValue, xmlData, groupIndex);
        xmlData.children[groupIndex].setAttribute("value", value);
        xmlData.children[groupIndex].setAttribute("prefix", prefix);
        xmlData.children[groupIndex].setAttribute("suffix", suffix);
        xmlData.children[groupIndex].setAttribute("denomination", denomination);
        xmlData.children[groupIndex].setAttribute("currencysymbol", currencysymbol);
    }
};
ChartTextChangeHandler.prototype.changeAseneterFormat = function (displayFormat, valueText, xmlData, groupIndex) {
    let oldDataValue = xmlData.children[groupIndex].getAttribute("asenteredvalue");
    if (displayFormat == "asentered") {
        xmlData.children[groupIndex].setAttribute("asenteredvalue", valueText);
    } else if (oldDataValue) {
        if (displayFormat != "percentage") {
            xmlData.children[groupIndex].setAttribute("asenteredvalue", valueText);
        }
    }
};
ChartTextChangeHandler.prototype.assignAxisTitleData = function (element, callback = null, xmlData) {
    let oldLabel = "";
    let axisTitleText = element.innerText;
    let indexId = element.getAttribute("data-id");
    let slideID = this.getSlideId(element);
    if (indexId == "xAxis") {
        oldLabel = xmlData.getAttribute("xaxistitle");
        element.innerText = oldLabel;
    } else if (indexId == "yAxis") {
        oldLabel = xmlData.getAttribute("yaxistitle");
        element.innerText = oldLabel;
    }
    if (indexId == "xAxis") xmlData.setAttribute("xaxistitle", axisTitleText);
    else if (indexId == "yAxis") xmlData.setAttribute("yaxistitle", axisTitleText);
    if (oldLabel != axisTitleText) {
        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.asseignHeaderTitle = function (element, callback = null, xmlData) {
    let oldLabel = "";
    let axisTitleText = element.innerText;
    let indexId = element.getAttribute("data-id");
    let slideID = this.getSlideId(element);
    if (indexId == "label-header") oldLabel = xmlData.getAttribute("labelheader");
    else if (indexId == "secondary-Header") oldLabel = xmlData.getAttribute("secondaryheader");
    else if (indexId == "item-Header") oldLabel = xmlData.getAttribute("itemheader");
    else if (indexId == "value-Header") oldLabel = xmlData.getAttribute("valueheader");
    if (oldLabel != axisTitleText) element.innerText = oldLabel;
    if (indexId == "label-header") xmlData.setAttribute("labelheader", axisTitleText);
    else if (indexId == "secondary-Header") xmlData.setAttribute("secondaryheader", axisTitleText);
    else if (indexId == "item-Header") xmlData.setAttribute("itemheader", axisTitleText);
    else if (indexId == "value-Header") xmlData.setAttribute("valueheader", axisTitleText);

    if (oldLabel != axisTitleText) {
        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};

ChartTextChangeHandler.prototype.assignBaseLineData = function (element, callback = null, xmlData) {
    let baselineTitleText = element.innerText;
    let baselineId = element.getAttribute("data-id");
    let index = parseInt(baselineId.split("_")[1]);
    let slideID = this.getSlideId(element);
    let arrBaseLineText = [];
    let oldLabel = baselineId.includes("left") ? xmlData.getAttribute("baseline_left_text") : xmlData.getAttribute("baseline_bottom_text");
    if (oldLabel != baselineTitleText) element.innerText = oldLabel;
    arrBaseLineText = baselineId.includes("left") ? xmlData.getAttribute("baseline_left_text").split(",") : xmlData.getAttribute("baseline_bottom_text").split(",");
    baselineTitleText = !baselineTitleText ? "Enter text" : baselineTitleText;
    arrBaseLineText.splice(index, 1, baselineTitleText);
    if (baselineId.includes("left")) xmlData.setAttribute("baseline_left_text", arrBaseLineText.toString());
    else xmlData.setAttribute("baseline_bottom_text", arrBaseLineText.toString());
    if (oldLabel != baselineTitleText) {
        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.assignBaseLinevalueData = function (element, callback = null, xmlData) {
    let baselinevaleText = parseFloat(element.innerText);
    let slideID = this.getSlideId(element);
    let oldValue = xmlData.getAttribute("baseline_bottom_value");
    if (oldValue != baselinevaleText) {
        baselinevaleText = Math.abs(parseFloat(element.innerText));
        element.innerText = oldValue;
        xmlData.setAttribute("baseline_bottom_value", baselinevaleText.toString());

        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.assignProjectionHeadingLabelData = function (element, callback = null, xmlData) {
    let projectionvaleText = element.innerHTML;
    let isProjectionDisabled = element.getAttribute("data-projectiondisabletext") == "true";
    let slideID = this.getSlideId(element);
    let oldValue = xmlData.getAttribute("projectionheadingtext");
    if (isProjectionDisabled) {
        oldValue = xmlData.getAttribute("projectiondisabledheadingtext");
    }
    if (oldValue != projectionvaleText) {
        element.innerHTML = oldValue;
        if (projectionvaleText == "<br>") {
            if (isProjectionDisabled) {
                xmlData.setAttribute("projectiondisabledheadingtext", "");
            } else {
                xmlData.setAttribute("projectionheadingtext", "");
            }
        } else {
            if (isProjectionDisabled) {
                xmlData.setAttribute("projectiondisabledheadingtext", projectionvaleText.toString());
            } else {
                xmlData.setAttribute("projectionheadingtext", projectionvaleText.toString());
            }
        }

        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
