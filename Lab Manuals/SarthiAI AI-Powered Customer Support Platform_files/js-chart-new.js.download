                let pathLength;
                let linePathLength = "";
                pathLength = dummeyPath.getTotalLength();
                if (this.bgFill) linePathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.data.slideObj);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
