ChartUtils.prototype.loadAssets = function (objPropData, slideElement, elementID, strGraphicTemplateJson, strSlideID, xmldata, isUndoableOp, callback, slideobjContant, boolLoadAsset = true, backXml = null) {
    let objChartAssetLoader = new AssetsLoader();
    let builderChart = new ChartBuilder();
    builderChart.getAssets(objPropData, xmldata);
    objChartAssetLoader.loadAssets(objPropData.assets).then(() => {
        ManifestHelper.getInstance().updateDocumentDefs(objPropData.assets, strSlideID, elementID);
        let chartDiv = builderChart.buildAsset(objPropData);
        if (chartDiv != null) {
            this.SvgUtils.assignAttributes(chartDiv, {
                "data-element-id": elementID,
                "data-json-graphic-template-details": strGraphicTemplateJson,
                xmldata: backXml,
            });
            if (backXml) {
                this.SvgUtils.assignAttributes(chartDiv, {
                    xmldata: backXml,
                });
            }
            if (objPropData.columnIndex != undefined && objPropData.columnIndex)
                this.SvgUtils.assignAttributes(chartDiv, {
                    "data-columnindex": objPropData.columnIndex,
                });
            if (objPropData.rowIndex != undefined && objPropData.rowIndex)
                this.SvgUtils.assignAttributes(chartDiv, {
                    "data-rowindex": objPropData.rowIndex,
                });
        }

        if (chartDiv != null) {
            if (!!xmldata) {
                // OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "csschart", isUndoableOp);
                let cloneNode = chartDiv.cloneNode(true);
                chartDiv.parentNode.removeChild(chartDiv);
                callback(cloneNode);
            } else {
                OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "chart", isUndoableOp);
                return;
            }
        }
    });
};

ChartUtils.prototype.addDummySvg = function (dummyNode, slideObject) {
    let slideContent = slideObject;
    let root = slideContent?.querySelector?.(".ci-layout-container");
    if (!root && slideContent?.getAttribute("class")?.includes("ci-layout-container")) {
        root = slideContent;
    }
    let svgNode = this.SvgUtils.createEmptySvgNode();
    svgNode.id = "dummysvg";
    root.appendChild(svgNode);
    svgNode.appendChild(dummyNode);
};

ChartUtils.prototype.updateFloaterProperties = function (event) {
    let CSSFloaterUpdates = new CssFloaterUpdates();
    let appStore = this.getAppStore();
    let unsubscribeFloater = appStore.subscribe(
        (state) => {
            return state.updatechartfloaterdata;
        },
        (updatechartfloaterdata) => {
            let AppStore = this.getAppStore();
            let floaterProperties = CSSFloaterUpdates.getFloaterProperties(updatechartfloaterdata?.target, updatechartfloaterdata?.event);
            let uiTarget = updatechartfloaterdata?.target;
            if (uiTarget && uiTarget.id == "ELEMENT_DIV") {
                let objFloaterProps = { deletegraphicasset: this.FloaterPropertyObjects.deletegraphicasset };
                objFloaterProps["showbasefloater"] = true;
                let objectData = {
                    selectorTarget: uiTarget,
                    type: "UPDATE_FLOATER_PROPERTY",
                    dpfloater: objFloaterProps,
                    targetsid: [
                        {
                            id: uiTarget?.id,
                            edit: true,
                        },
                    ],
                    customprops: {
                        targetID: uiTarget?.id,
                        assettype: uiTarget.getAttribute("data-id") ? "chart" : "chart",
                        graphicId: uiTarget?.parentNode?.getAttribute("id"),
                        customprops: {
                            graphicId: uiTarget?.parentNode?.getAttribute("id"),
                        },
                        graphicIndex: uiTarget?.parentNode?.getAttribute("data-graphic-index"),
                    },
                };
                AppStore.setState((prevState) => ({
                    ...prevState,
                    ui: {
                        inlineFloaterConfig: objectData,
                    },
                }));
            } else {
                if (floaterProperties.dpfloater) {
                    let objectData = {
                        selectorTarget: updatechartfloaterdata?.target,
                        type: "UPDATE_FLOATER_PROPERTY",
                        dpfloater: floaterProperties.dpfloater,
                        targetsid: [
                            {
                                id: floaterProperties.id,
                                edit: true,
                            },
                        ],
                        customprops: {
                            targetID: floaterProperties.id,
                            assettype: updatechartfloaterdata?.target?.getAttribute("data-id") ? "chart" : "chart",
                            customprops: floaterProperties.customprops,
                            graphicIndex: floaterProperties?.customprops?.graphicIndex || updatechartfloaterdata?.target?.parentNode?.getAttribute("data-graphic-index"),
                        },
                    };
                    AppStore.setState((prevState) => ({
                        ...prevState,
                        ui: {
                            inlineFloaterConfig: objectData,
                        },
                    }));

                    // if (elTarget.getAttribute("data-id")) uiSlideEditor.hideSelectionLayer();
                } else {
                    let objectData = {
                        selectorTarget: event.target,
                        type: "UPDATE_FLOATER_PROPERTY",
                        dpfloater: floaterProperties.dpfloater,
                        targetsid: [
                            {
                                id: floaterProperties.id,
                                edit: true,
                            },
                        ],
                        customprops: {
                            targetID: floaterProperties.id,
                            assettype: elTarget?.getAttribute("data-id") ? "chart" : "chart",
                            customprops: floaterProperties.customprops,
                        },
                    };
                }
            }
        },
    );

    // Add subscription to centralized manager
    if (window.addSubscription) {
        window.addSubscription(unsubscribeFloater);
    }
    // let floaterProperties = CSSFloaterUpdates.getFloaterProperties(event.target, event);
};

