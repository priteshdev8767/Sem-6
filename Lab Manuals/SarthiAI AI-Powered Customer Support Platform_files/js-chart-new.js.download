BaseTableSeriesItem.prototype.updateBasicData=function() {


}

BaseTableSeriesItem.prototype.doAddGraphicElement=function() {
    let tableColumnElement = document.createElement("td");
    this.parent.appendChild(tableColumnElement);
    let tableContentNode = document.createElement("div");
    tableColumnElement.appendChild(tableContentNode)
    let textElementValues = this.data.arrTableContent[this.groupindex][this.index];
    tableContentNode.setAttribute("data-id", textElementValues.indexvalue);
    tableContentNode.setAttribute("data-slideid", this.data.slideID);
    if(textElementValues&&textElementValues.elementtype=="label"){
        tableContentNode.innerText = textElementValues.value;
        tableContentNode.className ="p6 tablelabeltext"
        // tableContentNode.setAttribute("contenteditable", "true");
        tableContentNode.setAttribute("data-prompt-text","Enter label");
        this.ChartUtils.enableTextHeighlight(tableContentNode, this.data);
    }else{
        // tableContentNode.setAttribute("contenteditable", "true");
        tableContentNode.innerText = textElementValues.value
    }
    switch(textElementValues.elementtype){
        case "value":
            tableContentNode.id = "valuetext-" +textElementValues.indexvalue;
            // tableContentNode.setAttribute("data-type", "value");
        break;
        case "label":
            tableContentNode.id = "labeltext-" +textElementValues.indexvalue;
            // tableContentNode.setAttribute("data-type", "label");
        break;
    }
    // this.ChartHelper.setTextChangeListner(tableContentNode);
}

function SimpleTable(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleTable";
    BaseTable.call(this, argparent, argprops);
}
SimpleTable.prototype = Object.create(BaseTable.prototype);
SimpleTable.prototype.constructor = SimpleTable;

SimpleTable.prototype.seriesInstance=function(argparent, argprops) 
{
        return new window["SimpleTableSeries"](argparent, argprops);
}



function SimpleTableSeries(argparent, argprops){
    this.name = "SimpleTableSeries";
    BaseTableSeries.call(this, argparent, argprops);
}
SimpleTableSeries.prototype = Object.create(BaseTableSeries.prototype);
SimpleTableSeries.prototype.constructor = SimpleTableSeries;

SimpleTableSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new SimpleTableSeriesItem(argparent, argprops);
}

function SimpleTableSeriesItem(argparent, argprops){
    this.name = "SimpleTableSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseTableSeriesItem.call(this, argparent, argprops);
}
SimpleTableSeriesItem.prototype = Object.create(BaseTableSeriesItem.prototype);
SimpleTableSeriesItem.prototype.constructor = SimpleTableSeriesItem;


function SingleFillChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SingleFillChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SingleFillChart.prototype = Object.create(BaseColumnChart.prototype);
SingleFillChart.prototype.constructor = SingleFillChart;

SingleFillChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SingleFillSeries"](argparent, argprops);
};
SingleFillChart.prototype.CreateHightlightDifference = function () {
    return null;
};

function SingleFillSeries(argparent, argprops) {
    this.name = "SingleFillSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SingleFillSeries.prototype = Object.create(BaseColumnSeries.prototype);
SingleFillSeries.prototype.constructor = SingleFillSeries;
SingleFillSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    if (this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased != "true") {
        element.style.flexDirection = "column";
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    element.style.width = this.state.width + "px";
    element.classList.add("th-section" + customColorIndex);

    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }

    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops, true);
    }
    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond fillLevelFinder" + " item" + this.graphicElement.hposition;
    subelement.style.width = 100 + "%";
    subelement.style.position = "relative";
    subelement.style.alignItems = "center";
    subelement.style.order = 2;

    if ((this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased != "true") || (this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased == "true" && !this.data.layout.haddivider)) {
        subelement.style.justifyContent = "center";
        subelement.style.order = 0;
    } else {
        subelement.style.justifyContent = "unset";
    }

    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && this.index == 0) subelement.classList.add("alterstyle");

    for (let i1 = 0; i1 < 1; i1++) {
        // if(this.index==0){
        //     subelement.classList.add("flexdirrevers")
        // }else{
        //     subelement.classList.add("flexdirforward")
        // }
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

SingleFillSeries.prototype.updateBasicData = function () {
    BaseColumnSeries.prototype.updateBasicData.call(this);
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.7;
};

SingleFillSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SingleFillSeriesItem"](argparent, argprops);
};

function SingleFillSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.iconRow = 10;
    this.iconColumn = 10;
    this.valueMaxW = 0;
    this.labelMaxW = 0;
    this.labeMaxH = 0;
    this.valueMaxH = 0;
    this.dummeylabelMaxW = 230;
    this.styleShape = null;
    this.graphicH = 0;
    this.intStartAngle = 138;
    this.intMaxvalue = 100;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
    this.boolDisableWidth = true;
    this.ChartFonts = new window["ChartFonts"]();
    this.maxLabelFontSize = this.ChartFonts.maxValueFontSize;
}
SingleFillSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SingleFillSeriesItem.prototype.constructor = SingleFillSeriesItem;

SingleFillSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.data.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.5;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.valueMaxH = this.state.height * 0.5; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.valueAlignment.itemBased == "true") this.valueMaxW = this.state.width * 0.4;
    if (this.labelAlignment.itemBased == "true") this.labelMaxW = this.state.width * 0.5;
};

SingleFillSeriesItem.prototype.doAddGraphicElement = function () {
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

SingleFillSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
    }
};

SingleFillSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    this.styleShape = this.data.layout.waffleShape ? this.data.layout.waffleShape : "rect";
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    let svg = "";
    if (this.data.asset.data[this.index].data) {
        svg = this.data.asset.data[this.index].data;
    } else {
        svg = this.data.slideObj.querySelector("#graphicsvg-" + this.groupindex + "_" + this.index)?.cloneNode(true);
    }
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.dummeylabelMaxW * 0.5 : this.dummeylabelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }

    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    let styleIndex = 1 < this.data.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "contrast-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.justifyContent = "center ";
    subelement.style.alignItems = "center ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic transformOrginBottom moodanimation";
    graphicElement.setAttribute("data-animation", "baseitem");
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 90 + "%";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "flex-end";
    graphicElement.style.position = "relative";
    graphicElement.style.justifyContent = "center";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);

    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        if ((this.data.layout.itemgap > 1 && this.data.layout.itemgap < this.state.width * 0.5 && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased) {
            sameElement.style.width = this.state.width - this.data.layout.itemgap + "px";
            this.labelMaxW = this.state.width - this.data.layout.itemgap;
        }
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;

            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops, "", true);
            else this.doAddTopValue(sameElement, argprops, "", true);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }
    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops, "", true);
            else this.doAddTopValue(element, argprops, "", true);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops, "", true);
        }
    }
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? subelement.clientWidth * 0.5 : subelement.clientWidth;
    let graphicHeight = subelement.clientHeight;
    let iconVerSize = graphicWidth / this.iconColumn;
    let iconHorSize = graphicHeight / this.iconRow;
    this.iconsize = iconVerSize < iconHorSize ? iconVerSize : iconHorSize;
    this.createGraphicSVG(graphicElement, argprops, null, null, index, middleelementValue, element);
    graphicElement.style.width = "auto";
};

SingleFillSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    // if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
    //     if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
    //         if (this.groupindex == 0) {
    //             element.style.marginLeft = "auto";
    //         } else {
    //             element.style.marginRight = "auto";
    //         }
    //     }
    // }
    if (this.boolDisableWidth) {
        element.style.width = "";
    } else {
        element.style.width = this.valueMaxW + "px";
    }
    // if (this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
    //     if (this.groupindex == 0) {
    //         element.style.marginLeft = "auto";
    //     } else {
    //         element.style.marginRight = "auto";
    //     }
    // }
    if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
        this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex); //"accent" + (this.groupindex + 1) + "-color";
    }
    this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " n1";
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.setAttribute("data-customsmovey", 444.3 + "px");
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.data._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (boolenablePer && this.data.displayValueFormat != "number") {
        // subelement.innerText = parseFloat(argprops.valuetext)>100?"100%":parseFloat(argprops.valuetext) + "%";
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "theme" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", this.graphicH);
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
    }

    subelement.dataset.animation = "svgrectitemvalue";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgstyle == "style6") {
            element.classList.add("moodanimation");
            element.dataset.animation = "bgsecondarytext";
        }
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(this.index));
            }
        }
    }
    // if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction" && !this.data.disableEdit) {
    //     subelement.setAttribute("contenteditable", "true");
    //     subelement.setAttribute("data-dck-selector", "true");
    // }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsContrastTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.maxValueFontSize[this.arrIndex] == "null") {
        let maxFontSize = parseFloat(this.ChartFonts.maxLabelFontSize(subelement));
        this.maxValueFontSize[this.arrIndex] = maxFontSize;
    }
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.ChartUtils.updateValueTextProperties(subelement, this.data);
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = subelement.dataset.customvaluetextlineheight || "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        fontsize = window.getComputedStyle(subelement)["font-size"];
        if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
            element.style.display = "none";
        }
    }
    if (!boolmax) {
        subelement.style.overflow = "hidden";
    }
};

SingleFillSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index, middleelementValue, element) {
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "svgElement-" + this.groupindex + "_" + this.index,
        class: "gauge",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-startangle": -this.intStartAngle,
    });
    argparent.appendChild(svgElement);
    let svg = "";
    if (this.data.asset.data[this.index].data) {
        svg = this.data.asset.data[this.index].data;
    } else {
        svg = this.data.slideObj.querySelector("#graphicsvg-" + this.groupindex + "_" + this.index)?.cloneNode(true);
    }

    this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    let numValue = parseFloat(this.data.values[this.groupindex][this.index]);
    svgElement.appendChild(svg);
    svg.setAttribute("id", "graphicsvg-" + this.groupindex + "_" + this.index);
    let assetBounds = svgElement.children[0].getBBox();
    let baseAssetsBounds = svgElement.getBBox();
    let yValue = baseAssetsBounds.height > assetBounds.height ? baseAssetsBounds.height - assetBounds.height : 0;
    yValue = yValue - yValue * 0.5;
    let graphicRectangle = svg.querySelector("#fillrect");
    let circleValue = svg.querySelector("#fillvalue");
    let rectHeight = graphicRectangle.getAttribute("height");
    let rectY = 0;
    if (this.data.asset.data[this.index].data) {
        rectY = graphicRectangle.getAttribute("y");
        graphicRectangle.setAttribute("oldyvalue", rectY);
        rectHeight = graphicRectangle.getAttribute("height");
        graphicRectangle.setAttribute("oldheight", rectHeight);
    } else {
        rectY = graphicRectangle.getAttribute("oldyvalue");
        rectHeight = graphicRectangle.getAttribute("oldheight");
    }
    let minHeight = 0;
    let graphicMaxHeight = parseFloat(rectHeight) - parseFloat(minHeight);
    let actualGraphicHeight = (numValue / 100) * graphicMaxHeight;
    graphicRectangle.setAttribute("height", actualGraphicHeight + minHeight);
    graphicRectangle.setAttribute("data-customstartheight", minHeight + "px");
    graphicRectangle.setAttribute("data-customheight", actualGraphicHeight + minHeight + "px");
    graphicRectangle.setAttribute("data-animation", "svgrectitem");
    graphicRectangle.setAttribute("class", "moodanimation");
    graphicRectangle.setAttribute("data-customsmovey", 444.3 + "px");
    graphicRectangle.setAttribute("data-customstartscaley", 1);
    graphicRectangle.setAttribute("y", parseFloat(rectY) + (graphicMaxHeight - actualGraphicHeight));
    let circleYPosition = parseFloat(rectY) + (graphicMaxHeight - actualGraphicHeight);
    circleYPosition = parseFloat(circleValue.getAttribute("r")) > circleYPosition ? parseFloat(circleValue.getAttribute("r")) + 2 : circleYPosition;
    circleValue.setAttribute("cy", circleYPosition);
    circleValue.setAttribute("data-animation", "valuebgelement");
    circleValue.setAttribute("data-customsmovey", 444.3 + "px");
    circleValue.setAttribute("class", "moodanimation");
    let bounds = circleValue.getBBox();
    let slideElement = this.data.currentElementDiv;
    let slideScale = DiagramUtils.calcSlideScale(slideElement, "");
    let boundinRects = DiagramUtils.getAbsCoordOfElement(circleValue, argparent, slideScale);
    let clipPathElement = svg.getElementsByTagName("clipPath");
    let oldClipPathid = clipPathElement[0].getAttribute("id");
    let randamValue = Math.random() + "clippath";
    clipPathElement[0].setAttribute("id", randamValue);
    clipPathElement[0].setAttribute("data-maskelement", true);

    let changeTargetElement = svg.querySelector("g[clip-path]");
    changeTargetElement.setAttribute("clip-path", "url(#" + randamValue + ")");
    changeTargetElement.setAttribute("data-mask", "true");
    changeTargetElement.setAttribute("data-boolclippath", "true");
    if (this.valueAlignment.position == "middle") {
        this.middleVW = boundinRects.width;
        this.middleVH = boundinRects.height;
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + this.groupindex + "_" + this.index;
        middleelementValue.className = "middleelement";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        argparent.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
        middleelementValue.style.setProperty("top", boundinRects.y + "px", "");
        middleelementValue.style.setProperty("margin-left", "48px", "");
    }
};

function SimpleDumbbellChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleDumbbellChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleDumbbellChart.prototype = Object.create(BaseBarChart.prototype);
SimpleDumbbellChart.prototype.constructor = SimpleDumbbellChart;
// SimpleDumbbellChart.prototype.doAddGridDesk = function () {
//     return null;
// };
SimpleDumbbellChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleDumbbellSeries"](argparent, argprops);
};

function SimpleDumbbellSeries(argparent, argprops) {
    this.name = "SimpleDumbbellSeries";
    BaseBarSeries.call(this, argparent, argprops);
}
SimpleDumbbellSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleDumbbellSeries.prototype.constructor = SimpleDumbbellSeries;

SimpleDumbbellSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleDumbbellSeriesItem"](argparent, argprops);
};
SimpleDumbbellSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.enableHeader && (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) && this.index == this.data.seriesLength) {
        let element = document.createElement("div");
        element.id = "header-" + this.index;
        element.className = "header overflow ";
        // element.style.height = this.data._headerHeight + "px";
        element.style.maxWidth = "100%";
        // element.dataset.animation = "nodeitem";

        element.style.maxHeight = this.data._headerHeight + "px";
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        let seiesElement = this.parent.querySelector(".series");
        let labelHeader = document.createElement("div");
        let serieslabel = seiesElement.querySelector(".label");
        if (this.data.layout.labelHeaderTitle) {
            labelHeader.innerText = this.data.labelHeader;
            labelHeader.setAttribute("contenteditable", "true");
            labelHeader.setAttribute("data-prompt-text", "Enter Title");
        }
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.style.width = serieslabel ? serieslabel.clientWidth + "px" : "0%";
        labelHeader.style.order = this.labelAlignment.index;
        labelHeader.className = "labelheader labelheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        labelHeader.setAttribute("maxFontSize", 30);
        labelHeader.setAttribute("data-id", "label-header");
        labelHeader.setAttribute("data-slideid", this.data.slideID);
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.setAttribute("data-type", "labelheader");
        if (this.data._labelHeaderColor) {
            labelHeader.style.setProperty("color", this.data._labelHeaderColor, "important");
        }
        // labelHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(labelHeader);
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position == "outer") {
            element.appendChild(labelHeader);
        }
        if (this.data.layout.bgTabel) {
            labelHeader.classList.add("enabletable");
        }
        let secondaryHeader = document.createElement("div");
        let secondarylabelElement = seiesElement.querySelector(".secondaryElement");
        secondaryHeader.className = "secondaryheader secondaryheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        if (this.data.layout.placeholderheder) {
            secondaryHeader.innerText = this.data.secondaryHeader;
            secondaryHeader.setAttribute("contenteditable", "true");
            secondaryHeader.setAttribute("data-dck-selector", "true");
            secondaryHeader.setAttribute("data-prompt-text", "Enter Title");
        }
        secondaryHeader.style.order = this.alignment.index;
        secondaryHeader.setAttribute("maxFontSize", 30);
        secondaryHeader.setAttribute("data-id", "secondary-Header");
        secondaryHeader.setAttribute("data-slideid", this.data.slideID);
        secondaryHeader.setAttribute("data-type", "secondaryheader");
        if (this.data._secondaryHeaderColor) {
            secondaryHeader.style.setProperty("color", this.data._secondaryHeaderColor, "important");
        }
        if (this.data.layout.placeholderHeaderHPosition) secondaryHeader.classList.add("header" + this.data.layout.placeholderHeaderHPosition);
        // secondaryHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(secondaryHeader);
        if (this.data.layout.bgTabel) {
            secondaryHeader.classList.add("enabletable");
        }
        secondaryHeader.style.width = secondarylabelElement ? secondarylabelElement.clientWidth + "px" : "0%";
        if (this.alignment.itemBased != "true" && this.alignment.position == "outer" && this.data.layout) {
            element.appendChild(secondaryHeader);
        }

        let seriesItemHeader = document.createElement("div");
        let secondarylabel = seiesElement.querySelector(".seriesitemcond");
        seriesItemHeader.className = "secondaryitemheader itemheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        seriesItemHeader.style.order = this.data.layout.itemPosIndex;
        if (this.data.layout.itemHeader) {
            seriesItemHeader.innerText = this.data.itemHeader;
            seriesItemHeader.setAttribute("data-prompt-text", "Enter Title");
            seriesItemHeader.setAttribute("contenteditable", "true");
            seriesItemHeader.setAttribute("data-dck-selector", "true");
        }
        seriesItemHeader.style.width = secondarylabel ? secondarylabel.clientWidth + "px" : "0%";
        seriesItemHeader.setAttribute("maxFontSize", 30);
        seriesItemHeader.setAttribute("data-id", "item-Header");
        seriesItemHeader.setAttribute("data-slideid", this.data.slideID);
        seriesItemHeader.setAttribute("data-type", "itemheader");
        if (this.data._itemHeaderTextColor) {
            seriesItemHeader.style.setProperty("color", this.data._itemHeaderTextColor, "important");
        }
        if (this.data.layout.itemHeaderHPosition) seriesItemHeader.classList.add("header" + this.data.layout.itemHeaderHPosition);
        // seriesItemHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(seriesItemHeader);
        element.appendChild(seriesItemHeader);
        if (this.data.layout.bgTabel) {
            seriesItemHeader.classList.add("enabletable");
        }
        // if (this.parent) this.parent.appendChild(element);
        this.parent.insertBefore(element, this.parent.firstChild);
    } else {
        let parentLevelNumberingClass = "";
        let customColorIndex = this.ChartFonts.customColor(this.index);
        if (this.data.layout.sequenceGrandparentcls && this.data.sequencenumber) {
            parentLevelNumberingClass = this.data.layout.sequenceGrandparentcls;
        }
        let moveY = this.viewport.y;
        let element = document.createElement("div");
        element.id = "series-" + this.index;
        element.dataset.dckSelector = true;
        element.className = "series overflow accent" + customColorIndex + " clsMultiColorParent " + parentLevelNumberingClass;
        element.style.height = this.state.height + "px";
        element.style.position = "relative";
        element.dataset.index = this.index;
        element.style.maxWidth = "100%";
        // element.dataset.animation = "nodeitem"
        element.style.maxHeight = this.state.height + "px";
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
        if (this.data._seriesItemLength == 1) {
            element.classList.add("th-section" + customColorIndex);
        } else {
            element.className = "series overflow accent" + customColorIndex + " clsMultiColorParent " + parentLevelNumberingClass;
            element.classList.add("th-section" + customColorIndex);
        }
        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        element.classList.add("seriesnodeelements");
        if (this.parent) this.parent.appendChild(element);

        if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
            element.classList.add("cs-chart-emphasis-disabled");
            element.dataset.emphasis = "false";
        }
        if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
            element.classList.add("cs-chart-emphasis-enabled");
            element.dataset.emphasis = "true";
        }
        if (this.data.projection[this.index] == true && this.data.hasProjection) {
            element.classList.add("cs-chart-projection-enabled");
            element.classList.add("projectionEnableGraphic");
            element.dataset.projection = "true";
        }
        if (this.data.projection[this.index] != true && this.data.hasProjection) {
            element.classList.add("cs-chart-projection-disabled");
            element.classList.add("projectionDisabledGraphic");
            element.dataset.projection = "false";
        }

        // if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
        //     element.classList.add("emphasis");
        // }
        if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "alphaprojection") {
            element.classList.add("emphasis");
        }

        // if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") {
        //     element.classList.add("emphasis");
        // }
        let sameElement = document.createElement("div");
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.justifyContent = "center";
        sameElement.style.alignItems = "center";
        if (this.data.layout.secondarySamePosition) {
            element.appendChild(sameElement);
        }

        if (this.labelAlignment.show && this.labelAlignment.position == "outer" && this.labelAlignment.hposition == "left" && this.labelAlignment.itemBased != "true") {
            this.addlabel = true;
            labelMaxH = element.clientHeight / 2;
            if (this.data.layout.secondarySamePosition) {
                this.doAddLabel(sameElement, argprops, true);
                this.doAddLabel(sameElement, argprops, false, true);
            } else {
                if (this.data.layout.secondaryPosition) {
                    labelMaxH = element.clientHeight;
                    this.doAddLabel(element, argprops, true);
                    // this.s(element, argprops, false);
                } else {
                    labelMaxH = element.clientHeight;
                    this.doAddLabel(element, argprops, true);
                    this.doAddLabel(element, argprops, false);
                }
            }
        }
        if (this.data.secondaryLabel) {
            if (this.data.layout.secondarySamePosition) {
                this.doAddSecondaryLabelNode(sameElement, argprops, true);
                this.doAddSecondaryLabelNode(sameElement, argprops, false, true);
            } else {
                if (this.data.layout.secondaryPosition) {
                    this.doAddSecondaryLabelNode(element, argprops, true);
                    this.doAddSecondaryLabelNode(element, argprops, false);
                } else {
                    this.doAddSecondaryLabelNode(element, argprops, true);
                    this.doAddSecondaryLabelNode(element, argprops, false);
                }
            }
        }

        if (this.data.sequencenumber) {
            this.alignment = this.secondarySequenceAlignment;
            this.sequenceNumberMaxWidth = this.state.width * 0.1;
            this.doSecondaryLabel(element, argprops, true, true, true);
            this.doSecondaryLabel(element, argprops, false, true, true);
        }
        if (this.valueAlignment.position == "outer" && this.valueAlignment.hposition == "left" && this.valueAlignment.itemBased != "true") {
            this.addvalue = true;
            this.doAddValueElement(element, argprops);
        }
        if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.itemBased != "true") {
            this.addplaceholder = true;
            const eprops = {
                index: this.index,
                length: this.length,
                placeholdertype: this.data.primaryPlaceholderType[this.index],
                placeholder: this.data.placeholder,
                placeholderpath: this.data.placeholderpath,
            };
            this.doAddPrimaryPlaceholder(element, eprops);
        }
        if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

        let subelement = document.createElement("div");
        subelement.id = "seriesitemcond-" + this.index;
        subelement.className = "seriesitemcond overflow";
        subelement.style.order = this.data.layout.itemPosIndex;
        subelement.style.position = "relative";
        if (this.data.layout.multiSeriesItemSize) {
            let heightValue = parseFloat(this.data.layout.multiSeriesItemSize) * this.data.seriesItemLength;
            let gapValue = this.data.layout.multiseriesGapValue * (this.data.seriesItemLength - 1);
            let totalHeight = heightValue + gapValue;
            if (totalHeight > element.clientHeight) {
                totalHeight = element.clientHeight;
            }
            subelement.style.height = totalHeight + "px";
            subelement.setAttribute("data-height", totalHeight);
        } else {
            subelement.style.height = this.gapPercentage * 100 + "%";
        }
        // subelement.style.width = this.rectSeriesItem.width + "px";
        if (element) element.appendChild(subelement);
        if (this.data.layout.bgTabel) {
            subelement.style.height = 100 + "%";
            subelement.classList.add("enabletable");
        }
        let stackElement;
        let numWidth = 0;
        let stackedHighlightDifferenceWidth = 0;

        let baseGraphicElements = stackElement || subelement;
        let totalValueElement = stackElement?.parentNode || subelement;
        if (this.data.showTotalValue && totalValueElement && baseGraphicElements) {
            let defaultPaddingClass = this.data.chartFlip ? "clsPaddingRight16" : "clsPaddingRight16-Alter";
            this.data.layout.totalValuePaddingClass = this.data.layout.totalValuePaddingClass ? this.data.layout.totalValuePaddingClass : defaultPaddingClass;
            this.totalValueStyle = this.getColorDetails(this.groupindex, this.ChartFonts.valueOuterColor, this.data.layout.totalValueColor, "color");
            if (this.totalValueAlignment.itemBased == "true") {
                // if (this.totalValueAlignment.hposition == "right") {
                //     totalValueElement.style.flexDirection = "row-reverse";
                // } else {
                //     totalValueElement.style.flexDirection = "row";
                // }
                this.totalValueHeight = totalValueElement.clientHeight * 0.5;
                this.totalValueWidth = totalValueElement.clientWidth;
                let itemBasedTotalValueElement = document.createElement("div");
                const vLayoutName = this.totalValuelayoutClassName("containertotalvalue", true);
                this.data.SVGUtils.assignAttributes(itemBasedTotalValueElement, {
                    class: "itembasedtotalvalue " + vLayoutName,
                });
                itemBasedTotalValueElement.style.height = baseGraphicElements.clientHeight + "px";
                totalValueElement.style.alignItems = "flex-end";
                baseGraphicElements.style.width = "50%";
                totalValueElement.appendChild(itemBasedTotalValueElement);
                this.createTotalValueContainer(itemBasedTotalValueElement, true);
                this.data.totalValueBounds = { width: 0, height: 0 };
                this.createTotalValueContainer(itemBasedTotalValueElement, false);
            } else if (this.totalValueAlignment.position == "outer" && this.totalValueAlignment.itemBased != "true" && this.totalValueAlignment.inset != "bgoutside") {
                this.totalValueHeight = totalValueElement.clientHeight;
                this.totalValueWidth = totalValueElement.clientWidth * 0.2;
                if (this.totalValueAlignment.hposition == "right") {
                    totalValueElement.style.display = "flex";
                    totalValueElement.style.flexDirection = "row";
                    if (this.data.chartFlip) {
                        totalValueElement.style.flexDirection = "row-reverse";
                        totalValueElement.style.justifyContent = "end";
                    }
                    if (stackElement) {
                        stackElement.style.width = "unset";
                    }
                    this.createTotalValueContainer(totalValueElement, true);
                    this.createTotalValueContainer(totalValueElement, false);
                    if (stackElement) {
                        let maxBaseWidth = this.rectSeriesItem.width - this.longTotalvalueWidth - stackedHighlightDifferenceWidth - (this.data.extraElementBounds?.width || 0);
                        let numCalculatedWidth = maxBaseWidth * numWidth;
                        stackElement.style.width = this.data.SVGUtils.createPercentValue(this.rectSeriesItem.width, numCalculatedWidth);
                    }
                } else {
                    this.createTotalValueContainer(element, true);
                    this.rectSeriesItem.width -= this.longTotalvalueWidth + (this.data.extraElementBounds?.width || 0);
                    this.data.totalValueBounds = { width: 0, height: 0 };
                    this.createTotalValueContainer(element, false);
                }
            }
        } else if (stackedHighlightDifferenceWidth > 0 || this.data.extraElementBounds?.width > 0) {
            let heightValue = stackedHighlightDifferenceWidth + (this.data.extraElementBounds?.width || 0);
            let parentHeightValue = numWidth * 100;
            let intParentHeight = parseFloat(parentHeightValue || 100);
            let calcualtedHeight = (intParentHeight / 100) * heightValue;
            let strCalcValue = "calc(" + parentHeightValue + "% - " + calcualtedHeight + "px)";
            if (this.data.stackedChart) stackElement.style.width = strCalcValue;
        }

        for (let i1 = 0; i1 < 1; i1++) {
            let eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
            let itemElement = subelement;
            let seriesItem = this.seriesItemInstance(itemElement, eProps);
            seriesItem.ChartHelper = this.ChartHelper;
            seriesItem.ChartUtils = this.ChartUtils;
            seriesItem.move(this.rectSeriesItem.x, moveY);
            seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
            seriesItem.data = this.data;
            this.items[i1] = seriesItem;
            moveY += this.rectSeriesItem.height;
        }
    }
};

//import BaseBarSeriesItem from "../../base/baseChartBar/BaseBarSeriesItem.js";
function SimpleDumbbellSeriesItem(argparent, argprops) {
    this.name = "SimpleDumbbellSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseBarSeriesItem.call(this, argparent, argprops);
}
SimpleDumbbellSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
SimpleDumbbellSeriesItem.prototype.constructor = SimpleDumbbellSeriesItem;

SimpleDumbbellSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let highlightPoint = "";
    highlightPoint = false;
    let highlightDifferenceHeight = 0;
    let extraElementWidth = 0;
    if (this.data.extraElementBounds?.width) {
        extraElementWidth = this.data.extraElementBounds?.width;
    }
    this.data.hdHeight = highlightDifferenceHeight;
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    let graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.className = "graphic-container";
    graphicElement.style.position = "relative";
    graphicElement.style.height = "100%";
    graphicElement.style.width = "100%";
    element.appendChild(graphicElement);
    if (argparent) argparent.appendChild(element);
    else return element;
    this.valueMaxW = element?.clientWidth * 0.2;
    this.valueMaxH = this.state.height;

    this.doAddRightValue(element, argprops, true);
    this.doAddRightValue(element, argprops, false);

    argprops["index"] = 1;
    argprops["value"] = this.data.values[this.groupindex][1];
    argprops["valuetext"] = this.data.prefix[this.groupindex][1] + this.data.valuesDenomination[this.groupindex][1] + this.data.suffix[this.groupindex][1];
    this.doAddRightValue(element, argprops, false);
    let totlavalue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    totlavalue = totlavalue == 0 ? 1 : totlavalue;
    let shape1Size = 0;
    let shape2Size = 0;

    let shape1Clone = this.data._divParent.querySelector("#legendseries_0")?.querySelector(".cs-legend-shape")?.cloneNode(true);
    let shapeElement1 = this.ChartHelper.createDivElement({});
    shapeElement1 = shape1Clone || shapeElement1;
    shapeElement1.className = shape1Clone ? shape1Clone.getAttribute("class") + " cs-dumbbell-shape-one-style dumbbellchartshape moodanimation" : "cs-dumbbell-shape-one-style dumbbellchartshape moodanimation";
    shapeElement1.dataset.animation = "dumbbellshape1";
    shapeElement1.setAttribute("data-id", groupindex + "_" + 0);
    let shapeElement1Child = this.ChartHelper.createDivElement({});
    shapeElement1Child.className = "cs-dumbbell-shape-one-child";
    shapeElement1Child.classList.add(this.data.ChartFonts.appendgraphicBgColor(0));
    if (!shape1Clone) shapeElement1.appendChild(shapeElement1Child);
    graphicElement.appendChild(shapeElement1);

    let customColorIndex = this.ChartFonts.customColor(0);
    shapeElement1.classList.add("th-section" + customColorIndex);
    shapeElement1.classList.add("clsMultiColorParent");
    shapeElement1.classList.add("accent" + customColorIndex);

    shape1Size = shapeElement1.offsetWidth;

    let shape2Clone = this.data._divParent.querySelector("#legendseries_1")?.querySelector(".cs-legend-shape")?.cloneNode(true);
    let shapeElement2 = this.ChartHelper.createDivElement({});
    shapeElement2 = shape2Clone || shapeElement2;
    shapeElement2.className = shape2Clone ? shape2Clone.getAttribute("class") + " cs-dumbbell-shape-two-style dumbbellchartshape moodanimation" : "cs-dumbbell-shape-two-style dumbbellchartshape moodanimation";
    shapeElement2.dataset.animation = "dumbbellshape2";
    shapeElement2.setAttribute("data-id", groupindex + "_" + 1);

    let shapeElement2Child = this.ChartHelper.createDivElement({});
    shapeElement2Child.className = "cs-dumbbell-shape-two-child";
    shapeElement2Child.classList.add(this.data.ChartFonts.appendgraphicBgColor(0));
    if (!shape2Clone) shapeElement2.appendChild(shapeElement2Child);

    customColorIndex = this.ChartFonts.customColor(1);
    shapeElement2.classList.add("th-section" + customColorIndex);
    shapeElement2.classList.add("clsMultiColorParent");
    shapeElement2.classList.add("accent" + customColorIndex);
    graphicElement.appendChild(shapeElement2);

    shape2Size = shapeElement2.offsetWidth;

    const numMultpleFactor = element?.clientWidth / totlavalue;
    let parentWidth = element?.clientWidth;
    let shapeElement1position = this.data.values[this.groupindex][0] * numMultpleFactor;
    let shapeElement2position = this.data.values[this.groupindex][1] * numMultpleFactor;
    if (this.data.chartFlip) {
        shapeElement1position = parentWidth - shape1Size - shapeElement1position;
        shapeElement2position = parentWidth - shape2Size - shapeElement2position;
    }
    let shapeWidth = shapeElement1position > shapeElement2position ? shapeElement1position - shapeElement2position : shapeElement2position - shapeElement1position;
    let shapePosition = shapeElement1position > shapeElement2position ? shapeElement2position : shapeElement1position;

    let valueElement1 = element.querySelector("#value-text-" + this.groupindex + "_0");
    let valueElement2 = element.querySelector("#value-text-" + this.groupindex + "_1");
    valueElement1.classList.add("minlabelsize");
    valueElement2.classList.add("minlabelsize");

    valueElement1.style.position = "absolute";
    valueElement2.style.position = "absolute";

    if (valueElement1?.children[0]) {
        valueElement1.children[0].removeAttribute("data-graphic-x");
    }
    if (valueElement2?.children[0]) {
        valueElement2.children[0].removeAttribute("data-graphic-x");
    }

    let value1Width = valueElement1.offsetWidth;
    let value2Width = valueElement2.offsetWidth;

    let isSecondValueLow = parseFloat(this.data.values[this.groupindex][0]) > parseFloat(this.data.values[this.groupindex][1]);

    let value1gap = shapeElement1position;
    let value2gap = parentWidth - shapeElement2position - shape2Size;

    let value1Position = shapeElement1position - value1Width;
    let value2Position = shapeElement2position + shape2Size;
    if (this.data.chartFlip) {
        value1Position = shapeElement1position + shape1Size;
        value2Position = shapeElement2position - value2Width;
    }
    if (isSecondValueLow) {
        value1gap = parentWidth - shapeElement1position - shape1Size;
        value2gap = shapeElement2position;
        value1Position = shapeElement1position + shape1Size;
        value2Position = shapeElement2position - value2Width;
        if (this.data.chartFlip) {
            value1Position = shapeElement1position - value1Width;
            value2Position = shapeElement2position + shape2Size;
        }
        valueElement2.classList.remove(this.data.layout.valuePaddingClass);
        valueElement2.classList.add(this.data.layout.valueAlterPaddingClass);
    } else {
        valueElement1.classList.remove(this.data.layout.valuePaddingClass);
        valueElement1.classList.add(this.data.layout.valueAlterPaddingClass);
    }

    if (value1Width > value1gap) {
        valueElement1.style.display = "none";
    } else {
        valueElement1.style.left = this.data.SVGUtils.createPercentValue(parentWidth, value1Position);
    }
    if (value2Width > value2gap) {
        valueElement2.style.display = "none";
    } else {
        valueElement2.style.left = this.data.SVGUtils.createPercentValue(parentWidth, value2Position);
    }

    shapeElement1.style.left = this.data.SVGUtils.createPercentValue(parentWidth, shapeElement1position);
    shapeElement2.style.left = this.data.SVGUtils.createPercentValue(parentWidth, shapeElement2position);

    let shapeSize = shapeElement1position > shapeElement2position ? shape2Size : shape1Size;
    shapeWidth = shapeWidth - shapeSize;
    let graphicElementNode = this.ChartHelper.createDivElement({});
    graphicElementNode.className = "cls-dumbbell-graphic-node graphicNode";
    graphicElementNode.style.left = this.data.SVGUtils.createPercentValue(parentWidth, shapePosition + shapeSize);
    graphicElementNode.style.width = this.data.SVGUtils.createPercentValue(parentWidth, shapeWidth);
    let chartGraphicNode = this.ChartHelper.createDivElement({});
    chartGraphicNode.className = " cs-dumbbell-intermediate-line-style moodanimation";
    chartGraphicNode.dataset.animation = "dumbbellgraphicnode";
    graphicElementNode.appendChild(chartGraphicNode);
    chartGraphicNode.dataset.customorgin = "left";
    if (isSecondValueLow) {
        chartGraphicNode.dataset.customorgin = "right";
    }
    graphicElement.appendChild(graphicElementNode);
};

function SimpleVerticalDumbbellChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleDumbbellChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleVerticalDumbbellChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleVerticalDumbbellChart.prototype.constructor = SimpleVerticalDumbbellChart;
// SimpleDumbbellChart.prototype.doAddGridDesk = function () {
//     return null;
// };
SimpleVerticalDumbbellChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleVerticalDumbbellSeries"](argparent, argprops);
};

function SimpleVerticalDumbbellSeries(argparent, argprops) {
    this.name = "SimpleDumbbellSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleVerticalDumbbellSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleVerticalDumbbellSeries.prototype.constructor = SimpleVerticalDumbbellSeries;

SimpleVerticalDumbbellSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleVerticalDumbbellSeriesItem"](argparent, argprops);
};

//import BaseBarSeriesItem from "../../base/baseChartBar/BaseBarSeriesItem.js";
function SimpleVerticalDumbbellSeriesItem(argparent, argprops) {
    this.name = "SimpleVerticalDumbbellSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleVerticalDumbbellSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleVerticalDumbbellSeriesItem.prototype.constructor = SimpleVerticalDumbbellSeriesItem;

SimpleVerticalDumbbellSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // Create main container element
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic baserightgraphic";
    element.style.height = "100%";
    element.style.width = "100%";

    // Create graphics container
    let graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.className = "graphic-container";
    graphicElement.style.position = "relative";
    graphicElement.style.height = "100%";
    graphicElement.style.width = "100%";
    element.appendChild(graphicElement);

    if (argparent) argparent.appendChild(element);
    else return element;

    // Add value labels
    this.doAddTopValue(element, argprops, true);
    this.doAddTopValue(element, argprops, false);

    // Add second value
    argprops["index"] = 1;
    argprops["value"] = this.data.values[this.groupindex][1];
    argprops["valuetext"] = this.data.prefix[this.groupindex][1] + this.data.valuesDenomination[this.groupindex][1] + this.data.suffix[this.groupindex][1];
    this.doAddTopValue(element, argprops, false);

    // Calculate total value for scaling
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    totalValue = totalValue == 0 ? 1 : totalValue;

    // Create dumbbell shapes
    let shape1Clone = this.data._divParent.querySelector("#legendseries_0")?.querySelector(".cs-legend-shape")?.cloneNode(true);
    let shapeElement1 = this.ChartHelper.createDivElement({});
    shapeElement1 = shape1Clone || shapeElement1;
    shapeElement1.className = shape1Clone ? shape1Clone.getAttribute("class") + " cs-dumbbell-shape-one-style dumbbellchartshape moodanimation" : "cs-dumbbell-shape-one-style dumbbellchartshape moodanimation";
    shapeElement1.setAttribute("data-id", groupindex + "_" + 0);
    shapeElement1.dataset.animation = "dumbbellshape1";
    let shapeElement1Child = this.ChartHelper.createDivElement({});
    shapeElement1Child.className = "cs-dumbbell-shape-one-child";
    shapeElement1Child.classList.add(this.data.ChartFonts.appendgraphicBgColor(0));
    if (!shape1Clone) shapeElement1.appendChild(shapeElement1Child);
    graphicElement.appendChild(shapeElement1);

    let customColorIndex = this.ChartFonts.customColor(0);
    shapeElement1.classList.add("th-section" + customColorIndex);
    shapeElement1.classList.add("clsMultiColorParent");
    shapeElement1.classList.add("accent" + customColorIndex);

    let shape2Clone = this.data._divParent.querySelector("#legendseries_1")?.querySelector(".cs-legend-shape")?.cloneNode(true);
    let shapeElement2 = this.ChartHelper.createDivElement({});
    shapeElement2 = shape2Clone || shapeElement2;
    shapeElement2.setAttribute("data-id", groupindex + "_" + 1);
    shapeElement2.className = shape2Clone ? shape2Clone.getAttribute("class") + " cs-dumbbell-shape-two-style dumbbellchartshape moodanimation" : "cs-dumbbell-shape-two-style dumbbellchartshape moodanimation";
    shapeElement2.dataset.animation = "dumbbellshape2";

    let shapeElement2Child = this.ChartHelper.createDivElement({});
    shapeElement2Child.className = "cs-dumbbell-shape-two-child";
    shapeElement2Child.classList.add(this.data.ChartFonts.appendgraphicBgColor(0));
    if (!shape2Clone) shapeElement2.appendChild(shapeElement2Child);

    customColorIndex = this.ChartFonts.customColor(1);
    shapeElement2.classList.add("th-section" + customColorIndex);
    shapeElement2.classList.add("clsMultiColorParent");
    shapeElement2.classList.add("accent" + customColorIndex);

    graphicElement.appendChild(shapeElement2);

    // Get shape sizes
    let shape1Size = shapeElement1.offsetWidth;
    let shape2Size = shapeElement2.offsetWidth;

    // Calculate positions based on values
    const scaleFactor = element?.clientHeight / totalValue;
    let parentHeight = element?.clientHeight;
    let shapeElement1Position = parentHeight - shape1Size - this.data.values[this.groupindex][0] * scaleFactor;
    let shapeElement2Position = parentHeight - shape2Size - this.data.values[this.groupindex][1] * scaleFactor;
    if (this.data.chartFlip) {
        shapeElement1Position = this.data.values[this.groupindex][0] * scaleFactor;
        shapeElement2Position = this.data.values[this.groupindex][1] * scaleFactor;
    }
    // Calculate connector dimensions
    let connectorHeight = Math.abs(shapeElement1Position - shapeElement2Position);
    let connectorPosition = Math.min(shapeElement1Position, shapeElement2Position);

    // Position value labels
    let valueElement1 = element.querySelector("#value-text-" + this.groupindex + "_0");
    let valueElement2 = element.querySelector("#value-text-" + this.groupindex + "_1");

    valueElement1.classList.add("minlabelsize");
    valueElement2.classList.add("minlabelsize");
    valueElement1.style.position = "absolute";
    valueElement2.style.position = "absolute";
    if (valueElement1?.children[0]) {
        valueElement1.children[0].removeAttribute("data-graphic-y");
    }
    if (valueElement2?.children[0]) {
        valueElement2.children[0].removeAttribute("data-graphic-y");
    }
    // Determine if second value is lower
    let isSecondValueLow = parseFloat(this.data.values[this.groupindex][0]) > parseFloat(this.data.values[this.groupindex][1]);

    // Position shapes and labels
    shapeElement1.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement1Position);
    shapeElement2.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement2Position);

    // Create connector line
    let connectorElement = this.ChartHelper.createDivElement({});
    connectorElement.className = "cls-dumbbell-graphic-node graphicNode";
    connectorElement.style.top = this.data.SVGUtils.createPercentValue(parentHeight, connectorPosition + shape2Size);
    connectorElement.style.height = this.data.SVGUtils.createPercentValue(parentHeight, connectorHeight - shape2Size);

    let chartGraphicNode = this.ChartHelper.createDivElement({});
    chartGraphicNode.className = " cs-dumbbell-intermediate-line-style moodanimation";
    chartGraphicNode.dataset.animation = "dumbbellgraphicnode";
    connectorElement.appendChild(chartGraphicNode);

    chartGraphicNode.dataset.customorgin = "bottom";
    if (isSecondValueLow) {
        chartGraphicNode.dataset.customorgin = "top";
    }
    graphicElement.appendChild(connectorElement);

    // Position value labels
    let value1gap = 0;
    let value2gap = 0;
    if (isSecondValueLow) {
        valueElement1.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement1Position - valueElement1.offsetHeight);
        valueElement2.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement2Position + shape2Size);
        if (this.data.chartFlip) {
            valueElement1.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement1Position + shape2Size);
            valueElement2.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement2Position - valueElement2.offsetHeight);
        }
        valueElement2.classList.remove(this.data.layout.valuePaddingClass);
        valueElement2.classList.add(this.data.layout.valueAlterPaddingClass);
        value1gap = shapeElement1Position;
        value2gap = parentHeight - shapeElement2Position - shape2Size;
    } else {
        valueElement1.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement1Position + shape1Size);
        valueElement2.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement2Position - valueElement2.offsetHeight);
        if (this.data.chartFlip) {
            valueElement1.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement1Position - valueElement1.offsetHeight);
            valueElement2.style.top = this.data.SVGUtils.createPercentValue(parentHeight, shapeElement2Position + shape2Size);
        }
        valueElement1.classList.remove(this.data.layout.valuePaddingClass);
        valueElement1.classList.add(this.data.layout.valueAlterPaddingClass);
        value1gap = parentHeight - shapeElement1Position - shape1Size;
        value2gap = shapeElement2Position;
    }
    if (valueElement1.offsetHeight > value1gap) {
        valueElement1.style.display = "none";
    }
    if (valueElement2.offsetHeight > value2gap) {
        valueElement2.style.display = "none";
    }
};
