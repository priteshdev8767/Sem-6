            objTextColor.val = metaData.getAttribute(elementName + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
            if (elementType == "value" || elementType == "promt" || elementType == "totalvalue" || elementType == "label" || elementType == "legendvalue" || elementType == "legendlabel" || elementType == "secondarylabel") {
                objTextColor.val = metaData.children[index].getAttribute(elementName + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
                if (elementType == "value" || elementType == "promt" || elementType == "totalvalue") {
                    let indexValue = eltarget.getAttribute("data-id");
                    objTextColor["element"] = elementName + indexValue;
                    objTextColor.val = metaData.children[index].getAttribute(elementName + indexValue + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
                }
                objTextColor["indexvalue"] = index;
            } else if (elementType == "chartgrouplabel") {
                let indexValue = eltarget.getAttribute("data-id");
                objTextColor["element"] = elementName + indexValue;
                objTextColor.val = metaData.getAttribute(elementName + indexValue + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
            } else if (elementName == "seriesitemlabel") {
                let indexValue = eltarget.getAttribute("data-id");
                objTextColor["element"] = elementName + indexValue;
                objTextColor.val = metaData.getAttribute(elementName + indexValue + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
            } else if (elementName == "multilegendlabel") {
                let indexValue = eltarget.getAttribute("data-id");
                objTextColor["element"] = elementName + indexValue;
                objTextColor.val = metaData.getAttribute(elementName + indexValue + "textcolor") || window.getComputedStyle(elTemptarget)["color"];
            }
        }
    }
    index = itemId.includes("value") || itemId.includes("graphic") || itemId.includes("itemplaceholder") ? itemId.split("-")[1].split("_")[0] : itemId.split("-")[1];
    let isGraphicTarget = eltarget?.getAttribute("class")?.includes("chartgraphic");
    let isSeriesNode = eltarget?.getAttribute("class")?.includes("series");
    let jsonChartItemMetaData = this.getChartItemMetaData("name", chartName)[0]; //strClass
    let boolSupportChartGroup = jsonChartItemMetaData?.chartgroup == "true" ? true : false;

    // Get chartId from grahicDiv
    let chartId = grahicDiv ? this.ChartUtils.getOrCreateChartId(grahicDiv) : null;

    if ((event?.metaKey || event?.ctrlKey) && !isItemBasedChart && boolSupportChartGroup) {
        if (isGraphicTarget || isSeriesNode) {
            let arraySeries = grahicDiv.querySelectorAll(".series");
            let chartGroupNodes = this.ChartUtils.getChartGroupNodes(chartId);

            if (chartGroupNodes.length == 1) {
                let seriesIndex = chartGroupNodes[0]?.getAttribute("data-id")?.split("_")[0];
                let isSeriesLevelNode = eltarget?.getAttribute("class")?.includes("series");
                if (isSeriesLevelNode) {
                    seriesIndex = chartGroupNodes[0]?.getAttribute("data-index");
                }
                if (arraySeries[seriesIndex]) arraySeries[seriesIndex].classList.add("multiselecthoverclass");
            }
            if (arraySeries[index]) arraySeries[index].classList.add("multiselecthoverclass");
            this.ChartUtils.addChartGroupNode(chartId, eltarget);

            // Check if we have enough nodes after adding
            chartGroupNodes = this.ChartUtils.getChartGroupNodes(chartId);
            if (chartGroupNodes.length < 2) {
                return {};
            }
        } else {
            this.resetChartGroupNodes(grahicDiv);
        }
    } else if (isGraphicTarget || isSeriesNode) {
        this.resetChartGroupNodes(grahicDiv);
        this.ChartUtils.addChartGroupNode(chartId, eltarget);
    } else {
        this.resetChartGroupNodes(grahicDiv);
    }
    let valueLength = metaData?.children[0]?.getAttribute("value")?.split(",").length > 1 ? true : false;
    let disableChartGroup = metaData?.getAttribute("secondarylinechart") == "true" || valueLength ? true : false;

    let chartGroupNodes = this.ChartUtils.getChartGroupNodes(chartId);
    if (disableChartGroup && chartGroupNodes?.length > 1) {
        this.resetChartGroupNodes(grahicDiv);
    }
    let divChart = parent ? parent.querySelector(".metadata_group_chart").getAttribute("isdivChart") : false;
