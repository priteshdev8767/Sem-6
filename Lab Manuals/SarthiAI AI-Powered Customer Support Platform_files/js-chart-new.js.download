                    valueElement.style.opacity = "0";
                    valueElement.style.visibility = "hidden";
                }
                gridValueElement.appendChild(valueElement);
                if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != this.positiveGridCount - 1) {
                    valueElement.style.setProperty("opacity", "0", "important");
                }
            }

            if (this.type == "horizontal" && this.negBounds.width != 0) {
                let negWidth = 0;
