            let attribute = metaData.getAttribute("chartgrouplabelfontsize")?.split("^")?.length > 1 && metaData.getAttribute("chartgrouplabelfontsize")?.split("^")?.[indexVale] != "false" ? metaData.getAttribute("chartgrouplabelfontsize")?.split("^")?.[indexVale] : elTemptarget.getAttribute("data-themeclass");
            let selectedIndex = this.getSelectedIndex(dpTitleFontSize, attribute, 0);
            let fontSizeValue =
                metaData.getAttribute("chartgrouplabeltextsize")?.split("^")?.length > 0 && metaData.getAttribute("chartgrouplabeltextsize")?.split("^")?.[indexVale] != "false"
                    ? parseFloat(metaData.getAttribute("chartgrouplabeltextsize")?.split("^")?.[indexVale] || window.getComputedStyle(elTemptarget).fontSize || 0)
                    : parseFloat(window.getComputedStyle(elTemptarget).fontSize || 0);
            let textselectedIndex = this.getSelectedIndex(textSize["dpsource"], fontSizeValue + "px", 0);
