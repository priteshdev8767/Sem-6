    // -----------------------------------------------Doughnut Chart----------------------------------------------------
    this.customdoughnut = data.getAttribute("customdoughnut") == "true" || chartName.toLowerCase().includes("doughnut") ? true : false;
    hadCustomDoughnut = !data.getAttribute("semichart") || data.getAttribute("semichart") != "true" ? hadCustomDoughnut : false;
    let objdoughnutChart = {
        visible: hadCustomDoughnut,
        value: this.customdoughnut,
    };
    //------------------------------------------  secondary Text  -----------------------------------------------------

    if (hadSecondaryText) {
        this.secondaryElements = data.getAttribute("secondarytext") == "true" ? true : false;
        if (this.secondaryElements) data.setAttribute("secondaryplaceholder", "text");
        else data.getAttribute("secondaryplaceholder", "none");
        voLayout.showSecondaryPlaceholder = hadSecondaryText && this.secondaryElements;
        this.secondaryType = "text";
    }
    let objSecondaryText = {
        visible: hadSecondaryText,
        value: this.secondaryElements,
    };
    // ---------------------------------------------------------------------------------------------------------------
    let chartProperties = ChartUtils.getChartProperties(argProp.data);
    let customMaxValue = hadCustomMaxValue;
    let objCustomMax = "";
    // showxaxis:disbleXaxis,
    if (customMaxValue) {
        let numCustomMaxValue = data.getAttribute("customdisplaymaxvalue") ? data.getAttribute("customdisplaymaxvalue") : data.getAttribute("yaxismaxvalue");
        objCustomMax = {
            visible: customMaxValue,
            value: numCustomMaxValue,
        };
    }
    let hasProjection = false;
    if (objBaseProperties.projectionEnable == "true") {
        hasProjection = true;
    }
    let secondaryLineChart = data.getAttribute("secondarylinechart") == "true" ? true : false;
    if (voLayout.labelItemBased == "true" || voLayout.valueItemBased == "true") {
        hadSecondaryLineChart = false;
    }
    if (arrChartGroup.length > 0) {
        hadSecondaryLineChart = false;
        objMultiSlide.visible = false;
    }
    let objSecondaryLineChart = {
        visible: hadSecondaryLineChart,
        value: secondaryLineChart,
    };

    //------------------------------------------  CAGR  -----------------------------------------------------
    this.enableCagr = hadCagr && data.getAttribute("cagr") == "true" ? true : false;
    let hadStatisticallabel = seriesItemLength == 2 && this.enableStatisticalLabel ? true : false;
    let objCagr = {
        visible: hadCagr && seriesItemLength > 1 && !secondaryLineChart && !hadStatisticallabel,
        value: this.enableCagr,
    };
    let strCagrPos = data.getAttribute("cagrposition") ? data.getAttribute("cagrposition") : "top";
    let objCagrPos = {
        visible: hadCagr && seriesItemLength > 1 && !secondaryLineChart && this.enableCagr && (!this.customLegend || (this.customLegend && this.legendPosition != "right")) && !this.valueSeriesItemLabel,
        dpSource: arrCagrPos,
        selectedindex: ChartUtils.getSelectedIndex(arrCagrPos, strCagrPos),
    };
    let secondaryLineChartType = data.getAttribute("secondaryspline") == "true" ? true : false;
    let objSecondaryLineChartType = {
        visible: secondaryLineChart && hadSecondaryLineChart,
        value: secondaryLineChartType,
    };
    let secondaryLineChartValue = data.getAttribute("secondarylinechartvalue") == "true" ? true : false;
    let objSecondaryLineChartValue = {
        visible: secondaryLineChart && hadSecondaryLineChart,
        value: secondaryLineChartValue,
    };
    //show chartlist:
    let hadChartList = true;

    let chartDpList = [
        { icon: "bar_chart", lable: "bar", assettype: "chart", menuname: "cfg-bar-sty-a" },
        { icon: "column_chart", lable: "column", assettype: "chart", menuname: "cfg-column-sty-a" },
        { icon: "area_chart", lable: "area", assettype: "chart", menuname: "cfg-curved-area-sty-a" },
        { icon: "line_area_chart", lable: "line", assettype: "chart", menuname: "cfg-curved-line-sty-a" },
        { icon: "pie_chart", lable: "pie", assettype: "chart", menuname: "cfg-pie-chart-sty-a" },
    ];
    let currentGraphicMenuName = data.getAttribute("graphicname");
    let menuSelectedIndex = ChartUtils.getSelectedMenuIndex(chartDpList, currentGraphicMenuName);
    let objChartList = {
        visible: hadChartList,
        dpSource: chartDpList,
        selectedindex: menuSelectedIndex,
    };

    let hadLabelInterChange = Value?.length > 0 ? true : false;
    let arrLabelNode = [{ data: "label", label: "label" }];
    for (let l1 = 0; l1 < Value?.length; l1++) {
        arrLabelNode.push({ data: "value" + l1, label: "point" + (l1 + 1) });
    }
    let labelValue = data.getAttribute("interchangelabeldata");
    let intLabelSepearteIndex = ChartUtils.getSelectedIndex(arrLabelNode, labelValue);
    let objLabelInterchange = {
        visible: hadLabelInterChange,
        dpSource: arrLabelNode,
        selectedindex: intLabelSepearteIndex,
    };

    let hadValueInterChange = true;
    let objValueInterchange = {
        visible: hadValueInterChange,
        dpSource: [],
        selectedindex: menuSelectedIndex,
    };
    let valueNodes = [];
    let interChangeNode = data?.children[0]?.getAttribute("valueinterchange");
    let arrInterChangeNode = interChangeNode?.split(",");
    let inetrChangelength = interChangeNode?.split(",")?.length || Value?.length;
    inetrChangelength = Value?.length > 1 && (chartName == "waterfallchart" || chartName == "horWaterfallchart") ? 1 : inetrChangelength;
    let reverseChart = chartName == "columnStackedRectangle";
    if (reverseChart) {
        for (let i1 = 0; i1 < inetrChangelength; i1++) {
            let indexValue = data?.children[0]?.getAttribute("valueinterchange")?.split(",")[i1] || i1;
            valueNodes.push({ data: indexValue, label: "point" + (parseFloat(arrInterChangeNode?.[i1] || i1) + 1), value: Value[i1], isreverseChart: reverseChart });
        }
        valueNodes.reverse();
    } else {
        for (let i1 = 0; i1 < inetrChangelength; i1++) {
            let indexValue = data?.children[0]?.getAttribute("valueinterchange")?.split(",")[i1] || i1;
            valueNodes.push({ data: indexValue, label: "point" + (parseFloat(arrInterChangeNode?.[i1] || i1) + 1) });
        }
    }

    objValueInterchange["dpSource"] = valueNodes;

    let addColumn = maxAllowedSeriesItems > seriesItemLength ? true : false;
    let objAddColumn = {
        visible: addColumn,
        value: addColumn,
    };
    //------------------------------------------  chart border  -----------------------------------------------------
    this.chartBorder = data.getAttribute("chartborder") == "true" ? true : false;
    let objChartBorder = {
        visible: this.grid,
        value: this.chartBorder,
        property: "chartborder",
        label: "chartborder",
    };
    //------------------------------------------ grid thickmarker  -----------------------------------------------------
    this.gridThickMarker = data.getAttribute("gridthickmarker") == "true" ? true : false;
    let objGridThickMarker = {
        visible: this.grid,
        value: this.gridThickMarker,
    };
    //------------------------------------------ grid label tick marker  -----------------------------------------------------
    this.gridLabelTickMarker = data.getAttribute("gridlabeltickmarker") == "true" ? true : false;
    let objGridLabelTickMarker = {
        visible: this.grid,
        value: this.gridLabelTickMarker,
    };

    if (this.chartBorder) {
        objXAxis.visibleXAxis = false;
        objYAxis.visibleYAxis = false;
    }

    objAllProperties = {
        xaxis: objXAxis,
        yaxis: objYAxis,
        grid: enablegrid,
        sorting: objSorting,
        iconsize: objiconsize,
        animation: objAnimation,
        coinstyle: objCoinType,
        valueformat: objValueFormat,
        maxvaluecount: objMaxValueCount,
        prefixsuffix: objPrefixSuffix,
        valueseperator: objValueSeperator,
        highlightdiff: objHighlightDiffrents,
        primaryplaceholder: objPrimaryPlaceholder,
        baseline: objBaseLine,
        seriesitemconnector: objSeriesItemConnector,
        seriesitemconnectorthickness: objSeriesItemConnectorThickness,
        seriesitemconnectorcolor: objSeriesItemConnectorColor,
        seriesitemconnectortype: seriesitemconnectortype,
        seriesitemlabel: objSeriesItemLabel,
        seriesitemlabelpos: objSeriesItemLabelPos,
        showtotalvalue: objShowTotalValue,
        spline: objSpline,
        linehead: objLineHead,
        prompt: objPromptText,
        sourcetext: objSourceText,
        charttitletext: objChartTitle,
        projectiontext: objProjectionText,
        projectiondisabledtext: objProjectionDisableText,
        projectiondivider: objProjectionDivider,
        secondaryplaceholder: objSecondaryplaceholder,
        commonplaceholder: objCommonPlaceHolder,
        innerradius: objInnerradius,
        basicproperties: chartProperties,
        customlegend: objCustomLegend,
        customlegendpos: objLegendPosition,
        semichart: objSemiChart,
        secondarytext: objSecondaryText,
        customdoughnut: objdoughnutChart,
        alignment: this.alignment,
        valuedisplayformat: objValueDisplayFormat,
        sequencenumber: objSequenceNumber,
        highvaluebreak: objHighValueBreak,
        chartflip: objChartFlip,
        showlabels: objShaowLabel,
        showCustomMaxValue: objCustomMax,
        disableAdditem: boolDisableAdditem,
        indualhd: objIndualHd,
        itemheader: objItemHeader,
        valueheader: objValueHeader,
        labelheader: objLabelHeader,
        placeholderheader: objPlaceholderHeader,
        highlightvalue: objHighlightValue,
        multislide: objMultiSlide,
        chartlist: objChartList,
        projection: data.getAttribute("projection") == "true",
        emphasis: data.getAttribute("emphasis") == "true",
        hasProjection: hasProjection,
        secondarylinechart: objSecondaryLineChart,
        secondarylinetype: objSecondaryLineChartType,
        secondarylinechartvalue: objSecondaryLineChartValue,
        valueinterchange: objValueInterchange,
        labelinterchange: objLabelInterchange,
        addcolumn: objAddColumn,
        maxallowedseriesitems: maxAllowedSeriesItems,
        chartborder: objChartBorder,
        gridthickmarker: objGridThickMarker,
        gridlabeltickmarker: objGridLabelTickMarker,
        trendline: objTrendline,
        chartgrouplabel: objGroupLabel,
        chartstatisticallabel: objStatisticalLabel,
        cagr: objCagr,
        cagrpos: objCagrPos,
        chartgroup: this.hasChartGroup,
    };
}

