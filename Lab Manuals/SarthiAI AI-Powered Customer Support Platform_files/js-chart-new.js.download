            for (let l1 = 0; l1 < baseFontListing.length; l1++) {
                if (baseFontListing[l1].data <= marginFontSize) {
                    if (index == 1) fontListing["dpsource"].push({ label: "auto", data: "auto", selectedIndex: "0" });
