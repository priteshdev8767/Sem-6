ChartHelper.prototype.getAlignData = function (argProps) {
    let position = "middle";
    if (argProps.inset == "inside") {
        position = "inner";
    } else {
        if (argProps.inset != position) position = "outer";
    }
    if (argProps.outer) position = "outer";

    return {
        position: position,
        show: argProps.show,
        hposition: argProps.hposition,
        vposition: argProps.vposition,
        index: argProps.positinIndex,
        inset: argProps.inset,
        index: argProps.index,
        itemBased: argProps.itemBased,
        samepos: argProps.index ? "true" : false,
        textbg: argProps.textbg,
        textbgstyle: argProps.textbgstyle,
        textbgcallout: argProps.textbgcallout,
        alterpos: argProps.alterpos,
        overlap: argProps.overlap,
    };
};

ChartHelper.prototype.getStylesdata = function (data) {
    let bgFill = data.getAttribute("data-bgFill") == "true" ? true : false;
    let bgFillType = data.getAttribute("data-bgFillType");
    let bgFillColor = data.getAttribute("data-bgFillColor");
    let lineThickness = data.getAttribute("data-linethickness");
    let dropShadow = data.getAttribute("data-dropshadow") == "true" ? true : false;
    let chartType = data.getAttribute("data-charttype");
    let pointshape = data.getAttribute("data-pointshape");
    let dashed = data.getAttribute("data-dashed");
    let border = data.getAttribute("data-border");
    return {
        bgFill: bgFill,
        bgFillType: bgFillType,
        bgFillColor: bgFillColor,
        lineThickness: lineThickness,
        dropShadow: dropShadow,
        chartType: chartType,
        pointshape: pointshape,
        dashed: dashed,
        border: border,
    };
};

ChartHelper.prototype.getHorizantalAlignData = function (argProps) {
    let position = "middle";
    if (argProps.inset == "inside") {
        position = "inner";
    } else {
        if (argProps.inset != position) position = "outer";
    }
    if (argProps.outer) position = "outer";

    return {
        position: position,
        show: argProps.show,
        hposition: argProps.hposition,
        vposition: argProps.vposition,
        index: argProps.positinIndex,
        inset: argProps.inset,
        index: argProps.index,
        itemBased: argProps.itemBased,
        samepos: argProps.index ? "true" : false,
        textbg: argProps.textbg,
        textbgstyle: argProps.textbgstyle,
        textbgcallout: argProps.textbgcallout,
        textbgitem: argProps.textbgitem,
        alterpos: argProps.alterpos,
        overlap: argProps.overlap,
    };
};

ChartHelper.prototype.getChartAssetList = function (value, xmlData) {
    let arrAssets = [];
    let arrIconAssets = [];
    const slideID = value.slideID;
    const elementID = value.elementID;
    const chartName = value.chartName;
    const assetName = xmlData.getAttribute("data-asset");
    const appearance = xmlData.getAttribute("data-appearance");
    this.getShapeList(slideID, chartName, assetName, arrAssets, appearance, xmlData);
    if (xmlData.getAttribute("primaryplaceholder") == "true" || xmlData.getAttribute("data-primaryplaceholder") == "true") arrAssets = this.getIconList(slideID, STR_DEFAULT_ICONGROUP, arrAssets, xmlData);
    // let chartName = xmlData.getAttribute("name")
    if (
        chartName == "fillcompareChart" ||
        chartName == "columnIconFill" ||
        chartName == "barSimpleIconFill" ||
        chartName == "scaleiconcompareChart" ||
        chartName == "singleIconFill" ||
        chartName == "simpleIconFillRepeatChart" ||
        chartName == "iconComparisonChart" ||
        chartName == "barSimpleiconRepeatFill" ||
        chartName == "logoGraphicComparisonChart" ||
        chartName == "ComparisonpieChart" ||
        chartName == "comparisonModelType2"
    ) {
        //let iconGroup = this.data.getAttribute("data-iconid")?this.data.getAttribute("data-iconid"):"flaticon"
        arrAssets = this.getIconList(slideID, STR_DEFAULT_ICONGROUP, arrAssets, xmlData, chartName);
    }
    if (xmlData.getAttribute("commonplaceholdertype")) {
        arrAssets = this.getCommonIconList(slideID, STR_DEFAULT_ICONGROUP, arrAssets, xmlData);
    }

    //arrAssets = arrAssets.length > 0 ? [arrAssets, ...arrIconAssets] : arrIconAssets;
    //
    const strStyleSheetURL = "chart/css/chartnew.css";
    if (strStyleSheetURL != undefined) {
        let arrStyleSheetURL = strStyleSheetURL.split("/");
        let strID = arrStyleSheetURL[arrStyleSheetURL.length - 1].split(".")[0];
        let patternSvg = this.getAssetListDetails(xmlData, true);
    }
    //
    return { slideID: slideID, elementID: elementID, arrAssets: arrAssets };
};

ChartHelper.prototype.getShapeList = function (strSlideID, strChartName, strAssetName, arrStorage, strappearance, xmlData) {
    let filltype = "";
    let appearance = "";
    let assetDatas = this.getAssetListDetails(xmlData);
    if (assetDatas) {
        strAssetName = assetDatas.assetName;
        strappearance = assetDatas.appearance;
    }
    let assets = strAssetName ? strAssetName.split(",") : [strAssetName];
    let assetType = assetDatas && assetDatas.assetType ? assetDatas.assetType.split(",") : [null];
    for (let i1 = 0; i1 < assets.length; i1++) {
        strAssetName = assets[i1];
        let objAsset = JSON.parse(JSON.stringify(assetDatas)); //strChartName,
        if (objAsset) objAsset.assetType = assetType.length > i1 ? assetType[i1] : assetType[assetType.length - 1];
        if (objAsset && objAsset.assetType != undefined) {
            if (objAsset.assetType == "svg" && appearance != "RealImage") {
                let assetName = assets[i1].toLowerCase();
                if (appearance == "Outline") assetName = assetName + "outline";
                else if (appearance == "Overlay") assetName = assetName + "overlay";

                arrStorage.push({
                    type: "ICON",
                    id: assetName,
                    iconType: "fxg",
                    fillType: filltype,
                    slideID: strSlideID,
                    assetName: assetName,
                    appearance: appearance,
                    url: "genericassets/shapes/" + assetName + ".svg",
                    assetList: objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : assetName,
                });
            } else if (objAsset.assetType == "image") {
                if (
                    strChartName == "realObjectPieChart" ||
                    strChartName == "realObjectEarthChart" ||
                    strChartName == "barVerticalMaskChart" ||
                    strChartName == "objectComparisonChart" ||
                    strChartName == "currencyPercentageChart" ||
                    strChartName == "realObjectSinglePieChart" ||
                    strChartName == "realObjectSinglePieChart" ||
                    strChartName == "realObjectOverlayPieChart" ||
                    strChartName == "realObjectPercentagePieChart" ||
                    strChartName == "realObjectOverlayPiePercentageChart" ||
                    strChartName == "assetPercentageChart" ||
                    strChartName == "columnSimpleCoin" ||
                    strChartName == "SingleAssetPieOverlayChart"
                ) {
                    // let assetList = objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : objAsset.assets;
                    // let length = assetList.length;
                    appearance = strChartName == "assetPercentageChart" || strChartName == "currencyPercentageChart" ? "realimage" : strappearance;

                    // for (let i = 0; i < length; i++) {
                    const assetname = (strAssetName + appearance).toLocaleLowerCase();
                    arrStorage.push({
                        type: "IMAGE",
                        id: strAssetName,
                        filltype: filltype,
                        slideID: strSlideID,
                        assetList: assets,
                        appearance: appearance,
                        assetWidth: objAsset.assetWidth,
                        assetHeight: objAsset.assetHeight,
                        url: "genericassets/images/" + assetname + ".png",
                    });
                    // }
                } else {
                    arrStorage.push({
                        type: "JS",
                        styleName: "",
                        fillType: filltype,
                        slideID: strSlideID,
                        appearance: appearance,
                        id: objAsset.assetSource,
                        movieClipAsset: objAsset,
                        assetWidth: objAsset.assetWidth,
                        assetHeight: objAsset.assetHeight,
                        folderPath: "chart/js/" + objAsset.assetSource + "/",
                        url: "chart/js/" + objAsset.assetSource + "/" + objAsset.assetSource + ".js",
                        assetList: objAsset.assets && objAsset.assets.length > 1 ? objAsset.assets.split(",") : objAsset.assets,
                    });
                }
            } else if (objAsset.assetType == "spritesheet") {
                const arrAssetList = objAsset.assetName.split(",");
                const length = arrAssetList.length;
                for (let i1 = 0; i1 < length; i1++) {
                    let assetName = arrAssetList[i1];
                    if (appearance == "Outline") assetName = assetName + "outline";
                    else if (appearance == "Overlay") assetName = assetName + "overlay";
                    if (objAsset.multiasset == "true") {
                        for (let i2 = 0; i2 < 2; i2++) {
                            arrStorage.push({
                                type: "json",
                                styleName: "",
                                fillType: filltype,
                                slideID: strSlideID,
                                appearance: appearance,
                                id: assetName, //objAsset.assetSource,
                                movieClipAsset: objAsset,
                                assetWidth: objAsset.assetWidth,
                                assetHeight: objAsset.assetHeight,
                                folderPath: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/",
                                url: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/" + assetName + ".json", //objAsset.assetSource
                                assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                            });
                            arrStorage.push({
                                type: "asset",
                                styleName: "",
                                fillType: filltype,
                                slideID: strSlideID,
                                appearance: appearance,
                                id: assetName, //objAsset.assetSource,
                                movieClipAsset: objAsset,
                                assetWidth: objAsset.assetWidth,
                                assetHeight: objAsset.assetHeight,
                                folderPath: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/",
                                url: "genericassets/shapes/" + assetName + "/set" + (i2 + 1) + "/" + assetName + ".png", //objAsset.assetSource
                                assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                            });
                        }
                    } else {
                        arrStorage.push({
                            type: "json",
                            styleName: "",
                            fillType: filltype,
                            slideID: strSlideID,
                            appearance: appearance,
                            id: assetName, //objAsset.assetSource,
                            movieClipAsset: objAsset,
                            assetWidth: objAsset.assetWidth,
                            assetHeight: objAsset.assetHeight,
                            folderPath: "genericassets/shapes/" + assetName + "/",
                            url: "genericassets/shapes/" + assetName + "/" + assetName + ".json", //objAsset.assetSource
                            assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                        });
                        arrStorage.push({
                            type: "asset",
                            styleName: "",
                            fillType: filltype,
                            slideID: strSlideID,
                            appearance: appearance,
                            id: assetName, //objAsset.assetSource,
                            movieClipAsset: objAsset,
                            assetWidth: objAsset.assetWidth,
                            assetHeight: objAsset.assetHeight,
                            folderPath: "genericassets/shapes/" + assetName + "/",
                            url: "genericassets/shapes/" + assetName + "/" + assetName + ".png", //objAsset.assetSource
                            assetList: arrAssetList && arrAssetList.length > 1 ? objAsset.assetName.split(",") : objAsset.assetName,
                        });
                    }
                }
            }
        }
    }
};

ChartHelper.prototype.getIconList = function (strSlideID, strGroupName, arrStorage = [], xmlData, chartName = null) {
    let iconGroup;
    let arrAssets = arrStorage.length == 0 ? [] : arrStorage;
    let length = xmlData.children.length;
    let STR_DEFAULT_ICONPATH = "genericassets/icons/placeholder/placeholder.svg";
    let iconCount = 0;
    for (let i1 = 0; i1 < length; i1++) {
        let placeholderpath = chartName ? xmlData.children[i1].getAttribute("itemplaceholderpath") : xmlData.children[i1].getAttribute("placeholderpath");
        let placeholder = chartName ? xmlData.children[i1].getAttribute("itemplaceholder") : xmlData.children[i1].getAttribute("placeholder");

        if (placeholderpath && placeholder) {
            arrAssets.push({ type: "ICON", url: placeholderpath, id: placeholder, slideID: strSlideID });
        } else {
            let itemPlaceHolderIcons = xmlData.getAttribute("data-icon") ? xmlData.getAttribute("data-icon").split(",") : "";
            if (itemPlaceHolderIcons) {
                placeholderpath = chartName ? xmlData.children[iconCount].getAttribute("itemplaceholderpath") : xmlData.children[iconCount].getAttribute("placeholderpath");
                placeholder = chartName ? xmlData.children[iconCount].getAttribute("itemplaceholder") : xmlData.children[iconCount].getAttribute("placeholder");
                arrAssets.push({ type: "ICON", url: placeholderpath, id: placeholder, slideID: strSlideID });
                iconCount++;
                if (itemPlaceHolderIcons.length == iconCount) {
                    iconCount = 0;
                }
            } else {
                arrAssets.push({ type: "ICON", url: STR_DEFAULT_ICONPATH, id: "placeholder", slideID: strSlideID });
            }
        }
    }
    // if (arrStorage) {
    //     arrStorage = [...arrStorage, ...arrAssets];
    // } else {
    return arrAssets;
    // }
};
ChartHelper.prototype.getCommonIconList = function (strSlideID, strGroupName, arrStorage = [], xmlData, chartName = null) {
    let iconGroup;
    let arrAssets = arrStorage.length == 0 ? [] : arrStorage;

    let commonplaceholderpath = xmlData.getAttribute("commonplaceholderpath");
    let commonplaceholder = xmlData.getAttribute("commonplaceholder");
    let STR_DEFAULT_IMAGEPATH = "genericassets/genericassets/images/placeholder.png";
    let STR_DEFAULT_ICONPATH = "genericassets/icons/placeholder/placeholder.svg";
    if (commonplaceholderpath && commonplaceholder) {
        arrAssets.push({ type: "ICON", url: commonplaceholderpath, id: commonplaceholder, slideID: strSlideID });
    } else {
        if (xmlData.getAttribute("commonplaceholdertype") == "image") {
            arrAssets.push({ type: "image", url: STR_DEFAULT_IMAGEPATH, id: "placeholder", slideID: strSlideID });
        } else {
            arrAssets.push({ type: "ICON", url: STR_DEFAULT_ICONPATH, id: "placeholder", slideID: strSlideID });
        }
    }

    // if (arrStorage) {
    //     arrStorage = [...arrStorage, ...arrAssets];
    // } else {
    return arrAssets;
    // }
};

ChartHelper.prototype.gridCountValidation = function (value, gridCount) {
    let boolGridCount = false;
    let dummyValue;
    for (let i1 = gridCount; i1 <= 10; i1++) {
        dummyValue = value / i1;
        if (dummyValue % 5 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        } else if (dummyValue % 10 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        }
    }
    dummyValue = value / 5;
    if (dummyValue % 5 == 0) {
        gridCount = 5;
        boolGridCount = true;
    }
    if (gridCount > value) {
        gridCount = value;
    }
    return gridCount;
};

ChartHelper.prototype.setBaseLineListner = function (element, parentElement, strSlideID) {
    let slide = DocumentStore.getInstance().getSlideDetails(strSlideID);
    let baseLine = slide.content ? slide.content.querySelectorAll(".baselinevalue") : [];
    if (element && element.getAttribute("data-listner") == "true") {
        baseLine = slide.content ? slide.content.querySelectorAll(".baselinevalue") : [];
        if (baseLine.length == 0) {
            element.addEventListener("mousemove", (event) => {
                this.onMouseMoveHandler(element, parentElement, slide.content);
            });
        }

        element.addEventListener("mousedown", (event) => {
            baseLine = slide.content ? slide.content.querySelectorAll(".baselinevalue") : [];
            if (baseLine.length == 0) {
                this.onMouseDownHandler(element, parentElement, slide.content);
            }
        });
        // element.addEventListener("mouseout", event => {
        //     ChartHelper.onMouseOutHandler(element, parentElement);
        // });
    }
};

ChartHelper.prototype.onMouseMoveHandler = function (element, parentElement) {
    const bounds = element.getBoundingClientRect();
    if (element) {
        let oldBaselement = element.querySelectorAll("#baselinemove");
        if (oldBaselement.length >= 1) element.removeChild(oldBaselement[0]);
    }
    let id = element.getAttribute("id");
    let top;
    let bottom;
    if (id == "yaxis") {
        top = window.pageXOffset;
        bottom = window.pageYOffset + (event.pageY - bounds.top) / DocumentStore.getInstance().slideScale;
    } else {
        top = window.pageXOffset + (event.pageX - bounds.left) / DocumentStore.getInstance().slideScale;
        bottom = window.pageYOffset;
    }
    let baseelement = document.createElement("div");
    baseelement.id = "baselinemove";
    baseelement.style.left = id == "yaxis" ? top + "px" : top - 10 + "px";
    baseelement.style.top = id == "yaxis" ? bottom - 10 + "px" : bottom + "px"; //bounds.y;
    baseelement.style.width = "20px";
    baseelement.style.height = "20px";
    baseelement.style.position = "absolute";
    baseelement.style.pointerEvents = "none";
    baseelement.style.overflow = "hidden";
    // const strPlusIcon = IndexStore.getInstance().iconBaseURL + "plus.svg";
    const strPlusIcon = "";
    let imageTag = document.createElement("img");
    imageTag.setAttribute("src", strPlusIcon);
    imageTag.style.width = "100%";
    imageTag.style.height = "100%";
    baseelement.appendChild(imageTag);
    element.appendChild(baseelement);

    element.addEventListener("mouseout", (event) => {
        let baseLine = parentElement.querySelectorAll(".axisbaseline");
        if (baseLine.length == 0) {
            this.onMouseOutHandler(element, parentElement);
        } else {
            if (element) {
                let oldBaselement = element.querySelectorAll("#baselinemove");
                if (oldBaselement.length >= 1) element.removeChild(oldBaselement[0]);
            }
        }
    });
    parentElement;
};

ChartHelper.prototype.onMouseDownHandler = function (element, parentElement, slide) {
    let boundingRect = element.getBoundingClientRect();
    let coordinates = {
        x: event.pageX,
        y: event.pageY,
    };
    let objChartAxisBaselinePos = this.ChartUtils.getAxisBaselineProperties(element, coordinates, boundingRect);
    EditorManager.getInstance().doFloaterPropertiesChange(objChartAxisBaselinePos, null, null);
    if (element) {
        let oldBaselement = element.querySelectorAll("#baselinemove");
        if (oldBaselement.length >= 1) element.removeChild(oldBaselement[0]);
    }
};

ChartHelper.prototype.onMouseOutHandler = function (element, parentElement) {
    let targetElemntId = event.target.getAttribute("id");
    let elementId = element.getAttribute("id");
    if (element && targetElemntId != "baselinemove") {
        let oldBaselement = element.querySelectorAll("#baselinemove");
        if (oldBaselement.length >= 1) element.removeChild(oldBaselement[0]);
    }
};

ChartHelper.prototype.getTextMeasurements = function (slideID, text, argMaxWidth, argMaxHeight, argMaxFontSize, argMinFontSize, className = null, worwrap = true, parentElement) {
    let element = document.createElement("div");
    element.id = "dummyText";
    element.innerText = text;
    element.style.fontSize = argMaxFontSize + "px";
    element.style.maxWidth = argMaxWidth + "px";
    element.style.maxHeight = argMaxHeight + "px";
    element.style.position = "absolute";
    if (worwrap) {
        element.style.overflow = "hidden";
        element.style.display = "block";
        element.style.wordWrap = "break-word";
        element.style.overflowWrap = "normal";
    } else if (!worwrap) {
        element.style.display = "inline-block";
        element.style.wordWrap = "unset";
    }

    if (className) element.className = className;
    parentElement.appendChild(element);
    this.adjustFontSize(element, argMaxHeight, argMinFontSize, argMaxFontSize);
    let textBoundsW = parseInt(window.getComputedStyle(element)["width"]); //element.clientWidth < argMaxWidth ? element.clientWidth : argMaxWidth;
    let textBoundsH = parseInt(window.getComputedStyle(element)["height"]); //element.clientHeight < argMaxHeight ? element.clientHeight : argMaxHeight;
    let fontsize = window.getComputedStyle(element)["font-size"];
    element.remove();
    return {
        width: parseInt(textBoundsW + 1),
        height: parseInt(textBoundsH + 1),
        fontsize: fontsize.split("px")[0],
    };
    // let fontSize
};

ChartHelper.prototype.recalculateMaxHeight = function (nodeTextElement, disableparent = false, boolDisableAllElements = false) {
    let numScrollH = nodeTextElement.scrollHeight;
    let numClientH = nodeTextElement.clientHeight;
    let maxHeight;
    let boolHeightChange = false;
    const cssValue = window.getComputedStyle(nodeTextElement);
    if (numScrollH < 1 && numClientH < 1) {
        nodeTextElement.style.setProperty("font-size", 23 + "px", "");
        return false;
    }
    if (numClientH <= numScrollH) {
        maxHeight = cssValue["maxHeight"].split("px")[0];
        let value = maxHeight / parseFloat(cssValue["lineHeight"]);
        let maxLines = parseInt(value) == 0 ? 1 : parseInt(value);
        if (maxLines > 0 && parseFloat(cssValue["lineHeight"]) > 0) maxHeight = parseInt(maxLines * parseFloat(cssValue["lineHeight"]));
        if (!disableparent) nodeTextElement.parentElement.style.maxHeight = maxHeight + "px";
        //nodeTextElement.parentElement.style.height = maxHeight + "px";
        nodeTextElement.style.maxHeight = maxHeight + "px";
        boolHeightChange = true;
    }
    let graphicElement = this.getElementSlide(nodeTextElement, true);
    let className = nodeTextElement.getAttribute("class");
    let element = graphicElement ? graphicElement.getElementsByClassName(className) : [];
    if (!boolDisableAllElements) {
        for (let i1 = 0; i1 < element.length; i1++) {
            let maxElementH = window.getComputedStyle(element[i1])["maxHeight"].split("px")[0];
            maxElementH = maxHeight > maxElementH ? maxElementH : maxHeight;
            // element[i1].parentElement.style.height = maxElementH + "px";
            element[i1].style.maxHeight = maxElementH + "px";
        }
    }
};
ChartHelper.prototype.getAssetListDetails = function (xmlData, boolEnablePattern = false) {
    let graphicName = xmlData.getAttribute("graphicname");
    let className = xmlData.getAttribute("name");
    let childLength = xmlData.children.length;
    let jsonChartItemMetaData = this.getMenuDetail(graphicName);
    if (!jsonChartItemMetaData) {
        jsonChartItemMetaData = this.getChartOldMenuDetail(className, childLength);
        if (!jsonChartItemMetaData) {
            graphicName = this.getOldMenu(graphicName);
            jsonChartItemMetaData = this.getMenuDetail(graphicName);
        }
    }
    let layoutItems = jsonChartItemMetaData?.template?.chartlayout ? jsonChartItemMetaData?.template?.chartlayout.item : "";
    let layoutData = null;
    if (boolEnablePattern && jsonChartItemMetaData?.template?.chartlayout) {
        let layoutBgItem = jsonChartItemMetaData?.template?.chartlayout ? jsonChartItemMetaData?.template?.chartlayout.background : "";
        if (layoutBgItem && layoutBgItem.fill && layoutBgItem.fill.length > 0 && layoutBgItem.fill[0] == "pattern") {
            layoutData = { assetName: layoutBgItem.fill[1] };
            return layoutData;
        }
        if (layoutItems && layoutItems.fill && layoutItems.fill.length > 0 && layoutItems.fill[0] == "pattern") {
            layoutData = { assetName: layoutItems.fill[1] };
            return layoutData;
        }
    } else {
        if (layoutItems && layoutItems.asset) {
            layoutData = { assetName: layoutItems.asset, assetType: layoutItems.type, appearance: layoutItems.appearance, multiasset: layoutItems.multiasset };
            if (layoutItems.source) {
                layoutData.assetSource = layoutItems.source;
            }
            if (layoutItems.assetsize && layoutItems.assetsize.length > 1) {
                layoutData.assetWidth = layoutItems.assetsize[0];
                layoutData.assetHeight = layoutItems.assetsize[1];
            }
            return layoutData;
        } else {
            return null;
        }
    }
};
