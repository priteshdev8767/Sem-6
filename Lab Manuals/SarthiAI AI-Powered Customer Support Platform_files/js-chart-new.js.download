            this._data.setAttribute("chartflip", true);
        }
        if (argProps?.divParent) argProps.divParent.classList.remove("directionchangeenable");
        if (argProps?.divParent) argProps.divParent.classList.add("directionchangedisable");
        this._directionenable = false;
    } else {
        if (!this._customProperties.chartFlip) {
            this._chartFlip = false;
        }
        if (argProps?.divParent) argProps.divParent.classList.remove("directionchangedisable");
    }
    if (this._boolEnablesequeceNumber && this.voLayout.labelItemBased != "true" && this.voLayout.labelInset != "inside") {
        this.enableSequecelabel = true;
    }
    if (this._data.getAttribute("projectiondivider") == "true") {
        this._projectionDivider = true;
    }
    // if(!this._customProperties.showValueFormat){
    //     this._displayValueFormat = "percentage";
    // }
    if (this.data.getAttribute("highlightvalue") != "false") this.data.removeAttribute("highlightvalue");
    this.arrLabelOpacity = [];
    this.arrLabeltexttransform = [];
    this.arrSecondaryLabelOpacity = [];
    this.arrLabelFontStyle = [];
    this.arrLabelTextSize = [];
    this.arrsecondaryLabeltexttransform = [];
    this.arrsecondaryLabelFontStyle = [];
    this.arrSecondaryLabelTextSize = [];
    this._totalValueTextColor = [];
    this.arrSeriesItemWidth = [];
    this._seriesItemTotalWidth = 0;
    let defaultIconCount = 0;
    this._groupNodes = [];
    this._chartGroupLabel = [];
    this._boolChartGroupLabel = false;
    this.chartGroupCounts = [];
    this._chartGroupLabelTextColor = [];
    this._chartGroupLabelLineHeight = [];
    this._chartGroupLabelLetterSpace = [];

    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        let chartItem = this._data.children[seriesIndex];
        let boolChartGroup = chartItem.getAttribute("chartgroup") ? chartItem.getAttribute("chartgroup") : "false";
        if (boolChartGroup == "true" && this.baseProperties.chartgroup && this.voLayout.labelItemBased != "true" && this.voLayout.valueItemBased != "true") {
            this._chartGroup = true;
            this._boolChartGroupLabel = true;
        }
        if (this._chartGroup && this._boolChartGroupLabel && this.data.getAttribute("chartgrouplabel") == "false") {
            this._boolChartGroupLabel = false;
        }
        let groupindex = chartItem.getAttribute("chartgroupcount") ? chartItem.getAttribute("chartgroupcount") : 0;
        this._groupNodes.push({ value: boolChartGroup, index: groupindex });
        let arrayChartGroupLabel = this._data.getAttribute("chartgrouptext") ? this._data.getAttribute("chartgrouptext").split("^") : [];
        this._chartGroupLabel = arrayChartGroupLabel;
        let secondarName = chartItem.getAttribute(ChartPropertiesName.secondaryName);

        this._labelTextBold = chartItem.getAttribute("labeltextfontbold") ? chartItem.getAttribute("labeltextfontbold") : this._labelTextBold;
        this._labelTextItalic = chartItem.getAttribute("labeltextfontitalic") ? chartItem.getAttribute("labeltextfontitalic") : this._labelTextItalic;

        this._secondaryLabelTextBold = chartItem.getAttribute("secondarylabeltextfontbold") ? chartItem.getAttribute("secondarylabeltextfontbold") : this._secondaryLabelTextBold;
        this._secondaryLabelTextItalic = chartItem.getAttribute("secondarylabeltextfontitalic") ? chartItem.getAttribute("secondarylabeltextfontitalic") : this._secondaryLabelTextItalic;
        this._logoContrast[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.logocontrast) ? chartItem.getAttribute(ChartPropertiesName.logocontrast) : "false";
        let secondaryElementType = "image";
        let labelLineHeight = this._data.children[seriesIndex].getAttribute("labellineheight") ? this._data.children[seriesIndex].getAttribute("labellineheight") : "";
        this.labelLineHeight.push(labelLineHeight);
        let legendLineHeight = this._data.children[seriesIndex].getAttribute("legendlineheight") ? this._data.children[seriesIndex].getAttribute("legendlineheight") : "";
        this.legendlabellineHeight.push(legendLineHeight);
        let labelTextColor = this._data.children[seriesIndex].getAttribute("legendlabeltextcolor") || this._data.children[seriesIndex].getAttribute("labeltextcolor") || "";
        this._labelTextColor.push(labelTextColor);
        let mutiLegendColor = this._data.getAttribute("multilegendlabel" + seriesIndex + "textcolor") || "";
        this.multiLegendTextColor.push(mutiLegendColor);
        let secondaryLabelTextColor = this._data.children[seriesIndex].getAttribute("secondarylabeltextcolor") ? this._data.children[seriesIndex].getAttribute("secondarylabeltextcolor") : "";
        this._secondaryTextColor.push(secondaryLabelTextColor);

        let labelletterspace = this._data.children[seriesIndex].getAttribute("labelletterspace") ? this._data.children[seriesIndex].getAttribute("labelletterspace") : "";
        this.labelLetterSpace.push(labelletterspace);
        let legendLetterspcaing = this._data.children[seriesIndex].getAttribute("legendletterspace") ? this._data.children[seriesIndex].getAttribute("legendletterspace") : "";
        this.legendlabelletterspacing.push(legendLetterspcaing);

        let seriesLabelBold = this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontbold") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontbold") : "";
        this._chartGroupLabelBold.push(seriesLabelBold);
        let seriesLabelItalic = this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontitalic") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontitalic") : "";
        this._chartGroupLabelItalic.push(seriesLabelItalic);
        let seriesLabelOpacity = this._data.getAttribute("chartgrouplabel" + seriesIndex + "textopacity") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "textopacity") : "";
        this._chartGroupLabelOpacity.push(seriesLabelOpacity);
        let seriesLabelTransform = this._data.getAttribute("chartgrouplabel" + seriesIndex + "texttransform") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "texttransform") : "";
        this._chartGroupLabelTransform.push(seriesLabelTransform);
        let seriesLabelFontClass = this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontsize") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "fontsize") : "";
        this._chartGroupLabelFontClass.push(seriesLabelFontClass);
        let seriesLabelTextSize = this._data.getAttribute("chartgrouplabel" + seriesIndex + "textsize") ? this._data.getAttribute("chartgrouplabel" + seriesIndex + "textsize") : "";
        this._chartGroupLabelTextSize.push(seriesLabelTextSize);

        let labelOpacity = this._data.children[seriesIndex].getAttribute("labeltexttextopacity") ? this._data.children[seriesIndex].getAttribute("labeltexttextopacity") : "";
        this.arrLabelOpacity.push(labelOpacity);
        let labelTransform = this._data.children[seriesIndex].getAttribute("labeltexttexttransform") ? this._data.children[seriesIndex].getAttribute("labeltexttexttransform") : "";
        this.arrLabeltexttransform.push(labelTransform);
        let labelfontStyle = this._data.children[seriesIndex].getAttribute("labeltextfontsize") ? this._data.children[seriesIndex].getAttribute("labeltextfontsize") : this._data.getAttribute("labeltextfontsize") ? this._data.getAttribute("labeltextfontsize") : "";
        this.arrLabelFontStyle.push(labelfontStyle);
        let labeltextsize = this._data.children[seriesIndex].getAttribute("labeltexttextsize") ? this._data.children[seriesIndex].getAttribute("labeltexttextsize") : this._data.getAttribute("labeltexttextsize") ? this._data.getAttribute("labeltexttextsize") : "";
        this.arrLabelTextSize.push(labeltextsize);
        let secondarylabelOpacity = this._data.children[seriesIndex].getAttribute("secondarylabeltexttextopacity") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttextopacity") : "";
        this.arrSecondaryLabelOpacity.push(secondarylabelOpacity);
        let secondarylabelTransform = this._data.children[seriesIndex].getAttribute("secondarylabeltexttexttransform") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttexttransform") : "";
        this.arrsecondaryLabeltexttransform.push(secondarylabelTransform);
        let secondarylabelfontStyle = this._data.children[seriesIndex].getAttribute("secondarylabeltextfontsize") ? this._data.children[seriesIndex].getAttribute("secondarylabeltextfontsize") : "";
        this.arrsecondaryLabelFontStyle.push(secondarylabelfontStyle);
        let Secondarylabeltextsize = this._data.children[seriesIndex].getAttribute("secondarylabeltexttextsize") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttextsize") : "";
        this.arrSecondaryLabelTextSize.push(Secondarylabeltextsize);

        let chartGroupLabelTextColor = this._data.getAttribute("chartgrouplabel" + seriesIndex + "textcolor") || "";
        this._chartGroupLabelTextColor.push(chartGroupLabelTextColor);

        let chartGroupLabelLineHeight = this._data.getAttribute("chartgrouplabellineheight" + seriesIndex) ? this._data.getAttribute("chartgrouplabellineheight" + seriesIndex) : "";
        this._chartGroupLabelLineHeight.push(chartGroupLabelLineHeight);

        let chartGroupLabelLetterSpace = this._data.getAttribute("chartgrouplabelletterspacing" + seriesIndex) ? this._data.getAttribute("chartgrouplabelletterspacing" + seriesIndex) : "";
        this._chartGroupLabelLetterSpace.push(chartGroupLabelLetterSpace);

        let compareLabelLineHeight = this._data.children[seriesIndex].getAttribute("comparetitlelineheight") ? this._data.children[seriesIndex].getAttribute("comparetitlelineheight") : "";
        this.compareTitleLineHeight.push(compareLabelLineHeight);
        let compareLabelletterspace = this._data.children[seriesIndex].getAttribute("comparetitleletterspcing") ? this._data.children[seriesIndex].getAttribute("comparetitleletterspcing") : "";
        this.compareTitleLetterSpace.push(compareLabelletterspace);
        let labelhighlightColor = this._data.children[seriesIndex].getAttribute("labelHighlightcolor") ? this._data.children[seriesIndex].getAttribute("labelHighlightcolor") : "";
        this._labelHighlightColor.push(labelhighlightColor);
        let defaultImagePath = "";
        let defaultLogoPath = "";
        let defaultIconPath = "";
        let defaultIconId = "";
        if (arrDefaultplaceholderimage.length > 0) {
            if (arrDefaultplaceholderimage.length > seriesIndex && arrDefaultplaceholderimage[seriesIndex]) {
                defaultImagePath = arrDefaultplaceholderimage[seriesIndex].value;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultplaceholderimage.length);
                defaultImagePath = arrDefaultplaceholderimage[indexValue].value;
            }
        }
        if (arrDefaultlogoimage.length > 0) {
            if (arrDefaultlogoimage.length > seriesIndex && arrDefaultlogoimage[seriesIndex]) {
                defaultLogoPath = arrDefaultlogoimage[seriesIndex].value;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultlogoimage.length);
                defaultLogoPath = arrDefaultlogoimage[indexValue].value;
            }
        }
        if (arrDefaultPlaceholderIcons.length > 0) {
            if (arrDefaultPlaceholderIcons.length > seriesIndex && arrDefaultPlaceholderIcons[seriesIndex]) {
                defaultIconPath = arrDefaultPlaceholderIcons[seriesIndex].value;
                defaultIconId = arrDefaultPlaceholderIcons[seriesIndex].id;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultPlaceholderIcons.length);
                defaultIconPath = arrDefaultPlaceholderIcons[indexValue].value;
                defaultIconId = arrDefaultPlaceholderIcons[indexValue].id;
            }
            if (defaultIconPath) {
                this._chartPlaceHolder = defaultIconPath;
            }
        }
        let strName = chartItem.getAttribute(ChartPropertiesName.name);
        let strComparisonName = chartItem.getAttribute(ChartPropertiesName.comparisonName);
        let strLegendName = chartItem.getAttribute(ChartPropertiesName.legendName);
        let strValue = chartItem.getAttribute(ChartPropertiesName.value);
        let strHighlight = chartItem.getAttribute(ChartPropertiesName.highlight);
        let strlineHighlightText = chartItem.getAttribute("linehighlighttext") ? chartItem.getAttribute("linehighlighttext") : "";
        let promptText = chartItem.getAttribute(ChartPropertiesName.prompttext) ? chartItem.getAttribute(ChartPropertiesName.prompttext) : "";
        let totalValuePrompt = chartItem.getAttribute(ChartPropertiesName.totalvalueprompt) ? chartItem.getAttribute(ChartPropertiesName.totalvalueprompt) : "";
        let valueHdDisplayText = chartItem.getAttribute(ChartPropertiesName.hdcustomtext) ? chartItem.getAttribute(ChartPropertiesName.hdcustomtext) : "";
        let boolLineStyleValueShow = chartItem.getAttribute(ChartPropertiesName.linestylevalueshow) ? chartItem.getAttribute(ChartPropertiesName.linestylevalueshow) : "true";
        let length = strValue.split(",").length;
        this.axisHorLetterspaceing = this._data.getAttribute("axishorletterspacing");
        this.axis;
        VerLetterspaceing = this._data.getAttribute("axisverletterspacing");
        this.hasCustomHighlight = this._data.getAttribute("axisverletterspacing");
        if (this._data.getAttribute("customhighlight") == "true") {
            let customHighlightIndex = this._data.getAttribute("customhighlightpoint") && this._seriesLength >= parseInt(this._data.getAttribute("customhighlightpoint")) ? parseInt(this._data.getAttribute("customhighlightpoint")) : Math.floor(this._seriesLength / 2);
            if (seriesIndex == customHighlightIndex) {
                strHighlight = "true";
            }
        }
        if (this._primaryChartName || this._secondaryChartName) {
            if (!chartItem.getAttribute(ChartPropertiesName.secondaryValue)) chartItem.setAttribute(ChartPropertiesName.secondaryValue, strValue);
        }
        //prompt text
        if (this.baseProperties.promptText) {
            let seriesPromptArr = [];
            if (!promptText) {
                for (let p1 = 0; p1 < length; p1++) {
                    seriesPromptArr.push("");
                }
                promptText = seriesPromptArr.join(",");
            } else {
                let arrText = promptText.split(",");
                for (let p2 = 0; p2 < length; p2++) {
                    if (!arrText[p2]) {
                        seriesPromptArr.push("");
                    } else {
                        seriesPromptArr.push(arrText[p2]);
                    }
                }
                promptText = seriesPromptArr.join(",");
            }
            this._promptText[seriesIndex] = promptText.split(",");
            // chartItem.setAttribute(ChartPropertiesName.prompttext, promptText);
        }
        //total value prompt
        if (this.baseProperties.totalValuePrompt && this._boolEnablePrompt) {
            if (!totalValuePrompt) {
                totalValuePrompt = "";
            }
            this._totalValuePrompt[seriesIndex] = totalValuePrompt;
            this._longTotalPromptText = this._longTotalPromptText.length > totalValuePrompt.length ? this._longTotalPromptText : totalValuePrompt;

            chartItem.setAttribute(ChartPropertiesName.totalvalueprompt, totalValuePrompt);
        }
        //hddisplayFormat
        if (this._indualHighlightDisplayFormat == "customlabel") {
            let seriesHdDisplayArr = [];
            if (!valueHdDisplayText) {
                for (let h1 = 0; h1 < length; h1++) {
                    seriesHdDisplayArr.push("");
                }
                valueHdDisplayText = seriesHdDisplayArr.join(",");
            } else {
                let arrHdText = valueHdDisplayText.split(",");
                for (let h2 = 0; h2 < length; h2++) {
                    if (!arrHdText[h2]) {
                        seriesHdDisplayArr.push("");
                    } else {
                        seriesHdDisplayArr.push(arrHdText[h2]);
                    }
                }
                valueHdDisplayText = seriesHdDisplayArr.join(",");
            }
            this._hddisplayformat[seriesIndex] = valueHdDisplayText.split(",");
            chartItem.setAttribute(ChartPropertiesName.hdcustomtext, valueHdDisplayText);
        }
        ///
        this._promptLongValue = this.checkLongLabel(this._promptText);
        this._secondaryLinePromptLongValue = this.checkSecondaryLineLongLabel(this._promptText);
        this._arrlineHighlightText.push(strlineHighlightText);
        this._arrImagePlaceHolder[seriesIndex] = ChartHelper.getItemImagePlaceHolderPath(this.data, this._serverUrl, seriesIndex);
        let seriesItemWidth = parseFloat(chartItem.getAttribute(ChartPropertiesName.seriesItemWidth)) || 0;
        this.arrSeriesItemWidth.push(seriesItemWidth);
        this._seriesItemTotalWidth += seriesItemWidth;
        let strItemPlaceholder = chartItem.getAttribute(ChartPropertiesName.itemPlaceholder);
        let strItemPlaceholderType = chartItem.getAttribute(ChartPropertiesName.itemPlaceholderType);
        let strItemPlaceHolderPath = chartItem.getAttribute(ChartPropertiesName.itemPlaceholderPath);
        let strPlaceHolder = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
        let strPlaceholderType = chartItem.getAttribute(ChartPropertiesName.placeholderType) ? chartItem.getAttribute(ChartPropertiesName.placeholderType) : this.voLayout.placeholdertype;
        strPlaceholderType = strPlaceholderType == "" && this._data.children.length > 0 && seriesIndex > 0 ? this._data.children[0].getAttribute(ChartPropertiesName.placeholderType) : strPlaceholderType;
        let strSecondaryPlaceHolder = chartItem.getAttribute(ChartPropertiesName.secondaryplaceholder);
        let strSecondaryPlaceholderType = chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderType) ? chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderType) : this.voLayout.secondaryElementType;
        strSecondaryPlaceholderType = strSecondaryPlaceholderType == "" && this._data.children.length > 0 && seriesIndex > 0 ? this._data.children[0].getAttribute(ChartPropertiesName.secondaryPlaceholderType) : strSecondaryPlaceholderType;
        if (strPlaceholderType == "logo") {
            this._hasLogoPlaceholder = true;
        }
        let strEmphasis = chartItem.getAttribute(ChartPropertiesName.emphasis);
        let strProjection = chartItem.getAttribute(ChartPropertiesName.projection);
        let strGraphicImage = this._data.getAttribute("data-graphicimage") == "true" ? true : chartItem.getAttribute(ChartPropertiesName.graphicImage) ? ChartUtils.parseBoolen(chartItem.getAttribute(ChartPropertiesName.graphicImage)) : false;
        if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
            strGraphicImage = true;
        }
        if (this._chartName == "columnImageHorizontalChart") {
            strGraphicImage = false;
        }
        let strItemGraphicPath = chartItem.getAttribute(ChartPropertiesName.itemGraphicPath);
        let strSecondaryValue = chartItem.getAttribute(ChartPropertiesName.secondaryValue);
        let suffix = chartItem.getAttribute(ChartPropertiesName.suffix);
        let prefix = chartItem.getAttribute(ChartPropertiesName.prefix);
        let denomination = chartItem.getAttribute(ChartPropertiesName.denomination);
        let currencySymbol = chartItem.getAttribute(ChartPropertiesName.currencysymbol);
        if (strValue != null) this._values[seriesIndex] = strValue.split(",");
        this.valueTextColor[seriesIndex] = [];
        if (this.seriesanimation) {
            length = 1;
            let currentanimationindex = this.data.getAttribute("seriesanimationindex");
            let currentValue = this._values[seriesIndex][currentanimationindex];
            this._values[seriesIndex] = [];
            this._values[seriesIndex][0] = currentValue;
        }
        if (strSecondaryValue != null) this._secondaryValues[seriesIndex] = strSecondaryValue.split(",");
        if (this._comparePlaceholder && seriesIndex < 2) {
            this.showLegend = false;
            let defaultComparePlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            strSecondaryPlaceholderType = chartItem.getAttribute("placeholdertype");
            if (strSecondaryPlaceholderType == "image") defaultComparePlaceHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
            if (strSecondaryPlaceholderType == "icon") defaultComparePlaceHolder = defaultIconPath ? defaultIconPath : "genericassets/icons/placeholder/placeholder.svg";
            let placeholderPath = this._data.getAttribute("compareplaceholder" + (seriesIndex + 1)) ? this._data.getAttribute("compareplaceholder" + (seriesIndex + 1)) : defaultComparePlaceHolder;
            if (strSecondaryPlaceholderType == "icon") {
                placeholderPath = this._data.getAttribute("compareplaceholder" + (seriesIndex + 1)) ? this._data.getAttribute("compareplaceholder" + (seriesIndex + 1)) : "placeholder";
            }
            this._comparePlaceholderPath.push(placeholderPath);
        }
        // Secondary
        let ssuffix = chartItem.getAttribute(ChartPropertiesName.ssuffix);
        let sprefix = chartItem.getAttribute(ChartPropertiesName.sprefix);
        let sdenomination = chartItem.getAttribute(ChartPropertiesName.sdenomination);
        let scurrencySymbol = chartItem.getAttribute(ChartPropertiesName.scurrencysymbol);

        this._prefix[seriesIndex] = [];
        this._suffix[seriesIndex] = [];
        this._currencySymbol[seriesIndex] = [];
        this._denominationPrefix[seriesIndex] = [];
        this._valuesDenomination[seriesIndex] = [];
        this._sprefix[seriesIndex] = [];
        this._ssuffix[seriesIndex] = [];
        this._sdenominationPrefix[seriesIndex] = [];
        this._scurrencySymbol[seriesIndex] = [];
        this._stackValue = 0;
        this._seriesItemLabelTextColor = [];
        let seriesItemMaxvalue = 0;
        if (seriesIndex == 0) this._maxValueSeriesItems = [];
        let prefixType = this.data.getAttribute("valueprefixtype");
        let suffixType = this.data.getAttribute("valuesuffixtype");
        for (let i1 = 0; i1 < length; i1++) {
            let seriesItemLabelTextColor = this._data.getAttribute("seriesitemlabel" + i1 + "textcolor") || "";
            this._seriesItemLabelTextColor.push(seriesItemLabelTextColor);
            this._values[seriesIndex][i1] = this.baseProperties.isNegativeChart ? this._values[seriesIndex][i1] : Math.abs(this._values[seriesIndex][i1]);
            this._prefix[seriesIndex][i1] = prefix != undefined ? (prefix.split(",")[i1] == undefined ? "" : prefix.split(",")[i1]).substring(0, 4) : "";
            // if(prefixType&&prefix == undefined){
            //     this._prefix[seriesIndex][i1] = prefixType != undefined ? (prefixType.split(",")[i1] == undefined ? "" : prefixType.split(",")[i1]).substring(0, 4) : "";
            // }
            if (this._prefix[seriesIndex][i1] == "" && this.baseProperties.prefixData) {
                this._prefix[seriesIndex][i1] = this.baseProperties.prefixData;
            }
            this._suffix[seriesIndex][i1] = suffix != undefined ? (suffix.split(",")[i1] == undefined ? "" : suffix.split(",")[i1]).substring(0, 4) : "";
            this._currencySymbol[seriesIndex][i1] = currencySymbol != undefined ? (currencySymbol.split(",")[i1] == undefined ? "" : currencySymbol.split(",")[i1]) : "";
            this._denominationPrefix[seriesIndex][i1] = denomination != undefined ? (denomination.split(",")[i1] == undefined ? "" : denomination.split(",")[i1]) : "";
            this._legendLabels[seriesIndex] = strLegendName == null || strLegendName == "" ? "" : strLegendName; //this._chartDefaultValue.label
            seriesItemMaxvalue = i1 == 0 ? this._values[seriesIndex][i1] : seriesItemMaxvalue < this._values[seriesIndex][i1] ? this._values[seriesIndex][i1] : seriesItemMaxvalue;
            if (this._suffix[seriesIndex][i1] == "" && this.baseProperties.suffixData && !this._denominationPrefix[seriesIndex][i1] && this._displayValueFormat == "percentage") {
                this._suffix[seriesIndex][i1] = this.baseProperties.suffixData;
            }
            this._sprefix[seriesIndex][i1] = "";
            this._ssuffix[seriesIndex][i1] = "";
            this._sdenominationPrefix[seriesIndex][i1] = sdenomination != undefined ? (sdenomination.split(",")[i1] == undefined ? "" : sdenomination.split(",")[i1]) : this._customProperties.denominationPrefix;
            this._scurrencySymbol[seriesIndex][i1] = scurrencySymbol != undefined ? (scurrencySymbol.split(",")[i1] == undefined ? "" : scurrencySymbol.split(",")[i1]) : "";
            // if(this._chartName == "simpleIconFillRepeatChart"){
            //     if(this._values[seriesIndex][i1]%10!="0"&&this._values[seriesIndex][i1]>10){
            //         let remaingValue = this._values[seriesIndex][i1]%10;
            //         let roundedValue =0;
            //         let originalValue = 0;
            //        if(remaingValue>=5){
            //         let addinValue = 10-remaingValue;
            //         originalValue = addinValue+parseInt(this._values[seriesIndex][i1])
            //        }else{
            //         originalValue = parseInt(this._values[seriesIndex][i1])-remaingValue;
            //        }
            //        this._values[seriesIndex][i1] = originalValue;
            //     }
            //     if(this._displayValueFormat!="actual"&&this._displayValueFormat!="percentage"){
            //         let splitValue = (this._values[seriesIndex][i1]).toString().split("");
            //         this._values[seriesIndex][i1] = (splitValue.length>1)?Math.round(splitValue.join(".")):this._values[seriesIndex][i1];
            //     }
            // }
            let numSecondaryValue = seriesIndex < this._secondaryValues.length ? parseFloat(this._secondaryValues[seriesIndex][i1]) : 0;
            numSecondaryValue = !this.baseProperties.isNegativeChart ? (numSecondaryValue < 0 ? -numSecondaryValue : numSecondaryValue) : numSecondaryValue;
            this._secondaryValuesDenominationSuffix[seriesIndex + " " + i1] = ChartUtils.getDenominationValue(numSecondaryValue, this._sdenominationPrefix[seriesIndex][i1], this._scurrencySymbol[seriesIndex][i1]);

            this._valuesDenomination[seriesIndex][i1] = ChartUtils.getDenominationValue(this._values[seriesIndex][i1], this._denominationPrefix[seriesIndex][i1], this._currencySymbol[seriesIndex][i1]);
            if (this.baseProperties.maxAllowedSeries == 1 && this._values[0][0] > 100) {
                this._values[0][0] = 100;
            }

            if (this._displayValueFormat == "percentage" && this._chartName == "simpleIconFillRepeatChart" && this._suffix[seriesIndex][i1] == "") {
                this._valuesDenomination[seriesIndex][i1] = this._suffix[seriesIndex][i1].includes("%") ? this._valuesDenomination[seriesIndex][i1] : this._valuesDenomination[seriesIndex][i1] + "%";
            }

            if (this._displayValueFormat == "asentered") {
                let strAsEnteredValue = this._values[seriesIndex][i1];
                if (chartItem.getAttribute("asenteredvalue")) {
                    strAsEnteredValue = chartItem.getAttribute("asenteredvalue");

                    this._suffix[seriesIndex][i1] = "";
                    this._prefix[seriesIndex][i1] = "";
                    this._valuesDenomination[seriesIndex][i1] = strAsEnteredValue.split("^")[i1];
                } else {
                    this._valuesDenomination[seriesIndex][i1] = this._denominationPrefix[seriesIndex][i1] ? strAsEnteredValue.toLocaleString("en-US", { currency: "USD" }) : parseFloat(strAsEnteredValue).toLocaleString("en-US", { currency: "USD" });
                }
            }
            if (this._displayValueFormat == "currency" && (this._oldDisplayFormat == "asentered" || !this._oldDisplayFormat)) {
                if (chartItem.getAttribute("asenteredvalue") || !this._oldDisplayFormat) {
                    this._currencySymbol[seriesIndex][i1] == "";
                    this._suffix[seriesIndex][i1] == "";
                    strAsEnteredValue = chartItem.getAttribute("asenteredvalue");
                    if (strAsEnteredValue) this._valuesDenomination[seriesIndex][i1] = strAsEnteredValue.split("^")[i1];
                    this._denominationPrefix[seriesIndex][i1] = "";
                }
            }
            if (this._displayValueFormat == "currency" && !this._prefix[seriesIndex][i1]) {
                this._prefix[seriesIndex][i1] = "$";
                chartItem.setAttribute("prefix", "$");
                chartItem.setAttribute("denomination", "");
            }
            if (this._displayValueFormat == "asentered") {
                this._suffix[seriesIndex][i1] = "";
            }
            if ((this._secondaryLineChart && i1 != length - 1) || !this._secondaryLineChart) {
                this._stackValue += parseFloat(this._values[seriesIndex][i1]);
            }
            let idValue = "value" + seriesIndex + "_" + i1 + "textcolor";
            let legendIdValue = "legendvaluetextcolor";
            let valueTextColor = this._data.children[seriesIndex].getAttribute(idValue) || this._data.children[seriesIndex].getAttribute(legendIdValue) || "";
            this.valueTextColor[seriesIndex].push(valueTextColor);
        }
        let totalValueIdValue = "totalvalue" + seriesIndex + "textcolor";
        let totalValueTextColor = this._data.children[seriesIndex].getAttribute(totalValueIdValue) || "";
        this._totalValueTextColor.push(totalValueTextColor);
        this._maxValueSeriesItems.push(seriesItemMaxvalue);
        // if (this._boolcommonPlaceholder) {
        //     let strCompareCommonPlacHolderPath = this.data.getAttribute("commonplaceholderpath");
        //     let strCompareCommonPlacHolder = this.data.getAttribute("commonplaceholder");
        //     let placholderPaths =[];
        //     if (strCompareCommonPlacHolder) {
        //         if(strCommonPlacHolderPath){
        //             placholderPaths = strCommonPlacHolderPath.split(",")
        //             for(let j1=0;j1<placholderPaths.length;j1++){
        //                 placholderPaths[j1] = this._boolcommonPlaceholder=="image"?placholderPaths[j1]&&!placholderPaths[j1].includes(".svg")?placholderPaths[j1]:this._serverUrl+"genericassets/placeholderimages/placeholder.png":placholderPaths[j1];
        //             }
        //             for(let k1=(placholderPaths.length-1);k1<length;k1++)
        //             {
        //                 placholderPaths[k1] = this._boolcommonPlaceholder=="image"?placholderPaths[k1]&&!placholderPaths[k1].includes(".svg")?placholderPaths[k1]:this._serverUrl+"genericassets/placeholderimages/placeholder.png":placholderPaths[k1];
        //             }
        //         }
        //     } else {
        //         for(let j2=0;j2<length;j2++){
        //             placholderPaths[j2] = this._boolcommonPlaceholder=="image"?placholderPaths[j2]&&!placholderPaths[j2].includes(".svg")?strCommonPlacHolderPath:this._serverUrl+"genericassets/placeholderimages/placeholder.png":"placeholder";
        //         }
        //     }
        //     this.commonplacholder = placholderPaths;
        //     let strCommonPlacHolder = placholderPaths.join(",")
        //     chartItem.setAttribute("commonplaceholderpath",strCommonPlacHolder)
        // }
        if (length > 1 || this.seriesanimation) {
            let legendLength = this._seriesItemLength; //this._data.children[0].getAttribute("value").split(",").length;
            let txtMultiSeriesLegend = this._data.getAttribute("multiserieslegend");
            let strSeriesItemLabel = this._data.getAttribute("seriesitemlabel");
            if (!!strSeriesItemLabel) {
                this.txtMultiSeriesLegend = this._data.getAttribute("seriesitemlabel");
            }
            if (!!txtMultiSeriesLegend) {
                this._legendLabels = !!strSeriesItemLabel ? this.txtMultiSeriesLegend.split("^") : txtMultiSeriesLegend.split(",");
                if (this._legendLabels.length < legendLength) {
                    for (let j2 = this._legendLabels.length; j2 < legendLength; j2++) {
                        this._legendLabels[j2] = "";
                    }
                }
            } else {
                for (let i1 = 0; i1 < legendLength; i1++) {
                    this._legendLabels[i1] = "";
                }
            }

            if (!!strSeriesItemLabel) {
                this._seriesItemLabels = this._data.getAttribute("seriesitemlabel").split("^");
                if (this._seriesItemLabels.length < legendLength) {
                    for (let j2 = this._seriesItemLabels.length; j2 < legendLength; j2++) {
                        this._seriesItemLabels[j2] = "";
                    }
                }
            } else {
                this._seriesItemLabels = this._legendLabels;
            }
            let strMultiSeriesLegend = this._legendLabels.join(",");
            if (strMultiSeriesLegend.includes(":legendcolor:")) {
                for (let l1 = 0; l1 < this._legendLabels.length; l1++) {
                    this._legendLabels[l1] = this._legendLabels[l1].replaceAll(":legendcolor:", ",");
                }
            }
            if (this._showSeriesItemLabel) this._data.setAttribute("seriesitemlabel", this._seriesItemLabels.join("^"));
            if (!this._showSeriesItemLabel && this._showLegend) this._data.removeAttribute("seriesitemlabel");
            this._data.setAttribute("multiserieslegend", strMultiSeriesLegend);
        }

        this._stackSeriesvalueTotal[seriesIndex] = this.stackValue;
        this._maxStackValueTotal = this._maxStackValueTotal < this._stackValue ? this._stackValue : this._maxStackValueTotal;
        if (!!this.baseProperties.scatter && strValue != null) {
            this._xValues[seriesIndex] = strValue.split(",")[0];
            this._yValues[seriesIndex] = strValue.split(",").length < 2 ? 0 : strValue.split(",")[1];
            if (this.baseProperties.maxAllowedSeriesItems == 3) {
                this._size[seriesIndex] = strValue.split(",").length < 3 ? 10 : strValue.split(",")[2];
            }
        }
        if (!!this.baseProperties.scatter) this.validationForScatterMaxMinValues();

        this._itemPlacehoders[seriesIndex] =
            strItemPlaceholder == null || strItemPlaceholder == ""
                ? this._chartDefaultValue.itemPlaceholderGroup[ChartUtils.getFactorIndex(seriesIndex, this._chartDefaultValue.itemPlaceholderGroup.length)]
                    ? this._chartDefaultValue.itemPlaceholderGroup[ChartUtils.getFactorIndex(seriesIndex, this._chartDefaultValue.itemPlaceholderGroup.length)].id
                    : strItemPlaceholder
                : strItemPlaceholder;
        this._itemPlacehodersType[seriesIndex] = (strItemPlaceholderType == null || strItemPlaceholderType == "") && this._chartDefaultValue.itemPlaceholderType[seriesIndex] ? this._chartDefaultValue.itemPlaceholderType[seriesIndex] : strItemPlaceholderType;
        this._itemPlaceholderPath[seriesIndex] = (strItemPlaceHolderPath == null || strItemPlaceHolderPath == "") && this._chartDefaultValue.itemPlaceholderType[seriesIndex] ? this._chartDefaultValue.itemPlaceholderPath[seriesIndex] : strItemPlaceHolderPath;

        if (length <= 1) {
            this._seriesValueTotal += parseInt(this._values[seriesIndex]);
        }
        // this._prefix[seriesIndex] = ""; //prefix!=null?prefix.split(","):"";
        // this._suffix[seriesIndex] = suffix != null ? suffix.split(",") : "";
        // this._currencySymbol[seriesIndex] = currencySymbol != null ? currencySymbol.split(",") : "";
        // this._denominationPrefix[seriesIndex] = denomination != null ? denomination.split(",") : "";
        this._seriesItemLength = this._seriesItemLength < this._values[seriesIndex].length ? this._values[seriesIndex].length : this._seriesItemLength;
        this._seriesItemLength = this.baseProperties.maxAllowedSeriesItems < this._seriesItemLength ? this.baseProperties.maxAllowedSeriesItems : this._seriesItemLength;
        if (this._secondaryLineChart && this._seriesItemLength > 1) {
            this._seriesItemLength -= 1;
        }
        for (var key in arrData) {
            if (arrData[key] == layout) {
                this._seriesItemLength = 1;
            }
        }
        if (this._seriesItemLength > 1) {
            // this._indualHighlight =false;
            this.data.setAttribute("enablemultiSeries", "true");
        } else {
            this.data.removeAttribute("enablemultiSeries");
        }
        if (labeltextsize) {
            this.voLayout.labelfontsize = parseFloat(labeltextsize);
            if (this._seriesItemLength == 1) this.voLayout.legendLabelFonSize = parseFloat(labeltextsize);
        }
        if ((strHighlight == "true" && this.chartName == "assetPercentageChart") || chartItem.getAttribute("dummeyhighlight")) {
            chartItem.removeAttribute(ChartPropertiesName.highlight);
            strHighlight = "";
        }
        let midPoint = parseInt(this._seriesLength / 2);
        if (this.data.getAttribute("removeHighlight") != "true" && this.voLayout.highlightStyleShow && seriesIndex == midPoint) {
            strHighlight = "true";
            chartItem.setAttribute(ChartPropertiesName.highlight, true);
            chartItem.setAttribute("dummeyhighlight", true);
        }
        this._highlights[seriesIndex] = strHighlight == "true" ? true : false;
        this._lineStyleHightlightValue[seriesIndex] = boolLineStyleValueShow;
        if (this.data.getAttribute("highlightvalue") == "false") {
            this.lineHighlightPoint = "";
        }
        this._labels[seriesIndex] = strName == null || strName == "" ? "" : strName; //this._chartDefaultValue.label

        this._comparisonLabel[seriesIndex] = strComparisonName == null || strComparisonName == "" ? "" : strComparisonName; //this._chartDefaultValue.label
        if (this._chartName == "comparisonModelType3") {
            chartItem.setAttribute("comparisonname", this._comparisonLabel[seriesIndex]);
        }
        this._secondaryText[seriesIndex] = secondarName == null || secondarName == "" ? "" : secondarName;
        this._arrHyperlinkUrl[seriesIndex] = chartItem.getAttribute("data-navigate-to-slide-on-click");

        let updateAiGraphicImage = this._data.children[seriesIndex].getAttribute("needassetupdate") || "";
        let imageChangeByUser = this._data.children[seriesIndex].getAttribute("userchangeimage") == "true" || "";
        let assetUpdateedText = this._data.children[seriesIndex].getAttribute("assetsearchtext") || this._labels[seriesIndex];
        updateAiGraphicImage = imageChangeByUser ? "false" : updateAiGraphicImage;
        if (updateAiGraphicImage == "true") {
            this._arrGraphicImagePrompt.push(assetUpdateedText);
        } else if (updateAiGraphicImage == "false") {
            this._arrGraphicImagePrompt.push("");
        } else {
            this._arrGraphicImagePrompt.push("");
        }

        if (this.voLayout.secondaryElement) {
            this.data.setAttribute("secondaryplaceholder", "image");
            let secondarydefaultPlaceHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
            let tempSecondaryPath = chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderPath);
            let secondaryplaceholderPath = tempSecondaryPath ? tempSecondaryPath : secondarydefaultPlaceHolder;
            this._secondaryPlaceholderPath[seriesIndex] = secondaryplaceholderPath;
        }
        if (this.voLayout.secondaryElementType == "icon") {
            this.data.setAttribute("secondaryplaceholder", "icon");
            let secondarydefaulticonPlaceHolder = defaultIconPath ? defaultIconPath : "genericassets/icons/placeholder/placeholder.svg";
            let tempSecondaryiconPath = chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderPath);
            let secondaryiconplaceholderPath = tempSecondaryiconPath ? tempSecondaryiconPath : this._serverUrl + secondarydefaulticonPlaceHolder;
            this._secondaryPlaceholderPath[seriesIndex] = secondaryiconplaceholderPath;
        }
        if ((strPlaceholderType == null || strPlaceholderType == "") && this._customProperties.primaryPlaceholder) {
            this._data.setAttribute("primaryplaceholder", "true");
            strPlaceholderType = "ICON";
        }
        // if (strSecondaryPlaceholderType == null || strSecondaryPlaceholderType == "") {
        //     this._data.setAttribute("secondaryplaceholder", "true");
        //     strSecondaryPlaceholderType = "ICON";
        // }
        if (this.legendPlaceHolderType && (strPlaceholderType == "icon" || strPlaceholderType == "ICON")) {
            strGraphicImage = false;
        }
        if (strPlaceholderType == "icon") {
            strPlaceholderType = "ICON";
        }
        if (((strSecondaryPlaceHolder == null || strSecondaryPlaceHolder == "") && this._customProperties.secondaryPlaceholder) || (strSecondaryPlaceholderType === "logo" && strSecondaryPlaceHolder && strSecondaryPlaceHolder.includes(".svg"))) {
            let defaultPlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            strSecondaryPlaceHolder = strSecondaryPlaceholderType === "ICON" ? (this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]) : defaultPlaceHolder;
            strSecondaryPlaceHolder = strSecondaryPlaceholderType === "logo" && strSecondaryPlaceHolder && strSecondaryPlaceHolder.includes(".svg") ? defaultPlaceHolder : strSecondaryPlaceHolder;
            chartItem.setAttribute(ChartPropertiesName.secondaryplaceholder, strSecondaryPlaceHolder);
            strSecondaryPlaceholderType === "ICON" ? chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholderPath, this._chartPlaceHolder) : chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholderPath, this._chartPlaceHolder);
        }
        if (((strSecondaryPlaceHolder == null || strSecondaryPlaceHolder == "") && this._customProperties.secondaryPlaceholder) || (strSecondaryPlaceholderType === "image" && strSecondaryPlaceHolder && strSecondaryPlaceHolder.includes(".svg"))) {
            let defaultPlaceHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
            if (strSecondaryPlaceHolder == "logo") {
                defaultPlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            }
            strSecondaryPlaceHolder = strSecondaryPlaceholderType === "ICON" ? (this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]) : defaultPlaceHolder;
            strSecondaryPlaceHolder = strSecondaryPlaceholderType === "image" && strSecondaryPlaceHolder && strPlaceHolder && strPlaceHolder.includes(".svg") ? defaultPlaceHolder : strSecondaryPlaceHolder;
            chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholderPath, strSecondaryPlaceHolder);
            strSecondaryPlaceholderType === "ICON" ? chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholderPath, this._chartPlaceHolder) : chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholderPath, this._chartPlaceHolder);
        }
        if (((strPlaceHolder == null || strPlaceHolder == "") && this._customProperties.primaryPlaceholder) || (strPlaceholderType === "image" && strPlaceHolder && strPlaceHolder.includes(".svg"))) {
            let defaultPlaceHolder = defaultImagePath ? defaultImagePath : arrDefaultplaceholderimage.length > 0 ? this.getFactorIndex : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
            if (strPlaceholderType == "logo") {
                defaultPlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            }
            if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
                defaultPlaceHolder = this._serverUrl + "genericassets/placeholderimages/logoplaceholder_landscape.png";
            }
            strPlaceHolder = strPlaceholderType === "ICON" || strPlaceholderType === "icon" ? (this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]) : defaultPlaceHolder;
            if ((strPlaceholderType === "ICON" || strPlaceholderType === "icon") && strPlaceHolder && strPlaceHolder.includes(".svg") && this._chartPlaceHolder.split("/").length > 4) {
                strPlaceHolder = strPlaceHolder.split(".")[0];
            }
            strPlaceHolder = strPlaceholderType === "image" && strPlaceHolder && strPlaceHolder.includes(".svg") ? defaultPlaceHolder : strPlaceHolder;
            chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, defaultIconId || strPlaceHolder);
            strPlaceholderType === "ICON" || strPlaceholderType === "icon" ? chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderPath, this._chartPlaceHolder) : chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderPath, this._chartPlaceHolder);
        }
        if (((strPlaceHolder == null || strPlaceHolder == "") && this._customProperties.primaryPlaceholder) || (strPlaceholderType === "logo" && strPlaceHolder && strPlaceHolder.includes(".svg") && !strPlaceHolder.includes(".png"))) {
            let defaultPlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            strPlaceHolder = strPlaceholderType === "ICON" || strPlaceholderType === "icon" ? (this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]) : defaultPlaceHolder;
            strPlaceHolder = strPlaceholderType === "logo" && strPlaceHolder && strPlaceHolder.includes(".svg") ? defaultPlaceHolder : strPlaceHolder;
            chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, strPlaceHolder);
            strPlaceholderType === "ICON" || strPlaceholderType === "icon" ? chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderPath, this._chartPlaceHolder) : chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderPath, this._chartPlaceHolder);
        }
        if (this.voLayout.showPlaceholder || ((strPlaceholderType == "ICON" || strPlaceholderType == "icon") && this.legendPlaceHolderType)) chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderType, strPlaceholderType);
        if (strPlaceholderType) strPlaceholderType = strPlaceholderType.toUpperCase();
        if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
            strPlaceHolder = true;
        }
        if (strPlaceHolder) {
            if (strPlaceholderType === "ICON" || strPlaceholderType === "icon") {
                this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
                if (this.legendPlaceHolderType && !this._primaryPlaceholderPath[seriesIndex]) {
                    this._primaryPlaceholderPath[seriesIndex] = "placeholder";
                }

                if (this._primaryPlaceholderPath[seriesIndex].split(".").length != 1 || this._primaryPlaceholderPath[seriesIndex].includes("http")) {
                    this._primaryPlaceholderPath[seriesIndex] = this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]; //this._chartPlaceHolder[seriesIndex].id;
                    chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, defaultIconId || this._primaryPlaceholderPath[seriesIndex]);
                }
                const arrPathSplit = this._primaryPlaceholderPath[seriesIndex].split("/");
                this._primaryPlaceholderName[seriesIndex] = arrPathSplit[arrPathSplit.length - 1];
            } else if (strPlaceholderType === "IMAGE") {
                this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
                if (
                    !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
                    (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
                    !this._primaryPlaceholderPath[seriesIndex].includes("http") ||
                    this._primaryPlaceholderPath[seriesIndex].includes("logoimage.png")
                ) {
                    let defaultImageHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
                    if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
                        defaultImageHolder = "genericassets/placeholderimages/logoplaceholder_landscape.png";
                    }
                    this._primaryPlaceholderPath[seriesIndex] = defaultImageHolder;
                }
            } else if (strPlaceholderType === "LOGO") {
                this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
                if (!chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) || (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) || !this._primaryPlaceholderPath[seriesIndex].includes("http")) {
                    let defaultImageHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
                    this._primaryPlaceholderPath[seriesIndex] = defaultImageHolder;
                }
            }
            this._primaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholderType);
        }
        if (this._compareDivider && this._comparePlaceholder) {
            this._primaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholderType);
        }
        if (strSecondaryPlaceHolder) {
            if (strSecondaryPlaceholderType === "ICON") {
                this._secondaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.secondaryplaceholder);
                if (this._secondaryPlaceholderPath[seriesIndex].split(".").length != 1 || this._secondaryPlaceholderPath[seriesIndex].includes("http")) {
                    this._secondaryPlaceholderPath[seriesIndex] = this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]; //this._chartPlaceHolder[seriesIndex].id;
                    chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholder, this._secondaryPlaceholderPath[seriesIndex]);
                }
                const arrSecondaryPathSplit = this._secondaryPlaceholderPath[seriesIndex].split("/");
                this._secondaryPlaceholderName[seriesIndex] = arrSecondaryPathSplit[arrSecondaryPathSplit.length - 1].split(".")[0];
            }
            // else if (strSecondaryPlaceholderType === "IMAGE") {
            //     this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
            //     if (
            //         !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
            //         (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
            //         !this._primaryPlaceholderPath[seriesIndex].includes("http") ||
            //         this._primaryPlaceholderPath[seriesIndex].includes("logoimage.png")
            //     ) {
            //         let defaultImageHolder = "genericassets/placeholderimages/placeholder.png";
            //         if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
            //             defaultImageHolder = "genericassets/placeholderimages/logoplaceholder_landscape.png";
            //         }
            //         this._primaryPlaceholderPath[seriesIndex] = this._serverUrl + defaultImageHolder;
            //         chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
            //     }
            // } else if (strSecondaryPlaceholderType === "LOGO") {
            //     this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
            //     if (
            //         !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
            //         (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
            //         !this._primaryPlaceholderPath[seriesIndex].includes("http")
            //     ) {
            //         let defaultImageHolder = "genericassets/placeholderimages/logoimage.png";
            //         this._primaryPlaceholderPath[seriesIndex] = this._serverUrl + defaultImageHolder;
            //         chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
            //     }
            // }
            this._secondaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderType);
        }

        if (strGraphicImage) {
            if (!strItemGraphicPath) {
                let defaultItemPlaceHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
                if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
                    defaultItemPlaceHolder = this._serverUrl + "genericassets/placeholderimages/logoplaceholder_landscape.png";
                }
                strItemGraphicPath = defaultItemPlaceHolder;
            }
            this._grapicImage[seriesIndex] = "true";
            this._itemGraphicPath[seriesIndex] = strItemGraphicPath;
            chartItem.setAttribute(ChartPropertiesName.itemGraphicPath, strItemGraphicPath);
        } else {
            this._grapicImage[seriesIndex] = "false";
            this._itemGraphicPath[seriesIndex] = "";
            if (strItemGraphicPath) {
                chartItem.removeAttribute(ChartPropertiesName.itemGraphicPath);
            }
        }

        if (this.baseProperties.hasEmphasis && strEmphasis == "true") {
            this._emphasisCount++;
            this._hasEmphasis = true;
            this._emphasis[seriesIndex] = true;
        } else {
            this._emphasis[seriesIndex] = false;
        }

        if ((this.baseProperties.hasProjectionEnable && strProjection == "true") || this._hasProjection) {
            if (this._projectionStartIndex == "") this._projectionStartIndex = seriesIndex;
            this._hasProjection = true;
            this._boolEnableProjectiontext = "true";
            this._projection[seriesIndex] = true;
        } else {
            this._hasProjection = false;
            this._boolEnableProjectiontext = "";
            this._projection[seriesIndex] = false;
        }
        if (!this.data.hasAttribute("boolprojectiontext") && this._hasProjection) {
            this.data.setAttribute("boolprojectiontext", "true");
        } else if (this.data.hasAttribute("boolprojectiontext") == "true" && !this._hasProjection) {
            this.data.removeAttribute("boolprojectiontext");
        }
        for (let i1 = 0; i1 < length; i1++) {
            if (this._customProperties.showDataPoints == true) {
                if (this._customProperties.datapoint == "F" && seriesIndex == 0) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "L" && seriesIndex == this._seriesLength - 1) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "F,L" && (seriesIndex == this._seriesLength - 1 || seriesIndex == 0)) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "H" || this._customProperties.datapoint == "LO" || this._customProperties.datapoint == "L,H") {
                    this._valueDisplayFormat[seriesIndex + " " + i1] = "hidden";
                } else if (this._customProperties.datapoint == "true" || this._customProperties.datapoint == "all" || this._customProperties.datapoint == "") this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else this._valueDisplayFormat[seriesIndex + " " + i1] = "hidden";
            } else if (this._customProperties.showDataPoints == false) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
            if (this._lineHighlightPoint && this._chartName == "lineChart" && this._highlights[seriesIndex] && this._lineStyleHightlightValue[seriesIndex] == "true") {
                this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
            }
        }

        // for (let i2 = 0; i2 < length; i2++) {
        //     if (this._customProperties.showDataPoints == true) {
        //         if (this._customProperties.datapoint == "F" && seriesIndex == 0) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "L" && seriesIndex == this._seriesLength - 1) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "F,L" && (seriesIndex == this._seriesLength - 1 || seriesIndex == 0)) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "H"||this._customProperties.datapoint == "LO"||this._customProperties.datapoint == "L,H") {
        //             this._valueDisplayFormat[seriesIndex + " " + i2] = "hidden";
        //         }
        //         else if (this._customProperties.datapoint == "true" || this._customProperties.datapoint == "all" || this._customProperties.datapoint == "")
        //             this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else this._valueDisplayFormat[seriesIndex + " " + i2] = "hidden";
        //     } else if (this._customProperties.showDataPoints == false) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        // }
        if (this._showStatistical) {
            for (let s2 = 0; s2 < 2; s2++) {
                let tempValue = parseFloat(this._values[seriesIndex][0]) - parseFloat(this._values[seriesIndex][1]);
                let deciamlCount = tempValue.toString().split(".").length > 1 ? tempValue.toString().split(".")[1].length : 0;
                if (deciamlCount > 2) {
                    tempValue = tempValue.toFixed(2);
                }
                this.statisticalValues[seriesIndex] = tempValue;
            }
            this._seriesItemLength = 1;
        }
        this._primaryPlaceholderPathData[seriesIndex] = chartItem.getAttribute("primaryplaceholderpath") ? chartItem.getAttribute("primaryplaceholderpath") : chartItem.getAttribute("secondaryplaceholderpath");
    }
    if (this.baseProperties.hadCagr && this._data.getAttribute("cagr") == "true" && this._seriesItemLength > 1) {
        this._enableChartCagr = true;
    }
    if (!this._indualHighlight && this.data.getAttribute("data-highlightdifference") == "true" && this._indualHighlightDisplayFormat == "customlabel") {
        let valueSingleHdDisplayText = this.data.getAttribute(ChartPropertiesName.hdcustomtext) ? this.data.getAttribute(ChartPropertiesName.hdcustomtext) : "";
        if (valueSingleHdDisplayText) {
            this._hddisplayformat = valueSingleHdDisplayText.split(",");
        }
        this.data.setAttribute(ChartPropertiesName.hdcustomtext, this._hddisplayformat?.join(","));
    }
    if (this._labelTextBold) {
        this._data.setAttribute("labeltextfontbold", this._labelTextBold);
    } else {
        this._data.removeAttribute("labeltextfontbold");
    }
    if (this._labelTextItalic) {
        this._data.setAttribute("labeltextfontitalic", this._labelTextItalic);
    } else {
        this._data.removeAttribute("labeltextfontitalic");
    }
    if (this._secondaryLabelTextBold) {
        this._data.setAttribute("secondarylabeltextfontbold", this._secondaryLabelTextBold);
    } else {
        this._data.removeAttribute("secondarylabeltextfontbold");
    }
    if (this._secondaryLabelTextItalic) {
        this._data.setAttribute("secondarylabeltextfontitalic", this._secondaryLabelTextItalic);
    } else {
        this._data.removeAttribute("secondarylabeltextfontitalic");
    }
    let chartGroupDatas = this.groupTrueValuesWithIndices(this._groupNodes);
    this.arrChartGroupDatas = chartGroupDatas?.array;
    this.groupGapCount = chartGroupDatas?.gapcount;
    this.groupCount = this.arrChartGroupDatas?.length;
    this._groupNodeCount = chartGroupDatas?.groupNodeCount;
    this.groupOrderIndex = chartGroupDatas?.groupOrderIndex;
    if (this.groupCount > 0) {
        let chartGroupLabel = this._data.getAttribute("chartgrouptext");
        if (!chartGroupLabel) {
            for (let i = 0; i < this.groupCount; i++) {
                this._chartGroupLabel[i] = "";
            }
        } else if (this._chartGroupLabel.length < this.groupCount) {
            for (let i = this._chartGroupLabel.length; i < this.groupCount; i++) {
                this._chartGroupLabel[i] = "";
            }
        }
        this._data.setAttribute("chartgrouptext", this._chartGroupLabel.join("^"));
    }
    if (this._secondaryLineChart) {
        let temValues = [];
        for (let i = 0; i < this._values.length; i++) {
            temValues[i] = [];
            for (let j = 0; j < this._values[i].length; j++) {
                if (j < this._values[i].length - 1) {
                    temValues[i].push(this._values[i][j]);
                } else {
                    this._secondaryLineValues.push(this._values[i][j]);
                }
            }
        }
        this._values = temValues;
    }
    let hasIconNode = this._primaryPlaceholderType.length > 0 ? this._primaryPlaceholderType.indexOf("ICON") > -1 : false;
    let hasLogoNode = this._primaryPlaceholderType.length > 0 ? this._primaryPlaceholderType.indexOf("logo") > -1 : false;
    if (hasLogoNode && hasIconNode) {
        this._hasIconLogoNode = true;
    } else {
        this._hasIconLogoNode = false;
    }
    this._customValueFontSize = this._data.getAttribute("valuetexttextsize") && this._data.getAttribute("valuetexttextsize") != "auto" ? parseFloat(this._data.getAttribute("valuetexttextsize")) : this._customValueFontSize;
    this._customValueFontBold = this._data.getAttribute("valuetextfontbold") == "true" ? true : false;
    this._customValueFontItalic = this._data.getAttribute("valuetextfontitalic") == "true" ? true : false;
    this._customValueFontClass = this._data.getAttribute("data-customfontsizeclass") ? this._data.getAttribute("data-customfontsizeclass") : "";
    this._customValueOpacity = this._data.getAttribute("valuetexttextopacity") && this._data.getAttribute("valuetexttextopacity") != "auto" ? parseFloat(this._data.getAttribute("valuetexttextopacity")) : null;
    this._customTitleFontClass = this._data.getAttribute("data-titlefontclass") && this._data.getAttribute("data-titlefontclass") != "auto" ? this._data.getAttribute("data-titlefontclass") : "";
    this._customValueTextLineHeight = this._data.getAttribute("valuetextlineheight") && this._data.getAttribute("valuetextlineheight") != "auto" ? parseFloat(this._data.getAttribute("valuetextlineheight")) : "";
    this._customValueTextLetterSpacing = this._data.getAttribute("valuetextletterspace") && this._data.getAttribute("valuetextletterspace") != "auto" ? parseFloat(this._data.getAttribute("valuetextletterspace")) : "";

    this.hasCenter = this._chartName == "columnSimpleRectangle" && this.voLayout.labelInset == "inside" && this.voLayout.valueInset == "inside";
    let defaultArrowPosition = this.seriesItemLength == 2 ? "both" : "end";
    this._indualHighlightReverse = this._data.getAttribute("indualhdrev") ? this._data.getAttribute("indualhdrev") : defaultArrowPosition;
    this.sorValues(this._customProperties.sortType);
    if (this.baseProperties.oneatatime) {
        this.data.setAttribute("oneatatimeanimation", "true");
    }
    this.setLayout();
    this._longLabel = ChartHelper.getlabelRange(this._labels, this.data.getAttribute("labelheader"));
    if (this._chartName == "comparisonModelType3") {
        this._longLabel = ChartHelper.getCompareLabelRange(this._comparisonLabel, this._longLabel);
    }
    this._longsecondaryLabel = ChartHelper.getsecondarylabelRange(this._secondaryText);

    // const valuesRange = ChartHelper.getValuesRange(this._values, this.customProperties.showYAxisGrid, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems);
    let valuesRange = ChartHelper.getValuesRange(this._values, false, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems, this._displayValueFormat);
    let longValue = "";
    if (this._showStatistical) {
        valuesRange = ChartHelper.getValuesRange(this._values, false, this._customProperties.yAxisMaxValue, 1, this._displayValueFormat);
    }
    if (this._chartName == "dumbellChart" || this._chartName == "verticalDumbellChart") {
        let differenceCount = 9;
        if ((this._customProperties.yAxisMaxValue && valuesRange.rangeTotal + differenceCount < this._customProperties.yAxisMaxValue) || !this._customProperties.yAxisMaxValue) {
            valuesRange = ChartHelper.getValuesRange(this._values, false, valuesRange.rangeTotal + differenceCount, 1, this._displayValueFormat);
        }
    }
    this._longValue = longValue ? longValue : valuesRange.longValue;
    this._rangeTotal = valuesRange.rangeTotal;
    this._totalValue = valuesRange.totalValue;
    this._rangePositive = valuesRange.rangePositive;
    this._rangeNegative = valuesRange.rangeNegative;
    this._seconPostiveHighValue = valuesRange.secondPositiveHighValue;
    this._seconNagativeHighValue = valuesRange.secondNegativeHighValue;
    this._minValue = valuesRange.minvalue;
    this._postiveMaxValue = valuesRange.rangePositive;
    this._longLengthValue = valuesRange.longLengthValue;
    this._seriesItemMaxValue = valuesRange.seriesItemMaxValue;
    this._maxValueSeconPostiveHighValue = valuesRange.hasMaxSecondHighValue;
    if (this._rangePositive == 0 && this._rangeNegative == 0) {
        this._rangePositive = 1;
        this._rangeTotal = 1;
        this._totalValue = 1;
        this._postiveMaxValue = 1;
        this._longLengthValue = 1;
    }
    if (this._minValue < 0 || this._seriesLength > 15 || (this._seriesItemLength > 1 && this._seriesLength > 10)) {
        this._indualHighlight = false;
    }
    if (this._secondaryLineChart) {
        let minRangeValue = Math.min(...this._secondaryLineValues.map(Number));
        this._secondaryLineMinValue = minRangeValue;
        if (this._rangeNegative > -1 && this._secondaryLineMinValue < 0) {
            this.secondarylineNegativeValue = true;
            this._rangeNegative = this._secondaryLineMinValue;
        }
        let maxRangeValue = Math.max(...this._secondaryLineValues.map(Number));
        this._secondaryLineMaxValue = maxRangeValue;
        if (this._rangePositive < 1 && this._secondaryLineMaxValue > 0) {
            this.secondarylinePositiveValue = true;
            this._rangePositive = this._secondaryLineMaxValue;
        }
    }

    if (this._seconPostiveHighValue < 1) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    // if(this._displayValueFormat == "percentage"){
    //     this._valuesDenomination[seriesIndex][i1] =
    // }
    this.data.setAttribute("minvalue", this._minValue);
    if (this.data.getAttribute("valueprefixtype") && this.data.getAttribute("valueprefixtype").split(",").length > 0) {
        let prefix = this.data.getAttribute("valueprefixtype").split(",")[0];
        this._longLengthValue = prefix + valuesRange.longLengthValue;
    }
    if (this.data.getAttribute("valuesuffixtype") && this.data.getAttribute("valuesuffixtype").split(",").length > 0) {
        let suffix = this.data.getAttribute("valuesuffixtype").split(",")[0];
        this._longLengthValue += suffix;
    }
    let differencePostivePercentage = this._rangePositive / this._seconPostiveHighValue > 1000;
    let differenceNegativePercentage = this._rangeNegative / this._seconNagativeHighValue > 1000;
    let minNodeCount = parseInt(this._seconPostiveHighValue).toString().length;
    let maxNodeCount = parseInt(this._postiveMaxValue).toString().length;
    if (this._minValue < 0) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    let svaluesRange = ChartHelper.getValuesRange(this._secondaryValues, false, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems, this._displayValueFormat);
    this._slongValue = svaluesRange.longValue;
    this._srangeTotal = svaluesRange.rangeTotal;
    this._stotalValue = svaluesRange.totalValue;
    this._srangePositive = svaluesRange.rangePositive;
    this._srangeNegative = svaluesRange.rangeNegative;
    this._sseconPostiveHighValue = svaluesRange.secondPositiveHighValue;
    this._sseconNagativeHighValue = svaluesRange.secondNegativeHighValue;
    this._sminValue = svaluesRange.minvalue;
    this._spostiveMaxValue = svaluesRange.rangePositive;
    this._slongLengthValue = svaluesRange.longLengthValue;
    // if(differenceNegativePercentage||differencePostivePercentage){
    //     this._highValueBreak = true;
    // }
    if (this.customProperties.showYAxisGrid && !this._customProperties.yAxisMaxValue && this._minValue < 0 && !this._highValueBreak) {
        let dummeyNegativeValue = -this._rangeNegative;
        let maxTotalValue = dummeyNegativeValue + this._rangePositive;
        let gapValues = maxTotalValue / 5;
        let gapCount = gapValues;
        let DummeyCont = 0;
        // this._rangeNegative = this._rangeNegative-20;
        // this._rangePositive = dummeyNegativeValue*4;
        // this._rangeTotal = (this._rangePositive);
        let negativeSideValue = 0;
        while (dummeyNegativeValue > negativeSideValue) {
            DummeyCont++;
            negativeSideValue = gapValues * DummeyCont;
            if (negativeSideValue > dummeyNegativeValue) {
                if (this._chartName == "lineChart") {
                    this._rangeNegative = -negativeSideValue;
                }
                this._negativeGridCount = DummeyCont;
                break;
            }
        }
        let secondaryDummeyCont = 5 - DummeyCont;
        let positiveSideValue = 0;
        while (this._rangePositive > positiveSideValue) {
            positiveSideValue = gapValues * secondaryDummeyCont;
            if (positiveSideValue >= this._rangePositive) {
                this._positiveGridCount = secondaryDummeyCont;
                if (this.baseProperties.referenceName != "bar") {
                    // this._rangePositive = positiveSideValue;
                    // this._rangeTotal = positiveSideValue;
                }
                break;
            }
            secondaryDummeyCont++;
        }
    }
    if (this._chartName == "barStackedRectangle" || this._stackedChart) this._rangeTotal = this._maxStackValueTotal;
    this._gridCount = ChartHelper.gridCountValidation(this._rangeTotal, this.gridCount);
    // if (this.rangeNegative < 0) {
    //     this.customProperties.showYAxisGrid = false;
    //     this.customProperties.showYAxisLine = false;
    //     this.customProperties.showXAxisLine = false;
    //     this.customProperties.showYAxisGridValue = false;
    // }
    let valuedifference = maxNodeCount - minNodeCount >= 3;
    if (valuedifference) {
        if (!this.presentMode) this.data.setAttribute("highvaluebreak", "true");
    } else {
        this.data.removeAttribute("highvaluebreak");
    }

    if (!this.baseProperties.highvaluebreak) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
    }
    this._highValueBreak = (this.data.getAttribute("highvaluebreak") == "true" && this.data.getAttribute("userhighvaluebreak") != "false") || this.data.getAttribute("userhighvaluebreak") == "true" ? true : false;
    if (this._seconPostiveHighValue < 1) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    if (this._highValueBreak) {
        this._gridCount = 5;
    } else {
        this.data.removeAttribute("highvaluebreak");
    }
    if (this.highvaluebreak && this.voLayout.labelItemBased != "true") {
        this.customProperties.showYAxisGrid = true;
    }
    this._arrSeriesItemValueTotal = [];
    this._arrseriesItemHighValue = [];
    this.hasSeriesItemHighlight = false;
    let strSeriesItemHighValue = this.data.getAttribute("seriesitemhighlightindex");
    let arrSeriesItemHighValue = [];
    if (strSeriesItemHighValue) {
        arrSeriesItemHighValue = strSeriesItemHighValue.split(",");
    }
    for (let s1 = 0; s1 < this._seriesLength; s1++) {
        let seriesItemValueTotal = 0;
        for (let k1 = 0; k1 < this._seriesItemLength; k1++) {
            seriesItemValueTotal += parseFloat(this._values[s1][k1]);
            if (this._customProperties.showDataPoints == true) {
                if (this._customProperties.datapoint == "H" || this._customProperties.datapoint == "L,H") {
                    if (this._longValue == this._values[s1][k1]) {
                        this._valueDisplayFormat[s1 + " " + k1] = "visible";
                    }
                }
                if (this._customProperties.datapoint == "LO" || this._customProperties.datapoint == "L,H") {
                    if (valuesRange.minvalue == this._values[s1][k1]) {
                        this._valueDisplayFormat[s1 + " " + k1] = "visible";
                    }
                }
            }
            if (this.statisticalValues.length > 0) {
                this._statiSticalLongValue = this.statisticalValues[s1].length > this._statiSticalLongValue.length ? this.statisticalValues[s1] : this._statiSticalLongValue;
            }
            if (this._suffix[s1][k1] == "%" && !this.baseProperties.maxPercentageValue && this._displayValueFormat != "percentage") this._suffix[s1][k1] = "";
            if ((this._displayValueFormat == "currency" || this._displayValueFormat == "asentered") && this._valuesDenomination[s1][k1] && this._valuesDenomination[s1][k1].includes("$") && this._prefix[s1][k1].includes("$")) {
                this._prefix[s1][k1] = "";
            }
            this._longTotalValue = this._longTotalValue.length < this._values[s1][k1]?.toString()?.length ? this._values[s1][k1] : this._longTotalValue;
            if (arrSeriesItemHighValue.includes(k1.toString())) {
                this._arrseriesItemHighValue.push("true");
                this.hasSeriesItemHighlight = true;
            } else {
                this._arrseriesItemHighValue.push("false");
            }
        }
        this._arrSeriesItemValueTotal.push(seriesItemValueTotal);
    }
    this.getLongValue();
    if (this._displayValueFormat != "percentage") {
        for (let k1 = 0; k1 < this._valuesDenomination.length; k1++) {
            longValue = ChartHelper.getCompareLabelRange(this._valuesDenomination[k1], longValue);
        }
    }
    if (longValue) {
        this._longValue = longValue;
        this._longLengthValue = longValue;
    }
    if (this._chartName == "waterfallchart" || this._chartName == "horWaterfallchart") {
        this._waterFallData = this.makeWaterfallData();
    }
    if (this._chartName == "comparisonModelType3") this.compareValueFormation();

    if (this.data.getAttribute("data-connectorline")) {
        this._connectorLine = true;
        this._connectorLineType = this.data.getAttribute("data-type");
        this._connectorLineColor = this.data.getAttribute("data-color");
        this._connectorLinedashArray = "15,15";
        this._connectorLineStyle = this.data.getAttribute("data-style");
    }
    if (this.data.getAttribute("data-comparestyle")) {
        this.compareStyle = this.data.getAttribute("data-comparestyle");
    }
    if (this.data.getAttribute("data-logocompare")) {
        this._logoCompare = true;
    }

    if (this.data.getAttribute("data-highlightdifference") && (this._seriesItemLength < 2 || this._stackedChart)) {
        let hdIndex = 1;
        let hdSecondIndex = 1;
        if (this.data.getAttribute("highlightdifferencemenupoint1")) {
            let strFirstvalue = this.data.getAttribute("highlightdifferencemenupoint1")?.split(",")[0];
            switch (strFirstvalue) {
                case "first":
                    hdIndex = 0;
                    break;
                case "last":
                    hdIndex = this.data.children.length - 1;
                    break;
                case "middle":
                    hdIndex = parseInt(this.data.children.length / 2);
                    break;
                default:
                    hdIndex = parseInt(strFirstvalue) - 1;
                    break;
            }
            this.data.setAttribute("highlightdifferencepoint1", hdIndex);
            let strSecondvalue = this.data.getAttribute("highlightdifferencemenupoint1")?.split(",")[1];
            switch (strSecondvalue) {
                case "first":
                    hdSecondIndex = 0;
                    break;
                case "last":
                    hdSecondIndex = this.data.children.length - 1;
                    break;
                case "middle":
                    hdSecondIndex = parseInt(this.data.children.length / 2);
                    break;
                default:
                    hdSecondIndex = parseInt(strSecondvalue) - 1;
                    break;
            }
            this.data.setAttribute("highlightdifferencepoint1", hdIndex + "," + hdSecondIndex);
        }
        this.boolHighlightDifference = !this.presentMode ? (this.baseProperties.highlightdifference ? true : false) : this.data.getAttribute("orginalLength") == this.data.children.length;
        this.highlightDiffernecPoint1 = 0;
        this.highlightDiffernecPoint2 = this.seriesLength - 1;
        this.highlightDifferenceStyle = this.data.getAttribute("data-highlight-style") ? this.data.getAttribute("data-highlight-style") : "style1";
        this.highlightdifferencedisplayFormat = this.data.getAttribute("highlightdifferencedisplay") ? this.data.getAttribute("highlightdifferencedisplay") : "";
        this.highlightDifferceText = this.data.getAttribute("highlightdifferencedescription") ? this.data.getAttribute("highlightdifferencedescription") : "";
    }
    if (this._chartName == "columnSimpleRectangle" && (this.voLayout.valueItemBased == "true" || this.voLayout.labelItemBased == "true")) {
        this.boolHighlightDifference = false;
        this.seriesItemLength = 1;
    }
    if (this.boolHighlightDifference || this._indualHighlight || this._highValueBreak || this.data.getAttribute("isTakeaway") == "true") {
        this._boolenaclebaseline = false;
        this._forcedisableBaseline = true;
        this.data.removeAttribute("axisbaseline");
        this.data.removeAttribute("data-baseline");
    }
    if (this.data.getAttribute("isTakeaway") == "true") {
        this.boolHighlightDifference = false;
    }
    if (this.chartName == "lineChart" && this.seriesItemLength > 1) {
        this.boolHighlightDifference = false;
    }
    this.objHighlightDifferenceDetails = {
        display: this.boolHighlightDifference,
        point1: [],
        point2: [],
        style: this.highlightDifferenceStyle,
        displayFormat: this.highlightdifferencedisplayFormat,
    };
    let highlightDifferenceCount = this.data.getAttribute("highlightdifferencecount") ? parseInt(this.data.getAttribute("highlightdifferencecount")) : 0;
    if (this.boolHighlightDifference) {
        for (let i = 0; i < highlightDifferenceCount + 1; i++) {
            let point1 = this.data.getAttribute("highlightdifferencepoint" + parseInt(i + 1))?.split(",")[0] || this.highlightDiffernecPoint1;
            let point2 = this.data.getAttribute("highlightdifferencepoint" + parseInt(i + 1))?.split(",")[1] || this.highlightDiffernecPoint2;
            if (point1 != null && point2 != null) {
                this.objHighlightDifferenceDetails.point1.push(point1);
                this.objHighlightDifferenceDetails.point2.push(point2);
            }
            this.data.setAttribute("highlightdifferencepoint" + parseInt(i + 1), point1 + "," + point2);
        }
    }
    if (this.data.getAttribute("data-highlightdifference") && this.seriesItemLength > 1 && !this._stackedChart) {
        this._indualHighlight = true;
    }
    if (!this.baseProperties.highlightdifference || this.data.getAttribute("isTakeaway") == "true") {
        this._indualHighlight = false;
    }
    if (this.chartName == "lineChart" && this.seriesItemLength > 1) {
        this._indualHighlight = false;
    }
    if (this.voLayout.itemborder) {
        this._shapeBoder = true;
        this.__shapeBoderSize = this.voLayout.itemborder.width ? this.voLayout.itemborder.width : 0;
        this._boderColor = this.voLayout.itemborder.color;
        this._boderAlign = this.voLayout.itemborder.alignment;
    }
    if (this.data.getAttribute("valueformat") == "percentage" && this.seriesLength != 1 && this._rangeTotal > 100 && !this.baseProperties.maxPercentageValue) {
        this.valueFormat();
        this.data.setAttribute("ispercentageChart", "true");
        this._disableEdit = true;
    } else {
        this.data.removeAttribute("ispercentageChart");
    }
    if (this.baseProperties.disablevalueedit) {
        this._disableEdit = true;
    }
    if (this.data.getAttribute("valueformat") == "percentage" && this.seriesLength != 1) {
        this._disableEdit = true;
    }
    if (this._displayValueFormat == "percentage") {
        for (let k1 = 0; k1 < this._valuesDenomination.length; k1++) {
            longValue = ChartHelper.getCompareLabelRange(this._valuesDenomination[k1], longValue);
            longValue = longValue.includes("%") ? longValue : longValue + "%";
        }
    }
    if (longValue) {
        this._longValue = longValue;
        this._longLengthValue = longValue;
    }
    if (this._boolcommonPlaceholder) {
        let strCommonPlacHolderPath = this.data.getAttribute("commonplaceholderpath");
        let CommonPlacHolderTextvalue = this.data.getAttribute("commonplaceholdertext");
        let strCommonPlacHolder = this.data.getAttribute("commonplaceholder");
        if (strCommonPlacHolder) {
            this.strCommonPlacHolderText = CommonPlacHolderTextvalue ? CommonPlacHolderTextvalue : "";
        } else {
            this.strCommonPlacHolderText = CommonPlacHolderTextvalue ? CommonPlacHolderTextvalue : "";
        }
        let strCommonPlaceholder = this._boolcommonPlaceholder == "image" ? "genericassets/placeholderimages/placeholder.png" : this._boolcommonPlaceholder == "logo" ? "genericassets/placeholderimages/logoplaceholder_landscape.png" : "genericassets/placeholderimages/placeholder.png";
        if (strCommonPlacHolder) {
            this.commonplacholder = this._boolcommonPlaceholder == "image" || this._boolcommonPlaceholder == "logo" ? (strCommonPlacHolderPath && !strCommonPlacHolderPath.includes(".svg") ? strCommonPlacHolderPath : this._serverUrl + strCommonPlaceholder) : strCommonPlacHolder;
        } else {
            this.commonplacholder = this._boolcommonPlaceholder == "image" || this._boolcommonPlaceholder == "logo" ? (strCommonPlacHolderPath && !strCommonPlacHolderPath.includes(".svg") ? strCommonPlacHolderPath : this._serverUrl + strCommonPlaceholder) : "placeholder";
            if (this._boolcommonPlaceholder == "logo" && !strCommonPlacHolderPath) {
                this.commonplacholder = this._serverUrl + "genericassets/placeholderimages/logoplaceholder_landscape.png";
            }
        }
    }
    if (this.compareStyle == "style1") {
        let strCommonPlacHolderPath = this.data.getAttribute("commonplaceholderpath");
        let compareTextValue = this.data.getAttribute("comparetext");
        this._strComoareText = compareTextValue ? compareTextValue : "";
    }
    if (this.stremphasisName) {
        this._emphasisName = this.stremphasisName.split(",")[0];
    }
    if (this.strprojectionName) {
        this.arrprojectionName = this.strprojectionName.split(",");
        this._projectionName = this.arrprojectionName[0];
        if (this.baseProperties.emphasisstyle == "greyemphasize") {
            this._projectionName = this.arrprojectionName[1];
        } else if (this.baseProperties.emphasisstyle == "alphaemphasize") {
            this._projectionName = this.arrprojectionName.length > 2 ? this.arrprojectionName[2] : this.arrprojectionName[1];
        }
    }

    if (!!this.baseProperties.emphasisstyle && this.stremphasisName) {
        let arrayemphasis = this.stremphasisName.split(",");
        if (this.baseProperties.emphasisstyle == "greyemphasize") {
            this._emphasisName = "emphasize-grey";
        }
        if (this.baseProperties.emphasisstyle == "alphaemphasize") {
            this._emphasisName = arrayemphasis.length > 2 ? arrayemphasis[2] : arrayemphasis[1];
        }
    }
    if (this.voLayout.placeholderheder && this.data.getAttribute("boolplaceholderheader") != "false") {
        this.data.setAttribute("boolplaceholderheader", "true");
    }
    if (this.voLayout.itemHeader && this.data.getAttribute("boolitemheader") != "false") {
        this.data.setAttribute("boolitemheader", "true");
    }
    if (this.voLayout.labelHeaderTitle && this.data.getAttribute("boollabelheader") != "false") {
        this.data.setAttribute("boollabelheader", "true");
    }
    if (this.voLayout.valueHeaderTitle && this.data.getAttribute("boolvalueheader") != "false") {
        this.data.setAttribute("boolvalueheader", "true");
    }
    this._itemHeaderTitle = this.data.getAttribute("itemheader") ? this.data.getAttribute("itemheader") : "";
    this._enableItemHeader = this.data.getAttribute("boolitemheader") ? this.data.getAttribute("boolitemheader") == "true" : false;
    this._labelHeaderTitle = this.data.getAttribute("labelheader") ? this.data.getAttribute("labelheader") : "";
    this._enableLabelHeader = this.data.getAttribute("boollabelheader") ? this.data.getAttribute("boollabelheader") == "true" : false;
    this._secondaryHeaderTitle = this.data.getAttribute("secondaryheader") ? this.data.getAttribute("secondaryheader") : "";
    this._enablePlaceholderHeader = this.data.getAttribute("boolplaceholderheader") ? this.data.getAttribute("boolplaceholderheader") == "true" : false;
    this._valueHeaderTitle = this.data.getAttribute("valueheader") ? this.data.getAttribute("valueheader") : "";
    this._enableValueHeader = this.data.getAttribute("boolvalueheader") ? this.data.getAttribute("boolvalueheader") == "true" : false;
    this._boolEnableHeader = (this._labelHeaderTitle || this._enableValueHeader || this._enablePlaceholderHeader || this._enableItemHeader) && (this.voLayout.haslabelHeaderTitle || this.voLayout.hasValueHeaderTitle || this.voLayout.hasitemHeaderTitle);
    this._chartFonts = new window["ChartFonts"](this._fontDetails, this);
    this.baseProperties.grid = this.voLayout.itemCoinChart == "true" ? false : this.baseProperties.grid;
    if (this._headerValueDisplayFormat == "calvalueheader" || (this.voLayout.valueCalculateTitle && this._headerValueDisplayFormat == "")) {
        this.data.setAttribute("valueheaderformat", "calvalueheader");
        this._headerValueDisplayFormat = "calvalueheader";
        let valueHeaderData = this.getValueTitleText(this.voLayout);
        if (valueHeaderData) {
            let arrHeaderValue = { input: valueHeaderData.toString() };
            arrHeaderValue = this.ChartUtils.formatChartValues(arrHeaderValue);
            if (this._displayValueFormat == "asentered") {
                this._valueHeaderTitle = valueHeaderData.toLocaleString("en-US", { currency: "USD" });
            } else {
                this._valueHeaderTitle = arrHeaderValue.valueSystem + arrHeaderValue.currencySystem;
            }
        }
    }
    if (this._chartFlip) {
        let topLeftRadius;
        let topRightRadius;
        let bottomLeftRadius;
        let bottomRightRadius;
        if (this.voLayout.borderRadiusValues) {
            topLeftRadius = this.voLayout.borderRadiusValues.letftop;
            topRightRadius = this.voLayout.borderRadiusValues.righttop;
            bottomLeftRadius = this.voLayout.borderRadiusValues.leftbottom;
            bottomRightRadius = this.voLayout.borderRadiusValues.rightbottom;

            this.voLayout.borderRadiusValues.letftop = bottomLeftRadius;
            this.voLayout.borderRadiusValues.leftbottom = topLeftRadius;
            this.voLayout.borderRadiusValues.rightbottom = topRightRadius;
            this.voLayout.borderRadiusValues.righttop = bottomRightRadius;
        }
        if (this.voLayout.backgroundBorderRadiusValues) {
            topLeftRadius = this.voLayout.backgroundBorderRadiusValues.letftop;
            topRightRadius = this.voLayout.backgroundBorderRadiusValues.righttop;
            bottomLeftRadius = this.voLayout.backgroundBorderRadiusValues.leftbottom;
            bottomRightRadius = this.voLayout.backgroundBorderRadiusValues.rightbottom;

            this.voLayout.backgroundBorderRadiusValues.letftop = bottomLeftRadius;
            this.voLayout.backgroundBorderRadiusValues.leftbottom = topLeftRadius;
            this.voLayout.backgroundBorderRadiusValues.rightbottom = topRightRadius;
            this.voLayout.backgroundBorderRadiusValues.righttop = bottomRightRadius;
        }
    }
    if ((this.data.getAttribute("axisbaseline") || this.data.getAttribute("data-baseline")) && this.chartName != "column3DRectangle" && this.chartName != "bar3DChart") {
        // this.customProperties.showYAxisGrid = false;
    }
    if (this.seriesLength != 1 && (this.chartName.includes("pie") || this.chartName.includes("Pie") || this.chartName.includes("doughnut") || this.chartName.includes("Doughnut"))) {
        this.baseProperties.type2Percentage = true;
        this.baseProperties.maxPercentageValue = "true";
    }
    this._boolPercentageChart = this.checkPecentageChart();
    if (this._stackedPercentage && this._boolPercentageChart) {
        for (let s1 = 0; s1 < this._values.length; s1++) {
            let total = 0;
            for (let s2 = 0; s2 < this._values[s1].length; s2++) {
                if (this._seriesItemMaxValue[s1] > 100) {
                    let difference = 100 / this._seriesItemMaxValue[s1];
                    this._values[s1][s2] = this._values[s1][s2] * difference;
                    total += parseFloat(this._values[s1][s2]);
                    this._stackSeriesvalueTotal[s1] = total;
                }
            }
            for (let s3 = 0; s3 < this._values[s1].length; s3++) {
                let stackeddifferenceValue = 100 / this._stackSeriesvalueTotal[s1];
                this._values[s1][s3] = this._values[s1][s3] * stackeddifferenceValue;
                if (this._displayValueFormat != "asentered") this._valuesDenomination[s1][s3] = this.checkFloat(this._values[s1][s3]) ? parseFloat(this._values[s1][s3]).toFixed(2) : parseFloat(this._values[s1][s3]);
            }
            if (this._seriesItemMaxValue[s1] > 100) {
                this._stackSeriesvalueTotal[s1] = 100;
            }
        }
    }
    if ((this.baseProperties.maxPercentageValue == "true" || this.baseProperties.maxPercentageValue) && (!this._stackedPercentage || !this._boolPercentageChart)) {
        let totalValue = 0;
        for (let p1 = 0; p1 < this._values.length; p1++) {
            if (this._boolPercentageChart && this._postiveMaxValue > 100) {
                let differenceValue = 100 / this._postiveMaxValue;
                this._values[p1][0] = this._values[p1][0] * differenceValue;
                let hasArraValues = this._values[p1][0].toString().split(".");
                if (hasArraValues.length > 1 && hasArraValues[1].length > 3) {
                    this._values[p1][0] = this._values[p1][0].toFixed(1);
                }
                totalValue += parseFloat(this._values[p1][0]);
            }
        }

        if (this._boolPercentageChart && this.baseProperties.type2Percentage) {
            totalValue = totalValue == 0 ? this._totalValue : totalValue;
            let type2differenceValue = 100 / totalValue;
            totalValue = 0;
            for (let v1 = 0; v1 < this._values.length; v1++) {
                this._values[v1][0] = this._values[v1][0] * type2differenceValue;
                totalValue += parseFloat(this._values[v1][0]);
                if (this._displayValueFormat != "asentered") this._valuesDenomination[v1][0] = this.checkFloat(this._values[v1][0]) ? parseFloat(this._values[v1][0]).toFixed(2) : parseFloat(this._values[v1][0]);
            }
            this._totalValue = totalValue ? totalValue : this._totalValue;
        }
        if (this._boolPercentageChart && this.seriesLength == 1) {
            if (this._displayValueFormat != "asentered") this._valuesDenomination[0][0] = this._values[0][0];
        }
        if (this._boolPercentageChart && this._postiveMaxValue > 100) {
            this._rangePositive = 100;
            this._postiveMaxValue = 100;
            this._totalValue = totalValue ? totalValue : this._totalValue;
        }
    }
    if (this.baseProperties.customMaxValue) {
        let customMaxValue = this.data.getAttribute("custommaxvalue");
        customMaxValue = customMaxValue ? customMaxValue : this._rangePositive;
        this._maxStackValueTotal = this._maxStackValueTotal < customMaxValue ? customMaxValue : this._maxStackValueTotal;
        if (this._rangePositive < customMaxValue) {
            this._rangePositive = customMaxValue;
            this.data.setAttribute("yaxismaxvalue", customMaxValue);
        }
    }
    if (this.voLayout.labelInset == "inside" && this.voLayout.valueInset == "inside" && this.voLayout.labelSamePos == "true" && this.voLayout.valueSamePos == "true" && this._stackedChart) {
        this._boolEnableWidthReducer = true;
    }
    let iconSize = this.data.getAttribute("iconsize");
    switch (iconSize) {
        case "iconsmall":
            this._iconSizeRatio = 0.5;
            break;
        case "iconmedium":
            this._iconSizeRatio = 0.75;
            break;
        case "iconlarge":
            this._iconSizeRatio = 1;
            break;
    }
    if (this.seriesanimation) {
        this.dummerSeriesItemLength = this.data.children[0].getAttribute("value").split(",");
    }
    if (this.data.getAttribute("changetablecontent") == "true") {
        this._tabelRowLength = this.seriesLength;
        this._tableColumnLength = this._values[0].length + 1;
        if (this._chartName == "waterfallchart" || this._chartName == "horWaterfallchart") {
            this._tableColumnLength = 2;
        }
        this._arrTableContent = [];
        for (let r1 = 0; r1 < this._seriesLength; r1++) {
            this._arrTableContent.push([]);
            for (let c1 = 0; c1 < this._tableColumnLength; c1++) {
                let object = { type: "text", elementtype: "", value: "" };
                if (c1 == 0) {
                    object = { type: "text", elementtype: "label", value: this._labels[r1], indexvalue: r1 };
                    this._arrTableContent[r1].push(object);
                    object = { type: "text", elementtype: "value", value: this._values[r1][c1], indexvalue: r1 + "_" + c1 };
                    this._arrTableContent[r1].push(object);
                } else {
                    if (this._values[r1][c1]) {
                        object = { type: "text", elementtype: "value", value: this._values[r1][c1], indexvalue: r1 + "_" + c1 };
                        this._arrTableContent[r1].push(object);
                    }
                }
            }
        }
        let xAxisTitle = this.data.getAttribute("xaxistitle") || "Label";
        let yaxisTitle = this.data.getAttribute("yaxistitle") || "Value";
        let xAxisObject = { value: xAxisTitle, type: "text", elementtype: "label" };
        let yAxisObject = { value: yaxisTitle, type: "text", elementtype: "label" };
        let arrHeader = [xAxisObject, yAxisObject];
        this._arrTableHeaderLabel = arrHeader;
        this._arrTableHeaderLabel = JSON.parse(JSON.stringify(arrHeader));
        let multiserieslegend = this.data.getAttribute("multiserieslegend") ? this.data.getAttribute("multiserieslegend").split(",") : [];
        if (multiserieslegend.length > 0) {
            this._arrTableHeaderLabel = [xAxisObject];
        } else {
            if (this._seriesItemLength > 1 && this.showLegend && this.data.getAttribute("customlegend") != "true") {
                this.showLegend = false;
            }
        }
        for (let i1 = 0; i1 < multiserieslegend.length; i1++) {
            this._arrTableHeaderLabel.push({ value: multiserieslegend[i1], type: "text", elementtype: "label" });
        }
    }
    if (this._displayValueFormat) {
        this.data.setAttribute("maindisplayformat", this._displayValueFormat);
    }
    if (this._showTotalValue) {
        if (this._displayValueFormat == "percentage") {
            let max = Math.max(...this._arrSeriesItemValueTotal);
            let percentageArr = this._arrSeriesItemValueTotal.map((value) => {
                let percent = (value / max) * 100;
                return (percent % 1 === 0 ? percent.toFixed(0) : percent.toFixed(2)) + "%";
            });
            this._arrSeriesItemValueTotal = percentageArr;
        } else if (this._displayValueFormat == "currency") {
            for (let p1 = 0; p1 < this._arrSeriesItemValueTotal.length; p1++) {
                this._arrSeriesItemValueTotal[p1] = "$" + this.ChartUtils.formatNumber(this._arrSeriesItemValueTotal[p1]);
            }
        } else if (this._displayValueFormat == "number") {
            for (let p1 = 0; p1 < this._arrSeriesItemValueTotal.length; p1++) {
                this._arrSeriesItemValueTotal[p1] = this.ChartUtils.formatNumber(this._arrSeriesItemValueTotal[p1]);
            }
        }
        let longestValue = this._arrSeriesItemValueTotal.reduce((longest, current) => (current.length > longest.length ? current : longest));
        this._longTotalValue = longestValue;
    }
    if (this.arrSeriesItemWidth.length > 0) {
        let total = this.arrSeriesItemWidth.reduce((sum, num) => sum + num, 0);
        let percentages = this.arrSeriesItemWidth.map((num) => (num / total).toFixed(4));
        this.arrSeriesItemWidth = percentages;
    }
    if (this.rangePositive < 1) {
        this._allNegativeValue = true;
    }
    if (this.data.getAttribute("boolprojectiontext") == "false" && this._hasProjection) {
        this._boolEnableProjectiontext = "";
    }
    if (this.data.getAttribute("boolprojectiondisabledtext") == "true" && this._hasProjection) {
        this._boolEnableProjectionDisabledText = "true";
    } else if (this.data.getAttribute("boolprojectiondisabledtext") == "false" && this._hasProjection) {
        this._boolEnableProjectionDisabledText = "";
    }
    this._displayValueFormat != "percentage";
}
VOData.prototype.checkLongLabel = function (value) {
    let promptLongValue = "";
    let length = value[0]?.length - 1;
    for (let p1 = 0; p1 < value.length; p1++) {
        for (let p2 = 0; p2 < length; p2++) {
            promptLongValue = promptLongValue.length > value[p1][p2].length ? promptLongValue : value[p1][p2];
        }
    }
    return promptLongValue;
};
VOData.prototype.checkSecondaryLineLongLabel = function (value) {
    let promptLongValue = "";
    let length = value[0]?.length - 1;
    for (let p1 = 0; p1 < value.length; p1++) {
        for (let p2 = length; p2 < value[p1].length; p2++) {
            promptLongValue = promptLongValue.length > value[p1][p2].length ? promptLongValue : value[p1][p2];
        }
    }
    return promptLongValue;
};
VOData.prototype.checkFloat = function (value) {
    let parsed = Number.parseFloat(value);
    return !Number.isNaN(parsed) && !Number.isInteger(parsed);
};

VOData.prototype.checkPecentageChart = function () {
    let suffixDatas = this._suffix;

    for (let i1 = 0; i1 < suffixDatas.length; i1++) {
        if ((this.baseProperties.suffixData || this.baseProperties.defaultPercentage == "true") && this._displayValueFormat == "percentage" && suffixDatas[i1] == "") {
            suffixDatas[i1] = "%";
            this._suffix[i1] = "%";
        }
        if (this._stackedPercentage && this._displayValueFormat == "percentage" && suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "") {
            for (let s1 = 0; s1 < suffixDatas[i1].length; s1++) {
                suffixDatas[i1][s1] = "%";
                this._suffix[i1][s1] = "%";
            }
            if (i1 == suffixDatas.length - 1 && this._currencySymbol[i1][0] == "") return true;
        }
        if (this._displayValueFormat != "percentage") {
            // this._suffix[i1][0] ="";
            if (i1 == suffixDatas.length - 1) return false;
        } else {
            if ((suffixDatas[i1] == "%" || (suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "%")) && this._currencySymbol[i1][0] == "") {
                if (i1 == suffixDatas.length - 1) return true;
            } else {
                return false;
            }
        }
    }
};
VOData.prototype.getValueTitleText = function (layout) {
    let calculateValue = this._totalValue / this._seriesLength;

    return Number(calculateValue).toFixed(1);
};
VOData.prototype.getLongValue = function (arrayValues = null) {
    let arrList = arrayValues ? arrayValues : this._values;
    const length = arrList.length;
    let longValue;
    for (let i1 = 0; i1 < length; i1++) {
        const subLength = this.baseProperties.maxAllowedSeriesItems == 1 ? 1 : arrList[i1].length;
        for (let j1 = 0; j1 < subLength; j1++) {
            if (i1 == 0 && j1 == 0) {
                longValue = (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString();
            }
            longValue = longValue.length < (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString().length ? (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString() : longValue;
        }
        this._longValue = longValue;
    }
};
VOData.prototype.getsLongValue = function () {
    let arrList = this._secondaryValues;
    const length = arrList.length;
    let longValue;
    for (let i1 = 0; i1 < length; i1++) {
        const subLength = this.baseProperties.maxAllowedSeriesItems == 1 ? 1 : arrList[i1].length;
        for (let j1 = 0; j1 < subLength; j1++) {
            if (i1 == 0 && j1 == 0) {
                longValue = (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString();
            }
            longValue = longValue.length < (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString().length ? (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString() : longValue;
        }
        this._slongValue = longValue;
    }
};
VOData.prototype.valueFormat = function () {
    let length = this._valuesDenomination.length;
    for (let i1 = 0; i1 < length; i1++) {
        let arrValue = this._values[i1];
        let strValue = "";
        for (let i2 = 0; i2 < arrValue.length; i2++) {
            if (i2 == 0) strValue = parseFloat((Number(arrValue[i2]) / this._rangeTotal) * 100).toFixed(0);
            else strValue = parseFloat((Number(arrValue[i2]) / this._rangeTotal) * 100).toFixed(0);
            this._suffix[i1][i2] = "%";
            this._valuesDenomination[i1][i2] = strValue;
        }
    }
    this.getLongValue(this._valuesDenomination);
};

VOData.prototype.setLayout = function () {
    if (this.customProperties.datapoint == "none") this.validHover = true;
    if (this.validHover && this.customProperties.datapoint == "none") {
        this.customProperties.showYAxisGrid = this.baseProperties.grid ? true : false;
        // this.customProperties.showYAxisLine = true;
        // this.customProperties.showXAxisLine = true;
        this.customProperties.showYAxisGridValue = true;
    }
};

VOData.prototype.makeWaterfallData = function () {
    let objData = {};
    let strValue = "";
    let arrValue = [];
    let numValue = 0;
    let numMaxValue = 0;
    let numStartPoint = 0;
    let numPosMaxValue = 0;
    let numNegMaxValue = 0;
    let numLastSumValue = 0;
    let isSumValue = false;
    let nextPoint;
    for (let i1 = 0; i1 < this.seriesLength; i1++) {
        isSumValue = false;
        strValue = this._values[i1][0];
        numValue = parseFloat(strValue);
        if (i1 == this.seriesLength - 1) {
            strValue = "sum";
            // this.data.children[i1].setAttribute("value", "sum");
        }

        if (strValue.toLowerCase() == "sum") {
            isSumValue = true;
            numValue = numLastSumValue;
            numLastSumValue = 0;
            nextPoint = numStartPoint;
        } else {
            numLastSumValue += numValue;
            nextPoint = numStartPoint + numValue;
        }
        if (0 < numValue) {
            if (numPosMaxValue < nextPoint) numPosMaxValue = nextPoint;
        } else {
            if (nextPoint < numNegMaxValue) numNegMaxValue = nextPoint;
        }
        if (strValue.toLowerCase() == "sum") {
            let arrInputValue = { input: numValue.toString() };
            arrInputValue = this.ChartUtils.formatChartValues(arrInputValue);
            let denaminationValue = this._denominationPrefix[i1][0] ? this._denominationPrefix[i1][0] : arrInputValue.currencySystem;
            let CurrencySympol = this._currencySymbol[i1][0] ? this._currencySymbol[i1][0] : arrInputValue.currencysymbol;
            if (this._displayValueFormat == "asentered") {
                this._valuesDenomination[i1][0] = numValue;
            } else {
                this._valuesDenomination[i1][0] = this.ChartUtils.getDenominationValue(numValue, denaminationValue, CurrencySympol);
            }
        }

        arrValue[i1] = {
            value: numValue,
            startValue: numStartPoint,
            isSumValue: isSumValue,
        };
        numStartPoint += isSumValue ? 0 : numValue;
    }
    numMaxValue = numPosMaxValue + Math.abs(numNegMaxValue);
    objData = {
        data: arrValue,
        maxAreaValue: numMaxValue,
        negDiffValue: numNegMaxValue,
    };
    return objData;
};

VOData.prototype.compareValueFormation = function () {
    this._duplicateValues = [];
    this._duplicateLabels = [];
    this._duplicateValueDenominationSuffix = [];
    this._duplicatePrefix = [];
    this._duplicateSuffix = [];
    let length = this._seriesItemLength * this._seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        let value;
        let label;
        let prefix;
        let suffix;
        let index = i1;
        if (i1 < this._seriesLength) {
            value = this._values[index];
            label = this._labels[index];
            prefix = this._prefix[index];
            suffix = this.suffix[index];
            this._duplicateLabels[i1] = label;
            this._duplicateValues[i1] = value[0].toString().split(",");
            this._duplicatePrefix[i1] = prefix[0].toString().split(",");
            this._duplicateSuffix[i1] = suffix[0].toString().split(",");
        } else {
            index = i1 - this._seriesLength;
            value = this._values[index];
            label = this._comparisonLabel[index];
            prefix = this._prefix[index];
            suffix = this.suffix[index];
            this._duplicateLabels[i1] = label;
            this._duplicateValues[i1] = value[1].toString().split(",");
            this._duplicatePrefix[i1] = prefix[1].toString().split(",");
            this._duplicateSuffix[i1] = suffix[1].toString().split(",");
        }
        // if (this.customProperties.seperator) {
        //     if (this._denominationPrefix[index][0] == "none") {
        //         this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._duplicateValueDenominationSuffix[i1 + " " + 0], this.customProperties.valueseparator);
        //     } else {
        //         if (this._denominationPrefix[index][0] == "auto") {
        //             this._arrSeperatorSuffix = ["K", "L", "M", "C", "B"];
        //             this._seperatorSuffix = this._denominationPrefix;
        //             for (let k = 0; k < this._arrSeperatorSuffix.length; k++) {
        //                 if (this._duplicateValueDenominationSuffix[i1 + " " + 0].search(this._arrSeperatorSuffix[k]) != -1) this._seperatorSuffix = this._arrSeperatorSuffix[k];
        //             }
        //             this._seperateValue = this._duplicateValueDenominationSuffix[i1 + " " + 0].split(this._seperatorSuffix)[0];
        //             this._seperatorSuffix = this._seperatorSuffix != "auto" ? this._seperatorSuffix : "";
        //             this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._seperateValue, this.customProperties.valueseparator) + this._seperatorSuffix;
        //         } else {
        //             this._seperateValue = this._denominationPrefix[index][0]
        //                 ? this._duplicateValueDenominationSuffix[i1 + " " + 0].split(this._denominationPrefix[index][0])[0]
        //                 : this._duplicateValueDenominationSuffix[i1 + " " + 0];
        //             this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._seperateValue, this.customProperties.valueseparator) + this._denominationPrefix[index][0];
        //         }
        //     }
        // }
    }
    this._values = [];
    this._labels = [];

    this._prefix = [];
    this._suffix = [];
    this._valuesDenomination = [];
    this._seriesLength = length;
    this._seriesItemLength = 1;
    this._values = this._duplicateValues;
    this._labels = this._duplicateLabels;
    this._prefix = this._duplicatePrefix;
    this._suffix = this._duplicateSuffix;
    let seriesLength = this._duplicateValues.length;
    this._valuesDenomination = this._duplicateValues;
    let increaseIndex = 0;
    let secondaryIndex = 0;

    for (let s1 = 0; s1 < seriesLength; s1++) {
        secondaryIndex = s1 == seriesLength / 2 ? 0 : secondaryIndex;
        let seriesItemindex = s1 % 2;
        increaseIndex = s1 >= seriesLength / 2 ? 1 : 0;
        this._valuesDenomination[s1][0] = this.ChartUtils.getDenominationValue(this._duplicateValues[s1][0], this._denominationPrefix[secondaryIndex][increaseIndex], this._currencySymbol[secondaryIndex][increaseIndex]);
        secondaryIndex++;
    }

    // this._valuesDenominationSuffix = this._duplicateValueDenominationSuffix;
};

VOData.prototype.doSort = function (type) {
    if (1 < this._data.children[0].getAttribute("value").split(",").length) return;
    const items = [];
    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        const dateLabel = this.getUKFormat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.name));
        let value = this.baseProperties.isNegativeChart ? parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.value)) : Math.abs(parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.value)));
        items[seriesIndex] = {
            index: parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.index)),
            value: value,
            name: this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.name),
            date: Date.parse(dateLabel),
            data: this._data.children[seriesIndex],
        };
    }

    if (type == "asc") {
        items.sort(function (a, b) {
            return a.value - b.value;
        });
    } else if (type == "des") {
        items.sort(function (a, b) {
            return b.value - a.value;
        });
    } else if (type == "alphabet") {
        items.sort(function (a, b) {
            return a.name.localeCompare(b.name);
        });
    } else if (type == "time") {
        items.sort(function (a, b) {
            return a.date - b.date;
        });
    } else {
        items.sort(function (a, b) {
            return a.index - b.index;
        });
    }
    while (this._data.firstChild) {
        this._data.removeChild(this._data.firstChild);
    }
    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        this._data.appendChild(items[seriesIndex].data);
    }
    let sortIndex = null;
    for (let orderIndex = 0; orderIndex < this._seriesLength; orderIndex++) {
        if (this._data.children[orderIndex].getAttribute("sortorder") == "true") sortIndex = orderIndex.toString(); //this._data.children[orderIndex].getAttribute("index")
    }
    if (sortIndex) this._data.appendChild(items[sortIndex].data);
};
VOData.prototype.sorValues = function (type) {
    if (type == "asc") {
        this._values.sort(function (a, b) {
            return a - b;
        });
        this._valuesDenomination.sort(function (a, b) {
            return a - b;
        });
    } else if (type == "des") {
        this._values.sort(function (a, b) {
            return b - a;
        });
        this._valuesDenomination.sort(function (a, b) {
            return b - a;
        });
    }
};
VOData.prototype.getUKFormat = function (label = "") {
    var arrSeperator = ["-", "/"];
    for (let s1 = 0; s1 < arrSeperator.length; s1++) {
        var labelData = label ? label.split(arrSeperator[s1]) : [];
        if (labelData.length > 1) {
            if (Number(labelData[0]) > 12 && !isNaN(labelData[0]) && labelData[0].length <= 2) {
                label = labelData[1] + arrSeperator[s1] + labelData[0] + arrSeperator[s1] + labelData[2];
                break;
            }
            if (Number(labelData[1]) > 12 && !isNaN(labelData[1]) && labelData[1].length <= 2) {
                label = labelData[2] + arrSeperator[s1] + labelData[1] + arrSeperator[s1] + labelData[0];
                break;
            }
        }
    }
    return label;
};

VOData.prototype.validationForMinValue = function () {
    let length = this._data.children.length;
    let value = this.data.children[0].getAttribute("value").split(",");
    let menuData = this.data.getAttribute("multiseriescount");
    let seriesItemLength = menuData && value.length < 2 ? 2 : this.baseProperties.minAllowedSeriesItems;
    if (this._secondaryLineChart && seriesItemLength == 1) {
        seriesItemLength = 2;
    }
    this.data.removeAttribute("multiseriescount");
    if (value.length < seriesItemLength) {
        let newValue;
        let assenterValue = "";
        let newAsenterValue = "";
        for (let i2 = 0; i2 < length; i2++) {
            value = this.data.children[i2].getAttribute("value").split(",");
            assenterValue = this.data.children[i2].getAttribute("asenteredvalue").split("^");
            for (let i3 = 0; i3 < seriesItemLength; i3++) {
                let randommaxValue = parseFloat(Math.random().toFixed(2));
                randommaxValue = randommaxValue > 1 || randommaxValue == 0 ? 0.2 : randommaxValue;
                if (i3 == 0) {
                    newValue = value[i3] ? value[i3] : "25";
                    newAsenterValue = assenterValue[i3] ? assenterValue[i3] : "25";
                } else {
                    let tempNewValue = value[i3] ? value[i3] : parseInt(newValue.split(",")[i3 - 1]) + parseInt(parseInt(newValue.split(",")[i3 - 1]) * ((i3 + 1) * randommaxValue));
                    let tempasentervalue = assenterValue[i3] ? assenterValue[i3] : tempNewValue;
                    newAsenterValue += "^" + tempasentervalue;
                    newValue += "," + tempNewValue;
                }
            }
            if (newAsenterValue) this.data.children[i2].setAttribute("asenteredvalue", newAsenterValue);
            if (newValue) this.data.children[i2].setAttribute("value", newValue);
        }
    }
    if (length < this.baseProperties.minAllowedSeries) {
        let duplicateData = this._data.children[0].cloneNode(true);
        let index = Number(duplicateData.getAttribute("index"));
        duplicateData.setAttribute("index", index + 1);
        let arrValue = duplicateData.getAttribute("value").split(",");
        let strValue;
        for (let i2 = 0; i2 < arrValue.length; i2++) {
            let value = Number(arrValue[i2]);
            value = parseInt(value + value * ((i2 + 1) * 0.2));
            if (i2 == 0) strValue = value.toString();
            else strValue += "," + value.toString();
        }
        duplicateData.setAttribute("value", strValue);
        this._data.appendChild(duplicateData);
    }
};
VOData.prototype.groupTrueValuesWithIndices = function (arr) {
    let currentGroup = [];
    if (arr.length === 0) return currentGroup;
    let groupOrderIndex = [];
    for (let i = 0; i < arr.length; i++) {
        if (arr[i].value === "true") {
            let groupIndex = parseInt(arr[i].index) - 1;
            if (!currentGroup[groupIndex]) {
                groupOrderIndex.push(groupIndex);
                currentGroup[groupIndex] = [];
            }
            currentGroup[groupIndex].push({
                value: "true",
                index: i,
                groupIndex: arr[i].index,
            });
        }
    }
    let gapCount = 0;
    let groupNodeCount = 0;
    for (let c1 = 0; c1 < currentGroup.length; c1++) {
        gapCount += currentGroup[c1].length - 1;
        groupNodeCount += currentGroup[c1].length;
    }
    return { array: currentGroup, gapcount: gapCount, groupNodeCount: groupNodeCount, groupOrderIndex: groupOrderIndex };
};
VOData.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index + 1;
};
VOData.prototype.validationForScatterMaxMinValues = function () {
    this._xMaxValue = Math.max.apply(null, this._xValues);
    this._yMaxValue = Math.max.apply(null, this._yValues);
    this._yMinValue = Math.min.apply(null, this._yValues);
    this._xMinValue = Math.min.apply(null, this._xValues);
};
