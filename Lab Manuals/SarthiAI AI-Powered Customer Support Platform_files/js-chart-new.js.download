                        hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                    }
                    if (hightlight) {
                        hightlight.style.pointerEvents = "none";
                        let textNode = hightlight.querySelector("#callout-title");
                        if (textNode) {
                            textNode.setAttribute("contenteditable", "true");
                            textNode.setAttribute("data-dck-selector", "true");
                            textNode.setAttribute("data-prompt-text", "Enter highlight text");
                            this.ChartHelper.setTextChangeListner(textNode);
                            textNode.setAttribute("data-type", "highlightlabel");
                            textNode.setAttribute("index", seriesIndex);
                            textNode.setAttribute("id", "lineheightlighttext" + seriesIndex);
                            textNode.classList.add("linehighlightlabel");
                            textNode.style.pointerEvents = "all";
                            if (!this.data.lineHighlightText[seriesIndex]) {
                                textNode.innerText = "";
                            }
                        }
                        hightlight.setAttribute("data-animation", "linehighlightshape");
                        hightlight.classList.add("moodanimation");
                    }
                }
            }

            sereiesX = 17;
        }
        if (this.fullLine) {
            strPath += this.chart == "spline" ? "L" + intX + "," + intStartYPoint + "z" : "L" + intX + "," + intStartYPoint + "z";
        }

        let strokeColor = this.getBgFillDetails(seriesItemIndex, "cf-stroke-section-primary", this.data.layout.itemColor, "stroke");
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: strPath,
            class: "item-path " + strokeColor + " moodanimation " + this.data.layout.lineShadow,
            "data-animation": "itemline",
            "data-linechart": "true",
            "data-seriesitemindex": seriesItemIndex.toString(),
            fill: "transparent",
            "series-itemindex": seriesItemIndex,
            "stroke-opacity": this.data.layout.lineOpacity ? this.data.layout.lineOpacity : 0.5,
            "stroke-width": this.linethickness + "px",
        });
        // if(this.style.bgFillType != "gradient")
        // {
        //     this.data.SVGUtils.assignAttributes(svgPath, {
        //         fill: "transparent"
        //     });
        // }
        if (this.bgFill) {
            strokeColor = this.getBgFillDetails(seriesItemIndex, strokeColor, this.data.layout.itemLineColor, "stroke");
            this.data.SVGUtils.assignAttributes(svgPath, {
                class: "item-path " + strokeColor + " " + this.data.layout.lineShadow,
                "data-seriesitemindex": seriesItemIndex.toString(),
                "data-animation": "",
                "stroke-linecap": "",
            });
        }
        this.intLastX = sereiesX + intX;
        let areaFillColor = this.getBgFillDetails(seriesItemIndex, this.data.ChartFonts.appendgraphicFillColor(seriesItemIndex), this.data.layout.itemColor, "bgcolor");
        if (this.bgFill) {
            if (seriesItemIndex == 0) {
                this.createMaskSVG(svgElement);
            }
            strAreaPath += this.chart == "spline" ? "L" + intX + "," + intStartYPoint : "L" + intX + "," + intStartYPoint;

            this.data.SVGUtils.assignAttributes(svgAreaPath, {
                d: strAreaPath,
                style: "stroke:none;",
                class: "areapath path_to item-lines " + areaFillColor + " " + this.data.layout.areaShadow,
                id: "points_to-" + seriesItemIndex,
                "data-areacolor": areaFillColor,
                "fill-opacity": this.data.layout.areaOpacity && (this.data.layout.areaOpacity < 0.5 || this.data.seriesItemLength == 1) ? this.data.layout.areaOpacity : 0.5,
            });
            this.data.SVGUtils.assignAttributes(AreaBaseSvg, {
                "data-mask": "true",
                mask: "url(#" + this.baseMaskRect + ")",
            });
        }
        let clonepath = "";
        let defsTag = "";
        let maskElement = "";
        if (this.dashedarray) {
            defsTag = this.data.SVGUtils.createSVGElement("defs");
            maskElement = this.data.SVGUtils.createSVGElement("mask");
            this.maskPathId = Math.random() + this.data.slideID + "maskpath" + seriesItemIndex;
            this.data.SVGUtils.assignAttributes(maskElement, {
                "data-maskelement": "true",
                id: this.maskPathId,
                fill: "none",
                stroke: "white",
            });
            defsTag.appendChild(maskElement);
            svgSeiesItem.appendChild(defsTag);
            clonepath = svgPath.cloneNode(true);
            this.data.SVGUtils.assignAttributes(clonepath, {
                class: this.data.layout.lineShadow,
                fill: "none",
                stroke: "white",
                "data-animation": "",
                "stroke-width": this.linethickness + "px",
                "stroke-dasharray": this.dashedarray,
            });
            if (this.dashedarray) {
                this.data.SVGUtils.assignAttributes(maskElement, {
                    class: "dasharrayelement",
                });
            }
            maskElement.appendChild(clonepath);
            this.data.SVGUtils.assignAttributes(svgPath, {
                mask: "url(#" + this.maskPathId + ")",
                "data-mask": "true",
                "data-mask": "true",
            });
        }
        svgElement.appendChild(svgSeiesItem);
        if (this.gradient == true) {
            this.addGradient(svgPath, svgAreaPath, svgElement, this.bgFill, false, seriesItemIndex);
        }
        if (this.data.hasProjection) {
            this.maskRectId = Math.random() + "maskrect";
            this.data.SVGUtils.assignAttributes(svgAreaPath, {
                "data-mask": "",
                mask: "url(#" + this.maskRectId + ")",
            });
            if (this.dashedarray) {
            } else {
                this.data.SVGUtils.assignAttributes(svgPath, {
                    "data-mask": "",
                    mask: "url(#" + this.maskRectId + ")",
                });
            }
        }
        let ProjectionDefsTag = this.data.SVGUtils.createSVGElement("defs");
        let ProjectionMaskTag = this.data.SVGUtils.createSVGElement("mask");
        this.data.SVGUtils.assignAttributes(ProjectionMaskTag, {
            id: this.maskRectId,
            fill: "white",
            class: "projectionRect",
            maskUnits: "userSpaceOnUse",
        });
        if (this.dashedarray) {
        } else {
            ProjectionDefsTag.appendChild(ProjectionMaskTag);
        }
        if (clonepath && this.data.hasProjection) {
            this.data.SVGUtils.assignAttributes(clonepath, {
                mask: "url(#" + this.maskRectId + ")",
            });
        }
        for (let i4 = 0; i4 < arrProjection.length; i4++) {
            if (this.dashedarray && i4 == 0) {
                defsTag.appendChild(ProjectionMaskTag);
            }
            i4 == 0 ? svgSeiesItem.appendChild(ProjectionDefsTag) : "";
            let maskRect = this.data.SVGUtils.createSVGElement("rect");
            this.data.SVGUtils.assignAttributes(maskRect, {
                id: "projectionrectbase",
                x: arrProjection[i4].x,
                y: "0%",
                width: arrProjection[i4].width,
                height: this.state.height,
            });
            ProjectionMaskTag.appendChild(maskRect);
            if (this.dashedarray) {
                maskElement.appendChild(clonepath);
            }
        }
    }
};
SimpleLineChart.prototype.calculateProjectionWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let width = projectionLength * indualWidth - indualWidth / 2;
    let x = startingProjectionPoint * indualWidth + indualWidth / 2;
    return { x: containerElement.offsetLeft + this.rectBaseSeries.x + x, width: width };
};
SimpleLineChart.prototype.createHighlightShape = function (centerX, centerY, width, index, pathLength) {
    let svgCircle = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(svgCircle, {
        cx: centerX,
        cy: centerY,
        r: 24,
        class: "highlightshape moodanimation linehighlightshapestyle1 " + this.data.layout.itemShapeDrawStyle,
        "data-pathLength": pathLength,
        "data-customsmovey": centerY,
        "data-customsmovex": centerX,
    });
    return svgCircle;
};
SimpleLineChart.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex, dummeyShape) {
    if (this.data.layout.linechartShapeStyle == "border") {
        let borderSize = this.data.layout.linechartShapeBorderSize ? this.data.layout.linechartShapeBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.linechartShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsTertiaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
                dummeyShape.classList.add(this.data.ChartFonts.appendgraphicColor(seriesIndex));
            }
        } else {
            if (this.data.layout.linechartShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    // element.classList.add("clsTertiaryStroke");
                    // if(dummeyShape)dummeyShape.classList.add("clsSecondaryFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "contrast") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    element.classList.add("contrast-stroke");
                    if (dummeyShape) dummeyShape.classList.add("clsContrastFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("bgfill");
                    element.classList.add("bgstroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "alternateprimary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("alterbgcolor");
                    element.classList.add("alter-background-stroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    this.addGradient(element, element, element.parentNode, false, true, false, seriesIndex);
                }
            } else {
                // element.classList.add("clsTertiaryStroke");
            }
        }
    }
    if (this.data.layout.linechartShapeBgColor) {
        if (this.data.layout.linechartShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsSecondaryFill");
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.linechartShapeBgColor == "secondary") {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    // element.classList.add("clsSecondaryFill");
                }
            } else {
                if (this.data.layout.linechartShapeBgColor == "contrast") {
                    if (this.data.layout.linechartShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                    } else {
                        element.classList.add("contrast-fill");
                    }
                } else if (this.data.layout.linechartShapeBgColor == "alternateprimary") {
                    if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                        // element.classList.add("clsTertiaryStroke");
                    } else {
                        element.classList.remove("cf-fill-section-primary");
                        element.classList.remove("bgfill");
                        element.classList.add("alterbgcolor");
                    }
                } else {
                    if (this.data.layout.linechartShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true, false, seriesIndex);
                    } else if (this.data.layout.linechartShapeBgColor == "bgcolor") {
                        if (this.data.layout.linechartShapebgOpacity) {
                            element.classList.remove("cf-fill-section-primary");
                            element.classList.add("bgfill");
                            element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                        } else {
                            element.classList.add("contrast-fill");
                        }
                    }
                }
            }
        }
    }
    if (this.data.layout.itemShapeShadow) {
        element.classList.add(this.data.layout.itemShapeShadow);
    }
};
SimpleLineChart.prototype.createProjectionSVG = function (item) {
    if (this.data.hasProjection) {
        let svgProjection = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgProjection, {
            id: "projectionlayer",
            width: "100%",
            style: "position:absolute;",
            height: "100%",
            x: "0%",
            y: "0%",
        });
        let itemGraphic = item;
        let itemProjection = itemGraphic.cloneNode(true);
        //let TopmaskElement = itemProjection.querySelector(".basemaskrect");
        // if(TopmaskElement){
        //     TopmaskElement.parentNode.parentNode.removeChild(TopmaskElement.parentNode)
        // }
        this.data.SVGUtils.assignAttributes(itemProjection.children[0], {
            x: 0,
            y: 0,
        });
        let itemCircles = itemProjection.querySelectorAll(".item-circle");
        let areaPath = itemProjection.querySelectorAll(".areapath");
        for (let i1 = 0; i1 < itemCircles.length; i1++) {
            itemCircles[i1].parentNode.removeChild(itemCircles[i1]);
        }
        for (let a1 = 0; a1 < areaPath.length; a1++) {
            areaPath[a1].style.fill = "white";
        }
        let itemMask = itemProjection.querySelectorAll(".projectionRect");
        let maskNode = itemProjection.querySelector(".dasharrayelement");
        if (maskNode) maskNode.remove();

        for (let i2 = 0; i2 < itemMask.length; i2++) {
            let xvalue = itemMask[i2].children[0].getAttribute("width");
            let widthvalue = this.intLastX - parseFloat(xvalue);
            itemMask[i2].children[0].setAttribute("x", xvalue);
            itemMask[i2].children[0].setAttribute("width", widthvalue);
            itemProjection.children[0].appendChild(itemMask[i2].parentNode);
            itemMask[i2].setAttribute("id", this.maskprojection);
        }

        let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
        svgProjection.appendChild(patternDefsTag);

        let seriesItem = itemProjection.querySelectorAll(".svgseriesitem");
        let projectionClass = "";
        let projectionStrokeClass = this.lineGradient ? "" : "";
        for (let i1 = 0; i1 < seriesItem.length; i1++) {
            seriesItem[i1].setAttribute("mask", "url(#" + this.maskprojection + ")");
            projectionStrokeClass = this.lineGradient ? "" : this.getBgFillDetails(i1, "cf-stroke-section-primary", this.data.layout.itemColor, "stroke");
            let seriesItemClass = seriesItem[i1].getAttribute("class") ? seriesItem[i1].getAttribute("class") : "";
            seriesItem[i1].setAttribute("class", seriesItemClass + " " + this.data.layout.lineShadow);

            let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
            this.data.SVGUtils.assignAttributes(patternMaskTag, {
                id: this.randomkey + this.data.slideID + "mask" + i1,
                class: "mask cs-line-area-projection-enabled",
                maskUnits: "userSpaceOnUse",
            });
            patternMaskTag.style.setProperty("filter", "none", "important");
            let pathTo = seriesItem[i1].querySelectorAll(".item-lines");
            let itemPath = seriesItem[i1].querySelectorAll(".item-path");
            patternDefsTag.appendChild(patternMaskTag);
            let lineshaowColors = this.data.layout.lineShadow ? this.data.layout.lineShadow.split(" ") : [];
            if (pathTo.length > 0 && pathTo[0].parentNode && pathTo[0].parentNode.parentNode) {
                lineshaowColors.forEach(function (element) {
                    if (element) {
                        seriesItem[i1].classList.remove(element);
                    }
                });
                seriesItem[i1].classList.remove("cs-line-area-projection-disabled");
                seriesItem[i1].classList.add("cs-line-area-projection-enabled");
                // pathTo[0].parentNode.style.setProperty("filter", "grayscale(100%)", "important");
            }
            if (itemPath.length > 0 && itemPath[0].parentNode && itemPath[0].parentNode.parentNode) {
                lineshaowColors.forEach(function (element) {
                    if (element) {
                        seriesItem[i1].classList.remove(element);
                    }
                });
                seriesItem[i1].classList.remove("cs-line-area-projection-disabled");
                seriesItem[i1].classList.add("cs-line-area-projection-enabled");
                //itemPath[0].parentNode.style.setProperty("filter", "grayscale(100%)", "important");
            }
            for (let i3 = 0; i3 < pathTo.length; i3++) {
                let maskLine = pathTo[i3].cloneNode(true);
                maskLine.removeAttribute("class");
                maskLine.removeAttribute("mask");
                this.data.SVGUtils.assignAttributes(maskLine, {
                    class: "item-lines " + this.data.layout.lineShadow,
                    stroke: "white",
                });
                if (this.bgFill) {
                    maskLine.style.fill = "white";
                    maskLine.removeAttribute("fill-opacity");
                    maskLine.removeAttribute("stroke-opacity");
                }
                patternMaskTag.appendChild(maskLine);
                projectionClass = this.areaGradient ? "" : "";
                this.data.SVGUtils.assignAttributes(pathTo[i3], {
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                    class: "path_to item-lines " + projectionClass + " " + this.data.layout.lineShadow,
                });
                if (this.bgFill) {
                    projectionClass = !this.areaGradient && pathTo[i3].getAttribute("data-areacolor") ? pathTo[i3].getAttribute("data-areacolor") : projectionClass;
                    this.data.SVGUtils.assignAttributes(pathTo[i3], {
                        mask: "",
                        class: "path_to item-lines clsAreaStyle " + projectionClass,
                    });
                    pathTo[i3].style.removeProperty("fill");
                    pathTo[i3].removeAttribute("fill-opacity");
                    pathTo[i3].removeAttribute("stroke-opacity");
                }
                // let fillType = pathTo[i3].getAttribute("fill");
                // if(fillType&&fillType.includes("area")){
                //     fillType = fillType.replace("area", "projectionarea");
                // }else{
                //     if(fillType&&fillType.includes("grad")){
                //         fillType = fillType.replace("grad", "projectiongrad");
                //     }
                // }
                // pathTo[i3].setAttribute("fill",fillType);
            }
            for (let i2 = 0; i2 < itemPath.length; i2++) {
                let maskPath = itemPath[i2].cloneNode(true);
                maskPath.removeAttribute("class");
                this.data.SVGUtils.assignAttributes(maskPath, {
                    stroke: "white",
                    class: "item-path " + this.data.layout.lineShadow,
                    "data-animation": "",
                    // "stroke-dasharray": 13,
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                });
                patternMaskTag.appendChild(maskPath);
                this.data.SVGUtils.assignAttributes(itemPath[i2], {
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                    class: "item-path moodanimation " + this.data.layout.lineShadow,
                    "data-animation": "itemline",
                    "data-linechart": "true",
                    "data-seriesitemindex": i1.toString(),
                });

                if (this.bgFill) {
                    this.data.SVGUtils.assignAttributes(itemPath[i2], {
                        class: "item-path clsAreaStroke " + projectionStrokeClass + " " + this.data.layout.lineShadow,
                        "data-animation": "",
                    });
                    if (this.data.layout.lineShadow) {
                        this.data.SVGUtils.assignAttributes(itemPath[i2].parentNode, {
                            class: this.data.layout.lineShadow,
                        });
                    }
                    itemPath[i2].style.removeProperty("fill");
                    itemPath[i2].removeAttribute("stroke-opacity");
                }
                if (itemPath[i2] && itemPath[i2].parentNode && !this.bgFill && projectionStrokeClass) {
                    itemPath[i2].parentNode.classList.add(projectionStrokeClass);
                }
                if (this.dashedarray) {
                    this.data.SVGUtils.assignAttributes(itemPath[i2], {
                        mask: "",
                        "data-mask": "",
                    });
                }

                // let fillType = itemPath[i2].getAttribute("stroke");
                // if(fillType&&fillType.includes("area")){
                //     fillType = fillType.replace("area", "projectionarea");
                // }else{
                //     if(fillType&&fillType.includes("grad")){
                //         fillType = fillType.replace("grad", "projectiongrad");
                //     }
                // }
                // itemPath[i2].setAttribute("stroke",fillType);
            }
        }
        let cloneNode = itemProjection.children[0].cloneNode(true);
        cloneNode.setAttribute("x", "0");
        svgProjection.appendChild(cloneNode);
        item.children[0].style.position = "absolute";
        item.insertBefore(svgProjection, item.children[0]);
        if (this.style.bgFillType == "gradient") {
            let areaGradient = svgProjection.getElementsByTagName("linearGradient");
            for (let p1 = 0; p1 < areaGradient.length; p1++) {
                let currentId = areaGradient[p1].getAttribute("id");
                if (currentId && currentId.includes("area")) {
                    currentId = currentId.replace("area", "projectionarea");
                } else {
                    if (currentId && currentId.includes("grad")) {
                        currentId = currentId.replace("grad", "projectiongrad");
                    }
                }
                let itemLines = svgProjection.querySelectorAll(".item-lines");
                for (let i1 = 0; i1 < itemLines.length; i1++) {
                    if (itemLines[i1].getAttribute("fill").includes("area")) {
                        let oldFillValue = itemLines[i1].getAttribute("fill");
                        let newFillValue = oldFillValue.replace("area", "projectionarea");
                        itemLines[i1].setAttribute("fill", newFillValue);
                    } else {
                        if (itemLines[i1].getAttribute("fill").includes("grad")) {
                            let oldFillValue = itemLines[i1].getAttribute("fill");
                            let newFillValue = oldFillValue.replace("grad", "projectiongrad");
                            itemLines[i1].setAttribute("fill", newFillValue);
                        }
                    }
                }
                areaGradient[p1].setAttribute("id", currentId);
                for (let p2 = 0; p2 < areaGradient[p1].children.length; p2++) {
                    let currentStyle = areaGradient[p1].children[p2].getAttribute("style");
                    if (currentStyle.includes("var(--gradient1-color-rgb)")) {
                        currentStyle = currentStyle.replace("var(--gradient1-color-rgb)", "var(--th-slide-secondary)");
                    }
                    if (currentStyle.includes("var(--gradient2-color-rgb)")) {
                        currentStyle = currentStyle.replace("var(--gradient2-color-rgb)", "var(--th-slide-secondary)");
                    }
                    areaGradient[p1].children[p2].setAttribute("style", currentStyle);
                }
            }
        }
        let arrowHeadarray = svgProjection.querySelectorAll(".arrowhead");
        for (let a1 = 0; a1 < arrowHeadarray.length; a1++) {
            arrowHeadarray[a1].remove();
        }
        let arrowHightlightCircle = svgProjection.querySelectorAll(".highlightshape");
        for (let h1 = 0; h1 < arrowHightlightCircle.length; h1++) {
            arrowHightlightCircle[h1].remove();
        }
        if (this.data.hasProjection) {
            let projectiondisable = item.querySelectorAll("#series-common").length > 1 ? item.querySelectorAll("#series-common")[1] : "";
            if (projectiondisable) {
                let svgSeiesItemClone = projectiondisable.querySelectorAll(".svgseriesitem");
                for (s1 = 0; s1 < svgSeiesItemClone.length; s1++) {
                    if (svgSeiesItemClone[s1].classList.contains("cs-line-area-projection-disabled")) {
                        svgSeiesItemClone[s1].classList.remove("cs-line-area-projection-disabled");
                        let pathNode = svgSeiesItemClone[s1].getElementsByTagName("path");
                        for (let v1 = 0; v1 < pathNode.length; v1++) {
                            pathNode[v1].classList.add("cs-line-area-projection-disabled");
                        }
                    }
                }
            }
        }
        if (this.bgFill) {
            let itemLine = svgProjection.querySelectorAll("[data-animation='itemline']");
            for (let i1 = 0; i1 < itemLine.length; i1++) {
                itemLine[i1].dataset.animation = "";
            }
        }
    }
};
SimpleLineChart.prototype.createMaskSVG = function (argparent) {
    let DefsTag = this.data.SVGUtils.createSVGElement("defs");
    for (let i1 = 0; i1 < this.data.seriesItemLength; i1++) {
        let MaskTag = this.data.SVGUtils.createSVGElement("mask");
        this.baseMaskRect = Math.random() + this.voData.slideID + "basemaskrect" + i1;
        this.data.SVGUtils.assignAttributes(MaskTag, {
            id: this.baseMaskRect,
            class: "basemaskrect",
            "data-maskelement": "true",
        });
        DefsTag.appendChild(MaskTag);
        let endpercentage = this.intLastX - (this.intStartX - this.intCircleRadius);
        let Masksvg = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(Masksvg, {
            x: this.intStartX - this.intCircleRadius,
            y: 0,
            width: endpercentage,
            height: this.state.height,
            class: "areamaskrect",
        });
        MaskTag.appendChild(Masksvg);
        let basemaskRect = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(basemaskRect, {
            class: "moodanimation",
            x: 0,
            y: 0,
            width: endpercentage,
            fill: "white",
            height: this.state.height,
            "data-animation": "itemarea",
        });
        Masksvg.appendChild(basemaskRect);
    }
    //this.intStartX = 0;
    // this.intLastX = 0;
    argparent.appendChild(DefsTag);
};

SimpleLineChart.prototype.createDropShadow = function (svgElement) {
    let filterDy = this.filterYDistance == 0 ? 0 : parseInt(this.data.layout.shadowxValue);
    let filterDx = this.filterXDistance == 0 ? 0 : parseInt(this.data.layout.shadowyValue);
    let dropshadowColor = this.data.layout.itemBoxShdowColor == "item" || this.data.layout.itemBoxShdowColor == "theme" ? "SourceGraphic" : "SourceAlpha";

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let filterTag = this.data.SVGUtils.createSVGElement("filter");
    this.data.SVGUtils.assignAttributes(filterTag, {
        id: "dropshadow",
        x: "0",
        y: "0",
    });
    defsTag.appendChild(filterTag);

    let feOffsetTag = this.data.SVGUtils.createSVGElement("feOffset");
    this.data.SVGUtils.assignAttributes(feOffsetTag, {
        in: dropshadowColor,
        dx: filterDx,
        dy: filterDy,
        result: "offOut",
    });
    filterTag.appendChild(feOffsetTag);
    let feDropShadowTag = this.data.SVGUtils.createSVGElement("feGaussianBlur");
    let stateDiv = 5;
    if (this.data.layout.itemBoxShdowOpacity) {
        let currentOpacity = 1 - parseFloat(this.data.layout.itemBoxShdowOpacity);
        stateDiv = currentOpacity * 10;
    }
    this.data.SVGUtils.assignAttributes(feDropShadowTag, {
        result: "blurOut",
        stdDeviation: stateDiv,
        in: "blurOut",
    });
    filterTag.appendChild(feDropShadowTag);

    let feBlend = this.data.SVGUtils.createSVGElement("feBlend");
    this.data.SVGUtils.assignAttributes(feBlend, {
        in: "SourceGraphic",
        in2: "blurOut",
        mode: "normal",
    });
    filterTag.appendChild(feBlend);
};

