            chartimageplaceholder: hasImageProperty,
            diagramgraphictype: hasPlaceHolderProperty,
            changeicon: hasChangeIcon,
            changeimage: hasChangeImage,
            edit: editImage,
            highlight: hasHightlightProperty,
            deleteasset: hasDeleteProperty,
            deleteprojectionheading: hasDeleteProjectionHeading,
            selectedtextlinkurl: hasLinkProperty,
            projection: hasProjectionProperty,
            highlightemphasize: hasEmphasisProperty,
            sortorder: hasSortOrderProperty,
            graphicimage: hasGraphicImageProperty,
            addimagestackimage: hasAddImage,
            chartsourcetext: hassourcetext,
            sourcetextleftalign: sourcetextleftalign,
            sourcetextrightalign: sourcetextrightalign,
            sourcetextcenteralign: sourcetextcenteralign,
            titletextleftalign: titletextleftalign,
            titletextrightalign: titletextrightalign,
            titletextcenteralign: titletextcenteralign,
            projectiontextleftalign: projectiontextleftalign,
            addprojectionheading: hasProjectionTextHeading,
            projectiontextrightalign: projectiontextrightalign,
            projectiontextcenteralign: projectiontextcenteralign,
            headerleftalign: headerLeftAlign,
            charttitleresize: dpResizeSource,
            headercenteralign: headerCenterAlign,
            textalign: hadtextalign,
            changelogocontrast: logoContrastColor,
            fontsize: fontListing,
            morefloater: moreFloater,
            linehighlightvaluedisplay: disableHighlightValue,
            textopacity: textopacity,
            texttransform: texttransform,
            textsize: textSize,
            fontbold: textBold,
            fontitalic: textItalic,
            assetextratext: objAssetText,
            textcolor: objTextColor,
            hideupload: customImageSource ? true : false,
        };
        if (
            elementType == "label" ||
            elementType == "value" ||
            elementType == "promt" ||
            elementType == "secondarylabel" ||
            elementType == "legendlabel" ||
            elementType == "chartgrouplabel" ||
            elementType == "value" ||
            elementType == "promt" ||
            elementType == "label" ||
            elementType == "legendlabel" ||
            elementType == "projectiontext" ||
            elementType == "charttiletext" ||
            elementType == "multilegendlabel" ||
            elementType == "axistitle" ||
            elementType == "comparelabelheader"
        ) {
            if (elementType != "axistitle") {
                dictProps["lineheightchange"] = this.FloaterPropertyObjects.lineheightchange;
                dictProps["lineheightchange"].val = lineHeightOnRem;
            }
            dictProps["letterspacingchange"] = this.FloaterPropertyObjects.letterspacingchange;
            dictProps["letterspacingchange"].val = letterSpacingValue;
        }
        let baseElement = grahicDiv?.querySelector("#base-chart");
        let hasLabelUserBoldElement = elementType == "label" && baseElement?.classList?.contains("labelbold");
        let hasStyleParentBold = eltarget?.style?.fontWeight == "bold" || eltarget?.style?.fontWeight == "700" || hasLabelUserBoldElement;
        let hasParentBold = eltarget && (window.getComputedStyle(eltarget).fontWeight == "bold" || window.getComputedStyle(eltarget).fontWeight == "700");
        if (!hasStyleParentBold && hasParentBold) {
            dictProps["fontbold"] = "";
        }
    }
    let isMultiSeriesItem = this.checkmultiSeriesItemChart(grahicDiv);
    if (isMultiSeriesItem) {
        if (elementType == "value" || elementType == "ITEM") {
            let boolSelected = false;
            let index = eltarget.getAttribute("data-id")?.split("_")?.[1]?.toString();
            let seriesItemHighlightIndex = metaData?.getAttribute("seriesitemhighlightindex");
            let arrSeriesItemHighlightIndex = seriesItemHighlightIndex ? seriesItemHighlightIndex.split(",") : [];
            if (arrSeriesItemHighlightIndex?.includes(index)) {
                boolSelected = true;
            }
            dictProps["multiseriesitemhighlight"] = this.FloaterPropertyObjects.chartmultiseriesitemhighlight;
            dictProps["multiseriesitemhighlight"].value = boolSelected;
            dictProps["multiseriesitemhighlight"]["targetnodeid"] = eltarget?.getAttribute("id");
        }
    }
    if (elementType == "multilegendlabel") {
        dictProps["multiserieslabel"] = true;
    }

    if ((itemId?.includes("graphic-") || itemId?.includes("graphicimage-")) && (elementType == "ITEM" || elementType == "IMAGE")) {
        let indexId = eltarget?.getAttribute("data-id");
        let idValue = indexId?.split("_")?.[0];
        if (!idValue) {
            indexId = eltarget?.getAttribute("id");
            idValue = indexId?.split("_")?.[0]?.split("-")?.[1];
        }
        itemId = idValue ? "series-" + idValue : itemId;
    }
    // Use existing chartId and get chart group nodes
    chartGroupNodes = chartId ? this.ChartUtils.getChartGroupNodes(chartId) : [];

    if (chartGroupNodes.length > 1) {
        dictProps = {};
        itemId = this.checkFirstItemBasedOnIndex(chartId);
        dictProps["chartgroupnodes"] = this.FloaterPropertyObjects.chartgroupnodes;
    } else if (eltarget?.getAttribute("class")?.includes("chartgroupnode")) {
        dictProps = {};
        dictProps["chartungroupnodes"] = this.FloaterPropertyObjects.chartungroupnodes;
    }
    let floaterObject = {
        id: itemId,
        dpfloater: dictProps,
        customprops: {
            iconGroup: iconGroup,
            graphicId: grahicDiv?.getAttribute("id"),
            graphicIndex: grahicDiv?.getAttribute("data-graphic-index"),
        },
    };
    if (customImageSource) {
        floaterObject.customprops["customimageset"] = customImageSource;
        floaterObject.customprops["groupid"] = imageFolder;
    }
    let stroreObjectDetails = {
        graphicID: grahicDiv?.getAttribute("id"),
    };
    //store grahicDiv here on store
    storeGraphicDiv(grahicDiv);

    this.ChartUtils.getAppStore()?.setState((prevState) => ({
        ...prevState,
        selectedNode: JSON.parse(JSON.stringify(stroreObjectDetails || {})),
    }));
    return floaterObject;
};

CssFloaterUpdates.prototype.parseBoolen = function (value) {
    switch (value) {
        case "true":
        case true:
            return true;
        default:
            return false;
    }
};

CssFloaterUpdates.prototype.resetChartGroupNodes = function (grahicDiv) {
    if (!grahicDiv) return;

    // Get chartId from grahicDiv
    let chartId = this.ChartUtils.getOrCreateChartId(grahicDiv);
    if (!chartId) return;

    // Use ChartUtils method to reset
    this.ChartUtils.resetChartGroupNodes(chartId, grahicDiv);
};

CssFloaterUpdates.prototype.checkFirstItemBasedOnIndex = function (chartId) {
    if (!chartId) return "";

    // Use ChartUtils method to get first item index
    return this.ChartUtils.checkFirstItemBasedOnIndex(chartId);
};

CssFloaterUpdates.prototype.getChartItemMetaData = function (strProperty, strPropertyValue) {
    let ChartMetaDataClass = new window["chartjsonValue"]();
    let ChartMetaData = ChartMetaDataClass.getChartValue();
    let arrItems = [];
    let arrCharts = ChartMetaData.charts;
    if (arrCharts[strPropertyValue]) {
        arrItems.push(arrCharts[strPropertyValue]);
    }
    return arrItems;
};

CssFloaterUpdates.prototype.checkAlignmentValue = function (alignment) {
    if (alignment) {
        if (alignment.includes("right")) return "right";
        else if (alignment.includes("left")) return "left";
        else if (alignment.includes("center")) return "center";
    }
};

CssFloaterUpdates.prototype.getParentElementProp = function (eltarget) {
    if (eltarget.getAttribute("id") == "base-chart") {
        return eltarget;
    } else {
        eltarget = eltarget.parentElement;
        return eltarget ? this.getParentElementProp(eltarget) : null;
    }
};

CssFloaterUpdates.prototype.checkmultiSeriesItemChart = function (graphicDiv) {
    let arrSeries = graphicDiv?.querySelectorAll(".series");
    let series = arrSeries?.[0];
    let seriesItem = series?.querySelectorAll(".baseseriesitem");
    if (seriesItem?.length > 1) {
        return true;
    }
    return false;
};

CssFloaterUpdates.prototype.getImageSource = function (id) {
    let duplicateMenu = JSON.parse(JSON.stringify({}));
    let categories = duplicateMenu && duplicateMenu.categories ? duplicateMenu.categories : [];
    for (let i1 = 0; i1 < categories.length; i1++) {
        if (categories[i1].id == id) {
            return categories[i1];
        }
    }
};

CssFloaterUpdates.prototype.getFloaterImageProp = function (imageType) {
    return {
        floaterproperty: "chartimageplaceholder",
        dpsource: [
            { data: "circle", label: "circle" },
            { data: "rectangle", label: "rectangle" },
            { data: "square", label: "square" },
        ],
        selectedindex: imageType === "circle" ? 0 : imageType === "rectangle" ? 1 : 2,
    };
};

CssFloaterUpdates.prototype.setHighlightProperty = function (eltarget, parent, grahicDiv) {
    let elementType = eltarget.getAttribute("data-type");
    let index = elementType == "value" || elementType == "graphic" || elementType == "legendvalue" ? eltarget.id.split("-")[1].split("_")[0] : eltarget.id.split("-")[1];
    if (elementType == "secondarylabel") {
        index = eltarget.id.split("-")[2];
    }
    let chartData = grahicDiv.querySelector(".chartbase");
    let highlighttype = chartData.children[parseInt(index)].getAttribute("highlight") == "true" ? true : false;
    let highlightDesc = chartData.children[parseInt(index)].getAttribute("caption");
    highlightDesc = highlightDesc && highlighttype ? highlightDesc : "";
    let highlightStyle = chartData.children[parseInt(index)].getAttribute("highlightstyle");
    highlightStyle = highlightStyle ? highlightStyle : "text";
    let metaData = grahicDiv.querySelector(".metadata_group_chart");
    let strGraphicIcon = highlightStyle == "texticon" ? (window.IndexStore ? window.IndexStore.getInstance().staticServerURL : "") : "";
    let hasEmphasis = metaData.getAttribute("emphasis") == "true" ? true : false;
    let showProjection = metaData.getAttribute("projection") == "true" ? true : false;
    let emphasis = chartData.children[parseInt(index)].getAttribute("emphasis") == "true" ? true : false;
    let hasSortorder = chartData.children[parseInt(index)].getAttribute("sortorder") == "true" ? true : false;
    let hasProjection = chartData.children[parseInt(index)].getAttribute("projection") == "true" ? true : false;
    let highlightIcon = chartData.children[parseInt(index)].getAttribute("highlighticonpath")
        ? !chartData.children[parseInt(index)].getAttribute("highlighticonpath").includes("http")
            ? strGraphicIcon + chartData.children[parseInt(index)].getAttribute("highlighticonpath")
            : chartData.children[parseInt(index)].getAttribute("highlighticonpath")
        : null;
    let showGraphicImage = metaData.getAttribute("graphicimage") == "true" ? true : false;
    let hasGraphicImage = chartData.children[parseInt(index)].getAttribute("graphicimage") == "true" ? true : false;
    let boolProjection = chartData.getAttribute("projection") == "true" ? true : false;
    let boolEmphasize = chartData.getAttribute("emphasis") == "true" ? true : false;
    let boolGraphicImage = chartData.getAttribute("graphicimage") == "true" ? true : false;
    let isProjection = this.projectionCheck(chartData, index);
    let showSortOrder = metaData.getAttribute("sublength") == 1 && metaData.getAttribute("length") != 1 ? true : false;
    // if (highlightStyle == "texticon") chartData.children[parseInt(index)].setAttribute("highlighticonpath", highlightIcon);
    return {
        targetIndex: index,
        projection: boolEmphasize ? false : showProjection ? isProjection : showProjection,
        value: highlighttype,
        description: highlightDesc,
        floaterproperty: "highlight",
        highlightstyle: highlightStyle,
        highlightemphasize: boolProjection ? false : hasEmphasis,
        highlightemphasizeselected: emphasis,
        highlighticon: highlightIcon,
        highlightprojectionselected: hasProjection,
        sortorderselected: hasSortorder,
        graphicImage: boolProjection ? false : showGraphicImage,
        sortOrder: showSortOrder,
        graphicimageselected: hasGraphicImage,
    };
};

CssFloaterUpdates.prototype.projectionCheck = function (chartData, index) {
    let tempIndex = index?.includes("_") ? index.split("_")[0] : index;
    let intIndex = 0;
    let boolProjection = false;
    for (let i1 = 0; i1 < chartData.children.length; i1++) {
        let projection = chartData.children[i1].getAttribute("projection") == "true" ? true : false;
        if (projection) {
            intIndex = i1;
            boolProjection = true;
            break;
        }
    }
    return boolProjection ? (intIndex >= tempIndex ? true : false) : true;
};

CssFloaterUpdates.prototype.setSortorderProperety = function (hasHightlightProperty) {
    return {
        floaterproperty: "sortorder",
        value: hasHightlightProperty["sortorderselected"],
        visible: hasHightlightProperty.sortOrder,
    };
};

CssFloaterUpdates.prototype.setEmphasisProperty = function (hasHightlightProperty) {
    return {
        floaterproperty: "highlightemphasize",
        value: hasHightlightProperty["highlightemphasizeselected"],
        visible: hasHightlightProperty["highlightemphasize"],
    };
};

CssFloaterUpdates.prototype.getSelectedIndex = function (list, value, index = 0) {
    let length = list.length;
    for (let i1 = 0; i1 < length; i1++) {
        if (list[i1].data == value) {
            return i1;
        }
    }
    return index;
};

CssFloaterUpdates.prototype.setProjectionProperty = function (hasHightlightProperty) {
    return {
        floaterproperty: "projection",
        value: hasHightlightProperty["highlightprojectionselected"],
        visible: hasHightlightProperty.projection,
    };
};

CssFloaterUpdates.prototype.setGraphicImageProperety = function (hasHightlightProperty) {
    return {
        floaterproperty: "graphicimage",
        value: hasHightlightProperty["graphicimageselected"],
        visible: hasHightlightProperty.graphicImage,
    };
};

CssFloaterUpdates.prototype.setItemLinkProperty = function (eltarget, grahicDiv) {
    let index = eltarget.id.split("-")[0] == "value" || eltarget.id.split("-")[0] == "graphic" || eltarget.id.split("-")[0] == "legendvalue" ? eltarget.id.split("-")[1].split("_")[0] : eltarget.id.split("-")[1];
    let elementType = eltarget.getAttribute("data-type");
    if (elementType == "secondarylabel") {
        index = eltarget.id.split("-")[2];
    }
    let chartData = grahicDiv.querySelector(".chartbase");
    let childData = chartData.children[parseInt(index)].getAttribute("data-navigate-to-slide-on-click");
    let link = chartData.children[parseInt(index)].getAttribute("link");
    if (childData)
        return {
            floaterproperty: "selectedtextlinkurl",
            navigateslideid: link == "SLIDE" ? childData : "",
            description: link == "URL" ? childData : "",
            value: false,
        };
    else return this.FloaterPropertyObjects.selectedtextlinkurl;
};

CssFloaterUpdates.prototype.getGraphicElement = function (element) {
    if (!element) return null;
    if (element?.getAttribute("class")?.includes("ci-layout-container")) {
        return element;
    }
    if (element.parentElement) {
        return this.getGraphicElement(element.parentElement);
    }
    return null;
};

// import DocumentStore from "../../store/DocumentStore";
// import MenuParser from "../../util/MenuParser";

function ChartFloaterOperationHelper() {
    this.chartUtils = new window["ChartUtils"]();
    this.chartHelper = new window["ChartHelper"]();
    // Constructor - initialize any instance properties if needed
}

ChartFloaterOperationHelper.prototype.getChartSupportData = function (objDetails, xmlData, callback = null, callbackparams = null, divParent = null) {
    if (objDetails) {
        if (objDetails.property == "dropdowncount" || objDetails.property == "nodecount") {
            this.addNode(xmlData, objDetails, callback, callbackparams);
        } else if (objDetails.operation == "add" || objDetails.operation == "delete" || objDetails.property == "deleteasset" || objDetails.property == "chartrowcount" || objDetails.property == "chartcolumncount") {
            if (xmlData) xmlData.removeAttribute("overlapgrid");
            this.addRowCol(xmlData, objDetails, divParent);
        } else if (objDetails.property == "textcolor") {
            this.updateTextColor(xmlData, objDetails);
        } else if (objDetails.property == "textopacity") {
            this.createPropertyvalue(objDetails, xmlData);
        } else if (objDetails.property == "texttransform") {
            this.createPropertyvalue(objDetails, xmlData);
        } else if (objDetails.property == "textsize") {
            this.createPropertyvalue(objDetails, xmlData);
        } else if (objDetails.property == "axisbaseline") {
            this.axisBaselineoperation(xmlData, objDetails);
        } else if (objDetails.property == "assetextratext") {
            this.assetExtraText(xmlData, objDetails);
        } else if (objDetails.property == "textsize") {
            this.createPropertyvalue(objDetails, xmlData);
        } else if (objDetails.property == "spline") {
            xmlData.setAttribute("data-spline", objDetails.value);
        } else if (objDetails.property == "linehead") {
            xmlData.setAttribute("data-linehead", objDetails.value);
        } else if (objDetails.property == "deletebaseline") {
            this.removeBaseLine(xmlData, objDetails);
        } else if (objDetails.property == "cleartextstyles") {
            let targetId = objDetails.targetid;
            let range = objDetails;
            if (objDetails.property == "cleartextstyles") {
                let element = xmlData?.parentNode?.parentNode?.querySelector("[id='" + targetId + "']");
                while ((element && element.parentElement && element.parentElement.dataset.type == "SUB_TEXT_SPAN") || !element?.parentElement?.id) {
                    element = element.parentElement;
                }
                targetId = element.parentElement.id;
            }
            // if (objDetails.range) OperationsManager.getInstance().doSelectedTextStyleChangeOperation(objDetails.slideId, targetId, objDetails.range, objDetails.property, objDetails.value, null);
        } else if (objDetails.property == "changelogocontrast") {
            let index = objDetails.targetid.split("-")[1].split("-")[0];
            if (index == "placeholder" && objDetails.targetid.split("-").length > 2) {
                index = objDetails.targetid.split("-")[2];
            }
            if (index.includes("_")) {
                index = index.split("_")[0];
            }
            xmlData.children[index].setAttribute("logocontrast", objDetails.value);
        } else if (
            objDetails.property == "sortorder" ||
            objDetails.property == "projection" ||
            objDetails.property == "graphicimage" ||
            objDetails.property == "highlightstyle" ||
            objDetails.property == "enablehighlight" ||
            objDetails.property == "highlightemphasize" ||
            objDetails.property == "highlightdescription" ||
            objDetails.property == "deletesimplehighlight"
        ) {
            this.getHighlightProperty(xmlData, objDetails);
            if (objDetails.property == "sortorder") {
                AppDispatcher.dispatch({ type: "REMOVE_FLOATER" });
            }
        } else if (objDetails.property == "primaryplaceholder") {
            xmlData.setAttribute(objDetails.property, objDetails.value);
        } else if (objDetails.property == "selectedtextlinkurl") {
            this.getChartURLData(objDetails, xmlData, divParent);
        } else if (objDetails.property == "valuefontsizelist" || (objDetails.property == "fontsize" && (objDetails.targetid.includes("valuetex") || objDetails.targetid.includes("legendvalue") || objDetails.targetid.includes("pvalue")))) {
            xmlData.setAttribute("data-customfontsizeclass", objDetails.value);
        } else if (objDetails.property == "diagramgraphictype" || objDetails.property == "chartimageplaceholder") {
            let indexValue = objDetails.targetid.split("-")[1].split("_")[0];
            if (indexValue == "placeholder" && objDetails.targetid.includes("primary-placeholder-")) {
                indexValue = objDetails.targetid.split("-")[2] ? parseInt(objDetails.targetid.split("-")[2]) : objDetails.targetid.split("-")[2];
            }
            if (xmlData.getAttribute("comparedivider") == "true" && objDetails.property == "diagramgraphictype") {
                indexValue = indexValue ? parseInt(indexValue) : indexValue;
                xmlData.removeAttribute("compareplaceholder" + (indexValue + 1));
                xmlData.children[indexValue].setAttribute("placeholdertype", objDetails.value);
            } else if (objDetails.property == "diagramgraphictype") xmlData.children[indexValue].setAttribute("placeholdertype", objDetails.value);
            else if (objDetails.property == "chartimageplaceholder") xmlData.children[indexValue].setAttribute("imageplaceholdertype", objDetails.value);
        } else if (objDetails.property == "customdoughnut") {
            this.customDoughnutoperation(xmlData, objDetails);
        } else if (objDetails.property == "semichart") {
            this.customSemiChartoperation(xmlData, objDetails);
        } else if (objDetails.property == "fontbold" || objDetails.property == "fontitalic") {
            if (objDetails && objDetails["elementvalue"]) {
                this.createPropertyvalue(objDetails, xmlData);
            } else {
                if (objDetails.property == "fontbold") xmlData.setAttribute("data-titlefontbold", objDetails.value);
                else if (objDetails.property == "fontitalic") xmlData.setAttribute("data-titleitalic", objDetails.value);
            }
        } else if (objDetails.property == "fontsize") {
            if (objDetails && objDetails["elementvalue"]) {
                this.createPropertyvalue(objDetails, xmlData);
            } else {
                xmlData.setAttribute("data-titlefontclass", objDetails.value);
            }
        } else if (objDetails.property == "baseline") {
            if (objDetails.value) {
                xmlData.setAttribute("data-baseline", objDetails.value);
                xmlData.removeAttribute("userhighvaluebreak");
                xmlData.removeAttribute("highvaluebreak");
            } else {
                xmlData.removeAttribute("data-baseline");
                xmlData.removeAttribute("axisbaseline");
            }
        } else if (objDetails.property == "animationSWITCH") {
            if (!objDetails.value) {
                xmlData.setAttribute("animation", "animationoff");
            }
            if (objDetails.value) {
                xmlData.setAttribute("animation", "animateallatonce");
            }
        } else if (objDetails.property == "yaxismaxvaluelabel") {
            xmlData.setAttribute("yaxissteps", objDetails.value);
            if (!objDetails.value) {
                xmlData.removeAttribute("yaxismaxvalue");
                xmlData.removeAttribute("custommaxvalue");
            }
        } else if (objDetails.property == "primaryplaceholderTypeSWITCH") {
            if (xmlData.getAttribute("comparedivider") == "true") {
                xmlData.setAttribute("enablecompareplaceholder", objDetails.value);
            } else {
                if (objDetails.value) {
                    xmlData.setAttribute("primaryplaceholder", objDetails.value);
                } else {
                    xmlData.removeAttribute("primaryplaceholder");
                }
            }
        } else if (objDetails.property == "primaryplaceholderType") {
            xmlData.setAttribute("primaryplaceholder-type", objDetails.value);
            for (let k1 = 0; k1 < xmlData.children.length; k1++) {
                xmlData.removeAttribute("compareplaceholder" + (k1 + 1));
                xmlData.children[k1].setAttribute("placeholdertype", objDetails.value);
            }
        } else if (objDetails.property == "valueprefixtype") {
            let strPrefixValue = this.createSuffixValue(xmlData, objDetails.value);
            xmlData.setAttribute(objDetails.property, strPrefixValue);
            for (let k1 = 0; k1 < xmlData.children.length; k1++) {
                xmlData.children[k1].setAttribute("prefix", strPrefixValue);
            }
        } else if (objDetails.property == "valuesuffixtype") {
            let strSuffixValue = this.createSuffixValue(xmlData, objDetails.value);
            xmlData.setAttribute(objDetails.property, strSuffixValue);
            for (let k1 = 0; k1 < xmlData.children.length; k1++) {
                xmlData.children[k1].setAttribute("suffix", strSuffixValue);
            }
        } else if (objDetails.property == "valuedisplayformat") {
            let oldvalueFormat = xmlData.getAttribute("valueformat");
            if (oldvalueFormat) {
                xmlData.setAttribute("oldvalueformat", oldvalueFormat);
            } else {
                xmlData.setAttribute("oldvalueformat", "asentered");
            }
            xmlData.setAttribute("valueformat", objDetails.value);
            if (objDetails.value == "percentage") {
                for (let j1 = 0; j1 < xmlData.children.length; j1++) {
                    let suffixValue = this.createSuffixValue(xmlData, "%");
                    xmlData.children[j1].setAttribute("suffix", suffixValue);
                    xmlData.children[j1].setAttribute("prefix", "");
                    xmlData.setAttribute("valuesuffixtype", suffixValue);
                }
            }
            if (objDetails.value == "currency") {
                for (let j1 = 0; j1 < xmlData.children.length; j1++) {
                    let prefixValue = this.createSuffixValue(xmlData, "$");
                    xmlData.children[j1].setAttribute("prefix", prefixValue);
                    xmlData.children[j1].setAttribute("suffix", "");
                    xmlData.children[j1].setAttribute("currencysymbol", "");
                    xmlData.setAttribute("valueprefixtype", prefixValue);
                }
            }
            if (objDetails.value == "number") {
                for (let j1 = 0; j1 < xmlData.children.length; j1++) {
                    if (!xmlData.getAttribute("valueprefixtype")) xmlData.children[j1].setAttribute("prefix", "");
                    xmlData.children[j1].setAttribute("suffix", "");
                    if (oldvalueFormat == "currency") xmlData.children[j1].setAttribute("prefix", "");
                }
            }
            if (objDetails.value == "asentered") {
                xmlData.setAttribute("asentered", "true");
                for (let j1 = 0; j1 < xmlData.children.length; j1++) {
                    if (oldvalueFormat == "currency") xmlData.children[j1].setAttribute("prefix", "");
                }
            }
        } else if (objDetails.property == "highlightdifference") {
            xmlData.setAttribute(objDetails.property, objDetails.value);
            let type = xmlData.getAttribute("data-indualhighlight") || xmlData.getAttribute("indualhd");
            if (type) {
                xmlData.setAttribute("data-indualhighlight", objDetails.value);
                if (!objDetails.value) {
                    xmlData.removeAttribute("data-highlightdifference");
                    xmlData.removeAttribute("highlightdifference");
                }
            } else {
                if (objDetails.value) {
                    xmlData.setAttribute("data-highlightdifference", objDetails.value);
                    xmlData.setAttribute("highlightdifference", objDetails.value);
                } else {
                    xmlData.removeAttribute("data-highlightdifference");
                    xmlData.removeAttribute("highlightdifference");
                }
            }
        } else if (objDetails.property == "hdtype") {
            xmlData.setAttribute(objDetails.property, objDetails.value);
            let hdtype = xmlData.getAttribute("hdtype");
            if (hdtype == "all") {
                xmlData.setAttribute("data-indualhighlight", true);
                xmlData.removeAttribute("data-highlightdifference");
                xmlData.removeAttribute("highlightdifference");
            } else {
                xmlData.setAttribute("data-highlightdifference", true);
                xmlData.setAttribute("data-indualhighlight", false);
                xmlData.setAttribute("indualhd", false);
            }
        } else if (objDetails.property == "commonplaceholdertypeSWITCH") {
            if (objDetails.value) {
                let chartName = xmlData.getAttribute("name");
                if (chartName.toLowerCase().includes("doughnut") || (xmlData.getAttribute("innerradius") && xmlData.getAttribute("innerradius") != 0)) {
                    xmlData.setAttribute(objDetails.property, objDetails.value);
                }
            } else {
                xmlData.setAttribute(objDetails.property, objDetails.value);
            }
        } else if (objDetails.property == "sourcetextrightalign" || objDetails.property == "sourcetextcenteralign" || objDetails.property == "sourcetextleftalign") {
            xmlData.setAttribute("sourcetextalign", objDetails.property);
        } else if (objDetails.property == "titletextrightalign" || objDetails.property == "titletextcenteralign" || objDetails.property == "titletextleftalign") {
            xmlData.setAttribute("charttitlealign", objDetails.property);
        } else if (
            objDetails.property == "projectiontextleftalign" ||
            objDetails.property == "projectiontextrightalign" ||
            objDetails.property == "projectiontextcenteralign" ||
            objDetails.property == "projectionheadingtextcenteralign" ||
            objDetails.property == "projectionheadingtextleftalign" ||
            objDetails.property == "projectionheadingtextrightalign" ||
            objDetails.property == "projectiondisabletextleftalign" ||
            objDetails.property == "projectiondisabletextrightalign" ||
            objDetails.property == "projectiondisabletextcenteralign" ||
            objDetails.property == "projectionheadingdisabletextleftalign" ||
            objDetails.property == "projectionheadingdisabletextrightalign" ||
            objDetails.property == "projectionheadingdisabletextcenteralign"
        ) {
            if (objDetails.property.includes("projectiondisable") || objDetails.property.includes("projectionheadingdisable")) {
                if (objDetails.property.includes("heading")) {
                    xmlData.setAttribute("projectiondisabledheadingtextalign", objDetails.property);
                } else {
                    xmlData.setAttribute("projectiondisabledtextalign", objDetails.property);
                }
            } else {
                if (objDetails.property.includes("heading")) {
                    xmlData.setAttribute("projectionheadingtextalign", objDetails.property);
                } else {
                    xmlData.setAttribute("projectiontextalign", objDetails.property);
                }
            }
        } else if (objDetails.property == "prompttext") {
            if (xmlData.getAttribute("prompthide") != "true" || !objDetails.value) {
                xmlData.setAttribute(objDetails.property, objDetails.value);
            }
        } else if (objDetails.property == "resettextprops") {
            this.resetAllTextProps(xmlData, objDetails);
        } else if (objDetails.property == "userhighvaluebreak") {
            xmlData.setAttribute(objDetails.property, objDetails.value);
            xmlData.removeAttribute("data-baseline");
            xmlData.removeAttribute("baseline");
        } else if (objDetails.property == "changetablecontent") {
            if (xmlData.getAttribute("changetablecontent") == "true") {
                xmlData.removeAttribute("changetablecontent");
            } else {
                xmlData.setAttribute("changetablecontent", true);
            }
        } else if (objDetails.property == "changechartlist") {
        } else if (objDetails.property == "valueinterchange") {
            let childrenNodes = xmlData.children;
            let oldMultiseriesLengendValue = xmlData.getAttribute("oldmultiserieslegend");
            let multiseriesLengendValue = xmlData.getAttribute("multiserieslegend");
            if (!oldMultiseriesLengendValue) {
                xmlData.setAttribute("oldmultiserieslegend", multiseriesLengendValue);
                oldMultiseriesLengendValue = multiseriesLengendValue;
            }
            for (let i1 = 0; i1 < childrenNodes.length; i1++) {
                let valueData = childrenNodes[i1].getAttribute("value");
                let oldStrValue = childrenNodes[i1].getAttribute("oldvaluedata");
                let asenteredvalue = childrenNodes[i1].getAttribute("asenteredvalue");
                let oldAsenteredvalue = childrenNodes[i1].getAttribute("oldasenteredvalue");

                if (!oldStrValue) {
                    childrenNodes[i1].setAttribute("oldvaluedata", valueData);
                    childrenNodes[i1].setAttribute("oldasenteredvalue", asenteredvalue);
                    oldStrValue = valueData;
                    oldAsenteredvalue = asenteredvalue;
                }
                let arrayValues = oldStrValue?.split(",");
                let arrayAsenterValue = oldAsenteredvalue?.split("^");
                let newArrangment = objDetails?.value?.order?.split(",");
                let strValue = "";
                let strAsenteredvalue = "";
                let strMultiSeriesLegend = "";

                for (let v1 = 0; v1 < newArrangment.length; v1++) {
                    let index = newArrangment[v1];
                    if (v1 == 0) {
                        strValue += arrayValues[index];
                        strAsenteredvalue += arrayAsenterValue[index];
                    } else {
                        strValue += "," + arrayValues[index];
                        strAsenteredvalue += "^" + arrayAsenterValue[index];
                    }
                    if (i1 == 0) {
                        let multiSeriesLegend = oldMultiseriesLengendValue?.split(",");
                        if (v1 == 0) {
                            strMultiSeriesLegend += multiSeriesLegend[index];
                        } else {
                            strMultiSeriesLegend += "," + multiSeriesLegend[index];
                        }
                    }
                }
                if (i1 == 0 && strMultiSeriesLegend) {
                    xmlData.setAttribute("multiserieslegend", strMultiSeriesLegend);
                }
                if (strValue) {
                    childrenNodes[i1].setAttribute("asenteredvalue", strAsenteredvalue);
                    childrenNodes[i1].setAttribute("valueinterchange", objDetails?.value?.order);
                    childrenNodes[i1].setAttribute("value", strValue);
                }
            }
        } else if (objDetails.property == "labelinterchange") {
            let value = objDetails?.value;
            xmlData.setAttribute("labeldatachanged", true);
            if (value.includes("value")) {
                xmlData.setAttribute("interchangelabeldata", value);
                let valueIndex = parseInt(value.match(/\d+/)[0]);
                for (let l1 = 0; l1 < xmlData.children.length; l1++) {
                    let value = xmlData.children[l1].getAttribute("value")?.split(",")?.[valueIndex];
                    let displayValueFormat = xmlData.getAttribute("maindisplayformat");
                    if (displayValueFormat == "asentered") {
                        value = xmlData.children[l1].getAttribute("asenteredvalue")?.split("^")?.[valueIndex];
                    }
                    let oldLabel = xmlData.children[l1].getAttribute("oldlabeldata");
                    if (!oldLabel) {
                        let name = xmlData.children[l1].getAttribute("name");
                        xmlData.children[l1].setAttribute("oldlabeldata", name);
                    }
                    xmlData.children[l1].setAttribute("name", value);
                }
            } else {
                xmlData.removeAttribute("interchangelabeldata");
                for (let l1 = 0; l1 < xmlData.children.length; l1++) {
                    let oldLabel = xmlData.children[l1].getAttribute("oldlabeldata");
                    if (oldLabel) {
                        xmlData.children[l1].setAttribute("name", oldLabel);
                    } else {
                        let name = xmlData.children[l1].getAttribute("name");
                        xmlData.children[l1].setAttribute("name", name);
                    }
                    xmlData.children[l1].removeAttribute("oldlabeldata");
                }
            }
        } else if (objDetails.property == "highlightdifferencedelete") {
            this.updateHighlightDifferencePoint(xmlData, objDetails);
        } else if (objDetails.property == "chartgroupnodes") {
            this.updateChartGroupNodes(xmlData, objDetails, divParent);
            this.resetChartGroupNodes(divParent);
        } else if (objDetails.property == "chartungroupnodes") {
            this.updateChartUngroupNodes(xmlData, objDetails, divParent);
            this.resetChartGroupNodes(divParent);
        } else if (objDetails.property == "deleteprojectionheading") {
            if (objDetails.data?.projectiondisabletext) {
                xmlData.removeAttribute("PROJECTION_DISABLED_HEADING");
            } else {
                xmlData.removeAttribute("PROJECTION_HEADING");
            }
        } else if (objDetails.property == "multiseriesitemhighlight") {
            this.updateChartMultiSeriesItemHighlight(xmlData, objDetails);
        } else if (objDetails.property == "cagr") {
            if (objDetails.value) {
                xmlData.setAttribute("cagr", objDetails.value);
                if (xmlData.getAttribute("name") == "columnStackedRectangle") {
                    xmlData.removeAttribute("customlegend");
                    xmlData.setAttribute("boolseriesitemlabel", true);
                }
            } else {
                xmlData.removeAttribute("cagr");
            }
        } else {
            if (objDetails.property == "showyaxisline") {
                xmlData.setAttribute("showcustomyaxisline", objDetails.value);
            }
            if (objDetails.property == "showyaxisgrid") {
                xmlData.setAttribute("showcustomyaxisgrid", objDetails.value);
            }
            if (objDetails.property == "showxaxisline") {
                xmlData.setAttribute("showcustomxaxisline", objDetails.value);
            }
            if (objDetails.property == "highlightdifferencepoint1") {
                xmlData.removeAttribute("highlightdifferencemenupoint1");
            }
            if (objDetails.property == "highlightdifferencepoint2") {
                xmlData.removeAttribute("highlightdifferencemenupoint2");
            }
            if (objDetails.property == "boolseriesitemlabel" && objDetails?.value) {
                xmlData.setAttribute("customlegend", false);
                xmlData.setAttribute("showyaxisgridline", false);
            }
            if (objDetails.property == "boolseriesitemlabel" && !objDetails?.value) {
                xmlData.removeAttribute("customseriesitemlabelposition");
            }
            if (objDetails.property == "secondarylinechart" && objDetails?.value) {
                xmlData.setAttribute("customlegend", true);
                xmlData.setAttribute("boolseriesitemlabel", false);
                xmlData.removeAttribute("customseriesitemlabelposition");
            }
            if (objDetails.property == "yaxismaxvalue") {
                if (!objDetails.value) {
                    xmlData.removeAttribute("customdisplaymaxvalue");
                } else {
                    xmlData.setAttribute("customdisplaymaxvalue", objDetails.value);
                }
                let arrValue = [{ input: objDetails.value.toString() }];
                let arrItemList = [this.chartUtils.formatChartValues(arrValue[0])];
                let value = arrItemList && arrItemList.length > 0 && arrItemList[0].currencyValueNormalized ? arrItemList[0].currencyValueNormalized : objDetails.value;
                if (value) {
                    xmlData.setAttribute("custommaxvalue", value);
                }
                if (objDetails.property && value) xmlData.setAttribute(objDetails.property, value);
                else if (objDetails.property) xmlData.removeAttribute(objDetails.property);
            } else if (objDetails.property == "headerleftalign" || objDetails.property == "headercenteralign" || objDetails.property == "headerrightalign") {
                switch (objDetails.targetid) {
                    case "item-Header":
                        xmlData.setAttribute("itemheaderalign", objDetails.property);
                        break;
                    case "value-Header":
                        xmlData.setAttribute("valueheaderalign", objDetails.property);
                        break;
                    case "label-header":
                        xmlData.setAttribute("labelheaderalign", objDetails.property);
                        break;
                    case "secondary-Header":
                        xmlData.setAttribute("secondaryheaderalign", objDetails.property);
                        break;
                }
            } else if (objDetails.property == "legendposition") {
                xmlData.setAttribute("floatertextposition", objDetails.value);
                let firstValue = objDetails.value.split("_")[0];
                let secondValue = objDetails.value.split("_")[1];
                xmlData.setAttribute("customlegendposition", firstValue);
                xmlData.setAttribute("customlegendpositionsecondaryalignment", secondValue);
                xmlData.setAttribute("legendpositionalignment", objDetails.value);
            } else {
                if (objDetails.property == "linehighlightvaluedisplay") {
                    let index = objDetails.targetid.split("-")[1].split("-")[0];
                    if (objDetails.targetid && objDetails.targetid.includes("valuetext")) {
                        index = objDetails.targetid.split("-")[1].split("_")[0];
                    }
                    if (index == "placeholder" && objDetails.targetid.split("-").length > 2) {
                        index = objDetails.targetid.split("-")[2];
                    }
                    xmlData.children[index].setAttribute("linehighlightvaluedisplay", objDetails.value);
                } else if (objDetails.property?.includes("highlightdifferencepoint")) {
                    let baseHighlightDifferencePointIndex = Number(objDetails?.secondaryProperty?.match(/\d+/)[0] || 1);
                    let highlightDifferencePoint = Number(objDetails?.property?.match(/\d+/)[0] || 1);
                    let oldStrValue = xmlData.getAttribute("highlightdifferencepoint" + baseHighlightDifferencePointIndex);
                    let strData = "highlightdifferencepoint" + baseHighlightDifferencePointIndex;
                    if (oldStrValue) {
                        let arrValue = oldStrValue.split(",");
                        arrValue[highlightDifferencePoint - 1] = objDetails.value;
                        xmlData.setAttribute(strData, arrValue.join(","));
                    }
                } else {
                    if (objDetails.property) xmlData.setAttribute(objDetails.property, objDetails.value);
                }
            }
        }
    }
};
ChartFloaterOperationHelper.prototype.addNode = function (xmlData, objDetails, callback = null, callbackparams = null) {
    let itemIndex = 0;
    let length = xmlData.children.length;
    let numNodeCount = objDetails ? parseInt(objDetails.data) : "";
    xmlData.setAttribute("addnode", "true");
    objDetails.index = objDetails?.index && objDetails?.from == "hoverbtn" ? objDetails.index : numNodeCount;
    objDetails.operation = numNodeCount > length ? "add" : numNodeCount < length ? "delete" : "";
    let numNoOfItems = objDetails.operation == "add" ? numNodeCount - length : objDetails.operation == "delete" ? length - numNodeCount : 0;
    if (objDetails.operation == "add") {
        for (let i2 = 0; i2 < numNoOfItems; i2++) {
            let item = document.createElement("metadata");
            let metaData = xmlData.parentElement.parentElement;
            let primaryName = xmlData.getAttribute("primarychart");
            let secondaryName = xmlData.getAttribute("secondarychart");
            this.seriesLength = metaData.querySelector(".metadata_group_chart").getAttribute("sublength");
            let chartName = xmlData.getAttribute("name");
            //this.seriesLength = chartName=="logoGraphicComparisonChart"?(this.seriesLength+1):this.seriesLength;
            let valuePrefix = xmlData.getAttribute("valueprefixtype") ? xmlData.getAttribute("valueprefixtype") : "";
            let valuesuffix = xmlData.getAttribute("valuesuffixtype") ? xmlData.getAttribute("valuesuffixtype") : "";
            let value = this.seriesLength < 1 ? "25" : this.addValue(xmlData, objDetails, i2);
            let denamination = "";
            xmlData.setAttribute("addenable", "false");
            this.addNodeValue(value, primaryName, secondaryName, item, objDetails, this.seriesLength, xmlData, i2, valuePrefix, valuesuffix, denamination, chartName);
        }
    } else if (objDetails.operation == "delete" || objDetails.property == "deleteasset") {
        for (let i2 = 0; i2 < numNoOfItems; i2++) {
            for (let i1 = 0; i1 < length; i1++) {
                itemIndex = parseInt(xmlData.children[i1].attributes["index"].nodeValue);
                if (objDetails.index < itemIndex) {
                    xmlData.children[i1].attributes["index"].nodeValue = itemIndex - 1;
                }
            }
            length--;
            let nodeItem = xmlData.children[length];
            xmlData.removeChild(nodeItem);
        }
    }

    // }
};
ChartFloaterOperationHelper.prototype.addNodeValue = function (value, primaryName, secondaryName, item, objDetails, seriesLength, xmlData, i2, valuePrefix, valuesuffix, denamination, chartName, chartLabel = "") {
    xmlData.setAttribute("addenable", "true");
    if (value.toString().split(",").length < 2) {
        let arrValue = [{ input: value.toString() }];
        let arrItemList = [this.chartUtils.formatChartValues(arrValue[0])];
        value = arrItemList && arrItemList.length > 0 && arrItemList[0].value ? arrItemList[0].value : value;
        denamination = arrItemList && arrItemList.length > 0 && arrItemList[0].currencySystem ? arrItemList[0].currencySystem : denamination;
    }
    if (primaryName && secondaryName) {
        item.setAttribute("class", "chartitem");
        item.setAttribute("name", chartLabel);
        item.setAttribute("index", objDetails.index);
        item.setAttribute("value", value);
        item.setAttribute("secondaryvalue", seriesLength < 1 ? "25" : this.addValue(xmlData, objDetails, i2, "secondaryvalue"));
        item.setAttribute("prefix", valuePrefix);
        item.setAttribute("suffix", valuesuffix);
        item.setAttribute("denomination", denamination);
        item.setAttribute("sprefix", "");
        item.setAttribute("ssuffix", "");
        item.setAttribute("sdenomination", "");
    } else {
        item.setAttribute("class", "chartitem");
        item.setAttribute("name", chartLabel);
        item.setAttribute("index", objDetails.index);
        item.setAttribute("value", value);
        item.setAttribute("prefix", valuePrefix);
        item.setAttribute("suffix", valuesuffix);
        item.setAttribute("denomination", denamination);
    }
    let placeholderdatas = ["placeholder", "primaryplaceholderpath", "placeholdertype"];
    placeholderdatas.forEach(function (element) {
        if (xmlData.children[0].getAttribute(element)) {
            item.setAttribute(element, xmlData.children[0].getAttribute(element));
        }
    });

    if (chartName == "waterfallchart") {
        let lastNode = xmlData.children[xmlData.children.length - 1];
        item.setAttribute("asenteredvalue", value.split(",")[0]);
        xmlData.insertBefore(item, lastNode);
    } else {
        xmlData.appendChild(item);
    }
    let hasSeriesWidth = xmlData.children[0].getAttribute("seriesitemwidth");
    if (hasSeriesWidth) {
        let lastPreviousNode = xmlData.children[xmlData.children.length - 2];
        let seriesItemWidthValue = hasSeriesWidth;
        if (lastPreviousNode) {
            seriesItemWidthValue = lastPreviousNode.getAttribute("seriesitemwidth");
        }
        let randomAdjustment = Math.floor(Math.random() * 6) + 1;
        item.setAttribute("seriesitemwidth", parseInt(seriesItemWidthValue) + randomAdjustment);
    }
};
ChartFloaterOperationHelper.prototype.addValue = function (xmlData, objDetails, dropDownIndex = 0, property = "value") {
    let value;
    for (let i1 = 0; i1 < this.seriesLength; i1++) {
        if (i1 == 0) value = this.getChartValue(xmlData, objDetails, i1, dropDownIndex, property);
        else value += "," + this.getChartValue(xmlData, objDetails, i1, dropDownIndex, property); //",25";
    }
    let valueLength = xmlData.children[0].attributes["value"].nodeValue.split(",");
    let currentValueLength = value ? value.toString().split(",") : xmlData.children[0].attributes["value"].nodeValue.split(",");
    if (valueLength && currentValueLength && valueLength.length > currentValueLength.length) {
        let differentLength = valueLength.length - currentValueLength.length;
        for (let i1 = 0; i1 < differentLength; i1++) {
            value += "," + 30;
        }
    }
    return value;
};

ChartFloaterOperationHelper.prototype.getChartValue = function (xmlData, objDetails, valIndex, dropDownIndex, property = "value") {
    let index = 0;
    let value = 25;
    let range = "";
    let backValue = null;
    let frontValue = null;
    let dummyXmldata = xmlData.cloneNode(true);
    let childLength = xmlData.children.length;
    let previousValue = xmlData.children[childLength - 1]?.getAttribute("value")?.split(",")[0];
    let mathRandomCalcValue = this.randomFloatNumber(0.1, 1.4);
    if (previousValue) {
        value = previousValue == "0" ? Math.floor(Math.random() * 13 + 1).toString() : parseFloat(previousValue);
    }
    // this.doSort("asc", dummyXmldata, Number(dummyXmldata.children.length));
    let serieslength = dummyXmldata.children.length;
    let seriesItemlength = dummyXmldata.children[0].getAttribute(property).split(",").length;

    if (objDetails.type == "Column") {
        index = objDetails.columnIndex;
    } else if (objDetails.type == "Row" || objDetails.type == "ADD_ITEM" || objDetails.type == "DROPDOWN_SELECT" || !objDetails.type) {
        if (objDetails.type == "DROPDOWN_SELECT") index = serieslength;
        else index = objDetails.type == "Row" ? objDetails.rowIndex : objDetails.index - 1;

        if (index == 1) {
            range = "lower";
            let frontItem = dummyXmldata.children[index];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);
        } else if (index < serieslength) {
            range = "mid";
            let frontItem = dummyXmldata.children[index];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);

            let backItem = dummyXmldata.children[index - 1];
            if (backItem) backValue = parseInt(backItem.getAttribute(property).split(",")[valIndex]);
        } else if (serieslength == index) {
            range = "higher";
            let frontItem = dummyXmldata.children[index - 1];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);
        }
    }

    if (frontValue && backValue) {
        value = this.getRangeValue(range, frontValue, backValue);
    } else if (backValue) {
        value = this.getRangeValue(range, backValue);
    } else if (frontValue) {
        value = this.getRangeValue(range, frontValue);
    } else value = Math.ceil(value * ((valIndex + 1) * mathRandomCalcValue));
    return value;
};
ChartFloaterOperationHelper.prototype.randomFloatNumber = function (min, max) {
    min = min;
    max = max;
    return Math.random() * (max - min + 1) + min;
};

ChartFloaterOperationHelper.prototype.getRangeValue = function (range, firstvalue, secondvalue = null) {
    let value;
    let difference;

    if (secondvalue != null) {
        if (secondvalue < firstvalue) {
            difference = firstvalue - secondvalue;
        } else if (secondvalue > firstvalue) {
            difference = secondvalue - firstvalue;
        } else {
            difference = 0;
        }
    }

    if (range == "lower") {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference;
            } else {
                value = firstvalue * 0.8;
            }
        } else {
            value = firstvalue * 0.8;
        }
    } else if (range == "higher") {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference;
            } else {
                value = firstvalue * 1.2;
            }
        } else {
            value = firstvalue * 1.2;
        }
    } else {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference / 2;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference / 2;
            } else {
                value = firstvalue * 1.2;
            }
        } else {
            value = firstvalue;
        }
    }
    return Math.ceil(value);
};
ChartFloaterOperationHelper.prototype.addRowCol = function (xmlData, objDetails, divParent = null) {
    let itemIndex = 0;
    let length = xmlData.children.length;
    if (objDetails.targetid) objDetails.index = objDetails.targetid.split("-")[0] == "value" || "graphic" ? objDetails.targetid.split("-")[1]?.split("_")?.[0] : objDetails.targetid.split("-")?.[1];
    if (objDetails.targetid?.split("-")[0] == "secondary" || objDetails.targetid?.split("-")[0] == "primary") {
        objDetails.index = objDetails.targetid.split("-")[2];
    }
    objDetails.index = parseInt(objDetails.index || length);
    let columnIndex = objDetails.columnIndex == "lastindex" ? length : objDetails.columnIndex;
    if (objDetails.operation == "add") {
        if (objDetails.type == "Column") {
            if (objDetails.columnType == "text") {
                for (let i1 = 0; i1 < length; i1++) {
                    let arrAddValue = [];
                    arrAddValue = xmlData.children[i1].attributes["value"].nodeValue.split(",");
                    let asenteredValue = xmlData.children[i1].attributes["asenteredvalue"].nodeValue.split("^");
                    let value = this.getRandomValue(arrAddValue[0]);
                    arrAddValue.splice(columnIndex, 0, value);
                    asenteredValue.splice(columnIndex, 0, value);
                    xmlData.children[i1].attributes["value"].nodeValue = arrAddValue.toString();
                    xmlData.children[i1].attributes["asenteredvalue"].nodeValue = asenteredValue.join("^").toString();
                }
            } else if (objDetails.columnType == "icon") {
                xmlData.setAttribute("primaryplaceholder", true);
            }
        } else if (objDetails.type == "Row") {
            // let availabelMenu = this.checkMenuAvailabel(xmlData, objDetails, length + 1);
            // if (!availabelMenu) {
            //     AppDispatcher.dispatch({ type: "ALERT_MESSAGE", title: "invaliddata", message: "thistypeisnotsupported" });
            //     return;
            // }
            let item = document.createElement("metadata");
            let metaData = xmlData.parentElement.parentElement;
            let primaryName = xmlData.getAttribute("primarychart");
            let secondaryName = xmlData.getAttribute("secondarychart");
            this.seriesLength = metaData.querySelector(".metadata_group_chart").getAttribute("sublength");
            let placeHolderType = xmlData.getAttribute("primaryplaceholder-type");
            if (primaryName && secondaryName) {
                item.setAttribute("class", "chartitem");
                item.setAttribute("name", "");
                item.setAttribute("index", objDetails.index);
                item.setAttribute("asenteredvalue", this.addValue(xmlData, objDetails));
                item.setAttribute("value", this.addValue(xmlData, objDetails));
                item.setAttribute("secondaryvalue", this.addValue(xmlData, objDetails));
                item.setAttribute("prefix", "");
                item.setAttribute("suffix", "");
                item.setAttribute("denomination", "");
                item.setAttribute("sprefix", "");
                item.setAttribute("ssuffix", "");
                item.setAttribute("sdenomination", "");
            } else {
                item.setAttribute("class", "chartitem");
                item.setAttribute("name", "");
                item.setAttribute("index", objDetails.index);
                item.setAttribute("asenteredvalue", this.addValue(xmlData, objDetails));
                item.setAttribute("value", this.addValue(xmlData, objDetails));
                item.setAttribute("prefix", "");
                item.setAttribute("suffix", "");
                item.setAttribute("denomination", "");
            }
            if (placeHolderType == "logo") {
                item.setAttribute("placeholdertype", "logo");
            }
            xmlData.insertBefore(item, xmlData.children[objDetails.index]);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].attributes["index"].nodeValue = i1;
            }
        }
    } else if (objDetails.operation == "delete" || objDetails.property == "deleteasset") {
        // let availabelMenu = this.checkMenuAvailabel(xmlData, objDetails, length - 1, boolenablemenu);
        // if (!availabelMenu && objDetails.type != "Column") {
        //     AppDispatcher.dispatch({ type: "ALERT_MESSAGE", title: "invaliddata", message: "thistypeisnotsupported" });
        //     return;
        // }
        let projectionIndex = xmlData.getAttribute("projectionindex") ? parseInt(xmlData.getAttribute("projectionindex")) : "";
        if (projectionIndex && projectionIndex == objDetails.index && objDetails.type != "Column") {
            let boolProjection = xmlData.children[projectionIndex].getAttribute("projection") == "true" ? true : false;
            if (boolProjection) {
                xmlData.children[projectionIndex].removeAttribute("projection");
            }
            xmlData.removeAttribute("projection");
        }
        if (objDetails.type == "Column") {
            let columnIndex = objDetails.columnIndex - 1;
            if (objDetails.index && !objDetails.columnIndex) {
                columnIndex = objDetails.index - 1;
            }
            if (objDetails.index == 0 || objDetails.columnIndex == 0) return;
            for (let i1 = 0; i1 < length; i1++) {
                let arrDelValue = [];
                let assenteredValues = [];
                arrDelValue = xmlData.children[i1].attributes["value"].nodeValue.split(",");
                assenteredValues = xmlData.children[i1].attributes["asenteredvalue"].nodeValue.split("^");
                if (arrDelValue.length > 1) {
                    arrDelValue.splice(columnIndex, 1);
                    assenteredValues.splice(columnIndex, 1);
                    xmlData.children[i1].attributes["value"].nodeValue = arrDelValue?.join(",")?.toString();
                    xmlData.children[i1].attributes["asenteredvalue"].nodeValue = assenteredValues?.join("^")?.toString();
                } else return;
            }
        } else {
            for (let i1 = 0; i1 < length; i1++) {
                itemIndex = parseInt(xmlData.children[i1].attributes["index"].nodeValue);
                if (objDetails.index < itemIndex) {
                    xmlData.children[i1].attributes["index"].nodeValue = itemIndex - 1;
                }
            }
            let removeItem = xmlData.children[objDetails?.rowIndex];
            removeItem = !removeItem ? xmlData.children[objDetails.index] : removeItem;

            xmlData.removeChild(removeItem);
        }
    }
};
ChartFloaterOperationHelper.prototype.getRandomValue = function (BaseValue) {
    let newMultiplier = Math.floor(Math.random() * 2);
    newMultiplier = newMultiplier == 0 ? 1 : newMultiplier;
    let newValue = BaseValue * newMultiplier;
    return parseInt(newValue * 0.6);
};
// Dependency functions
ChartFloaterOperationHelper.prototype.updateTextColor = function (xmlData, objDetails) {
    let elementType = objDetails?.elementvalue;
    if (objDetails["indexvalue"]) {
        let indexValue = objDetails["indexvalue"];
        xmlData.children[indexValue].setAttribute(elementType + "textcolor", objDetails.value);
    } else {
        xmlData.setAttribute(elementType + "textcolor", objDetails.value);
    }
};

ChartFloaterOperationHelper.prototype.createPropertyvalue = function (objDetails, xmlData) {
    let attributeValue = null;
    let mainXmlProperty = ["secondarylabeltexttextsize", "secondarylabeltextfontsize", "secondarylabeltextfontbold", "secondarylabeltextfontitalic", , "secondarylabeltextletterspace"];
    if (objDetails["elementvalue"]) {
        attributeValue = objDetails["elementvalue"].replace("dynamicalign", objDetails.property);
    }
    if (attributeValue && !attributeValue.includes("chartgrouplabel") && !attributeValue.includes("seriesitemlabel") && (attributeValue.includes("labeltext") || attributeValue.includes("projectiontextfontsize") || attributeValue.includes("titletextfontsize"))) {
        if (attributeValue.includes("labeltextfontsize") || attributeValue.includes("labeltexttextsize")) {
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].setAttribute(attributeValue, objDetails.value);
                if (attributeValue == "labeltextfontsize") {
                    xmlData.children[i1].setAttribute("labeltexttextsize", "");
                }
                if (attributeValue == "secondarylabeltextfontsize") {
                    xmlData.children[i1].setAttribute("secondarylabeltexttextsize", "");
                }
            }
        } else {
            let index = objDetails.targetid && objDetails.targetid.split("-").length > 1 ? objDetails.targetid.split("-")[1] : "";
            if (attributeValue.includes("secondarylabeltext")) {
                index = objDetails.targetid && objDetails.targetid.split("-").length > 2 ? objDetails.targetid.split("-")[2] : "";
            }
            if (attributeValue == "titletextfontsize") {
                xmlData.setAttribute("titletexttextsize", "");
                xmlData.setAttribute("titletextfontsize", objDetails.value);
            } else if (attributeValue == "projectiontextfontsize") {
                xmlData.setAttribute("projectiontexttextsize", "");
                xmlData.setAttribute("projectiontextfontsize", objDetails.value);
            } else {
                if (index != "" && xmlData.children[index]) {
                    xmlData.children[index].setAttribute(attributeValue, objDetails.value);
                }
            }
        }
    } else if (attributeValue.includes("seriesitemlabel")) {
        let index = objDetails.targetid && objDetails.targetid.split("-").length > 1 ? objDetails.targetid.split("-")[1] : "";
        let oldPropertyValue = xmlData.getAttribute(attributeValue);
        let arrPropertyValue = oldPropertyValue ? oldPropertyValue.split("^") : [];
        let seriesItemlength = xmlData.children[0].getAttribute("value").split(",").length > 1 ? xmlData.children[0].getAttribute("value").split(",").length : 2;
        for (let i1 = 0; i1 < seriesItemlength; i1++) {
            if (!arrPropertyValue[i1] && index != i1) {
                arrPropertyValue[i1] = "false";
            }
        }
        arrPropertyValue[index] = objDetails?.value?.toString();
        xmlData.setAttribute(attributeValue, arrPropertyValue.join("^"));
    } else if (attributeValue) {
        if ((objDetails.property == "fontbold" || objDetails.property == "fontitalic") && !objDetails.value) {
            xmlData.removeAttribute(attributeValue);
        } else {
            xmlData.setAttribute(attributeValue, objDetails.value);
        }
    }
    if (mainXmlProperty.includes(attributeValue)) {
        if (!objDetails.value) {
            xmlData.removeAttribute(attributeValue);
        } else {
            xmlData.setAttribute(attributeValue, objDetails.value);
        }
    }
};

ChartFloaterOperationHelper.prototype.axisBaselineoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, "true");
    xmlData.setAttribute("chartAxisType", objDetails.dpaxisbaseline.chartAxisType);
    let maxValue = objDetails.dpaxisbaseline.bounds.isnegative ? this.minValueOperation(xmlData) : this.maxValueOperation(xmlData);
    if (objDetails.dpaxisbaseline.chartAxisType == "vertical") {
        if (objDetails.dpaxisbaseline.leftPos) {
            let axisLeftPos = xmlData.getAttribute("baseline_left_value");
            let targetH = Number(objDetails.dpaxisbaseline.bounds.height);
            let targetBtm = Number(objDetails.dpaxisbaseline.bounds.bottom);
            let checkPoint = targetBtm - Number(objDetails.dpaxisbaseline.leftPos.y);
            let percentageDiff = (checkPoint / targetH) * 100;
            let maxPercentage = maxValue / 100;
            let targetY = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            axisLeftPos = axisLeftPos ? xmlData.getAttribute("baseline_left_value") + "," + targetY : targetY;
            xmlData.setAttribute("baseline_left_value", axisLeftPos);
            let axisLeftText = xmlData.getAttribute("baseline_left_text") ? xmlData.getAttribute("baseline_left_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_left_text", axisLeftText);
        } else if (objDetails.dpaxisbaseline.bottomPos) {
            let axisBottomPos = xmlData.getAttribute("baseline_bottom_value");
            let targetW = Number(objDetails.dpaxisbaseline.bounds.width);
            let checkPoint = Number(objDetails.dpaxisbaseline.bottomPos.x) - Number(objDetails.dpaxisbaseline.bounds.x);
            let offsetX = (checkPoint / targetW) * 100;
            let maxPercentage = parseInt(maxValue) / 100;
            offsetX = maxPercentage * offsetX;
            axisBottomPos = axisBottomPos ? xmlData.getAttribute("baseline_bottom_value") + "," + offsetX : offsetX;
            xmlData.setAttribute("baseline_bottom_value", axisBottomPos);
            let axisBottomText = xmlData.getAttribute("baseline_bottom_text") ? xmlData.getAttribute("baseline_bottom_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_bottom_text", axisBottomText);
        }
    } else if (objDetails.dpaxisbaseline.chartAxisType == "horizontal") {
        if (objDetails.dpaxisbaseline.bottomPos) {
            let targetW = Number(objDetails.dpaxisbaseline.bounds.width);
            let checkPoint = Number(objDetails.dpaxisbaseline.bottomPos.x) - Number(objDetails.dpaxisbaseline.bounds.x);
            let percentageDiff = (checkPoint / targetW) * 100;
            let maxPercentage = maxValue / 100;
            let targetX = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            let axisBottomPos = xmlData.getAttribute("baseline_bottom_value");
            axisBottomPos = axisBottomPos ? xmlData.getAttribute("baseline_bottom_value") + "," + targetX : targetX;
            xmlData.setAttribute("baseline_bottom_value", axisBottomPos);
            let axisBottomText = xmlData.getAttribute("baseline_bottom_text") ? xmlData.getAttribute("baseline_bottom_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_bottom_text", axisBottomText);
        } else if (objDetails.dpaxisbaseline.leftPos) {
            let axisLeftPos = xmlData.getAttribute("baseline_left_value");
            let targetH = Number(objDetails.dpaxisbaseline.bounds.height);
            let targetBtm = Number(objDetails.dpaxisbaseline.bounds.bottom);
            let checkPoint = targetBtm - Number(objDetails.dpaxisbaseline.leftPos.y);
            let percentageDiff = (checkPoint / targetH) * 100;
            let maxPercentage = maxValue / 100;
            let targetY = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            axisLeftPos = axisLeftPos ? xmlData.getAttribute("baseline_left_value") + "," + targetY : targetY;
            xmlData.setAttribute("baseline_left_value", axisLeftPos);
            let axisLeftText = xmlData.getAttribute("baseline_left_text") ? xmlData.getAttribute("baseline_left_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_left_text", axisLeftText);
        }
    }
};

ChartFloaterOperationHelper.prototype.maxValueOperation = function (xmlData) {
    let maxValue;
    let xmlChildData = xmlData.children;
    let boolGrid = xmlData.getAttribute("showyaxisgrid") == "true" ? true : false;
    let arrValue = [];
    for (let i1 = 0; i1 < xmlChildData.length; i1++) {
        arrValue[i1] = xmlChildData[i1].getAttribute("value").split(",");
    }
    let customMaxValue = xmlData.getAttribute("yaxismaxvalue") ? xmlData.getAttribute("yaxismaxvalue") : "";
    let valuesRange = this.chartHelper.getValuesRange(arrValue, boolGrid);
    return valuesRange.rangeTotal;
};

ChartFloaterOperationHelper.prototype.minValueOperation = function (xmlData) {
    let minValue;
    let xmlChildData = xmlData.children;
    let boolGrid = xmlData.getAttribute("showyaxisgrid") == "true" ? true : false;
    let arrValue = [];
    for (let i1 = 0; i1 < xmlChildData.length; i1++) {
        arrValue[i1] = xmlChildData[i1].getAttribute("value").split(",");
    }
    let customMinValue = xmlData.getAttribute("yaxisminvalue") ? xmlData.getAttribute("yaxisminvalue") : "";
    let valuesRange = this.chartHelper.getValuesRange(arrValue, boolGrid);
    return valuesRange.rangeMin;
};

ChartFloaterOperationHelper.prototype.assetExtraText = function (xmlData, tempobjDetails) {
    let objDetails = JSON.parse(JSON.stringify(tempobjDetails));
    let index = objDetails.targetid.split("-")[1].split("-")[0];
    if (index == "placeholder" && objDetails.targetid.split("-").length > 2) {
        index = objDetails.targetid.split("-")[2];
    }
    if (index.includes("_")) {
        index = index.split("_")[0];
    }
    objDetails["index"] = index;
    objDetails["xmlData"] = xmlData;
    objDetails["placeholdertype"] = xmlData.children[index]?.getAttribute("placeholdertype")?.toLowerCase();
    objDetails["placeholderid"] = objDetails.targetid;
    if (objDetails.targetid.includes("commonPlaceholder")) {
        xmlData.setAttribute("commonassettext", objDetails.value);
        objDetails["placeholdertype"] = xmlData.getAttribute("commonplaceholdertype")?.toLowerCase();
    }
    if (!objDetails["placeholdertype"] && objDetails.targetid.includes("primaryplaceholdergraphic")) {
        objDetails["placeholdertype"] = "logo";
    }
    let xmlChildElement = xmlData.children[index];
    let copyObject = JSON.parse(JSON.stringify(objDetails));
    xmlData.children[index].setAttribute("assettext", objDetails.value);
    copyObject["text"] = [copyObject.value];
    copyObject["type"] = objDetails["placeholdertype"]?.toLowerCase();
    let iconStyle = getMoodData().iconstyle || "illustrative";
    if (objDetails["placeholdertype"]?.toLowerCase() == "image") copyObject["imgtype"] = "nodes";
    if (objDetails["placeholdertype"]?.toLowerCase() == "icon" && iconStyle) copyObject["style"] = iconStyle;
    // AISearchUtils.searchIcon(IndexStore.getInstance().serverURL, copyObject, this.updateAssetTextOperation, objDetails);
};

ChartFloaterOperationHelper.prototype.removeBaseLine = function (xmlData, objDetails) {
    if (objDetails.targetid && objDetails.targetid != "") {
        if (objDetails.targetid.includes("hightlight")) {
            xmlData.removeAttribute("data-highlightdifference");
        } else {
            let arrId = objDetails.targetid.split("-");
            let groupName = arrId[0];
            let groupNameItem = groupName.split("_");
            let index = parseInt(groupNameItem[2]);
            let attrText = groupNameItem[0] + "_" + groupNameItem[1] + "_text";
            let attrValue = groupNameItem[0] + "_" + groupNameItem[1] + "_value";
            let strText = xmlData.getAttribute(attrText);
            let strValue = xmlData.getAttribute(attrValue);
            if (!strValue) {
                strValue = xmlData.getAttribute("baseline_bottom_value");
            }
            let arrText = strText ? strText.split(",") : [];
            let arrValue = strValue ? strValue.split(",") : [];
            arrText.splice(index, 1);
            arrValue.splice(index, 1);
            let length = arrText.length;
            strText = "";
            strValue = "";
            for (let i1 = 0; i1 < length; i1++) {
                strText += i1 == 0 ? arrText[i1] : "," + arrText[i1];
                strValue += i1 == 0 ? arrValue[i1] : "," + arrValue[i1];
            }

            xmlData.removeAttribute("axisbaseline");
            xmlData.removeAttribute("data-baseline");
        }
    }
};

ChartFloaterOperationHelper.prototype.getHighlightProperty = function (xmlData, objDetails) {
    if (objDetails.property == "nodecount") {
        let numNumberOfChildren = objDetails.value;
        console.log(numNumberOfChildren);
    } else {
        let index = objDetails.targetid.split("-")[0] == "value" || "graphic" ? objDetails.targetid.split("-")[1].split("_")[0] : objDetails.targetid.split("-")[1];
        if ((objDetails.targetid.split("-")[0] == "primary" && objDetails.targetid.split("-").length > 2) || objDetails.targetid.split("-")[0] == "secondary") {
            index = objDetails.targetid.split("-")[2];
        }
        if (objDetails?.highlighttext) {
            xmlData.children[index].setAttribute("caption", objDetails.highlighttext);
            xmlData.children[index].setAttribute("highlightstyle", "text");
        }
        if (objDetails.property == "highlightemphasize") {
            xmlData.children[index].setAttribute("emphasis", objDetails.value);
            let boolEmphasize = false;
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let emphasis = xmlData.children[i1].getAttribute("emphasis") == "true" ? true : false;
                if (emphasis) {
                    boolEmphasize = emphasis;
                }
            }
            xmlData.setAttribute("emphasis", boolEmphasize);
        } else if (objDetails.property == "enablehighlight") {
            xmlData.children[index].setAttribute("highlight", objDetails.value);
        } else if (objDetails.property == "projection") {
            let boolProjection = false;
            for (let i1 = 0; i1 <= index; i1++) {
                let projection = xmlData.children[i1].getAttribute("projection") == "true" ? true : false;
                if (projection) {
                    xmlData.children[i1].removeAttribute("projection");
                }
            }
            xmlData.children[index].setAttribute("projection", objDetails.value);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let projection = xmlData.children[i1].getAttribute("projection");
                if (projection) {
                    boolProjection = projection;
                }
            }
            if (boolProjection == "true") {
                xmlData.setAttribute("projectionindex", index);
                xmlData.setAttribute("projection", boolProjection);
            } else {
                xmlData.removeAttribute("projectionindex");
                xmlData.removeAttribute("projection");
            }
        } else if (objDetails.property == "sortorder") {
            for (let i2 = 0; i2 < xmlData.children.length; i2++) {
                let sortorder = xmlData.children[i2].getAttribute("sortorder");
                if (sortorder) {
                    xmlData.children[i2].removeAttribute("sortorder");
                }
            }
            xmlData.children[index].setAttribute(objDetails.property, objDetails.value);
        } else if (objDetails.property == "graphicimage") {
            xmlData.children[index].setAttribute("graphicimage", objDetails.value);
            let boolGraphicImage = false;
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let graphicimage = xmlData.children[i1].getAttribute("graphicimage") == "true" ? true : false;
                if (graphicimage) {
                    boolGraphicImage = graphicimage;
                }
            }
            xmlData.setAttribute("graphicimage", boolGraphicImage);
            if (objDetails.value) {
                xmlData.setAttribute("usergraphicimage", boolGraphicImage);
            } else {
                xmlData.removeAttribute("usergraphicimage");
            }
        } else {
            xmlData.children[index].setAttribute("highlight", true);
            let highlightIcon = xmlData.children[index].getAttribute("highlighticonpath");
            if (highlightIcon) {
                xmlData.children[index].setAttribute("highlighticonpath", highlightIcon);
                xmlData.children[index].setAttribute("highlightstyle", "texticon");
            } else xmlData.children[index].setAttribute("highlightstyle", "text");
            if (objDetails.property == "highlightdescription") {
                xmlData.children[index].setAttribute("caption", objDetails.value);
            }
        }
    }
};

ChartFloaterOperationHelper.prototype.getChartURLData = function (objDetails, xmlData, divParent) {
    let hasDeleteType = objDetails?.deleteType;
    let index = objDetails.targetid.split("-")[0] == "valuetext" || objDetails.targetid.split("-")[0] == "pvalue" || objDetails.targetid.split("-")[0] == "graphic" ? objDetails.targetid.split("-")[1].split("_")[0] : objDetails.targetid.split("-")[1];
    if (objDetails.targetid.split("-")[0] == "secondary" || objDetails.targetid.split("-")[0] == "primary") {
        index = objDetails.targetid.split("-")[2];
    }
    let arrGraphics = [".series", ".legenditemgroup"];
    let metadata = divParent;
    let linkId = "";
    this.strHyperlinkUrl = "";
    if (objDetails.url) {
        this.strHyperlinkUrl = objDetails.url;
        linkId = "URL";
        if (!/^(f|ht)tps?:\/\//i.test(this.strHyperlinkUrl)) {
            this.strHyperlinkUrl = "https://" + this.strHyperlinkUrl;
        }
    } else if (objDetails.linkSlide) {
        this.strHyperlinkUrl = objDetails.linkSlide;
        linkId = "SLIDE";
    }
    if (!hasDeleteType) {
        xmlData.children[parseInt(index)].setAttribute("data-navigate-to-slide-on-click", this.strHyperlinkUrl);
        xmlData.children[parseInt(index)].setAttribute("link", linkId);
    } else if (xmlData.children[parseInt(index)]) {
        xmlData.children[parseInt(index)].removeAttribute("data-navigate-to-slide-on-click");
        xmlData.children[parseInt(index)].removeAttribute("link");
    }

    for (let i1 = 0; i1 < arrGraphics.length; i1++) {
        let element = metadata.querySelectorAll(arrGraphics[i1]);
        if (hasDeleteType && element[parseInt(index)]) {
            element[parseInt(index)].removeAttribute("data-navigate-to-slide-on-click");
            element[parseInt(index)].removeAttribute("link");
        } else {
            element[parseInt(index)].setAttribute("data-navigate-to-slide-on-click", this.strHyperlinkUrl);
            element[parseInt(index)].setAttribute("link", linkId);
        }
    }
    return {
        xmlData,
    };
};

ChartFloaterOperationHelper.prototype.customDoughnutoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, objDetails.value);
    let objChartNames = {
        pieSimpleStandard: "pieDoughnutStandard",
        pieDoughnutStandard: "pieSimpleStandard",
        halfPieChart: "pieSemiDoughnutStandard",
        pieSemiDoughnutStandard: "halfPieChart",
    };
    let strChartName = xmlData.getAttribute("name");
    xmlData.setAttribute("name", objChartNames[strChartName]);
};

ChartFloaterOperationHelper.prototype.customSemiChartoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, objDetails.value);
    let objChartNames = {
        pieSimpleStandard: "halfPieChart",
        pieDoughnutStandard: "pieSemiDoughnutStandard",
        halfPieChart: "pieSimpleStandard",
        pieSemiDoughnutStandard: "pieDoughnutStandard",
    };
    let strChartName = xmlData.getAttribute("name");
    xmlData.setAttribute("name", objChartNames[strChartName]);
};

ChartFloaterOperationHelper.prototype.resetAllTextProps = function (xmlData, objDetails) {
    let attributeValue = null;
    if (objDetails["elementvalue"]) {
        attributeValue = objDetails["elementvalue"].replace("dynamicalign", "");
    }
    let secondaryAttributeValue = "";
    if (attributeValue.includes("labeltext")) {
        secondaryAttributeValue = "label";
    }
    if (attributeValue.includes("titletext")) {
        secondaryAttributeValue = "chartTitletext";
    }
    let arrayResetValues = ["letterspace", "align", "lineheight", , "textsize", "fontsize", "texttransform", "textopacity"];
    let arrayChildValues = ["textsize", "fontsize", "texttransform", "textopacity", "letterspace", "lineheight"];
    arrayResetValues.forEach(function (element) {
        if (xmlData.getAttribute(attributeValue + element)) {
            xmlData.removeAttribute(attributeValue + element);
        }
        if (xmlData.getAttribute(secondaryAttributeValue + element)) {
            xmlData.removeAttribute(secondaryAttributeValue + element);
        }
    });
    for (let i1 = 0; i1 < xmlData.children.length; i1++) {
        arrayChildValues.forEach(function (element) {
            if (xmlData.children[i1].getAttribute(attributeValue + element)) {
                xmlData.children[i1].removeAttribute(attributeValue + element);
            }
            if (xmlData.children[i1].getAttribute(secondaryAttributeValue + element)) {
                xmlData.children[i1].removeAttribute(secondaryAttributeValue + element);
            }
        });
    }
};

ChartFloaterOperationHelper.prototype.updateHighlightDifferencePoint = function (xmlData, objDetails) {
    let indexValue = objDetails.value;
    let attrName = "highlightdifferencepoint" + indexValue;
    if (xmlData.getAttribute(attrName)) {
        xmlData.removeAttribute(attrName);
    }
    let highlightDifferenceCount = xmlData.getAttribute("highlightdifferencecount") || 1;
    if (xmlData.getAttribute("highlightdifferencecount")) {
        xmlData.setAttribute("highlightdifferencecount", parseInt(highlightDifferenceCount) - 1);
    }
    for (let i1 = indexValue; i1 < parseInt(highlightDifferenceCount) + 1; i1++) {
        let childAttrName = "highlightdifferencepoint" + parseInt(parseInt(i1) + 1);
        let newAttrName = "highlightdifferencepoint" + parseInt(i1);
        let childAttrValue = xmlData.getAttribute(childAttrName);
        xmlData.removeAttribute(childAttrName);
        xmlData.setAttribute(newAttrName, childAttrValue);
    }
};

ChartFloaterOperationHelper.prototype.updateChartGroupNodes = function (xmlData, objDetails, divParent) {
    // Get chartId from divParent
    let chartId = null;
    if (divParent) {
        chartId = this.chartUtils.getOrCreateChartId(divParent);
    }

    if (chartId && xmlData) {
        this.chartUtils.updateChartGroupNodes(xmlData, objDetails, chartId);
    }
};

ChartFloaterOperationHelper.prototype.updateChartUngroupNodes = function (xmlData, objDetails, divParent) {
    // Get chartId from divParent
    let chartId = null;
    if (divParent) {
        chartId = this.chartUtils.getOrCreateChartId(divParent);
    }

    if (chartId && xmlData) {
        this.chartUtils.updateChartUngroupNodes(xmlData, objDetails, chartId);
    }
};

ChartFloaterOperationHelper.prototype.resetChartGroupNodes = function (divParent) {
    // Get chartId from divParent
    let chartId = null;
    if (divParent) {
        chartId = this.chartUtils.getOrCreateChartId(divParent);
    }

    if (chartId) {
        this.chartUtils.resetChartGroupNodes(chartId, divParent);
    }
};

ChartFloaterOperationHelper.prototype.updateChartMultiSeriesItemHighlight = function (xmlData, objDetails) {
    const seriesItemIndex = objDetails?.data?.targetnodeid?.split("_")?.[1]?.toString() || objDetails?.targetid?.split("_")?.[1]?.toString();
    let highlightAttr = xmlData.getAttribute("seriesitemhighlightindex");
    let arr = highlightAttr ? highlightAttr.split(",") : [];

    const index = arr.indexOf(seriesItemIndex);
    if (index !== -1) {
        arr.splice(index, 1); // remove if present
    } else {
        arr.push(seriesItemIndex); // add if not present
    }

    if (arr.length > 0) {
        xmlData.setAttribute("seriesitemhighlightindex", arr.join(","));
    } else {
        xmlData.removeAttribute("seriesitemhighlightindex");
    }
};

ChartFloaterOperationHelper.prototype.createSuffixValue = function (xmlData, value) {
    let length = xmlData.children[0].getAttribute("value").split(",").length;
    let suffixValue = "";
    for (let i1 = 0; i1 < length; i1++) {
        suffixValue += value + ",";
    }
    return suffixValue;
};

// Export the constructor function
window["ChartFloaterOperationHelper"] = ChartFloaterOperationHelper;

function CssHandleFloaterOperations() {
    // Constructor - initialize any instance properties if needed
    this.FloaterPropertyObjects = new window["FloaterPropertyObjects"]()?.getFloaterProperty();
    this.ChartFloaterOperationHelper = new window["ChartFloaterOperationHelper"]();
    this.ChartUtils = new window["ChartUtils"]();
}

CssHandleFloaterOperations.prototype.FloaterOperationsListener = function (elTemptarget, event = null) {
    let ChartUtils = new window["ChartUtils"]();
    let appStore = ChartUtils.getAppStore();
    // unsubscribe  existing thissubscription

    let unsubscribe = appStore.subscribe(
        (state) => {
            return state.updateFloaterProperties;
        },
        (updateFloaterProperties) => {
            this.handleFloaterOperations(updateFloaterProperties);
        }
    );

    // Add subscription to centralized manager
    if (window.addSubscription) {
        window.addSubscription(unsubscribe);
    }
};
CssHandleFloaterOperations.prototype.handleFloaterOperations = function (updateFloaterProperties) {
    let slideId = updateFloaterProperties.slideId;
    let xmlData = updateFloaterProperties.chartData;
    let menuData = updateFloaterProperties.menu;
    let divParent = updateFloaterProperties.graphicDiv;
    let callback = updateFloaterProperties.callback;
    let objDetails = updateFloaterProperties.objDetails;
    let callbackparams = updateFloaterProperties.callbackparams;
    if (objDetails?.property == "changechartlist") {
        this.createNewChart(slideId, objDetails, menuData, divParent, callback, callbackparams);
    } else {
        this.ChartFloaterOperationHelper.getChartSupportData(objDetails, xmlData, callback, callbackparams, divParent);
        this.ChartUtils.chartRecreate(slideId, xmlData, menuData, divParent, callback);
    }
};

CssHandleFloaterOperations.prototype.createNewChart = function (slideId, objDetails, menuData, divParent, callback = null, callbackparams = null) {
    let builderChart = new ChartBuilder();
    // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
    let chartId = divParent?.getAttribute("data-chart-id");
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    let slideData = graphicIndex ? getOutlineData(graphicIndex) : getOutlineData();
    let finalMenuData = menuData || (graphicIndex ? getMenuData(graphicIndex) : getMenuData());
    let finalGraphicDiv = divParent || getGraphicDiv();
    let commonData = getCommonData() || {};
    let objOutlineData = {
        data: slideData?.elementcontent,
        outlinetype: "chart",
        type: "chart",
    };
    builderChart.createChart(slideId, objOutlineData, finalMenuData, finalGraphicDiv, callback, commonData);
};

