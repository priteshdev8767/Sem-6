ChartUtils.prototype.getFontDetails = function (data, legend = false) {
    return { maxSize: "null", minSize: 8 };
};
ChartUtils.prototype.createSpanFormat = function (element, data, sumData = false) {
    let prefixStyle = data.prefixStyle;
    let suffixStyle = data.suffixStyle;
    let arrKeyValue = { input: element.textContent };
    if (element.querySelector("#spanMainText")) {
        if (!element.innerText) {
            let strKeyValue = "";
            for (let i1 = 0; i1 < element.children.length; i1++) {
                strKeyValue += element.children[i1].innerHTML;
            }
            arrKeyValue = { input: strKeyValue };
        } else {
            arrKeyValue = { input: element.innerText };
        }
    }
    let objFormatted = this.formatChartValues(arrKeyValue);
    // if (!objFormatted.validData) {
    //     data.invaidData = true;
    // }
    let prefix = document.createElement("span");
    prefix.className = prefixStyle;
    prefix.textContent = !!objFormatted.currencysymbol && data.displayValueFormat != "asentered" ? objFormatted.prefix + objFormatted.currencysymbol : objFormatted.prefix == undefined ? "" : objFormatted.prefix;
    let suffix = document.createElement("span");
    suffix.className = suffixStyle;
    suffix.textContent = !!objFormatted.currencySystem && data.displayValueFormat != "asentered" ? objFormatted.suffix + objFormatted.currencySystem : objFormatted.suffix == undefined ? "" : objFormatted.suffix;

    let valueSpan = document.createElement("span");
    valueSpan.className = "clSpanMainText";
    valueSpan.id = "spanMainText";
    valueSpan.textContent = data.displayValueFormat == "asentered" ? objFormatted.input : objFormatted.value == undefined ? "" : objFormatted.value;
    if (!!objFormatted.currencyValueNormalized && objFormatted.valueSystem && sumData) {
        if (objFormatted.currencyValueNormalized < 0) {
            valueSpan.textContent = -parseInt(objFormatted.valueSystem);
        } else {
            valueSpan.textContent = parseInt(objFormatted.valueSystem);
        }
    }
    if (!element.textContent.includes(valueSpan.textContent + suffix.textContent) && (data.displayValueFormat == "asentered" || (data.displayValueFormat == "currency" && (data._oldDisplayFormat == "asentered" || !data._oldDisplayFormat)))) {
        valueSpan.textContent = objFormatted.valueSystem < 0 && data.displayValueFormat == "asentered" ? objFormatted.input : parseInt(objFormatted.value);
        suffix.textContent = !!objFormatted.suffix ? objFormatted.suffix : "";
        if (data.displayValueFormat != "asentered") DiagramNodeUtils.checkNumberFormat(element, element.parentNode, data.moodData);
        if (element?.querySelector("#spanMainText")?.textContent?.includes(",")) {
            element.querySelector("#spanMainText").dataset.hasnumberformat = true;
        }
    } else {
        element.innerHTML = prefix.outerHTML + valueSpan.outerHTML + suffix.outerHTML;
        element.dataset.oldinnertext = prefix.outerHTML + valueSpan.outerHTML + suffix.outerHTML;
    }
    element.setAttribute("data-innertext", element.textContent);
};
ChartUtils.prototype.formatChartValues = function (element) {
    // return element;
    var gDataFormatter = eval("new " + "DataFormatUtil" + "()");
    gDataFormatter.formatCurrency(element);
    if (!element.validData) {
        delete element.validData;
        element.invalidData = true;
        gDataFormatter.formatCurrency(element);
    }
    return element;
};
ChartUtils.prototype.getSeqNumber = function (moodData, index) {
    let sequenceNumber = moodData && moodData.seqnumproperties ? moodData.seqnumproperties : null;
    if (sequenceNumber) {
        return this.getSeqMoodStyle(sequenceNumber, index);
    } else {
        return index;
    }
};
ChartUtils.prototype.getSeqMoodStyle = function (moodData, index) {
    try {
        let strContent = index;
        // let restrictSequence = properties.ismoodsequence != null && properties.ismoodsequence == false;
        // if (restrictSequence) return strContent;
        if (moodData.sequenceprefix || moodData.sequencesuffix) {
            let prefix = this.setSeqStyle(moodData.sequenceprefix.style, index, true);
            let suffix = this.setSeqStyle(moodData.sequencesuffix.style, index, true);
            let mainStyle = moodData.sequencemain && moodData.sequencemain.style;
            let mainContent = mainStyle && (mainStyle == "abc" || mainStyle == "ABC") ? this.getABCStyle(index - 1, mainStyle == "ABC") : index;
            strContent = prefix + mainContent + suffix;
        }
        return strContent;
    } catch (error) {
        return index;
    }
};
ChartUtils.prototype.setSeqStyle = function (style, index, filterStyle = false) {
    let strContent = "";
    if (style == "0" && index < 10) strContent = style + (filterStyle ? "" : index);
    else if (style == "abc" || style == "ABC") strContent = this.getABCStyle(index - 1, style == "ABC");
    else if (style != "0") strContent = style + (filterStyle ? "" : index);
    return strContent;
};
ChartUtils.prototype.getABCStyle = function (index, isUpperCase) {
    let strAlphabet = "abcdefghijklmnopqrstuvwxyz";
    let arrAbc = isUpperCase ? strAlphabet.toUpperCase().split("") : strAlphabet.split("");
    return arrAbc[index];
};
ChartUtils.prototype.checkPecentageChart = function (data) {
    let suffixDatas = data.suffix;
    for (let i1 = 0; i1 < suffixDatas.length; i1++) {
        if ((suffixDatas[i1] == "%" || (suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "%")) && data._currencySymbol[i1][0] == "") {
            if (i1 == suffixDatas.length - 1) return true;
        } else {
            return false;
        }
    }
};
ChartUtils.prototype.formatNumber = function (value) {
    if (value >= 1_000_000_000_000) {
        return (value / 1_000_000_000_000).toFixed(1).replace(".0", "") + "T";
    } else if (value >= 1_000_000_000) {
        return (value / 1_000_000_000).toFixed(1).replace(".0", "") + "B";
    } else if (value >= 1_000_000) {
        return (value / 1_000_000).toFixed(1).replace(".0", "") + "M";
    } else if (value >= 1_000) {
        return (value / 1_000).toFixed(1).replace(".0", "") + "K";
    } else {
        return value.toString(); // Keep smaller numbers as they are
    }
};
ChartUtils.prototype.setExtraValueBounds = function (data, width, height) {
    let extraElementBounds = JSON.parse(JSON.stringify(data.extraElementBounds));
    extraElementBounds.width += width;
    extraElementBounds.height += height;
    data.extraElementBounds = extraElementBounds;
};
ChartUtils.prototype.updateValueTextProperties = function (element, data) {
    let valueText = element;
    if (data._customValueFontBold) {
        valueText.style.fontWeight = "bold";
    }
    if (data._customValueFontItalic) {
        valueText.style.fontStyle = "italic";
    }
    if (data._customValueOpacity) {
        valueText.style.opacity = data._customValueOpacity;
        valueText.dataset.customopacity = data._customValueOpacity;
    }
    if (data._customValueTextLineHeight) {
        valueText.style.lineHeight = data._customValueTextLineHeight;
        valueText.dataset.customvaluetextlineheight = data._customValueTextLineHeight;
    }
    if (data._customValueTextLetterSpacing) {
        valueText.style.setProperty("letter-spacing", data._customValueTextLetterSpacing + "em", "important");
        valueText.dataset.customvaluetextletterspacing = data._customValueTextLetterSpacing;
    }
};
ChartUtils.prototype.createDefaultElementContentProperty = function () {
    let objContentProps = new Object();
    objContentProps.tableprops = {
        maxrows: 6,
        maxcolumns: 1,
        minrows: -1,
        mincolumns: -1,
    };
    objContentProps.properties = {};
    objContentProps.matrix = null;
    return objContentProps;
};
ChartUtils.prototype.generateAllProperties = function (nodeSlideElement, objProperties, menuDetails) {
    if (nodeSlideElement) {
        if (nodeSlideElement.getAttribute("class") && nodeSlideElement.getAttribute("class").includes("clsElementBG")) {
            nodeSlideElement = nodeSlideElement.parentNode ? nodeSlideElement.parentNode.querySelector("#ELEMENT_DIV") : "";
        }
        let xmlChart = nodeSlideElement.querySelector("desc") && nodeSlideElement.querySelector("desc").children.length > 0 ? nodeSlideElement.querySelector("desc").children[0] : null;
        let metadata = nodeSlideElement.getElementsByClassName("metadata_group_chart") ? nodeSlideElement.getElementsByClassName("metadata_group_chart")[0] : null;
        if (!metadata) {
            metadata = document.createElement("metadata");
            metadata.className = "metadata_group_chart";
            metadata.setAttribute("maxseries", "32");
            metadata.setAttribute("minseries", "2");
            metadata.setAttribute("maxseriesitem", "9");
            metadata.setAttribute("minseriesitem", "1");
        }
        let isItemBasedChart = nodeSlideElement.querySelector(".itembasedlabelelement") ? true : false;
        let elementContentKey = "elementcontent";
        let graphicDiv = nodeSlideElement?.parentNode;
        if (xmlChart) {
            objProperties.haseditgraphic = true;
            objProperties.haseditcontentmode = true;
            // For MultiGraphics
            let slideContent = "";
            const strChartName = xmlChart.getAttribute("name");
            const strClassName = xmlChart.getAttribute("data-classname");
            const uniqueLayout = xmlChart.getAttribute("uniqueLayout");
            const uniqueLayoutName = xmlChart.getAttribute("uniqueLayoutName");
            // const chartList = ChartHelper.getChartListDataByName(strChartName);
            const jsonChartItemMetaData = this.getChartItemMetaData("name", strClassName)[0]; //chartList.name
            const strVideoName = xmlChart.getAttribute("video");
            const hasTableOption = xmlChart.getAttribute("changetablecontent") == "true";
            const strLayoutName = xmlChart.getAttribute("layout");
            const primaryplaceholder = xmlChart.getAttribute("primaryplaceholder") ? xmlChart.getAttribute("primaryplaceholder") : xmlChart.getAttribute("data-primaryplaceholder");
            const boolitemplaceholder = xmlChart.getAttribute("itemplaceholder");

            const secondaryPlaceholder = xmlChart.getAttribute("secondaryplaceholder");
            const strPrimaryChartName = xmlChart.getAttribute("primarychart");
            const svgDiv = nodeSlideElement.querySelector("div[id='SVG_DIV']");
            const svgNode = svgDiv ? svgDiv.querySelector("svg") : null;
            const defaultnode = svgNode ? svgNode.getAttribute("data-defaultnode") : undefined;
            const strSecondaryChartName = xmlChart.getAttribute("secondarychart");
            const jsonGraphicTemplateDetails = nodeSlideElement.getAttribute("data-json-graphic-template-details");

            if (uniqueLayout) objProperties.uniqueLayouts = [uniqueLayoutName];
            objProperties.jsonGraphicTemplateDetails = jsonGraphicTemplateDetails;
            objProperties.dpdesign = this.getChartDesignProperties(xmlChart, metadata); //not Valid
            objProperties.dpcontent = this.getChartContentProperties(xmlChart, nodeSlideElement, slideContent, menuDetails);
            objProperties.dpcontent.nodecount = this.getChartNodeCount(defaultnode, metadata, strChartName, xmlChart);
            let slideCount = xmlChart.getAttribute("multislidecount") || null;
            if (slideCount && slideCount > -1 && slideContent) {
                slideContent.dataset.pagecount = slideCount;
            }
            if (xmlChart.getAttribute("multislide") == "true") {
                objProperties.dpcontent["imagecount"] = {
                    slidecount: xmlChart.getAttribute("multislidecount"),
                    currentindex: xmlChart.getAttribute("imagestackselectedindex") ? xmlChart.getAttribute("imagestackselectedindex") : 0,
                };
            }
            objProperties.dpcontent["hastable"] = hasTableOption;
            objProperties.customize = metadata.getAttribute("customise") == "true" ? true : false;
            objProperties.dpassetname = {
                chartname: strChartName,
                layoutname: strLayoutName,
                primaryName: strPrimaryChartName,
                secondaryName: strSecondaryChartName,
            };
            let grahicDivIndex = nodeSlideElement?.parentElement?.dataset?.graphicIndex;
            if (grahicDivIndex && slideContent) {
                slideContent.dataset.graphicIndex = grahicDivIndex;
                elementContentKey = "elementcontent" + (grahicDivIndex != "" && grahicDivIndex != "0" ? parseInt(grahicDivIndex) : "");
            }
            objProperties[elementContentKey] = this.createDefaultElementContentProperty();
            let arrAnimation = [
                {
                    data: "animationoff",
                },
                {
                    data: "animateoneatatime",
                },
                {
                    data: "animateallatonce",
                },
            ];
            // if (!boolMultiGraphicsSupport) {
            //     objProperties.graphicanimation = {
            //         visible: true,
            //         selectedindex: xmlChart.getAttribute("animation") == "" || xmlChart.getAttribute("animation") == null ? 2 : CssChartUtils.getSelectedIndex(arrAnimation, xmlChart.getAttribute("animation")),
            //     };
            // }
            let objContent = objProperties[elementContentKey];
            objContent.jsonGraphicTemplateDetails = jsonGraphicTemplateDetails;
            objContent.matrix = this.createDefaultOutlineTable();
            let dpZenTableSource = objContent.matrix;
            let dpZenTableProps = objContent.tableprops;
            objContent.properties = this.createChartJSONData(xmlChart);
            objContent.secondaryText = [];
            // For MultiGraphics
            objContent.elementtype = "chart";
            objContent.promptText = [];
            objContent.labellineheight = [];
            objContent.labelletterspace = [];
            objContent.needassetupdate = [];
            objContent.jsonGraphicTemplateDetails = jsonGraphicTemplateDetails;
            let chartTitleTextProperties = {}; //this.checkChartTitleProperties(xmlChart);
            let chartSourceTextProperties = {}; //this.checkSourceTextProperties(xmlChart);
            let chartProjectionTextProperties = {}; //this.checkProjectionTextProperties(xmlChart);
            if (Object.keys(chartTitleTextProperties).length) {
                objContent["charttitletext"] = {};
                objContent["charttitletext"]["textproperties"] = chartTitleTextProperties;
            }
            if (Object.keys(chartSourceTextProperties).length) {
                objContent["sourcetext"] = {};
                objContent["sourcetext"]["textproperties"] = chartSourceTextProperties;
            }
            if (Object.keys(chartProjectionTextProperties).length) {
                objContent["projectiontext"] = {};
                objContent["projectiontext"]["textproperties"] = chartProjectionTextProperties;
            }
            dpZenTableProps.deleterow = Number(metadata.getAttribute("length")) <= Number(metadata.getAttribute("minseries")) ? false : true;
            dpZenTableProps.insertcolumn = true;
            dpZenTableProps.deletecolumn = Number(metadata.getAttribute("sublength")) > 1 ? true : false;
            let index = primaryplaceholder === "true" && jsonChartItemMetaData.primary === "true" ? 2 : 1;
            dpZenTableProps.mincolumns = strChartName == "comparisonModel" ? 3 : Number(metadata.getAttribute("minseriesitem")) + index;
            dpZenTableProps.minrows = Number(metadata.getAttribute("minseries"));
            dpZenTableProps.maxrows = Number(xmlChart.getAttribute("data-menumaxseries") || metadata.getAttribute("maxseries"));
            let maxColumns = Number(metadata.getAttribute("maxseriesitem"));
            let hasChartGroup = this.checkChartGroup(xmlChart);
            if (isItemBasedChart) {
                hasChartGroup = false;
            }
            if (hasChartGroup) {
                maxColumns = 1;
            }
            dpZenTableProps.maxcolumns =
                strChartName == "comparisonModel" || strChartName == "combinationModel" || (Number(metadata.getAttribute("sublength")) == 1 && primaryplaceholder === "true" && jsonChartItemMetaData.primary === "true" && Number(metadata.getAttribute("maxseriesitem")) == 1)
                    ? 3
                    : isItemBasedChart
                      ? 2
                      : maxColumns + index;
            if (strChartName == "comparisonModelType3") dpZenTableProps.maxcolumns = 4;

            let maxSerires = primaryplaceholder === "true" && jsonChartItemMetaData.primary === "true" ? dpZenTableProps.maxcolumns == 3 : dpZenTableProps.maxcolumns == 3 && maxColumns == 2;
            if (xmlChart.getAttribute("data-stackedsizevalue") == "true") {
                dpZenTableProps.maxcolumns = dpZenTableProps.maxcolumns + 1;
            }
            if (maxSerires) {
                dpZenTableProps.hideaddbutton = true;
            }
            let xAxisTitle = xmlChart.getAttribute("xaxistitle");
            let yaxisTitle = xmlChart.getAttribute("yaxistitle");
            // let xAxisObject = { value: TextHighLightUtils.highlightToString(xAxisTitle), type: "text" };
            // let yAxisObject = { value: TextHighLightUtils.highlightToString(yaxisTitle), type: "text" };
            let xAxisObject = { value: yaxisTitle, type: "text" };
            let yAxisObject = { value: xAxisTitle, type: "text" };
            let arrHeader = [xAxisObject, yAxisObject];
            dpZenTableProps.header = arrHeader;
            let arrTableHeader = JSON.parse(JSON.stringify(arrHeader));
            let multiserieslegend = xmlChart.getAttribute("multiserieslegend") ? xmlChart.getAttribute("multiserieslegend").split(",") : [];
            if (multiserieslegend.length > 0) {
                arrTableHeader = [xAxisObject];
            }
            for (let i1 = 0; i1 < multiserieslegend.length; i1++) {
                arrTableHeader.push({ value: multiserieslegend[i1], type: "text" });
            }
            dpZenTableProps.tableHeader = arrTableHeader;
            const nodeChart = xmlChart.children;
            let multiSeries = xmlChart.children[0].getAttribute("value").split(",").length > 1;
            objContent.properties.multiseries = multiSeries;
            let rowLength = Number(metadata.getAttribute("maxseries")) <= nodeChart.length ? Number(metadata.getAttribute("maxseries")) : nodeChart.length;
            let isNegative = metadata.getAttribute("negativechart");
            let columnLength;
            let arrAsenteredvalue = [];
            let arrChartGroupDetails = [];
            let arrLabelTextColor = [];
            let arrLogoContrast = [];
            let arrSecondaryTextColor = [];
            let valueTextColor = [];
            for (let r3 = 0; r3 < rowLength; r3++) {
                let index = 0;
                let blnTextId = false;
                let boolSecondary = false;
                let nodeChartItem = nodeChart[r3];
                let needassetUpdate = false;
                let assetSearchText = "";
                let attrValue = nodeChartItem.getAttribute("value");
                let attrSecondaryValue = nodeChartItem.getAttribute("secondaryvalue");
                attrSecondaryValue = !attrSecondaryValue && (strChartName == "comparisonModel" || strChartName == "combinationModel") ? nodeChartItem.getAttribute("value") : attrSecondaryValue;
                columnLength = Number(metadata.getAttribute("maxseriesitem")) == 1 ? 2 : attrValue.split(",").length + 1;
                columnLength = attrSecondaryValue ? columnLength + 1 : columnLength;
                if (columnLength > 1) {
                    objProperties.multiSeries = "true";
                } else {
                    if (objProperties.multiSeries) {
                        delete objProperties.multiSeries;
                    }
                }
                let secondaryValue = !attrSecondaryValue && (strChartName == "comparisonModel" || strChartName == "combinationModel") ? "value" : "secondaryvalue";
                dpZenTableSource[r3] = this.createDefaultOutlineRow();
                arrAsenteredvalue[r3] = [];
                let blnPrimaryplaceholder = false;
                let blnSecondaryplaceholder = false;
                let blnPlaceholderData = false;
                let blnItemPlaceholder = false;
                // let chartListData = ChartHelper.getChartListDataByName(strChartName);
                let jsonChartItemMetaData = this.getChartItemMetaData("name", strClassName)[0]; //chartListData.name
                if (primaryplaceholder === "true") {
                    let boolHover = xmlChart.getAttribute("hover") == "true" ? true : false;
                    if (jsonChartItemMetaData.primary === "true") {
                        blnPrimaryplaceholder = true;
                        blnPlaceholderData = true;
                    }
                }
                if (boolitemplaceholder === "true") {
                    blnItemPlaceholder = true;
                }
                if (secondaryPlaceholder) {
                    if (secondaryPlaceholder != "none") if (jsonChartItemMetaData.secondary === "true" || jsonChartItemMetaData.secondaryText === "true") blnSecondaryplaceholder = true;
                }

                blnPrimaryplaceholder = blnPrimaryplaceholder;
                columnLength = blnPrimaryplaceholder ? columnLength + 1 : columnLength;
                columnLength = strChartName.includes("comparisonModelType3") || strChartName.includes("SimpleStackedCompareBarChart") ? 4 : columnLength;
                // columnLength = xmlChart.getAttribute("secondarytext") == "true" ? columnLength + 1 : columnLength;
                let labelIndex = 0;
                //prefix suffix changes
                let suffix = nodeChartItem.getAttribute(this.ChartPropertiesName.suffix) ? nodeChartItem.getAttribute(this.ChartPropertiesName.suffix).split(",") : [];
                let prefix = nodeChartItem.getAttribute(this.ChartPropertiesName.prefix) ? nodeChartItem.getAttribute(this.ChartPropertiesName.prefix).split(",") : [];
                let denomination = nodeChartItem.getAttribute(this.ChartPropertiesName.denomination) ? nodeChartItem.getAttribute(this.ChartPropertiesName.denomination).split(",") : [];
                let currencySymbol = nodeChartItem.getAttribute(this.ChartPropertiesName.currencysymbol) ? nodeChartItem.getAttribute(this.ChartPropertiesName.currencysymbol).split(",") : [];
                //secondary
                let ssuffix = nodeChartItem.getAttribute(this.ChartPropertiesName.ssuffix) ? nodeChartItem.getAttribute(this.ChartPropertiesName.ssuffix).split(",") : [];
                let sprefix = nodeChartItem.getAttribute(this.ChartPropertiesName.sprefix) ? nodeChartItem.getAttribute(this.ChartPropertiesName.sprefix).split(",") : [];
                let logoContrast = nodeChartItem.getAttribute("logocontrast") || "";
                arrLogoContrast.push(logoContrast);
                let sdenomination = nodeChartItem.getAttribute(this.ChartPropertiesName.sdenomination) ? nodeChartItem.getAttribute(this.ChartPropertiesName.sdenomination).split(",") : [];
                let scurrencySymbol = nodeChartItem.getAttribute(this.ChartPropertiesName.scurrencysymbol) ? nodeChartItem.getAttribute(this.ChartPropertiesName.scurrencysymbol).split(",") : [];
                let labelTextColor = nodeChartItem.getAttribute("labeltextcolor");
                arrLabelTextColor.push(labelTextColor);
                let secondaryLabelTextColor = nodeChartItem.getAttribute("secondarylabeltextcolor");
                arrSecondaryTextColor.push(secondaryLabelTextColor);
                valueTextColor[r3] = [];
                //
                let editIndex = 0;
                let hasStatistical = false;

                let strBoolChartGroupitem = nodeChartItem.getAttribute("chartgroup") == "true" ? "true" : "false";
                let strGroupCount = nodeChartItem.getAttribute("chartgroupcount") ? nodeChartItem.getAttribute("chartgroupcount") : "";
                let objChartGroupData = {
                    chartgroup: strBoolChartGroupitem,
                    chartgroupcount: strGroupCount,
                };
                arrChartGroupDetails.push(objChartGroupData);

                for (let c3 = 0; c3 < columnLength; c3++) {
                    let id;
                    let aURL;
                    let value;
                    let textproperties = {};
                    let valueId;
                    let nodeCell;
                    let strPrefix;
                    let strSuffix;
                    let strDenomoination;
                    let strCurrencySymbol;
                    let type = "text";
                    let primaryPlaceholderType;
                    const defaultLabel = "";
                    let attributeValue = "value" + r3 + "_" + c3 + "textcolor";
                    let colorValue = nodeChartItem.getAttribute(attributeValue);
                    if (colorValue) {
                        let objValue = {};
                        objValue[attributeValue] = colorValue;
                        valueTextColor[r3].push(objValue);
                    }
                    if (blnPrimaryplaceholder) {
                        if (c3 == 0) {
                            labelIndex = 1;
                            id = "placeholder-" + r3 + "_0";
                            primaryPlaceholderType = nodeChartItem.attributes["placeholdertype"] ? nodeChartItem.attributes["placeholdertype"].value : "";
                            aURL = nodeChartItem.attributes["placeholderpath"] ? nodeChartItem.attributes["placeholderpath"].value : nodeChartItem.attributes["primaryPlaceholderPath"] ? nodeChartItem.attributes["primaryPlaceholderPath"].value : "";
                            if (primaryPlaceholderType.toLowerCase() == "icon") {
                                if (!aURL?.includes("https")) {
                                    aURL = nodeChartItem.attributes["placeholderpath"] ? nodeChartItem.attributes["placeholderpath"].value : nodeChartItem.attributes["primaryPlaceholderPath"] ? nodeChartItem.attributes["primaryPlaceholderPath"].value : "";
                                    if ((!aURL || (aURL && !aURL.includes(".svg"))) && nodeChartItem.attributes["secondaryplaceholderpath"]) {
                                        aURL = nodeChartItem.attributes["secondaryplaceholderpath"].value;
                                    }
                                    aURL = aURL ? aURL.split(".")[0] + ".svg" : "";
                                    // aURL = IndexStore.getInstance().staticServerURL + aURL;
                                }
                            } else if (primaryPlaceholderType.toLowerCase() == "image" || primaryPlaceholderType.toLowerCase() == "logo") {
                                aURL = nodeChartItem.attributes["placeholder"] ? nodeChartItem.attributes["placeholder"].value : nodeChartItem.attributes["primaryPlaceholderPath"] ? nodeChartItem.attributes["primaryPlaceholderPath"].value : "";
                                aURL = aURL;
                            }
                            if (strChartName == "ComparisonpieChart" || strChartName == "ComparisonpieChart") {
                                // aURL = nodeChartItem.attributes["itemplaceholderpath"] ? IndexStore.getInstance().staticServerURL + nodeChartItem.attributes["itemplaceholderpath"].value : aURL;
                            }
                            value = aURL;
                            blnTextId = true;
                            blnPrimaryplaceholder = false;
                            type = primaryPlaceholderType;
                        }
                    } else {
                        if (labelIndex == c3) {
                            nodeCell = nodeChartItem.attributes["name"];
                            needassetUpdate = nodeChartItem?.getAttribute("needassetupdate");
                            assetSearchText = nodeChartItem?.getAttribute("assetsearchtext");
                            if ((strChartName.includes("comparisonModelType3") || strChartName.includes("SimpleStackedCompareBarChart")) && labelIndex == 2) {
                                nodeCell = nodeChartItem.attributes["comparisonname"] ? nodeChartItem.attributes["comparisonname"] : "";
                                id = "comparelabel-" + r3;
                            } else {
                                id = "label-" + r3;
                                let secondaryTextValue = xmlChart.getAttribute("secondarytext") == "true" ? nodeChartItem.getAttribute("secondaryName") : "";
                                if (xmlChart.getAttribute("secondarytext") == "true") {
                                    objContent.secondaryText.push(secondaryTextValue);
                                }
                            }
                            textproperties = this.checklabeltextproperties(nodeChartItem);
                            value = nodeCell && nodeCell.nodeValue ? nodeCell.nodeValue : defaultLabel;
                            if (nodeChartItem.getAttribute("innerHtml")) {
                                value = nodeChartItem.getAttribute("innerHtml");
                                if (value.includes("<div>")) value = value;
                            } else {
                                value = value;
                            }
                        } else if (labelIndex < c3) {
                            labelIndex = strChartName.includes("comparisonModelType3") || strChartName.includes("SimpleStackedCompareBarChart") ? 2 : labelIndex;
                            nodeCell = boolSecondary ? nodeChartItem.attributes[secondaryValue] : nodeChartItem.attributes["value"];
                            let isMultiseries = nodeCell.nodeValue.split(",").length > 1;
                            value = nodeCell.nodeValue.split(",")[index];
                            strPrefix = boolSecondary ? (sprefix[editIndex] ? sprefix[editIndex] : "") : prefix[editIndex] ? prefix[editIndex] : "";
                            strSuffix = boolSecondary ? (ssuffix[editIndex - 1] ? ssuffix[editIndex - 1] : "") : suffix[editIndex] ? suffix[editIndex] : "";
                            strDenomoination = boolSecondary ? (sdenomination[editIndex] ? sdenomination[editIndex] : "") : denomination[editIndex] ? denomination[editIndex] : "";
                            strCurrencySymbol = boolSecondary ? (scurrencySymbol[editIndex] ? scurrencySymbol[editIndex] : "") : currencySymbol[editIndex] ? currencySymbol[editIndex] : "";
                            if (strChartName == "waterfallchart" && r3 == rowLength - 1) {
                                value = "sum";
                            } else {
                                value = isNegative == "false" ? (parseInt(value) < 0 ? parseInt(Math.abs(value)).toString() : value) : value;
                            }
                            valueId = blnTextId ? r3 + "_" + (c3 - 2) : r3 + "_" + (c3 - 1);
                            id = boolSecondary ? "secondaryvalue-" + valueId : "value-" + valueId;
                            index++;
                            if (editIndex > 0 && strChartName == "statisticalBarSimpleRectangle") {
                                hasStatistical = true;
                            } else {
                                hasStatistical = false;
                            }
                            editIndex++;
                            let promptTextValue = xmlChart.getAttribute("prompttext") == "true" ? nodeChartItem.getAttribute("prompttext") : "";
                            if (xmlChart.getAttribute("prompttext") == "true") {
                                objContent.promptText.push(promptTextValue);
                            }
                            let strAsenterdValue = nodeChartItem.getAttribute("asenteredvalue") ? nodeChartItem.getAttribute("asenteredvalue") : "";
                            arrAsenteredvalue[r3].push(strAsenterdValue);
                            let boolEnableLineHeight = xmlChart.getAttribute("enablelabellineheight");
                            if (boolEnableLineHeight == "true") {
                                objContent.labellineheight[r3] = nodeChartItem.getAttribute("labellineheight") ? nodeChartItem.getAttribute("labellineheight") : "";
                            }
                            textproperties = this.checkValuetextproperties(xmlChart, nodeChartItem);
                            let boolEnableLetterSpace = xmlChart.getAttribute("enablelabelletterspace");
                            if (boolEnableLetterSpace == "true") {
                                objContent.labelletterspace[r3] = nodeChartItem.getAttribute("labelletterspace") ? nodeChartItem.getAttribute("labelletterspace") : "";
                            }
                            if (attrSecondaryValue) {
                                index--;
                                boolSecondary = true;
                            }
                            //strPrefix +
                            let hasPercentageChart = xmlChart.getAttribute("ispercentageChart") == "true";
                            value = strChartName == "waterfallchart" && value == "sum" ? value : !hasPercentageChart ? strPrefix + this.getDenominationValue(value, strDenomoination, strCurrencySymbol) + strSuffix : strPrefix + this.getDenominationValue(value, strDenomoination, strCurrencySymbol);
                            if (strAsenterdValue && !isMultiseries) {
                                value = strChartName == "waterfallchart" && value == "sum" ? value : strAsenterdValue;
                            }
                        }
                    }
                    if (type.toLocaleLowerCase() == "icon" && value.includes("projectresources")) {
                        value = value.split("projectresources/")[1];
                    }
                    dpZenTableSource[r3].matrix[c3] = this.createDefaultOutlineCell();
                    dpZenTableSource[r3].matrix[c3].type = type.toLocaleLowerCase();
                    if (type.toLowerCase() == "logo") {
                        dpZenTableSource[r3].matrix[c3].type = "image";
                        dpZenTableSource[r3].matrix[c3].altertype = type;
                    }
                    if (needassetUpdate) {
                        dpZenTableSource[r3].matrix[c3]["needassetupdate"] = needassetUpdate;
                        dpZenTableSource[r3].matrix[c3]["assetsearch"] = assetSearchText;
                    }
                    if ((type.toLowerCase() == "image" || type.toLowerCase() == "logo" || type.toLowerCase() == "icon") && nodeChartItem && nodeChartItem.getAttribute("assettext")) {
                        dpZenTableSource[r3].matrix[c3].assetText = nodeChartItem.getAttribute("assettext");
                    }
                    if (type.toLocaleLowerCase() == "icon" || type.toLowerCase() == "image" || type.toLowerCase() == "logo") {
                        dpZenTableSource[r3].matrix[c3]["contenttype"] = type.toLocaleLowerCase();
                    }
                    dpZenTableSource[r3].matrix[c3].value = value;
                    if (hasStatistical) {
                        dpZenTableSource[r3].matrix[c3].statistical = hasStatistical;
                    }
                    if (textproperties && Object.keys(textproperties).length != 0) dpZenTableSource[r3].matrix[c3].textProperties = textproperties;
                    dpZenTableSource[r3].matrix[c3].data = {
                        id: id,
                    };
                    let highlight = nodeChartItem.getAttribute("highlight") == "true" ? true : false;
                    if (highlight) {
                        let highlighStyle = nodeChartItem.getAttribute("highlightstyle");
                        let caption = nodeChartItem.getAttribute("caption");
                        if (highlighStyle == "text") {
                            dpZenTableSource[r3].highlightProperty = {
                                highlight: highlight,
                                highlightstyle: highlighStyle,
                                caption: caption,
                            };
                        } else {
                            let highlighticonpath = nodeChartItem.getAttribute("highlighticonpath");
                            dpZenTableSource[r3].highlightProperty = {
                                caption: caption,
                                highlight: highlight,
                                highlightstyle: highlighStyle,
                                highlighticonpath: highlighticonpath,
                            };
                        }
                    }
                    let linkUrl = nodeChartItem.getAttribute("data-navigate-to-slide-on-click");
                    if (linkUrl) {
                        dpZenTableSource[r3].linkUrlProperty = linkUrl;
                    }
                    if (blnPlaceholderData) {
                        let placeholder = nodeChartItem.getAttribute("placeholder");
                        placeholder = placeholder ? placeholder : nodeChartItem.getAttribute("primaryPlaceholderPath");
                        let placeholderPath = nodeChartItem.getAttribute("primaryPlaceholderPath");
                        placeholderPath = placeholderPath ? placeholderPath : nodeChartItem.getAttribute("placeholderpath");
                        let placeholderType = nodeChartItem.getAttribute("placeholdertype");
                        let imageW = nodeChartItem.getAttribute("data-imagewidth");
                        let imageH = nodeChartItem.getAttribute("data-imageheight");
                        if (placeholder && placeholderPath && placeholderType)
                            dpZenTableSource[r3].primaryPlaceholderProperty = {
                                placeholder: placeholder,
                                placeholdertype: placeholderType,
                                placeholderpath: placeholderPath,
                            };
                        if (imageW && imageH) {
                            dpZenTableSource[r3].primaryPlaceholderProperty = {
                                placeholder: placeholder,
                                placeholdertype: placeholderType,
                                placeholderpath: placeholderPath,
                                "data-imagewidth": imageW,
                                "data-imageheight": imageH,
                            };
                        }
                    }
                    if (blnItemPlaceholder) {
                        let itemPlaceholder = nodeChartItem.getAttribute("itemplaceholder");
                        let itemPlaceholderPath = nodeChartItem.getAttribute("itemplaceholderpath");

                        if (itemPlaceholder && itemPlaceholder)
                            dpZenTableSource[r3].itemPlaceholderProperty = {
                                itemplaceholder: itemPlaceholder,
                                itemplaceholderpath: itemPlaceholderPath,
                            };
                    }
                    // if(){}
                    if (blnSecondaryplaceholder) {
                        let secondaryPholder = nodeChartItem.getAttribute("secondaryplaceholder");
                        let secondaryplaceholderpath = nodeChartItem.getAttribute("secondaryplaceholderpath");
                        let secondaryName = nodeChartItem.getAttribute("secondaryName") ? nodeChartItem.getAttribute("secondaryName") : "";
                        if (secondaryPlaceholder == "icon") {
                            dpZenTableSource[r3].secondaryPlaceholderProperty = {
                                secondaryplaceholder: secondaryPholder,
                                secondaryplaceholderpath: secondaryplaceholderpath,
                            };
                        } else if (secondaryPlaceholder == "image") {
                            let arrSecondaryPholder = secondaryplaceholderpath.split(".svg");
                            dpZenTableSource[r3].secondaryPlaceholderProperty = {
                                secondaryplaceholder: arrSecondaryPholder.length > 1 ? secondaryPholder : "",
                                secondaryplaceholderpath: secondaryplaceholderpath,
                            };
                        } else if (secondaryPlaceholder == "text") {
                            dpZenTableSource[r3].secondaryPlaceholderProperty = {
                                secondaryName: secondaryName,
                            };
                        }
                    }
                    let projection = nodeChartItem.getAttribute("projection") == "true" ? true : false;
                    if (projection)
                        dpZenTableSource[r3].projectionProperty = {
                            projection: projection,
                        };
                    let emphasis = nodeChartItem.getAttribute("emphasis") == "true" ? true : false;
                    if (emphasis)
                        dpZenTableSource[r3].emphasisProperty = {
                            emphasis: emphasis,
                        };
                    let graphicImage = nodeChartItem.getAttribute("graphicimage") == "true" || xmlChart.getAttribute("data-graphicimage") == "true" ? true : false;
                    if (strChartName == "logoComparisonChart" || strChartName == "logoGraphicComparisonChart") {
                        graphicImage = true;
                    }
                    if (graphicImage) {
                        let itemGraphicPath = nodeChartItem.getAttribute("itemGraphicPath");
                        itemGraphicPath = !itemGraphicPath ? nodeChartItem.getAttribute("itemgraphicpath") : itemGraphicPath;
                        let imageWidth = nodeChartItem.getAttribute("data-imagewidth");
                        let imageHeight = nodeChartItem.getAttribute("data-imageheight");
                        let graphicSize = nodeChartItem.getAttribute("data-itemgraphic-imagesize");
                        dpZenTableSource[r3].graphicImageProperty = {
                            graphicimage: graphicImage,
                            itemgraphicpath: itemGraphicPath,
                            "data-itemgraphic-imagesize": graphicSize,
                            "data-imagewidth": imageWidth,
                            "data-imageheight": imageHeight,
                        };
                    }
                }
                let boolItemImagePlaceholder = nodeChartItem.getAttribute("itemimageplaceholder");
                if (boolItemImagePlaceholder) {
                    let itemImagePlaceholder = nodeChartItem.getAttribute("itemimageplaceholder");
                    if (itemImagePlaceholder)
                        dpZenTableSource[r3].itemImagePlaceholderProperty = {
                            itemimageplaceholder: itemImagePlaceholder,
                        };
                }
            }
            objContent["asenteredvalue"] = arrAsenteredvalue;
            objContent["chartgroup"] = arrChartGroupDetails;
            objContent["logocontrast"] = arrLogoContrast;
            objContent["labeltextcolor"] = arrLabelTextColor;
            objContent["valuetextcolor"] = valueTextColor;
            objContent["secondarylabeltextcolor"] = arrSecondaryTextColor;
            this.updateAllTextProps(xmlChart, objContent);
            let columnIndex = nodeSlideElement.getAttribute("data-columnindex");
            let rowIndex = nodeSlideElement.getAttribute("data-rowindex");
            if (columnIndex && rowIndex && columnIndex >= 0 && rowIndex >= 0) dpZenTableSource[parseInt(rowIndex)].matrix[parseInt(columnIndex)].focus = true;
            else dpZenTableSource[parseInt(rowLength - 1)].matrix[parseInt(columnLength - 1)].focus = true;
        }
        let tempDpZenTableSource = JSON.parse(JSON.stringify(objProperties?.elementcontent?.matrix));
        let modifiedDpZenTableSource = this.checkStackedSizeValue(tempDpZenTableSource, xmlChart);
        objProperties.elementcontent.matrix = modifiedDpZenTableSource;
        objProperties.elementcontent["graphicIndex"] = graphicDiv?.getAttribute("data-graphic-index");
        objProperties.elementcontent["elementindex"] = graphicDiv?.getAttribute("data-graphic-index");

        this.updatePropertiesContent(objProperties, menuDetails);
    }
    // if (1 < objProperties.dpdesign.shapes.dpsource.length) objProperties.dpdesign.floaterchartstyle = true;
    return objProperties;
};
ChartUtils.prototype.updateAllTextProps = function (xmlData, objDetails) {
    let attributeValue = null;
    let objTextProperty = {};
    let elementValueDetails = ["label"];
    let arrayChildValues = ["texttextopacity", "letterspace"];
    for (let i1 = 0; i1 < xmlData.children.length; i1++) {
        for (let e1 = 0; e1 < elementValueDetails.length; e1++) {
            attributeValue = elementValueDetails[e1];
            arrayChildValues.forEach(function (element) {
                let value = xmlData.children[i1].getAttribute(attributeValue + element) || "";
                if (!objTextProperty[attributeValue + element]) {
                    objTextProperty[attributeValue + element] = [];
                }
                objTextProperty[attributeValue + element].push(value);
            });
        }
    }
    objDetails["textproperty"] = objTextProperty;
    console.log(objDetails);
};
ChartUtils.prototype.updatePropertiesContent = function (objProperties, menuData) {
    let arryProperties = [
        { aidataName: "graphic_title", chartproperties: ["charttitlename"] },
        { aidataName: "baseline_data_value", chartproperties: ["baseline_left_value", "baseline_bottom_value"] },
        { aidataName: "baseline_data_text", chartproperties: ["baseline_left_text", "baseline_bottom_text"] },
        { aidataName: "graphic_source", chartproperties: ["sourcetextname"] },
    ];
    let properties = objProperties?.elementcontent?.properties;
    for (let i = 0; i < arryProperties.length; i++) {
        let property = arryProperties[i];
        let chartProperty = property.chartproperties;
        for (let j = 0; j < chartProperty.length; j++) {
            let chartPropertyName = chartProperty[j];
            if (properties?.[chartPropertyName]) {
                objProperties.elementcontent[property.aidataName] = properties?.[chartPropertyName];
            }
        }
    }
    if (menuData?.aiGraphicType) {
        if (!objProperties.elementcontent["properties"]) {
            objProperties.elementcontent["properties"] = {};
        }
        objProperties.elementcontent["properties"]["aiGraphicType"] = menuData?.aiGraphicType;
    }
    if (menuData?.subGraphicType) {
        if (!objProperties.elementcontent["properties"]) {
            objProperties.elementcontent["properties"] = {};
        }
        objProperties.elementcontent["properties"]["subGraphicType"] = menuData?.subGraphicType;
    }
    if (menuData?.heroGraphic) {
        if (!objProperties.elementcontent["properties"]) {
            objProperties.elementcontent["properties"] = {};
        }
        objProperties.elementcontent["properties"]["heroGraphic"] = menuData?.heroGraphic;
    }
};
ChartUtils.prototype.checklabeltextproperties = function (nodeChartItem) {
    let objdata = {};
    let labellineheight = nodeChartItem.getAttribute("labellineheight");
    if (labellineheight) objdata["lineheight"] = labellineheight;
    let labelletterspace = nodeChartItem.getAttribute("labelletterspace");
    if (labelletterspace) objdata["letterspace"] = labelletterspace;
    return objdata;
};
ChartUtils.prototype.createChartJSONData = function (xmlChart) {
    let obj = {};
    if (xmlChart.nodeType == 1) {
        if (xmlChart.attributes.length > 0) {
            for (var j = 0; j < xmlChart.attributes.length; j++) {
                var attribute = xmlChart.attributes.item(j);
                obj[attribute.nodeName] = attribute.nodeValue;
            }
        }
    } else if (xmlChart.nodeType == 3) {
        obj = xmlChart.nodeValue;
    }
    let baseLine = xmlChart.getAttribute("axisbaseline") || xmlChart.getAttribute("data-baseline");
    let highlightdifference = xmlChart.getAttribute("data-highlightdifference");
    let emphasis = xmlChart.getAttribute("emphasis");
    let projection = xmlChart.getAttribute("projection");
    let placeHolderType = xmlChart.getAttribute("variationplaceholder");
    if (baseLine) {
        obj["variationproperty"] = "baseline";
    }
    if (highlightdifference) {
        obj["variationproperty"] = "highlightdifference";
    }
    if (emphasis) {
        obj["variationproperty"] = "emphasize";
    }
    if (projection) {
        obj["variationproperty"] = "projection";
    }
    if (placeHolderType) {
        obj["variationproperty"] = placeHolderType;
    }
    return obj;
};
ChartUtils.prototype.checkStackedSizeValue = function (dpZenTableSource, xmlChart) {
    let tempZenNode = JSON.parse(JSON.stringify(dpZenTableSource));
    let hasStackedSizeValue = xmlChart.getAttribute("data-stackedsizevalue") == "true";
    let xmlChartChildren = xmlChart.children;
    if (hasStackedSizeValue) {
        for (let i = 0; i < xmlChartChildren.length; i++) {
            let stackedWidth = xmlChartChildren[i].getAttribute("seriesitemwidth");
            let zenNode = tempZenNode[i];
            let result = this.extractSecondTextObject(zenNode, stackedWidth);
            zenNode = result.modifiedArray;
            tempZenNode[i] = zenNode;
        }
    }
    return tempZenNode;
};
ChartUtils.prototype.extractSecondTextObject = function (zenNode, stackedWidth) {
    let textObjectCount = 0;
    let secondTextObjectIndex = -1;
    let secondTextObject = null;

    for (let i = 0; i < zenNode.matrix.length; i++) {
        if (zenNode.matrix[i].type === "text") {
            textObjectCount++;
            if (textObjectCount === 1) {
                secondTextObjectIndex = i + 1;
                break;
            }
        }
    }

    // Remove the second text object if found
    let objectToAdd = JSON.parse(JSON.stringify(zenNode.matrix[secondTextObjectIndex]));
    objectToAdd.value = stackedWidth;
    if (objectToAdd?.data?.id) objectToAdd.data.id = objectToAdd.data.id.replace("value", "stackedwidthvalue");
    if (secondTextObjectIndex !== -1) {
        zenNode.matrix.splice(secondTextObjectIndex, 0, objectToAdd);
    }

    return {
        modifiedArray: zenNode,
    };
};
ChartUtils.prototype.checkValuetextproperties = function (xmlChart, nodeChartItem) {
    let objdata = {};
    let boolEnableLineHeight = xmlChart.getAttribute("enablelabellineheight");
    let labellineheight = nodeChartItem.getAttribute("labellineheight") && boolEnableLineHeight == "true" ? nodeChartItem.getAttribute("labellineheight") : "";
    if (labellineheight) {
        objdata["lineheight"] = labellineheight;
    }
    let boolEnableLetterSpace = xmlChart.getAttribute("enablelabelletterspace");
    let labelletterspace = boolEnableLetterSpace == "true" && nodeChartItem.getAttribute("labelletterspace") ? nodeChartItem.getAttribute("labelletterspace") : "";
    if (labelletterspace) objdata["labelletterspace"] = labelletterspace;
    return {};
};
ChartUtils.prototype.getChartDesignProperties = function (xmlChart, metadata) {
    let strChartName = xmlChart.getAttribute("name");
    let strLayoutName = xmlChart.getAttribute("layout");
    let strClassName = xmlChart.getAttribute("data-classname");
    let arrLayoutList = [];
    if (xmlChart.getAttribute("layoutlist") || xmlChart.getAttribute("additionallayoutlist"))
        arrLayoutList =
            xmlChart.getAttribute("primaryplaceholder") == "true"
                ? xmlChart.getAttribute("additionallayoutlist") && xmlChart.getAttribute("additionallayoutlist").split(",").length > 0
                    ? xmlChart.getAttribute("additionallayoutlist").split(",")
                    : xmlChart.getAttribute("layoutlist").split(",")
                : xmlChart.getAttribute("layoutlist").split(","); //objLayoutList.arrDuplictatelayoutList.length <= 0 ? objLayoutList.arrLayoutList : objLayoutList.arrDuplictatelayoutList;
    // let chartListData = ChartHelper.getChartListDataByName(strChartName);
    let jsonChartItemMetaData = this.getChartItemMetaData("name", strClassName)[0]; //chartListData.name
    let category = !jsonChartItemMetaData.layoutcategory ? (jsonChartItemMetaData.category == "simple" || !jsonChartItemMetaData.category ? "" : jsonChartItemMetaData.category) : jsonChartItemMetaData.layoutcategory;
    // let rules = CssChartUtils.ruler(xmlChart, null, "speciallayout");
    // if (rules) {
    //     if (rules["speciallayout"] && rules["speciallayout"]["speciallist"]) {
    //         arrLayoutList = arrLayoutList.concat(rules["speciallayout"]["speciallist"]);
    //     }
    // }
    let layoutThumbnail = metadata?.getAttribute("conflictLayoutList");
    if (layoutThumbnail) {
        arrLayoutList = layoutThumbnail.split(",");
    }
    if (xmlChart.children.length > 6) {
        let topIndex = arrLayoutList.indexOf("toplabel");
        if (topIndex !== -1) arrLayoutList.splice(topIndex, 1);
    }
    let layoutList = arrLayoutList.length == 1 ? 0 : arrLayoutList.length;
    let seriesItemLength = Number(metadata?.getAttribute("sublength"));
    let objChartDesignSupport = {
        layouts: {
            visible: seriesItemLength >= 1 ? true : false,
            dpsource: [],
            selectedindex: 0,
        },
    };

    let selectedIndex;
    let arrValidationList = ""; //ChartDataValidation.doLayoutValidation(xmlChart, null, true);
    let boolIcon = arrValidationList ? arrValidationList["boolIcon"] : false;
    let boolNegative = arrValidationList ? arrValidationList["boolNegative"] : false;
    if ((boolIcon || boolNegative) && arrValidationList) {
        let dupLayoutList = arrValidationList["layoutList"];
        category = arrValidationList["category"];
        for (let i = 0; i < dupLayoutList.length; i++) {
            objChartDesignSupport.layouts.dpsource.push({
                data: dupLayoutList[i],
                icon: "sidepanelgraphicicons/chart/chartlayoutthumbnails/" + dupLayoutList[i] + category + ".png",
            });
        }

        selectedIndex = this.getSelectedIndex(objChartDesignSupport.layouts.dpsource, strLayoutName);
        objChartDesignSupport.layouts.selectedindex = selectedIndex;
    } else {
        for (let i = 0; i < layoutList; i++) {
            objChartDesignSupport.layouts.dpsource.push({
                data: arrLayoutList[i],
                icon: "sidepanelgraphicicons/chart/chartlayoutthumbnails/" + arrLayoutList[i] + category + ".png",
            });
        }

        let indexLayoutname = this.indexLayoutName(arrLayoutList, strLayoutName);
        selectedIndex = this.getSelectedIndex(objChartDesignSupport.layouts.dpsource, indexLayoutname);
        objChartDesignSupport.layouts.selectedindex = selectedIndex;
    }
    return objChartDesignSupport;
};
ChartUtils.prototype.indexLayoutName = function (arrLayoutList, strLayoutName) {
    for (let i1 = 0; i1 < arrLayoutList.length; i1++) {
        if (arrLayoutList[i1] == strLayoutName) return arrLayoutList[i1];
    }
    for (let i1 = 0; i1 < arrLayoutList.length; i1++) {
        if (arrLayoutList[i1].includes(strLayoutName)) return arrLayoutList[i1];
    }
};
ChartUtils.prototype.getChartContentProperties = function (xmlChart, nodeSlideElement, slideContent, menuDetails) {
    let strName = xmlChart.getAttribute("name");
    let strLayout = xmlChart.getAttribute("layout");
    let strAssetName = xmlChart.getAttribute("data-asset");
    let strClassname = xmlChart.getAttribute("data-classname");
    let objItamAsset = []; ///this.getItemAssetData(strName, strAssetName);
    // let strClass = ChartHelper.getChartListDataByName(strName).name;
    let jsonChartItemMetaData = this.getChartItemMetaData("name", strClassname)[0]; //strClass
    this.ChartHelper = new window["ChartHelper"]();
    let objLayout = this.ChartHelper.getLayout("", strAssetName, strAssetName, xmlChart, false, false, menuDetails);
    let voLayout = new VOLayout(objLayout, xmlChart, null, nodeSlideElement);
    var voCustomProperties = new VOCustomProperties({
        data: xmlChart,
        voLayout: voLayout,
        currentslide: slideContent,
        asset: objItamAsset,
        baseProperties: jsonChartItemMetaData,
    });
    return voCustomProperties.allProperties;
};

ChartUtils.prototype.getChartNodeCount = function (defaultnode, metadata, strChartName, xmlChart) {
    let dpDropdown = [];
    let dpdropdownlist = [];
    let selectedindex = 0;
    let objNodeCount = {};
    let minnode = Number(metadata?.getAttribute("minseries")) || 0;
    let maxnode = Number(metadata?.getAttribute("maxseries")) || 0;
    let nodeIndex = strChartName == "comparisonModelType3" ? Number((metadata?.getAttribute("length") || 2) / 2) : Number(metadata?.getAttribute("length") || 0);
    for (let i1 = minnode; i1 <= maxnode; i1++) {
        if (i1 == 1)
            dpDropdown.push({
                label: i1 + " Points",
                data: i1 + " Node",
            });
        else
            dpDropdown.push({
                label: i1 + " Points",
                data: i1 + " Nodes",
            });
        if (defaultnode && i1 == defaultnode.split(" ")[0]) selectedindex = i1;
    }
    let dropmin = Number(xmlChart.getAttribute("data-menuminseries"));
    let dropmax = Number(xmlChart.getAttribute("data-menumaxseries"));
    for (let i2 = dropmin; i2 <= dropmax; i2++) {
        if (i2 == 1)
            dpdropdownlist.push({
                label: i2,
                data: i2 + " Node",
            });
        else
            dpdropdownlist.push({
                label: i2 + " Points",
                data: i2 + " Nodes",
            });
        // if (defaultnode && i2 == defaultnode.split(" ")[0]) selectedindex = i2;
    }
    objNodeCount.visible = dpDropdown && dpDropdown.length > 0 && dropmax != 1 ? true : false;
    if (dropmax == maxnode && dropmin == minnode && dropmin == maxnode) {
        objNodeCount.visible = false;
    }
    if (maxnode > 1 && !objNodeCount.visible) {
        objNodeCount.visible = true;
    }
    objNodeCount.dpsource = dpDropdown;
    objNodeCount.dpsource = dpdropdownlist;
    objNodeCount.selectedindex = nodeIndex - minnode;
    objNodeCount.enable = xmlChart.getAttribute("addenable") && xmlChart.getAttribute("addenable") == "false" ? false : true;
    return objNodeCount;
};

ChartUtils.prototype.getChartDefaultDataBasedOnCount = function (maxCount = 0) {
    let chartXmlGenerator = new window["ChartXmlGenerator"]();
    let defaultData = chartXmlGenerator.chartDefaultData();
    let tempMatrixData = [];
    for (let i = 0; i < maxCount; i++) {
        if (defaultData.data.matrix[i]) {
            tempMatrixData.push(JSON.parse(JSON.stringify(defaultData.data.matrix[i])));
        } else {
            tempMatrixData.push(this.createDefaultOutlineRow());
        }
    }
    if (tempMatrixData.length > 0) defaultData.data.matrix = tempMatrixData;
    return defaultData;
};
