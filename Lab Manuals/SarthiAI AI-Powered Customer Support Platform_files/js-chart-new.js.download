            let italicValue = metaData.getAttribute("chartgrouplabelfontitalic")?.split("^")?.length > 0 && metaData.getAttribute("chartgrouplabelfontitalic")?.split("^")?.[indexVale] == "true" ? true : false;

            textBold["value"] = boldValue;
            textItalic["value"] = italicValue;
        }
        if (elementType == "value" || elementType == "promt" || elementType == "totalvalue" || elementType == "legendvalue") {
