                    lineElement.style.borderTopWidth = this.data.layout.gridLineThickness;
                }
                gridLineElement.appendChild(lineElement);
                lineElementHeight = lineElement.clientHeight;
                if (i1 == this.positiveGridCount - 1 && this.move3dY && this.negBounds.height == 0) {
                    let poswidth = lineElement.clientWidth;
                    let posmoveX = Math.round(this.move3dY);
                    poswidth = poswidth - posmoveX;
                    let posheight = lineElement.clientHeight + Math.round(lineElement.clientHeight * 0.07);
                    let posintY = this.move3dY + 10;
                    let posmoveY = 0;
                    let svgPos3dshape = this.data.SVGUtils.createSVGElement("svg");
                    this.data.SVGUtils.assignAttributes(svgPos3dshape, {
                        width: "100%",
                    });
                    svgPos3dshape.style.position = "absolute";
                    svgPos3dshape.style.top = lineElement.offsetTop + lineElement.clientHeight - this.move3dY + "px";
                    gridLineElement.appendChild(svgPos3dshape);
                    let pospathElement = this.data.SVGUtils.createSVGElement("path");
                    this.data.SVGUtils.assignAttributes(pospathElement, {
                        d: "M0" + "," + posintY + "L" + posmoveX + "," + posmoveY + "L" + (poswidth + posmoveX) + "," + posmoveY + "L" + poswidth + "," + posintY + " Z",
                        "fill-opacity": 0.15,
                        class: "moodanimation",
                        "data-animation": "gridlines",
                        fill: "rgba(var(--th-slide-contrast),1)",
                    });
                    svgPos3dshape.appendChild(pospathElement);
                }
            }

            for (let i2 = 0; i2 < this.positiveGridCount; i2++) {
                let valueElement = document.createElement("div");
                valueElement.className = "gridvalues moodanimation " + this.ChartFonts.gridThemeClassName + " " + this.ChartFonts.gridLabelOuterColor;
                valueElement.style.width = this.gridValueSizeW + "px";
                valueElement.style.height = height ? height : "auto";
                valueElement.innerHTML = this.getDenominationValue(Math.round((this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2)));
                if (this.voData.rangeTotal < 3) {
                    valueElement.innerHTML = this.getDenominationValue((this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2));
                }
                if (this.data.displayValueFormat == "percentage") {
