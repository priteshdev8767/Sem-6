                highlightType: "Pattern",
                seperator: "true",
                primary: "true",
                src: "./core/packages/simpleVerticalDumbbellDC/SimpleVerticalDumbbellChart.js",
            },
        },
    };
    return value;
};

function ChartTextChangeHandler() {
    // Constructor function - can be empty or contain initialization logic
    this.ChartUtils = new window["ChartUtils"]();
}

ChartTextChangeHandler.prototype.onFocusoutHandler = function (element, callback = null, xmlData) {
    const type = element.getAttribute("data-type");
    switch (type) {
        case "label":
        case "legendlabel":
        case "comparisonlabel":
        case "placeholdertext":
        case "comparelabel":
            element.parentElement.scrollTop = 0;
            this.assignLabelData(element, type, callback, xmlData);
        case "seriesItemLabel":
            element.parentElement.scrollTop = 0;
            this.assignSeriesItemLabelData(element, callback, xmlData);
            break;
        case "highlightlabel":
            element.parentElement.scrollTop = 0;
            this.assignHighlightLabelData(element, callback, xmlData);
            break;
        case "sourcetext":
            element.parentElement.scrollTop = 0;
            this.assignSourceLabelData(element, callback, xmlData);
            break;
        case "charttiletext":
            element.parentElement.scrollTop = 0;
            this.assignChartTitleData(element, callback, xmlData);
            break;
        case "multilegendlabel":
            element.parentElement.scrollTop = 0;
            this.assignLegendLabelData(element, callback, xmlData);
            break;
        case "value":
        case "legendvalue":
            if (element.dataset.enabled != "true") {
                this.assignValueData(element, callback, xmlData);
            }
            break;
        case "promt":
            element.parentElement.scrollTop = 0;
            this.assignpromptLabelData(element, callback, xmlData);
            break;
        case "totalvalueprompt":
            element.parentElement.scrollTop = 0;
            this.assignTotalValuePromptLabelData(element, callback, xmlData);
            break;
        case "hdtext":
            element.parentElement.scrollTop = 0;
            this.assignIndualHdLabelData(element, callback, xmlData);
            break;
        case "axistitle":
            element.scrollLeft = 0;
            this.assignAxisTitleData(element, callback, xmlData);
            break;
        case "itemheader":
        case "labelheader":
        case "valueheader":
        case "secondaryheader":
            element.scrollLeft = 0;
            this.asseignHeaderTitle(element, callback, xmlData);
            break;
        case "baselinecallout":
            this.assignBaseLineData(element, callback, xmlData);
            break;
        case "basevalue":
            this.assignBaseLinevalueData(element, callback, xmlData);
            break;
        case "baseleftvalue":
            this.assignBaseLineLeftvalueData(element, callback, xmlData);
            break;
        case "secondarylabel":
            this.assignSecondaryData(element, callback, xmlData);
            break;
        case "projectiontext":
            this.assignProjectionLabelData(element, callback, xmlData);
            break;
        case "projectionheadingtext":
            this.assignProjectionHeadingLabelData(element, callback, xmlData);
            break;
        case "comparelabelheader":
            this.assignCompareHeaderLabelData(element, callback, xmlData);
            break;
        case "chartgrouplabel":
            this.assignChartGroupLabelData(element, callback, xmlData);
            break;
    }
};

ChartTextChangeHandler.prototype.assignLabelData = function (element, type, callback = null, xmlData, stopRedraw = false) {
    let labelText = element.innerHTML;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = this.getSlideId(element);
    let hasGraphicImage = xmlData?.getAttribute("data-graphicimage") == "true";
    let hasChange = false;
    if (type == "comparisonlabel") {
        let oldCompareLabel = xmlData.children[index].getAttribute("comparisonname");
        if (oldCompareLabel != labelText) {
            element.innerHTML = oldCompareLabel;
            xmlData.children[index].setAttribute("comparisonname", labelText);
            if (hasGraphicImage) {
                xmlData.children[index].setAttribute("needassetupdate", "true");
                xmlData.children[index].removeAttribute("assetsearchtext");
            }
            hasChange = true;
        }
    } else if (type == "placeholdertext") {
        let oldCompareLabel = xmlData.getAttribute("commonplaceholdertext");
        if (oldCompareLabel != labelText) {
            element.innerHTML = oldCompareLabel;
            xmlData.setAttribute("commonplaceholdertext", labelText);
            hasChange = true;
        }
    } else if (type == "comparelabel") {
        let oldCompareLabel = xmlData.getAttribute("comparetext");
        if (oldCompareLabel != labelText) {
            element.innerHTML = oldCompareLabel;
            xmlData.setAttribute("comparetext", labelText);
            hasChange = true;
        }
    } else {
        let oldLabel = xmlData.children[index].getAttribute("name");
        let oldIndexHtml = xmlData.children[index].getAttribute("innerHtml") ? xmlData.children[index].getAttribute("innerHtml") : oldLabel;
        let oldInnerHtmlText = TextHighLightUtils.highlightToString(oldIndexHtml);
        if (labelText && (labelText.includes("<p") || labelText.includes("<br>") || labelText.includes("<div>"))) labelText = TextHighLightUtils.highlightToString(element.innerHTML);
        let highlightNode = element.getAttribute("highlighnode");
        if (oldInnerHtmlText != labelText || oldLabel != labelText) {
            element.innerHTML = oldInnerHtmlText;
            if (highlightNode) element.removeAttribute("highlighnode");
            if (labelText == "<br>") {
                labelText = "";
            }
            if (hasGraphicImage) {
                xmlData.children[index].setAttribute("needassetupdate", "true");
            }
            xmlData.children[index].setAttribute("name", labelText);
            xmlData.children[index].setAttribute("innerHtml", labelText);
            hasChange = true;
        }
    }
    if (stopRedraw) {
        return hasChange;
    } else {
        if (hasChange) {
            // Get divParent from element context
            let divParent = this.getElementSlide(element, true);

            // Get stored data from data store
            // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
            let chartId = divParent?.getAttribute("data-chart-id");
            let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
            let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

            // Use stored data if available, otherwise use null
            let finalMenuData = storedMenuData || null;

            this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
        }
    }
};

ChartTextChangeHandler.prototype.getTextChangeOperationListener = function () {
    this.ChartUtils = new window["ChartUtils"]();
    let appStore = this.ChartUtils.getAppStore();
    let unsubscribe = appStore.subscribe(
        (state) => {
            return state.operationsTextData;
        },
        (operationsTextData) => {
            this.onFocusoutHandler(operationsTextData?.event?.target, operationsTextData.callback, operationsTextData.xmlData);
        }
    );

    // Add subscription to centralized manager
    if (window.addSubscription) {
        window.addSubscription(unsubscribe);
    }
};

ChartTextChangeHandler.prototype.getElementSlide = function (element, returnorginal = false) {
    if (!element) return null;
    if (element?.getAttribute("class")?.includes("ci-layout-container")) {
        return returnorginal ? element : element?.querySelector?.(".ci-layout-container");
    }
    if (element.parentElement) {
        return this.getElementSlide(element.parentElement, returnorginal);
    }
    return null;
};

ChartTextChangeHandler.prototype.getSlideId = function (element) {
    if (element) {
        return element.getAttribute("data-slideid") || this.getElementSlide(element).getAttribute("id");
    }
    return null;
};

ChartTextChangeHandler.prototype.getXmlData = function (slide, xmlData) {
    // This method seems to be redundant as xmlData is already properly assigned
    // from slide.querySelector("desc").children[0]
    return xmlData;
};

ChartTextChangeHandler.prototype.assignSeriesItemLabelData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = this.getSlideId(element);
    let oldLabel = xmlData.getAttribute("seriesitemlabel");
    this.seriesItemLabel = xmlData.getAttribute("seriesitemlabel").split("^");
    this.newText = labelText;
    element.innerHTML = this.seriesItemLabel[index];
    this.seriesItemLabel[index] = this.newText;
    this.newText = "";
    this.newText = this.seriesItemLabel.join("^");
    if (oldLabel != this.newText) {
        xmlData.setAttribute("seriesitemlabel", this.newText);
        // Get divParent from element context
        let divParent = this.getElementSlide(element, true);

        // Get stored data from data store
        // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
        let chartId = divParent?.getAttribute("data-chart-id");
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

        // Use stored data if available, otherwise use null
        let finalMenuData = storedMenuData || null;

        this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
    }
};
ChartTextChangeHandler.prototype.assignLegendLabelData = function (element, callback = null, xmlData) {
    let labelText = element.innerHTML;
    if (labelText.includes(",")) {
        labelText = labelText.replaceAll(",", "^");
    }
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = this.getSlideId(element);
    this.multiSeriesLegend = xmlData.getAttribute("multiserieslegend").split(",");
    this.newText = labelText;
    element.innerHTML = this.multiSeriesLegend[index];
    this.multiSeriesLegend[index] = this.newText;
    this.newText = "";
    this.newText = this.multiSeriesLegend.join(",");
    // Get divParent from element context
    let divParent = this.getElementSlide(element, true);

    // Get stored data from data store
    // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
    let chartId = divParent?.getAttribute("data-chart-id");
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    let storedMenuData = graphicIndex ? getMenuData(graphicIndex) : getMenuData();

    // Use stored data if available, otherwise use null
    let finalMenuData = storedMenuData || null;
    this.newText = "";
    this.newText = this.multiSeriesLegend.join(",");
    xmlData.setAttribute("multiserieslegend", this.newText);
    this.ChartUtils.chartRecreate(slideID, xmlData, finalMenuData, divParent, callback);
};
