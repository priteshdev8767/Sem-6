            textItalic = this.FloaterPropertyObjects.fontitalic;
            fontListing = this.FloaterPropertyObjects.fontsize;
            texttransform = this.FloaterPropertyObjects.texttransform;
            textopacity = this.FloaterPropertyObjects.textopacity;
            textOpacityValue = metaData.children[index].getAttribute("secondarylabeltexttextopacity") ? metaData.children[index].getAttribute("secondarylabeltexttextopacity") : 1;
            transformValue = metaData.children[index].getAttribute("secondarylabeltexttexttransform") ? metaData.children[index].getAttribute("secondarylabeltexttexttransform") : "";
            texttransform["val"] = transformValue;
            textopacity["elementvalue"] = "secondarylabeltextdynamicalign";
            texttransform["elementvalue"] = "secondarylabeltextdynamicalign";
            textopacity["val"] = textOpacityValue;
            let dpTitleFontSize = [{ label: "auto", data: "auto" }];
            let titleFontSizeList;
            titleFontSizeList = this.FloaterPropertyObjects.PARA_FONT_STYLING;
            for (let i = 0; i < titleFontSizeList.length; i++) {
                dpTitleFontSize.push(titleFontSizeList[i]);
            }
            let selectedIndex = this.getSelectedIndex(dpTitleFontSize, metaData.children[index].getAttribute("secondarylabeltextfontsize"), 0);
            let textselectedIndex = this.getSelectedIndex(textSize["dpsource"], metaData.children[0].getAttribute("secondarylabeltexttextsize"), 0);
            textSize["selectedindex"] = textselectedIndex;
            fontListing["dpsource"] = dpTitleFontSize;
            fontListing["selectedindex"] = selectedIndex;
            fontListing["elementvalue"] = "secondarylabeltextdynamicalign";
            textSize["elementvalue"] = "secondarylabeltextdynamicalign";
            textBold["elementvalue"] = "secondarylabeltextdynamicalign";
            textItalic["elementvalue"] = "secondarylabeltextdynamicalign";
            textBold["value"] = metaData.getAttribute("secondarylabeltextfontbold") ? true : false;
            textItalic["value"] = metaData.getAttribute("secondarylabeltextfontitalic") ? true : false;
        }
        if (itemId.includes("series") || elementType == "ITEM" || elementType == "ICON" || ((itemId?.includes("graphicimage-") || itemId?.includes("image-")) && elementType == "IMAGE") || elementSpecialType == elementType || elementType == "legendvalue" || elementType == "legendlabel") {
            supportNodeProperty = true;
        }
        // supportNodeProperty = true;
        if (
            supportNodeProperty ||
            elementType == "valueheader" ||
            elementType == "secondaryheader" ||
            elementType == "labelheader" ||
            elementType == "value" ||
            elementType == "promt" ||
            elementType == "totalvalue" ||
            elementType == "label" ||
            elementType == "ITEM" ||
            elementType == "legendvalue" ||
            elementType == "legendlabel" ||
            elementType == "secondarylabel" ||
            elementType == "sourcetext" ||
            elementType == "charttiletext" ||
            elementType == "projectiontext" ||
            elementType == "projectionheadingtext" ||
            elementType == "itemheader" ||
            elementType == "multilegendlabel" ||
            elementType == "axistitle" ||
            elementType == "comparelabelheader" ||
            elementType == "chartgrouplabel"
        ) {
