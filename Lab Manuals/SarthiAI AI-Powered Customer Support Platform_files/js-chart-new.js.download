/**
 * Create tooltip callout for chart elements
 * @param {HTMLElement} eParent - The parent element containing chart graphics
 * @param {HTMLElement} tempSlide - The slide element (optional)
 * @param {HTMLElement} tempScaledParent - The scaled parent element (optional)
 * @param {HTMLElement} tempXmlData - The XML chart data (optional)
 */
ChartUtils.prototype.createTooltipCallout = function (eParent, tempSlide, tempScaledParent, tempXmlData) {
    if (!eParent) return;

    // Clear existing event listeners first to prevent duplicates
    this.removeTooltipEventListeners(eParent);

    let isChartGraphic = false;
    let graphicContainer = eParent.querySelectorAll(".graphicconatiner");

    if (graphicContainer.length < 1) {
        graphicContainer = eParent.querySelectorAll(".graphicConatiner");
    }

    if (graphicContainer.length < 1) {
        graphicContainer = eParent.querySelectorAll(".dumbbellchartshape");
        isChartGraphic = true;
    }

    let xmlData = tempXmlData ? tempXmlData : eParent.querySelector(".chartbase");
    if (!xmlData) return;

    let chartName = xmlData?.getAttribute("name") || "";
    let maxSeriesNode = parseInt(xmlData?.getAttribute("data-menumaxseries") || 9) || parseInt(xmlData?.getAttribute("data-maxseries") || 9);

    if (maxSeriesNode < 2) {
        return;
    }

    if (graphicContainer.length < 1) {
        graphicContainer = eParent.querySelectorAll(".chartMainGraphic");
        isChartGraphic = true;
    }

    if (graphicContainer.length < 1) {
        graphicContainer = eParent.querySelectorAll(".chartgraphic");
        isChartGraphic = true;
    }

    if (eParent?.querySelector(".chartmaskrect")) {
        graphicContainer = eParent.querySelectorAll(".chartmaskrect");
    }

    let seriesElements = eParent.querySelectorAll(".series");
    let baseSeries = eParent.querySelector("#base-series");

    if (!baseSeries) return;

    let values = eParent.querySelectorAll("[data-type='value']");
    values = values.length > 0 ? values : eParent.querySelectorAll("[data-type='legendvalue']");

    let labels = eParent.querySelectorAll("[data-type='label']");
    labels = labels.length > 0 ? labels : eParent.querySelectorAll("[data-type='legendlabel']");
    labels = labels.length > 0 ? labels : eParent.querySelectorAll("[data-type='comparisonlabel']");
    labels = labels.length > 0 ? labels : eParent.querySelectorAll("[data-type='comparelabel']");

    // Data mapping for region names and percentages
    const regionData = {};

    // Create tooltip element or use existing one
    let tooltip = baseSeries.querySelector(".chart-tooltip");
    let fontJSON = this.getFonList(xmlData);
    let fontClassName = fontJSON?.tooltiptext ? fontJSON.tooltiptext : "p7";

    if (!tooltip) {
        tooltip = document.createElement("div");
        tooltip.className = "chart-tooltip " + fontClassName;
        baseSeries.appendChild(tooltip);
    }

    tooltip.style.opacity = "0";
    tooltip.style.visibility = "hidden";

    let toolTipChild = baseSeries.querySelector(".chart-tooltip-child");
    if (!toolTipChild) {
        toolTipChild = document.createElement("div");
    }

    toolTipChild.className = "chart-tooltip-child";
    tooltip.appendChild(toolTipChild);

    // Save event listener references so we can remove them later
    if (!eParent._tooltipListeners) {
        eParent._tooltipListeners = new Map();
    }

    let slideId = null;
    if (typeof window !== "undefined" && window.DocumentStore) {
        slideId = window.DocumentStore.getInstance().currentSlideID;
    }

    let slide = tempSlide ? tempSlide : slideId && window.DocumentStore ? window.DocumentStore.getInstance().getSlideDetails(slideId)?.content : null;
    // Use container as fallback if scaledParent is not available
    let scaledParent = tempScaledParent ? tempScaledParent : slide ? slide.parentNode : baseSeries;

    // Add event listeners to each column
    graphicContainer.forEach((column, index) => {
        // Get the region name based on index or data-attribute
        let columnGraphic = isChartGraphic ? column : column.querySelector(".chartgraphic") || column;
        let indexId = columnGraphic?.getAttribute("data-id") || columnGraphic?.getAttribute("id")?.split("-")[1];

        let seriesIndexValue = indexId?.split("_")[0] || "";
        let seriesItemIndexValue = indexId?.split("_")[1] || 0;

        let baseSeriesItem = seriesElements[seriesIndexValue]?.querySelector("[id='baseseriesitem-" + seriesItemIndexValue + "']");

        let idValue = column.getAttribute("data-id") || seriesIndexValue + "_" + seriesItemIndexValue;

        let valueText = "";
        values.forEach((element) => {
            if (element.getAttribute("data-id") == column.getAttribute("data-id") || (idValue && element.getAttribute("id").includes(idValue)) || element.getAttribute("data-id") == seriesIndexValue) {
                valueText = element;
            }
        });

        let arrLegendText = xmlData?.getAttribute("multiserieslegend")?.split(",") || xmlData?.getAttribute("multiserieslegend")?.split("^");

        let legendTextValue = chartName != "waterfallchart" ? arrLegendText?.[seriesItemIndexValue] || "" : "";

        let labelText = "";
        if (!legendTextValue) {
            labels.forEach((element) => {
                if (element.getAttribute("data-id") === seriesIndexValue) {
                    labelText = element;
                }
            });
        }

        let regionNames = Object.keys(regionData || {});
        let regionName = regionNames?.[seriesIndexValue % regionNames.length] || labelText?.textContent || legendTextValue || "";

        let percentage = regionData?.[regionName]?.[seriesItemIndexValue] || valueText.textContent || this.getchartValueNode(eParent, seriesIndexValue, seriesItemIndexValue, xmlData) || "";

        if (valueText && valueText.getAttribute("data-innertext")) {
            percentage = valueText.getAttribute("data-innertext") || percentage;
        }

        // Create event listener functions and store references to them
        const mouseEnterHandler = (e) => {
            // Set tooltip content
            toolTipChild.innerHTML = `<strong>${percentage}</strong> ${regionName}`;
            this.checkToolTipMaxHeight(toolTipChild, tooltip);

            // Position the tooltip
            this.positionTooltip(e, tooltip, baseSeries, "auto", 15, slide, scaledParent);

            // Show tooltip
            tooltip.style.visibility = "visible";
            tooltip.style.opacity = "1";
        };

        const mouseMoveHandler = (e) => {
            // Reposition tooltip on mouse move
            this.positionTooltip(e, tooltip, baseSeries, "auto", 15, slide, scaledParent);
        };

        const mouseLeaveHandler = () => {
            // Hide tooltip
            toolTipChild.style.removeProperty("height");
            tooltip.style.visibility = "hidden";
            tooltip.style.opacity = "0";
        };

        // Save references to these handlers
        const handlers = {
            mouseenter: mouseEnterHandler,
            mousemove: mouseMoveHandler,
            mouseleave: mouseLeaveHandler,
        };

        // Store event listeners in the map with column as key
        eParent._tooltipListeners.set(column, handlers);

        // Add event listeners
        column.addEventListener("mouseenter", mouseEnterHandler);
        column.addEventListener("mousemove", mouseMoveHandler);
        column.addEventListener("mouseleave", mouseLeaveHandler);
    });
};

/**
 * Remove tooltip event listeners from parent element
 * @param {HTMLElement} eParent - The parent element
 */
ChartUtils.prototype.removeTooltipEventListeners = function (eParent) {
    // Check if we have stored listeners
    if (!eParent._tooltipListeners) {
        return;
    }

    // Remove all event listeners
    eParent._tooltipListeners.forEach((handlers, column) => {
        column.removeEventListener("mouseenter", handlers.mouseenter);
        column.removeEventListener("mousemove", handlers.mousemove);
        column.removeEventListener("mouseleave", handlers.mouseleave);
    });

    // Clear the listeners map
    eParent._tooltipListeners.clear();
};

/**
 * Get chart value node for tooltip
 * @param {HTMLElement} element - The element
 * @param {string|number} seriesIndexValue - Series index
 * @param {string|number} seriesItemIndexValue - Series item index
 * @param {HTMLElement} xmlData - XML chart data
 * @returns {string} The value
 */
ChartUtils.prototype.getchartValueNode = function (element, seriesIndexValue, seriesItemIndexValue, xmlData) {
    let value = "";

    if (xmlData) {
        value = xmlData.children[seriesIndexValue]?.getAttribute("value")?.split(",")[seriesItemIndexValue];

        let displayValueFormat = xmlData.getAttribute("valueformat") ? xmlData.getAttribute("valueformat") : "asentered";

        if (displayValueFormat == "asentered") {
            value = xmlData.children[seriesIndexValue]?.getAttribute("asenteredvalue")?.split("^")[seriesItemIndexValue];
        }
    }

    return value;
};

/**
 * Get font list for chart
 * @param {HTMLElement} xmldata - XML chart data
 * @returns {Object} Font JSON object
 */
ChartUtils.prototype.getFonList = function (xmldata) {
    let seriesLength = xmldata.children.length;
    let strAssetName = "";

    // if (seriesLength < 6) {
    //     strAssetName = "mininode";
    // }
    // if (seriesLength > 12) {
    //     strAssetName = "maxnode";
    // }

    let fontJSON = "";

    if (strAssetName && typeof window !== "undefined" && window.PresetThemeHelper) {
        fontJSON = window.PresetThemeHelper.getFontClassName("chart", strAssetName);
    } else if (typeof window !== "undefined" && window.PresetThemeHelper) {
        fontJSON = window.PresetThemeHelper.getFontClassName("chart");
    }

    return fontJSON;
};

/**
 * Check tooltip max height and set line clamp
 * @param {HTMLElement} toolTipChild - Tooltip child element
 * @param {HTMLElement} tooltip - Tooltip element
 */
ChartUtils.prototype.checkToolTipMaxHeight = function (toolTipChild, tooltip) {
    let height = tooltip.offsetHeight;
    let MaxHeight = window.getComputedStyle(toolTipChild.parentNode).maxHeight;
    MaxHeight = parseFloat(MaxHeight || 0);

    let lineHeight = parseFloat(window.getComputedStyle(toolTipChild).lineHeight);
    let maxLineCount = Math.floor(height / lineHeight);
    let maxHeight = maxLineCount * lineHeight;

    if (MaxHeight > 0) {
        let lineCount = Math.floor(MaxHeight / lineHeight);
        toolTipChild.style.setProperty("-webkit-line-clamp", lineCount.toString());
    }

    toolTipChild.style.height = maxHeight + "px";
};

/**
 * Position tooltip relative to mouse cursor
 * @param {Event} event - Mouse event
 * @param {HTMLElement} tooltip - Tooltip element
 * @param {HTMLElement} container - Container element
 * @param {string} position - Position mode ("auto", "left", "right")
 * @param {number} offset - Horizontal offset
 * @param {HTMLElement} slide - Slide element
 * @param {HTMLElement} scaledParent - Scaled parent element
 * @param {string} verticalPosition - Vertical position ("top", "center", "bottom")
 * @param {number} verticalOffset - Vertical offset
 * @returns {string} Final position
 */
ChartUtils.prototype.positionTooltip = function (event, tooltip, container, position = "auto", offset = 15, slide, scaledParent, verticalPosition = "bottom", verticalOffset = 10) {
    if (!event || !tooltip || !container) return position;

    // Try to get values from AppStore first
    let appStore = this.getAppStore();
    let nodeSlideContentRect = null;
    let transFormValue = null;
    let scale = 1;
    let useAppStoreValues = false;

    if (appStore) {
        let state = appStore.getState();
        nodeSlideContentRect = state?.nodeSlideContentRect;
        transFormValue = state?.transFormValue;

        // If we have AppStore values, use them
        if (nodeSlideContentRect && transFormValue) {
            useAppStoreValues = true;
            // Extract scale from transFormValue
            if (transFormValue && transFormValue !== "none") {
                if (transFormValue.startsWith("matrix")) {
                    // Matrix format: matrix(scaleX, 0, 0, scaleY, translateX, translateY)
                    let match = transFormValue.match(/matrix.*\((.+)\)/);
                    if (match) {
                        scale = parseFloat(match[1].split(", ")[0]);
                    }
                } else if (transFormValue.startsWith("scale")) {
                    // Scale format: scale(x) or scale(x, y)
                    let match = transFormValue.match(/scale\((.+)\)/);
                    if (match) {
                        scale = parseFloat(match[1].split(", ")[0]);
                    }
                }
            }
        }
    }

    // Fallback to scaledParent concept if AppStore values are not available
    if (!useAppStoreValues) {
        let referenceParent = scaledParent || container;

        if (referenceParent) {
            const transform = window.getComputedStyle(referenceParent).transform;

            // Extract scale value from transform
            if (transform && transform !== "none") {
                if (transform.startsWith("matrix")) {
                    // Matrix format: matrix(scaleX, 0, 0, scaleY, translateX, translateY)
                    let match = transform.match(/matrix.*\((.+)\)/);
                    if (match) {
                        scale = parseFloat(match[1].split(", ")[0]);
                    }
                } else if (transform.startsWith("scale")) {
                    // Scale format: scale(x) or scale(x, y)
                    let match = transform.match(/scale\((.+)\)/);
                    if (match) {
                        scale = parseFloat(match[1].split(", ")[0]);
                    }
                }
            }
        }
    }

    // Get element positions and dimensions
    const containerRect = container.getBoundingClientRect();
    const tooltipRect = tooltip.getBoundingClientRect();

    // Calculate mouse position within container
    let mouseX, mouseY;

    if (useAppStoreValues && nodeSlideContentRect) {
        // Use AppStore values for positioning
        mouseX = (event.clientX - nodeSlideContentRect.left) / scale - (containerRect.left - nodeSlideContentRect.left) / scale;
        mouseY = (event.clientY - nodeSlideContentRect.top) / scale - (containerRect.top - nodeSlideContentRect.top) / scale;
    } else if (scaledParent) {
        // Fallback: Use scaledParent for reference
        const parentRect = scaledParent.getBoundingClientRect();
        // Calculate mouse position within container, accounting for parent scale
        mouseX = (event.clientX - parentRect.left) / scale - (containerRect.left - parentRect.left) / scale;
        mouseY = (event.clientY - parentRect.top) / scale - (containerRect.top - parentRect.top) / scale;
    } else {
        // Use container directly when neither AppStore values nor scaledParent is available
        mouseX = event.clientX - containerRect.left;
        mouseY = event.clientY - containerRect.top;
    }

    // Get dimensions (account for scale if we have AppStore values or scaledParent)
    const hasScale = useAppStoreValues || scaledParent;
    const containerWidth = hasScale ? containerRect.width / scale : containerRect.width;
    const tooltipWidth = hasScale ? tooltipRect.width / scale : tooltipRect.width;
    const tooltipHeight = hasScale ? tooltipRect.height / scale : tooltipRect.height;

    // Determine which side to place the tooltip
    let finalPosition = position;

    if (position === "auto") {
        // In auto mode, check if there's enough space to the right
        const spaceRight = containerWidth - mouseX;

        if (spaceRight >= tooltipWidth + offset) {
            finalPosition = "right";
        } else {
            finalPosition = "left";
        }
    }

    // left
    tooltip.style.left = mouseX - tooltipWidth / 2 + "px";

    let tooltipLeft = mouseX + tooltipWidth / 2;

    if (tooltipLeft > tooltip?.parentNode?.offsetWidth) {
        tooltip.style.left = mouseX - tooltipWidth - verticalOffset + "px";
        verticalPosition = "center";
    } else if (mouseX - tooltipWidth / 2 < 0) {
        tooltip.style.left = mouseX + verticalOffset + "px";
        verticalPosition = "center";
    }

    // Remove any transform that might interfere with positioning
    tooltip.style.transform = "none";

    // Position tooltip vertically based on verticalPosition parameter
    switch (verticalPosition) {
        case "top":
            // Align tooltip top edge with cursor
            tooltip.style.top = mouseY + verticalOffset + "px";
            break;
        case "center":
            // Center tooltip vertically with cursor (original behavior)
            tooltip.style.top = mouseY - tooltipHeight / 2 + "px";
            break;
        case "bottom":
            // Align tooltip bottom edge with cursor
            tooltip.style.top = mouseY - tooltipHeight - verticalOffset + "px";
            break;
        default:
            // Default to top alignment
            tooltip.style.top = mouseY + verticalOffset + "px";
    }

    // Ensure tooltip stays within container bounds
    // Check left edge
    if (parseFloat(tooltip.style.left) < 0) {
        tooltip.style.left = "0px";
    }

    // Check top edge
    if (parseFloat(tooltip.style.top) < 0) {
        tooltip.style.top = mouseY + verticalOffset + "px";
    }

    // Check bottom edge
    const containerHeight = hasScale ? containerRect.height / scale : containerRect.height;
    const bottomEdge = parseFloat(tooltip.style.top) + tooltipHeight;

    if (bottomEdge > containerHeight) {
        tooltip.style.top = containerHeight - tooltipHeight + "px";
    }

    return finalPosition;
};

/**
 * Reset chart tooltip visibility
 * @param {HTMLElement} slideParent - Slide parent element
 */
ChartUtils.prototype.resetChartTooltip = function (slideParent) {
    if (!slideParent) return;

    let arrTooltip = slideParent.querySelectorAll(".chart-tooltip");

    if (arrTooltip) {
        arrTooltip.forEach((element) => {
            element.style.visibility = "hidden";
            element.style.opacity = "0";
        });
    }
};

