            let textselectedIndex = this.getSelectedIndex(textSize["dpsource"], fontSize, 0);
            textSize["selectedindex"] = textselectedIndex;
            textOpacityValue = metaData.getAttribute("valuetexttextopacity") ? metaData.getAttribute("valuetexttextopacity") : 1;
            fontListing["dpsource"] = dpTitleFontSize;
            fontListing["selectedindex"] = selectedIndex;
            fontListing["elementvalue"] = "valuetextdynamicalign";
            textSize["elementvalue"] = "valuetextdynamicalign";
            textBold["elementvalue"] = "valuetextdynamicalign";
            textItalic["elementvalue"] = "valuetextdynamicalign";
            textopacity["elementvalue"] = "valuetextdynamicalign";
