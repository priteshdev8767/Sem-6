ChartBuilder.prototype.enablePlaceholder = function () {
    let slide = menuDetails.slideobj && menuDetails.slideobj.content ? menuDetails.slideobj.content : document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let BooldPlaceHolder = this.xmlData.getAttribute("primaryplaceholder");
    if (BooldPlaceHolder) {
        this.xmlData.removeAttribute("primaryplaceholder");

        for (let k1 = 0; k1 < this.xmlData.children.length; k1++) {
            this.xmlData.children[k1].removeAttribute("placeholder");
            this.xmlData.children[k1].removeAttribute("primaryPlaceholderPath");
            this.xmlData.children[k1].removeAttribute("placeholdertype");
        }
    } else {
        this.xmlData.setAttribute("primaryplaceholder", true);
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue, "", true);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};

ChartBuilder.prototype.doEnableBaseLine = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    let BooldPlaceHolder = this.xmlData.getAttribute("data-baseline") == "true";
    if (BooldPlaceHolder) {
        this.xmlData.removeAttribute("data-baseline");
    } else {
        this.xmlData.setAttribute("data-baseline", true);
        this.xmlData.setAttribute("data-baslinestyle", "simplebaseline"), (calloutType = "horizontal");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.doEnableHighlightDiff = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    let length = this.xmlData.children.length;
    let boolEnableHighlight = this.xmlData.getAttribute("data-highlightdifference");
    if (!boolEnableHighlight) {
        this.xmlData.setAttribute("data-highlightdifference", "true");
        this.xmlData.setAttribute("data-highlight-value", "first,last");
        this.xmlData.setAttribute("highlightdifferencepoint1", 0 + "," + length - 1);
    } else {
        this.xmlData.removeAttribute("data-highlightdifference");
        this.xmlData.removeAttribute("data-highlight-value");
        this.xmlData.removeAttribute("highlightdifferencepoint1");
        this.xmlData.removeAttribute("highlightdifferencepoint2");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.createChart = function (slideId, slideData, menuData, divParent, callback, commonData = {}) {
    let chartXmlGenerator = new window["ChartXmlGenerator"]();
    let oldSlideData = JSON.parse(JSON.stringify(slideData || this.ChartUtils.getChartDefaultDataBasedOnCount(menuData?.template?.nodecount?.default)));
    let slideDatas = {
        menu: menuData,
        content: slideData?.data || this.ChartUtils.getChartDefaultDataBasedOnCount(menuData?.template?.nodecount?.default).data,
        type: slideData?.type || "",
    };
    let objData = chartXmlGenerator.createOutlineChart(slideId, slideDatas, false, null, { graphicDiv: divParent });
    let objProcessData = {
        chartData: objData?.xmlData,
        menu: menuData,
        graphicDiv: divParent,
        oldSlideData: oldSlideData,
    };
    let instanceDetails = {
        fontsData: commonData?.fontDetails,
        appStore: commonData?.appStore,
        moodData: commonData?.moodsData,
        isTempSlide: commonData?.isTempSlide,
        serverUrl: commonData?.staticServerURL,
    };

    // Store data for future chart recreation
    // Generate and set unique chart ID on graphic div if not already set
    let chartId = divParent ? this.ChartUtils.getOrCreateChartId(divParent) : null;
    // Use data-chart-id first, fallback to data-graphic-index for backward compatibility
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    if (graphicIndex) {
        storeMenuData(menuData, graphicIndex);
    } else {
        storeMenuData(menuData); // Fallback for backward compatibility
    }
    storeFontData(commonData?.fontDetails);
    storeGraphicDiv(divParent);
    storeIsTempSlide(slideId, commonData?.isTempSlide);
    storeCommonData(commonData);
    // Note: moodData will be stored in buildAsset method when available
    this.slideID = slideId;
    this.chartName = objProcessData.menu ? objProcessData.menu.classname : objProcessData.chartData.getAttribute("data-classname") ? objProcessData.chartData.getAttribute("data-classname") : objProcessData.chartData.getAttribute("name");
    let chartAsset = this.CssChartAssetManager.getChartAssetList({ slideID: slideId, elementID: "", chartName: this.chartName }, objData?.xmlData, menuData, commonData?.moodData);
    if (chartAsset?.arrAssets?.length > 0) {
        this.chartAssetLoader.loadAssets(divParent, chartAsset?.arrAssets, commonData?.staticServerURL || "./").then(() => {
            objProcessData.assets = chartAsset?.arrAssets;
            divParent = this.buildAsset(objProcessData, divParent, instanceDetails);
            let objProperties = {};
            let outlineData = this.ChartUtils.generateAllProperties(divParent, objProperties, menuData);
            outlineData["slideid"] = slideId;

            // Store outlineData for future chart recreation
            let chartId = divParent ? this.ChartUtils.getOrCreateChartId(divParent) : null;
            let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
            if (graphicIndex) {
                storeOutlineData(outlineData, graphicIndex);
            } else {
                storeOutlineData(outlineData); // Fallback for backward compatibility
            }
            if (callback) {
                let object = {
                    slideData: outlineData,
                    element: divParent,
                };
                callback(object);
            }
        });
    } else {
        divParent = this.buildAsset(objProcessData, divParent, instanceDetails);
        let objProperties = {};
        let outlineData = this.ChartUtils.generateAllProperties(divParent, objProperties, menuData);
        outlineData["slideid"] = slideId;

        // Store outlineData for future chart recreation
        let chartId = divParent ? this.ChartUtils.getOrCreateChartId(divParent) : null;
        let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
        if (graphicIndex) {
            storeOutlineData(outlineData, graphicIndex);
        } else {
            storeOutlineData(outlineData); // Fallback for backward compatibility
        }
        if (callback) {
            let object = {
                slideData: outlineData,
                element: divParent,
            };
            callback(object);
        }
    }

    // return { slideData: oldSlideData };
};

ChartBuilder.prototype.chartRecreate = function (slideId, xmlData, menuData, divParent, callback) {
    this.ChartFonts = new window["ChartFonts"]();
    this.CssChartAssetManager = new window["CssChartAssetManager"]();
    this.chartAssetLoader = new window["ChartAssetLoader"]();
    // Get stored data from data store
    let chartId = divParent ? this.ChartUtils.getOrCreateChartId(divParent) : null;
    let graphicIndex = chartId || divParent?.getAttribute("data-graphic-index");
    let finalMenuData = menuData || (graphicIndex ? getMenuData(graphicIndex) : getMenuData());
    let finalFontData = getFontData() || {};
    let finalMoodData = getMoodData() || {};
    let finalGraphicDiv = divParent || getGraphicDiv();
    let finalIsTempSlide = getIsTempSlide(slideId) || false;
    let finalCommonData = getCommonData() || {};
    this.slideID = slideId;
    let objProcessData = {
        chartData: xmlData,
        menu: finalMenuData,
        graphicDiv: finalGraphicDiv,
        slideid: slideId,
    };

    let instanceDetails = {
        fontsData: finalFontData,
        moodData: finalMoodData,
        isTempSlide: finalIsTempSlide,
        appStore: finalCommonData?.appStore,
        serverUrl: finalCommonData?.staticServerURL,
    };
    this.chartName = objProcessData.menu ? objProcessData.menu.classname : objProcessData.chartData.getAttribute("data-classname") ? objProcessData.chartData.getAttribute("data-classname") : objProcessData.chartData.getAttribute("name");
    let chartAsset = this.CssChartAssetManager.getChartAssetList({ slideID: slideId, elementID: "", chartName: this.chartName }, xmlData, finalMenuData, finalMoodData);
    this.chartAssetLoader.loadAssets(finalGraphicDiv, chartAsset?.arrAssets, finalCommonData?.staticServerURL || "./").then(() => {
        objProcessData.assets = chartAsset?.arrAssets;
        divParent = this.buildAsset(objProcessData, finalGraphicDiv, instanceDetails);
        let objProperties = {};
        let outlineData = this.ChartUtils.generateAllProperties(divParent, objProperties, finalMenuData);
        outlineData["slideid"] = slideId;

        // Store outlineData for future chart recreation
        // Use the graphic div to get chart ID, not divParent (which is ELEMENT_DIV)
        let chartIdForStore = finalGraphicDiv ? this.ChartUtils.getOrCreateChartId(finalGraphicDiv) : chartId;
        let graphicIndexForStore = chartIdForStore || graphicIndex;
        if (graphicIndexForStore) {
            storeOutlineData(outlineData, graphicIndexForStore);
        } else {
            storeOutlineData(outlineData); // Fallback for backward compatibility
        }

        if (callback) {
            let object = {
                slideData: outlineData,
                element: divParent,
            };
            callback(object);
        }
    });
};

function ChartDataGenerator() {
    this.chartUtils = new window["ChartUtils"]();
    this.chartHelper = new window["ChartHelper"]();
}

ChartDataGenerator.prototype.createOutlineChart = function (strSlideId, objPropData, boolOperation = false, creationCompleteCallBack, callBackParam) {
    let xmlData = this.outlineChartData(objPropData, true);
    let objctBaseDetails = {};
    xmlData.setAttribute("searchcount", 0);
    objctBaseDetails["strSlideId"] = strSlideId;
    objctBaseDetails["objPropData"] = objPropData;
    objctBaseDetails["boolOperation"] = boolOperation;
    objctBaseDetails["creationCompleteCallBack"] = creationCompleteCallBack;
    objctBaseDetails["callBackParam"] = callBackParam;
    objctBaseDetails["xmlData"] = xmlData;
    if (callBackParam?.graphicDiv) {
        objctBaseDetails["graphicDiv"] = callBackParam.graphicDiv;
    }
    return objctBaseDetails;
};
ChartDataGenerator.prototype.outlineChartData = function (objPropData, bool = false) {
    try {
        let xmlChildNode;
        let arrLabel = [];
        let textProperties = [];
        let compareLabel = [];
        let arrprefix = [];
        let arrsuffix = [];
        let arrvaluesuffix = [];
        let arrcurrencysymbol = [];
        let strValue = "";
        let strPrefix = "";
        let strSuffix = "";
        let hasPrefix = false;
        let hasSuffix = false;
        let enableProjection = false;

        let strChartName = objPropData.name ? objPropData.name : objPropData.content && objPropData.content.properties ? objPropData.content.properties.name : "";
        if (objPropData && objPropData.menu && objPropData.menu.classname) {
            strChartName = objPropData.menu.classname;
        }
        let strPrimaryChartName = strChartName == "comparisonModel" || strChartName == "combinationModel" || strChartName == "comparisonModelType2" || strChartName == "barcomparisonmodel" ? this.comparisonModelPrimaryData(strChartName) : objPropData.primaryName;
        let strSecondaryChartName = strChartName == "comparisonModel" || strChartName == "combinationModel" || strChartName == "comparisonModelType2" || strChartName == "barcomparisonmodel" ? this.comparisonModelSecondaryData(strChartName) : objPropData.secondaryName;
        let xmlBeginNode = "<metadata class='chartbase'>";
        let xmlEndNode = "</metadata>";
        let matrixData = objPropData.operation == "paste" ? objPropData.content : objPropData.content.matrix;
        let booHeader = matrixData[0].header ? true : false;
        let length = matrixData.length;
        let currentAssetName = objPropData.menu && objPropData.menu.name ? objPropData.menu.name : null; //&&objPropData.menu.chartlayout&&objPropData.menu.chartlayout.item&&objPropData.menu.chartlayout.item.asset?objPropData.menu.chartlayout.item.asset:null;
        let oldAssetName = objPropData.properties && objPropData.properties.graphicname ? objPropData.properties.graphicname : null;
        bool = bool && currentAssetName == oldAssetName ? true : false;
        let index1 = booHeader ? 1 : 0;
        var domParser = new DOMParser();
        let boolType = false;
        let itemType;
        let assetText = "";
        let assetTextUpdate = false;
        let arrNeedAssetUpdate = [];
        let arrItemAssetSearchTex = [];
        let alterType = null;
        let itemValue;
        let cellType;
        let arrItemList = [];
        let arrPlaceholder = [];
        let arrLabelTextProps = [];
        let arrSecondaryText = objPropData && objPropData.content && objPropData.content.secondaryText ? objPropData.content.secondaryText : [];
        let labelTextColor = objPropData && objPropData.content && objPropData.content.labeltextcolor ? objPropData.content.labeltextcolor : [];
        let secondaryLabelTextColor = objPropData && objPropData.content && objPropData.content.secondarylabeltextcolor ? objPropData.content.secondarylabeltextcolor : [];
        let valueTextColor = objPropData && objPropData.content && objPropData.content.valuetextcolor ? objPropData.content.valuetextcolor : [];
        let arraylogocontrast = objPropData && objPropData.content && objPropData.content.logocontrast ? objPropData.content.logocontrast : [];
        let arrPromptText = objPropData && objPropData.content && objPropData.content.prompttext ? objPropData.content.prompttext : [];
        let arrChartGroupDetails = objPropData && objPropData.content && objPropData.content.chartgroup ? objPropData.content.chartgroup : [];
        let arrLabelLineHeight = objPropData && objPropData.content && objPropData.content.labellineheight ? objPropData.content.labellineheight : [];
        let arrLabelLineLetterSpace = objPropData && objPropData.content && objPropData.content.labelletterspace ? objPropData.content.labelletterspace : [];
        let arrItemPlaceholder = [];
        let arrStackedSizeObject = [];
        let arrAsenterValue = [];
        let objAllElementValue = {
            label: [],
            value: [],
            primaryplaceholder: [],
            secondaryplaceholder: [],
        };
        let randomValues = (10 * Math.floor(Math.random() * (91 - 1 + 1) + 1)).toString();
        let boolaiType = !objPropData.properties || !objPropData.properties.name ? this.aiTypeValidator(matrixData, length) : true;
        for (let i1 = index1; i1 < length; i1++) {
            let value;
            let intVal;
            let index = 1;
            let multiIndex = 2;
            let placeholder;
            let secondaryvalue;
            let placeholderpath;
            let arrAsset = [];

            let objStackedSizeValue = this.checkStackedSizeValue(matrixData[i1], objPropData.menu);
            matrixData[i1] = objStackedSizeValue.modifiedArray;
            let stackedSizeObject = objStackedSizeValue.extractedObject;
            if (stackedSizeObject) arrStackedSizeObject.push(stackedSizeObject);
            let childXml = matrixData[i1].matrix;
            itemType = childXml[0] ? childXml[0].type || "text" : "text";
            alterType = childXml[0] ? childXml[0].altertype : "text";
            itemValue = childXml[0] ? childXml[0].value || "text" : "text";
            cellType = childXml[0] ? childXml[0].cellType || "text" : "text";
            assetText = childXml[0] ? childXml[0].assetText || "" : "";
            assetTextUpdate = childXml[0] ? childXml[0].assetTextUpdate : false;
            randomValues = (10 * Math.floor(Math.random() * (23 - 1 + 1) + 1)).toString();
            if (childXml[0] && childXml[0].needassetupdate) {
                arrNeedAssetUpdate.push(childXml[0].needassetupdate);
            } else {
                arrNeedAssetUpdate.push("");
            }
            if (childXml[0] && childXml[0].assetsearch) {
                arrItemAssetSearchTex.push(childXml[0].assetsearch);
            } else {
                arrItemAssetSearchTex.push("");
            }

            if (strPrimaryChartName && strSecondaryChartName) {
                let childLength = childXml.length <= 2 ? childXml.length + 1 : childXml.length;
                for (let j1 = 0; j1 < childLength - 2; j1++) {
                    //arrItemList[i1 + "-" + j1] = childXml[j1 + 1].value;
                    value = $.isNumeric(childXml[j1 + 1].value) ? childXml[j1 + 1].value.replace(/[^0-9.-]+/g, "") : initValue + initValue * (i1 * initPercentage);
                    secondaryvalue = childXml[j1 + 2] ? ($.isNumeric(childXml[j1 + 2].value) ? childXml[j1 + 2].value.replace(/[^0-9.-]+/g, "") : "25") : "25";
                    if (i1 == 0) xmlChildNode = "<metadata class= 'chartitem' index= '" + i1 + "' name = '" + childXml[j1].value + "'  value='" + value + "' secondaryvalue='" + secondaryvalue + "'/>";
                    else xmlChildNode += "<metadata class='chartitem' index= '" + i1 + "' name = '" + childXml[j1].value + "'  value='" + value + "' secondaryvalue='" + secondaryvalue + "'/>";
                    itemType != "text" ? arrLabel.push(childXml[1].value) : arrLabel.push(childXml[0].value);
                }
            } else {
                let placeholderIndex = booHeader ? i1 - 1 : i1;
                if (itemType != "text") {
                    index += 1;
                    multiIndex += 1;
                    boolType = true;
                    itemValue = itemValue == "genericassets/placeholderimages/auto_icon.png" ? "" : itemValue;
                    if (itemType == "icon") {
                        placeholder = itemValue?.split(".")[0];
                        arrAsset = placeholder.split("/");
                        placeholderpath = placeholder + ".svg";
                        placeholder = arrAsset[arrAsset.length - 1];
                        if (itemValue?.includes("https")) {
                            arrAsset = itemValue.split("/");
                            placeholder = arrAsset[arrAsset.length - 1]?.split(".svg")?.[0] || placeholder;
                            placeholderpath = itemValue;
                        }
                        arrPlaceholder[placeholderIndex] = {
                            assetTextUpdate: assetTextUpdate,
                            assetText: assetText,
                            placeholder: placeholder,
                            placeholdertype: itemType,
                            placeholderpath: placeholderpath,
                        };
                    } else if (itemType == "image") {
                        placeholderpath = itemValue;
                        arrPlaceholder[placeholderIndex] = {
                            assetTextUpdate: assetTextUpdate,
                            assetText: assetText,
                            placeholdertype: alterType ? alterType : itemType,
                            placeholderpath: placeholderpath,
                            width: childXml[0].dataRef ? childXml[0].dataRef.imageWidth : "",
                            height: childXml[0].dataRef ? childXml[0].dataRef.imageHeight : "",
                        };
                    } else {
                        arrPlaceholder[placeholderIndex] = {
                            placeholder: null,
                            placeholderpath: null,
                            placeholdertype: null,
                        };
                    }
                } else {
                    arrPlaceholder[placeholderIndex] = {
                        placeholder: null,
                        placeholderpath: null,
                        placeholdertype: null,
                    };
                }
                if (childXml.length == 1) {
                    childXml.push({ type: "text", value: randomValues });
                }
                if (childXml.length == 1) {
                    index = 0;
                }

                for (let k1 = 0; k1 < childXml.length - index; k1++) {
                    let keyIndex = booHeader ? i1 - 1 : i1;
                    randomValues = (10 * Math.floor(Math.random() * (13 - 1 + 1) + 1)).toString();

                    if (childXml.length > multiIndex) {
                        intVal = boolType ? k1 + 1 : k1;
                        for (let l1 = 0; l1 < childXml.length - index; l1++) {
                            randomValues = (10 * Math.floor(Math.random() * (45 - 1 + 1) + 1)).toString();
                            if (strChartName == "comparisonModelType3" || strChartName == "SimpleStackedCompareBarChart") {
                                if (l1 == 1) {
                                    if (strChartName == "comparisonModelType3" && childXml[intVal + l1 + 1] && childXml[intVal + l1 + 1].data && childXml[intVal + l1 + 1].data.id && childXml[intVal + l1 + 1].data.id.includes("comparelabel")) {
                                        strValue = childXml[intVal + l1 + 1].value;
                                    } else {
                                        if (strChartName == "comparisonModelType3") {
                                            strValue = "";
                                        } else {
                                            strValue = childXml[intVal + l1 + 1].value;
                                        }
                                    }
                                    compareLabel.push(strValue);
                                } else {
                                    strValue = childXml[intVal + l1 + 1].value;
                                    if (!strValue) {
                                        strValue = randomValues;
                                    }
                                    arrItemList.push({
                                        key: keyIndex + "-" + k1,
                                        input: strValue.toString(),
                                    });

                                    if (strValue == "") strValue = randomValues;
                                    hasPrefix = RegExConstants.CURRENCY_START.test(strValue);
                                    hasSuffix = RegExConstants.CURRENCY_END.test(strValue);
                                    if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                                    if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                                    k1++;
                                }
                            } else {
                                if (childXml[intVal + l1 + 1]) {
                                    strValue = childXml[intVal + l1 + 1].value;
                                    let hasStatistical = childXml[intVal + l1 + 1].statistical;
                                    if (!strValue) {
                                        strValue = randomValues;
                                    } else {
                                        let showdefaultValue = true;
                                        let tempValue = strValue.toString().split(",");
                                        if (isNaN(parseFloat(tempValue[0]))) {
                                            tempValue[0] = tempValue[0].includes(",") ? parseFloat(tempValue.replace(/,/g, "")) : tempValue[0];
                                            let matches = tempValue[0].match(/(\d+)/);
                                            if (matches && !isNaN(parseFloat(matches))) {
                                                showdefaultValue = false;
                                            }
                                        }
                                        if (tempValue.length > 0 && isNaN(parseFloat(tempValue[0])) && showdefaultValue) {
                                            strValue = randomValues;
                                        }
                                    }
                                    // if (!hasStatistical) {
                                    arrItemList.push({
                                        key: keyIndex + "-" + k1,
                                        input: strValue.toString(),
                                    });
                                    //}
                                    if (strValue == "") strValue = randomValues;
                                    hasPrefix = RegExConstants.CURRENCY_START.test(strValue);
                                    hasSuffix = RegExConstants.CURRENCY_END.test(strValue);
                                    if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                                    if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                                    k1++;
                                }
                            }
                        }
                    } else {
                        intVal = boolType ? k1 + 1 : childXml.length == 1 ? k1 - childXml.length : k1;
                        strValue = childXml[intVal + 1].value;
                        randomValues = (10 * Math.floor(Math.random() * (18 - 1 + 1) + 1)).toString();

                        if (!strValue) {
                            strValue = randomValues;
                        } else {
                            let showdefaultValue = true;
                            let tempValue = strValue.toString().split(",");
                            if (isNaN(parseFloat(tempValue[0]))) {
                                tempValue[0] = tempValue[0].includes(",") ? parseFloat(tempValue.replace(/,/g, "")) : tempValue[0];
                                let matches = tempValue[0].match(/(\d+)/);
                                if (matches && !isNaN(parseFloat(matches))) {
                                    showdefaultValue = false;
                                }
                            }
                            if (tempValue.length > 0 && isNaN(parseFloat(tempValue[0])) && showdefaultValue) {
                                strValue = randomValues;
                            }
                        }
                        arrItemList.push({
                            key: keyIndex + "-" + k1,
                            input: strValue.toString(),
                        });
                        hasPrefix = RegExConstants.CURRENCY_START.test(strValue);
                        hasSuffix = RegExConstants.CURRENCY_END.test(strValue);
                        if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                        if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                    }
                    if (childXml.length == 1) arrLabel.push("");
                    else if (childXml[intVal].value) arrLabel.push(childXml[intVal].value);
                    else arrLabel.push("");
                    childXml[intVal] && childXml[intVal].textProperties ? arrLabelTextProps.push(childXml[intVal].textProperties) : arrLabelTextProps.push("");
                }
            }
        }

        if (arrItemList.length > 0) {
            arrItemList = this.chartUtils.formatChartValues(arrItemList);
            const itemlength = arrItemList.length;
            const arrItemCell = [];
            if (0 < itemlength) {
                let seriesLength = 0;
                let seriesItemLength = 0;
                for (let k2 = 0; k2 < itemlength; k2++) {
                    const nodeKey = arrItemList[k2].key.split("-");
                    const seriesIndex = parseInt(nodeKey[0]);
                    const seriesItemIndex = parseInt(nodeKey[1]);
                    arrItemCell[arrItemList[k2].key] = arrItemList[k2];
                    seriesLength = seriesLength < seriesIndex + 1 ? seriesIndex + 1 : seriesLength;
                    seriesItemLength = seriesItemLength < seriesItemIndex + 1 ? seriesItemIndex + 1 : seriesItemLength;
                }
                let inputValue = randomValues;
                for (let k3 = 0; k3 < seriesLength; k3++) {
                    let value, prefix, suffix, valuesuffix, currencysymbol;
                    let item = "";
                    for (let k4 = 0; k4 < seriesItemLength; k4++) {
                        item = arrItemCell[k3 + "-" + k4];
                        if (item) {
                            const strsuffix = item.suffix == undefined ? "" : item.suffix;
                            const strprefix = item.prefix == undefined ? "" : item.prefix;
                            const strvaluesuffix = item.currencySystem == undefined ? "" : item.currencySystem;
                            const strcurrencysymbol = item.currencysymbol == undefined ? "" : item.currencysymbol;
                            let strAssetName = objPropData.content && objPropData.content.properties && objPropData.content.properties.name ? objPropData.content.properties.name : "";
                            if (item.input) {
                                item.input = item.input.replace(/\s/g, "");
                            }
                            let strvalue = item.currencyValueNormalized == "" || item.currencyValueNormalized == undefined ? (isNaN(parseInt(item.input)) ? initValue + initValue * (k4 * initPercentage) : item.input.match(/\d+/g)[0]) : item.currencyValueNormalized;
                            if (strAssetName == "waterfallchart" && item.input && item.input.toLowerCase() == "sum") {
                                strvalue = item.input.toLowerCase();
                            }
                            if (seriesItemLength == 1) {
                                value = strvalue;
                                suffix = strsuffix;
                                prefix = strprefix;
                                valuesuffix = strvaluesuffix;
                                currencysymbol = strcurrencysymbol;
                                if (item && item.input) {
                                    inputValue = item.input;
                                }
                            } else {
                                if (k4 == 0) {
                                    value = strvalue;
                                    suffix = strsuffix;
                                    prefix = strprefix;
                                    valuesuffix = strvaluesuffix;
                                    currencysymbol = strcurrencysymbol;
                                    if (item && item.input) {
                                        inputValue = item.input;
                                    }
                                } else {
                                    value += "," + strvalue;
                                    prefix += "," + strprefix;
                                    suffix += "," + strsuffix;
                                    valuesuffix += "," + strvaluesuffix;
                                    currencysymbol += "," + strcurrencysymbol;
                                    if (item && item.input) {
                                        inputValue += "^" + item.input;
                                    }
                                }
                            }
                        }
                    }
                    arrprefix.push(prefix);
                    arrsuffix.push(suffix);
                    arrvaluesuffix.push(valuesuffix);
                    arrcurrencysymbol.push(currencysymbol);
                    if (!value) {
                        value = randomValues;
                    }
                    xmlChildNode = this.addNodeItemInMatadata(xmlChildNode, k3, "", value, "", "", "", "", "");
                    if (objPropData?.content?.outlinetype == "responsivechart") {
                        arrAsenterValue.push(parseFloat(inputValue));
                    } else {
                        arrAsenterValue.push(inputValue);
                    }
                }
            }
        }

        if (xmlChildNode == undefined) {
            xmlChildNode = "<metadata class='chartitem' index='" + 0 + "' name='" + "" + "'  value='" + 25 + "'/>";
            arrLabel.push("");
        }

        let xmlCoreData = xmlBeginNode + xmlChildNode + xmlEndNode;
        this.xmlData = domParser.parseFromString(JSON.parse(JSON.stringify(xmlCoreData)), "text/xml").children[0];
        for (let a1 = 0; a1 < arrAsenterValue.length; a1++) {
            this.xmlData.children[a1].setAttribute("asenteredvalue", arrAsenterValue[a1]);
        }
        for (let a2 = 0; a2 < arrStackedSizeObject.length; a2++) {
            this.xmlData.children[a2].setAttribute("seriesitemwidth", arrStackedSizeObject[a2]?.value);
        }
        for (let l1 = 0; l1 < arraylogocontrast.length; l1++) {
            if (this.xmlData.children[l1] && arraylogocontrast[l1]) this.xmlData.children[l1].setAttribute("logocontrast", arraylogocontrast[l1]);
        }
        for (let l3 = 0; l3 < arrNeedAssetUpdate.length; l3++) {
            if (arrItemAssetSearchTex[l3]) this.xmlData.children[l3].setAttribute("assetsearchtext", arrItemAssetSearchTex[l3]);
            if (arrNeedAssetUpdate[l3]) this.xmlData.children[l3].setAttribute("needassetupdate", arrNeedAssetUpdate[l3]);
        }
        const itemlength = this.xmlData.children.length;
        arrPromptText = CssChartDataGenerator.checkPropmptText(this.xmlData, arrPromptText, objPropData.menu, arrAsenterValue, objPropData);
        for (let i2 = 0; i2 < itemlength; i2++) {
            this.xmlData.children[i2].setAttribute("name", arrLabel[i2]);
            this.setTextProperties(this.xmlData.children[i2], arrLabelTextProps[i2], "label");
            if (arrSecondaryText[i2]) this.xmlData.children[i2].setAttribute("secondaryName", arrSecondaryText[i2]);
            if (compareLabel.length >= 1 && compareLabel[i2]) {
                this.xmlData.children[i2].setAttribute("comparisonname", compareLabel[i2]);
            }
            if (arrPromptText[i2]) this.xmlData.children[i2].setAttribute("prompttext", arrPromptText[i2]);
            if (labelTextColor[i2]) this.xmlData.children[i2].setAttribute("labeltextcolor", labelTextColor[i2]);
            if (arrChartGroupDetails[i2]) {
                if (arrChartGroupDetails[i2]?.chartgroup == "true") {
                    for (let key in arrChartGroupDetails[i2]) {
                        this.xmlData.children[i2].setAttribute(key, arrChartGroupDetails[i2][key]);
                    }
                }
            }
            if (secondaryLabelTextColor[i2]) this.xmlData.children[i2].setAttribute("secondarylabeltextcolor", secondaryLabelTextColor[i2]);
            if (valueTextColor[i2]) {
                for (let v1 = 0; v1 < valueTextColor[i2].length; v1++) {
                    let arrValueDetails = valueTextColor[i2][v1];
                    for (let key in arrValueDetails) {
                        this.xmlData.children[i2].setAttribute(key, arrValueDetails[key]);
                    }
                }
            }
            // if(arrLabelLineHeight[i2])this.xmlData.children[i2].setAttribute("labellineheight", arrLabelLineHeight[i2]);
            // if(arrLabelLineLetterSpace[i2])this.xmlData.children[i2].setAttribute("labelletterspace", arrLabelLineLetterSpace[i2]);
            if (!strPrimaryChartName && !strSecondaryChartName) {
                if (arrprefix[i2] != undefined) this.xmlData.children[i2].setAttribute("prefix", arrprefix[i2]);
                if (arrsuffix[i2] != undefined) this.xmlData.children[i2].setAttribute("suffix", arrsuffix[i2]);
                if (arrvaluesuffix[i2] != undefined) this.xmlData.children[i2].setAttribute("denomination", arrvaluesuffix[i2]);
                if (arrcurrencysymbol[i2] != undefined) this.xmlData.children[i2].setAttribute("currencysymbol", arrcurrencysymbol[i2]);
            }

            if (matrixData[i2]) {
                let hadSecondaryPlaceHolderProp = matrixData[i2].secondaryPlaceholderProperty;
                if (hadSecondaryPlaceHolderProp && hadSecondaryPlaceHolderProp != undefined) {
                    for (var property in matrixData[i2].secondaryPlaceholderProperty) {
                        this.xmlData.setAttribute("secondarytext", "true");
                        this.xmlData.setAttribute("secondaryplaceholder", "text");
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].secondaryPlaceholderProperty[property]);
                    }
                }

                let hadhighlightProp = matrixData[i2].highlightProperty;
                if (hadhighlightProp && hadhighlightProp != undefined) {
                    for (var property in matrixData[i2].highlightProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].highlightProperty[property]);
                    }
                }
                let linkUrlProperty = matrixData[i2].linkUrlProperty;
                if (linkUrlProperty && linkUrlProperty != undefined) {
                    for (var property in matrixData[i2].linkUrlProperty) {
                        this.xmlData.children[i2].setAttribute("data-navigate-to-slide-on-click", linkUrlProperty);
                        this.xmlData.children[i2].setAttribute("link", "URL");
                    }
                }
                let hasProjectionProp = matrixData[i2].projectionProperty;
                if (hasProjectionProp && hasProjectionProp != undefined) {
                    for (var property in matrixData[i2].projectionProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].projectionProperty[property]);
                    }
                }
                let hadEmphasizeProp = matrixData[i2].emphasisProperty;
                if (hadEmphasizeProp && hadEmphasizeProp != undefined) {
                    for (var property in matrixData[i2].emphasisProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].emphasisProperty[property]);
                    }
                }
                let hasEmphasis = matrixData[i2]?.nodeproperties?.emphasize;
                if (hasEmphasis) {
                    hasCustomData = true;
                    this.xmlData.children[i2].setAttribute("emphasis", true);
                    objPropData.properties["emphasis"] = "true";
                    // this.xmlData.setAttribute("emphasis",true);
                }
                let projection = matrixData[i2]?.nodeproperties?.projection;
                if (projection) {
                    hasCustomData = true;
                    this.xmlData.children[i2].setAttribute("projection", true);
                    objPropData.properties["projection"] = "true";
                    // this.xmlData.setAttribute("emphasis",true);
                }
                let hadPrimaryPlaceholderProp = matrixData[i2].primaryPlaceholderProperty;
                if (hadPrimaryPlaceholderProp && hadPrimaryPlaceholderProp != undefined) {
                    for (var property in matrixData[i2].primaryPlaceholderProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].primaryPlaceholderProperty[property]);
                    }
                }
                let hadItemPlaceholderProp = matrixData[i2].itemPlaceholderProperty;
                if (hadItemPlaceholderProp && hadItemPlaceholderProp != undefined && bool) {
                    for (var property in matrixData[i2].itemPlaceholderProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].itemPlaceholderProperty[property]);
                    }
                }
                let hadItemImagePlaceholderProp = matrixData[i2].itemImagePlaceholderProperty;
                if (hadItemImagePlaceholderProp && hadItemImagePlaceholderProp != undefined && bool) {
                    for (var property in matrixData[i2].itemImagePlaceholderProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].itemImagePlaceholderProperty[property]);
                    }
                }

                let hadGraphicImageProp = matrixData[i2].graphicImageProperty;
                if (hadGraphicImageProp && hadGraphicImageProp != undefined) {
                    for (var property in matrixData[i2].graphicImageProperty) {
                        this.xmlData.children[i2].setAttribute(property, matrixData[i2].graphicImageProperty[property]);
                    }
                }
            }

            if (arrPlaceholder.length > 0) {
                if (arrPlaceholder[i2].placeholder != null || arrPlaceholder[i2].placeholderpath != null) {
                    this.xmlData.setAttribute("primaryplaceholder", "true");
                    if (arrPlaceholder[i2].placeholder) this.xmlData.children[i2].setAttribute("placeholder", arrPlaceholder[i2].placeholder);
                    this.xmlData.children[i2].setAttribute("placeholderpath", arrPlaceholder[i2].placeholderpath);
                    this.xmlData.children[i2].setAttribute("placeholdertype", arrPlaceholder[i2].placeholdertype);
                    if (arrPlaceholder[i2].placeholdertype == "image" || arrPlaceholder[i2].placeholdertype == "logo") {
                        this.xmlData.children[i2].setAttribute("placeholder", arrPlaceholder[i2].placeholderpath);
                    }
                    if (arrPlaceholder[i2].placeholdertype == "image" && arrPlaceholder[i2].width && arrPlaceholder[i2].height) {
                        this.xmlData.children[i2].setAttribute("data-imagewidth", arrPlaceholder[i2].width);
                        this.xmlData.children[i2].setAttribute("data-imageheight", arrPlaceholder[i2].height);
                    }
                    if (arrPlaceholder[i2].assetTextUpdate) {
                        if (arrPlaceholder[i2].assetTextUpdate) this.xmlData.children[i2].setAttribute("assettextupdate", arrPlaceholder[i2].assetTextUpdate);
                    } else {
                        this.xmlData.children[i2].removeAttribute("assettextupdate");
                    }
                    if (arrPlaceholder[i2].assetText) this.xmlData.children[i2].setAttribute("assettext", arrPlaceholder[i2].assetText);
                }
            }
            // if (matrixData[i2]&&matrixData[i2].itemPlaceholderProperty) {
            //     let itemPlaceHolder = matrixData[i2].itemPlaceholderProperty.itemplaceholder;
            //     let itemplaceholderPath = matrixData[i2].itemPlaceholderProperty.itemplaceholderpath;
            //     let iconGroup = this.xmlData.getAttribute("data-icon");

            //     if(itemPlaceHolder&&itemplaceholderPath){
            //         this.xmlData.children[i2].setAttribute("itemplaceholderpath",itemplaceholderPath)
            //         this.xmlData.children[i2].setAttribute("itemplaceholder",itemPlaceHolder)
            //     }
            // }
        }
        let oldChartName = objPropData?.properties?.graphicname;
        let newChartName = objPropData?.menu?.name;
        if (objPropData.content.textproperty) {
            let textProperty = objPropData.content.textproperty;
            for (let key in textProperty) {
                if (textProperty[key].length > 0) {
                    for (let i = 0; i < this.xmlData.children.length; i++) {
                        if (textProperty[key][i]) this.xmlData.children[i].setAttribute(key, textProperty[key][i]);
                    }
                }
            }
        }
        if (strPrimaryChartName && strSecondaryChartName) {
            this.xmlData.setAttribute("primarychart", strPrimaryChartName);
            this.xmlData.setAttribute("secondarychart", strSecondaryChartName);
        }
        if (strPrefix != "") this.xmlData.setAttribute("prefixtype", strPrefix);
        if (strSuffix != "") {
            strSuffix = strSuffix.substring(0, 4);
            this.xmlData.setAttribute("suffixlabel", strSuffix);
        }
        if (objPropData.properties && objPropData.properties.customdata) {
            hasCustomData = true;
            // this.resetOutlineCustomProps(this.xmlData, objPropData.properties);
            delete objPropData.properties.customdata;
        }
        for (var property in objPropData.properties) {
            this.xmlData.setAttribute(property, objPropData.properties[property]);
        }
        if (objPropData.header && objPropData.header.length > 0) {
            if (objPropData.header[0]) {
                if (objPropData.header[0].value) this.xmlData.setAttribute("showxaxistitle", "true");
                this.xmlData.setAttribute("xaxistitle", objPropData.header[0].value);
            }
        }
        if (objPropData.header && objPropData.header.length > 1) {
            if (objPropData.header[1]) {
                if (objPropData.header[1].value) this.xmlData.setAttribute("showyaxistitle", "true");
                this.xmlData.setAttribute("yaxistitle", objPropData.header[1].value);
            }
        }
        if (objPropData.operation == "redraw") {
            for (var property in objPropData.content.properties) {
                this.xmlData.setAttribute(property, objPropData.content.properties[property]);
            }
        }
        this.updateAiDataProperties(this.xmlData, objPropData);
        if (objPropData.content.charttitletext && objPropData.content.charttitletext.textproperties) {
            for (var property in objPropData.content.charttitletext.textproperties) {
                switch (property) {
                    case "lineheight":
                        this.xmlData.setAttribute("chartTitletextlineheight", objPropData.content.charttitletext.textproperties[property]);
                        break;
                    case "textalignment":
                        this.xmlData.setAttribute("charttitlealign", CssChartUtils.changeAlignment(objPropData.content.charttitletext.textproperties[property], "titletext"));
                        break;
                    case "letterspacing":
                        this.xmlData.setAttribute("chartTitletextletterspace", objPropData.content.charttitletext.textproperties[property]);
                        break;
                    case "fontsize":
                        this.xmlData.setAttribute("data-titlefontclass", objPropData.content.charttitletext.textproperties[property]);
                        break;
                }
            }
        }
        if (objPropData.content.sourcetext && objPropData.content.sourcetext.textproperties) {
            for (var property in objPropData.content.sourcetext.textproperties) {
                switch (property) {
                    case "lineheight":
                        this.xmlData.setAttribute("sourcetextlineheight", objPropData.content.sourcetext.textproperties[property]);
                        break;
                    case "textalignment":
                        this.xmlData.setAttribute("sourcetextalign", CssChartUtils.changeAlignment(objPropData.content.sourcetext.textproperties[property], "sourcetext"));
                        break;
                    case "letterspacing":
                        this.xmlData.setAttribute("sourcetextletterspace", objPropData.content.sourcetext.textproperties[property]);
                        break;
                }
            }
        }
        if (objPropData.content.projectiontext && objPropData.content.projectiontext.textproperties) {
            for (var property in objPropData.content.projectiontext.textproperties) {
                switch (property) {
                    case "lineheight":
                        this.xmlData.setAttribute("projectiontextlineheight", objPropData.content.projectiontext.textproperties[property]);
                        break;
                    case "textalignment":
                        this.xmlData.setAttribute("projectiontextalign", CssChartUtils.changeAlignment(objPropData.content.projectiontext.textproperties[property], "projectiontext"));
                        break;
                    case "letterspacing":
                        this.xmlData.setAttribute("projectiontextletterspace", objPropData.content.projectiontext.textproperties[property]);
                        break;
                }
            }
        }
        //&& !objPropData.properties
        if (strChartName) this.xmlData.setAttribute("name", strChartName);
        if ((strChartName && !objPropData.properties) || objPropData.variation) this.xmlData.setAttribute("name", strChartName);
        if (objPropData?.menu?.stylevariationname) {
            this.xmlData.setAttribute("variationname", objPropData?.menu?.stylevariationname);
        }
        if (objPropData?.menu?.stylename) {
            this.xmlData.setAttribute("stylename", objPropData?.menu?.stylename);
        }

        return this.xmlData;
    } catch (error) {
        console.log(error);
    }
};
ChartDataGenerator.prototype.resetCustomProps = function (xmlData, objDetails) {
    let arrData = [
        "data-bgFill",
        "data-bgFillType",
        "data-linethickness",
        "data-charttype",
        "data-dropshadow",
        "data-pointshape",
        "data-dashed",
        "data-stepdown",
        "data-slidebg",
        "data-graphicimage",
        "data-asset",
        "data-border",
        "data-barspace",
        "data-primaryplaceholder",
        "data-showxaxisline",
        "data-showyaxisline",
        "data-showxaxistitle",
        "data-showyaxistitle",
        "data-showyaxisgrid",
        "data-graphicpadding",
        "data-widthpadding",
        "data-heightpadding",
        "data-multicolor",
        "data-icon",
        "data-iconid",
        "data-borderradius",
        "data-mood",
        "data-minseries",
        "data-maxseries",
        "data-menuminseries",
        "data-menumaxseries",
        "data-stackpercentage",
        "data-connectorLine",
        "data-shapeborder",
        "data-primaryplaceholder",
        "data-baseline",
        "emphasis",
        "itemplaceholder",
        "itemplaceholderpath",
        "projection",
        "data-showMerged",
        "placholder",
        "placeholder",
        "placeholderpath",
        "placeholdertype",
        "primaryplaceholder",
        "primaryPlaceholderPath",
        "data-commonplaceholder",
        "data-highlightdifference",
    ];
    for (var key in arrData) {
        let strName = arrData[key];
        if (
            strName != "placholder" &&
            strName != "placeholderpath" &&
            strName != "placeholder" &&
            strName != "data-baseline" &&
            strName != "placeholdertype" &&
            strName != "primaryplaceholder" &&
            strName != "primaryPlaceholderPath" &&
            strName != "emphasis" &&
            strName != "projection" &&
            strName != "data-highlightdifference"
        ) {
            xmlData.removeAttribute(arrData[key]);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].removeAttribute(arrData[key]);
            }
        } else {
            if (
                (strName == "emphasis" ||
                    strName == "data-highlightdifference" ||
                    strName == "projection" ||
                    strName == "placholder" ||
                    strName == "placeholderpath" ||
                    strName == "placeholder" ||
                    strName == "placeholdertype" ||
                    strName == "primaryplaceholder" ||
                    strName == "primaryPlaceholderPath" ||
                    strName == "data-baseline") &&
                objDetails.menu &&
                (!objDetails.menu.variationproperties || objDetails.menu.variationsplit)
            ) {
                xmlData.removeAttribute(arrData[key]);
                for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                    xmlData.children[i1].removeAttribute(arrData[key]);
                }
            }
        }
    }
};

ChartDataGenerator.prototype.propertyUpdation = function (xmlData, objDetails) {
    if (objDetails.menu) {
        this.resetCustomProps(xmlData, objDetails);
        if (objDetails.menu.floaterproperty) {
            for (var key in objDetails.menu.floaterproperty) {
                xmlData.setAttribute("data-" + key, objDetails.menu.floaterproperty[key]);
            }
        }
        if (objDetails.menu.layoutproperty) {
            this.setChartLayoutProperty(objDetails, xmlData);
        }
        if (objDetails.menu.layoutmeta) {
            this.setSlideLayoutProperty(objDetails, xmlData);
            xmlData.setAttribute("uniqueLayout", "true");
            // if(objDetails.menu.layoutmeta.bgimage){
            // DocumentStore.getInstance().addBGImage(objDetails.slideId, { data: IndexStore.getInstance().staticServerURL + "genericassets/placeholderimages/placeholder.png" })
            // }else{
            // DocumentStore.getInstance().deleteBGImage(objDetails.slideId)
            // }
        } else {
            xmlData.removeAttribute("uniqueLayout");
            // DocumentStore.getInstance().deleteBGImage(objDetails.slideId)
        }
        if (objDetails.menu.hasOwnProperty("customprops")) {
            for (var key in objDetails.menu.customprops) {
                if (key != "connectorline" && key != "shapeborder") {
                    xmlData.setAttribute("data-" + key, objDetails.menu.customprops[key]);
                } else {
                    xmlData.setAttribute("data-" + key, "true");
                    let basekey = key;
                    for (var key in objDetails.menu.customprops[basekey]) {
                        xmlData.setAttribute("data-" + key, objDetails.menu.customprops[basekey][key]);
                    }
                }
            }
        }
        if (objDetails.menu.hasOwnProperty("highlightdifference")) {
            for (var key in objDetails.menu.highlightdifference) {
                xmlData.setAttribute("data-highlightdifference", "true");
                if (key != "connectorline" && key != "shapeborder") {
                    xmlData.setAttribute("data-highlight-" + key, objDetails.menu.highlightdifference[key]);
                } else {
                    xmlData.setAttribute("data-" + key, "true");
                    let basekey = key;
                    for (var key in objDetails.menu.highlightdifference[basekey]) {
                        xmlData.setAttribute("data-highlight-" + key, objDetails.menu.highlightdifference[basekey][key]);
                    }
                }
            }
        }
        if (objDetails?.menu?.template?.hasOwnProperty("nodecount")) {
            xmlData.setAttribute("data-minseries", objDetails.menu.template?.nodecount?.min);
            xmlData.setAttribute("data-maxseries", objDetails.menu.template?.nodecount?.max);
            xmlData.setAttribute("data-menuminseries", objDetails.menu.template?.nodecount?.min);
            xmlData.setAttribute("data-menumaxseries", objDetails.menu.template?.nodecount?.max);
        }
        if (objDetails.menu.hasOwnProperty("baseline")) xmlData.setAttribute("data-baseline", objDetails.menu.baseline);
        if (objDetails.menu.hasOwnProperty("icon")) xmlData.setAttribute("data-icon", objDetails.menu.icon);
        if (objDetails.menu.hasOwnProperty("iconid")) xmlData.setAttribute("data-iconid", objDetails.menu.iconid);
        if (objDetails.menu.hasOwnProperty("asset")) xmlData.setAttribute("data-asset", objDetails.menu.asset);
        if (objDetails.menu?.template?.hasOwnProperty("animateid")) xmlData.setAttribute("data-animateid", objDetails.menu?.template?.animateid);
        if (objDetails.menu.hasOwnProperty("name")) xmlData.setAttribute("graphicname", objDetails.menu.name);
        if (objDetails.menu.hasOwnProperty("classname")) xmlData.setAttribute("data-classname", objDetails.menu.classname);
        if (objDetails.menu.hasOwnProperty("appearance")) xmlData.setAttribute("data-appearance", objDetails.menu.appearance);
        if (objDetails.menu.hasOwnProperty("multicolor") && objDetails.menu.multicolor == "true") xmlData.setAttribute("data-multicolor", objDetails.menu.multicolor);
        if (objDetails.menu.hasOwnProperty("ismoodshape")) xmlData.setAttribute("data-mood", objDetails.menu.ismoodshape);
        if (objDetails.menu.hasOwnProperty("graphicgap")) this.graphicGapCalculation(xmlData, objDetails.menu.graphicgap);
        if (objDetails.menu.hasOwnProperty("emphasize") && objDetails.menu.emphasize.value) {
            let strvalue = objDetails.menu.emphasize.value[0];
            let index = 1;
            switch (strvalue) {
                case "first":
                    index = 1;
                    break;
                case "last":
                    index = xmlData.children.length - 1;
                    break;
                case "middle":
                    index = parseInt(xmlData.children.length / 2);
                    break;
                default:
                    index = parseInt(strvalue) - 1;
                    break;
            }
            if (xmlData.children.length > index) {
                xmlData.setAttribute("emphasis", true);
                xmlData.children[index].setAttribute("emphasis", true);
            }
        }
        if (objDetails.menu.hasOwnProperty("secondaryseries-text")) xmlData.setAttribute("data-secondaryType", "text");
        if (objDetails.menu.hasOwnProperty("secondaryseries-image")) xmlData.setAttribute("data-secondaryType", "image");
        if (objDetails.menu.hasOwnProperty("secondaryseries-sequencenumber")) xmlData.setAttribute("data-secondaryType", "sequencenumber");

        if (objDetails.menu.hasOwnProperty("projection")) {
            let strvalue = objDetails.menu.projection.value[0];
            let index = 1;
            switch (strvalue) {
                case "first":
                    index = 1;
                    break;
                case "last":
                    index = xmlData.children.length - 1;
                    break;
                case "middle":
                    index = parseInt(xmlData.children.length / 2);
                    break;
                default:
                    index = parseInt(strvalue) - 1;
                    break;
            }
            xmlData.setAttribute("projection", true);
            xmlData.children[index].setAttribute("projection", true);
        }
        if (objDetails.menu.hasOwnProperty("highlightdifference") && objDetails.menu.highlightdifference.length > 1) {
            xmlData.setAttribute("data-highlightdifference", true);
            xmlData.setAttribute("highlightdifferencepoint1", objDetails.menu.highlightdifference[0] + "," + objDetails.menu.highlightdifference[1]);
            xmlData.setAttribute("data-highlight-style", objDetails.menu.highlightdifference[2]);
        }
        if ((objDetails.menu?.template?.hasOwnProperty("chartlayout") && objDetails.menu?.template?.chartlayout?.placeholder && objDetails.menu?.template?.chartlayout?.placeholder.default) || objDetails.menu?.hasOwnProperty("placeholder-image") || objDetails.menu?.hasOwnProperty("placeholder-icon")) {
            xmlData.setAttribute("data-primaryplaceholder", true);
        }
        if (objDetails.menu?.template?.hasOwnProperty("chartlayout") && objDetails.menu?.template?.chartlayout?.label && objDetails.menu?.template?.chartlayout?.label.hasOwnProperty("itembased")) {
            xmlData.setAttribute("data-showMerged", "false");
        }
        if (
            (objDetails.menu?.template?.hasOwnProperty("chartlayout") && objDetails.menu?.template?.chartlayout?.placeholder && objDetails.menu?.template?.chartlayout?.placeholder.default && objDetails.menu?.template?.chartlayout?.placeholder.content) ||
            objDetails.menu.hasOwnProperty("placeholder-image") ||
            objDetails.menu.hasOwnProperty("placeholder-icon")
        ) {
            let type = objDetails.menu?.template?.chartlayout?.placeholder.content ? objDetails.menu?.template?.chartlayout?.placeholder.content : "";

            if (objDetails.menu.hasOwnProperty("placeholder-image")) {
                type = "image";
            }
            if (objDetails.menu.hasOwnProperty("placeholder-icon")) {
                type = "icon";
            }
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].setAttribute("placeholdertype", type);
            }
        }
        if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.graphicbg) {
            xmlData.setAttribute("data-slidebg", "true");
        }
        if (objDetails.menu?.template?.hasOwnProperty("chartlayout") && objDetails.menu?.template?.chartlayout?.commonplaceholder && objDetails.menu?.template?.chartlayout?.commonplaceholder.content) {
            xmlData.setAttribute("commonplaceholdertype", objDetails.menu.chartlayout.commonplaceholder.content);
        }

        if (objDetails.menu?.template?.hasOwnProperty("chartlayout") && objDetails.menu?.template?.chartlayout?.item && objDetails.menu?.template?.chartlayout?.item.type == "icon") {
            xmlData.setAttribute("data-icon", objDetails.menu?.template?.chartlayout?.item.asset);
            if (objDetails.menu?.template?.chartlayout?.item.iconid) {
                xmlData.setAttribute("data-iconid", objDetails.menu?.template?.chartlayout?.item.iconid);
            } else {
                xmlData.setAttribute("data-iconid", "iconfill");
            }
        }
    }
};

ChartDataGenerator.prototype.graphicGapCalculation = function (xmlData, property) {
    let left = 0;
    let right = 0;
    let top = 0;
    let bottom = 0;
    for (var key in property) {
        if (key == "top") top = Number(property[key]);
        if (key == "left") left = Number(property[key]);
        if (key == "right") right = Number(property[key]);
        if (key == "bottom") bottom = Number(property[key]);
    }
    xmlData.setAttribute("data-graphicpadding", top + "px " + right + "px " + bottom + "px " + left + "px");
    xmlData.setAttribute("data-widthpadding", left + right);
    xmlData.setAttribute("data-heightpadding", top + bottom);
};

ChartDataGenerator.prototype.setSlideLayoutProperty = function (objDetails, xmlData) {
    let slidelayout;
    let seriesLength = xmlData.children.length;
    let seriesItemLength = xmlData.children[0].getAttribute("value").split(",").length;
    let slideID = objDetails.slideId;
    if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.hasOwnProperty("2node") && seriesLength <= 2) {
        slidelayout = objDetails.menu.layoutmeta["2node"].layout;
    } else if (objDetails.menu.hasOwnProperty("layoutmeta") && (objDetails.menu.layoutmeta.hasOwnProperty("3node") || objDetails.menu.layoutmeta.hasOwnProperty("2node")) && seriesLength == 3) {
        slidelayout = objDetails.menu.layoutmeta.hasOwnProperty("3node") ? objDetails.menu.layoutmeta["3node"].layout : objDetails.menu.layoutmeta["2node"].layout;
    } else if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.hasOwnProperty("nodes")) {
        if (objDetails.menu.layoutmeta.hasOwnProperty("nodes")) slidelayout = objDetails.menu.layoutmeta["nodes"].layout;
    }
    if (slidelayout) {
        xmlData.setAttribute("uniqueLayoutName", slidelayout);
        //this.slideLayoutUpdate(slideID, slidelayout);
    }
};

ChartDataGenerator.prototype.setChartLayoutProperty = function (objDetails, xmlData) {
    let twonodelayout = objDetails.menu.layoutproperty["2node"] ? objDetails.menu.layoutproperty["2node"].layout : "";
    let threenodelayout = objDetails.menu.layoutproperty["3node"] ? objDetails.menu.layoutproperty["3node"].layout : "";
    let fournodelayout = objDetails.menu.layoutproperty["4node"] ? objDetails.menu.layoutproperty["4node"].layout : "";
    let layoutlist = objDetails.menu.layoutproperty["layoutList"] ? objDetails.menu.layoutproperty["layoutList"].layout : "";
    let additionallayoutlist = objDetails.menu.layoutproperty["additionalLayoutList"] ? objDetails.menu.layoutproperty["additionalLayoutList"].layout : "";
    let twonodename = objDetails.menu.layoutproperty["2node"] ? objDetails.menu.layoutproperty["2node"].name : "";
    let threenodename = objDetails.menu.layoutproperty["3node"] ? objDetails.menu.layoutproperty["3node"].name : "";
    let fournodename = objDetails.menu.layoutproperty["4node"] ? objDetails.menu.layoutproperty["4node"].name : "";
    let layoutlistname = objDetails.menu.layoutproperty["layoutList"] ? objDetails.menu.layoutproperty["layoutList"].name : objDetails.menu.classname;
    let additionallayoutlistname = objDetails.menu.layoutproperty["additionalLayoutList"] ? objDetails.menu.layoutproperty["additionalLayoutList"].name : "";
    if (twonodelayout && twonodename) {
        xmlData.setAttribute("twonodelayout", twonodelayout);
        xmlData.setAttribute("data-twonodename", twonodename);
    } else {
        xmlData.removeAttribute("twonodelayout");
        xmlData.removeAttribute("data-twonodename");
    }
    if (threenodelayout && threenodename) {
        xmlData.setAttribute("threenodelayout", threenodelayout);
        xmlData.setAttribute("data-threenodename", threenodename);
    } else {
        xmlData.removeAttribute("threenodelayout");
        xmlData.removeAttribute("data-threenodename");
    }
    if (fournodelayout && fournodename) {
        xmlData.setAttribute("fournodelayout", threenodelayout);
        xmlData.setAttribute("data-fournodename", threenodename);
    } else {
        xmlData.removeAttribute("fournodelayout");
        xmlData.removeAttribute("data-fournodename");
    }
    if (layoutlistname) {
        xmlData.setAttribute("data-chartname", layoutlistname);
    }

    // else {
    //     xmlData.removeAttribute("layoutlist");
    //     xmlData.removeAttribute("data-chartname");
    // }
    if (additionallayoutlist && additionallayoutlistname) {
        xmlData.setAttribute("additionallayoutlist", additionallayoutlist);
        xmlData.setAttribute("data-chartname", additionallayoutlistname);
    }
    // else {
    //     xmlData.removeAttribute("additionallayoutlist");
    //     xmlData.removeAttribute("data-chartname");
    // }
};

ChartDataGenerator.prototype.assignproperty = function (xmlData, objDetails) {
    let chartName = xmlData.getAttribute("name");
    let chartLayout = "";
    let seriesLength = xmlData.children.length;
    let seriesItemLength = xmlData.children[0].getAttribute("value").split(",").length;
    let defaultlayout = xmlData.getAttribute("layout");
    if (seriesLength <= 2 && xmlData.getAttribute("twonodelayout")) {
        chartName = xmlData.getAttribute("data-twonodename");
        chartLayout = xmlData.getAttribute("twonodelayout");
    } else if (seriesLength == 3 && xmlData.getAttribute("threenodelayout")) {
        chartName = xmlData.getAttribute("data-threenodename");
        chartLayout = xmlData.getAttribute("threenodelayout");
    } else if (seriesLength == 4 && xmlData.getAttribute("fournodelayout")) {
        chartName = xmlData.getAttribute("data-fournodename") ? xmlData.getAttribute("data-fournodename") : chartName;
        chartLayout = xmlData.getAttribute("fournodelayout");
    } else {
        chartName = xmlData.getAttribute("data-chartname");
        chartLayout = xmlData.getAttribute("primaryplaceholder") == "true" ? xmlData.getAttribute("additionallayoutlist") : xmlData.getAttribute("layoutlist");
    }
    if (!chartLayout && !chartName) {
        chartName = xmlData.getAttribute("data-chartname") ? xmlData.getAttribute("data-chartname") : chartName;
        chartLayout = xmlData.getAttribute("primaryplaceholder") == "true" ? xmlData.getAttribute("additionallayoutlist") : xmlData.getAttribute("layoutlist");
    }
    let length = chartLayout ? chartLayout.split(",").length : 0;
    for (let i1 = 0; i1 < length; i1++) {
        let arrlayout = chartLayout.split(",");
        let boolLayout = true;
        if (arrlayout[i1] == defaultlayout) {
            chartLayout = arrlayout[i1];
            boolLayout = false;
            break;
        }
    }
    xmlData.setAttribute("name", chartName);
    chartLayout = !chartLayout && defaultlayout ? defaultlayout : chartLayout;
    if (chartLayout) {
        xmlData.setAttribute("layout", chartLayout);
    }
    /////
    if (xmlData.getAttribute("data-icon") && xmlData.getAttribute("data-iconid")) {
        for (let i1 = 0; i1 < xmlData.children.length; i1++) {
            let iconPath = xmlData.getAttribute("data-icon") ? xmlData.getAttribute("data-icon").split(",") : [];
            let iconid = xmlData.getAttribute("data-iconid");
            if (!xmlData.children[i1].getAttribute("itemplaceholder") && iconPath.length > i1) {
                xmlData.setAttribute("itemplaceholder", "true");
                xmlData.children[i1].setAttribute("itemplaceholder", iconPath[i1]);
                xmlData.children[i1].setAttribute("itemplaceholderpath", "genericassets/icons/" + iconid + "/" + iconPath[i1] + ".svg");
            }
        }
    }
};

ChartDataGenerator.prototype.outlineChartData = function (objPropDataValue, bool = false) {
    this.chartHelper = new window["ChartHelper"]();
    let objPropData = {};
    let content = {
        matrix: [
            {
                matrix: [
                    {
                        value: "",
                        cellType: "text",
                        type: "text",
                        key: "562d0522-e832-4df2-8715-a6ff7033e31c",
                    },
                    {
                        value: "",
                        cellType: "text",
                        type: "text",
                        key: "fc42aa34-d882-4c73-b7bd-6f50f245fb03",
                    },
                ],
                key: "4f3e7bde-7254-40bf-a8ed-756aef05d5e9",
            },
        ],
        tableprops: {
            maxrows: 12,
            mincolumns: 2,
            minrows: 1,
            maxcolumns: 10,
        },
        type: "table",
        subtype: "table",
        outlinetype: "chart",
        header: [
            {
                value: "",
                type: "text",
                key: "de093041-4a06-42e8-bd58-4c2b36ceb7a5",
            },
            {
                value: "",
                type: "text",
                key: "00891b3d-8d5f-4a3c-a5b4-b37f0aebb229",
            },
        ],
    };
    objPropData.content = content;
    objPropData.menu = objPropDataValue;
    objPropData.name = objPropDataValue.name;
    let xmlChildNode;
    let arrLabel = [];
    let compareLabel = [];
    let arrprefix = [];
    let arrsuffix = [];
    let arrvaluesuffix = [];
    let arrcurrencysymbol = [];
    let strValue = "";
    let strPrefix = "";
    let strSuffix = "";
    let hasPrefix = false;
    let hasSuffix = false;
    let strChartName = objPropData.name ? objPropData.name : objPropData.content && objPropData.content.properties ? objPropData.content.properties.name : "";
    let strPrimaryChartName = strChartName == "comparisonModel" || strChartName == "combinationModel" || strChartName == "comparisonModelType2" || strChartName == "barcomparisonmodel" ? this.comparisonModelPrimaryData(strChartName) : objPropData.primaryName;
    let strSecondaryChartName = strChartName == "comparisonModel" || strChartName == "combinationModel" || strChartName == "comparisonModelType2" || strChartName == "barcomparisonmodel" ? this.comparisonModelSecondaryData(strChartName) : objPropData.secondaryName;
    let xmlBeginNode = "<metadata class='chartbase'>";
    let xmlEndNode = "</metadata>";
    let matrixData = objPropData.operation == "paste" ? objPropData.content : objPropData.content.matrix;
    let booHeader = matrixData[0].header ? true : false;
    let length = matrixData.length;
    let index1 = booHeader ? 1 : 0;
    var domParser = new DOMParser();
    let boolType = false;
    let itemType;
    let itemValue;
    let cellType;
    let arrItemList = [];
    let arrPlaceholder = [];
    let objAllElementValue = {
        label: [],
        value: [],
        primaryplaceholder: [],
        secondaryplaceholder: [],
    };
    let boolaiType = !objPropData.properties || !objPropData.properties.name ? this.aiTypeValidator(matrixData, length) : true;
    for (let i1 = index1; i1 < length; i1++) {
        let value;
        let intVal;
        let index = 1;
        let multiIndex = 2;
        let placeholder;
        let secondaryvalue;
        let placeholderpath;
        let arrAsset = [];
        let childXml = matrixData[i1].matrix;
        itemType = childXml[0].type;
        itemValue = childXml[0].value;
        cellType = childXml[0].cellType;
        if (strPrimaryChartName && strSecondaryChartName) {
            let childLength = childXml.length <= 2 ? childXml.length + 1 : childXml.length;
            for (let j1 = 0; j1 < childLength - 2; j1++) {
                //arrItemList[i1 + "-" + j1] = childXml[j1 + 1].value;
                value = $.isNumeric(childXml[j1 + 1].value) ? childXml[j1 + 1].value.replace(/[^0-9.-]+/g, "") : initValue + initValue * (i1 * initPercentage);
                secondaryvalue = childXml[j1 + 2] ? ($.isNumeric(childXml[j1 + 2].value) ? childXml[j1 + 2].value.replace(/[^0-9.-]+/g, "") : "25") : "25";
                if (i1 == 0) xmlChildNode = "<metadata class= 'chartitem' index= '" + i1 + "' name = '" + childXml[j1].value + "'  value='" + value + "' secondaryvalue='" + secondaryvalue + "'/>";
                else xmlChildNode += "<metadata class='chartitem' index= '" + i1 + "' name = '" + childXml[j1].value + "'  value='" + value + "' secondaryvalue='" + secondaryvalue + "'/>";
                itemType != "text" ? arrLabel.push(childXml[1].value) : arrLabel.push(childXml[0].value);
            }
        } else {
            let placeholderIndex = booHeader ? i1 - 1 : i1;
            if (itemType != "text") {
                index += 1;
                multiIndex += 1;
                boolType = true;
                itemValue = itemValue == "genericassets/placeholderimages/auto_icon.png" ? "" : itemValue;
                if (itemType == "icon" && boolaiType) {
                    placeholder = itemValue.split(".")[0];
                    arrAsset = placeholder.split("/");
                    placeholderpath = placeholder + ".svg";
                    placeholder = arrAsset[arrAsset.length - 1];
                    arrPlaceholder[placeholderIndex] = {
                        placeholder: placeholder,
                        placeholdertype: itemType,
                        placeholderpath: placeholderpath,
                    };
                } else if (itemType == "image" && boolaiType) {
                    placeholderpath = itemValue;
                    arrPlaceholder[placeholderIndex] = {
                        placeholdertype: itemType,
                        placeholderpath: placeholderpath,
                        width: childXml[0].dataRef ? childXml[0].dataRef.imageWidth : "",
                        height: childXml[0].dataRef ? childXml[0].dataRef.imageHeight : "",
                    };
                } else {
                    arrPlaceholder[placeholderIndex] = {
                        placeholder: null,
                        placeholderpath: null,
                        placeholdertype: null,
                    };
                }
            } else {
                arrPlaceholder[placeholderIndex] = {
                    placeholder: null,
                    placeholderpath: null,
                    placeholdertype: null,
                };
            }
            if (childXml.length == 1) index = 0;

            for (let k1 = 0; k1 < childXml.length - index; k1++) {
                let keyIndex = booHeader ? i1 - 1 : i1;
                if (childXml.length > multiIndex) {
                    intVal = boolType ? k1 + 1 : k1;
                    for (let l1 = 0; l1 < childXml.length - index; l1++) {
                        if (strChartName == "comparisonModelType3" || strChartName == "SimpleStackedCompareBarChart") {
                            if (l1 == 1) {
                                strValue = childXml[intVal + l1 + 1].value;
                                compareLabel.push(strValue);
                            } else {
                                strValue = childXml[intVal + l1 + 1].value;
                                arrItemList.push({
                                    key: keyIndex + "-" + k1,
                                    input: strValue,
                                });

                                if (strValue == "") strValue = "30";
                                hasPrefix = false;
                                hasSuffix = false;
                                if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                                if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                                k1++;
                            }
                        } else {
                            strValue = childXml[intVal + l1 + 1].value;
                            arrItemList.push({
                                key: keyIndex + "-" + k1,
                                input: strValue,
                            });

                            if (strValue == "") strValue = "30";
                            hasPrefix = false;
                            hasSuffix = false;
                            if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                            if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                            k1++;
                        }
                    }
                } else {
                    intVal = boolType ? k1 + 1 : childXml.length == 1 ? k1 - childXml.length : k1;
                    strValue = childXml[intVal + 1].value;
                    arrItemList.push({
                        key: keyIndex + "-" + k1,
                        input: strValue,
                    });
                    hasPrefix = false;
                    hasSuffix = false;
                    if (hasPrefix) strPrefix = String(strValue).substr(0, 1);
                    if (hasSuffix) strSuffix = String(strValue).substr(strValue.length - 1, 1);
                }
                if (childXml.length == 1) arrLabel.push("");
                else arrLabel.push(childXml[intVal].value);
            }
        }
    }

    if (arrItemList.length > 0) {
        arrItemList = this.formatChartValues(arrItemList);
        const itemlength = arrItemList.length;
        const arrItemCell = [];
        if (0 < itemlength) {
            let seriesLength = 0;
            let seriesItemLength = 0;
            for (let k2 = 0; k2 < itemlength; k2++) {
                const nodeKey = arrItemList[k2].key.split("-");
                const seriesIndex = parseInt(nodeKey[0]);
                const seriesItemIndex = parseInt(nodeKey[1]);
                arrItemCell[arrItemList[k2].key] = arrItemList[k2];
                seriesLength = seriesLength < seriesIndex + 1 ? seriesIndex + 1 : seriesLength;
                seriesItemLength = seriesItemLength < seriesItemIndex + 1 ? seriesItemIndex + 1 : seriesItemLength;
            }

            for (let k3 = 0; k3 < seriesLength; k3++) {
                let value, prefix, suffix, valuesuffix, currencysymbol;
                for (let k4 = 0; k4 < seriesItemLength; k4++) {
                    const item = arrItemCell[k3 + "-" + k4];
                    const strsuffix = item.suffix == undefined ? "" : item.suffix;
                    const strprefix = item.prefix == undefined ? "" : item.prefix;
                    const strvaluesuffix = item.currencySystem == undefined ? "" : item.currencySystem;
                    const strcurrencysymbol = item.currencysymbol == undefined ? "" : item.currencysymbol;
                    let strAssetName = objPropData.content && objPropData.content.properties && objPropData.content.properties.name ? objPropData.content.properties.name : "";
                    if (item.input) {
                        item.input = item.input.replace(/\s/g, "");
                    }

                    let strvalue = item.currencyValueNormalized == "" || item.currencyValueNormalized == undefined ? (isNaN(parseInt(item.input)) ? initValue + initValue * (k4 * initPercentage) : item.input.match(/\d+/g)[0]) : item.currencyValueNormalized;

                    if ((strAssetName == "waterfallchart" || strAssetName == "horWaterfallchart") && item.input && item.input.toLowerCase() == "sum") {
                        strvalue = item.input.toLowerCase();
                    }
                    if (seriesItemLength == 1) {
                        value = strvalue;
                        suffix = strsuffix;
                        prefix = strprefix;
                        valuesuffix = strvaluesuffix;
                        currencysymbol = strcurrencysymbol;
                    } else {
                        if (k4 == 0) {
                            value = strvalue;
                            suffix = strsuffix;
                            prefix = strprefix;
                            valuesuffix = strvaluesuffix;
                            currencysymbol = strcurrencysymbol;
                        } else {
                            value += "," + strvalue;
                            prefix += "," + strprefix;
                            suffix += "," + strsuffix;
                            valuesuffix += "," + strvaluesuffix;
                            currencysymbol += "," + strcurrencysymbol;
                        }
                    }
                }
                arrprefix.push(prefix);
                arrsuffix.push(suffix);
                arrvaluesuffix.push(valuesuffix);
                arrcurrencysymbol.push(currencysymbol);
                xmlChildNode = this.addNodeItemInMatadata(xmlChildNode, k3, "", value, "", "", "", "");
            }
        }
    }

    if (xmlChildNode == undefined) {
        xmlChildNode = "<metadata class='chartitem' index='" + 0 + "' name='" + "" + "'  value='" + 25 + "'/>";
        arrLabel.push("");
    }

    let xmlCoreData = xmlBeginNode + xmlChildNode + xmlEndNode;
    this.xmlData = domParser.parseFromString(JSON.parse(JSON.stringify(xmlCoreData)), "text/xml").children[0];
    const itemlength = this.xmlData.children.length;

    for (let i2 = 0; i2 < itemlength; i2++) {
        this.xmlData.children[i2].setAttribute("name", arrLabel[i2]);
        if (compareLabel.length >= 1 && compareLabel[i2]) {
            this.xmlData.children[i2].setAttribute("comparisonname", compareLabel[i2]);
        }
        if (!strPrimaryChartName && !strSecondaryChartName) {
            if (arrprefix[i2] != undefined) this.xmlData.children[i2].setAttribute("prefix", arrprefix[i2]);
            if (arrsuffix[i2] != undefined) this.xmlData.children[i2].setAttribute("suffix", arrsuffix[i2]);
            if (arrvaluesuffix[i2] != undefined) this.xmlData.children[i2].setAttribute("denomination", arrvaluesuffix[i2]);
            if (arrcurrencysymbol[i2] != undefined) this.xmlData.children[i2].setAttribute("currencysymbol", arrcurrencysymbol[i2]);
        }

        if (matrixData[i2]) {
            let hadSecondaryPlaceHolderProp = matrixData[i2].secondaryPlaceholderProperty;
            if (hadSecondaryPlaceHolderProp && hadSecondaryPlaceHolderProp != undefined) {
                for (var property in matrixData[i2].secondaryPlaceholderProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].secondaryPlaceholderProperty[property]);
                }
            }

            let hadhighlightProp = matrixData[i2].highlightProperty;
            if (hadhighlightProp && hadhighlightProp != undefined) {
                for (var property in matrixData[i2].highlightProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].highlightProperty[property]);
                }
            }
            let linkUrlProperty = matrixData[i2].linkUrlProperty;
            if (linkUrlProperty && linkUrlProperty != undefined) {
                for (var property in matrixData[i2].linkUrlProperty) {
                    this.xmlData.children[i2].setAttribute("data-navigate-to-slide-on-click", linkUrlProperty);
                    this.xmlData.children[i2].setAttribute("link", "URL");
                }
            }
            let hasProjectionProp = matrixData[i2].projectionProperty;
            if (hasProjectionProp && hasProjectionProp != undefined) {
                for (var property in matrixData[i2].projectionProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].projectionProperty[property]);
                }
            }
            let hadEmphasizeProp = matrixData[i2].emphasisProperty;
            if (hadEmphasizeProp && hadEmphasizeProp != undefined) {
                for (var property in matrixData[i2].emphasisProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].emphasisProperty[property]);
                }
            }
            let hadPrimaryPlaceholderProp = matrixData[i2].primaryPlaceholderProperty;
            if (hadPrimaryPlaceholderProp && hadPrimaryPlaceholderProp != undefined) {
                for (var property in matrixData[i2].primaryPlaceholderProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].primaryPlaceholderProperty[property]);
                }
            }
            let hadItemPlaceholderProp = matrixData[i2].itemPlaceholderProperty;
            if (hadItemPlaceholderProp && hadItemPlaceholderProp != undefined && bool) {
                for (var property in matrixData[i2].itemPlaceholderProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].itemPlaceholderProperty[property]);
                }
            }
            let hadGraphicImageProp = matrixData[i2].graphicImageProperty;
            if (hadGraphicImageProp && hadGraphicImageProp != undefined) {
                for (var property in matrixData[i2].graphicImageProperty) {
                    this.xmlData.children[i2].setAttribute(property, matrixData[i2].graphicImageProperty[property]);
                }
            }
        }

        if (arrPlaceholder.length > 0) {
            if (arrPlaceholder[i2].placeholder != null || arrPlaceholder[i2].placeholderpath != null) {
                this.xmlData.setAttribute("primaryplaceholder", "true");
                if (arrPlaceholder[i2].placeholder) this.xmlData.children[i2].setAttribute("placeholder", arrPlaceholder[i2].placeholder);
                this.xmlData.children[i2].setAttribute("placeholderpath", arrPlaceholder[i2].placeholderpath);
                this.xmlData.children[i2].setAttribute("placeholdertype", arrPlaceholder[i2].placeholdertype);
                if (arrPlaceholder[i2].placeholdertype == "image" && arrPlaceholder[i2].width && arrPlaceholder[i2].height) {
                    this.xmlData.children[i2].setAttribute("data-imagewidth", arrPlaceholder[i2].width);
                    this.xmlData.children[i2].setAttribute("data-imageheight", arrPlaceholder[i2].height);
                }
            }
        }
    }

    if (strPrimaryChartName && strSecondaryChartName) {
        this.xmlData.setAttribute("primarychart", strPrimaryChartName);
        this.xmlData.setAttribute("secondarychart", strSecondaryChartName);
    }
    if (strPrefix != "") this.xmlData.setAttribute("prefixtype", strPrefix);
    if (strSuffix != "") {
        strSuffix = strSuffix.substring(0, 4);
        this.xmlData.setAttribute("suffixlabel", strSuffix);
    }
    for (var property in objPropData.properties) {
        this.xmlData.setAttribute(property, objPropData.properties[property]);
    }

    if (objPropData.operation == "redraw") {
        for (var property in objPropData.content.properties) {
            this.xmlData.setAttribute(property, objPropData.content.properties[property]);
        }
    }

    //&& !objPropData.properties
    if (strChartName) this.xmlData.setAttribute("name", strChartName);
    if ((strChartName && !objPropData.properties) || objPropData.variation) this.xmlData.setAttribute("name", strChartName);
    return this.xmlData;
};

ChartDataGenerator.prototype.addNodeItemInMatadata = function (parent, index, label = "", value = "", prefix = "", suffix = "", valuesuffix = "", currencysymbol = "") {
    const node = "<metadata class='chartitem' index='" + index + "' name='" + label + "' value='" + value + "' prefix='" + prefix + "' suffix='" + suffix + "' denomination='" + valuesuffix + "' currencysymbol='" + currencysymbol + "'/>";
    if (index == 0) parent = node;
    else parent += node;
    return parent;
};

ChartDataGenerator.prototype.comparisonModelPrimaryData = function (chartPrimaryName) {
    if (chartPrimaryName == "comparisonModel") return "barHorizontalChart";
    else if (chartPrimaryName == "combinationModel") return "barVerticalChart";
    // if (chartPrimaryName == "comparisonModelType2") return "barHorizontalChart";
    // if (chartPrimaryName == "comparisonModelType3") return "barHorizontalChart";
};

ChartDataGenerator.prototype.comparisonModelSecondaryData = function (chartPrimaryName) {
    if (chartPrimaryName == "comparisonModel") return "barHorizontalChart";
    else if (chartPrimaryName == "combinationModel") return "lineChart";
    // if (chartPrimaryName == "comparisonModelType2") return "barHorizontalChart";
    // if (chartPrimaryName == "comparisonModelType3") return "barHorizontalChart";
};

ChartDataGenerator.prototype.aiTypeValidator = function (matrixData, length) {
    let boolAiType;
    for (let i1 = 0; i1 < length; i1++) {
        let childXml = matrixData[i1].matrix;
        let aiType = childXml[0].aiType;
        if (aiType == "countries" || aiType == "companies") boolAiType = true;
        else {
            boolAiType = childXml[0].hasOwnProperty("aigraphic") ? true : false;
            break;
        }
    }
    return boolAiType;
};

ChartDataGenerator.prototype.assignLabelData = function (element, type) {
    let labelText = element.innerText;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = element.getAttribute("data-slideid");
    const slide = document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    if (type == "comparisonlabel") {
        let oldCompareLabel = xmlData.children[index].getAttribute("comparisonname");
        if (oldCompareLabel != labelText) {
            xmlData.children[index].setAttribute("comparisonname", labelText);
            this.chartUtils.updateChartProperties(slideID, {});
        }
    } else if (type == "placeholdertext") {
        let oldCompareLabel = xmlData.getAttribute("commonplaceholdertext");
        if (oldCompareLabel != labelText) {
            xmlData.setAttribute("commonplaceholdertext", labelText);
        }
    } else if (type == "comparelabel") {
        let oldCompareLabel = xmlData.getAttribute("comparetext");
        if (oldCompareLabel != labelText) {
            xmlData.setAttribute("comparetext", labelText);
        }
    } else {
        let oldLabel = xmlData.children[index].getAttribute("name");
        if (oldLabel != labelText) {
            xmlData.children[index].setAttribute("name", labelText);
            this.chartUtils.updateChartProperties(slideID, {});
        }
    }
};

ChartDataGenerator.prototype.assignLegendLabelData = function (element) {
    let labelText = element.innerText;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = element.getAttribute("data-slideid");
    const slide = document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];

    this.multiSeriesLegend = xmlData.getAttribute("multiserieslegend").split(",");
    this.newText = labelText;
    this.multiSeriesLegend[index] = this.newText;
    this.newText = "";
    this.newText = this.multiSeriesLegend.join(",");
    xmlData.setAttribute("multiserieslegend", this.newText);
    this.chartUtils.updateChartProperties(slideID, {});
};

ChartDataGenerator.prototype.assignSecondaryData = function (element) {
    let labelText = element.innerText;
    let index = parseInt(element.getAttribute("data-id"));
    let slideID = element.getAttribute("data-slideid");
    const slide = document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    let oldLabel = xmlData.children[index].getAttribute("secondaryName");
    if (oldLabel != labelText) {
        xmlData.children[index].setAttribute("secondaryName", labelText);
        this.chartUtils.updateChartProperties(slideID, {});
    }
};
ChartDataGenerator.prototype.assignValueData = function (element) {
    let valueText = element.innerText.replace(/\s/g, "");

    element.innerText = valueText;
    let booldefaultPercentage = element.dataset.defalutPercentage ? true : false;
    let arrInputValue = [
        {
            input: valueText,
        },
    ];
    arrInputValue = this.chartUtils.formatChartValues(arrInputValue);
    let boolsum = !arrInputValue.validData && element.hasAttribute("sumvalue") && valueText.toLowerCase() == "sum" ? true : false;
    let indexId = element.getAttribute("data-id");
    let groupIndex = parseInt(indexId.split("_")[0]);
    let index = parseInt(indexId.split("_")[1]);
    let slideID = element.getAttribute("data-slideid");
    const slide = document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    let arrValue = xmlData.children[groupIndex].getAttribute("value").split(",");
    let arrPrefix = xmlData.children[groupIndex].getAttribute("prefix");
    let arrSuffix = xmlData.children[groupIndex].getAttribute("suffix");
    let arrdenomination = xmlData.children[groupIndex].getAttribute("denomination");
    let arrcurrencySymbol = xmlData.children[groupIndex].getAttribute("currencysymbol");
    let chartName = xmlData.getAttribute("name");
    let value;
    let prefix;
    let suffix;
    let denomination;
    let currencysymbol;
    let oldValue = xmlData.children[groupIndex].getAttribute("value").split(",")[index];
    let oldSuffix = xmlData.children[groupIndex].getAttribute("suffix") == "," || xmlData.children[groupIndex].getAttribute("suffix") == ",," || xmlData.children[groupIndex].getAttribute("suffix") == ",,," ? "" : xmlData.children[groupIndex].getAttribute("suffix");
    oldSuffix = booldefaultPercentage && !oldSuffix.includes("%") ? "%" : oldSuffix;
    oldSuffix = chartName == "fillcompareChart" && oldSuffix == "" ? "%" : oldSuffix;
    if (oldValue + oldSuffix != valueText) {
        element.setAttribute("data-enabled", "true");
        for (let i1 = 0; i1 < arrValue.length; i1++) {
            if (i1 == index) {
                if (i1 == 0) {
                    value = boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0; // valueText;
                    prefix = arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix;
                    suffix = arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix;
                    denomination = arrInputValue[0].currencySystem == undefined ? "" : arrInputValue[0].currencySystem;
                    currencysymbol = arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol;
                } else {
                    value += "," + (boolsum ? valueText : arrInputValue[0].validData ? arrInputValue[0].currencyValueNormalized : 0); // valueText;
                    prefix += "," + (arrInputValue[0].prefix == undefined ? "" : arrInputValue[0].prefix);
                    suffix += "," + (arrInputValue[0].suffix == undefined ? "" : arrInputValue[0].suffix);
                    denomination += "," + (arrInputValue[0].denomination == undefined ? "" : arrInputValue[0].denomination);
                    currencysymbol += "," + (arrInputValue[0].currencysymbol == undefined ? "" : arrInputValue[0].currencysymbol);
                }
            } else {
                if (i1 == 0) {
                    value = arrValue[i1];
                    prefix = arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "";
                    suffix = arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "";
                    denomination = arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "";
                    currencysymbol = arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "";
                } else {
                    value += "," + arrValue[i1];
                    prefix += "," + (arrPrefix ? (arrPrefix.split(",")[i1] ? arrPrefix.split(",")[i1] : "") : "");
                    suffix += "," + (arrSuffix ? (arrSuffix.split(",")[i1] ? arrSuffix.split(",")[i1] : "") : "");
                    denomination += "," + (arrdenomination ? (arrdenomination.split(",")[i1] ? arrdenomination.split(",")[i1] : "") : "");
                    currencysymbol += "," + (arrcurrencySymbol ? (arrcurrencySymbol.split(",")[i1] ? arrcurrencySymbol.split(",")[i1] : "") : "");
                }
            }
            value = value == undefined ? "" : value;
            prefix = prefix == undefined ? "" : prefix;
            suffix = suffix == undefined ? "" : suffix;
            denomination = denomination == undefined ? "" : denomination;
            currencysymbol = currencysymbol == undefined ? "" : currencysymbol;
        }
        suffix = booldefaultPercentage ? "" : suffix;
        if (value && value.length > 7 && value.split(",").length == 1) {
            value = value.substr(0, 7);
        }
        xmlData.children[groupIndex].setAttribute("value", value);
        xmlData.children[groupIndex].setAttribute("prefix", prefix);
        xmlData.children[groupIndex].setAttribute("suffix", suffix);
        xmlData.children[groupIndex].setAttribute("denomination", denomination);
        xmlData.children[groupIndex].setAttribute("currencysymbol", currencysymbol);
    }
};

ChartDataGenerator.prototype.formatChartValues = function (arrChartValues) {
    return arrChartValues;
    let gDataFormatterval = eval("new " + "GDataFormatter" + "()");
    for (var i = 0; i < arrChartValues.length; i++) {
        gDataFormatterval.formatCurrency(arrChartValues[i]);
        if (!arrChartValues[i].validData) {
            delete arrChartValues[i].validData;
            arrChartValues[i].invalidData = true;
            gDataFormatter.formatCurrency(arrChartValues[i]);
        }
    }
    return arrChartValues;
};
ChartDataGenerator.prototype.assignAxisTitleData = function (element) {
    let oldLabel = "";
    let axisTitleText = element.innerText;
    let indexId = element.getAttribute("data-id");
    let slideID = this.getElementSlide(element).getAttribute("id"); //element.getAttribute("data-slideid");
    const slide = this.getElementSlide(element); //document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    if (indexId == "xAxis") oldLabel = xmlData.getAttribute("xaxistitle");
    else if (indexId == "yAxis") oldLabel = xmlData.getAttribute("yaxistitle");
    if (indexId == "xAxis") xmlData.setAttribute("xaxistitle", axisTitleText);
    else if (indexId == "yAxis") xmlData.setAttribute("yaxistitle", axisTitleText);
    if (oldLabel != axisTitleText) {
        this.chartUtils.updateChartProperties(slideID, {});
    }
};

ChartDataGenerator.prototype.assignBaseLineData = function (element) {
    let baselineTitleText = element.innerText;
    let baselineId = element.getAttribute("data-id");
    let index = parseInt(baselineId.split("_")[1]);
    let slideID = this.getElementSlide(element).getAttribute("id"); //element.getAttribute("data-slideid");
    const slide = this.getElementSlide(element); //document.getElementById(slideID);
    let xmlData = slide.querySelector("desc").children[0];
    let arrBaseLineText = [];
    let oldLabel = baselineId.includes("left") ? xmlData.getAttribute("baseline_left_text") : xmlData.getAttribute("baseline_bottom_text");
    arrBaseLineText = baselineId.includes("left") ? xmlData.getAttribute("baseline_left_text").split(",") : xmlData.getAttribute("baseline_bottom_text").split(",");
    arrBaseLineText.splice(index, 1, baselineTitleText);
    if (baselineId.includes("left")) xmlData.setAttribute("baseline_left_text", arrBaseLineText.toString());
    else xmlData.setAttribute("baseline_bottom_text", arrBaseLineText.toString());
    this.chartUtils.updateChartProperties(slideID, {});
};
