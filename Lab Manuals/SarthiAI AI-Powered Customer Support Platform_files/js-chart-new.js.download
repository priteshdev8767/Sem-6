                // let imagePath = eltarget.getAttribute("data-imagepath");
                // if (imagePath)
                editImage = this.FloaterPropertyObjects.edit;
            }
            if (elementType == "IMAGE") {
                imageFolder = eltarget.getAttribute("data-secondassetsource");
                if (!imageFolder) imageFolder = eltarget.getAttribute("data-secondassetSource");
                if (imageFolder) {
                    customImageSource = this.getImageSource(imageFolder);
                }
                if (chartName == "imageColumnIconFill") {
                    let boolEmptyImage = eltarget.getAttribute("has-image");
                    if (boolEmptyImage) {
                        hasAddImage = this.FloaterPropertyObjects.addimagestackimage;
                    }
                }
            }
