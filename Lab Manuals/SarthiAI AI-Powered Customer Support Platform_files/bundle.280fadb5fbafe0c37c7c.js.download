Progress:"Planning the presentation outline",completed:"Planned the presentation outline",summary:"A slide-by-slide structure was defined, establishing logical flow and a clear progression from context to insight to conclusion."},{id:6,inProgress:"Identifying gaps and missing data",completed:"Identified gaps and missing data",summary:"Areas of incomplete information were identified, key assumptions were surfaced, and points where additional input would improve clarity or accuracy were flagged."},{id:7,inProgress:"Analysing new information",completed:"Analysed new information",summary:"New inputs were interpreted in context, separating signal from noise and identifying what materially changes the direction or emphasis of this slide.",conditional:!0},{id:8,inProgress:"Shaping slide layouts",completed:"Shaped slide layouts",summary:"Appropriate layout patterns were selected and adapted to support hierarchy, balance, and clarity — ensuring the overall structure reinforces the message across the slide."},{id:9,inProgress:"Sketching diagrams",completed:"Sketched diagrams",summary:"Concepts were translated into visual structures such as flows, comparisons, frameworks, or relationships where diagrams communicate more clearly than text."},{id:10,inProgress:"Styling content blocks",completed:"Styled content blocks",summary:"Text, lists, highlights, and emphasis elements were formatted to improve readability and guide attention without clutter."},{id:11,inProgress:"Picking icons",completed:"Picked icons",summary:"Icons were selected to reinforce meaning, add visual anchors, and increase scannability without introducing visual noise."},{id:12,inProgress:"Generating visuals",completed:"Generated visuals",summary:"Supporting imagery or illustrations were created or selected to enhance clarity, tone, and engagement while staying contextually relevant."},{id:13,inProgress:"Charting the numbers",completed:"Charted the numbers",summary:"Data was mapped into the most appropriate chart type, with axes, scale, and emphasis adjusted to highlight the intended insight."},{id:14,inProgress:"Refining the copy",completed:"Refined the copy",summary:"Language was tightened and aligned with tone, ensuring clarity, precision, and visual fit within the layout."},{id:15,inProgress:"Adding motion",completed:"Added motion",summary:"Subtle animations and transitions were applied to guide attention and improve narrative flow without distracting from the content."},{id:16,inProgress:"Finalising the slide",completed:"Finalised the slide",summary:"All elements were reviewed for cohesion, consistency, and balance before rendering the completed slide."}];t.researchSteps=o.slice(0,6),t.editorStepsForLoader=o.slice(7,16),t.editorStepsWithMetrics=[o[6]].concat(n(o.slice(7,16))),t.stepsWithoutConditional=[].concat(n(o.slice(0,6)),n(o.slice(7,16)))},19039(e,t,n){"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.Spinner=l,t.default=void 0;var r,o=(r=n(96540))&&r.__esModule?r:{default:r},a=n(75382),i=["className"];function l(e){var t=e.className;!function(e,t){if(null==e)return{};var n,r,o=function(e,t){if(null==e)return{};var n={};for(var r in e)if({}.hasOwnProperty.call(e,r)){if(-1!==t.indexOf(r))continue;n[r]=e[r]}return n}(e,t);if(Object.getOwnPropertySymbols){var a=Object.getOwnPropertySymbols(e);for(r=0;r<a.length;r++)n=a[r],-1===t.indexOf(n)&&{}.propertyIsEnumerable.call(e,n)&&(o[n]=e[n])}}(e,i);return o.default.createElement(a.PhosphorIcon,{icon:"CircleNotch",variant:"bold",size:"24px",className:"w-5 h-5 animate-spin "+t})}t.default=l},11679(e,t,n){"use strict";function r(e){return r="function"==typeof Symbol&&"symbol"==typeof Symbol.iterator?function(e){return typeof e}:function(e){return e&&"function"==typeof Symbol&&e.constructor===Symbol&&e!==Symbol.prototype?"symbol":typeof e},r(e)}Object.defineProperty(t,"__esModule",{value:!0}),t.default=void 0;var o,a=function(e,t){if("function"==typeof WeakMap)var n=new WeakMap,o=new WeakMap;return function(e,t